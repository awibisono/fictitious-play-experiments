theorem Karlin.FaithfulMain.main_theorem : ∀ (k : ℕ),
  2 ≤ k →
    ∃ m M a c,
      m + 1 = (k + 1) ^ 2 - 5 ∧
        Karlin.IsSkewSymmetric M ∧
          a 0 = 0 ∧
            (∀ (i : Fin (m + 1)), Karlin.FaithfulMain.counts a 0 i = 0) ∧
              Karlin.IsStrictTwoPlayerFPTrajectory M a a ∧
                (∀ (row col : ℕ → Fin (m + 1)),
                    Karlin.IsWeakTwoPlayerFPTrajectory M row col →
                      row 0 = 0 → col 0 = 0 → ∀ (t : ℕ), row t = a t ∧ col t = a t) ∧
                  0 < c ∧
                    Filter.Tendsto (fun t => ↑(Karlin.standardDualityGap M a a t) * ↑t ^ (1 / ↑k)) Filter.atTop
                        (nhds c) ∧
                      ((fun t => ↑(Karlin.standardDualityGap M a a t) / (c * ↑t ^ (-(1 / ↑k))) - 1) =O[Filter.atTop]
                          fun t => ↑t ^ (-(1 / ↑k))) ∧
                        ∃ T,
                          1 ≤ T ∧
                            ∀ (t : ℕ),
                              T ≤ t →
                                c / 2 * ↑t ^ (-(1 / ↑k)) ≤ ↑(Karlin.standardDualityGap M a a t) ∧
                                  ↑(Karlin.standardDualityGap M a a t) ≤ 2 * c * ↑t ^ (-(1 / ↑k)) :=
fun k hk =>
  Exists.intro (Karlin.FaithfulMain.clock k hk).m
    (Exists.intro (Karlin.FaithfulMain.matrix k hk)
      (Exists.intro (Karlin.FaithfulMain.trajectory k hk)
        (Exists.intro (Karlin.FaithfulMain.constant k hk)
          ⟨Karlin.FaithfulMain.dimension k hk,
            ⟨Karlin.FaithfulMain.skew k hk,
              ⟨Karlin.FaithfulMain.common_initial_action k hk,
                ⟨Karlin.FaithfulMain.zero_initial_counts k hk,
                  ⟨Karlin.FaithfulMain.strict_simultaneous k hk,
                    ⟨Karlin.FaithfulMain.unique_from_common_setup k hk,
                      ⟨(Karlin.FaithfulMain.exact_gap k hk).left,
                        ⟨(Karlin.FaithfulMain.exact_gap k hk).right,
                          ⟨Karlin.FaithfulMain.relative_error k hk,
                            Karlin.FaithfulMain.all_integer_theta k hk⟩⟩⟩⟩⟩⟩⟩⟩⟩)))
'Karlin.FaithfulMain.main_theorem' depends on axioms: [propext, Classical.choice, Quot.sound]
