  (A : Karlin.FaithfulAdmissible.Admissible P) (lam T1 T2 : ℕ),
  0 < lam →
    0 < T1 →
      T1 ≤ T2 →
        Karlin.FaithfulAppendix.nu k (↑T1) (↑lam) A.referenceHeight A.correction < 1 / 2 →
