structure Karlin.FaithfulEffectiveContract.UniversalThresholdRealizer {k : ℕ} (P : Karlin.FaithfulClock.Clock k) : Type
number of parameters: 2
fields:
  Karlin.FaithfulEffectiveContract.UniversalThresholdRealizer.program : Karlin.FaithfulEffectiveContract.UniversalProgram
  Karlin.FaithfulEffectiveContract.UniversalThresholdRealizer.computes : ∀ (eps : ℚ),
      0 < eps → self.program.eval eps = Part.some ↑(P.threshold eps)
constructor:
  Karlin.FaithfulEffectiveContract.UniversalThresholdRealizer.mk {k : ℕ} {P : Karlin.FaithfulClock.Clock k}
    (program : Karlin.FaithfulEffectiveContract.UniversalProgram)
    (computes : ∀ (eps : ℚ), 0 < eps → program.eval eps = Part.some ↑(P.threshold eps)) :
    Karlin.FaithfulEffectiveContract.UniversalThresholdRealizer P
@Karlin.FaithfulEffectiveContract.lift_every_partrec_parent_program : ∀ {k : ℕ} {P : Karlin.FaithfulClock.Clock k}
  (A : Karlin.FaithfulAdmissible.Admissible P) (f : ℕ → Part ℕ),
  Nat.Partrec f →
    (∀ (eps : ℚ), 0 < eps → f (Karlin.FaithfulEffectiveContract.encodeRat eps) = Part.some (P.threshold eps)) →
      ∃ code,
        ∀ (input : ℕ),
          0 < Karlin.FaithfulEffectiveContract.decodeRat input →
            Karlin.FaithfulEffectiveContract.UniversalProgram.runCode code input =
              Part.some ((Karlin.FaithfulLift.nextClock A).threshold (Karlin.FaithfulEffectiveContract.decodeRat input))
Karlin.FaithfulEffectiveContract.universal_rpsFamily_correct : ∀ (k : ℕ) (hk : 2 ≤ k) (eps : ℚ),
  0 < eps →
    ∃ fuel,
      (Karlin.FaithfulEffectiveContract.universalRpsFamily k hk).program.execute fuel
          (Karlin.FaithfulEffectiveContract.encodeRat eps) =
        some (Karlin.FaithfulEffectiveLift.familyThreshold k hk eps)
Karlin.FaithfulEffectiveContract.universal_sevenFamily_correct : ∀ (k : ℕ) (hk : 3 ≤ k) (eps : ℚ),
  0 < eps →
    ∃ fuel,
      (Karlin.FaithfulEffectiveContract.universalSevenFamily k hk).program.execute fuel
          (Karlin.FaithfulEffectiveContract.encodeRat eps) =
        some (Karlin.FaithfulSevenFamily.threshold k hk eps)
Karlin.FaithfulMain.main_theorem : ∀ (k : ℕ),
  2 ≤ k →
    ∃ m M a c,
      m + 1 = (k + 1) ^ 2 - 5 ∧
        Karlin.IsSkewSymmetric M ∧
          a 0 = 0 ∧
            (∀ (i : Fin (m + 1)), Karlin.FaithfulMain.counts a 0 i = 0) ∧
              Karlin.IsStrictTwoPlayerFPTrajectory M a a ∧
                (∀ (row col : ℕ → Fin (m + 1)),
                    Karlin.IsWeakTwoPlayerFPTrajectory M row col →
                      row 0 = 0 → col 0 = 0 → ∀ (t : ℕ), row t = a t ∧ col t = a t) ∧
                  0 < c ∧
                    Filter.Tendsto (fun t => ↑(Karlin.standardDualityGap M a a t) * ↑t ^ (1 / ↑k)) Filter.atTop
                        (nhds c) ∧
                      ((fun t => ↑(Karlin.standardDualityGap M a a t) / (c * ↑t ^ (-(1 / ↑k))) - 1) =O[Filter.atTop]
                          fun t => ↑t ^ (-(1 / ↑k))) ∧
                        ∃ T,
                          1 ≤ T ∧
                            ∀ (t : ℕ),
                              T ≤ t →
                                c / 2 * ↑t ^ (-(1 / ↑k)) ≤ ↑(Karlin.standardDualityGap M a a t) ∧
                                  ↑(Karlin.standardDualityGap M a a t) ≤ 2 * c * ↑t ^ (-(1 / ↑k))
Karlin.FaithfulSevenFamily.main_theorem : ∀ (k : ℕ),
  3 ≤ k →
    ∃ m M a c,
      m + 1 = (k + 1) ^ 2 - 9 ∧
        Karlin.IsSkewSymmetric M ∧
          a 0 = 0 ∧
            (∀ (i : Fin (m + 1)), Karlin.FaithfulSevenFamily.counts a 0 i = 0) ∧
              Karlin.IsStrictTwoPlayerFPTrajectory M a a ∧
                (∀ (row col : ℕ → Fin (m + 1)),
