ADDED_THEOREM_TYPE Karlin.FaithfulEffectiveContract.UniversalProgram.fromCodeTree.eq_def
∀ (x : Nat.Partrec.Code),
  Karlin.FaithfulEffectiveContract.UniversalProgram.fromCodeTree x =
    match x with
    | Nat.Partrec.Code.zero.pair c =>
      Option.some (Karlin.FaithfulEffectiveContract.UniversalProgram.machine c.encodeCode)
    | Nat.Partrec.Code.succ.pair c =>
      Option.map Karlin.FaithfulEffectiveContract.UniversalProgram.arithmetic (Encodable.decode c.encodeCode)
    | (Nat.Partrec.Code.left.pair c).pair (p.pair q) => do
      let p' ← Karlin.FaithfulEffectiveContract.UniversalProgram.fromCodeTree p
      let q' ← Karlin.FaithfulEffectiveContract.UniversalProgram.fromCodeTree q
      Pure.pure (Karlin.FaithfulEffectiveContract.UniversalProgram.binary c.encodeCode p' q')
    | Nat.Partrec.Code.right.pair p =>
      Option.map Karlin.FaithfulEffectiveContract.UniversalProgram.round
        (Karlin.FaithfulEffectiveContract.UniversalProgram.fromCodeTree p)
    | x => Option.none
