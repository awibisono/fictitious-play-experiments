    | Karlin.FaithfulEffectiveContract.UniversalProgram.machine c =>
      Nat.Partrec.Code.zero.pair (Nat.Partrec.Code.ofNatCode c)
    | Karlin.FaithfulEffectiveContract.UniversalProgram.arithmetic p =>
