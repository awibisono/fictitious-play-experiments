∀ (k : ℕ) (T1 T2 lam : ℚ) (z ell : Fin (k + 1) → ℚ) (L B : Matrix (Fin (k + 1)) (Fin (k + 1)) ℚ),
  0 < T1 →
    T1 ≤ T2 →
      ∀ Z ∈ {Karlin.W_concrete k T1 T2 lam z, Karlin.WE_concrete k T1 T2 lam z (Karlin.Faithful.earlyUnit k) ell},
        Karlin.FaithfulAppendix.normStar ((1 / (T1 * T2 ^ 2)) • (L * Z)) +
              Karlin.FaithfulAppendix.normStar ((1 / (T1 * T2 ^ 2)) • (L.transpose * Z * B)) ≤
            Karlin.FaithfulAppendix.normStar L * Karlin.FaithfulAppendix.bC k T1 lam z ell *
                (1 + Karlin.FaithfulAppendix.normStar B) /
              (T1 * T2) ∧
          Karlin.FaithfulAppendix.normStar ((1 / (T1 * T2 ^ 2)) • (L * Z)) +
              Karlin.FaithfulAppendix.normStar ((1 / (T1 * T2 ^ 2)) • (L.transpose * Z * B)) ≤
            Karlin.FaithfulAppendix.normStar L * Karlin.FaithfulAppendix.bC k T1 lam z ell *
                (1 + Karlin.FaithfulAppendix.normStar B) /
