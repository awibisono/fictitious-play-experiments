  ∃ code fuel,
    ∀ (input : ℕ),
      0 < Karlin.FaithfulEffectiveContract.decodeRat input →
        Karlin.FaithfulEffectiveContract.execute code input =
            Option.some (P.threshold (Karlin.FaithfulEffectiveContract.decodeRat input)) ∧
          Karlin.FaithfulEffectiveContract.runFuel fuel E.program (Karlin.FaithfulEffectiveContract.decodeRat input)
                [] =
              Option.some [↑(P.threshold (Karlin.FaithfulEffectiveContract.decodeRat input))] ∧
            ∀ (q : ℕ),
              P.threshold (Karlin.FaithfulEffectiveContract.decodeRat input) ≤ q →
