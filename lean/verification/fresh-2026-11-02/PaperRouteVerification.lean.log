ADDED_THEOREM_TYPE Karlin.FaithfulEffectiveContract.UniversalProgram.evaln.eq_def
∀ (x : Karlin.FaithfulEffectiveContract.UniversalProgram) (x_1 : ℕ) (x_2 : ℚ),
  x.evaln x_1 x_2 =
    match x, x_1, x_2 with
    | Karlin.FaithfulEffectiveContract.UniversalProgram.machine c, fuel, eps =>
      Option.map (fun n => ↑n)
        (Nat.Partrec.Code.evaln fuel (Nat.Partrec.Code.ofNatCode c) (Karlin.FaithfulEffectiveContract.encodeRat eps))
    | Karlin.FaithfulEffectiveContract.UniversalProgram.arithmetic p, x, eps =>
      Option.some ((Karlin.FaithfulEffectiveContract.run p eps []).headD 0)
    | Karlin.FaithfulEffectiveContract.UniversalProgram.binary op p q, fuel, eps =>
      (p.evaln fuel eps).bind fun x =>
        Option.map (Karlin.FaithfulEffectiveContract.UniversalProgram.operation op x) (q.evaln fuel eps)
    | p.round, fuel, eps => Option.map (fun x => ↑⌈x⌉₊) (p.evaln fuel eps)
