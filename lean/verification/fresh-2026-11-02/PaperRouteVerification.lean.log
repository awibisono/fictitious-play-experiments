Karlin.FaithfulMain.main_theorem : ∀ (k : ℕ),
  2 ≤ k →
    ∃ m M a c,
      m + 1 = (k + 1) ^ 2 - 5 ∧
        Karlin.IsSkewSymmetric M ∧
          a 0 = 0 ∧
            (∀ (i : Fin (m + 1)), Karlin.FaithfulMain.counts a 0 i = 0) ∧
              Karlin.IsStrictTwoPlayerFPTrajectory M a a ∧
                (∀ (row col : ℕ → Fin (m + 1)),
                    Karlin.IsWeakTwoPlayerFPTrajectory M row col →
                      row 0 = 0 → col 0 = 0 → ∀ (t : ℕ), row t = a t ∧ col t = a t) ∧
                  0 < c ∧
                    Filter.Tendsto (fun t => ↑(Karlin.standardDualityGap M a a t) * ↑t ^ (1 / ↑k)) Filter.atTop
                        (nhds c) ∧
                      ((fun t => ↑(Karlin.standardDualityGap M a a t) / (c * ↑t ^ (-(1 / ↑k))) - 1) =O[Filter.atTop]
                          fun t => ↑t ^ (-(1 / ↑k))) ∧
                        ∃ T,
                          1 ≤ T ∧
                            ∀ (t : ℕ),
                              T ≤ t →
                                c / 2 * ↑t ^ (-(1 / ↑k)) ≤ ↑(Karlin.standardDualityGap M a a t) ∧
                                  ↑(Karlin.standardDualityGap M a a t) ≤ 2 * c * ↑t ^ (-(1 / ↑k))
Karlin.FaithfulSevenFamily.main_theorem : ∀ (k : ℕ),
  3 ≤ k →
    ∃ m M a c,
      m + 1 = (k + 1) ^ 2 - 9 ∧
        Karlin.IsSkewSymmetric M ∧
          a 0 = 0 ∧
            (∀ (i : Fin (m + 1)), Karlin.FaithfulSevenFamily.counts a 0 i = 0) ∧
              Karlin.IsStrictTwoPlayerFPTrajectory M a a ∧
                (∀ (row col : ℕ → Fin (m + 1)),
                    Karlin.IsWeakTwoPlayerFPTrajectory M row col →
                      row 0 = 0 → col 0 = 0 → ∀ (t : ℕ), row t = a t ∧ col t = a t) ∧
                  0 < c ∧
                    Filter.Tendsto (fun t => ↑(Karlin.standardDualityGap M a a t) * ↑t ^ (1 / ↑k)) Filter.atTop
                        (nhds c) ∧
                      ((fun t => ↑(Karlin.standardDualityGap M a a t) / (c * ↑t ^ (-(1 / ↑k))) - 1) =O[Filter.atTop]
                          fun t => ↑t ^ (-(1 / ↑k))) ∧
                        ∃ T,
                          1 ≤ T ∧
                            ∀ (t : ℕ),
                              T ≤ t →
                                c / 2 * ↑t ^ (-(1 / ↑k)) ≤ ↑(Karlin.standardDualityGap M a a t) ∧
                                  ↑(Karlin.standardDualityGap M a a t) ≤ 2 * c * ↑t ^ (-(1 / ↑k))
@Karlin.FaithfulPaperCoverage.chosen_strictness : ∀ {k : ℕ} {P : Karlin.FaithfulClock.Clock k}
  (A : Karlin.FaithfulAdmissible.Admissible P),
  have T1 := Karlin.FaithfulController.firstScale A;
  have T2 := Karlin.FaithfulController.secondScale A T1;
  ∀ (q : ℕ),
    Karlin.FaithfulController.outerOnset A T1 T2 ≤ q →
      have h :=
        Karlin.FaithfulTables.parentTranslation P A.tau
          (Karlin.FaithfulGain.AdmissibleGain.selectedGain A (Karlin.FaithfulParameters.AdmissibleParameters.lam A) T1)
          (Karlin.FaithfulAdmissible.baseline P) q;
      have W := Karlin.FaithfulWindow.consecutiveWord P.word (A.tau * q) (A.tau * q);
      (∀ (j : Karlin.FaithfulNextClock.Lift.Res),
          ↑j + 1 < k + 1 + (k + 1) →
            Karlin.FaithfulActualWaiting.pullState A T1 T2 q (Sum.inr j) < P.entry (A.tau * q) P.b + h) ∧
        (∀ (j : Karlin.FaithfulNextClock.Lift.Res),
            ↑j + 1 = k + 1 + (k + 1) →
              Karlin.FaithfulActualWaiting.pullState A T1 T2 q (Sum.inr j) = P.entry (A.tau * q) P.b + h) ∧
          ∀ (j : Karlin.FaithfulNextClock.Lift.Res),
            k + 1 ≤ ↑j →
              ∀ (r : ℕ),
                0 < r →
                  r ≤ W.length →
                    Karlin.wordScore
                        (Karlin.liftedGameMat (Karlin.FaithfulGateway.game P)
                          (Karlin.FaithfulActualWaiting.pullCoupling A T1 T2) (Karlin.FaithfulNextClock.Lift.J A T1 T2))
                        (Karlin.FaithfulActualWaiting.pullState A T1 T2 q)
                        (Karlin.FaithfulWaiting.parentStage P (List.take r W)) (Sum.inr j) <
                      Karlin.FaithfulClock.height P.b (Karlin.wordScore P.A (P.entry (A.tau * q)) (List.take r W)) + h
@Karlin.FaithfulPaperCoverage.selected_chronology : ∀ {k : ℕ} {P : Karlin.FaithfulClock.Clock k}
  (A : Karlin.FaithfulAdmissible.Admissible P),
  have T1 := Karlin.FaithfulController.firstScale A;
  have T2 := Karlin.FaithfulController.secondScale A T1;
  ∀ (q : ℕ),
    Karlin.FaithfulController.outerOnset A T1 T2 ≤ q →
      Karlin.IsValidPriorityWord (Karlin.FaithfulNextClock.Lift.game A T1 T2)
          (Karlin.FaithfulNextClockAssembly.entryScore A T1 T2 q) Karlin.FaithfulNextClockAssembly.rank
          (List.map Sum.inl (Karlin.FaithfulNextClock.Lift.old A q) ++
            Karlin.FaithfulNextClockAssembly.reset A T1 T2 q) ∧
        Karlin.wordScore (Karlin.FaithfulNextClock.Lift.game A T1 T2)
              (Karlin.FaithfulNextClockAssembly.entryScore A T1 T2 q)
              (List.map Sum.inl (Karlin.FaithfulNextClock.Lift.old A q) ++
                Karlin.FaithfulNextClockAssembly.reset A T1 T2 q) =
            Karlin.FaithfulNextClockAssembly.entryScore A T1 T2 (q + 1) ∧
          ∀ r ≤ (Karlin.FaithfulNextClockAssembly.reset A T1 T2 q).length,
            Karlin.FaithfulInheritance.scoreHeight Karlin.FaithfulNextClock.Lift.base
                (Karlin.wordScore (Karlin.FaithfulNextClock.Lift.game A T1 T2)
                  (Karlin.FaithfulNextClockAssembly.entryScore A T1 T2 q)
                  (List.map Sum.inl (Karlin.FaithfulNextClock.Lift.old A q) ++
                    List.take r (Karlin.FaithfulNextClockAssembly.reset A T1 T2 q))) =
              Karlin.FaithfulNextClock.Lift.zeta A T1 ⬝ᵥ Karlin.binomBasis (k + 1) q
Karlin.FaithfulPaperCokernel.paper_moment_solvable_iff : ∀ (k : ℕ),
  0 < k →
    ∀ (F : Karlin.FaithfulPaperCokernel.Mat (k + 1)),
      (∃ E, Karlin.L_moment (Karlin.B_mat (k + 1)) E = F) ↔
        ∀ (h : ℕ), k ≤ h → h ≤ 2 * k → Even h → Karlin.matInnerProd (Karlin.Z_binom_concrete (k + 1) h) F = 0
@Karlin.FaithfulPaperAlgebra.clock_bundle_expansion_by_ordinary_powers : ∀ {k : ℕ} (P : Karlin.FaithfulClock.Clock k)
  (tau : ℕ),
  0 < tau →
    (fun q =>
        ∑ s ∈ Finset.Ico (tau * q) (2 * tau * q), ↑(P.word s).length -
          ↑(Karlin.FaithfulGrowthRecurrences.bundleLeading P tau) * ↑q ^ k) =O[Filter.atTop]
      fun q => ↑q ^ (k - 1)
@Karlin.FaithfulPaperBounds.clock_phase_boundary_ratios : ∀ {k : ℕ} (P : Karlin.FaithfulClock.Clock k),
  ((fun q =>
        ↑(Karlin.FaithfulRealization.phaseTime P (q + 1)) / ↑(Karlin.FaithfulRealization.phaseTime P q) -
          1) =O[Filter.atTop]
      fun q => 1 / ↑q) ∧
    (fun q =>
        ↑(Karlin.cumScore (Karlin.FaithfulRealization.game P) (Karlin.FaithfulRealization.play P)
                (Karlin.FaithfulRealization.phaseTime P (q + 1))
                (Karlin.FaithfulRealization.play P (Karlin.FaithfulRealization.phaseTime P (q + 1)))) /
            ↑(Karlin.cumScore (Karlin.FaithfulRealization.game P) (Karlin.FaithfulRealization.play P)
                (Karlin.FaithfulRealization.phaseTime P q)
                (Karlin.FaithfulRealization.play P (Karlin.FaithfulRealization.phaseTime P q))) -
          1) =O[Filter.atTop]
      fun q => 1 / ↑q
