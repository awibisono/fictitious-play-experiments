  x.eval x_1 =
    match x, x_1 with
    | Karlin.FaithfulEffectiveContract.UniversalProgram.machine c, eps =>
      Part.map (fun n => ↑n) ((Nat.Partrec.Code.ofNatCode c).eval (Karlin.FaithfulEffectiveContract.encodeRat eps))
