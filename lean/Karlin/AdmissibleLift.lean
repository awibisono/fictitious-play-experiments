theorem uniform_stage3_valid_M {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
