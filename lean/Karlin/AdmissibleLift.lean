/-!
## 37. Inductive Parity Locking, Leader Score Preservation, and Lifted Cone Vanishing
-/

open scoped Matrix

/-- 1. Entry `Sum.inr r0` of `liftedScoreMat` matches `zeta` when row `r0` of `J` vanishes. -/
theorem liftedScoreMat_inr_zero_eq_zeta
    {α β γ : Type*} [Fintype α] [Fintype β] [DecidableEq β]
    (G_O : Matrix α α ℚ) (J : Matrix β β ℚ)
    (S X : Matrix α γ ℚ) (M : Matrix β γ ℚ) (zeta : γ → ℚ)
    (r0 : β) (hJ0 : ∀ k : β, J r0 k = 0) (c : γ) :
    liftedScoreMat G_O J S X M zeta (Sum.inr r0) c = zeta c := by
  dsimp [liftedScoreMat, one_zeta]
  have hJM : (J * M) r0 c = 0 := by
    simp only [Matrix.mul_apply, hJ0, zero_mul, Finset.sum_const_zero]
  rw [hJM, sub_zero]

/-- The first early reset action (row `finSumFinEquiv (Sum.inl 0)`) in `J_lower_eta` has all entries 0. -/
theorem J_lower_eta_row_zero (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (k : Fin ((w + 1) + (w + 1))) :
    J_lower_eta w ell E eta (finSumFinEquiv (Sum.inl 0)) k = 0 := by
  obtain ⟨sk, rfl⟩ := finSumFinEquiv.surjective k
  simp only [J_lower_eta, Matrix.of_apply, Equiv.symm_apply_apply]
  cases sk with
  | inl j =>
    simp [L_strict]
  | inr j =>
    rfl

/-- Concrete specialization: in the lifted score table with `J_lower_eta`, the row of the
    first early reset action is IDENTICALLY `zeta c`. -/
theorem liftedScoreMat_J_lower_eta_inl_zero_eq_zeta
    {α : Type*} [Fintype α]
    (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (G_O : Matrix α α ℚ) (S X : Matrix α (Fin (w + 1)) ℚ) (zeta : Fin (w + 1) → ℚ)
    (c : Fin (w + 1)) :
    liftedScoreMat G_O (J_lower_eta w ell E eta) S X (M_lower w ell) zeta
      (Sum.inr (finSumFinEquiv (Sum.inl 0))) c = zeta c :=
  liftedScoreMat_inr_zero_eq_zeta G_O (J_lower_eta w ell E eta) S X (M_lower w ell) zeta
    (finSumFinEquiv (Sum.inl 0)) (J_lower_eta_row_zero w ell E eta) c

/-- 2. Phase-start leadership: The first reset action `b_new = Sum.inr r0` dominates
    any other reset action `r` whenever `(J * M) r · p(σ) ≥ 0`, and dominates old actions
    bounded by `zeta(σ)`. -/
theorem liftedScoreMat_inr_zero_leader_of_bounds
    {α β γ : Type*} [Fintype α] [Fintype β] [Fintype γ] [DecidableEq β]
    (G_O : Matrix α α ℚ) (J : Matrix β β ℚ)
    (S X : Matrix α γ ℚ) (M : Matrix β γ ℚ) (zeta : γ → ℚ)
    (r0 : β) (hJ0 : ∀ k : β, J r0 k = 0) (p : γ → ℚ)
    (h_old : ∀ i : α, dotProduct (fun c => (S + G_O * X) i c) p ≤ dotProduct zeta p)
    (h_reset : ∀ r : β, 0 ≤ dotProduct (fun c => (J * M) r c) p) :
    ∀ x : α ⊕ β,
      dotProduct (fun c => liftedScoreMat G_O J S X M zeta x c) p ≤
        dotProduct (fun c => liftedScoreMat G_O J S X M zeta (Sum.inr r0) c) p := by
  intro x
  have h_lead : (fun c => liftedScoreMat G_O J S X M zeta (Sum.inr r0) c) = zeta := by
    ext c
    exact liftedScoreMat_inr_zero_eq_zeta G_O J S X M zeta r0 hJ0 c
  rw [h_lead]
  cases x with
  | inl i =>
    dsimp [liftedScoreMat]
    exact h_old i
  | inr r =>
    dsimp [liftedScoreMat, one_zeta]
    have h_sub : (fun c => zeta c - (J * M) r c) = zeta - (fun c => (J * M) r c) := rfl
    rw [h_sub, sub_dotProduct]
    have hr := h_reset r
    linarith

/-- Universal column-shift vanishing: Any matrix whose columns $c \ge 1$ vanish satisfies
    `Delta * N_mat w = 0`. -/
theorem delta_mul_N_mat_eq_zero {w : ℕ} (Delta : Matrix (Fin w) (Fin w) ℚ)
    (hDelta : ∀ i (c : Fin w), 0 < c.val → Delta i c = 0) :
    Delta * N_mat w = 0 := by
  ext i k
  rw [Matrix.mul_apply, Matrix.zero_apply]
  by_cases hk : k.val + 1 < w
  · have hN : ∀ c : Fin w, N_mat w c k = if c = ⟨k.val + 1, hk⟩ then 1 else 0 := by
      intro c
      by_cases hc : c = ⟨k.val + 1, hk⟩
      · subst hc
        simp [N_mat]
      · have hval : c.val ≠ k.val + 1 := fun h => hc (Fin.ext h)
        simp [N_mat, hc, hval]
    simp_rw [hN]
    rw [Finset.sum_eq_single ⟨k.val + 1, hk⟩]
    · simp only [↓reduceIte, mul_one]
      exact hDelta i ⟨k.val + 1, hk⟩ (Nat.succ_pos k.val)
    · intro c _ hc
      simp [hc]
    · intro h; exfalso; exact h (Finset.mem_univ _)
  · have hle : w ≤ k.val + 1 := not_lt.mp hk
    have hN : ∀ c : Fin w, N_mat w c k = 0 := by
      intro c
      have hc : c.val < w := c.isLt
      have hnot : c.val ≠ k.val + 1 := by omega
      simp [N_mat, hnot]
    simp [hN]

/-- 4. Universal clock cone vanishing: If the product Delta = Cᵀ * R satisfies Delta_{i, c} = 0
    for all c > 0, then Cᵀ * G * C = 0 identically. -/
theorem clock_CGC_zero_of_delta_cols_zero {w : ℕ} (clock : AlgebraicClock w)
    (hDelta : ∀ i (c : Fin w), 0 < c.val → (clock.C.transpose * clock.R) i c = 0) :
    clock.C.transpose * clock.G * clock.C = 0 := by
  rw [clock.cone_identity]
  exact delta_mul_N_mat_eq_zero (clock.C.transpose * clock.R) hDelta

/-- Column sum of `M_lower` with integer weights `u` is `2 * u c`. -/
theorem sum_M_lower_eq_two_u (w : ℕ) (u : Fin (w + 1) → ℚ) (c : Fin (w + 1)) :
    (∑ r : Fin ((w + 1) + (w + 1)), M_lower w (fun j => 2 * u j) r c) = 2 * u c := by
  have hc := (Equiv.sum_comp finSumFinEquiv (fun r => M_lower w (fun j => 2 * u j) r c)).symm
  rw [hc, Fintype.sum_sum_type]
  have hu : (fun j => (2 * u j) / 2) = u := by
    ext j; ring
  simp only [M_lower, Matrix.of_apply, Equiv.symm_apply_apply, W_lower_u, hu]
  have h1 : (∑ i : Fin (w + 1), W_lower w u i c) = u c := by
    have hvec := congr_fun (vecMul_one_W_lower w u) c
    dsimp [Matrix.vecMul, dotProduct] at hvec
    simp only [one_mul] at hvec
    exact hvec
  rw [h1]
  ring

/-- 3. Parity identity: `colsum(C_{w+1}) - R_{w+1}(b_new, c) = (y_sum c + 2 u c) - zeta c`. -/
theorem colsum_liftedCountMat_sub_zeta {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 : ℚ)
    (u : Fin (w + 1) → ℚ) (c : Fin (w + 1)) :
    (∑ x : Fin (clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
      liftedCountMat (X_gateway clock) (M_lower w (fun j => 2 * u j)) (N_mat (w + 1)) x c) -
    zeta_canonical hw clock b c_step H0 c =
    (y_sum_uniform clock c + 2 * u c) - zeta_canonical hw clock b c_step H0 c := by
  have hcomp : (∑ x : Fin (clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
      liftedCountMat (X_gateway clock) (M_lower w (fun j => 2 * u j)) (N_mat (w + 1)) x c) =
    (∑ i : Fin (clock.m + 1), (X_gateway clock * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) i c) +
    (∑ r : Fin ((w + 1) + (w + 1)), M_lower w (fun j => 2 * u j) r c) := by
    rw [Fintype.sum_sum_type]
    rfl
  rw [hcomp, sum_M_lower_eq_two_u w u c]
  have hy : (∑ i : Fin (clock.m + 1), (X_gateway clock * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) i c) =
      y_sum_uniform clock c := by
    dsimp [y_sum_uniform, x_sum_uniform]
    rw [Matrix.vecMul_vecMul]
    dsimp [Matrix.vecMul, dotProduct]
    simp only [one_mul]
  rw [hy]

/-- 3. Exact Parity Locking: When `2 u c = (2 * m + 1) * zeta c - y_sum c` with `zeta c = (z : ℚ)`,
    the next column sum minus the new leader score is an exact even integer `2 * (m * z)`. -/
theorem colsum_sub_zeta_even_of_odd_alpha {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 : ℚ)
    (u : Fin (w + 1) → ℚ) (m : ℤ) (z : ℤ) (c : Fin (w + 1))
    (h_zeta : zeta_canonical hw clock b c_step H0 c = (z : ℚ))
    (h_u : 2 * u c = (2 * (m : ℚ) + 1) * zeta_canonical hw clock b c_step H0 c - y_sum_uniform clock c) :
    (∑ x : Fin (clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
      liftedCountMat (X_gateway clock) (M_lower w (fun j => 2 * u j)) (N_mat (w + 1)) x c) -
    zeta_canonical hw clock b c_step H0 c = 2 * ((m * z : ℤ) : ℚ) := by
  rw [colsum_liftedCountMat_sub_zeta hw clock b c_step H0 u c]
  rw [h_u, h_zeta]
  push_cast
  ring

/-- Parity Locking with 3-Scaled Profile: When `3 * zeta c = (z : ℚ)` and
    `2 u c = 3 * (2 * m + 1) * zeta c - y_sum c`, the column sum equals `(2 * m + 1) * z`
    and the column sum minus `3 * zeta c` equals `2 * (m * z)`. -/
theorem colsum_sub_three_zeta_even_of_odd_mul_three_alpha {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 : ℚ)
    (u : Fin (w + 1) → ℚ) (m : ℤ) (z : ℤ) (c : Fin (w + 1))
    (h_zeta : 3 * zeta_canonical hw clock b c_step H0 c = (z : ℚ))
    (h_u : 2 * u c = 3 * (2 * (m : ℚ) + 1) * zeta_canonical hw clock b c_step H0 c - y_sum_uniform clock c) :
    ((∑ x : Fin (clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
      liftedCountMat (X_gateway clock) (M_lower w (fun j => 2 * u j)) (N_mat (w + 1)) x c) = ((2 * m + 1) * z : ℤ)) ∧
    ((∑ x : Fin (clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
      liftedCountMat (X_gateway clock) (M_lower w (fun j => 2 * u j)) (N_mat (w + 1)) x c) -
      3 * zeta_canonical hw clock b c_step H0 c = 2 * ((m * z : ℤ) : ℚ)) := by
  have hcol : (∑ x : Fin (clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
      liftedCountMat (X_gateway clock) (M_lower w (fun j => 2 * u j)) (N_mat (w + 1)) x c) =
      y_sum_uniform clock c + 2 * u c := by
    have hcomp : (∑ x : Fin (clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
        liftedCountMat (X_gateway clock) (M_lower w (fun j => 2 * u j)) (N_mat (w + 1)) x c) =
      (∑ i : Fin (clock.m + 1), (X_gateway clock * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) i c) +
      (∑ r : Fin ((w + 1) + (w + 1)), M_lower w (fun j => 2 * u j) r c) := by
      rw [Fintype.sum_sum_type]
      rfl
    rw [hcomp, sum_M_lower_eq_two_u w u c]
    have hy : (∑ i : Fin (clock.m + 1), (X_gateway clock * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) i c) =
        y_sum_uniform clock c := by
      dsimp [y_sum_uniform, x_sum_uniform]
      rw [Matrix.vecMul_vecMul]
      dsimp [Matrix.vecMul, dotProduct]
      simp only [one_mul]
    rw [hy]
  have h1 : (∑ x : Fin (clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
      liftedCountMat (X_gateway clock) (M_lower w (fun j => 2 * u j)) (N_mat (w + 1)) x c) =
      ((2 * m + 1) * z : ℤ) := by
    rw [hcol, h_u]
    have h_alg : y_sum_uniform clock c + (3 * (2 * (m : ℚ) + 1) * zeta_canonical hw clock b c_step H0 c - y_sum_uniform clock c) =
        (2 * (m : ℚ) + 1) * (3 * zeta_canonical hw clock b c_step H0 c) := by ring
    rw [h_alg, h_zeta]
    push_cast
    ring
  refine ⟨h1, ?_⟩
  rw [h1]
  push_cast
  rw [h_zeta]
  ring

/-- Value of `x_sum_uniform` at coordinate 0 is 1. -/
theorem x_sum_uniform_zero {w : ℕ} (clock : AlgebraicClock w) :
    x_sum_uniform clock 0 = 1 := by
  dsimp [x_sum_uniform, Matrix.vecMul, dotProduct]
  have hcomp := (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) => (1 : ℚ) * X_gateway clock y 0).symm
  rw [hcomp, Fintype.sum_sum_type]
  have hX_inl : ∀ j : Fin clock.m, X_gateway clock (finSumFinEquiv (Sum.inl j)) 0 = 0 := by
    intro j
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, shiftRightCount]
    simp
  have hX_inr : ∀ j : Fin 1, X_gateway clock (finSumFinEquiv (Sum.inr j)) 0 = 1 := by
    intro j
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, e0_row]
    rfl
  simp only [one_mul, hX_inl, Finset.sum_const_zero, zero_add, hX_inr, Fin.sum_univ_one]

/-- Formula for `x_sum_uniform` on positive coordinates `c > 0`. -/
theorem x_sum_uniform_pos {w : ℕ} (clock : AlgebraicClock w) (c : Fin (w + 1)) (hc : 0 < c.val) :
    x_sum_uniform clock c = ∑ i : Fin clock.m, clock.C i ⟨c.val - 1, by omega⟩ := by
  dsimp [x_sum_uniform, Matrix.vecMul, dotProduct]
  have hcomp := (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) => (1 : ℚ) * X_gateway clock y c).symm
  rw [hcomp, Fintype.sum_sum_type]
  have he0_c : e0_row (w + 1) c = 0 := by
    simp only [e0_row]
    split_ifs with h
    · omega
    · rfl
  have hX_inr : ∀ j : Fin 1, X_gateway clock (finSumFinEquiv (Sum.inr j)) c = 0 := by
    intro j
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, he0_c]
  have hX_inl : ∀ j : Fin clock.m, X_gateway clock (finSumFinEquiv (Sum.inl j)) c = clock.C j ⟨c.val - 1, by omega⟩ := by
    intro j
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, shiftRightCount, hc]
    rfl
  simp only [one_mul, hX_inr, Finset.sum_const_zero, add_zero, hX_inl]

/-- Unfolding formula for `y_sum_uniform`. -/
theorem y_sum_uniform_apply {w : ℕ} (clock : AlgebraicClock w) (c : Fin (w + 1)) :
    y_sum_uniform clock c = x_sum_uniform clock c +
      if hc : c.val + 1 < w + 1 then x_sum_uniform clock ⟨c.val + 1, hc⟩ else 0 := by
  dsimp [y_sum_uniform]
  rw [Matrix.vecMul_add, Matrix.vecMul_one, Pi.add_apply]
  rw [vecMul_N_mat_apply]

theorem U_mat_zero (k i : ℕ) : U_mat (fun _ _ => 0) k i = 0 := by
  induction k using Nat.strong_induction_on generalizing i with
  | h k ih =>
    cases k with
    | zero => rfl
    | succ k =>
      cases k with
      | zero => rfl
      | succ k =>
        cases k with
        | zero =>
          dsimp [U_mat]
          ring
        | succ k =>
          dsimp [U_mat]
          have h1 := ih (k + 1) (by omega) (i + 1)
          have h2 := ih (k + 2) (by omega) (i + 1)
          rw [h1, h2]
          ring

theorem ell_seq_zero (w : ℕ) (v : ℕ → ℚ) (m : ℕ) :
    ell_seq w (fun _ _ => 0) v m = fun _ => 0 := by
  induction m with
  | zero => rfl
  | succ m ih =>
    dsimp [ell_seq]
    rw [ih]
    have hG : G_with_ell (fun _ _ => 0) v (fun _ => 0) = fun _ _ => 0 := by
      ext a b
      simp [G_with_ell]
    rw [hG]
    have hU : U_mat (fun _ _ => 0) (m + 1) (w - 1 - m) = 0 := U_mat_zero (m + 1) (w - 1 - m)
    rw [hU]
    ext a
    split_ifs <;> ring

/-- Universal vanishing of `F_inner_uniform` whenever $C^\top G C = 0$. -/
theorem F_inner_uniform_eq_zero_of_CGC_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (hCGC : clock.C.transpose * clock.G * clock.C = 0) :
    F_inner_uniform hw clock b c_step H0 delta = 0 := by
  ext i j
  simp only [F_inner_uniform, Matrix.of_apply, Matrix.zero_apply]
  split_ifs with h
  · rfl
  · push_neg at h
    have h1 : 0 < i.val := Nat.pos_of_ne_zero h.1
    have h2 : 0 < j.val := Nat.pos_of_ne_zero h.2
    exact F_gw_uniform_supp_of_CGC_zero hw clock b c_step H0 delta hCGC i j h1 h2

/-- Universal vanishing of `G_inner_uniform` whenever $C^\top G C = 0$. -/
theorem G_inner_uniform_eq_zero_of_CGC_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (hCGC : clock.C.transpose * clock.G * clock.C = 0) :
    G_inner_uniform hw clock b c_step H0 delta = fun _ _ => 0 := by
  ext i j
  dsimp [G_inner_uniform]
  split_ifs with hi hj
  · rw [F_inner_uniform_eq_zero_of_CGC_zero hw clock b c_step H0 delta hCGC]
    simp
  · rfl
  · rfl

/-- Universal vanishing of `ell_inner_uniform` whenever $C^\top G C = 0$. -/
theorem ell_inner_uniform_eq_zero_of_CGC_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (hCGC : clock.C.transpose * clock.G * clock.C = 0) :
    ell_inner_uniform hw clock b c_step H0 delta = 0 := by
  ext i
  dsimp [ell_inner_uniform]
  rw [G_inner_uniform_eq_zero_of_CGC_zero hw clock b c_step H0 delta hCGC]
  rw [ell_seq_zero]

/-- Identification `ell_uniform_total = ell_uniform` when $C^\top G C = 0$. -/
theorem ell_uniform_total_eq_ell_uniform_of_CGC_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta alpha : ℚ) (hCGC : clock.C.transpose * clock.G * clock.C = 0) :
    ell_uniform_total hw clock b c_step H0 delta alpha =
      ell_uniform hw clock b c_step H0 alpha := by
  ext c
  simp only [ell_uniform_total, Pi.add_apply]
  rw [ell_inner_uniform_eq_zero_of_CGC_zero hw clock b c_step H0 delta hCGC]
  simp

theorem zeta_canonical_succ_val {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) (c : Fin (w + 1)) (hc : 0 < c.val) :
    zeta_canonical hw clock b c_step H0 c =
      v_step hw clock b c_step ⟨c.val - 1, by omega⟩ +
        v_step hw clock b c_step c := by
  dsimp [zeta_canonical]
  have hne : ¬ (c.val = 0) := by omega
  rw [if_neg hne]
  simp only [Matrix.vecMul_add, Matrix.vecMul_one, Pi.add_apply]
  rw [vecMul_N_mat_apply]
  have hlt : c.val - 1 + 1 < w + 1 := by
    have := c.isLt
    omega
  simp only [hlt, ↓reduceDIte]
  have heq : (⟨c.val - 1 + 1, hlt⟩ : Fin (w + 1)) = c := by ext; dsimp; omega
  rw [heq]

theorem zeta_canonical_zero {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) :
    zeta_canonical hw clock b c_step H0 0 = H0 := rfl

theorem zeta_canonical_one {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) :
    zeta_canonical (by omega) clock b c_step H0 ⟨1, by omega⟩ =
      c_step + clock.R b ⟨1, by omega⟩ := by
  have hpos : 0 < (⟨1, by omega⟩ : Fin (w + 1)).val := by dsimp; omega
  have h := zeta_canonical_succ_val (by omega) clock b c_step H0 ⟨1, by omega⟩ hpos
  have h0 : (⟨1 - 1, by omega⟩ : Fin (w + 1)) = ⟨0, Nat.succ_pos w⟩ := by ext; rfl
  rw [h0] at h
  rw [h, v_step_zero (by omega) clock b c_step]
  rw [v_step_pos (by omega) clock b c_step ⟨1, by omega⟩ hpos]
  have h1_lt : (⟨1, by omega⟩ : Fin (w + 1)).val < w := by dsimp; omega
  simp only [h1_lt, ↓reduceDIte]

theorem zeta_canonical_ge_two_lt {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) (c : Fin (w + 1)) (hc2 : 2 ≤ c.val) (hcw : c.val < w) :
    zeta_canonical (by omega) clock b c_step H0 c =
      clock.R b ⟨c.val - 1, by omega⟩ + clock.R b ⟨c.val, hcw⟩ := by
  have hc_pos : 0 < c.val := by omega
  have h := zeta_canonical_succ_val (by omega) clock b c_step H0 c hc_pos
  rw [h]
  have hprev_pos : 0 < (⟨c.val - 1, by omega⟩ : Fin (w + 1)).val := by dsimp; omega
  rw [v_step_pos (by omega) clock b c_step ⟨c.val - 1, by omega⟩ hprev_pos]
  have hprev_lt : (⟨c.val - 1, by omega⟩ : Fin (w + 1)).val < w := by dsimp; omega
  simp only [hprev_lt, ↓reduceDIte]
  rw [v_step_pos (by omega) clock b c_step c hc_pos]
  simp only [hcw, ↓reduceDIte]

theorem zeta_canonical_top {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) :
    zeta_canonical (by omega) clock b c_step H0 ⟨w, Nat.lt_succ_self w⟩ =
      clock.R b ⟨w - 1, by omega⟩ := by
  have hpos : 0 < (⟨w, Nat.lt_succ_self w⟩ : Fin (w + 1)).val := by dsimp; omega
  have h := zeta_canonical_succ_val (by omega) clock b c_step H0 ⟨w, Nat.lt_succ_self w⟩ hpos
  rw [h, v_step_top (by omega) clock b c_step, add_zero]
  have hprev_pos : 0 < (⟨w - 1, by omega⟩ : Fin (w + 1)).val := by dsimp; omega
  rw [v_step_pos (by omega) clock b c_step ⟨w - 1, by omega⟩ hprev_pos]
  have hprev_lt : (⟨w - 1, by omega⟩ : Fin (w + 1)).val < w := by dsimp; omega
  simp only [hprev_lt, ↓reduceDIte]

theorem y_sum_uniform_zero {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) :
    y_sum_uniform clock 0 = 1 + ∑ i : Fin clock.m, clock.C i ⟨0, hw⟩ := by
  rw [y_sum_uniform_apply, x_sum_uniform_zero]
  have hlt : (0 : Fin (w + 1)).val + 1 < w + 1 := by dsimp; omega
  rw [dif_pos hlt]
  have hpos : 0 < (⟨(0 : Fin (w + 1)).val + 1, hlt⟩ : Fin (w + 1)).val := by dsimp; omega
  rw [x_sum_uniform_pos clock ⟨(0 : Fin (w + 1)).val + 1, hlt⟩ hpos]
  have heq : (⟨(0 : Fin (w + 1)).val + 1 - 1, by omega⟩ : Fin w) = ⟨0, hw⟩ := by ext; rfl
  rw [heq]

theorem y_sum_uniform_one {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) :
    y_sum_uniform clock ⟨1, by omega⟩ =
      (∑ i : Fin clock.m, clock.C i ⟨0, by omega⟩) +
        (∑ i : Fin clock.m, clock.C i ⟨1, by omega⟩) := by
  rw [y_sum_uniform_apply]
  have hpos1 : 0 < (⟨1, by omega⟩ : Fin (w + 1)).val := by dsimp; omega
  rw [x_sum_uniform_pos clock ⟨1, by omega⟩ hpos1]
  have hlt : (⟨1, by omega⟩ : Fin (w + 1)).val + 1 < w + 1 := by dsimp; omega
  rw [dif_pos hlt]
  have hpos2 : 0 < (⟨(⟨1, by omega⟩ : Fin (w + 1)).val + 1, hlt⟩ : Fin (w + 1)).val := by dsimp; omega
  rw [x_sum_uniform_pos clock ⟨(⟨1, by omega⟩ : Fin (w + 1)).val + 1, hlt⟩ hpos2]
  have heq0 : (⟨(⟨1, by omega⟩ : Fin (w + 1)).val - 1, by omega⟩ : Fin w) = ⟨0, by omega⟩ := by ext; rfl
  have heq1 : (⟨(⟨1, by omega⟩ : Fin (w + 1)).val + 1 - 1, by omega⟩ : Fin w) = ⟨1, by omega⟩ := by ext; rfl
  rw [heq0, heq1]

theorem y_sum_uniform_ge_two_lt {w : ℕ} (_hw : 2 ≤ w) (clock : AlgebraicClock w)
    (c : Fin (w + 1)) (hc2 : 2 ≤ c.val) (hcw : c.val < w) :
    y_sum_uniform clock c =
      (∑ i : Fin clock.m, clock.C i ⟨c.val - 1, by omega⟩) +
        (∑ i : Fin clock.m, clock.C i ⟨c.val, hcw⟩) := by
  rw [y_sum_uniform_apply]
  have hc_pos : 0 < c.val := by omega
  rw [x_sum_uniform_pos clock c hc_pos]
  have hlt : c.val + 1 < w + 1 := by omega
  rw [dif_pos hlt]
  have hpos_next : 0 < (⟨c.val + 1, hlt⟩ : Fin (w + 1)).val := by dsimp; omega
  rw [x_sum_uniform_pos clock ⟨c.val + 1, hlt⟩ hpos_next]
  rfl

theorem y_sum_uniform_top {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) :
    y_sum_uniform clock ⟨w, Nat.lt_succ_self w⟩ =
      ∑ i : Fin clock.m, clock.C i ⟨w - 1, by omega⟩ := by
  rw [y_sum_uniform_apply]
  have hpos : 0 < (⟨w, Nat.lt_succ_self w⟩ : Fin (w + 1)).val := by dsimp; omega
  rw [x_sum_uniform_pos clock ⟨w, Nat.lt_succ_self w⟩ hpos]
  have hnot : ¬ ((⟨w, Nat.lt_succ_self w⟩ : Fin (w + 1)).val + 1 < w + 1) := by dsimp; omega
  rw [dif_neg hnot, add_zero]

/-- Concrete Parity Step: At order `w ≥ 2`, when `Cᵀ G C = 0`, the top row score is 1,
    column 0 sum is an integer, and columns `c > 0` satisfy the parity condition,
    then with odd scaling `alpha = 2 m + 1`, the new canonical profile `zeta_canonical`
    is integer-valued, `zeta_canonical - y_sum` is even-integer-valued,
    and the total reset vector `ell_uniform_total` is identically even-integer-valued. -/
theorem ell_uniform_total_even_of_colsum_sub_R_even {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 c_step delta alpha : ℚ)
    (hCGC : clock.C.transpose * clock.G * clock.C = 0)
    (hb_top : clock.R b ⟨w - 1, by omega⟩ = 1)
    (hcol0 : ∃ z0 : ℤ, (∑ i, clock.C i ⟨0, by omega⟩) = (z0 : ℚ))
    (hparity : ∀ c : Fin w, 0 < c.val → ∃ k : ℤ, (∑ i, clock.C i c) - clock.R b c = 2 * (k : ℚ))
    (hR_int : ∀ c : Fin w, 0 < c.val → ∃ z : ℤ, clock.R b c = (z : ℚ))
    (k_step k_H0 m_alpha : ℤ)
    (hc_step : c_step = (∑ i, clock.C i ⟨0, by omega⟩) + 2 * (k_step : ℚ))
    (hH0 : H0 = 1 + (∑ i, clock.C i ⟨0, by omega⟩) + 2 * (k_H0 : ℚ))
    (halpha : alpha = 2 * (m_alpha : ℚ) + 1) :
    (∀ c : Fin (w + 1), ∃ z : ℤ, zeta_canonical (by omega) clock b c_step H0 c = (z : ℚ)) ∧
    (∀ c : Fin (w + 1), ∃ k : ℤ, zeta_canonical (by omega) clock b c_step H0 c - y_sum_uniform clock c = 2 * (k : ℚ)) ∧
    (∀ c : Fin (w + 1), ∃ k : ℤ, ell_uniform_total hw clock b c_step H0 delta alpha c = 2 * (k : ℚ)) := by
  obtain ⟨z0, hz0⟩ := hcol0
  have hzeta : ∀ c : Fin (w + 1), ∃ z : ℤ, zeta_canonical (by omega) clock b c_step H0 c = (z : ℚ) := by
    intro c
    by_cases hc0 : c.val = 0
    · have heq0 : c = 0 := Fin.ext hc0
      subst heq0
      rw [zeta_canonical_zero (by omega), hH0, hz0]
      refine ⟨1 + z0 + 2 * k_H0, by push_cast; ring⟩
    · by_cases hc1 : c.val = 1
      · have heq1 : c = ⟨1, by omega⟩ := Fin.ext hc1
        rw [heq1]
        rw [zeta_canonical_one hw, hc_step, hz0]
        obtain ⟨z1, hz1⟩ := hR_int ⟨1, by omega⟩ (by dsimp; omega)
        rw [hz1]
        refine ⟨z0 + 2 * k_step + z1, by push_cast; ring⟩
      · by_cases hcw : c.val < w
        · have hc2 : 2 ≤ c.val := by omega
          rw [zeta_canonical_ge_two_lt hw clock b c_step H0 c hc2 hcw]
          obtain ⟨zp, hzp⟩ := hR_int ⟨c.val - 1, by omega⟩ (by dsimp; omega)
          obtain ⟨zc, hzc⟩ := hR_int ⟨c.val, hcw⟩ (by dsimp; omega)
          rw [hzp, hzc]
          refine ⟨zp + zc, by push_cast; ring⟩
        · have h_lt := c.isLt
          have hc_val : c.val = w := by omega
          have hc_top : c = ⟨w, Nat.lt_succ_self w⟩ := Fin.ext hc_val
          rw [hc_top]
          rw [zeta_canonical_top hw, hb_top]
          refine ⟨1, by push_cast; ring⟩
  have hdiff : ∀ c : Fin (w + 1), ∃ k : ℤ, zeta_canonical (by omega) clock b c_step H0 c - y_sum_uniform clock c = 2 * (k : ℚ) := by
    intro c
    by_cases hc0 : c.val = 0
    · have heq0 : c = 0 := Fin.ext hc0
      subst heq0
      rw [zeta_canonical_zero (by omega), y_sum_uniform_zero (by omega), hH0]
      refine ⟨k_H0, by ring⟩
    · by_cases hc1 : c.val = 1
      · have heq1 : c = ⟨1, by omega⟩ := Fin.ext hc1
        rw [heq1]
        rw [zeta_canonical_one hw, y_sum_uniform_one hw, hc_step]
        obtain ⟨k1, hk1⟩ := hparity ⟨1, by omega⟩ (by dsimp; omega)
        refine ⟨k_step - k1, ?_⟩
        push_cast
        linarith
      · by_cases hcw : c.val < w
        · have hc2 : 2 ≤ c.val := by omega
          rw [zeta_canonical_ge_two_lt hw clock b c_step H0 c hc2 hcw]
          rw [y_sum_uniform_ge_two_lt hw clock c hc2 hcw]
          obtain ⟨kp, hkp⟩ := hparity ⟨c.val - 1, by omega⟩ (by dsimp; omega)
          obtain ⟨kc, hkc⟩ := hparity ⟨c.val, hcw⟩ (by dsimp; omega)
          refine ⟨- kp - kc, ?_⟩
          push_cast
          linarith
        · have h_lt := c.isLt
          have hc_val : c.val = w := by omega
          have hc_top : c = ⟨w, Nat.lt_succ_self w⟩ := Fin.ext hc_val
          rw [hc_top]
          rw [zeta_canonical_top hw, y_sum_uniform_top hw]
          obtain ⟨kw, hkw⟩ := hparity ⟨w - 1, by omega⟩ (by dsimp; omega)
          refine ⟨- kw, ?_⟩
          push_cast
          linarith
  refine ⟨hzeta, hdiff, ?_⟩
  intro c
  obtain ⟨z, hz⟩ := hzeta c
  obtain ⟨k, hk⟩ := hdiff c
  rw [ell_uniform_total_eq_ell_uniform_of_CGC_zero hw clock b c_step H0 delta alpha hCGC]
  dsimp [ell_uniform]
  rw [halpha]
  refine ⟨m_alpha * z + k, ?_⟩
  push_cast
  have h_alg : (2 * (m_alpha : ℚ) + 1) * zeta_canonical (by omega) clock b c_step H0 c - y_sum_uniform clock c =
      2 * (m_alpha : ℚ) * zeta_canonical (by omega) clock b c_step H0 c +
        (zeta_canonical (by omega) clock b c_step H0 c - y_sum_uniform clock c) := by ring
  rw [h_alg, hk, hz]
  ring

/-- Concrete 3-Scaled Parity Step: At order `w ≥ 2`, when `Cᵀ G C = 0`, the top row score is 1,
    column 0 sum is an integer, and columns `c > 0` satisfy the 3-scaled parity condition,
    then with 3-scaled odd scaling `alpha = 3 * (2 m + 1)`, the new canonical profile `3 * zeta_canonical`
    is integer-valued, `3 * zeta_canonical - y_sum` is even-integer-valued,
    and the total reset vector `ell_uniform_total` is identically even-integer-valued. -/
theorem ell_uniform_total_even_of_colsum_sub_three_R_even {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 c_step delta alpha : ℚ)
    (hCGC : clock.C.transpose * clock.G * clock.C = 0)
    (hb_top : clock.R b ⟨w - 1, by omega⟩ = 1)
    (hcol0 : ∃ z0 : ℤ, (∑ i, clock.C i ⟨0, by omega⟩) = (z0 : ℚ))
    (hparity : ∀ c : Fin w, 0 < c.val → ∃ k : ℤ, (∑ i, clock.C i c) - 3 * clock.R b c = 2 * (k : ℚ))
    (hR_int : ∀ c : Fin w, 0 < c.val → ∃ z : ℤ, 3 * clock.R b c = (z : ℚ))
    (k_step k_H0 m_alpha : ℤ)
    (hc_step : 3 * c_step = (∑ i, clock.C i ⟨0, by omega⟩) + 2 * (k_step : ℚ))
    (hH0 : 3 * H0 = 1 + (∑ i, clock.C i ⟨0, by omega⟩) + 2 * (k_H0 : ℚ))
    (halpha : alpha = 3 * (2 * (m_alpha : ℚ) + 1)) :
    (∀ c : Fin (w + 1), ∃ z : ℤ, 3 * zeta_canonical (by omega) clock b c_step H0 c = (z : ℚ)) ∧
    (∀ c : Fin (w + 1), ∃ k : ℤ, 3 * zeta_canonical (by omega) clock b c_step H0 c - y_sum_uniform clock c = 2 * (k : ℚ)) ∧
    (∀ c : Fin (w + 1), ∃ k : ℤ, ell_uniform_total hw clock b c_step H0 delta alpha c = 2 * (k : ℚ)) := by
  obtain ⟨z0, hz0⟩ := hcol0
  have hzeta : ∀ c : Fin (w + 1), ∃ z : ℤ, 3 * zeta_canonical (by omega) clock b c_step H0 c = (z : ℚ) := by
    intro c
    by_cases hc0 : c.val = 0
    · have heq0 : c = 0 := Fin.ext hc0
      subst heq0
      rw [zeta_canonical_zero (by omega), hH0, hz0]
      refine ⟨1 + z0 + 2 * k_H0, by push_cast; ring⟩
    · by_cases hc1 : c.val = 1
      · have heq1 : c = ⟨1, by omega⟩ := Fin.ext hc1
        rw [heq1]
        rw [zeta_canonical_one hw]
        have h_step_distrib : 3 * (c_step + clock.R b ⟨1, by omega⟩) = 3 * c_step + 3 * clock.R b ⟨1, by omega⟩ := by ring
        rw [h_step_distrib, hc_step, hz0]
        obtain ⟨z1, hz1⟩ := hR_int ⟨1, by omega⟩ (by dsimp; omega)
        rw [hz1]
        refine ⟨z0 + 2 * k_step + z1, by push_cast; ring⟩
      · by_cases hcw : c.val < w
        · have hc2 : 2 ≤ c.val := by omega
          rw [zeta_canonical_ge_two_lt hw clock b c_step H0 c hc2 hcw]
          have h_distrib : 3 * (clock.R b ⟨c.val - 1, by omega⟩ + clock.R b ⟨c.val, hcw⟩) =
              3 * clock.R b ⟨c.val - 1, by omega⟩ + 3 * clock.R b ⟨c.val, hcw⟩ := by ring
          rw [h_distrib]
          obtain ⟨zp, hzp⟩ := hR_int ⟨c.val - 1, by omega⟩ (by dsimp; omega)
          obtain ⟨zc, hzc⟩ := hR_int ⟨c.val, hcw⟩ (by dsimp; omega)
          rw [hzp, hzc]
          refine ⟨zp + zc, by push_cast; ring⟩
        · have h_lt := c.isLt
          have hc_val : c.val = w := by omega
          have hc_top : c = ⟨w, Nat.lt_succ_self w⟩ := Fin.ext hc_val
          rw [hc_top]
          rw [zeta_canonical_top hw, hb_top]
          refine ⟨3, by push_cast; ring⟩
  have hdiff : ∀ c : Fin (w + 1), ∃ k : ℤ, 3 * zeta_canonical (by omega) clock b c_step H0 c - y_sum_uniform clock c = 2 * (k : ℚ) := by
    intro c
    by_cases hc0 : c.val = 0
    · have heq0 : c = 0 := Fin.ext hc0
      subst heq0
      rw [zeta_canonical_zero (by omega), y_sum_uniform_zero (by omega), hH0]
      refine ⟨k_H0, by ring⟩
    · by_cases hc1 : c.val = 1
      · have heq1 : c = ⟨1, by omega⟩ := Fin.ext hc1
        rw [heq1]
        rw [zeta_canonical_one hw, y_sum_uniform_one hw]
        have h_step_distrib : 3 * (c_step + clock.R b ⟨1, by omega⟩) = 3 * c_step + 3 * clock.R b ⟨1, by omega⟩ := by ring
        rw [h_step_distrib, hc_step]
        obtain ⟨k1, hk1⟩ := hparity ⟨1, by omega⟩ (by dsimp; omega)
        refine ⟨k_step - k1, ?_⟩
        push_cast
        linarith
      · by_cases hcw : c.val < w
        · have hc2 : 2 ≤ c.val := by omega
          rw [zeta_canonical_ge_two_lt hw clock b c_step H0 c hc2 hcw]
          rw [y_sum_uniform_ge_two_lt hw clock c hc2 hcw]
          have h_distrib : 3 * (clock.R b ⟨c.val - 1, by omega⟩ + clock.R b ⟨c.val, hcw⟩) =
              3 * clock.R b ⟨c.val - 1, by omega⟩ + 3 * clock.R b ⟨c.val, hcw⟩ := by ring
          rw [h_distrib]
          obtain ⟨kp, hkp⟩ := hparity ⟨c.val - 1, by omega⟩ (by dsimp; omega)
          obtain ⟨kc, hkc⟩ := hparity ⟨c.val, hcw⟩ (by dsimp; omega)
          refine ⟨- kp - kc, ?_⟩
          push_cast
          linarith
        · have h_lt := c.isLt
          have hc_val : c.val = w := by omega
          have hc_top : c = ⟨w, Nat.lt_succ_self w⟩ := Fin.ext hc_val
          rw [hc_top]
          rw [zeta_canonical_top hw, y_sum_uniform_top hw]
          obtain ⟨kw, hkw⟩ := hparity ⟨w - 1, by omega⟩ (by dsimp; omega)
          refine ⟨- kw, ?_⟩
          push_cast
          have h_top_rw : 3 * clock.R b ⟨w - 1, by omega⟩ = 3 * 1 := by rw [hb_top]
          linarith
  refine ⟨hzeta, hdiff, ?_⟩
  intro c
  obtain ⟨z, hz⟩ := hzeta c
  obtain ⟨k, hk⟩ := hdiff c
  rw [ell_uniform_total_eq_ell_uniform_of_CGC_zero hw clock b c_step H0 delta alpha hCGC]
  dsimp [ell_uniform]
  rw [halpha]
  refine ⟨m_alpha * z + k, ?_⟩
  push_cast
  have h_alg : 3 * (2 * (m_alpha : ℚ) + 1) * zeta_canonical (by omega) clock b c_step H0 c - y_sum_uniform clock c =
      2 * (m_alpha : ℚ) * (3 * zeta_canonical (by omega) clock b c_step H0 c) +
        (3 * zeta_canonical (by omega) clock b c_step H0 c - y_sum_uniform clock c) := by ring
  rw [h_alg, hk, hz]
  ring

/-- Block decomposition of the lifted cone product `C₊ᵀ * R₊`:
    splits into the old/gateway block `(X(1 + N))ᵀ * (S + G_O X)` and the reset block `Mᵀ * (1 ζᵀ - J M)`. -/
theorem liftedCountMat_transpose_mul_liftedScoreMat
    {α β γ : Type*} [Fintype α] [Fintype β] [Fintype γ] [DecidableEq γ]
    (G_O : Matrix α α ℚ) (J : Matrix β β ℚ)
    (S X : Matrix α γ ℚ) (M : Matrix β γ ℚ) (zeta : γ → ℚ) (N : Matrix γ γ ℚ) :
    (liftedCountMat X M N).transpose * liftedScoreMat G_O J S X M zeta =
      (X * (1 + N : Matrix γ γ ℚ)).transpose * (S + G_O * X) +
      M.transpose * (one_zeta β zeta - J * M) := by
  ext i j
  simp only [Matrix.mul_apply, Matrix.transpose_apply, liftedCountMat, liftedScoreMat, Matrix.of_apply,
    Matrix.add_apply]
  rw [Fintype.sum_sum_type]

/-- Reset block evaluation: When `∑ r, M r c = ell c` and `Mᵀ * J * M = E`,
    the reset interaction term `Mᵀ * (1 ζᵀ - J M)` equals `ellᵀ ζ - E`. -/
theorem M_transpose_mul_one_zeta_sub_JM {β γ : Type*} [Fintype β] [Fintype γ] [DecidableEq γ]
    (M : Matrix β γ ℚ) (J : Matrix β β ℚ) (zeta : γ → ℚ) (E : Matrix γ γ ℚ) (ell : γ → ℚ)
    (hcol : ∀ c : γ, (∑ r : β, M r c) = ell c)
    (hMJM : M.transpose * J * M = E) :
    M.transpose * (one_zeta β zeta - J * M) =
      Matrix.of (fun i j => ell i * zeta j) - E := by
  ext i j
  simp only [Matrix.mul_sub, Matrix.sub_apply, Matrix.of_apply]
  have h_zeta : (M.transpose * one_zeta β zeta) i j = ell i * zeta j := by
    simp only [Matrix.mul_apply, Matrix.transpose_apply, one_zeta, Matrix.of_apply]
    rw [← Finset.sum_mul, hcol i]
  have h_E : (M.transpose * (J * M)) i j = E i j := by
    have hM := congr_fun (congr_fun hMJM i) j
    simp only [Matrix.mul_assoc] at hM
    exact hM
  rw [h_zeta, h_E]

/-- Concrete Lifted Clock Vanishing: For any algebraic clock of order `w + 1` constructed from
    the lifted block tables `liftedCountMat` and `liftedScoreMat`, if the lifted cone product
    `Delta = C₊ᵀ * R₊` has vanishing columns `c > 0`, then `C₊ᵀ * G₊ * C₊ = 0` identically. -/
theorem lifted_clock_CGC_zero_of_delta_cols_zero {w : ℕ} (clock : AlgebraicClock (w + 1))
    (hDelta : ∀ i (c : Fin (w + 1)), 0 < c.val → (clock.C.transpose * clock.R) i c = 0) :
    clock.C.transpose * clock.G * clock.C = 0 :=
  clock_CGC_zero_of_delta_cols_zero clock hDelta

/-- Universal Lifted Payoff-Count Cone Vanishing for Block Systems:
    Whenever the lifted system satisfies the master lift equations (`hBT`, `hPtX`, `hPM`)
    and the lifted cone product `C₊ᵀ * R₊` has vanishing positive columns (`c > 0`),
    the lifted cone interaction `C₊ᵀ * G₊ * C₊` vanishes identically. -/
theorem lifted_tables_CGC_zero_of_delta_cols_zero {w : ℕ}
    {α β : Type*} [Fintype α] [Fintype β]
    (G_O : Matrix α α ℚ) (P : Matrix α β ℚ) (J : Matrix β β ℚ)
    (S X : Matrix α (Fin (w + 1)) ℚ) (M : Matrix β (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ) (B : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hBT : B * (1 + N_mat (w + 1)) = 1)
    (hPtX : P.transpose * X = Q_reset J M B zeta)
    (hPM : P * M = S * N_mat (w + 1) - G_O * X)
    (hDelta : ∀ i (c : Fin (w + 1)), 0 < c.val →
      ((liftedCountMat X M (N_mat (w + 1))).transpose * liftedScoreMat G_O J S X M zeta) i c = 0) :
    (liftedCountMat X M (N_mat (w + 1))).transpose *
      liftedGameMat G_O P J *
      liftedCountMat X M (N_mat (w + 1)) = 0 := by
  have hGC := liftedGameMat_mul_liftedCountMat G_O P J S X M B (N_mat (w + 1)) zeta hBT hPtX hPM
  rw [Matrix.mul_assoc, hGC, ← Matrix.mul_assoc]
  exact delta_mul_N_mat_eq_zero ((liftedCountMat X M (N_mat (w + 1))).transpose * liftedScoreMat G_O J S X M zeta) hDelta

/-- Master Column-Positive Vanishing Theorem:
    In the lifted block system, whenever the reset interaction `Mᵀ * (1 ζᵀ - J M)` evaluates to
    `ell * zetaᵀ - E` and cancels the gateway-old product `(X(1 + N))ᵀ * (S + G_O X)` on positive
    columns `c > 0`, the lifted cone interaction table `Delta = C₊ᵀ * R₊` vanishes identically on column `c`. -/
theorem delta_uniform_col_pos_eq_zero {w : ℕ}
    {α β : Type*} [Fintype α] [Fintype β] [DecidableEq β]
    (G_O : Matrix α α ℚ) (J : Matrix β β ℚ)
    (S X : Matrix α (Fin (w + 1)) ℚ) (M : Matrix β (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (ell : Fin (w + 1) → ℚ)
    (hcol : ∀ c : Fin (w + 1), (∑ r : β, M r c) = ell c)
    (hMJM : M.transpose * J * M = E)
    (h_cancel : ∀ i (c : Fin (w + 1)), 0 < c.val →
      ((X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)).transpose * (S + G_O * X)) i c +
        (ell i * zeta c - E i c) = 0)
    (i : Fin (w + 1)) (c : Fin (w + 1)) (hc : 0 < c.val) :
    ((liftedCountMat X M (N_mat (w + 1))).transpose * liftedScoreMat G_O J S X M zeta) i c = 0 := by
  have h_split := congr_fun (congr_fun
    (liftedCountMat_transpose_mul_liftedScoreMat G_O J S X M zeta (N_mat (w + 1))) i) c
  have h_reset := congr_fun (congr_fun
    (M_transpose_mul_one_zeta_sub_JM M J zeta E ell hcol hMJM) i) c
  simp only [Matrix.add_apply] at h_split
  simp only [Matrix.sub_apply, Matrix.of_apply] at h_reset
  rw [h_split, h_reset]
  exact h_cancel i c hc

/-- Concrete Inductive Step: Lifted Clock Vanishing (`lifted_clock_CGC_zero`):
    When the master lift equations (`hBT`, `hPtX`, `hPM`) hold and the master cancellation
    is satisfied on positive columns `c > 0`, the lifted payoff-count cone interaction
    vanishes identically:
    `C₊ᵀ * G₊ * C₊ = 0`. -/
theorem lifted_clock_CGC_zero {w : ℕ}
    {α β : Type*} [Fintype α] [Fintype β] [DecidableEq β]
    (G_O : Matrix α α ℚ) (P : Matrix α β ℚ) (J : Matrix β β ℚ)
    (S X : Matrix α (Fin (w + 1)) ℚ) (M : Matrix β (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (ell : Fin (w + 1) → ℚ)
    (B : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hBT : B * (1 + N_mat (w + 1)) = 1)
    (hPtX : P.transpose * X = Q_reset J M B zeta)
    (hPM : P * M = S * N_mat (w + 1) - G_O * X)
    (hcol : ∀ c : Fin (w + 1), (∑ r : β, M r c) = ell c)
    (hMJM : M.transpose * J * M = E)
    (h_cancel : ∀ i (c : Fin (w + 1)), 0 < c.val →
      ((X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)).transpose * (S + G_O * X)) i c +
        (ell i * zeta c - E i c) = 0) :
    (liftedCountMat X M (N_mat (w + 1))).transpose *
      liftedGameMat G_O P J *
      liftedCountMat X M (N_mat (w + 1)) = 0 := by
  have hDelta : ∀ i (c : Fin (w + 1)), 0 < c.val →
      ((liftedCountMat X M (N_mat (w + 1))).transpose * liftedScoreMat G_O J S X M zeta) i c = 0 := by
    intro i c hc
    exact delta_uniform_col_pos_eq_zero G_O J S X M zeta E ell hcol hMJM h_cancel i c hc
  exact lifted_tables_CGC_zero_of_delta_cols_zero G_O P J S X M zeta B hBT hPtX hPM hDelta

/-- Lifted Bundled Clock Vanishing:
    Any order-`(w + 1)` algebraic clock produced by `AlgebraicClock.lift` whose cone interaction
    matrix `Delta = C₊ᵀ * R₊` vanishes on positive columns `c > 0` satisfies
    `clock.Cᵀ * clock.G * clock.C = 0` identically. -/
theorem lifted_bundled_clock_CGC_zero {w : ℕ} (clock : AlgebraicClock w) {n : ℕ}
    (step : LiftStepData clock n)
    (hDelta : ∀ i (c : Fin (w + 1)), 0 < c.val →
      ((clock.lift step).C.transpose * (clock.lift step).R) i c = 0) :
    (clock.lift step).C.transpose * (clock.lift step).G * (clock.lift step).C = 0 :=
  lifted_clock_CGC_zero_of_delta_cols_zero (clock.lift step) hDelta

theorem transpose_mul_mul_self_skew {n m : Type*} [Fintype n] [Fintype m]
    (C : Matrix n m ℚ) (G : Matrix n n ℚ) (hG : IsSkewSymmetric G) :
    IsSkewSymmetric (C.transpose * G * C) := by
  intro i j
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  simp_rw [Finset.sum_mul]
  have h_lhs : (∑ k : n, ∑ l : n, C l i * G l k * C k j) =
      ∑ k : n, ∑ l : n, -(C k j * G k l * C l i) := by
    refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun l _ => ?_
    rw [hG l k]
    ring
  rw [h_lhs]
  rw [Finset.sum_comm]
  simp_rw [← Finset.sum_neg_distrib]

theorem delta_mul_N_mat_eq_CGC {w : ℕ}
    {α β : Type*} [Fintype α] [Fintype β]
    (G_O : Matrix α α ℚ) (P : Matrix α β ℚ) (J : Matrix β β ℚ)
    (S X : Matrix α (Fin (w + 1)) ℚ) (M : Matrix β (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ) (B : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hBT : B * (1 + N_mat (w + 1)) = 1)
    (hPtX : P.transpose * X = Q_reset J M B zeta)
    (hPM : P * M = S * N_mat (w + 1) - G_O * X) :
    ((liftedCountMat X M (N_mat (w + 1))).transpose * liftedScoreMat G_O J S X M zeta) * N_mat (w + 1) =
      (liftedCountMat X M (N_mat (w + 1))).transpose *
        liftedGameMat G_O P J *
        liftedCountMat X M (N_mat (w + 1)) := by
  have hGC := liftedGameMat_mul_liftedCountMat G_O P J S X M B (N_mat (w + 1)) zeta hBT hPtX hPM
  rw [Matrix.mul_assoc, ← hGC, ← Matrix.mul_assoc]

theorem delta_cols_pos_zero_of_pos_rows_and_skew {w : ℕ}
    (Delta : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (h_pos_rows : ∀ (i c : Fin (w + 1)), 0 < i.val → 0 < c.val → Delta i c = 0)
    (h_skew : IsSkewSymmetric (Delta * N_mat (w + 1))) :
    ∀ (i c : Fin (w + 1)), 0 < c.val → Delta i c = 0 := by
  have h_mul_pos_rows : ∀ (i k : Fin (w + 1)), 0 < i.val → (Delta * N_mat (w + 1)) i k = 0 := by
    intro i k hi
    rw [Matrix.mul_apply]
    by_cases hk : k.val + 1 < w + 1
    · have hN : ∀ c : Fin (w + 1), N_mat (w + 1) c k = if c = ⟨k.val + 1, hk⟩ then 1 else 0 := by
        intro c
        by_cases hc : c = ⟨k.val + 1, hk⟩
        · subst hc
          simp [N_mat]
        · have hval : c.val ≠ k.val + 1 := fun h => hc (Fin.ext h)
          simp [N_mat, hc, hval]
      simp_rw [hN]
      rw [Finset.sum_eq_single ⟨k.val + 1, hk⟩]
      · simp only [↓reduceIte, mul_one]
        exact h_pos_rows i ⟨k.val + 1, hk⟩ hi (Nat.succ_pos k.val)
      · intro c _ hc
        simp [hc]
      · intro h; exfalso; exact h (Finset.mem_univ _)
    · have hle : w + 1 ≤ k.val + 1 := not_lt.mp hk
      have hN : ∀ c : Fin (w + 1), N_mat (w + 1) c k = 0 := by
        intro c
        have hc : c.val < w + 1 := c.isLt
        have hnot : c.val ≠ k.val + 1 := by omega
        simp [N_mat, hnot]
      simp [hN]
  have h_mul_zero_row : ∀ (k : Fin (w + 1)), (Delta * N_mat (w + 1)) 0 k = 0 := by
    intro k
    have h_sk := h_skew 0 k
    by_cases hk : 0 < k.val
    · rw [h_sk, h_mul_pos_rows k 0 hk, neg_zero]
    · have heq : k = 0 := by ext; dsimp; omega
      subst heq
      have h00 := h_skew 0 0
      linarith
  have h_mul_all_zero : Delta * N_mat (w + 1) = 0 := by
    ext i k
    by_cases hi : 0 < i.val
    · rw [h_mul_pos_rows i k hi, Matrix.zero_apply]
    · have heq : i = 0 := by ext; dsimp; omega
      subst heq
      rw [h_mul_zero_row k, Matrix.zero_apply]
  intro i c hc
  have hlt : c.val - 1 + 1 < w + 1 := by
    have := c.isLt
    omega
  let k : Fin (w + 1) := ⟨c.val - 1, by have := c.isLt; omega⟩
  have h_entry := congr_fun (congr_fun h_mul_all_zero i) k
  simp only [Matrix.zero_apply] at h_entry
  rw [Matrix.mul_apply] at h_entry
  have hN : ∀ d : Fin (w + 1), N_mat (w + 1) d k = if d = c then 1 else 0 := by
    intro d
    by_cases hd : d = c
    · cases hd
      simp only [↓reduceIte]
      dsimp [N_mat, k]
      have heq_c : c.val = c.val - 1 + 1 := by omega
      rw [if_pos heq_c]
    · simp only [if_neg hd]
      dsimp [N_mat, k]
      have hne : d.val ≠ c.val - 1 + 1 := by
        intro h
        apply hd
        ext
        omega
      rw [if_neg hne]
  simp_rw [hN] at h_entry
  rw [Finset.sum_eq_single c] at h_entry
  · simp only [↓reduceIte, mul_one] at h_entry
    exact h_entry
  · intro d _ hd
    simp [hd]
  · intro h; exfalso; exact h (Finset.mem_univ _)

theorem S_add_GO_X_inl {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (j : Fin clock.m) (c : Fin (w + 1)) (hc : 0 < c.val) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let h := h_uniform clock b zeta c_step
    let S := S_uniform (by omega) clock b h delta
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let X := X_gateway clock
    (S + G_O * X) (finSumFinEquiv (Sum.inl j)) c =
      h c + (clock.G * clock.C) j ⟨c.val - 1, by omega⟩ := by
  intro zeta h S G_O X
  rw [Matrix.add_apply]
  dsimp only [S, S_uniform]
  have hc0 : ¬ (c.val = 0) := by omega
  simp only [Matrix.of_apply, Equiv.symm_apply_apply, hc0, ↓reduceIte, zero_add]
  rw [GO_mul_X_inl_apply]
  have he0 : e0_row (w + 1) c = 0 := by
    simp only [e0_row, hc0, ↓reduceIte]
  rw [he0, mul_zero, sub_zero]
  have hshift : (clock.G * shiftRightCount clock.C) j c =
      (clock.G * clock.C) j ⟨c.val - 1, by omega⟩ := by
    simp only [Matrix.mul_apply]
    refine Finset.sum_congr rfl fun k _ => ?_
    dsimp [shiftRightCount]
    rw [dif_pos hc]
  rw [hshift]

theorem S_add_GO_X_inr {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (c : Fin (w + 1)) (hc : 0 < c.val) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let h := h_uniform clock b zeta c_step
    let S := S_uniform (by omega) clock b h delta
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let X := X_gateway clock
    (S + G_O * X) (finSumFinEquiv (Sum.inr 0)) c =
      h c + (clock.G * clock.C) b ⟨c.val - 1, by omega⟩ := by
  intro zeta h S G_O X
  rw [Matrix.add_apply]
  dsimp only [S, S_uniform]
  have hc0 : ¬ (c.val = 0) := by omega
  simp only [Matrix.of_apply, Equiv.symm_apply_apply, hc0, ↓reduceIte]
  rw [GO_mul_X_inr_apply]
  have hshift : (clock.G * shiftRightCount clock.C) b c =
      (clock.G * clock.C) b ⟨c.val - 1, by omega⟩ := by
    simp only [Matrix.mul_apply]
    refine Finset.sum_congr rfl fun k _ => ?_
    dsimp [shiftRightCount]
    rw [dif_pos hc]
  rw [hshift]
  simp only [e1_row]
  split_ifs <;> ring

theorem X_mul_one_add_N_inl_mul_GC_zero {w : ℕ} (clock : AlgebraicClock w)
    (hCGC : clock.C.transpose * clock.G * clock.C = 0)
    (i : Fin (w + 1)) (d : Fin w) :
    (∑ j : Fin clock.m,
      (X_gateway clock * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ))
        (finSumFinEquiv (Sum.inl j)) i * (clock.G * clock.C) j d) = 0 := by
  have hCGC_apply : ∀ a : Fin w, (∑ j : Fin clock.m, clock.C j a * (clock.G * clock.C) j d) = 0 := by
    intro a
    have h := congr_fun (congr_fun (show clock.C.transpose * (clock.G * clock.C) = 0 by rw [← Matrix.mul_assoc, hCGC]) a) d
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.zero_apply] at h
    exact h
  simp_rw [Matrix.mul_apply, Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_eq_zero fun k _ => ?_
  change (∑ j : Fin clock.m, X_gateway clock (finSumFinEquiv (Sum.inl j)) k * (1 + N_mat (w + 1)) k i * (clock.G * clock.C) j d) = 0
  have h_assoc : (∑ j : Fin clock.m, X_gateway clock (finSumFinEquiv (Sum.inl j)) k * (1 + N_mat (w + 1)) k i * (clock.G * clock.C) j d) =
      (∑ j : Fin clock.m, (X_gateway clock (finSumFinEquiv (Sum.inl j)) k * (clock.G * clock.C) j d)) * (1 + N_mat (w + 1)) k i := by
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun j _ => by ring
  rw [h_assoc]
  by_cases hk : k.val = 0
  · have hX : ∀ j : Fin clock.m, X_gateway clock (finSumFinEquiv (Sum.inl j)) k = 0 := by
      intro j
      simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, shiftRightCount]
      rw [dif_neg (by omega)]
    have h_sum0 : (∑ j : Fin clock.m, (X_gateway clock (finSumFinEquiv (Sum.inl j)) k * (clock.G * clock.C) j d)) = 0 := by
      simp_rw [hX, zero_mul, Finset.sum_const_zero]
    rw [h_sum0, zero_mul]
  · have hk_pos : 0 < k.val := by omega
    have hX : ∀ j : Fin clock.m, X_gateway clock (finSumFinEquiv (Sum.inl j)) k = clock.C j ⟨k.val - 1, by omega⟩ := by
      intro j
      simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, shiftRightCount]
      rw [dif_pos hk_pos]
    have h_sum_cgc : (∑ j : Fin clock.m, (X_gateway clock (finSumFinEquiv (Sum.inl j)) k * (clock.G * clock.C) j d)) = 0 := by
      simp_rw [hX]
      exact hCGC_apply ⟨k.val - 1, by omega⟩
    rw [h_sum_cgc, zero_mul]

theorem X_mul_one_add_N_inr_zero {w : ℕ} (clock : AlgebraicClock w) (i : Fin (w + 1)) :
    (X_gateway clock * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ))
      (finSumFinEquiv (Sum.inr 0)) i = if i.val = 0 then 1 else 0 := by
  simp only [Matrix.mul_apply, Matrix.add_apply, Matrix.one_apply]
  have hX : ∀ k : Fin (w + 1), X_gateway clock (finSumFinEquiv (Sum.inr 0)) k = e0_row (w + 1) k := by
    intro k
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply]
  simp_rw [hX]
  have he0_0 : e0_row (w + 1) 0 = 1 := by
    dsimp [e0_row]
  have h0 : (∑ k : Fin (w + 1), e0_row (w + 1) k * ((if k = i then 1 else 0) + N_mat (w + 1) k i)) =
      (if (0 : Fin (w + 1)) = i then 1 else 0) + N_mat (w + 1) 0 i := by
    rw [Finset.sum_eq_single 0]
    · rw [he0_0, one_mul]
    · intro k _ hk
      have hne : k.val ≠ 0 := fun h => hk (Fin.ext h)
      simp [e0_row, hne]
    · intro h; exact False.elim (h (Finset.mem_univ _))
  rw [h0]
  have hN0 : N_mat (w + 1) 0 i = 0 := by
    dsimp [N_mat]
  rw [hN0, add_zero]
  by_cases hi : i.val = 0
  · have heq : (0 : Fin (w + 1)) = i := by ext; dsimp; omega
    simp [hi, heq]
  · have hne : (0 : Fin (w + 1)) ≠ i := fun h => hi (by rw [← h]; rfl)
    simp [hi, hne]

theorem X_one_add_N_transpose_mul_S_add_GO_X {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ)
    (hCGC : clock.C.transpose * clock.G * clock.C = 0)
    (i c : Fin (w + 1)) (hc : 0 < c.val) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let h := h_uniform clock b zeta c_step
    let S := S_uniform (by omega) clock b h delta
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let X := X_gateway clock
    ((X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)).transpose * (S + G_O * X)) i c =
      y_sum_uniform clock i * h c +
        (if i.val = 0 then (clock.G * clock.C) b ⟨c.val - 1, by omega⟩ else 0) := by
  intro zeta h S G_O X
  change (∑ y : Fin (clock.m + 1), (X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) y i * (S + G_O * X) y c) = _
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) =>
      (X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) y i * (S + G_O * X) y c).symm
  rw [hcomp, Fintype.sum_sum_type]
  have h_inl : (∑ j : Fin clock.m, (X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) (finSumFinEquiv (Sum.inl j)) i * (S + G_O * X) (finSumFinEquiv (Sum.inl j)) c) =
      (∑ j : Fin clock.m, (X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) (finSumFinEquiv (Sum.inl j)) i * h c) := by
    have h_eval : ∀ j : Fin clock.m, (S + G_O * X) (finSumFinEquiv (Sum.inl j)) c =
        h c + (clock.G * clock.C) j ⟨c.val - 1, by omega⟩ :=
      fun j => S_add_GO_X_inl hw clock b c_step H0 delta j c hc
    simp_rw [h_eval, mul_add]
    rw [Finset.sum_add_distrib]
    have h_cgc := X_mul_one_add_N_inl_mul_GC_zero clock hCGC i ⟨c.val - 1, by omega⟩
    rw [h_cgc, add_zero]
  have h_inr : (∑ j : Fin 1, (X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) (finSumFinEquiv (Sum.inr j)) i * (S + G_O * X) (finSumFinEquiv (Sum.inr j)) c) =
      (X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) (finSumFinEquiv (Sum.inr 0)) i *
        (h c + (clock.G * clock.C) b ⟨c.val - 1, by omega⟩) := by
    simp only [Fin.sum_univ_one]
    rw [S_add_GO_X_inr hw clock b c_step H0 delta c hc]
  rw [h_inl, h_inr]
  rw [X_mul_one_add_N_inr_zero clock i]
  have hy : y_sum_uniform clock i =
      (∑ j : Fin clock.m, (X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) (finSumFinEquiv (Sum.inl j)) i) +
        (if i.val = 0 then 1 else 0) := by
    have hsum : y_sum_uniform clock i = ∑ y : Fin (clock.m + 1), (X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) y i := by
      dsimp [y_sum_uniform, x_sum_uniform, X]
      rw [Matrix.vecMul_vecMul]
      dsimp [Matrix.vecMul, dotProduct]
      simp only [one_mul]
    rw [hsum]
    have hcomp_y := (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) =>
      (X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) y i).symm
    rw [hcomp_y, Fintype.sum_sum_type, Fin.sum_univ_one]
    rw [X_mul_one_add_N_inr_zero clock i]
  rw [hy]
  rw [← Finset.sum_mul]
  split_ifs <;> ring

theorem h_uniform_eq_v_step_pred {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) (c c_pred : Fin (w + 1)) (hc : 0 < c.val) (hpred : c_pred.val = c.val - 1) :
    h_uniform clock b (zeta_canonical hw clock b c_step H0) c_step c =
      v_step hw clock b c_step c_pred := by
  dsimp [h_uniform, v_step]
  have hc0 : ¬ (c.val = 0) := by omega
  simp only [hc0, ↓reduceIte, sub_zero]
  have hz := zeta_canonical_succ_val hw clock b c_step H0 c hc
  have heq_pred : (⟨c.val - 1, by omega⟩ : Fin (w + 1)) = c_pred := by ext; dsimp; omega
  rw [heq_pred] at hz
  dsimp [v_step] at hz
  simp only [hc0, ↓reduceIte, sub_zero, add_zero] at hz
  rw [hz]
  ring

theorem ell_mul_zeta_sub_E_pos {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta alpha : ℚ)
    (i c c_pred : Fin (w + 1)) (hc : 0 < c.val) (hpred : c_pred.val = c.val - 1) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let ell := ell_uniform hw clock b c_step H0 alpha
    let E := E_uniform hw clock b c_step H0 delta alpha
    let F_gw := F_gw_uniform hw clock b c_step H0 delta
    ell i * zeta c - E i c =
      - (y_sum_uniform clock i * v_step (by omega) clock b c_step c_pred +
         (if i.val = 0 then v1_vec_moment F_gw c else 0)) := by
  intro zeta ell E F_gw
  have hzeta := zeta_canonical_succ_val (by omega) clock b c_step H0 c hc
  have heq_pred : (⟨c.val - 1, by omega⟩ : Fin (w + 1)) = c_pred := by ext; dsimp; omega
  rw [heq_pred] at hzeta
  have hz : zeta c = v_step (by omega) clock b c_step c_pred + v_step (by omega) clock b c_step c := hzeta
  dsimp [E, E_uniform, E_outer, E_outer1, E_outer2, ell, ell_uniform, E_rank2]
  have hc0 : ¬ (c.val = 0) := by omega
  simp only [hc0, ↓reduceIte, add_zero]
  change (alpha * zeta i - y_sum_uniform clock i) * zeta c -
    ((if i.val = 0 then v1_vec_moment F_gw c else 0) +
     (- (y_sum_uniform clock i * v_step (by omega) clock b c_step c) +
      alpha * zeta i * zeta c)) = _
  rw [hz]
  ring

theorem uniform_delta_pos_rows_cancel {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (hCGC : clock.C.transpose * clock.G * clock.C = 0)
    (i c : Fin (w + 1)) (hi : 0 < i.val) (hc : 0 < c.val) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let h := h_uniform clock b zeta c_step
    let S := S_uniform (by omega) clock b h delta
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let X := X_gateway clock
    let ell := ell_uniform hw clock b c_step H0 alpha
    let E := E_uniform hw clock b c_step H0 delta alpha
    ((X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)).transpose * (S + G_O * X)) i c +
      (ell i * zeta c - E i c) = 0 := by
  intro zeta h S G_O X ell E
  let c_pred : Fin (w + 1) := ⟨c.val - 1, by have := c.isLt; omega⟩
  have hpred : c_pred.val = c.val - 1 := rfl
  have hX_prod := X_one_add_N_transpose_mul_S_add_GO_X hw clock b c_step H0 delta hCGC i c hc
  have hell := ell_mul_zeta_sub_E_pos hw clock b c_step H0 delta alpha i c c_pred hc hpred
  have hh := h_uniform_eq_v_step_pred (by omega) clock b c_step H0 c c_pred hc hpred
  have hi0 : ¬ (i.val = 0) := by omega
  simp only [hi0, ↓reduceIte, add_zero] at hX_prod hell
  rw [hX_prod, hell, hh]
  ring

theorem uniform_delta_col_pos_cancel {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (hCGC : clock.C.transpose * clock.G * clock.C = 0)
    {β : Type*} [Fintype β] [DecidableEq β]
    (P : Matrix (Fin (clock.m + 1)) β ℚ) (J : Matrix β β ℚ)
    (M : Matrix β (Fin (w + 1)) ℚ)
    (B : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hBT : B * (1 + N_mat (w + 1)) = 1)
    (hPtX : P.transpose * X_gateway clock = Q_reset J M B (zeta_canonical (by omega) clock b c_step H0))
    (hPM : P * M = S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta * N_mat (w + 1) -
      AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock)
    (hcol : ∀ c : Fin (w + 1), (∑ r : β, M r c) = ell_uniform hw clock b c_step H0 alpha c)
    (hMJM : M.transpose * J * M = E_uniform hw clock b c_step H0 delta alpha)
    (i : Fin (w + 1)) (c : Fin (w + 1)) (hc : 0 < c.val) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let h := h_uniform clock b zeta c_step
    let S := S_uniform (by omega) clock b h delta
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let X := X_gateway clock
    let ell := ell_uniform hw clock b c_step H0 alpha
    let E := E_uniform hw clock b c_step H0 delta alpha
    ((X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)).transpose * (S + G_O * X)) i c +
      (ell i * zeta c - E i c) = 0 := by
  intro zeta h S G_O X ell E
  let Delta := (liftedCountMat X M (N_mat (w + 1))).transpose * liftedScoreMat G_O J S X M zeta
  have h_split : ∀ r k, Delta r k =
      ((X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)).transpose * (S + G_O * X)) r k +
        (ell r * zeta k - E r k) := by
    intro r k
    have h_s := congr_fun (congr_fun
      (liftedCountMat_transpose_mul_liftedScoreMat G_O J S X M zeta (N_mat (w + 1))) r) k
    have h_r := congr_fun (congr_fun
      (M_transpose_mul_one_zeta_sub_JM M J zeta E ell hcol hMJM) r) k
    simp only [Matrix.add_apply] at h_s
    simp only [Matrix.sub_apply, Matrix.of_apply] at h_r
    dsimp [Delta]
    rw [h_s, h_r]
  have h_pos_rows : ∀ (r k : Fin (w + 1)), 0 < r.val → 0 < k.val → Delta r k = 0 := by
    intro r k hr hk
    rw [h_split r k]
    exact uniform_delta_pos_rows_cancel hw clock b c_step H0 delta alpha hCGC r k hr hk
  have hGO_skew : IsSkewSymmetric G_O := AdjoinLeaderEndpointG_skew clock.G b clock.v clock.hskew
  have hG_plus_skew : IsSkewSymmetric (liftedGameMat G_O P J) := liftedGameMat_skew G_O P J hGO_skew
  have hCGC_skew : IsSkewSymmetric ((liftedCountMat X M (N_mat (w + 1))).transpose *
      liftedGameMat G_O P J *
      liftedCountMat X M (N_mat (w + 1))) :=
    transpose_mul_mul_self_skew (liftedCountMat X M (N_mat (w + 1))) _ hG_plus_skew
  have h_eq : Delta * N_mat (w + 1) =
      (liftedCountMat X M (N_mat (w + 1))).transpose *
        liftedGameMat G_O P J *
        liftedCountMat X M (N_mat (w + 1)) :=
    delta_mul_N_mat_eq_CGC G_O P J S X M zeta B hBT hPtX hPM
  have h_skew : IsSkewSymmetric (Delta * N_mat (w + 1)) := by
    rw [h_eq]
    exact hCGC_skew
  have h_all_cols : ∀ (r k : Fin (w + 1)), 0 < k.val → Delta r k = 0 :=
    delta_cols_pos_zero_of_pos_rows_and_skew Delta h_pos_rows h_skew
  have h_zero := h_all_cols i c hc
  rw [h_split i c] at h_zero
  exact h_zero

theorem uniform_lifted_clock_CGC_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (hCGC : clock.C.transpose * clock.G * clock.C = 0)
    {β : Type*} [Fintype β] [DecidableEq β]
    (P : Matrix (Fin (clock.m + 1)) β ℚ) (J : Matrix β β ℚ)
    (M : Matrix β (Fin (w + 1)) ℚ)
    (B : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hBT : B * (1 + N_mat (w + 1)) = 1)
    (hPtX : P.transpose * X_gateway clock = Q_reset J M B (zeta_canonical (by omega) clock b c_step H0))
    (hPM : P * M = S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta * N_mat (w + 1) -
      AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock)
    (hcol : ∀ c : Fin (w + 1), (∑ r : β, M r c) = ell_uniform hw clock b c_step H0 alpha c)
    (hMJM : M.transpose * J * M = E_uniform hw clock b c_step H0 delta alpha) :
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let X := X_gateway clock
    (liftedCountMat X M (N_mat (w + 1))).transpose *
      liftedGameMat G_O P J *
      liftedCountMat X M (N_mat (w + 1)) = 0 := by
  intro G_O X
  let zeta := zeta_canonical (by omega) clock b c_step H0
  let h := h_uniform clock b zeta c_step
  let S := S_uniform (by omega) clock b h delta
  let E := E_uniform hw clock b c_step H0 delta alpha
  let ell := ell_uniform hw clock b c_step H0 alpha
  have h_cancel : ∀ (i c : Fin (w + 1)), 0 < c.val →
      ((X * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)).transpose * (S + G_O * X)) i c +
        (ell i * zeta c - E i c) = 0 := by
    intro i c hc
    exact uniform_delta_col_pos_cancel hw clock b c_step H0 delta alpha hCGC P J M B hBT hPtX hPM hcol hMJM i c hc
  exact lifted_clock_CGC_zero G_O P J S X M zeta E ell B hBT hPtX hPM hcol hMJM h_cancel

/-!
## 5. Concrete RPS Base-Case Instantiations (w = 2)
-/

/-- Explicit phase-boundary leader action for the RPS clock (`b = 0`). -/
def b_rps : Fin rpsFullRankClock.clock.m := ⟨0, by decide⟩

/-- The inner cone interaction vanishes for the order-2 RPS clock: $C_2^\top G_2 C_2 = 0$. -/
theorem rps_full_rank_CGC_zero :
    rpsFullRankClock.clock.C.transpose * rpsFullRankClock.clock.G * rpsFullRankClock.clock.C = 0 :=
  rps_CGC_zero

/-- Column 0 sum of the RPS clock count table equals 18. -/
theorem rps_col0_int :
    (∑ i : Fin rpsFullRankClock.clock.m, rpsFullRankClock.clock.C i ⟨0, by decide⟩) = ((18 : ℤ) : ℚ) := by
  simp [Fin.sum_univ_three, rpsFullRankClock, rpsAlgebraicClock, C2]
  norm_num

/-- Parity alignment for positive columns of the RPS clock: `colsum_1(C) - 3 * R_{0, 1} = 9 - 3 = 6 = 2 * 3`. -/
theorem rps_parity :
    ∀ c : Fin 2, 0 < c.val →
      ∃ k : ℤ, (∑ i : Fin rpsFullRankClock.clock.m, rpsFullRankClock.clock.C i c) -
        3 * rpsFullRankClock.clock.R ⟨0, by decide⟩ c = 2 * (k : ℚ) := by
  intro c hc
  have heq1 : c = ⟨1, by decide⟩ := by
    ext
    dsimp
    have hc_lt := c.isLt
    omega
  subst heq1
  refine ⟨3, ?_⟩
  simp [Fin.sum_univ_three, rpsFullRankClock, rpsAlgebraicClock, C2, R2]
  norm_num

/-- 3-scaled score entry is an integer: `3 * R_{0, 1} = 3 = (3 : ℤ)`. -/
theorem rps_three_R_int :
    ∀ c : Fin 2, 0 < c.val →
      ∃ z : ℤ, 3 * rpsFullRankClock.clock.R ⟨0, by decide⟩ c = (z : ℚ) := by
  intro c hc
  have heq1 : c = ⟨1, by decide⟩ := by
    ext
    dsimp
    have hc_lt := c.isLt
    omega
  subst heq1
  refine ⟨3, ?_⟩
  simp [rpsFullRankClock, rpsAlgebraicClock, R2]

/-- Step constant calibration for RPS: `3 * (4 / 3) = 18 + 2 * (-7) = 4`. -/
theorem rps_c_step_four_thirds :
    3 * (4 / 3 : ℚ) = (∑ i : Fin rpsFullRankClock.clock.m, rpsFullRankClock.clock.C i ⟨0, by decide⟩) +
      2 * ((-7 : ℤ) : ℚ) := by
  simp [Fin.sum_univ_three, rpsFullRankClock, rpsAlgebraicClock, C2]
  norm_num

/-- Baseline ceiling calibration for RPS: `3 * 3 = 1 + 18 + 2 * (-5) = 9`. -/
theorem rps_H0_three :
    3 * (3 : ℚ) = 1 + (∑ i : Fin rpsFullRankClock.clock.m, rpsFullRankClock.clock.C i ⟨0, by decide⟩) +
      2 * ((-5 : ℤ) : ℚ) := by
  simp [Fin.sum_univ_three, rpsFullRankClock, rpsAlgebraicClock, C2]
  norm_num




