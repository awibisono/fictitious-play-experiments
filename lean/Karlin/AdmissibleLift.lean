/-- Leader dominance preservation across all actions and all columns in the lifted clock. -/
theorem h_leader'_all
    (h_leader_all : ∀ i (j : Fin w), grc.rc.fc.clock.R i j ≤ grc.rc.fc.clock.R grc.b j)
    (h_JM_nonneg : ∀ r c, 0 ≤ (J_lower_eta w (fun c => 2 * (grc.u c : ℚ)) (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta * M_of_nat (M_lower_nat w grc.u)) r c)
    (h_delta_plus_Gv : ∀ i0 : Fin grc.rc.fc.clock.m, 0 ≤ grc.delta + (grc.rc.fc.clock.G grc.b i0 + grc.rc.fc.clock.v i0))
    (h_c_step_le_JM0 : ∀ r : Fin ((w + 1) + (w + 1)), grc.c_step - grc.delta ≤ (J_lower_eta w (fun c => 2 * (grc.u c : ℚ)) (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta * M_of_nat (M_lower_nat w grc.u)) r 0)
