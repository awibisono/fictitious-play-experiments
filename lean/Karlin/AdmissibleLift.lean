theorem W_bundle_word_succ_eq {m : ℕ} (parentWord : ℕ → List (Fin m)) (K : ℕ) :
    W_bundle_word parentWord (K + 1) = W_bundle_word parentWord K ++ parentWord K := by
  unfold W_bundle_word
  rw [@List.range_succ K, List.flatMap_append]
  simp

/-- Subphase reduction for the Stage 3 bundle with access to the remaining length:
    step `k` of `W_bundle_word parentWord Q` is step `r` of subphase `idx < Q`, with starting score
    `wordScore G s0 (W_bundle_word parentWord idx)` and remaining length
    `((parentWord idx).drop r).length + ∑ τ ∈ Ico (idx + 1) Q, (parentWord τ).length`. -/
theorem W_bundle_word_take_forall_drop {m : ℕ}
    (parentWord : ℕ → List (Fin m)) (G : Matrix (Fin m) (Fin m) ℚ) (s0 : Fin m → ℚ) (Q : ℕ)
    (P : Fin m → ℚ → ℕ → Prop)
    (h_sub : ∀ (idx : ℕ) (_ : idx < Q) (r : ℕ) (hr : r < (parentWord idx).length),
      P (parentWord idx)[r]
        (wordScore G (wordScore G s0 (W_bundle_word parentWord idx))
          ((parentWord idx).take r) (parentWord idx)[r])
        (((parentWord idx).drop r).length + ∑ τ ∈ Finset.Ico (idx + 1) Q, (parentWord τ).length)) :
    ∀ (k : ℕ) (hk : k < (W_bundle_word parentWord Q).length),
      P (W_bundle_word parentWord Q)[k]
        (wordScore G s0 ((W_bundle_word parentWord Q).take k) (W_bundle_word parentWord Q)[k])
        ((W_bundle_word parentWord Q).drop k).length := by
  have h_ind : ∀ K ≤ Q, ∀ (k : ℕ) (hk : k < (W_bundle_word parentWord K).length),
      P (W_bundle_word parentWord K)[k]
        (wordScore G s0 ((W_bundle_word parentWord K).take k) (W_bundle_word parentWord K)[k])
        (((W_bundle_word parentWord K).drop k).length +
          ∑ τ ∈ Finset.Ico K Q, (parentWord τ).length) := by
    intro K
    induction K with
    | zero =>
      intro _ k hk
      simp [W_bundle_word] at hk
    | succ K ih =>
      intro hK
      have hflat := W_bundle_word_succ_eq parentWord K
      have hIco : ∑ τ ∈ Finset.Ico K Q, (parentWord τ).length =
          (parentWord K).length + ∑ τ ∈ Finset.Ico (K + 1) Q, (parentWord τ).length :=
        Finset.sum_eq_sum_Ico_succ_bot (by omega) _
      have key : ∀ (k : ℕ) (hk : k < (W_bundle_word parentWord K ++ parentWord K).length),
          P (W_bundle_word parentWord K ++ parentWord K)[k]
            (wordScore G s0 ((W_bundle_word parentWord K ++ parentWord K).take k)
              (W_bundle_word parentWord K ++ parentWord K)[k])
            (((W_bundle_word parentWord K ++ parentWord K).drop k).length +
              ∑ τ ∈ Finset.Ico (K + 1) Q, (parentWord τ).length) := by
        intro k hk
        rw [List.length_append] at hk
        by_cases hk1 : k < (W_bundle_word parentWord K).length
        · have htake : (W_bundle_word parentWord K ++ parentWord K).take k =
              (W_bundle_word parentWord K).take k :=
            List.take_append_of_le_length (le_of_lt hk1)
          have hget : (W_bundle_word parentWord K ++ parentWord K)[k] =
              (W_bundle_word parentWord K)[k] := List.getElem_append_left hk1
          have hdrop : ((W_bundle_word parentWord K ++ parentWord K).drop k).length +
              ∑ τ ∈ Finset.Ico (K + 1) Q, (parentWord τ).length =
              ((W_bundle_word parentWord K).drop k).length +
                ∑ τ ∈ Finset.Ico K Q, (parentWord τ).length := by
            rw [hIco]
            simp only [List.length_drop, List.length_append]
            omega
          rw [htake, hget, hdrop]
          exact ih (by omega) k hk1
        · have hle : (W_bundle_word parentWord K).length ≤ k := le_of_not_gt hk1
          have hk2 : k - (W_bundle_word parentWord K).length < (parentWord K).length := by omega
          have htake : (W_bundle_word parentWord K ++ parentWord K).take k =
              W_bundle_word parentWord K ++
                (parentWord K).take (k - (W_bundle_word parentWord K).length) := by
            rw [List.take_append, List.take_of_length_le hle]
          have hget : (W_bundle_word parentWord K ++ parentWord K)[k] =
              (parentWord K)[k - (W_bundle_word parentWord K).length] :=
            List.getElem_append_right hle
          have hdrop : ((W_bundle_word parentWord K ++ parentWord K).drop k).length =
              ((parentWord K).drop (k - (W_bundle_word parentWord K).length)).length := by
            simp only [List.length_drop, List.length_append]
            omega
          rw [htake, hget, hdrop, wordScore_append]
          exact h_sub K (by omega) _ hk2
      intro k hk
      have hk' : k < (W_bundle_word parentWord K ++ parentWord K).length := by
        rw [← hflat]; exact hk
      have := key k hk'
      simpa only [hflat] using this
  intro k hk
  have := h_ind Q le_rfl k hk
  simpa using this

lemma rps_phase_len (τ : ℕ) : ((rpsPhaseWord τ).length : ℚ) = 9 * (τ : ℚ) + 18 := by
  have hlen : (rpsPhaseWord τ).length = 3 * τ + 5 + (3 * τ + 6 + (3 * τ + 7)) := by
    simp [rpsPhaseWord]
  rw [hlen]
  push_cast
  ring

lemma rps_sum_len_ge (a b : ℕ) (hab : a ≤ b) :
    72 * ((b : ℚ) - (a : ℚ)) - 72 * 6 ≤ ∑ τ ∈ Finset.Ico a b, ((rpsPhaseWord τ).length : ℚ) := by
  induction b, hab using Nat.le_induction with
  | base => simp
  | succ b hab ih =>
    rw [Finset.sum_Ico_succ_top hab, rps_phase_len]
    push_cast
    by_cases hb : 6 ≤ b
    · have : (6 : ℚ) ≤ (b : ℚ) := by exact_mod_cast hb
      linarith
    · have hnonneg : 0 ≤ ∑ τ ∈ Finset.Ico a b, ((rpsPhaseWord τ).length : ℚ) :=
        Finset.sum_nonneg (fun _ _ => by positivity)
      have hb5 : (b : ℚ) ≤ 5 := by exact_mod_cast (by omega : b ≤ 5)
      have ha0 : (0 : ℚ) ≤ (a : ℚ) := by positivity
      have hb0 : (0 : ℚ) ≤ (b : ℚ) := by positivity
      linarith

