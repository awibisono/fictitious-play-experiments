theorem uniform_phaseWord_M_head_eq_zero {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (hM0 : ∀ r : Fin ((w + 1) + (w + 1)), 1 ≤ M_nat r ⟨0, Nat.succ_pos w⟩) (q : ℕ)
    (h_pos : 0 < ((rawFourStageWord_M clock parentWord M_nat q).map
      (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)))).length) :
    ((rawFourStageWord_M clock parentWord M_nat q).map
      (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))))[0]'h_pos =
    ⟨0, by
      have : 0 < (clock.m + 1) + ((w + 1) + (w + 1)) := by omega
      exact this⟩ := by
  have hraw_pos : 0 < (rawFourStageWord_M clock parentWord M_nat q).length := by
    rw [List.length_map] at h_pos
    exact h_pos
  have hget : ((rawFourStageWord_M clock parentWord M_nat q).map
      (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))))[0]'h_pos =
    (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)))
      ((rawFourStageWord_M clock parentWord M_nat q)[0]'hraw_pos) := by
    simp only [List.getElem_map]
  rw [hget]
  rw [rawFourStageWord_M_head_eq_inr_zero clock parentWord M_nat hM0 q hraw_pos]
  exact rotLeaderEquiv_inr_zero (by omega) (by omega)

def uniformInitScoreVec_M {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hRM : R_M * (M_of_nat M_nat) = 1)
    (hMJM : (M_of_nat M_nat).transpose * J * (M_of_nat M_nat) = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_of_nat M_nat)).transpose * psi_row zeta (B_mat (w + 1)))
    (q : ℕ) :
    Fin (uniformFullRankLift_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment).clock.m → ℚ :=
  fun i => ((liftedScoreMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
    J
    (S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta)
    (X_gateway fc.clock) (M_of_nat M_nat)
    zeta).mulVec (binomBasis (w + 1) q))
    ((rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1))).symm i)

theorem uniformInitScoreVec_M_zero {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hRM : R_M * (M_of_nat M_nat) = 1)
    (hMJM : (M_of_nat M_nat).transpose * J * (M_of_nat M_nat) = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_of_nat M_nat)).transpose * psi_row zeta (B_mat (w + 1)))
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0)
    (q : ℕ) :
    uniformInitScoreVec_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment q ⟨0, by
      have := uniformFullRankLift_M_m_pos hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment
      omega⟩ =
    dotProduct zeta (binomBasis (w + 1) q) := by
  unfold uniformInitScoreVec_M
  have hm : 0 < (fc.clock.m + 1) + ((w + 1) + (w + 1)) := by omega
  have hm_pos : 0 < fc.clock.m + 1 := by omega
  have hn_pos : 0 < (w + 1) + (w + 1) := by omega
  have hrot := rotLeaderEquiv_symm_zero hm_pos hn_pos
  have hcast : (⟨0, hm⟩ : Fin ((fc.clock.m + 1) + ((w + 1) + (w + 1)))) = ⟨0, by omega⟩ := rfl
  rw [hcast, hrot]
  exact liftedScoreMat_inr_zero_eq_ceiling (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
    J (S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta)
    (X_gateway fc.clock) (M_of_nat M_nat) zeta hJ_lower q

