/-- Concrete order-2 RPS seed phase word. -/
def rpsPhaseWord (q : ℕ) : List (Fin 3) :=
  List.replicate (3 * q + 5) 0 ++ List.replicate (3 * q + 6) 1 ++ List.replicate (3 * q + 7) 2

/-- Exact play-count vector of `rpsPhaseWord q` matches `C2 * binomBasis 2 q`. -/
theorem wordCountVec_rpsPhaseWord (q : ℕ) :
    wordCountVec (rpsPhaseWord q) = rpsFullRankClock.clock.C.mulVec (binomBasis 2 q) := by
  have hC : rpsFullRankClock.clock.C = C2 := rfl
  rw [hC]
  ext i
  fin_cases i <;>
    (unfold wordCountVec rpsPhaseWord
     simp only [List.count_append, List.count_replicate]
     split_ifs <;> try contradiction
     simp [Matrix.mulVec, dotProduct, Fin.sum_univ_two, binomBasis, C2]
     ring)

/-- At the base RPS clock (depth 0), the leader action 0 weakly dominates all actions
    at every phase start `σ : ℕ`. -/
theorem rpsAlgebraicClock_leader_zero_dom (σ : ℕ) (i : Fin rpsAlgebraicClock.m) :
    (rpsAlgebraicClock.R.mulVec (binomBasis 2 σ)) i ≤
      (rpsAlgebraicClock.R.mulVec (binomBasis 2 σ)) ⟨0, by decide⟩ := by
  have hr : rpsAlgebraicClock.R = R2 := rfl
  rw [hr, ← congr_fun (r2Vec_eq_R2_mulVec σ) i, ← congr_fun (r2Vec_eq_R2_mulVec σ) ⟨0, by decide⟩]
  have hσ : 0 ≤ (σ : ℚ) := by positivity
  fin_cases i
  · exact le_rfl
  · simp only [r2Vec]; linarith
  · simp only [r2Vec]; linarith

/-- Unconditional nonpositivity of endpoint counter inner product on proper prefixes of `rpsPhaseWord`:
    for any phase `σ` and prefix length `r < (rpsPhaseWord σ).length`,
    `v_RPS · count(rpsPhaseWord σ.take r) ≤ 0`. -/
theorem rpsPhaseWord_take_v_dot_nonpos (σ r : ℕ) (hr : r < (rpsPhaseWord σ).length) :
    dotProduct rpsAlgebraicClock.v (wordCountVec ((rpsPhaseWord σ).take r)) ≤ 0 := by
  have hdot : dotProduct rpsAlgebraicClock.v (wordCountVec ((rpsPhaseWord σ).take r)) =
      (((rpsPhaseWord σ).take r).count 2 : ℚ) - (((rpsPhaseWord σ).take r).count 1 : ℚ) := by
    change dotProduct v_RPS (wordCountVec ((rpsPhaseWord σ).take r)) = _
    dsimp only [dotProduct]
    rw [Fin.sum_univ_three]
    have h0 : v_RPS 0 = 0 := rfl
    have h1 : v_RPS 1 = -1 := rfl
    have h2 : v_RPS 2 = 1 := rfl
    rw [h0, h1, h2]
    dsimp only [wordCountVec]
    ring
  have hle : ((rpsPhaseWord σ).take r).count 2 ≤ ((rpsPhaseWord σ).take r).count 1 := by
    have hlen : (rpsPhaseWord σ).length = (3 * σ + 5) + (3 * σ + 6) + (3 * σ + 7) := by
      dsimp [rpsPhaseWord]
      simp only [List.length_append, List.length_replicate]
    have hr_len : r < (3 * σ + 5) + (3 * σ + 6) + (3 * σ + 7) := by
      rwa [hlen] at hr
    have htake : ((rpsPhaseWord σ).take r) =
        (List.replicate (3 * σ + 5) 0).take r ++
        (List.replicate (3 * σ + 6) 1).take (r - (3 * σ + 5)) ++
        (List.replicate (3 * σ + 7) 2).take (r - ((3 * σ + 5) + (3 * σ + 6))) := by
      dsimp [rpsPhaseWord]
      rw [List.take_append, List.take_append]
      simp only [List.length_append, List.length_replicate]
    rw [htake]
    simp only [List.count_append, List.take_replicate, List.count_replicate]
    have h02 : (0 : Fin 3) ≠ 2 := by decide
    have h12 : (1 : Fin 3) ≠ 2 := by decide
    have h01 : (0 : Fin 3) ≠ 1 := by decide
    have h21 : (2 : Fin 3) ≠ 1 := by decide
    split_ifs <;> try contradiction
    omega
  have hle_q : (((rpsPhaseWord σ).take r).count 2 : ℚ) ≤
      (((rpsPhaseWord σ).take r).count 1 : ℚ) := by
    exact_mod_cast hle
  rw [hdot]
  linarith




