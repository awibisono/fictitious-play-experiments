/-- RPS Stage 3 active score lower bound with explicit constants `eps = 1/72`, `C_bundle = 7`. -/
theorem rps_bundle_active_lb (q k : ℕ) (hk : k < (W_bundle_word rpsPhaseWord (q + 1)).length) :
    ((q : ℚ) + 2) - 7 - (1 / 72) * (((W_bundle_word rpsPhaseWord (q + 1)).drop k).length : ℚ) ≤
      wordScore rpsFullRankClock.clock.G (rpsFullRankClock.clock.R.mulVec (binomBasis 2 0))
        ((W_bundle_word rpsPhaseWord (q + 1)).take k) (W_bundle_word rpsPhaseWord (q + 1))[k] := by
  refine W_bundle_word_take_forall_drop rpsPhaseWord rpsFullRankClock.clock.G
    (rpsFullRankClock.clock.R.mulVec (binomBasis 2 0)) (q + 1)
    (fun _ score len => ((q : ℚ) + 2) - 7 - (1 / 72) * (len : ℚ) ≤ score) ?_ k hk
  intro idx hidx r hr
  dsimp only
  have hws : wordScore rpsFullRankClock.clock.G (rpsFullRankClock.clock.R.mulVec (binomBasis 2 0))
      (W_bundle_word rpsPhaseWord idx) = rpsFullRankClock.clock.R.mulVec (binomBasis 2 idx) := by
    have h := wordScore_bundle_word rpsFullRankClock.clock rpsPhaseWord wordCountVec_rpsPhaseWord 0 idx
    have h0 : (fun i => rpsFullRankClock.clock.R.mulVec (binomBasis 2 0) i + 0) =
        rpsFullRankClock.clock.R.mulVec (binomBasis 2 0) := by ext i; ring
    have h1 : (fun i => rpsFullRankClock.clock.R.mulVec (binomBasis 2 idx) i + 0) =
        rpsFullRankClock.clock.R.mulVec (binomBasis 2 idx) := by ext i; ring
    rw [h0, h1] at h
    exact h
  rw [hws]
  have hact := rps_active_score_ge_sigma_add_one idx r hr
  have hG : rpsFullRankClock.clock.G = A_RPS := rfl
  have hR : rpsFullRankClock.clock.R = R2 := rfl
  rw [hG, hR]
  have hsum := rps_sum_len_ge (idx + 1) (q + 1) (by omega)
  have hdrop_nonneg : (0 : ℚ) ≤ (((rpsPhaseWord idx).drop r).length : ℚ) := by positivity
  push_cast at hsum ⊢
  linarith

