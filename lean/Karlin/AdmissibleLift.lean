  rw [D_admissible_indep_of_delta clock b H0 ch delta]
  rw [J_admissible_scaled_indep_of_delta clock b H0 ch delta c_zeta]
  rw [zeta_admissible_scaled_indep_of_delta clock b H0 ch delta c_zeta]

/-- Canonical ceiling scale `canonicalCZeta_admissible` is independent of `delta`. -/
theorem canonicalCZeta_admissible_indep_of_delta {w : ℕ} (clock : AlgebraicClock w)
