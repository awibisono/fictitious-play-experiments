theorem uniform_biased_phaseStart_cumScore_eq_M {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hRM : R_M * (M_of_nat M_nat) = 1)
    (hMJM : (M_of_nat M_nat).transpose * J * (M_of_nat M_nat) = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_of_nat M_nat)).transpose * psi_row zeta (B_mat (w + 1)))
    (hM0 : ∀ r : Fin ((w + 1) + (w + 1)), 1 ≤ M_nat r ⟨0, Nat.succ_pos w⟩)
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis w σ))
    {m_rank : ℕ}
    (rank : Fin (uniformFullRankLift_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment).clock.m → Fin m_rank)
    (phaseShift : ℕ)
    (p : ℕ) :
    let uLift := uniformFullRankLift_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment
    let rotEquiv := rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1))
    let defaultAct : Fin uLift.clock.m := ⟨0, by
      have := uniformFullRankLift_M_m_pos hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment
      omega⟩
    let rawWord : ℕ → List (Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1))) := fun q : ℕ =>
      rawFourStageWord_M fc.clock parentWord M_nat (q + phaseShift)
    let phaseWord : ℕ → List (Fin uLift.clock.m) := fun q : ℕ =>
      (rawWord q).map rotEquiv
    let sBiased : ℕ → Fin uLift.clock.m → ℚ := fun q =>
      uniformBiasedInitScoreVec_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment rank phaseShift (q + phaseShift)
    cumScore (setupMatrix uLift.clock.G (canonicalSetupVec (sBiased 0)))
      (wordPhaseTrajectory phaseWord defaultAct)
      (wordPhaseStartStep phaseWord p)
      (wordPhaseTrajectory phaseWord defaultAct (wordPhaseStartStep phaseWord p)) =
    dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) +
      uniformBiasedScoreShift_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment rank phaseShift := by
  intro uLift rotEquiv defaultAct rawWord phaseWord sBiased
  let sInit : ℕ → Fin uLift.clock.m → ℚ := fun q =>
    uniformInitScoreVec_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment (q + phaseShift)
  have hcount : ∀ q : ℕ, 0 < (phaseWord q).length := by
    intro q
    change 0 < ((rawWord q).map rotEquiv).length
    rw [List.length_map]
    dsimp only [rawWord, rawFourStageWord_M]
    simp only [List.length_append, List.length_singleton]
    omega
  have hboundary : ∀ q : ℕ,
      wordScore uLift.clock.G (sInit q) (phaseWord q) = sInit (q + 1) := by
    intro q
    ext i
    have hmap := wordScore_map_equiv rotEquiv
      (liftedGameMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        (P_uniform_M hw fc.clock b c_step H0 delta M_nat R_M J zeta P0 fc.L_C)
        J)
      ((liftedScoreMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        J
        (S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta)
        (X_gateway fc.clock) (M_of_nat M_nat)
        zeta).mulVec (binomBasis (w + 1) (q + phaseShift)))
      (rawWord q) i
    have hPM : (P_uniform_M hw fc.clock b c_step H0 delta M_nat R_M J zeta P0 fc.L_C) * (M_of_nat M_nat) =
        (S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta) * N_mat (w + 1) -
        AdjoinLeaderEndpointG fc.clock.G b fc.clock.v * X_gateway fc.clock :=
      P_uniform_M_mul_M hw fc.clock b c_step H0 delta M_nat R_M J E zeta P0 fc.L_C hRM hMJM hmoment
    have hraw := wordScore_rawFourStageWord_M fc.clock parentWord hparent_count
      (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
      (P_uniform_M hw fc.clock b c_step H0 delta M_nat R_M J zeta P0 fc.L_C)
      J
      (S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta)
      M_nat
      zeta
      (P_uniform_M_transpose_mul_X hw fc.clock b c_step H0 delta M_nat R_M J zeta P0 fc.L_C fc.hLC)
      hPM
      (q + phaseShift)
    have hshift : q + phaseShift + 1 = q + 1 + phaseShift := by omega
    rw [hshift] at hraw
    have hraw_i := congr_fun hraw (rotEquiv.symm i)
    exact hmap.trans hraw_i
  have hboundary_biased : ∀ q : ℕ,
      wordScore uLift.clock.G (sBiased q) (phaseWord q) = sBiased (q + 1) := by
    intro q
    ext i
    change wordScore uLift.clock.G
      (fun j => sInit q j + uniformTieRemovalBias_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment rank phaseShift j)
      (phaseWord q) i =
      sInit (q + 1) i + uniformTieRemovalBias_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment rank phaseShift i
    rw [wordScore_add_bias]
    congr 1
    exact congr_fun (hboundary q) i
  let i0 : Fin uLift.clock.m := defaultAct
  have hact : (phaseWord p)[0]'(hcount p) = i0 :=
    uniform_phaseWord_M_head_eq_zero fc.clock parentWord M_nat hM0 (p + phaseShift) (hcount p)
  have htraj_at := wordPhaseTrajectory_at_phase_start phaseWord defaultAct hcount p
  have hact_0 : wordPhaseAct phaseWord defaultAct p 0 = i0 := by
    unfold wordPhaseAct
    rw [dif_pos (hcount p)]
    exact hact
  rw [hact_0] at htraj_at
  rw [htraj_at]
  have hcum := wordPhaseTrajectory_cumScore_at_phase_start uLift.clock.G
    (canonicalSetupVec (sBiased 0)) (canonicalScoreShift (sBiased 0)) sBiased phaseWord defaultAct
    hcount (fun _ => rfl) hboundary_biased p i0
  rw [hcum]
  have hsinit_i0 : sInit p i0 =
      dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) := by
    dsimp only [sInit, i0, defaultAct]
    exact uniformInitScoreVec_M_zero hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment hJ_lower (p + phaseShift)
  have h0 : 0 + phaseShift = phaseShift := by omega
  have hsBiased_i0 : sBiased p i0 =
      dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) +
      uniformTieRemovalBias_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment rank phaseShift i0 := by
    change sInit p i0 + uniformTieRemovalBias_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment rank phaseShift i0 = _
    rw [hsinit_i0]
  have hshift_def : uniformBiasedScoreShift_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment rank phaseShift =
      uniformTieRemovalBias_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment rank phaseShift i0 +
      canonicalScoreShift (sBiased 0) := by
    dsimp only [uniformBiasedScoreShift_M, i0, defaultAct, sBiased]
    rw [h0]
  rw [hsBiased_i0, hshift_def]
  ring

structure UniformLiftSpec_M {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hRM : R_M * (M_of_nat M_nat) = 1)
    (hMJM : (M_of_nat M_nat).transpose * J * (M_of_nat M_nat) = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_of_nat M_nat)).transpose * psi_row zeta (B_mat (w + 1)))
    (hM0 : ∀ r : Fin ((w + 1) + (w + 1)), 1 ≤ M_nat r ⟨0, Nat.succ_pos w⟩)
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0) where
  phaseShift : ℕ
  parentWord : ℕ → List (Fin fc.clock.m)
  hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis w σ)
  m_rank : ℕ
  hm_rank : 0 < m_rank
  rank : Fin (uniformFullRankLift_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment).clock.m → Fin m_rank
  hpriority_raw : ∀ p : ℕ,
    IsValidPriorityWord
      (liftedGameMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        (P_uniform_M hw fc.clock b c_step H0 delta M_nat R_M J zeta P0 fc.L_C)
        J)
      ((liftedScoreMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        J
        (S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta)
        (X_gateway fc.clock) (M_of_nat M_nat)
        zeta).mulVec (binomBasis (w + 1) (p + phaseShift)))
      (fun i => rank ((rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1))) i))
      (rawFourStageWord_M fc.clock parentWord M_nat (p + phaseShift))
  c_low : ℚ
  c_high : ℚ
  hc_low_pos : 0 < c_low
  hc_high_pos : 0 < c_high
  hgap_low : ∀ p : ℕ,
    c_low * (wordPhaseStartStep (fun q => (rawFourStageWord_M fc.clock parentWord M_nat (q + phaseShift)).map
      (rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1)) : _ ≃ Fin (uniformFullRankLift_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment).clock.m)) (p + 1) : ℚ) ^ w ≤
      (2 * (dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) +
        uniformBiasedScoreShift_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment rank phaseShift)) ^ (w + 1)
  hgap_high : ∀ p : ℕ,
    (2 * (dotProduct zeta (binomBasis (w + 1) (p + 1 + phaseShift)) +
      uniformBiasedScoreShift_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment rank phaseShift)) ^ (w + 1) ≤
      c_high * (wordPhaseStartStep (fun q => (rawFourStageWord_M fc.clock parentWord M_nat (q + phaseShift)).map
        (rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1)) : _ ≃ Fin (uniformFullRankLift_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment).clock.m)) p : ℚ) ^ w

def RealizedClock.ofUniformLift_M {w : ℕ} (hw : 2 ≤ w) (rc : RealizedClock w)
    (b : Fin rc.fc.clock.m) (c_step H0 delta : ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (rc.fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hRM : R_M * (M_of_nat M_nat) = 1)
    (hMJM : (M_of_nat M_nat).transpose * J * (M_of_nat M_nat) = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw rc.fc.clock b c_step H0 delta).transpose * X_gateway rc.fc.clock -
        (ell_row (M_of_nat M_nat)).transpose * psi_row zeta (B_mat (w + 1)))
    (hM0 : ∀ r : Fin ((w + 1) + (w + 1)), 1 ≤ M_nat r ⟨0, Nat.succ_pos w⟩)
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0)
    (spec : UniformLiftSpec_M hw rc.fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment hM0 hJ_lower) :
    RealizedClock (w + 1) :=
  let uLift := uniformFullRankLift_M hw rc.fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment
  let rotEquiv := rotLeaderEquiv (rc.fc.clock.m + 1) ((w + 1) + (w + 1))
  let defaultAct : Fin uLift.clock.m := ⟨0, by
    have := uniformFullRankLift_M_m_pos hw rc.fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment
    omega⟩
  let rawWord : ℕ → List (Fin (rc.fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1))) := fun p : ℕ =>
    rawFourStageWord_M rc.fc.clock spec.parentWord M_nat (p + spec.phaseShift)
  let phaseWord : ℕ → List (Fin uLift.clock.m) := fun p : ℕ =>
    (rawWord p).map rotEquiv
  let sInit : ℕ → Fin uLift.clock.m → ℚ := fun p =>
    uniformInitScoreVec_M hw rc.fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment (p + spec.phaseShift)
  let sBiased : ℕ → Fin uLift.clock.m → ℚ := fun p =>
    uniformBiasedInitScoreVec_M hw rc.fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment spec.rank spec.phaseShift (p + spec.phaseShift)
  have hcount : ∀ p : ℕ, 0 < (phaseWord p).length := by
    intro p
    change 0 < ((rawWord p).map rotEquiv).length
    rw [List.length_map]
    dsimp only [rawWord, rawFourStageWord_M]
    simp only [List.length_append, List.length_singleton]
    omega
  have hboundary : ∀ p : ℕ,
      wordScore uLift.clock.G (sInit p) (phaseWord p) = sInit (p + 1) := by
    intro p
    ext i
    have hmap := wordScore_map_equiv rotEquiv
      (liftedGameMat (AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v)
        (P_uniform_M hw rc.fc.clock b c_step H0 delta M_nat R_M J zeta P0 rc.fc.L_C)
        J)
      ((liftedScoreMat (AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v)
        J
        (S_uniform (by omega) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (by omega) rc.fc.clock b c_step H0) c_step) delta)
        (X_gateway rc.fc.clock) (M_of_nat M_nat)
        zeta).mulVec (binomBasis (w + 1) (p + spec.phaseShift)))
      (rawWord p) i
    have hPM : (P_uniform_M hw rc.fc.clock b c_step H0 delta M_nat R_M J zeta P0 rc.fc.L_C) * (M_of_nat M_nat) =
        (S_uniform (by omega) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (by omega) rc.fc.clock b c_step H0) c_step) delta) * N_mat (w + 1) -
        AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v * X_gateway rc.fc.clock :=
      P_uniform_M_mul_M hw rc.fc.clock b c_step H0 delta M_nat R_M J E zeta P0 rc.fc.L_C hRM hMJM hmoment
    have hraw := wordScore_rawFourStageWord_M rc.fc.clock spec.parentWord spec.hparent_count
      (AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v)
      (P_uniform_M hw rc.fc.clock b c_step H0 delta M_nat R_M J zeta P0 rc.fc.L_C)
      J
      (S_uniform (by omega) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (by omega) rc.fc.clock b c_step H0) c_step) delta)
      M_nat
      zeta
      (P_uniform_M_transpose_mul_X hw rc.fc.clock b c_step H0 delta M_nat R_M J zeta P0 rc.fc.L_C rc.fc.hLC)
      hPM
      (p + spec.phaseShift)
    have hshift : p + spec.phaseShift + 1 = p + 1 + spec.phaseShift := by omega
    rw [hshift] at hraw
    have hraw_i := congr_fun hraw (rotEquiv.symm i)
    exact hmap.trans hraw_i
  have hpriority : ∀ p : ℕ,
      IsValidPriorityWord uLift.clock.G (sInit p) spec.rank (phaseWord p) := by
    intro p
    have hequiv := isValidPriorityWord_map_equiv rotEquiv
      (liftedGameMat (AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v)
        (P_uniform_M hw rc.fc.clock b c_step H0 delta M_nat R_M J zeta P0 rc.fc.L_C)
        J)
      _ (fun i => spec.rank (rotEquiv i)) (rawWord p) (spec.hpriority_raw p)
    have hrank_eq : (fun j => spec.rank (rotEquiv (rotEquiv.symm j))) = spec.rank := by
      ext j
      simp only [Equiv.apply_symm_apply]
    rw [hrank_eq] at hequiv
    exact hequiv
  have h0_phase : 0 + spec.phaseShift = spec.phaseShift := by omega
  have hsInit0 : sInit 0 = uniformInitScoreVec_M hw rc.fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment spec.phaseShift := by
    dsimp only [sInit]
    rw [h0_phase]
  have hstrict_pair := priority_phase_family_canonical_strict
    uLift.clock.G sInit spec.rank phaseWord spec.hm_rank hboundary hpriority
  have hvalid : ∀ p : ℕ,
      IsValidStrictWord uLift.clock.G (sBiased p) (phaseWord p) := by
    intro p
    have hv := hstrict_pair.1 p
    rw [hsInit0] at hv
    exact hv
  have hboundary_biased : ∀ p : ℕ,
      wordScore uLift.clock.G (sBiased p) (phaseWord p) = sBiased (p + 1) := by
    intro p
    have hb := hstrict_pair.2 p
    rw [hsInit0] at hb
    exact hb
  have hword_pos : ∀ (p v : ℕ) (hv : v < (phaseWord p).length),
      0 < wordScore uLift.clock.G (sBiased p) ((phaseWord p).take v) ((phaseWord p)[v]) +
          canonicalScoreShift (sBiased 0) :=
    wordScore_add_canonicalScoreShift_pos uLift.clock.G uLift.clock.hskew
      sBiased phaseWord hcount hboundary_biased hvalid
  have hstrict :
      IsStrictFPTrajectory (setupMatrix uLift.clock.G (canonicalSetupVec (sBiased 0)))
        (wordPhaseTrajectory phaseWord defaultAct) :=
    word_phase_unroll_isStrictFPTrajectory
      uLift.clock.G (canonicalSetupVec (sBiased 0)) (canonicalScoreShift (sBiased 0))
      sBiased phaseWord defaultAct
      hcount (canonicalSetupVec_nonneg (sBiased 0))
      (fun i => rfl)
      hboundary_biased hvalid hword_pos
  have hskew : IsSkewSymmetric (setupMatrix uLift.clock.G (canonicalSetupVec (sBiased 0))) :=
    setupMatrix_skewSymmetric uLift.clock.hskew (canonicalSetupVec (sBiased 0))
  have hpt_zero := wordPhaseStartStep_zero phaseWord
  have hpt_lt := wordPhaseStartStep_strictMono phaseWord hcount
  have hleader : ∀ p : ℕ, ∃ i0 : Fin uLift.clock.m,
      wordPhaseTrajectory phaseWord defaultAct (wordPhaseStartStep phaseWord p) = some i0 := by
    intro p
    exact ⟨wordPhaseAct phaseWord defaultAct p 0, wordPhaseTrajectory_at_phase_start phaseWord defaultAct hcount p⟩
  { fc := uLift
    setupVec := canonicalSetupVec (sBiased 0)
    phaseShift := spec.phaseShift
    scoreShift := canonicalScoreShift (sBiased 0)
    A_adm := 0
    hA_adm_nonneg := le_rfl
    hsetup_nonneg := canonicalSetupVec_nonneg (sBiased 0)
    trajectory := wordPhaseTrajectory phaseWord defaultAct
    phaseTime := wordPhaseStartStep phaseWord
    htraj_zero := rfl
    hstrict := hstrict
    hphaseTime_zero := hpt_zero
    hphaseTime_lt := hpt_lt
    hphase_leader := hleader
    c_low := spec.c_low
    c_high := spec.c_high
    hc_low_pos := spec.hc_low_pos
    hc_high_pos := spec.hc_high_pos
    hgap_bounds := fun t ht => by
      have hgap_l : ∀ p : ℕ,
        spec.c_low * (wordPhaseStartStep phaseWord (p + 1) : ℚ) ^ w ≤
          (2 * cumScore (setupMatrix uLift.clock.G (canonicalSetupVec (sBiased 0)))
            (wordPhaseTrajectory phaseWord defaultAct)
            (wordPhaseStartStep phaseWord p)
            (wordPhaseTrajectory phaseWord defaultAct (wordPhaseStartStep phaseWord p))) ^ (w + 1) := by
        intro p
        have hcs := uniform_biased_phaseStart_cumScore_eq_M hw rc.fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment hM0 hJ_lower
          spec.parentWord spec.hparent_count spec.rank spec.phaseShift p
        rw [hcs]
        exact spec.hgap_low p
      have hgap_h : ∀ p : ℕ,
        (2 * cumScore (setupMatrix uLift.clock.G (canonicalSetupVec (sBiased 0)))
          (wordPhaseTrajectory phaseWord defaultAct)
          (wordPhaseStartStep phaseWord (p + 1))
          (wordPhaseTrajectory phaseWord defaultAct (wordPhaseStartStep phaseWord (p + 1)))) ^ (w + 1) ≤
          spec.c_high * (wordPhaseStartStep phaseWord p : ℚ) ^ w := by
        intro p
        have hcs := uniform_biased_phaseStart_cumScore_eq_M hw rc.fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment hM0 hJ_lower
          spec.parentWord spec.hparent_count spec.rank spec.phaseShift (p + 1)
        rw [hcs]
        exact spec.hgap_high p
      exact all_integer_time_power_gap_bounds hskew hstrict hpt_zero hpt_lt
        (Nat.le_add_left 1 w) hgap_l hgap_h t ht }

theorem RealizedClock.ofUniformLift_M_fc {w : ℕ} (hw : 2 ≤ w) (rc : RealizedClock w)
    (b : Fin rc.fc.clock.m) (c_step H0 delta : ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (rc.fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hRM : R_M * (M_of_nat M_nat) = 1)
    (hMJM : (M_of_nat M_nat).transpose * J * (M_of_nat M_nat) = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw rc.fc.clock b c_step H0 delta).transpose * X_gateway rc.fc.clock -
        (ell_row (M_of_nat M_nat)).transpose * psi_row zeta (B_mat (w + 1)))
    (hM0 : ∀ r : Fin ((w + 1) + (w + 1)), 1 ≤ M_nat r ⟨0, Nat.succ_pos w⟩)
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0)
    (spec : UniformLiftSpec_M hw rc.fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment hM0 hJ_lower) :
    (RealizedClock.ofUniformLift_M hw rc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment hM0 hJ_lower spec).fc =
      uniformFullRankLift_M hw rc.fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment :=
  rfl



/-!
## Section 31_M: Grounded Duality Gap Bounds for General M
-/

def C_len_M {k : ℕ} (fc : FullRankClock k) (M_nat : Matrix (Fin ((k + 1) + (k + 1))) (Fin (k + 1)) ℕ) : ℚ :=
  1 + ∑ x : Fin (fc.clock.m + 1) ⊕ Fin ((k + 1) + (k + 1)),
    ∑ c : Fin (k + 1), |(liftedCountMat (X_gateway fc.clock) (M_of_nat M_nat) (N_mat (k + 1))) x c|

theorem C_len_M_pos {k : ℕ} (fc : FullRankClock k) (M_nat : Matrix (Fin ((k + 1) + (k + 1))) (Fin (k + 1)) ℕ) :
    0 < C_len_M fc M_nat := by
  unfold C_len_M
  have : 0 ≤ ∑ x : Fin (fc.clock.m + 1) ⊕ Fin ((k + 1) + (k + 1)),
      ∑ c : Fin (k + 1), |(liftedCountMat (X_gateway fc.clock) (M_of_nat M_nat) (N_mat (k + 1))) x c| := by
    refine Finset.sum_nonneg fun x _ => ?_
    refine Finset.sum_nonneg fun c _ => abs_nonneg _
  linarith

def bundle_c_low_M {k : ℕ} (fc : FullRankClock k)
    (M_nat : Matrix (Fin ((k + 1) + (k + 1))) (Fin (k + 1)) ℕ) (phaseShift : ℕ) : ℚ :=
  (2 / (k.factorial : ℚ)) ^ (k + 1) / ((1 + C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k)) ^ k)

theorem bundle_c_low_M_pos {k : ℕ} (fc : FullRankClock k)
    (M_nat : Matrix (Fin ((k + 1) + (k + 1))) (Fin (k + 1)) ℕ) (phaseShift : ℕ) :
    0 < bundle_c_low_M fc M_nat phaseShift := by
  unfold bundle_c_low_M
  have hfact_pos : 0 < (k.factorial : ℚ) := by positivity
  have hbase : 0 < 2 / (k.factorial : ℚ) := by positivity
  have hdenom : 0 < 1 + C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k) := by
    have : 0 < C_len_M fc M_nat := C_len_M_pos fc M_nat
    positivity
  positivity

theorem rawFourStageWord_M_length_eq_sum_liftedCountMat {k : ℕ} (clock : AlgebraicClock k)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis k σ))
    (M_nat : Matrix (Fin ((k + 1) + (k + 1))) (Fin (k + 1)) ℕ) (q : ℕ) :
    ((rawFourStageWord_M clock parentWord M_nat q).length : ℚ) =
      ∑ x : Fin (clock.m + 1) ⊕ Fin ((k + 1) + (k + 1)),
        (liftedCountMat (X_gateway clock) (M_of_nat M_nat) (N_mat (k + 1))).mulVec (binomBasis (k + 1) q) x := by
  rw [list_length_eq_sum_wordCountVec, wordCountVec_rawFourStageWord_M clock parentWord hparent_count M_nat q]

theorem rawFourStageWord_M_length_upper_bound {k : ℕ} (fc : FullRankClock k)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis k σ))
    (M_nat : Matrix (Fin ((k + 1) + (k + 1))) (Fin (k + 1)) ℕ)
    (phaseShift q : ℕ) :
    ((rawFourStageWord_M fc.clock parentWord M_nat (q + phaseShift)).length : ℚ) ≤
      C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k) := by
  let L := liftedCountMat (X_gateway fc.clock) (M_of_nat M_nat) (N_mat (k + 1))
  have h_len := rawFourStageWord_M_length_eq_sum_liftedCountMat fc.clock parentWord hparent_count M_nat (q + phaseShift)
  rw [h_len]
  have h_binom_nonneg : ∀ c : Fin (k + 1), 0 ≤ binomBasis (k + 1) (q + phaseShift) c := by
    intro c; unfold binomBasis; positivity
  have h_bound_x : ∀ x : Fin (fc.clock.m + 1) ⊕ Fin ((k + 1) + (k + 1)),
      (L.mulVec (binomBasis (k + 1) (q + phaseShift))) x ≤
        (∑ c : Fin (k + 1), |L x c|) * (((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k)) := by
    intro x
    dsimp only [Matrix.mulVec, dotProduct]
    have h_le_c : ∀ c ∈ (Finset.univ : Finset (Fin (k + 1))), L x c * binomBasis (k + 1) (q + phaseShift) c ≤
        |L x c| * (((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k)) := by
      intro c _
      have h1 : L x c ≤ |L x c| := le_abs_self _
      have h2 := binomBasis_upper_bound k q phaseShift c
      have h_nonneg_prod : 0 ≤ ((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k) := by positivity
      calc L x c * binomBasis (k + 1) (q + phaseShift) c ≤
          |L x c| * binomBasis (k + 1) (q + phaseShift) c := mul_le_mul_of_nonneg_right h1 (h_binom_nonneg c)
        _ ≤ |L x c| * (((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k)) :=
          mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
    have h_sum_c := Finset.sum_le_sum h_le_c
    rw [← Finset.sum_mul] at h_sum_c
    exact h_sum_c
  have h_total_sum := Finset.sum_le_sum fun x (_ : x ∈ Finset.univ) => h_bound_x x
  rw [← Finset.sum_mul] at h_total_sum
  have h_sum_le_C_len : (∑ x : Fin (fc.clock.m + 1) ⊕ Fin ((k + 1) + (k + 1)), ∑ c : Fin (k + 1), |L x c|) ≤ C_len_M fc M_nat := by
    unfold C_len_M
    linarith
  have h_prod_nonneg : 0 ≤ ((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k) := by positivity
  calc ∑ x : Fin (fc.clock.m + 1) ⊕ Fin ((k + 1) + (k + 1)), (L.mulVec (binomBasis (k + 1) (q + phaseShift))) x ≤
