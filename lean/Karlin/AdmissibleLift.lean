theorem uniform_stage3_valid_M' {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hRM : R_M * (M_of_nat M_nat) = 1)
    (hMJM : (M_of_nat M_nat).transpose * J * (M_of_nat M_nat) = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row (M_of_nat M_nat)).transpose * psi_row zeta (B_mat (w + 1)))
    (parentWord : ℕ → List (Fin clock.m))
    (parent_rank : Fin clock.m → Fin clock.m)
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (hparent_valid : ∀ σ : ℕ,
      IsValidPriorityWord clock.G (clock.R.mulVec (binomBasis w σ)) parent_rank (parentWord σ))
    (q : ℕ)
    (h_gw_waits : ∀ (k : ℕ) (hk : k < (W_bundle_word parentWord (q + 1)).length),
      let G_O := AdjoinLeaderEndpointG clock.G b clock.v
      let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
      let X := X_gateway clock
      let M := M_of_nat M_nat
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)
      let s_mid := wordScore (liftedGameMat G_O (P_uniform_M hw clock b c_step H0 delta M_nat R_M J zeta P0 L_C) J) s0
        (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q)
      wordScore G_O (fun u => s_mid (Sum.inl u))
        (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).take k)
        (gatewayOldAct clock.m) <
      wordScore G_O (fun u => s_mid (Sum.inl u))
        (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).take k)
        (parentToOldAct clock.m ((W_bundle_word parentWord (q + 1))[k]'hk)))
    (h_reset_waits : ∀ (k : ℕ)
      (hk : k < ((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).length)
      (j : Fin ((w + 1) + (w + 1))),
      let G_O := AdjoinLeaderEndpointG clock.G b clock.v
      let P := P_uniform_M hw clock b c_step H0 delta M_nat R_M J zeta P0 L_C
      let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
      let X := X_gateway clock
      let M := M_of_nat M_nat
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)
      let s_mid := wordScore (liftedGameMat G_O P J) s0 (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q)
      s_mid (Sum.inr j) -
        ∑ u, P u j * wordCountVec (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).take k) u ≤
        wordScore G_O (fun u => s_mid (Sum.inl u))
          (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).take k)
          (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m))[k])) :
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let P := P_uniform_M hw clock b c_step H0 delta M_nat R_M J zeta P0 L_C
    let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
    let X := X_gateway clock
    let M := M_of_nat M_nat
    let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)
    IsValidPriorityWord (liftedGameMat G_O P J)
      (wordScore (liftedGameMat G_O P J) s0 (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q))
      (paperPriorityRank clock.m w parent_rank)
      ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)) := by
  intro G_O P S X M s0
  let s_mid := wordScore (liftedGameMat G_O P J) s0 (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q)
  have hPM : P * (M_of_nat M_nat) = S * N_mat (w + 1) - G_O * X :=
    P_uniform_M_mul_M hw clock b c_step H0 delta M_nat R_M J E zeta P0 L_C hRM hMJM hmoment
  have hs_after : ∀ u : Fin (clock.m + 1), s_mid (Sum.inl u) = S.mulVec (binomBasis (w + 1) (q + 1)) u := by
    intro u
    dsimp only [s_mid, s0]
    exact wordScore_after_reset_stages_M_inl clock G_O P J S M_nat zeta hPM q u
  let c_shift := dotProduct (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) (binomBasis (w + 1) (q + 1))
  have hs_agree : ∀ i : Fin clock.m, s_mid (Sum.inl (parentToOldAct clock.m i)) =
      clock.R.mulVec (binomBasis w 0) i + c_shift := by
    intro i
    rw [hs_after]
    have hp : parentToOldAct clock.m i = finSumFinEquiv (Sum.inl i) := rfl
    rw [hp]
    dsimp only [S]
    rw [S_uniform_parent_eval (by omega) clock b _ delta i q]
    have hR0 : clock.R.mulVec (binomBasis w 0) i = clock.R i ⟨0, by omega⟩ := by
      simp only [Matrix.mulVec, dotProduct, binomBasis]
      rw [Finset.sum_eq_single ⟨0, by omega⟩]
      · simp
      · intro j _ hj
        have : j.val ≠ 0 := by intro h; apply hj; ext; exact h
        have : Nat.choose 0 j.val = 0 := Nat.choose_eq_zero_of_lt (by omega)
        simp [this]
      · intro h; exact False.elim (h (Finset.mem_univ _))
    rw [hR0]
  have hG_agree : ∀ i j : Fin clock.m,
      G_O (parentToOldAct clock.m i) (parentToOldAct clock.m j) = clock.G i j := by
    intro i j
    dsimp only [G_O]
    exact AdjoinLeaderEndpointG_parent_parent clock.G b clock.v i j
  exact isValidPriorityWord_stage3_bundle_from_parent' clock parentWord parent_rank
    hparent_count hparent_valid q c_shift G_O P J s_mid
    hG_agree hs_agree h_gw_waits h_reset_waits

