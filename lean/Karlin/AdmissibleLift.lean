  ext c
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun x =>
      a_old_rps_four_thirds_H0 H0 x * X_gateway rpsFullRankClock.clock x c).symm
  dsimp [Matrix.vecMul, dotProduct]
  rw [hcomp, Fintype.sum_sum_type]
  have hX_inr : (∑ g : Fin 1, a_old_rps_four_thirds_H0 H0 (finSumFinEquiv (Sum.inr g)) *
      X_gateway rpsFullRankClock.clock (finSumFinEquiv (Sum.inr g)) c) =
      (2 * H0 - 4 / 3) * e0_row 3 c := by
    rw [Fin.sum_univ_one]
    dsimp [a_old_rps_four_thirds_H0, X_gateway, X_coupled]
