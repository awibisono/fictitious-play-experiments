      have hj_ne0 : ¬ (j.val = 0) := by omega
      have h_if : (if j.val = 0 then clock.R b ⟨0, by omega⟩ + delta else 0) = 0 := by
        simp only [hj_ne0, ↓reduceIte]
      rw [h_if, add_zero]
      by_cases hjw : j.val < w
      · dsimp only [h]
        unfold h_uniform
        simp only [hjw, hj_ne0, ↓reduceDIte, ↓reduceIte, sub_zero]
        have h_mul := shiftRightCount_R_mul_N_mat (by omega) clock b j
        rw [if_neg hj_ne0] at h_mul
        rw [← h_mul, mul_N_mat_apply]
        have hd_lt : j.val + 1 < w + 1 := by omega
        simp only [hd_lt, ↓reduceDIte]
        have hshift_entry : shiftRightCount clock.R b ⟨j.val + 1, hd_lt⟩ = clock.R b ⟨j.val, hjw⟩ := by
          unfold shiftRightCount
          simp only [Matrix.of_apply]
          have hpos : 0 < j.val + 1 := by omega
          simp only [hpos, ↓reduceDIte]
          congr 1
        rw [hshift_entry]
        have h_jm := h_JM_nonneg r j
        linarith
      · have hj_eq_w : j.val = w := by have := j.isLt; omega
        have heq_j : j = ⟨w, Nat.lt_succ_self w⟩ := by ext; exact hj_eq_w
        rw [heq_j]
        have h_shift_b : (clock.G * shiftRightCount clock.C) b ⟨w, Nat.lt_succ_self w⟩ = 0 := by
          have h_mul := shiftRightCount_R_mul_N_mat (by omega) clock b ⟨w, Nat.lt_succ_self w⟩
          have hw_ne : ¬ (w = 0) := by omega
          rw [if_neg hw_ne] at h_mul
          rw [← h_mul, mul_N_mat_apply]
          have h_col : ¬ (w + 1 < w + 1) := by omega
          simp only [h_col, ↓reduceDIte]
        rw [h_shift_b, add_zero]
        dsimp only [h]
        unfold h_uniform
        have h_w_lt : ¬ (w < w) := by omega
        have hw_ne : ¬ (w = 0) := by omega
        simp only [h_w_lt, hw_ne, ↓reduceDIte, ↓reduceIte, sub_zero]
        have h_jm := h_JM_nonneg r ⟨w, Nat.lt_succ_self w⟩
        linarith


/-- Next-order raw word length bound: choose q w ≤ length. -/
theorem step_parentWord_length_ge_choose (r : Fin ((w + 1) + (w + 1)))
    (hr : 1 ≤ M_lower_nat w grc.u r ⟨w, Nat.lt_succ_self w⟩) (q : ℕ) :
    (Nat.choose q w : ℚ) ≤
      ((rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) q).length : ℚ) :=
  rawFourStageWord_M_length_ge_choose grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) r hr q


/-- Next-order parent word family for . -/
def step_parentWord (q : ℕ) : List (Fin grc.step_rc.fc.clock.m) :=
  (rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) q).map
    (rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1)))

/-- Prefix dot-product vanishing with endpoint weight vector for the next-order parent word. -/
theorem step_parentWord_take_v_dot_eq_zero (q r : ℕ)
    (hr : r < (step_parentWord grc q).length) :
    dotProduct grc.step_rc.fc.clock.v
      (wordCountVec ((step_parentWord grc q).take r)) = 0 := by
  let rotEquiv := rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))
  have hlen : (step_parentWord grc q).length =
      (rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) q).length := by
    dsimp [step_parentWord]
    rw [List.length_map]
  have hr_raw : r < (rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) q).length := by
    rwa [← hlen]
  have h_take : (step_parentWord grc q).take r =
      ((rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) q).take r).map rotEquiv := by
    dsimp [step_parentWord]
    rw [List.map_take]
  rw [h_take]
  have hv : grc.step_rc.fc.clock.v = fun a =>
      liftedWeightVec (v_old_coupled grc.rc.fc.clock.m) (0 : Fin ((w + 1) + (w + 1)) → ℚ) (rotEquiv.symm a) := by
    ext a
    change (uniformFullRankLift_M grc.hw grc.rc.fc grc.b grc.c_step grc.H0 grc.delta
      (M_lower_nat w grc.u)
      (R_M_lower w (fun c => 2 * (grc.u c : ℚ)))
      (J_lower_eta w (fun c => 2 * (grc.u c : ℚ)) (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta)
      (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha)
      (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0)
      grc.P0
      (R_M_lower_mul_M_lower_nat w grc.u grc.hu0 grc.hui)
      (M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w grc.u _ grc.eta grc.hu0 grc.hui)
      (E_uniform_total_moment_equation_M_lower_nat grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha grc.u (by have := grc.hu0; omega) grc.hell (by rw [grc.hb_subdiag]; norm_num))).clock.v a = _
    dsimp [uniformFullRankLift_M, AlgebraicClock.ofEquiv]
  rw [hv]
  simp only [dotProduct]
  have hinj : Function.Injective rotEquiv := rotEquiv.injective
  let W_raw := (rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) q).take r
  have hequiv_sum := Equiv.sum_comp rotEquiv (fun a =>
    liftedWeightVec (v_old_coupled grc.rc.fc.clock.m) 0 (rotEquiv.symm a) * wordCountVec (W_raw.map rotEquiv) a)
  change (∑ i, liftedWeightVec (v_old_coupled grc.rc.fc.clock.m) 0 (rotEquiv.symm i) * wordCountVec (W_raw.map rotEquiv) i) = 0
  rw [← hequiv_sum]
  have hterm : ∀ y, liftedWeightVec (v_old_coupled grc.rc.fc.clock.m) 0 (rotEquiv.symm (rotEquiv y)) *
      wordCountVec (W_raw.map rotEquiv) (rotEquiv y) =
      liftedWeightVec (v_old_coupled grc.rc.fc.clock.m) 0 y * wordCountVec W_raw y := by
    intro y
    rw [rotEquiv.symm_apply_apply]
    unfold wordCountVec
    rw [list_count_map_of_injective rotEquiv hinj W_raw y]
  simp_rw [hterm]
  change dotProduct (liftedWeightVec (v_old_coupled grc.rc.fc.clock.m) (0 : Fin ((w + 1) + (w + 1)) → ℚ))
    (wordCountVec ((rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) q).take r)) = 0
  exact rawFourStageWord_M_take_v_dot_eq_zero grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) q r hr_raw


/-- Preservation of CGC vanishing across the algebraic equivalence in the lifted clock. -/
theorem step_clock_CGC_zero_of_lifted
    (h_lifted : (liftedCountMat (X_gateway grc.rc.fc.clock) (M_of_nat (M_lower_nat w grc.u)) (N_mat (w + 1))).transpose *
      liftedGameMat (AdjoinLeaderEndpointG grc.rc.fc.clock.G grc.b grc.rc.fc.clock.v)
        (P_uniform_M grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta
          (M_lower_nat w grc.u) (R_M_lower w (fun c => 2 * (grc.u c : ℚ)))
          (J_lower_eta w (fun c => 2 * (grc.u c : ℚ)) (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta)
          (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0) grc.P0 grc.rc.fc.L_C)
        (J_lower_eta w (fun c => 2 * (grc.u c : ℚ)) (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta) *
      liftedCountMat (X_gateway grc.rc.fc.clock) (M_of_nat (M_lower_nat w grc.u)) (N_mat (w + 1)) = 0) :
    grc.step_rc.fc.clock.C.transpose * grc.step_rc.fc.clock.G * grc.step_rc.fc.clock.C = 0 := by
  let rotEquiv := rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))
  let G_O := AdjoinLeaderEndpointG grc.rc.fc.clock.G grc.b grc.rc.fc.clock.v
  let P := P_uniform_M grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta
    (M_lower_nat w grc.u) (R_M_lower w (fun c => 2 * (grc.u c : ℚ)))
    (J_lower_eta w (fun c => 2 * (grc.u c : ℚ)) (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta)
    (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0) grc.P0 grc.rc.fc.L_C
  let J := J_lower_eta w (fun c => 2 * (grc.u c : ℚ)) (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta
  let X := X_gateway grc.rc.fc.clock
  let M := M_of_nat (M_lower_nat w grc.u)
  let G_lifted := liftedGameMat G_O P J
  let C_lifted := liftedCountMat X M (N_mat (w + 1))
  have hC : grc.step_rc.fc.clock.C = Matrix.of fun i c => C_lifted (rotEquiv.symm i) c := by
    change (uniformFullRankLift_M grc.hw grc.rc.fc grc.b grc.c_step grc.H0 grc.delta
      (M_lower_nat w grc.u)
      (R_M_lower w (fun c => 2 * (grc.u c : ℚ)))
      (J_lower_eta w (fun c => 2 * (grc.u c : ℚ)) (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta)
      (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha)
      (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0)
      grc.P0
      (R_M_lower_mul_M_lower_nat w grc.u grc.hu0 grc.hui)
      (M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w grc.u _ grc.eta grc.hu0 grc.hui)
      (E_uniform_total_moment_equation_M_lower_nat grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha grc.u (by have := grc.hu0; omega) grc.hell (by rw [grc.hb_subdiag]; norm_num))).clock.C = _
    dsimp [uniformFullRankLift_M, AlgebraicClock.ofEquiv]
  have hG : grc.step_rc.fc.clock.G = Matrix.of fun i j => G_lifted (rotEquiv.symm i) (rotEquiv.symm j) := by
    change (uniformFullRankLift_M grc.hw grc.rc.fc grc.b grc.c_step grc.H0 grc.delta
      (M_lower_nat w grc.u)
      (R_M_lower w (fun c => 2 * (grc.u c : ℚ)))
      (J_lower_eta w (fun c => 2 * (grc.u c : ℚ)) (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta)
      (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha)
      (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0)
      grc.P0
      (R_M_lower_mul_M_lower_nat w grc.u grc.hu0 grc.hui)
      (M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w grc.u _ grc.eta grc.hu0 grc.hui)
      (E_uniform_total_moment_equation_M_lower_nat grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha grc.u (by have := grc.hu0; omega) grc.hell (by rw [grc.hb_subdiag]; norm_num))).clock.G = _
    dsimp [uniformFullRankLift_M, AlgebraicClock.ofEquiv]
  rw [Matrix.mul_assoc]
  rw [hC, hG]
  ext c1 c2
  simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply]
  have h_inner : ∀ i, (∑ k, G_lifted (rotEquiv.symm i) (rotEquiv.symm k) * C_lifted (rotEquiv.symm k) c2) =
      ∑ z, G_lifted (rotEquiv.symm i) z * C_lifted z c2 := by
    intro i
    have he := Equiv.sum_comp rotEquiv (fun a => G_lifted (rotEquiv.symm i) (rotEquiv.symm a) * C_lifted (rotEquiv.symm a) c2)
    rw [← he]
    refine Finset.sum_congr rfl fun z _ => ?_
    rw [rotEquiv.symm_apply_apply]
  simp_rw [h_inner]
  have he := Equiv.sum_comp rotEquiv (fun a => C_lifted (rotEquiv.symm a) c1 * (∑ z, G_lifted (rotEquiv.symm a) z * C_lifted z c2))
  change (∑ x : Fin (grc.rc.fc.clock.m + 1 + (w + 1 + (w + 1))), C_lifted (rotEquiv.symm x) c1 * ∑ z, G_lifted (rotEquiv.symm x) z * C_lifted z c2) = 0
  rw [← he]
  simp_rw [rotEquiv.symm_apply_apply]
  have h_eval : (C_lifted.transpose * (G_lifted * C_lifted)) c1 c2 = 0 := by
    rw [← Matrix.mul_assoc]
    rw [h_lifted]
    rfl
  simp only [Matrix.mul_apply, Matrix.transpose_apply] at h_eval
  exact h_eval



end GroundedRealizedClockTower


/-- Decomposition of a prefix index `k` of `W_bundle_word parentWord K` into a subphase
    `idx < K` and an inner index `r < (parentWord idx).length`. -/
theorem W_bundle_word_take_decomp {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (K : ℕ) (k : ℕ) (hk : k < (W_bundle_word parentWord K).length) :
    ∃ (idx : ℕ) (r : ℕ) (hr : r < (parentWord idx).length), idx < K ∧
      wordScore clock.G (clock.R.mulVec (binomBasis w 0))
          ((W_bundle_word parentWord K).take k) ((W_bundle_word parentWord K)[k]) =
        wordScore clock.G (clock.R.mulVec (binomBasis w idx))
          ((parentWord idx).take r) ((parentWord idx)[r]) ∧
      (((W_bundle_word parentWord K).drop k).length : ℚ) =
        (((parentWord idx).drop r).length : ℚ) +
          ∑ τ ∈ Finset.Ico (idx + 1) K, ((parentWord τ).length : ℚ) := by
  induction K generalizing k with
  | zero => simp [W_bundle_word] at hk
  | succ K ih =>
    have hflat : W_bundle_word parentWord (K + 1) = W_bundle_word parentWord K ++ parentWord K := by
      unfold W_bundle_word
      rw [@List.range_succ K, List.flatMap_append]
      simp
    have hk' : k < (W_bundle_word parentWord K ++ parentWord K).length := by rw [← hflat]; exact hk
    simp only [hflat]
    rw [List.length_append] at hk'
    by_cases hk1 : k < (W_bundle_word parentWord K).length
    · obtain ⟨idx, r, hr, hidx, hscore, hlen⟩ := ih k hk1
      refine ⟨idx, r, hr, by omega, ?_, ?_⟩
      · rw [List.take_append_of_le_length (le_of_lt hk1), List.getElem_append_left hk1]
        exact hscore
      · rw [List.drop_append_of_le_length (le_of_lt hk1), List.length_append]
        push_cast
        rw [hlen, Finset.sum_Ico_succ_top (by omega : idx + 1 ≤ K)]
        ring
    · have hle : (W_bundle_word parentWord K).length ≤ k := le_of_not_gt hk1
      have hk2 : k - (W_bundle_word parentWord K).length < (parentWord K).length := by omega
      refine ⟨K, k - (W_bundle_word parentWord K).length, hk2, by omega, ?_, ?_⟩
      · rw [List.take_append, List.take_of_length_le hle, List.getElem_append_right hle,
          wordScore_append]
        have hws : wordScore clock.G (clock.R.mulVec (binomBasis w 0)) (W_bundle_word parentWord K) =
            clock.R.mulVec (binomBasis w K) := by
          ext i
          rw [wordScore_W_bundle_word_general clock parentWord hparent_count]
          ring
        rw [hws]
      · rw [List.drop_append, List.drop_of_length_le hle, List.nil_append]
        simp

/-- **Active parent score lower bound for the Stage 3 bundle from `HasSuffixBound`.** -/
theorem bundle_active_score_lb_of_hasSuffixBound {w : ℕ} (hw : 2 ≤ w)
    (clock : AlgebraicClock w) (b : Fin clock.m)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (h_suffix : HasSuffixBound clock b parentWord)
    (h_len : ∀ τ : ℕ, (Nat.choose (τ + w - 1) (w - 1) : ℚ) ≤ ((parentWord τ).length : ℚ))
    (eps : ℚ) (heps : 0 < eps) :
    ∃ C_bundle : ℚ, 0 ≤ C_bundle ∧
      ∀ (c_step H0 delta : ℚ) (q : ℕ) (k : ℕ)
        (hk : k < ((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).length),
        dotProduct (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0) (binomBasis (w + 1) (q + 1)) -
            c_step - C_bundle -
            eps * ((((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).drop k).length : ℚ) ≤
          wordScore (AdjoinLeaderEndpointG clock.G b clock.v)
            ((S_uniform (Nat.le_of_succ_le hw) clock b
              (h_uniform clock b (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0) c_step)
              delta).mulVec (binomBasis (w + 1) (q + 1)))
            (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).take k)
            (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m))[k]) := by
  obtain ⟨A, hA, hA_bound⟩ := h_suffix eps heps
  obtain ⟨B, hB, hB_bound⟩ := subphase_leader_diff_le_eps_length_add_const hw clock b parentWord h_len eps heps
  refine ⟨A + B, by linarith, ?_⟩
  intro c_step H0 delta q k hk
  have hk_b : k < (W_bundle_word parentWord (q + 1)).length := by simpa using hk
  set zeta := zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0 with hzeta
  set h := h_uniform clock b zeta c_step with hh
  have hget : ((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m))[k] =
      parentToOldAct clock.m ((W_bundle_word parentWord (q + 1))[k]'hk_b) := by
    simp
  rw [hget, wordScore_bundle_take_parentToOldAct_uniform (Nat.le_of_succ_le hw) clock b h delta
    (W_bundle_word parentWord (q + 1)) q k]
  rw [dotProduct_h_uniform_binomBasis clock b zeta c_step (q + 1)]
  have hdrop_len : ((((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).drop k).length : ℚ) =
      (((W_bundle_word parentWord (q + 1)).drop k).length : ℚ) := by
    simp
  rw [hdrop_len]
  obtain ⟨idx, r, hr, hidx, hscore, hlen⟩ :=
    W_bundle_word_take_decomp clock parentWord hparent_count (q + 1) k hk_b
  rw [hscore, hlen]
  have h1 := hA_bound idx r hr
  have h2 := hB_bound (idx + 1) q (by omega)
  have hnn : 0 ≤ eps * (((parentWord idx).drop r).length : ℚ) := by positivity
  nlinarith


theorem W_bundle_word_length_eq_sum {m : ℕ} (parentWord : ℕ → List (Fin m)) (K : ℕ) :
    ((W_bundle_word parentWord K).length : ℚ) = ∑ τ ∈ Finset.range K, ((parentWord τ).length : ℚ) := by
  induction K with
  | zero => simp [W_bundle_word]
  | succ K ih =>
    have hflat : W_bundle_word parentWord (K + 1) = W_bundle_word parentWord K ++ parentWord K := by
      unfold W_bundle_word
      rw [@List.range_succ K, List.flatMap_append]
      simp
    rw [hflat, List.length_append, Finset.sum_range_succ]
    push_cast
    rw [ih]

theorem R_mulVec_binomBasis_zero_apply {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (i : Fin clock.m) :
    clock.R.mulVec (binomBasis w 0) i = clock.R i ⟨0, hw⟩ := by
  simp only [Matrix.mulVec, dotProduct, binomBasis]
  rw [Finset.sum_eq_single ⟨0, hw⟩]
  · simp
  · intro j _ hj
    have : j.val ≠ 0 := by intro h; apply hj; ext; exact h
    have : Nat.choose 0 j.val = 0 := Nat.choose_eq_zero_of_lt (by omega)
    simp [this]
  · intro h; exact False.elim (h (Finset.mem_univ _))

/-- **Raw (un-rotated) suffix bound for the lifted four-stage word.** -/
theorem lifted_raw_suffix_bound {w : ℕ} (hw : 2 ≤ w)
    (clock : AlgebraicClock w) (b : Fin clock.m)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (h_suffix : HasSuffixBound clock b parentWord)
    (h_len : ∀ τ : ℕ, (Nat.choose (τ + w - 1) (w - 1) : ℚ) ≤ ((parentWord τ).length : ℚ))
    (c_step H0 delta : ℚ) (hdelta : 0 ≤ delta)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (P : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (hPtX : P.transpose * X_gateway clock =
      Q_reset J (M_of_nat M_nat) (B_mat (w + 1)) (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0))
    (hPM : P * M_of_nat M_nat =
      (S_uniform (Nat.le_of_succ_le hw) clock b
        (h_uniform clock b (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0) c_step) delta) *
        N_mat (w + 1) - (AdjoinLeaderEndpointG clock.G b clock.v) * X_gateway clock)
    (eps : ℚ) (heps : 0 < eps) :
    ∃ A : ℚ, 0 ≤ A ∧ ∀ (σ r : ℕ) (hr : r < (rawFourStageWord_M clock parentWord M_nat σ).length),
      (r < (W_early_word_M clock.m w M_nat σ ++ W_late_word_M clock.m w M_nat σ).length →
        dotProduct (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0) (binomBasis (w + 1) σ) ≤
          wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v) P J)
            ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v) J
              (S_uniform (Nat.le_of_succ_le hw) clock b
                (h_uniform clock b (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0) c_step) delta)
              (X_gateway clock) (M_of_nat M_nat)
              (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0)).mulVec (binomBasis (w + 1) σ))
            ((rawFourStageWord_M clock parentWord M_nat σ).take r)
            ((rawFourStageWord_M clock parentWord M_nat σ)[r])) →
      ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v) J
          (S_uniform (Nat.le_of_succ_le hw) clock b
            (h_uniform clock b (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0) c_step) delta)
          (X_gateway clock) (M_of_nat M_nat)
          (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0)).mulVec (binomBasis (w + 1) (σ + 1)))
          (Sum.inl (gatewayOldAct clock.m)) -
        wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v) P J)
          ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v) J
            (S_uniform (Nat.le_of_succ_le hw) clock b
              (h_uniform clock b (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0) c_step) delta)
            (X_gateway clock) (M_of_nat M_nat)
            (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0)).mulVec (binomBasis (w + 1) σ))
          ((rawFourStageWord_M clock parentWord M_nat σ).take r)
          ((rawFourStageWord_M clock parentWord M_nat σ)[r]) ≤
        eps * (((rawFourStageWord_M clock parentWord M_nat σ).drop r).length : ℚ) + A := by
  have hw1 : 1 ≤ w := Nat.le_of_succ_le hw
  obtain ⟨Cb, hCb, hCb_bound⟩ :=
    bundle_active_score_lb_of_hasSuffixBound hw clock b parentWord hparent_count h_suffix h_len eps heps
  obtain ⟨B, hB, hB_bound⟩ := subphase_leader_diff_le_eps_length_add_const hw clock b parentWord h_len eps heps
  refine ⟨B + Cb + delta, by linarith, ?_⟩
  intro σ r hr h12
  set zeta := zeta_canonical hw1 clock b c_step H0 with hzeta
  set h := h_uniform clock b zeta c_step with hh
  set S := S_uniform hw1 clock b h delta with hS
  set G_O := AdjoinLeaderEndpointG clock.G b clock.v with hG_O
  set Rl := liftedScoreMat G_O J S (X_gateway clock) (M_of_nat M_nat) zeta with hRl
  set W12 := W_early_word_M clock.m w M_nat σ ++ W_late_word_M clock.m w M_nat σ with hW12
  set W_O := (W_bundle_word parentWord (σ + 1)).map (parentToOldAct clock.m) with hW_O
  set W3 := (W_bundle_word parentWord (σ + 1)).map (bundleToLiftedAct clock.m w) with hW3
  set g := gatewayToLiftedAct clock.m w with hg
  have hW : rawFourStageWord_M clock parentWord M_nat σ = (W12 ++ W3) ++ [g] := rfl
  have hW3_eq : W3 = W_O.map Sum.inl := map_bundleToLiftedAct_eq_map_inl clock.m w _
  have hlenW3 : W3.length = W_O.length := by rw [hW3_eq, List.length_map]
  have hlenWO : W_O.length = (W_bundle_word parentWord (σ + 1)).length := by rw [hW_O, List.length_map]
  -- gateway score at phase σ + 1
  have h_gw_eval : (Rl.mulVec (binomBasis (w + 1) (σ + 1))) (Sum.inl (gatewayOldAct clock.m)) =
      dotProduct zeta (binomBasis (w + 1) (σ + 1)) - c_step + delta :=
    liftedScoreMat_S_uniform_inl_gateway_eval hw1 clock b c_step H0 delta J (M_of_nat M_nat) (σ + 1)
  rw [h_gw_eval]
  have hlenW : (rawFourStageWord_M clock parentWord M_nat σ).length = W12.length + W3.length + 1 := by
    rw [hW]; simp only [List.length_append, List.length_singleton]
  have hdrop_len : ((rawFourStageWord_M clock parentWord M_nat σ).drop r).length =
      W12.length + W3.length + 1 - r := by
    rw [List.length_drop, hlenW]
  by_cases hr12 : r < W12.length
  · -- Stages 1 & 2
    have hact := h12 hr12
    have hdiff := zeta_canonical_diff_succ hw1 clock b c_step H0 σ
    have hsub := hB_bound 0 σ (by omega)
    rw [R_mulVec_binomBasis_zero_apply hw1] at hsub
    have hsum : (∑ τ ∈ Finset.Ico 0 (σ + 1), ((parentWord τ).length : ℚ)) =
        ((W_bundle_word parentWord (σ + 1)).length : ℚ) := by
      rw [W_bundle_word_length_eq_sum, Finset.range_eq_Ico]
    rw [hsum] at hsub
    have hlen_le : ((W_bundle_word parentWord (σ + 1)).length : ℚ) ≤
        (((rawFourStageWord_M clock parentWord M_nat σ).drop r).length : ℚ) := by
      have : (W_bundle_word parentWord (σ + 1)).length ≤
          ((rawFourStageWord_M clock parentWord M_nat σ).drop r).length := by
        rw [hdrop_len]; omega
      exact_mod_cast this
    have hmul : eps * ((W_bundle_word parentWord (σ + 1)).length : ℚ) ≤
        eps * (((rawFourStageWord_M clock parentWord M_nat σ).drop r).length : ℚ) :=
      mul_le_mul_of_nonneg_left hlen_le (le_of_lt heps)
    linarith
  · by_cases hr3 : r < W12.length + W3.length
    · -- Stage 3 (parent bundle)
      set k := r - W12.length with hk_def
      have hk : k < W_O.length := by omega
      have hr' : r < (W12 ++ W3).length := by rw [List.length_append]; omega
      have htake : (rawFourStageWord_M clock parentWord M_nat σ).take r = W12 ++ W3.take k := by
        rw [hW, List.take_append_of_le_length (le_of_lt hr'), List.take_append,
          List.take_of_length_le (by omega)]
      have hget : (rawFourStageWord_M clock parentWord M_nat σ)[r] = Sum.inl (W_O[k]) := by
        have h1 : (rawFourStageWord_M clock parentWord M_nat σ)[r] = (W12 ++ W3)[r]'hr' := by
          simp only [hW]
          exact List.getElem_append_left hr'
        rw [h1, List.getElem_append_right (by omega)]
        simp only [hW3_eq, List.getElem_map, hk_def]
      rw [htake, hget, wordScore_append]
      have htake3 : W3.take k = (W_O.take k).map Sum.inl := by rw [hW3_eq, List.map_take]
      rw [htake3]
      have hmapold := wordScore_map_inl_old G_O P J
        (wordScore (liftedGameMat G_O P J) (Rl.mulVec (binomBasis (w + 1) σ)) W12) (W_O.take k) (W_O[k])
      have hmid : (fun u => wordScore (liftedGameMat G_O P J) (Rl.mulVec (binomBasis (w + 1) σ)) W12 (Sum.inl u)) =
          S.mulVec (binomBasis (w + 1) (σ + 1)) := by
        funext u
        exact wordScore_after_reset_stages_M_inl clock G_O P J S M_nat zeta hPM σ u
      rw [hmid] at hmapold
      rw [show wordScore (liftedGameMat G_O P J)
        (wordScore (liftedGameMat G_O P J) (Rl.mulVec (binomBasis (w + 1) σ)) W12)
        ((W_O.take k).map Sum.inl) (Sum.inl (W_O[k])) =
          wordScore (Matrix.fromBlocks G_O P (-P.transpose) (J - J.transpose))
        (wordScore (liftedGameMat G_O P J) (Rl.mulVec (binomBasis (w + 1) σ)) W12)
        ((W_O.take k).map Sum.inl) (Sum.inl (W_O[k])) from rfl, hmapold]
      have hlb := hCb_bound c_step H0 delta σ k hk
      have hdropk : ((rawFourStageWord_M clock parentWord M_nat σ).drop r).length =
          (W_O.drop k).length + 1 := by
        rw [hdrop_len, List.length_drop]; omega
      rw [hdropk]
      push_cast
      linarith
    · -- Stage 4 (gateway)
      have hr_eq : r = W12.length + W3.length := by omega
      have htake : (rawFourStageWord_M clock parentWord M_nat σ).take r = W12 ++ W3 := by
        rw [hW, hr_eq, List.take_append_of_le_length (by simp), List.take_of_length_le (by simp)]
      have hget : (rawFourStageWord_M clock parentWord M_nat σ)[r] = g := by
        simp only [hW]
        rw [List.getElem_append_right (by simp; omega)]
        simp
      rw [htake, hget]
      have hend := s_end_gw_M hw1 clock b c_step H0 delta parentWord hparent_count M_nat P J hPtX hPM σ
      dsimp only at hend
      rw [hend]
      have hh_dot := dotProduct_h_uniform_binomBasis clock b zeta c_step (σ + 1)
      have hnn : 0 ≤ eps * (((rawFourStageWord_M clock parentWord M_nat σ).drop r).length : ℚ) := by
        positivity
      linarith

section StepSuffix

variable {w : ℕ} (grc : GroundedRealizedClock w)

/-- Shorthand data for the lifted objects of a grounded realized clock. -/
noncomputable abbrev grcJ : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ :=
  J_lower_eta w (fun c => 2 * (grc.u c : ℚ))
    (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta

noncomputable abbrev grcP : Matrix (Fin (grc.rc.fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  P_uniform_M grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta (M_lower_nat w grc.u)
    (R_M_lower w (fun c => 2 * (grc.u c : ℚ))) (grcJ grc)
    (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0) grc.P0 grc.rc.fc.L_C

noncomputable abbrev grcRl : Matrix (Fin (grc.rc.fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ :=
  liftedScoreMat (AdjoinLeaderEndpointG grc.rc.fc.clock.G grc.b grc.rc.fc.clock.v) (grcJ grc)
    (S_uniform (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b
      (h_uniform grc.rc.fc.clock grc.b
        (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0) grc.c_step) grc.delta)
    (X_gateway grc.rc.fc.clock) (M_of_nat (M_lower_nat w grc.u))
    (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0)

noncomputable abbrev grcGl : Matrix (Fin (grc.rc.fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)))
    (Fin (grc.rc.fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1))) ℚ :=
  liftedGameMat (AdjoinLeaderEndpointG grc.rc.fc.clock.G grc.b grc.rc.fc.clock.v) (grcP grc) (grcJ grc)

theorem grc_hPM :
    grcP grc * M_of_nat (M_lower_nat w grc.u) =
      (S_uniform (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b
        (h_uniform grc.rc.fc.clock grc.b
          (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0) grc.c_step)
        grc.delta) * N_mat (w + 1) -
      (AdjoinLeaderEndpointG grc.rc.fc.clock.G grc.b grc.rc.fc.clock.v) * X_gateway grc.rc.fc.clock :=
  P_uniform_M_mul_M grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta (M_lower_nat w grc.u)
    (R_M_lower w (fun c => 2 * (grc.u c : ℚ))) (grcJ grc)
    (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha)
    (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0) grc.P0 grc.rc.fc.L_C
    (R_M_lower_mul_M_lower_nat w grc.u grc.hu0 grc.hui)
    (M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w grc.u _ grc.eta grc.hu0 grc.hui)
    (E_uniform_total_moment_equation_M_lower_nat grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta
      grc.alpha grc.u (by have := grc.hu0; omega) grc.hell (by rw [grc.hb_subdiag]; norm_num))

theorem grc_hPtX :
    (grcP grc).transpose * X_gateway grc.rc.fc.clock =
      Q_reset (grcJ grc) (M_of_nat (M_lower_nat w grc.u)) (B_mat (w + 1))
        (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0) :=
  P_uniform_M_transpose_mul_X grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta (M_lower_nat w grc.u)
    (R_M_lower w (fun c => 2 * (grc.u c : ℚ))) (grcJ grc)
    (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0) grc.P0 grc.rc.fc.L_C
    grc.rc.fc.hLC

theorem step_clock_R_apply (a : Fin grc.step_rc.fc.clock.m) (j : Fin (w + 1)) :
    grc.step_rc.fc.clock.R a j =
      grcRl grc ((rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm a) j := by
  change (uniformFullRankLift_M grc.hw grc.rc.fc grc.b grc.c_step grc.H0 grc.delta
    (M_lower_nat w grc.u) (R_M_lower w (fun c => 2 * (grc.u c : ℚ))) (grcJ grc)
    (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha)
    (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0) grc.P0
    (R_M_lower_mul_M_lower_nat w grc.u grc.hu0 grc.hui)
    (M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w grc.u _ grc.eta grc.hu0 grc.hui)
    (E_uniform_total_moment_equation_M_lower_nat grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta
      grc.alpha grc.u (by have := grc.hu0; omega) grc.hell (by rw [grc.hb_subdiag]; norm_num))).clock.R a j = _
  dsimp [uniformFullRankLift_M, AlgebraicClock.ofEquiv]

theorem step_clock_G_apply (a a' : Fin grc.step_rc.fc.clock.m) :
    grc.step_rc.fc.clock.G a a' =
      grcGl grc ((rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm a)
        ((rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm a') := by
  change (uniformFullRankLift_M grc.hw grc.rc.fc grc.b grc.c_step grc.H0 grc.delta
    (M_lower_nat w grc.u) (R_M_lower w (fun c => 2 * (grc.u c : ℚ))) (grcJ grc)
    (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha)
    (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0) grc.P0
    (R_M_lower_mul_M_lower_nat w grc.u grc.hu0 grc.hui)
    (M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w grc.u _ grc.eta grc.hu0 grc.hui)
    (E_uniform_total_moment_equation_M_lower_nat grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta
      grc.alpha grc.u (by have := grc.hu0; omega) grc.hell (by rw [grc.hb_subdiag]; norm_num))).clock.G a a' = _
  dsimp [uniformFullRankLift_M, AlgebraicClock.ofEquiv]

theorem step_clock_G_eq :
    grc.step_rc.fc.clock.G = Matrix.of fun a a' =>
      grcGl grc ((rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm a)
        ((rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm a') := by
  ext a a'
  rw [step_clock_G_apply, Matrix.of_apply]

theorem step_clock_R_mulVec (v : Fin (w + 1) → ℚ) :
    grc.step_rc.fc.clock.R.mulVec v = fun a =>
      (grcRl grc).mulVec v ((rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm a) := by
  funext a
  simp only [Matrix.mulVec, dotProduct, step_clock_R_apply]

/-- Rotated phase score transfer: the step clock's word score along `step_parentWord`
    equals the raw lifted word score along `rawFourStageWord_M`. -/
theorem step_wordScore_parentWord (σ r : ℕ) (hr : r < (step_parentWord grc σ).length)
    (hr' : r < (rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) σ).length) :
    wordScore grc.step_rc.fc.clock.G (grc.step_rc.fc.clock.R.mulVec (binomBasis (w + 1) σ))
        ((step_parentWord grc σ).take r) ((step_parentWord grc σ)[r]) =
      wordScore (grcGl grc) ((grcRl grc).mulVec (binomBasis (w + 1) σ))
        ((rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) σ).take r)
        ((rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) σ)[r]) := by
  set rot := rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1)) with hrot
  have hget : (step_parentWord grc σ)[r] =
      rot ((rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) σ)[r]) := by
    simp [step_parentWord, hrot]
  have htake : (step_parentWord grc σ).take r =
      ((rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) σ).take r).map rot := by
    simp [step_parentWord, hrot, List.map_take]
  rw [hget, htake, step_clock_G_eq, step_clock_R_mulVec]
  rw [wordScore_map_equiv rot (grcGl grc) ((grcRl grc).mulVec (binomBasis (w + 1) σ))]
  rw [Equiv.symm_apply_apply]

theorem grcRl_inr_zero_mulVec (σ : ℕ) :
    (grcRl grc).mulVec (binomBasis (w + 1) σ) (Sum.inr ⟨0, by omega⟩) =
      dotProduct (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0)
        (binomBasis (w + 1) σ) := by
  simp only [grcRl, liftedScoreMat, Matrix.mulVec, dotProduct, Matrix.of_apply, Matrix.sub_apply,
    one_zeta]
  have hJM : ∀ c : Fin (w + 1), (grcJ grc * M_of_nat (M_lower_nat w grc.u)) ⟨0, by omega⟩ c = 0 := by
    intro c
    rw [Matrix.mul_apply]
    refine Finset.sum_eq_zero fun a _ => ?_
    rw [grcJ, J_lower_eta_lower w _ _ grc.eta ⟨0, by omega⟩ a (by simp), zero_mul]
  simp only [hJM, sub_zero]

/-- **Inductive preservation of `HasSuffixBound` across the grounded lift.** -/
theorem hasSuffixBound_rawFourStageWord_M
    (h_suffix : HasSuffixBound grc.rc.fc.clock grc.b grc.parentWord)
    (h_len : ∀ τ : ℕ, (Nat.choose (τ + w - 1) (w - 1) : ℚ) ≤ ((grc.parentWord τ).length : ℚ)) :
    HasSuffixBound grc.step_rc.fc.clock (step_b grc) (step_parentWord grc) := by
  intro eps heps
  obtain ⟨A, hA, hbound⟩ := lifted_raw_suffix_bound grc.hw grc.rc.fc.clock grc.b grc.parentWord
    grc.hparent_count h_suffix h_len grc.c_step grc.H0 grc.delta (le_of_lt grc.hdelta)
    (M_lower_nat w grc.u) (grcP grc) (grcJ grc) (grc_hPtX grc) (grc_hPM grc) eps heps
  set R' := grc.step_rc.fc.clock.R with hR'
  set G' := grc.step_rc.fc.clock.G with hG'
  let f : ℕ → ℕ → ℚ := fun σ r =>
    if hr : r < (step_parentWord grc σ).length then
      max 0 ((R'.mulVec (binomBasis (w + 1) (σ + 1))) (step_b grc) -
        wordScore G' (R'.mulVec (binomBasis (w + 1) σ)) ((step_parentWord grc σ).take r)
          ((step_parentWord grc σ)[r]))
    else 0
  have hf_nonneg : ∀ σ r, 0 ≤ f σ r := by
    intro σ r
    simp only [f]
    split_ifs
    · exact le_max_left _ _
    · exact le_rfl
  let A0 : ℚ := ∑ σ ∈ Finset.range grc.phaseShift,
    ∑ r ∈ Finset.range (step_parentWord grc σ).length, f σ r
  have hA0 : 0 ≤ A0 := Finset.sum_nonneg fun σ _ => Finset.sum_nonneg fun r _ => hf_nonneg σ r
  refine ⟨A + A0, by linarith, ?_⟩
  intro σ r hr
  have hnn : 0 ≤ eps * (((step_parentWord grc σ).drop r).length : ℚ) := by positivity
  by_cases hσ : σ < grc.phaseShift
  · -- finitely many early phases: absorbed into A0
    have h1 : (R'.mulVec (binomBasis (w + 1) (σ + 1))) (step_b grc) -
        wordScore G' (R'.mulVec (binomBasis (w + 1) σ)) ((step_parentWord grc σ).take r)
          ((step_parentWord grc σ)[r]) ≤ f σ r := by
      simp only [f, dif_pos hr]
      exact le_max_right _ _
    have h2 : f σ r ≤ ∑ r' ∈ Finset.range (step_parentWord grc σ).length, f σ r' :=
      Finset.single_le_sum (fun r' _ => hf_nonneg σ r') (Finset.mem_range.mpr hr)
    have h3 : (∑ r' ∈ Finset.range (step_parentWord grc σ).length, f σ r') ≤ A0 :=
      Finset.single_le_sum (f := fun σ' => ∑ r' ∈ Finset.range (step_parentWord grc σ').length, f σ' r')
        (fun σ' _ => Finset.sum_nonneg fun r' _ => hf_nonneg σ' r') (Finset.mem_range.mpr hσ)
    linarith
  · obtain ⟨p, rfl⟩ : ∃ p, σ = p + grc.phaseShift := ⟨σ - grc.phaseShift, by omega⟩
    have hr' : r < (rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u)
        (p + grc.phaseShift)).length := by
      simpa [step_parentWord] using hr
    rw [step_wordScore_parentWord grc _ r hr hr']
    have hb' : (R'.mulVec (binomBasis (w + 1) (p + grc.phaseShift + 1))) (step_b grc) =
        ((grcRl grc).mulVec (binomBasis (w + 1) (p + grc.phaseShift + 1)))
          (Sum.inl (gatewayOldAct grc.rc.fc.clock.m)) := by
      rw [hR', step_clock_R_mulVec]
      simp only [step_b, Equiv.symm_apply_apply]
    rw [hb']
    have hdrop : (((step_parentWord grc (p + grc.phaseShift)).drop r).length : ℚ) =
        (((rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u)
          (p + grc.phaseShift)).drop r).length : ℚ) := by
      simp [step_parentWord]
    rw [hdrop]
    have h12 : r < (W_early_word_M grc.rc.fc.clock.m w (M_lower_nat w grc.u) (p + grc.phaseShift) ++
          W_late_word_M grc.rc.fc.clock.m w (M_lower_nat w grc.u) (p + grc.phaseShift)).length →
        dotProduct (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0)
            (binomBasis (w + 1) (p + grc.phaseShift)) ≤
          wordScore (grcGl grc) ((grcRl grc).mulVec (binomBasis (w + 1) (p + grc.phaseShift)))
            ((rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u)
              (p + grc.phaseShift)).take r)
            ((rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u)
              (p + grc.phaseShift))[r]) := by
      intro hr12
      set W12 := W_early_word_M grc.rc.fc.clock.m w (M_lower_nat w grc.u) (p + grc.phaseShift) ++
          W_late_word_M grc.rc.fc.clock.m w (M_lower_nat w grc.u) (p + grc.phaseShift) with hW12
      have hvalid : IsValidPriorityWord (grcGl grc)
          ((grcRl grc).mulVec (binomBasis (w + 1) (p + grc.phaseShift)))
          (paperPriorityRank grc.rc.fc.clock.m w grc.parent_rank) W12 := by
        have he := grc.h_early p
        have hl := grc.h_late p
        dsimp only at he hl
        exact (isValidPriorityWord_append_iff _ _ _ _ _).mpr ⟨he, hl⟩
      have hG_diag : ∀ i, grcGl grc i i = 0 := fun i =>
        skew_diag_zero (liftedGameMat_skew _ _ _
          (AdjoinLeaderEndpointG_skew _ _ _ grc.rc.fc.clock.hskew)) i
      have hact := initial_score_le_active_wordScore_of_isValidPriorityWord (grcGl grc) hG_diag _ _ W12
        hvalid r hr12 (Sum.inr ⟨0, by omega⟩)
      rw [grcRl_inr_zero_mulVec] at hact
      have hW : rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) (p + grc.phaseShift) =
          W12 ++ ((W_bundle_word grc.parentWord (p + grc.phaseShift + 1)).map
            (bundleToLiftedAct grc.rc.fc.clock.m w) ++ [gatewayToLiftedAct grc.rc.fc.clock.m w]) := by
        simp only [rawFourStageWord_M, hW12, List.append_assoc]
      have htake : (rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u)
          (p + grc.phaseShift)).take r = W12.take r := by
        rw [hW, List.take_append_of_le_length (le_of_lt hr12)]
      have hget : (rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u)
          (p + grc.phaseShift))[r] = W12[r] := by
        simp only [hW]
        exact List.getElem_append_left hr12
      rw [htake, hget]
      exact hact
    have := hbound (p + grc.phaseShift) r hr' h12
    linarith

end StepSuffix

/-- Transfer of `HasSuffixBound` to another leader whose next-phase score exceeds by at most `K`. -/
theorem HasSuffixBound.of_le_add {w : ℕ} {clock : AlgebraicClock w} {b b' : Fin clock.m}
    {W : ℕ → List (Fin clock.m)} (h : HasSuffixBound clock b W) (K : ℚ)
    (hK : ∀ σ : ℕ, clock.R.mulVec (binomBasis w (σ + 1)) b' ≤ clock.R.mulVec (binomBasis w (σ + 1)) b + K) :
    HasSuffixBound clock b' W := by
  intro eps heps
  obtain ⟨A, hA, hb⟩ := h eps heps
  refine ⟨A + max 0 K, add_nonneg hA (le_max_left _ _), fun σ r hr => ?_⟩
  have h1 := hb σ r hr
  have h2 := hK σ
  have h3 := le_max_right 0 K
  linarith

/-- Generic: a parent row of the lifted score table is dominated by the gateway row. -/
theorem parent_row_le_gw_row {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (h : Fin (w + 1) → ℚ) (delta : ℚ)
    (h_leader_all : ∀ i (j : Fin w), clock.R i j ≤ clock.R b j)
    (h_delta_plus_Gv : ∀ i0 : Fin clock.m, 0 ≤ delta + (clock.G b i0 + clock.v i0))
    (i0 : Fin clock.m) (j : Fin (w + 1)) :
    (S_uniform (Nat.le_of_succ_le hw) clock b h delta +
        AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock) (finSumFinEquiv (Sum.inl i0)) j ≤
      (S_uniform (Nat.le_of_succ_le hw) clock b h delta +
        AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock) (gatewayOldAct clock.m) j := by
  have h_parent := S_add_GO_X_parent_apply (Nat.le_of_succ_le hw) clock b h delta i0 j
  have h_gw := S_add_GO_X_gateway_apply (Nat.le_of_succ_le hw) clock b h delta j
  dsimp only at h_parent h_gw
  rw [h_parent, h_gw]
  by_cases hj0 : j.val = 0
  · simp only [hj0, ↓reduceIte]
    rw [mul_shiftRightCount_zero clock.G clock.C b j hj0, mul_shiftRightCount_zero clock.G clock.C i0 j hj0]
    have h_lead := h_leader_all i0 ⟨0, by omega⟩
    have h_delta := h_delta_plus_Gv i0
    linarith
  · simp only [hj0, ↓reduceIte, add_zero]
    by_cases hjw : j.val < w
    · have h_mul_b := shiftRightCount_R_mul_N_mat (by omega) clock b j
      have h_mul_i0 := shiftRightCount_R_mul_N_mat (by omega) clock i0 j
      rw [if_neg hj0] at h_mul_b h_mul_i0
      rw [← h_mul_b, ← h_mul_i0, mul_N_mat_apply, mul_N_mat_apply]
      have hd_lt : j.val + 1 < w + 1 := by omega
      simp only [hd_lt, ↓reduceDIte]
      have hshift : ∀ a, shiftRightCount clock.R a ⟨j.val + 1, hd_lt⟩ = clock.R a ⟨j.val, hjw⟩ := by
        intro a
        unfold shiftRightCount
        simp only [Matrix.of_apply]
        have hpos : 0 < j.val + 1 := by omega
        simp only [hpos, ↓reduceDIte]
        congr 1
      rw [hshift b, hshift i0]
      have h_lead := h_leader_all i0 ⟨j.val, hjw⟩
      linarith
    · have hj_eq_w : j.val = w := by have := j.isLt; omega
      have heq_j : j = ⟨w, Nat.lt_succ_self w⟩ := by ext; exact hj_eq_w
      rw [heq_j]
      have h_shift : ∀ a, (clock.G * shiftRightCount clock.C) a ⟨w, Nat.lt_succ_self w⟩ = 0 := by
        intro a
        have h_mul := shiftRightCount_R_mul_N_mat (by omega) clock a ⟨w, Nat.lt_succ_self w⟩
        have hw_ne : ¬ (w = 0) := by omega
        rw [if_neg hw_ne] at h_mul
        rw [← h_mul, mul_N_mat_apply]
        have h_col : ¬ (w + 1 < w + 1) := by omega
        simp only [h_col, ↓reduceDIte]
      rw [h_shift b, h_shift i0]

section StepLeaderZero

variable {w : ℕ} (grc : GroundedRealizedClock w)

noncomputable abbrev grcZeta : Fin (w + 1) → ℚ :=
  zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0

/-- The correct next-order leader: the coordinate-0 reset action, whose score row is exactly `zeta`. -/
def step_b0 : Fin grc.step_rc.fc.clock.m :=
  rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1)) (Sum.inr ⟨0, by omega⟩)

theorem grcRl_inr_apply (r : Fin ((w + 1) + (w + 1))) (c : Fin (w + 1)) :
    grcRl grc (Sum.inr r) c = grcZeta grc c - (grcJ grc * M_of_nat (M_lower_nat w grc.u)) r c := by
  simp only [grcRl, liftedScoreMat, Matrix.of_apply, Matrix.sub_apply, one_zeta]

theorem grcRl_inr_zero_apply (c : Fin (w + 1)) :
    grcRl grc (Sum.inr ⟨0, by omega⟩) c = grcZeta grc c := by
  rw [grcRl_inr_apply]
  have : (grcJ grc * M_of_nat (M_lower_nat w grc.u)) ⟨0, by omega⟩ c = 0 := by
    rw [Matrix.mul_apply]
    refine Finset.sum_eq_zero fun a _ => ?_
    rw [grcJ, J_lower_eta_lower w _ _ grc.eta ⟨0, by omega⟩ a (by simp), zero_mul]
  rw [this, sub_zero]

theorem grcRl_gw_apply (c : Fin (w + 1)) :
    grcRl grc (Sum.inl (gatewayOldAct grc.rc.fc.clock.m)) c =
      grcZeta grc c + (if c.val = 0 then grc.delta - grc.c_step else 0) := by
  by_cases hc0 : c.val = 0
  · have h_entry := S_add_GO_X_gateway_apply (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b
      (h_uniform grc.rc.fc.clock grc.b (grcZeta grc) grc.c_step) grc.delta c
    dsimp only at h_entry
    simp only [grcRl, liftedScoreMat, Matrix.of_apply]
    rw [h_entry, mul_shiftRightCount_zero _ _ _ c hc0]
    obtain ⟨cv, hcv⟩ := c
    simp only at hc0
    subst hc0
    have h0w : (0 : ℕ) < w := by have := grc.hw; omega
    simp only [h_uniform, h0w, ↓reduceDIte, ↓reduceIte]
    ring
  · have h1 := step_b_R_pos grc c (by omega)
    rw [step_clock_R_apply] at h1
    simp only [step_b, Equiv.symm_apply_apply] at h1
    rw [h1, if_neg hc0, add_zero]

theorem step_b0_R (j : Fin (w + 1)) :
    grc.step_rc.fc.clock.R (step_b0 grc) j = grcZeta grc j := by
  rw [step_clock_R_apply, step_b0, Equiv.symm_apply_apply, grcRl_inr_zero_apply]

theorem step_b_R_eq_b0 (j : Fin (w + 1)) :
    grc.step_rc.fc.clock.R (step_b grc) j =
      grc.step_rc.fc.clock.R (step_b0 grc) j + (if j.val = 0 then grc.delta - grc.c_step else 0) := by
  rw [step_b0_R, step_clock_R_apply, step_b, Equiv.symm_apply_apply, grcRl_gw_apply]

theorem step_b0_subdiag :
    grc.step_rc.fc.clock.R (step_b0 grc) ⟨w, Nat.lt_succ_self w⟩ = 1 := by
  rw [step_b0_R]
  exact zeta_canonical_top_eq_one grc.hw _ _ _ _ grc.hb_subdiag

theorem step_b0_mulVec (n : ℕ) :
    grc.step_rc.fc.clock.R.mulVec (binomBasis (w + 1) n) (step_b0 grc) =
      grc.step_rc.fc.clock.R.mulVec (binomBasis (w + 1) n) (step_b grc) + (grc.c_step - grc.delta) := by
  simp only [Matrix.mulVec, dotProduct, step_b_R_eq_b0, add_mul, Finset.sum_add_distrib]
  rw [Fin.sum_univ_succ (f := fun j : Fin (w + 1) =>
    (if j.val = 0 then grc.delta - grc.c_step else 0) * binomBasis (w + 1) n j)]
  simp [binomBasis]
  ring

theorem hasSuffixBound_step_b0
    (h_suffix : HasSuffixBound grc.rc.fc.clock grc.b grc.parentWord)
    (h_len : ∀ τ : ℕ, (Nat.choose (τ + w - 1) (w - 1) : ℚ) ≤ ((grc.parentWord τ).length : ℚ)) :
    HasSuffixBound grc.step_rc.fc.clock (step_b0 grc) (step_parentWord grc) :=
  (hasSuffixBound_rawFourStageWord_M grc h_suffix h_len).of_le_add (grc.c_step - grc.delta)
    (fun σ => by rw [step_b0_mulVec])

theorem step_b0_leader_all
    (h_leader_all : ∀ i (j : Fin w), grc.rc.fc.clock.R i j ≤ grc.rc.fc.clock.R grc.b j)
    (h_JM_nonneg : ∀ r c, 0 ≤ (grcJ grc * M_of_nat (M_lower_nat w grc.u)) r c)
    (h_delta_plus_Gv : ∀ i0 : Fin grc.rc.fc.clock.m,
      0 ≤ grc.delta + (grc.rc.fc.clock.G grc.b i0 + grc.rc.fc.clock.v i0))
    (h_delta_le : grc.delta ≤ grc.c_step)
    (i : Fin grc.step_rc.fc.clock.m) (j : Fin (w + 1)) :
    grc.step_rc.fc.clock.R i j ≤ grc.step_rc.fc.clock.R (step_b0 grc) j := by
  rw [step_clock_R_apply, step_b0_R]
  have hgw_le : grcRl grc (Sum.inl (gatewayOldAct grc.rc.fc.clock.m)) j ≤ grcZeta grc j := by
    rw [grcRl_gw_apply]
    split_ifs <;> linarith
  generalize (rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm i = x
  rcases x with y | r
  · rcases hy : finSumFinEquiv.symm y with i0 | z
    · have hy_eq : y = finSumFinEquiv (Sum.inl i0) := by rw [← hy, Equiv.apply_symm_apply]
      subst hy_eq
      refine le_trans ?_ hgw_le
      exact parent_row_le_gw_row grc.hw grc.rc.fc.clock grc.b _ grc.delta h_leader_all h_delta_plus_Gv i0 j
    · have hy_eq : y = gatewayOldAct grc.rc.fc.clock.m := by
        rw [← Equiv.apply_symm_apply finSumFinEquiv y, hy, Subsingleton.elim z 0]
        rfl
      subst hy_eq
      exact hgw_le
  · rw [grcRl_inr_apply]
    linarith [h_JM_nonneg r j]

/-- Hockey-stick lower bound on the next-order parent word lengths. -/
theorem sum_choose_le_of_len {m w : ℕ} (hw : 1 ≤ w) (parentWord : ℕ → List (Fin m))
    (h_len : ∀ τ : ℕ, (Nat.choose (τ + w - 1) (w - 1) : ℚ) ≤ ((parentWord τ).length : ℚ)) (q : ℕ) :
    (Nat.choose (q + w) w : ℚ) ≤ ∑ τ ∈ Finset.range (q + 1), ((parentWord τ).length : ℚ) := by
  induction q with
  | zero =>
    have := h_len 0
    simp only [zero_add, Nat.choose_self, Nat.cast_one, Finset.sum_range_one] at this ⊢
    simpa [Nat.choose_self] using this
  | succ q ih =>
    rw [Finset.sum_range_succ]
    obtain ⟨k, rfl⟩ : ∃ k, w = k + 1 := ⟨w - 1, by omega⟩
    have hpascal : Nat.choose (q + 1 + (k + 1)) (k + 1) =
        Nat.choose (q + 1 + k) k + Nat.choose (q + (k + 1)) (k + 1) := by
      rw [show q + 1 + (k + 1) = (q + (k + 1)) + 1 by omega, Nat.choose_succ_succ,
        show q + (k + 1) = q + 1 + k by omega]
    have := h_len (q + 1)
    rw [show q + 1 + (k + 1) - 1 = q + 1 + k by omega, show k + 1 - 1 = k by omega] at this
    rw [hpascal]
    push_cast
    linarith

theorem step_parentWord_length_ge
    (h_len : ∀ τ : ℕ, (Nat.choose (τ + w - 1) (w - 1) : ℚ) ≤ ((grc.parentWord τ).length : ℚ)) (q : ℕ) :
    (Nat.choose (q + (w + 1) - 1) ((w + 1) - 1) : ℚ) ≤ ((step_parentWord grc q).length : ℚ) := by
  have e1 : q + (w + 1) - 1 = q + w := by omega
  have e2 : (w + 1) - 1 = w := by omega
  rw [e1, e2]
  refine le_trans (sum_choose_le_of_len (by have := grc.hw; omega) grc.parentWord h_len q) ?_
  rw [← W_bundle_word_length_eq_sum]
  simp only [step_parentWord, rawFourStageWord_M, List.length_map, List.length_append,
    List.length_singleton]
  push_cast
  have h1 : (0 : ℚ) ≤ ((W_early_word_M grc.rc.fc.clock.m w (M_lower_nat w grc.u) q).length : ℚ) := by positivity
  have h2 : (0 : ℚ) ≤ ((W_late_word_M grc.rc.fc.clock.m w (M_lower_nat w grc.u) q).length : ℚ) := by positivity
  linarith

end StepLeaderZero



/-- Stage 2 sharpened end condition for any `delta < 1`, valid at every phase `q` (including `q = 0`). -/
theorem stage2_end_sharp_lt_one {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ) (hdelta : delta < 1) (q : ℕ)
    (P_reset : Fin (clock.m + 1) → ℚ)
    (h_lead0 : ∀ i : Fin clock.m, clock.R i ⟨0, by omega⟩ ≤ clock.R b ⟨0, by omega⟩)
    (hP_pos_parent : ∀ i : Fin clock.m, 0 < P_reset (finSumFinEquiv (Sum.inl i)))
    (hP_nonneg_gw : 0 ≤ P_reset (finSumFinEquiv (Sum.inr 0)))
    (x : Fin (clock.m + 1)) :
    (S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step)
        delta).mulVec (binomBasis (w + 1) (q + 1)) x - P_reset x <
      dotProduct (zeta_canonical (by omega) clock b c_step H0) (binomBasis (w + 1) q) := by
  obtain ⟨sx, rfl⟩ := finSumFinEquiv.surjective x
  cases sx with
  | inl i =>
    have h_const : clock.R i ⟨0, by omega⟩ - clock.R b ⟨0, by omega⟩ <
        P_reset (finSumFinEquiv (Sum.inl i)) := by
      have := h_lead0 i
      have := hP_pos_parent i
      linarith
    exact stage2_parent_end_sharp_canonical (by omega) clock b c_step H0 delta i q _ h_const
  | inr j =>
    have hj0 : j = 0 := Subsingleton.elim j 0
    subst hj0
    rw [S_uniform_gateway_eval (by omega) clock b _ delta q,
      h_uniform_zeta_canonical_eval (by omega) clock b c_step H0 q]
    have hq : (1 : ℚ) ≤ ((q + 1 : ℕ) : ℚ) := by exact_mod_cast (by omega : 1 ≤ q + 1)
    linarith

lemma J_lower_eta_transpose_inr_nonneg (w : ℕ) (ell : Fin (w + 1) → ℚ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (eta : ℚ) (heta : 0 ≤ eta) (j : Fin (w + 1)) (a : Fin ((w + 1) + (w + 1))) :
    0 ≤ (J_lower_eta w ell E eta).transpose (finSumFinEquiv (Sum.inr j)) a := by
  obtain ⟨sa, rfl⟩ := finSumFinEquiv.surjective a
  dsimp [Matrix.transpose, J_lower_eta]
  have hj : (finSumFinEquiv (Sum.inr j) : Fin ((w + 1) + (w + 1))) = Fin.natAdd (w + 1) j := rfl
  have hj_symm : finSumFinEquiv.symm (Fin.natAdd (w + 1) j) = Sum.inr j := by
    rw [← hj, finSumFinEquiv.symm_apply_apply]
  rw [finSumFinEquiv.symm_apply_apply, hj_symm]
  cases sa with
  | inl i =>
    linarith
  | inr i =>
    dsimp [L_strict]
    split_ifs <;> nlinarith

lemma J_lower_eta_inl_nonneg (w : ℕ) (ell : Fin (w + 1) → ℚ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (eta : ℚ) (heta : 0 ≤ eta) (j : Fin (w + 1)) (b : Fin ((w + 1) + (w + 1))) :
    0 ≤ (J_lower_eta w ell E eta) (finSumFinEquiv (Sum.inl j)) b := by
  obtain ⟨sb, rfl⟩ := finSumFinEquiv.surjective b
  dsimp [J_lower_eta]
  have hj : (finSumFinEquiv (Sum.inl j) : Fin ((w + 1) + (w + 1))) = Fin.castAdd (w + 1) j := rfl
  have hj_symm : finSumFinEquiv.symm (Fin.castAdd (w + 1) j) = Sum.inl j := by
    rw [← hj, finSumFinEquiv.symm_apply_apply]
  rw [finSumFinEquiv.symm_apply_apply, hj_symm]
  cases sb with
  | inl i =>
    dsimp [L_strict]
    split_ifs <;> nlinarith
  | inr i =>
    linarith

theorem leader_score_succ_ge_zero {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (hR_nonneg : ∀ c : Fin w, 0 ≤ clock.R b c) (q : ℕ) :
    clock.R b ⟨0, hw⟩ ≤ clock.R.mulVec (binomBasis w (q + 1)) b := by
  dsimp [Matrix.mulVec, dotProduct]
  have h_mem : ⟨0, hw⟩ ∈ (Finset.univ : Finset (Fin w)) := Finset.mem_univ _
  rw [← Finset.add_sum_erase _ _ h_mem]
  have h0 : binomBasis w (q + 1) ⟨0, hw⟩ = 1 := by
    unfold binomBasis
    simp
  rw [h0, mul_one]
  have hsum_nonneg : 0 ≤ ∑ x ∈ Finset.univ.erase ⟨0, hw⟩, clock.R b x * binomBasis w (q + 1) x := by
    refine Finset.sum_nonneg fun c _ => ?_
    have h1 := hR_nonneg c
    have h2 : 0 ≤ binomBasis w (q + 1) c := by unfold binomBasis; positivity
    exact mul_nonneg h1 h2
  linarith

theorem hb_score_of_canonical {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (hR_nonneg : ∀ c : Fin w, 0 ≤ clock.R b c)
    (c_step H0 delta : ℚ) (q : ℕ) :
    let zeta := zeta_canonical hw clock b c_step H0
    let h := h_uniform clock b zeta c_step
    let S := S_uniform hw clock b h delta
    dotProduct zeta (binomBasis (w + 1) q) ≤
      S.mulVec (binomBasis (w + 1) (q + 1)) (finSumFinEquiv (Sum.inl b)) := by
  intro zeta h S
  rw [S_uniform_parent_eval hw clock b h delta b q]
  have h_h_dot := dotProduct_h_uniform_binomBasis clock b zeta c_step (q + 1)
  have h_diff := zeta_canonical_diff_succ hw clock b c_step H0 q
  have h_lead := leader_score_succ_ge_zero hw clock b hR_nonneg q
  change dotProduct zeta (binomBasis (w + 1) q) ≤ clock.R b ⟨0, hw⟩ + dotProduct h (binomBasis (w + 1) (q + 1))
  rw [h_h_dot]
  linarith [h_diff, h_lead]

theorem late_reset_take_score_le_zeta {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (u : Fin (w + 1) → ℕ)
    (alpha eta : ℚ) (heta : 0 ≤ eta)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (parentWord : ℕ → List (Fin clock.m))
    (j : Fin (w + 1))
    (hP_late : ∀ u_old : Fin (clock.m + 1),
      0 ≤ (P_uniform_M hw clock b c_step H0 delta (M_lower_nat w u) (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw clock b c_step H0 delta alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0) P0 L_C) u_old (finSumFinEquiv (Sum.inr j)))
    (q k : ℕ) :
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw clock b c_step H0 delta alpha) eta
    let P := P_uniform_M hw clock b c_step H0 delta (M_lower_nat w u) (R_M_lower w (fun c => 2 * (u c : ℚ))) J (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0) P0 L_C
    let S := S_uniform (Nat.le_of_succ_le hw) clock b (h_uniform clock b (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0) c_step) delta
    let X := X_gateway clock
    let zeta := zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0
    let M_nat := M_lower_nat w u
    let s0 := (liftedScoreMat G_O J S X (M_of_nat M_nat) zeta).mulVec (binomBasis (w + 1) q)
    let s_mid := wordScore (liftedGameMat G_O P J) s0 (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q)
    let W_O := (W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)
    let r := finSumFinEquiv (Sum.inr j)
    s_mid (Sum.inr r) - ∑ u_act, P u_act r * wordCountVec (W_O.take k) u_act ≤
      dotProduct zeta (binomBasis (w + 1) q) := by
  intro G_O J P S X zeta M_nat s0 s_mid W_O r
  have htake_map : ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)).take k =
      (W_O.take k).map Sum.inl := by
    rw [map_bundleToLiftedAct_eq_map_inl, List.map_take]
  have hscore_eq : s_mid (Sum.inr r) - ∑ u_act, P u_act r * wordCountVec (W_O.take k) u_act =
      wordScore (liftedGameMat G_O P J) s_mid
        (((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)).take k) (Sum.inr r) := by
    rw [htake_map]
    have hnew := wordScore_map_inl_new G_O P J s_mid (W_O.take k) r
    change wordScore (liftedGameMat G_O P J) s_mid ((W_O.take k).map Sum.inl) (Sum.inr r) = _ at hnew
    exact hnew.symm
  rw [hscore_eq]
  have hle := wordScore_stage3_take_late_inr_M_le_start clock parentWord G_O P J S M_nat zeta j hP_late q k
  have hV_le : ((one_zeta (Fin ((w + 1) + (w + 1))) zeta - J.transpose * (M_of_nat M_nat)).mulVec (binomBasis (w + 1) q)) r ≤
      dotProduct zeta (binomBasis (w + 1) q) := by
    dsimp [Matrix.mulVec, dotProduct]
    simp only [sub_mul, Finset.sum_sub_distrib]
    have hone : (∑ c : Fin (w + 1), one_zeta (Fin ((w + 1) + (w + 1))) zeta r c * binomBasis (w + 1) q c) =
        ∑ c : Fin (w + 1), zeta c * binomBasis (w + 1) q c := by
      refine Finset.sum_congr rfl fun c _ => ?_
      dsimp [one_zeta]
    rw [hone]
    have hJM_nonneg : 0 ≤ ∑ c : Fin (w + 1), (J.transpose * (M_of_nat M_nat)) r c * binomBasis (w + 1) q c := by
      refine Finset.sum_nonneg fun c _ => ?_
      have h1 : 0 ≤ (J.transpose * (M_of_nat M_nat)) r c := by
        rw [Matrix.mul_apply]
        refine Finset.sum_nonneg fun a _ => ?_
        have hj := J_lower_eta_transpose_inr_nonneg w (fun c => 2 * (u c : ℚ))
          (E_uniform_total hw clock b c_step H0 delta alpha) eta heta j a
        have hm : 0 ≤ (M_of_nat M_nat) a c := by
          dsimp [M_of_nat]
          exact Nat.cast_nonneg _
        exact mul_nonneg hj hm
      have h2 : 0 ≤ binomBasis (w + 1) q c := by unfold binomBasis; positivity
      exact mul_nonneg h1 h2
    linarith
  exact le_trans hle hV_le

theorem early_reset_take_score_le_end {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (G_O : Matrix (Fin (clock.m + 1)) (Fin (clock.m + 1)) ℚ)
    (P : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (S : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (zeta : Fin (w + 1) → ℚ)
    (hPtX : P.transpose * X_gateway clock = Q_reset J (M_of_nat M_nat) (B_mat (w + 1)) zeta)
    (j : Fin (w + 1))
    (hP_early : ∀ u : Fin (clock.m + 1), P u (finSumFinEquiv (Sum.inl j)) ≤ 0)
    (q k : ℕ) :
    let s0 := (liftedScoreMat G_O J S (X_gateway clock) (M_of_nat M_nat) zeta).mulVec (binomBasis (w + 1) q)
    let W_stage3 := (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)
    let r := finSumFinEquiv (Sum.inl j)
    wordScore (liftedGameMat G_O P J)
      (wordScore (liftedGameMat G_O P J) s0 (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q))
      (W_stage3.take k) (Sum.inr r) ≤
    dotProduct zeta (binomBasis (w + 1) (q + 1)) -
      ((J * M_of_nat M_nat).mulVec (binomBasis (w + 1) (q + 1))) r +
      P (gatewayOldAct clock.m) r := by
  intro s0 W_stage3 r
  have hend := wordScore_after_stage3_M_inr clock parentWord hparent_count G_O P J S M_nat zeta hPtX q r
  change wordScore (liftedGameMat G_O P J) s0
    ((W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q) ++ W_stage3) (Sum.inr r) = _ at hend
  rw [wordScore_append] at hend
  have hsplit : W_stage3 = W_stage3.take k ++ W_stage3.drop k := (List.take_append_drop k W_stage3).symm
  conv_lhs at hend => rw [hsplit, wordScore_append]
  have hdrop_inr := wordCountVec_drop_bundleToLiftedAct_inr clock.m w (W_bundle_word parentWord (q + 1)) k
  rw [wordScore_liftedGameMat_old_word_inr G_O P J _ _ hdrop_inr r] at hend
  have hsum_nonpos : ∑ u : Fin (clock.m + 1), P u r * wordCountVec (W_stage3.drop k) (Sum.inl u) ≤ 0 := by
    apply Finset.sum_nonpos
    intro u _
    have h1 := hP_early u
    have h2 : 0 ≤ wordCountVec (W_stage3.drop k) (Sum.inl u) := by unfold wordCountVec; positivity
    exact mul_nonpos_of_nonpos_of_nonneg h1 h2
  linarith

theorem generic_stage4_gw_dom {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 : ℚ) (_hc_step : 1 ≤ c_step)
    (u : Fin (w + 1) → ℕ)
    (alpha eta : ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis w σ))
    (h_leader : ∀ q : ℕ, ∀ i : Fin fc.clock.m,
      fc.clock.R.mulVec (binomBasis w (q + 1)) i ≤ fc.clock.R.mulVec (binomBasis w (q + 1)) b)
    (hPtX : (P_uniform_M hw fc.clock b c_step H0 (1 / 2) (M_lower_nat w u) (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0) P0 fc.L_C).transpose * X_gateway fc.clock =
      Q_reset (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) eta)
        (M_of_nat (M_lower_nat w u)) (B_mat (w + 1)) (zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0))
    (hPM : (P_uniform_M hw fc.clock b c_step H0 (1 / 2) (M_lower_nat w u) (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0) P0 fc.L_C) * M_of_nat (M_lower_nat w u) =
      (S_uniform (Nat.le_of_succ_le hw) fc.clock b (h_uniform fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0) c_step) (1 / 2)) * N_mat (w + 1) -
        (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v) * X_gateway fc.clock)
    (q : ℕ)
    (hJM_nonneg : ∀ j : Fin (w + 1),
      0 ≤ ((J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) eta * M_of_nat (M_lower_nat w u)).mulVec (binomBasis (w + 1) (q + 1))) (finSumFinEquiv (Sum.inl j)))
    (hP_early_margin : ∀ j : Fin (w + 1),
      (P_uniform_M hw fc.clock b c_step H0 (1 / 2) (M_lower_nat w u) (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0) P0 fc.L_C)
        (gatewayOldAct fc.clock.m) (finSumFinEquiv (Sum.inl j)) < - c_step + 1 / 2)
    (h_late_mono : ∀ j : Fin (w + 1),
      let G_O := AdjoinLeaderEndpointG fc.clock.G b fc.clock.v
      let P := P_uniform_M hw fc.clock b c_step H0 (1 / 2) (M_lower_nat w u) (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0) P0 fc.L_C
      let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) eta
      let S := S_uniform (Nat.le_of_succ_le hw) fc.clock b (h_uniform fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0) c_step) (1 / 2)
      let X := X_gateway fc.clock
      let M := M_of_nat (M_lower_nat w u)
      let zeta := zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)
      let W_12 := W_early_word_M fc.clock.m w (M_lower_nat w u) q ++ W_late_word_M fc.clock.m w (M_lower_nat w u) q
      let W_123 := W_12 ++ (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct fc.clock.m w)
      wordScore (liftedGameMat G_O P J) s0 W_123 (Sum.inr (finSumFinEquiv (Sum.inr j))) ≤
      wordScore (liftedGameMat G_O P J) s0 W_12 (Sum.inr (finSumFinEquiv (Sum.inr j))))
    (h_late_mid : ∀ j : Fin (w + 1),
      let G_O := AdjoinLeaderEndpointG fc.clock.G b fc.clock.v
      let P := P_uniform_M hw fc.clock b c_step H0 (1 / 2) (M_lower_nat w u) (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0) P0 fc.L_C
      let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) eta
      let S := S_uniform (Nat.le_of_succ_le hw) fc.clock b (h_uniform fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0) c_step) (1 / 2)
      let X := X_gateway fc.clock
      let M := M_of_nat (M_lower_nat w u)
      let zeta := zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)
      let W_12 := W_early_word_M fc.clock.m w (M_lower_nat w u) q ++ W_late_word_M fc.clock.m w (M_lower_nat w u) q
      wordScore (liftedGameMat G_O P J) s0 W_12 (Sum.inr (finSumFinEquiv (Sum.inr j))) ≤
        dotProduct (zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0) (binomBasis (w + 1) q))
    (h_growth : dotProduct (zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0) (binomBasis (w + 1) q) ≤
      dotProduct (zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0) (binomBasis (w + 1) (q + 1)) - c_step) :
    let G_O := AdjoinLeaderEndpointG fc.clock.G b fc.clock.v
    let P := P_uniform_M hw fc.clock b c_step H0 (1 / 2) (M_lower_nat w u) (R_M_lower w (fun c => 2 * (u c : ℚ)))
      (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) eta)
      (zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0) P0 fc.L_C
    let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) eta
    let S := S_uniform (Nat.le_of_succ_le hw) fc.clock b (h_uniform fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0) c_step) (1 / 2)
    let X := X_gateway fc.clock
    let M := M_of_nat (M_lower_nat w u)
    let zeta := zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0
    let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)
    let W_123 := W_early_word_M fc.clock.m w (M_lower_nat w u) q ++ W_late_word_M fc.clock.m w (M_lower_nat w u) q ++
      (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct fc.clock.m w)
    ∀ y : Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
      y ≠ gatewayToLiftedAct fc.clock.m w →
      wordScore (liftedGameMat G_O P J) s0 W_123 y <
      wordScore (liftedGameMat G_O P J) s0 W_123 (gatewayToLiftedAct fc.clock.m w) := by
  intro G_O P J S X M zeta s0 W_123 y hy
  have hw1 : 1 ≤ w := Nat.le_of_succ_le hw
  have hdelta_pos : 0 < (1 / 2 : ℚ) := by norm_num
  have h_parent : ∀ i : Fin fc.clock.m,
      wordScore (liftedGameMat G_O P J) s0 W_123 (Sum.inl (finSumFinEquiv (Sum.inl i))) =
        fc.clock.R.mulVec (binomBasis w (q + 1)) i +
          dotProduct (h_uniform fc.clock b zeta c_step) (binomBasis (w + 1) (q + 1)) :=
    fun i => s_end_parent_M hw1 fc.clock b c_step H0 (1 / 2) parentWord hparent_count
      (M_lower_nat w u) P J hPtX hPM i q
  have h_gw : wordScore (liftedGameMat G_O P J) s0 W_123 (gatewayToLiftedAct fc.clock.m w) =
      fc.clock.R.mulVec (binomBasis w (q + 1)) b +
        dotProduct (h_uniform fc.clock b zeta c_step) (binomBasis (w + 1) (q + 1)) + 1 / 2 :=
    s_end_gw_M hw1 fc.clock b c_step H0 (1 / 2) parentWord hparent_count
      (M_lower_nat w u) P J hPtX hPM q
  have h_early : ∀ j : Fin (w + 1),
      wordScore (liftedGameMat G_O P J) s0 W_123 (Sum.inr (finSumFinEquiv (Sum.inl j))) <
        dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + 1 / 2 := by
    intro j
    let r : Fin ((w + 1) + (w + 1)) := finSumFinEquiv (Sum.inl j : Fin (w + 1) ⊕ Fin (w + 1))
    have hs_eq := wordScore_after_stage3_M_inr fc.clock parentWord hparent_count
      G_O P J S (M_lower_nat w u) zeta hPtX q r
    exact stage4_reset_end_early zeta c_step (1 / 2) q
      (wordScore (liftedGameMat G_O P J) s0 W_123 (Sum.inr r))
      (((J * M_of_nat (M_lower_nat w u)).mulVec (binomBasis (w + 1) (q + 1))) r)
      (P (gatewayOldAct fc.clock.m) r)
      hs_eq (hJM_nonneg j) (hP_early_margin j)
  have h_late : ∀ j : Fin (w + 1),
      wordScore (liftedGameMat G_O P J) s0 W_123 (Sum.inr (finSumFinEquiv (Sum.inr j))) <
        dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + 1 / 2 := by
    intro j
    exact stage4_reset_end_late zeta c_step (1 / 2) hdelta_pos q
      (wordScore (liftedGameMat G_O P J) s0 W_123 (Sum.inr (finSumFinEquiv (Sum.inr j))))
      (wordScore (liftedGameMat G_O P J) s0 (W_early_word_M fc.clock.m w (M_lower_nat w u) q ++ W_late_word_M fc.clock.m w (M_lower_nat w u) q) (Sum.inr (finSumFinEquiv (Sum.inr j))))
      (h_late_mono j) (h_late_mid j) h_growth
  exact stage4_gw_dom_of_reset_blocks hw fc b c_step (1 / 2) hdelta_pos zeta q
    (fun y => wordScore (liftedGameMat G_O P J) s0 W_123 y)
    h_parent (h_leader q) h_gw h_early h_late y hy


theorem R_mulVec_diff_le_col0 {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b i : Fin clock.m)
    (h_leader_all : ∀ i (j : Fin w), clock.R i j ≤ clock.R b j) (q : ℕ) :
    clock.R.mulVec (binomBasis w q) i - clock.R.mulVec (binomBasis w q) b ≤
      clock.R i ⟨0, hw⟩ - clock.R b ⟨0, hw⟩ := by
  simp only [Matrix.mulVec, dotProduct]
  rw [← Finset.sum_sub_distrib]
  have h_mem : (⟨0, hw⟩ : Fin w) ∈ Finset.univ := Finset.mem_univ _
  rw [← Finset.add_sum_erase _ _ h_mem]
  have h0 : binomBasis w q ⟨0, hw⟩ = 1 := by unfold binomBasis; simp
  rw [h0]
  have hrest : ∑ x ∈ Finset.univ.erase ⟨0, hw⟩,
      (clock.R i x * binomBasis w q x - clock.R b x * binomBasis w q x) ≤ 0 := by
    refine Finset.sum_nonpos fun j _ => ?_
    have hb : 0 ≤ binomBasis w q j := by unfold binomBasis; positivity
    have := h_leader_all i j
    nlinarith
  linarith

section GenericLift

variable {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w) (b : Fin fc.clock.m)
  (c_step H0 alpha eta : ℚ) (u : Fin (w + 1) → ℕ)
  (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)

noncomputable abbrev gZeta : Fin (w + 1) → ℚ :=
  zeta_canonical (Nat.le_of_succ_le hw) fc.clock b c_step H0

noncomputable abbrev gJ : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ :=
  J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) eta

noncomputable abbrev gP : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  P_uniform_M hw fc.clock b c_step H0 (1 / 2) (M_lower_nat w u) (R_M_lower w (fun c => 2 * (u c : ℚ)))
    (gJ hw fc b c_step H0 alpha eta u) (gZeta hw fc b c_step H0) P0 fc.L_C

noncomputable abbrev gS : Matrix (Fin (fc.clock.m + 1)) (Fin (w + 1)) ℚ :=
  S_uniform (Nat.le_of_succ_le hw) fc.clock b (h_uniform fc.clock b (gZeta hw fc b c_step H0) c_step) (1 / 2)

noncomputable abbrev gRl : Matrix (Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ :=
  liftedScoreMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
    (gJ hw fc b c_step H0 alpha eta u) (gS hw fc b c_step H0) (X_gateway fc.clock)
    (M_of_nat (M_lower_nat w u)) (gZeta hw fc b c_step H0)

