theorem g_reset_waits (hu0 : w + 1 ≤ u 0) (hui : ∀ i : Fin w, 1 ≤ u i.succ)
    (hell : ell_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha = fun c => 2 * (u c : ℚ))
    (hb_subdiag : fc.clock.R b ⟨w - 1, by omega⟩ = 1)
    (hR_nonneg : ∀ c : Fin w, 0 ≤ fc.clock.R b c) (heta : 0 ≤ eta)
    (parentWord : ℕ → List (Fin fc.clock.m)) (parent_rank : Fin fc.clock.m → Fin fc.clock.m)
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis w σ))
    (hparent_valid : ∀ σ : ℕ,
      IsValidPriorityWord fc.clock.G (fc.clock.R.mulVec (binomBasis w σ)) parent_rank (parentWord σ))
    (a_old : Fin (fc.clock.m + 1) → ℚ) (ha_pos : ∀ x, 0 < a_old x)
    (hP_inr : ∀ (x : Fin (fc.clock.m + 1)) (j : Fin (w + 1)),
      a_old x / 4 ≤ gP hw fc b c_step H0 alpha eta u P0 x (finSumFinEquiv (Sum.inr j)))
    (hP_inl : ∀ (x : Fin (fc.clock.m + 1)) (i : Fin (w + 1)),
      gP hw fc b c_step H0 alpha eta u P0 x (finSumFinEquiv (Sum.inl i)) ≤ -(a_old x / 4))
    (eps C_bundle : ℚ) (heps : ∀ x, eps ≤ a_old x / 4)
    (h_active : ∀ (q k : ℕ) (_hk : k < ((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m)).length),
      dotProduct (gZeta hw fc b c_step H0) (binomBasis (w + 1) (q + 1)) - c_step - C_bundle -
          eps * ((((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m)).drop k).length : ℚ) ≤
        wordScore (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
          ((gS hw fc b c_step H0).mulVec (binomBasis (w + 1) (q + 1)))
          (((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m)).take k)
          (((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m))[k]))
    (h_gw_margin : c_step + C_bundle < a_old (gatewayOldAct fc.clock.m) / 4)
    (q k : ℕ) (hk : k < ((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m)).length)
    (j : Fin ((w + 1) + (w + 1))) :
    wordScore (gGl hw fc b c_step H0 alpha eta u P0)
        ((gRl hw fc b c_step H0 alpha eta u).mulVec (binomBasis (w + 1) q))
        (W_early_word_M fc.clock.m w (M_lower_nat w u) q ++ W_late_word_M fc.clock.m w (M_lower_nat w u) q)
        (Sum.inr j) -
      ∑ u_act, gP hw fc b c_step H0 alpha eta u P0 u_act j *
        wordCountVec (((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m)).take k) u_act ≤
      wordScore (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        (fun u_act => wordScore (gGl hw fc b c_step H0 alpha eta u P0)
          ((gRl hw fc b c_step H0 alpha eta u).mulVec (binomBasis (w + 1) q))
          (W_early_word_M fc.clock.m w (M_lower_nat w u) q ++ W_late_word_M fc.clock.m w (M_lower_nat w u) q)
          (Sum.inl u_act))
        (((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m)).take k)
        (((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m))[k]) := by
  have hw1 : 1 ≤ w := Nat.le_of_succ_le hw
  rw [g_mid_inl hw fc b c_step H0 alpha eta u P0 hu0 hui hell hb_subdiag q]
  set W_O := (W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m) with hW_O
  set G_O := AdjoinLeaderEndpointG fc.clock.G b fc.clock.v with hG_O
  set P := gP hw fc b c_step H0 alpha eta u P0 with hP
  set J := gJ hw fc b c_step H0 alpha eta u with hJ
  set S := gS hw fc b c_step H0 with hS
  set zeta := gZeta hw fc b c_step H0 with hzeta
  set s_mid := wordScore (gGl hw fc b c_step H0 alpha eta u P0)
        ((gRl hw fc b c_step H0 alpha eta u).mulVec (binomBasis (w + 1) q))
        (W_early_word_M fc.clock.m w (M_lower_nat w u) q ++ W_late_word_M fc.clock.m w (M_lower_nat w u) q)
    with hs_mid
  have h_act := g_parent_active hw fc b c_step H0 parentWord parent_rank hparent_count hparent_valid q k hk
  have hb_score := hb_score_of_canonical hw1 fc.clock b hR_nonneg c_step H0 (1 / 2) q
  obtain ⟨sj, rfl⟩ := finSumFinEquiv.surjective j
  cases sj with
  | inr j0 =>
    have hP_late : ∀ u_old : Fin (fc.clock.m + 1), 0 ≤ P u_old (finSumFinEquiv (Sum.inr j0)) := by
      intro u_old
      have h := hP_inr u_old j0
      have hpos := ha_pos u_old
      linarith
    have hlate := late_reset_take_score_le_zeta hw fc.clock b c_step H0 (1 / 2)
      u alpha eta heta P0 fc.L_C parentWord j0 hP_late q k
    exact le_trans hlate (le_trans hb_score h_act)
  | inl j0 =>
    let r : Fin ((w + 1) + (w + 1)) := finSumFinEquiv (Sum.inl j0)
    have hPtX := g_hPtX hw fc b c_step H0 alpha eta u P0
    have hend := wordScore_after_stage3_M_inr fc.clock parentWord hparent_count
      G_O P J S (M_lower_nat w u) zeta hPtX q r
    have hmap : (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct fc.clock.m w) =
        W_O.map Sum.inl := by
      rw [map_bundleToLiftedAct_eq_map_inl]
    rw [wordScore_append, hmap] at hend
    have hnew := wordScore_map_inl_new G_O P J s_mid W_O r
    change wordScore (liftedGameMat G_O P J) s_mid (W_O.map Sum.inl) (Sum.inr r) = _ at hnew
    change wordScore (liftedGameMat G_O P J) s_mid (W_O.map Sum.inl) (Sum.inr r) = _ at hend
    rw [hnew] at hend
    have hJM_nonneg : 0 ≤ ((J * M_of_nat (M_lower_nat w u)).mulVec (binomBasis (w + 1) (q + 1))) r := by
      dsimp [Matrix.mulVec, dotProduct]
      refine Finset.sum_nonneg fun c _ => ?_
      have h1 : 0 ≤ (J * M_of_nat (M_lower_nat w u)) r c := by
        rw [Matrix.mul_apply]
        refine Finset.sum_nonneg fun a _ => ?_
        have hj := J_lower_eta_inl_nonneg w (fun c => 2 * (u c : ℚ))
          (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) eta heta j0 a
        have hm : 0 ≤ M_of_nat (M_lower_nat w u) a c := by
          dsimp [M_of_nat]
          exact Nat.cast_nonneg _
        exact mul_nonneg hj hm
      have h2 : 0 ≤ binomBasis (w + 1) (q + 1) c := by unfold binomBasis; positivity
      exact mul_nonneg h1 h2
    have hP_col_le : ∀ x : Fin (fc.clock.m + 1), P x r ≤ -eps := by
      intro x
      have h := hP_inl x j0
      have ha := heps x
      linarith
    have h_Pg : P (gatewayOldAct fc.clock.m) r < -c_step - C_bundle := by
      have h := hP_inl (gatewayOldAct fc.clock.m) j0
      linarith
    have hlt := stage3_early_reset_waits_step (S.mulVec (binomBasis (w + 1) (q + 1))) W_O k hk
      (s_mid (Sum.inr r)) (fun x => P x r)
      (dotProduct zeta (binomBasis (w + 1) (q + 1)) -
        ((J * M_of_nat (M_lower_nat w u)).mulVec (binomBasis (w + 1) (q + 1))) r + P (gatewayOldAct fc.clock.m) r)
      hend eps (fun x _ => hP_col_le x)
      (dotProduct zeta (binomBasis (w + 1) (q + 1))) (P (gatewayOldAct fc.clock.m) r)
      (by linarith) c_step C_bundle (h_active q k hk) h_Pg
    exact le_of_lt hlt

theorem g_zeta_growth (hR_nonneg : ∀ c : Fin w, 0 ≤ fc.clock.R b c) (q : ℕ) :
    dotProduct (gZeta hw fc b c_step H0) (binomBasis (w + 1) q) ≤
      dotProduct (gZeta hw fc b c_step H0) (binomBasis (w + 1) (q + 1)) - c_step := by
  have h1 := zeta_canonical_diff_succ (Nat.le_of_succ_le hw) fc.clock b c_step H0 q
  have h2 := leader_score_succ_ge_zero (Nat.le_of_succ_le hw) fc.clock b hR_nonneg q
  simp only [gZeta]
  linarith

theorem g_gw_dom (hu0 : w + 1 ≤ u 0) (hui : ∀ i : Fin w, 1 ≤ u i.succ)
    (hell : ell_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha = fun c => 2 * (u c : ℚ))
    (hb_subdiag : fc.clock.R b ⟨w - 1, by omega⟩ = 1)
    (hR_nonneg : ∀ c : Fin w, 0 ≤ fc.clock.R b c) (heta : 0 ≤ eta)
    (h_leader_all : ∀ i (j : Fin w), fc.clock.R i j ≤ fc.clock.R b j)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis w σ))
    (a_old : Fin (fc.clock.m + 1) → ℚ) (ha_pos : ∀ x, 0 < a_old x)
    (hP_inr : ∀ (x : Fin (fc.clock.m + 1)) (j : Fin (w + 1)),
      a_old x / 4 ≤ gP hw fc b c_step H0 alpha eta u P0 x (finSumFinEquiv (Sum.inr j)))
    (hP_inl : ∀ (x : Fin (fc.clock.m + 1)) (i : Fin (w + 1)),
      gP hw fc b c_step H0 alpha eta u P0 x (finSumFinEquiv (Sum.inl i)) ≤ -(a_old x / 4))
    (h_gw_margin : c_step < a_old (gatewayOldAct fc.clock.m) / 4) (hc1 : 1 ≤ c_step) (q : ℕ) :
    ∀ y : Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
      y ≠ gatewayToLiftedAct fc.clock.m w →
      wordScore (gGl hw fc b c_step H0 alpha eta u P0)
        ((gRl hw fc b c_step H0 alpha eta u).mulVec (binomBasis (w + 1) q))
        (W_early_word_M fc.clock.m w (M_lower_nat w u) q ++ W_late_word_M fc.clock.m w (M_lower_nat w u) q ++
          ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct fc.clock.m w))) y <
      wordScore (gGl hw fc b c_step H0 alpha eta u P0)
        ((gRl hw fc b c_step H0 alpha eta u).mulVec (binomBasis (w + 1) q))
        (W_early_word_M fc.clock.m w (M_lower_nat w u) q ++ W_late_word_M fc.clock.m w (M_lower_nat w u) q ++
          ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct fc.clock.m w)))
        (gatewayToLiftedAct fc.clock.m w) := by
  set G_O := AdjoinLeaderEndpointG fc.clock.G b fc.clock.v with hG_O
  set P := gP hw fc b c_step H0 alpha eta u P0 with hP
  set J := gJ hw fc b c_step H0 alpha eta u with hJ
  set s0 := (gRl hw fc b c_step H0 alpha eta u).mulVec (binomBasis (w + 1) q) with hs0
  have hPtX := g_hPtX hw fc b c_step H0 alpha eta u P0
  have hPM := g_hPM hw fc b c_step H0 alpha eta u P0 hu0 hui hell hb_subdiag
  have h_leader : ∀ q : ℕ, ∀ i : Fin fc.clock.m,
      fc.clock.R.mulVec (binomBasis w (q + 1)) i ≤ fc.clock.R.mulVec (binomBasis w (q + 1)) b := by
    intro q i
    simp only [Matrix.mulVec, dotProduct]
    apply Finset.sum_le_sum
    intro j _
    have hbin : 0 ≤ binomBasis w (q + 1) j := by unfold binomBasis; positivity
    exact mul_le_mul_of_nonneg_right (h_leader_all i j) hbin
  have hJM_nonneg : ∀ j : Fin (w + 1),
      0 ≤ ((J * M_of_nat (M_lower_nat w u)).mulVec (binomBasis (w + 1) (q + 1))) (finSumFinEquiv (Sum.inl j)) := by
    intro j
    dsimp [Matrix.mulVec, dotProduct]
    refine Finset.sum_nonneg fun c _ => ?_
    have h1 : 0 ≤ (J * M_of_nat (M_lower_nat w u)) (finSumFinEquiv (Sum.inl j)) c := by
      rw [Matrix.mul_apply]
      refine Finset.sum_nonneg fun a _ => ?_
      have hj := J_lower_eta_inl_nonneg w (fun c => 2 * (u c : ℚ))
        (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) eta heta j a
      have hm : 0 ≤ M_of_nat (M_lower_nat w u) a c := by dsimp [M_of_nat]; exact Nat.cast_nonneg _
      exact mul_nonneg hj hm
    have h2 : 0 ≤ binomBasis (w + 1) (q + 1) c := by unfold binomBasis; positivity
    exact mul_nonneg h1 h2
  have hP_early_margin : ∀ j : Fin (w + 1),
      P (gatewayOldAct fc.clock.m) (finSumFinEquiv (Sum.inl j)) < -c_step + 1 / 2 := by
    intro j
    have h := hP_inl (gatewayOldAct fc.clock.m) j
    linarith
  have hP_late : ∀ (j : Fin (w + 1)) (u_old : Fin (fc.clock.m + 1)),
      0 ≤ P u_old (finSumFinEquiv (Sum.inr j)) := by
    intro j u_old
    have h := hP_inr u_old j
    have hpos := ha_pos u_old
    linarith
  have h_late_mono : ∀ j : Fin (w + 1),
      wordScore (liftedGameMat G_O P J) s0
        (W_early_word_M fc.clock.m w (M_lower_nat w u) q ++ W_late_word_M fc.clock.m w (M_lower_nat w u) q ++
          (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct fc.clock.m w))
        (Sum.inr (finSumFinEquiv (Sum.inr j))) ≤
      wordScore (liftedGameMat G_O P J) s0
        (W_early_word_M fc.clock.m w (M_lower_nat w u) q ++ W_late_word_M fc.clock.m w (M_lower_nat w u) q)
        (Sum.inr (finSumFinEquiv (Sum.inr j))) := by
    intro j
    rw [wordScore_append]
    have hmap : ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct fc.clock.m w)) =
        ((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m)).map Sum.inl := by
      rw [map_bundleToLiftedAct_eq_map_inl]
    rw [hmap]
    have hnew := wordScore_map_inl_new G_O P J
      (wordScore (liftedGameMat G_O P J) s0
        (W_early_word_M fc.clock.m w (M_lower_nat w u) q ++ W_late_word_M fc.clock.m w (M_lower_nat w u) q))
      ((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m))
      (finSumFinEquiv (Sum.inr j))
    change wordScore (liftedGameMat G_O P J) _
      (((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m)).map Sum.inl) _ = _ at hnew
    rw [hnew]
    have hsum : 0 ≤ ∑ x, P x (finSumFinEquiv (Sum.inr j)) *
        wordCountVec ((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m)) x := by
      refine Finset.sum_nonneg fun x _ => mul_nonneg (hP_late j x) (by dsimp [wordCountVec]; positivity)
    linarith
  have h_late_mid : ∀ j : Fin (w + 1),
      wordScore (liftedGameMat G_O P J) s0
        (W_early_word_M fc.clock.m w (M_lower_nat w u) q ++ W_late_word_M fc.clock.m w (M_lower_nat w u) q)
        (Sum.inr (finSumFinEquiv (Sum.inr j))) ≤
        dotProduct (gZeta hw fc b c_step H0) (binomBasis (w + 1) q) := by
    intro j
    have h0 := late_reset_take_score_le_zeta hw fc.clock b c_step H0 (1 / 2)
      u alpha eta heta P0 fc.L_C parentWord j (hP_late j) q 0
    dsimp [List.take, wordCountVec, List.count] at h0
    simp only [mul_zero, Finset.sum_const_zero, sub_zero] at h0
    exact h0
  exact generic_stage4_gw_dom hw fc b c_step H0 hc1 u alpha eta P0
    parentWord hparent_count (fun q i => h_leader q i) hPtX hPM q hJM_nonneg hP_early_margin h_late_mono
    h_late_mid (g_zeta_growth hw fc b c_step H0 hR_nonneg q)

theorem g_old_start'
    (h_leader_all : ∀ i (j : Fin w), fc.clock.R i j ≤ fc.clock.R b j)
    (hc_Gv : ∀ i : Fin fc.clock.m, fc.clock.R i ⟨0, by omega⟩ - fc.clock.R b ⟨0, by omega⟩ -
      (fc.clock.G b i + fc.clock.v i) < c_step)
    (hc : (1 / 2 : ℚ) < c_step) (q : ℕ) (x : Fin (fc.clock.m + 1)) :
    (gRl hw fc b c_step H0 alpha eta u).mulVec (binomBasis (w + 1) q) (Sum.inl x) <
      dotProduct (gZeta hw fc b c_step H0) (binomBasis (w + 1) q) := by
  have h_parent : ∀ i : Fin fc.clock.m,
      (fc.clock.R.mulVec (binomBasis w q)) i - (fc.clock.R.mulVec (binomBasis w q)) b -
        fc.clock.G b i - fc.clock.v i < c_step := by
    intro i
    have h_diff_le := R_mulVec_diff_le_col0 (by omega) fc.clock b i h_leader_all q
    have := hc_Gv i
    linarith
  exact stage1_old_start_all (Nat.le_of_succ_le hw) fc.clock b c_step H0 (1 / 2)
    (gJ hw fc b c_step H0 alpha eta u) (M_of_nat (M_lower_nat w u)) q hc h_parent x

theorem g_bundle_valid (hu0 : w + 1 ≤ u 0) (hui : ∀ i : Fin w, 1 ≤ u i.succ)
    (hell : ell_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha = fun c => 2 * (u c : ℚ))
    (hb_subdiag : fc.clock.R b ⟨w - 1, by omega⟩ = 1)
    (hR_nonneg : ∀ c : Fin w, 0 ≤ fc.clock.R b c) (heta : 0 ≤ eta)
    (parentWord : ℕ → List (Fin fc.clock.m)) (parent_rank : Fin fc.clock.m → Fin fc.clock.m)
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis w σ))
    (hparent_valid : ∀ σ : ℕ,
      IsValidPriorityWord fc.clock.G (fc.clock.R.mulVec (binomBasis w σ)) parent_rank (parentWord σ))
    (h_v_take : ∀ σ r, r < (parentWord σ).length →
      dotProduct fc.clock.v (wordCountVec ((parentWord σ).take r)) ≤ 0)
    (a_old : Fin (fc.clock.m + 1) → ℚ) (ha_pos : ∀ x, 0 < a_old x)
    (hP_inr : ∀ (x : Fin (fc.clock.m + 1)) (j : Fin (w + 1)),
      a_old x / 4 ≤ gP hw fc b c_step H0 alpha eta u P0 x (finSumFinEquiv (Sum.inr j)))
    (hP_inl : ∀ (x : Fin (fc.clock.m + 1)) (i : Fin (w + 1)),
      gP hw fc b c_step H0 alpha eta u P0 x (finSumFinEquiv (Sum.inl i)) ≤ -(a_old x / 4))
    (eps C_bundle : ℚ) (heps : ∀ x, eps ≤ a_old x / 4)
    (h_active : ∀ (q k : ℕ) (_hk : k < ((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m)).length),
      dotProduct (gZeta hw fc b c_step H0) (binomBasis (w + 1) (q + 1)) - c_step - C_bundle -
          eps * ((((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m)).drop k).length : ℚ) ≤
        wordScore (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
          ((gS hw fc b c_step H0).mulVec (binomBasis (w + 1) (q + 1)))
          (((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m)).take k)
          (((W_bundle_word parentWord (q + 1)).map (parentToOldAct fc.clock.m))[k]))
    (h_gw_margin : c_step + C_bundle < a_old (gatewayOldAct fc.clock.m) / 4) (ps : ℕ) (p : ℕ) :
    IsValidPriorityWord (gGl hw fc b c_step H0 alpha eta u P0)
      (wordScore (gGl hw fc b c_step H0 alpha eta u P0)
        ((gRl hw fc b c_step H0 alpha eta u).mulVec (binomBasis (w + 1) (p + ps)))
        (W_early_word_M fc.clock.m w (M_lower_nat w u) (p + ps) ++ W_late_word_M fc.clock.m w (M_lower_nat w u) (p + ps)))
      (paperPriorityRank fc.clock.m w parent_rank)
      ((W_bundle_word parentWord (p + ps + 1)).map (bundleToLiftedAct fc.clock.m w)) :=
  GroundedRealizedClock.discharge_bundle' hw fc.clock b c_step H0 (1 / 2) u
    (R_M_lower w (fun c => 2 * (u c : ℚ))) (gJ hw fc b c_step H0 alpha eta u)
    (E_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha) (gZeta hw fc b c_step H0) P0 fc.L_C
    (R_M_lower_mul_M_lower_nat w u hu0 hui)
    (M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w u _ eta hu0 hui)
    (E_uniform_total_moment_equation_M_lower_nat hw fc.clock b c_step H0 (1 / 2) alpha u (by omega) hell
      (by rw [hb_subdiag]; norm_num))
    parentWord parent_rank hparent_count hparent_valid ps
    (fun p k hk => g_gw_waits hw fc b c_step H0 alpha eta u P0 hu0 hui hell hb_subdiag parentWord parent_rank
      hparent_count hparent_valid h_v_take (p + ps) k hk)
    (fun p k hk j => g_reset_waits hw fc b c_step H0 alpha eta u P0 hu0 hui hell hb_subdiag hR_nonneg heta
      parentWord parent_rank hparent_count hparent_valid a_old ha_pos hP_inr hP_inl eps C_bundle heps h_active
      h_gw_margin (p + ps) k hk j) p

end GenericLift

lemma M_lower_nat_last_row_col_ge_one' (w : ℕ) (hw : 2 ≤ w) (u : Fin (w + 1) → ℕ)
    (hui : ∀ i : Fin w, 1 ≤ u i.succ) :
    1 ≤ M_lower_nat w u (finSumFinEquiv (Sum.inl (⟨w, Nat.lt_succ_self w⟩ : Fin (w + 1)) :
      Fin (w + 1) ⊕ Fin (w + 1))) ⟨w, Nat.lt_succ_self w⟩ := by
  have h1 : M_lower_nat w u (finSumFinEquiv (Sum.inl (⟨w, Nat.lt_succ_self w⟩ : Fin (w + 1)) :
      Fin (w + 1) ⊕ Fin (w + 1))) ⟨w, Nat.lt_succ_self w⟩ =
      W_lower_nat w u ⟨w, Nat.lt_succ_self w⟩ ⟨w, Nat.lt_succ_self w⟩ := by
    change (match finSumFinEquiv.symm (finSumFinEquiv (Sum.inl (⟨w, Nat.lt_succ_self w⟩ : Fin (w + 1)) :
      Fin (w + 1) ⊕ Fin (w + 1))) with
      | Sum.inl i => W_lower_nat w u i ⟨w, Nat.lt_succ_self w⟩
      | Sum.inr i => W_lower_nat w u i ⟨w, Nat.lt_succ_self w⟩) = _
    rw [finSumFinEquiv.symm_apply_apply]
  rw [h1]
  dsimp [W_lower_nat]
  have hw_ne_zero : w ≠ 0 := by omega
  have hne : ¬ (⟨w, Nat.lt_succ_self w⟩ : Fin (w + 1)).val = 0 := by
    simp [hw_ne_zero]
  rw [if_neg hne, if_neg hne, if_pos rfl]
  have h_succ : (⟨w, Nat.lt_succ_self w⟩ : Fin (w + 1)) = (⟨w - 1, by omega⟩ : Fin w).succ := by
    ext; simp; omega
  rw [h_succ]
  exact hui ⟨w - 1, by omega⟩

/-- All inputs needed to lift a parent clock at order `w` (with `delta = 1/2`). -/
structure LiftInput (w : ℕ) where
  hw : 2 ≤ w
  rc : RealizedClock w
  b : Fin rc.fc.clock.m
  hb_subdiag : rc.fc.clock.R b ⟨w - 1, by omega⟩ = 1
  parentWord : ℕ → List (Fin rc.fc.clock.m)
  parent_rank : Fin rc.fc.clock.m → Fin rc.fc.clock.m
  hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = rc.fc.clock.C.mulVec (binomBasis w σ)
  hparent_valid : ∀ σ : ℕ,
    IsValidPriorityWord rc.fc.clock.G (rc.fc.clock.R.mulVec (binomBasis w σ)) parent_rank (parentWord σ)
  h_leader_all : ∀ i (j : Fin w), rc.fc.clock.R i j ≤ rc.fc.clock.R b j
  hR_pos : ∀ j, 0 < rc.fc.clock.R b j
  h_v_take : ∀ σ r, r < (parentWord σ).length →
    dotProduct rc.fc.clock.v (wordCountVec ((parentWord σ).take r)) ≤ 0
  c_step : ℚ
  H0 : ℚ
  alpha : ℚ
  eta : ℚ
  heta : 0 < eta
  hc1 : 1 ≤ c_step
  hc_Gv : ∀ i, rc.fc.clock.R i ⟨0, by omega⟩ - rc.fc.clock.R b ⟨0, by omega⟩ -
    (rc.fc.clock.G b i + rc.fc.clock.v i) < c_step
  hH0 : 1 ≤ H0
  u : Fin (w + 1) → ℕ
  hu0 : w + 1 ≤ u 0
  hui : ∀ i : Fin w, 1 ≤ u i.succ
  hell : ell_uniform_total hw rc.fc.clock b c_step H0 (1 / 2) alpha = fun c => 2 * (u c : ℚ)
  hJ_subdiag : ∀ a b_act : Fin ((w + 1) + (w + 1)), b_act.val < a.val →
    0 < J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 (1 / 2) alpha) eta a b_act
  a_old : Fin (rc.fc.clock.m + 1) → ℚ
  ha_pos : ∀ x, 0 < a_old x
  hP_inr : ∀ (x : Fin (rc.fc.clock.m + 1)) (j : Fin (w + 1)),
    a_old x / 4 ≤ gP hw rc.fc b c_step H0 alpha eta u (P0_cone_old a_old w) x (finSumFinEquiv (Sum.inr j))
  hP_inl : ∀ (x : Fin (rc.fc.clock.m + 1)) (i : Fin (w + 1)),
    gP hw rc.fc b c_step H0 alpha eta u (P0_cone_old a_old w) x (finSumFinEquiv (Sum.inl i)) ≤ -(a_old x / 4)
  eps : ℚ
  C_bundle : ℚ
  hC_nonneg : 0 ≤ C_bundle
  heps : ∀ x, eps ≤ a_old x / 4
  h_active : ∀ (q k : ℕ) (_hk : k < ((W_bundle_word parentWord (q + 1)).map (parentToOldAct rc.fc.clock.m)).length),
    dotProduct (gZeta hw rc.fc b c_step H0) (binomBasis (w + 1) (q + 1)) - c_step - C_bundle -
        eps * ((((W_bundle_word parentWord (q + 1)).map (parentToOldAct rc.fc.clock.m)).drop k).length : ℚ) ≤
      wordScore (AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v)
        ((gS hw rc.fc b c_step H0).mulVec (binomBasis (w + 1) (q + 1)))
        (((W_bundle_word parentWord (q + 1)).map (parentToOldAct rc.fc.clock.m)).take k)
        (((W_bundle_word parentWord (q + 1)).map (parentToOldAct rc.fc.clock.m))[k])
  h_gw_margin : c_step + C_bundle < a_old (gatewayOldAct rc.fc.clock.m) / 4

section LiftInput

variable {w : ℕ} (L : LiftInput w)

theorem LiftInput.hR_nonneg : ∀ c : Fin w, 0 ≤ L.rc.fc.clock.R L.b c := fun c => le_of_lt (L.hR_pos c)

theorem LiftInput.hP_inl_nonpos (j : Fin (w + 1)) (x : Fin (L.rc.fc.clock.m + 1)) :
    gP L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u (P0_cone_old L.a_old w) x
      (finSumFinEquiv (Sum.inl j)) ≤ 0 := by
  have := L.hP_inl x j
  have := L.ha_pos x
  linarith

theorem LiftInput.hP_inr_nonneg (j : Fin (w + 1)) (x : Fin (L.rc.fc.clock.m + 1)) :
    0 ≤ gP L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u (P0_cone_old L.a_old w) x
      (finSumFinEquiv (Sum.inr j)) := by
  have := L.hP_inr x j
  have := L.ha_pos x
  linarith

theorem LiftInput.h_old (q : ℕ) (x : Fin (L.rc.fc.clock.m + 1)) :
    (gRl L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u).mulVec (binomBasis (w + 1) q) (Sum.inl x) <
      dotProduct (gZeta L.hw L.rc.fc L.b L.c_step L.H0) (binomBasis (w + 1) q) :=
  g_old_start' L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u L.h_leader_all L.hc_Gv
    (by linarith [L.hc1]) q x

theorem LiftInput.hP_pos_parent (i : Fin L.rc.fc.clock.m) :
    0 < gP L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u (P0_cone_old L.a_old w)
      (finSumFinEquiv (Sum.inl i)) (finSumFinEquiv (Sum.inr ⟨w, Nat.lt_succ_self w⟩)) := by
  have := L.hP_inr (finSumFinEquiv (Sum.inl i)) ⟨w, Nat.lt_succ_self w⟩
  have := L.ha_pos (finSumFinEquiv (Sum.inl i))
  linarith

theorem LiftInput.gw_margin' : L.c_step < L.a_old (gatewayOldAct L.rc.fc.clock.m) / 4 := by
  have h1 := L.h_gw_margin
  have h2 := L.hC_nonneg
  linarith

/-- The grounded realized clock built from a lift input (phase shift `w`). -/
noncomputable def LiftInput.toGRC : GroundedRealizedClock w where
  hw := L.hw
  rc := L.rc
  b := L.b
  hb_subdiag := L.hb_subdiag
  c_step := L.c_step
  H0 := L.H0
  delta := 1 / 2
  hdelta := by norm_num
  alpha := L.alpha
  eta := L.eta
  heta := L.heta
  u := L.u
  hu0 := L.hu0
  hui := L.hui
  hell := L.hell
  P0 := P0_cone_old L.a_old w
  phaseShift := w
  hshift := le_rfl
  parentWord := L.parentWord
  hparent_count := L.hparent_count
  parent_rank := L.parent_rank
  h_dot_ge_low := fun p =>
    zeta_canonical_dot_binomBasis_ge_one_add_choose L.hw L.rc.fc.clock L.b L.c_step L.H0 L.hH0
      (by linarith [L.hc1]) L.hR_nonneg L.hb_subdiag (p + w)
  h_dot_ge_high := fun p =>
    zeta_canonical_dot_binomBasis_nonneg L.hw L.rc.fc.clock L.b L.c_step L.H0 (by linarith [L.hH0])
      (by linarith [L.hc1]) L.hR_nonneg (p + 1 + w)
  h_len_lower := fun q =>
    rawFourStageWord_M_length_ge_choose L.rc.fc.clock L.parentWord (M_lower_nat w L.u) _
      (M_lower_nat_last_row_col_ge_one' w L.hw L.u L.hui) q
  h_early := fun p =>
    g_early_valid L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u (P0_cone_old L.a_old w) L.hu0
      L.hJ_subdiag L.hP_inl_nonpos L.h_old L.parent_rank (p + w)
  h_late := fun p =>
    g_late_valid L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u (P0_cone_old L.a_old w) L.hu0 L.hui L.hell
      L.hb_subdiag L.hJ_subdiag L.hP_inr_nonneg L.hP_pos_parent
      (fun i => L.h_leader_all i ⟨0, by have := L.hw; omega⟩) L.parent_rank (p + w)
  h_bundle := fun p =>
    g_bundle_valid L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u (P0_cone_old L.a_old w) L.hu0 L.hui L.hell
      L.hb_subdiag L.hR_nonneg (le_of_lt L.heta) L.parentWord L.parent_rank L.hparent_count L.hparent_valid
      L.h_v_take L.a_old L.ha_pos L.hP_inr L.hP_inl L.eps L.C_bundle L.heps L.h_active L.h_gw_margin w p
  h_gw := fun p =>
    g_gw_dom L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u (P0_cone_old L.a_old w) L.hu0 L.hui L.hell
      L.hb_subdiag L.hR_nonneg (le_of_lt L.heta) L.h_leader_all L.parentWord L.hparent_count L.a_old L.ha_pos
      L.hP_inr L.hP_inl L.gw_margin' L.hc1 (p + w)

/-- Raw validity of the four-stage word at every phase `σ` (including `σ < w`). -/
theorem LiftInput.raw_valid (σ : ℕ) :
    IsValidPriorityWord (gGl L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u (P0_cone_old L.a_old w))
      ((gRl L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u).mulVec (binomBasis (w + 1) σ))
      (paperPriorityRank L.rc.fc.clock.m w L.parent_rank)
      (rawFourStageWord_M L.rc.fc.clock L.parentWord (M_lower_nat w L.u) σ) :=
  uniform_hpriority_raw_of_stages_M L.hw L.rc.fc L.b L.c_step L.H0 (1 / 2) (M_lower_nat w L.u)
    (R_M_lower w (fun c => 2 * (L.u c : ℚ))) (gJ L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u)
    (gZeta L.hw L.rc.fc L.b L.c_step L.H0) (P0_cone_old L.a_old w) L.parentWord L.parent_rank σ
    (g_early_valid L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u (P0_cone_old L.a_old w) L.hu0
      L.hJ_subdiag L.hP_inl_nonpos L.h_old L.parent_rank σ)
    (g_late_valid L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u (P0_cone_old L.a_old w) L.hu0 L.hui L.hell
      L.hb_subdiag L.hJ_subdiag L.hP_inr_nonneg L.hP_pos_parent
      (fun i => L.h_leader_all i ⟨0, by have := L.hw; omega⟩) L.parent_rank σ)
    (g_bundle_valid L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u (P0_cone_old L.a_old w) L.hu0 L.hui L.hell
      L.hb_subdiag L.hR_nonneg (le_of_lt L.heta) L.parentWord L.parent_rank L.hparent_count L.hparent_valid
      L.h_v_take L.a_old L.ha_pos L.hP_inr L.hP_inl L.eps L.C_bundle L.heps L.h_active L.h_gw_margin 0 σ)
    (g_gw_dom L.hw L.rc.fc L.b L.c_step L.H0 L.alpha L.eta L.u (P0_cone_old L.a_old w) L.hu0 L.hui L.hell
      L.hb_subdiag L.hR_nonneg (le_of_lt L.heta) L.h_leader_all L.parentWord L.hparent_count L.a_old L.ha_pos
      L.hP_inr L.hP_inl L.gw_margin' L.hc1 σ)

end LiftInput

theorem E_uniform_total_eq_E_uniform_of_CGC_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ) (hCGC : clock.C.transpose * clock.G * clock.C = 0) :
    E_uniform_total hw clock b c_step H0 delta alpha = E_uniform hw clock b c_step H0 delta alpha := by
  have hG := G_inner_uniform_eq_zero_of_CGC_zero hw clock b c_step H0 delta hCGC
  have hF := F_inner_uniform_eq_zero_of_CGC_zero hw clock b c_step H0 delta hCGC
  have hsplit := F_gw_split hw clock b c_step H0 delta
  rw [hF, add_zero] at hsplit
  simp only [E_uniform_total, E_uniform]
  rw [hG, ell_seq_zero, ← hsplit]
  have hz : G_with_ell (fun _ _ => (0 : ℚ)) (v_seq_fun hw clock b c_step) (fun _ => 0) = fun _ _ => 0 := by
    ext a b; simp [G_with_ell]
  rw [hz]
  have hE0 : E_mat_U w (fun _ _ => (0 : ℚ)) = 0 := by
    ext i j; simp [E_mat_U, E_from_U, U_mat_zero]
  rw [hE0, add_zero]

/-- A lift input together with the invariants needed to lift once more. -/
structure GroundedClockBundle (w : ℕ) where
  L : LiftInput w
  hasSuffix : HasSuffixBound L.rc.fc.clock L.b L.parentWord
  h_len : ∀ τ : ℕ, (Nat.choose (τ + w - 1) (w - 1) : ℚ) ≤ ((L.parentWord τ).length : ℚ)
  hCGC : L.rc.fc.clock.C.transpose * L.rc.fc.clock.G * L.rc.fc.clock.C = 0
  m_alpha : ℕ
  halpha : L.alpha = 3 * (2 * (m_alpha : ℚ) + 1)
  hzeta_int : ∀ c : Fin (w + 1), ∃ z : ℤ,
    3 * zeta_canonical (Nat.le_of_succ_le L.hw) L.rc.fc.clock L.b L.c_step L.H0 c = (z : ℚ)
  hm : L.rc.fc.clock.m = (w + 1) ^ 2 - 6

set_option maxHeartbeats 3200000

section ConeTransport

variable {w : ℕ} (grc : GroundedRealizedClock w)


/-- Score rows of the step clock (duplicate of opus-prover's `step_clock_R_apply`). -/
theorem step_clock_R_apply' (a : Fin grc.step_rc.fc.clock.m) (j : Fin (w + 1)) :
    grc.step_rc.fc.clock.R a j =
      liftedScoreMat (AdjoinLeaderEndpointG grc.rc.fc.clock.G grc.b grc.rc.fc.clock.v)
        (J_lower_eta w (fun c => 2 * (grc.u c : ℚ))
          (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta)
        (S_uniform (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b
          (h_uniform grc.rc.fc.clock grc.b
            (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0) grc.c_step) grc.delta)
        (X_gateway grc.rc.fc.clock) (M_of_nat (M_lower_nat w grc.u))
        (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0)
        ((rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm a) j := by
  change (uniformFullRankLift_M grc.hw grc.rc.fc grc.b grc.c_step grc.H0 grc.delta
    (M_lower_nat w grc.u) (R_M_lower w (fun c => 2 * (grc.u c : ℚ)))
    (J_lower_eta w (fun c => 2 * (grc.u c : ℚ))
      (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta)
    (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha)
    (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0) grc.P0
    (R_M_lower_mul_M_lower_nat w grc.u grc.hu0 grc.hui)
    (M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w grc.u _ grc.eta grc.hu0 grc.hui)
    (E_uniform_total_moment_equation_M_lower_nat grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta
      grc.alpha grc.u (by have := grc.hu0; omega) grc.hell (by rw [grc.hb_subdiag]; norm_num))).clock.R a j = _
  dsimp [uniformFullRankLift_M, AlgebraicClock.ofEquiv]

/-- The leader `step_b0` has score row `zeta` (duplicate of opus-prover's `step_b0_R`). -/
theorem step_b0_R' (j : Fin (w + 1)) :
    grc.step_rc.fc.clock.R (step_b0 grc) j =
      zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0 j := by
  rw [step_clock_R_apply', step_b0, Equiv.symm_apply_apply]
  simp only [liftedScoreMat, Matrix.of_apply, Matrix.sub_apply, one_zeta]
  have : (J_lower_eta w (fun c => 2 * (grc.u c : ℚ))
      (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta *
      M_of_nat (M_lower_nat w grc.u)) ⟨0, by omega⟩ j = 0 := by
    rw [Matrix.mul_apply]
    refine Finset.sum_eq_zero fun a _ => ?_
    rw [J_lower_eta_lower w _ _ grc.eta ⟨0, by omega⟩ a (by simp), zero_mul]
  rw [this, sub_zero]

/-- Count rows of the step clock. -/
theorem step_clock_C_apply (a : Fin grc.step_rc.fc.clock.m) (c : Fin (w + 1)) :
    grc.step_rc.fc.clock.C a c =
      liftedCountMat (X_gateway grc.rc.fc.clock) (M_of_nat (M_lower_nat w grc.u)) (N_mat (w + 1))
        ((rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm a) c := by
  change (uniformFullRankLift_M grc.hw grc.rc.fc grc.b grc.c_step grc.H0 grc.delta
    (M_lower_nat w grc.u) (R_M_lower w (fun c => 2 * (grc.u c : ℚ)))
    (J_lower_eta w (fun c => 2 * (grc.u c : ℚ))
      (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta)
    (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha)
    (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0) grc.P0
    (R_M_lower_mul_M_lower_nat w grc.u grc.hu0 grc.hui)
    (M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w grc.u _ grc.eta grc.hu0 grc.hui)
    (E_uniform_total_moment_equation_M_lower_nat grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta
      grc.alpha grc.u (by have := grc.hu0; omega) grc.hell (by rw [grc.hb_subdiag]; norm_num))).clock.C a c = _
  dsimp [uniformFullRankLift_M, AlgebraicClock.ofEquiv]

/-- Row permutation `π = finSumFinEquiv ∘ rot.symm` relating the step clock's rows to the rows of
`C_lifted_lower`. -/
def stepRowPerm : Fin grc.step_rc.fc.clock.m ≃ Fin ((grc.rc.fc.clock.m + 1) + ((w + 1) + (w + 1))) :=
  (rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm.trans finSumFinEquiv

theorem step_clock_C_eq_C_lifted_lower (a : Fin grc.step_rc.fc.clock.m) (c : Fin (w + 1)) :
    grc.step_rc.fc.clock.C a c =
      C_lifted_lower w grc.rc.fc.clock (fun c => 2 * (grc.u c : ℚ)) (stepRowPerm grc a) c := by
  rw [step_clock_C_apply, M_of_nat_M_lower_nat w grc.u (by have := grc.hu0; omega)]
  simp only [stepRowPerm, Equiv.trans_apply]
  generalize (rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm a = z
  cases z with
  | inl i => simp [liftedCountMat, C_lifted_lower]
  | inr r => simp [liftedCountMat, C_lifted_lower]

/-- Action permutation `ρ` on the extended action set (parents permuted by `π`, gateway fixed). -/
def stepActPerm : Fin (grc.step_rc.fc.clock.m + 1) ≃
    Fin (((grc.rc.fc.clock.m + 1) + ((w + 1) + (w + 1))) + 1) :=
  (finSumFinEquiv (m := grc.step_rc.fc.clock.m) (n := 1)).symm.trans
    (((stepRowPerm grc).sumCongr (Equiv.refl (Fin 1))).trans finSumFinEquiv)

theorem stepActPerm_inl (y : Fin grc.step_rc.fc.clock.m) :
    stepActPerm grc (finSumFinEquiv (Sum.inl y)) = finSumFinEquiv (Sum.inl (stepRowPerm grc y)) := by
  simp [stepActPerm]

theorem stepActPerm_inr (g : Fin 1) :
    stepActPerm grc (finSumFinEquiv (Sum.inr g)) = finSumFinEquiv (Sum.inr g) := by
  simp [stepActPerm]

theorem stepActPerm_gateway :
    stepActPerm grc (gatewayOldAct grc.step_rc.fc.clock.m) = finSumFinEquiv (Sum.inr (0 : Fin 1)) :=
  stepActPerm_inr grc 0

/-- The step clock's gateway count table is the row-permuted `X_gateway_lifted`. -/
theorem X_gateway_step_eq :
    X_gateway grc.step_rc.fc.clock =
      (X_gateway_lifted grc.rc.fc.clock (fun c => 2 * (grc.u c : ℚ))).submatrix (stepActPerm grc) id := by
  ext x c
  obtain ⟨z, rfl⟩ := (finSumFinEquiv (m := grc.step_rc.fc.clock.m) (n := 1)).surjective x
  rw [Matrix.submatrix_apply]
  cases z with
  | inl y =>
    rw [stepActPerm_inl]
    simp only [X_gateway, X_coupled, X_gateway_lifted, Matrix.of_apply, Equiv.symm_apply_apply, id]
    simp only [shiftRightCount, Matrix.of_apply]
    split_ifs with h
    · exact step_clock_C_eq_C_lifted_lower grc y _
    · rfl
  | inr g =>
    rw [stepActPerm_inr]
    simp only [X_gateway, X_coupled, X_gateway_lifted, Matrix.of_apply, Equiv.symm_apply_apply, id]

/-- Transport of `vecMul` along `ρ`. -/
theorem vecMul_stepActPerm (a : Fin (((grc.rc.fc.clock.m + 1) + ((w + 1) + (w + 1))) + 1) → ℚ) :
    Matrix.vecMul (a ∘ stepActPerm grc) (X_gateway grc.step_rc.fc.clock) =
      Matrix.vecMul a (X_gateway_lifted grc.rc.fc.clock (fun c => 2 * (grc.u c : ℚ))) := by
  rw [X_gateway_step_eq, Matrix.submatrix_vecMul_equiv]
  simp only [Function.comp_assoc, Equiv.self_comp_symm, Function.comp_id]

end ConeTransport

/-!
## Target coordinates of `vecMul zeta' (1 + B)` for the step clock
-/

section ConeTarget

variable {w : ℕ} (hw : 2 ≤ w) (clock' : AlgebraicClock (w + 1)) (b0 : Fin clock'.m) (c' H0' : ℚ)

theorem vecMul_zeta_step_one_add_B_zero :
    Matrix.vecMul (zeta_canonical (by omega) clock' b0 c' H0') (1 + B_mat (w + 1 + 1)) 0 =
      2 * H0' - c' := by
  rw [vecMul_zeta_canonical_one_add_B_mat]
  simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  rw [zeta_canonical_zero]
  simp [v_step]

theorem vecMul_zeta_step_one_add_B_succ (d : Fin (w + 1)) :
    Matrix.vecMul (zeta_canonical (by omega) clock' b0 c' H0') (1 + B_mat (w + 1 + 1)) d.succ =
      2 * v_step (by omega) clock' b0 c' (Fin.castSucc d) + v_step (by omega) clock' b0 c' d.succ := by
  rw [vecMul_zeta_canonical_one_add_B_mat]
  simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  have h := zeta_canonical_succ_val (by omega : 1 ≤ w + 1) clock' b0 c' H0' d.succ (by simp)
  have heq : (⟨(d.succ : Fin (w + 1 + 1)).val - 1, by have := d.succ.isLt; omega⟩ : Fin (w + 1 + 1)) =
      Fin.castSucc d := by
    ext; simp
  rw [heq] at h
  rw [h]
  ring

theorem vecMul_zeta_step_one_add_B_one :
    Matrix.vecMul (zeta_canonical (by omega) clock' b0 c' H0') (1 + B_mat (w + 1 + 1)) (Fin.succ 0) =
      2 * c' + clock'.R b0 ⟨1, by omega⟩ := by
  rw [vecMul_zeta_step_one_add_B_succ hw]
  have h1 : (1 : ℕ) < w + 1 := by omega
  simp [v_step, h1]

theorem vecMul_zeta_step_one_add_B_succ_succ (j : Fin w) :
    Matrix.vecMul (zeta_canonical (by omega) clock' b0 c' H0') (1 + B_mat (w + 1 + 1)) j.succ.succ =
      2 * clock'.R b0 j.succ + (if h : j.val + 2 < w + 1 then clock'.R b0 ⟨j.val + 2, h⟩ else 0) := by
  rw [vecMul_zeta_step_one_add_B_succ hw]
  have h1 : j.val + 1 < w + 1 := by omega
  simp only [v_step, Fin.val_castSucc, Fin.val_succ, h1, ↓reduceDIte, Nat.succ_ne_zero, ↓reduceIte,
    sub_zero, add_zero]
  have h2 : (⟨j.val + 1, h1⟩ : Fin (w + 1)) = j.succ := by ext; simp
  rw [h2]

end ConeTarget

/-!
## Cone vector profile `coneV` and the base existence lemma restated
-/

/-- The `v`-profile of `exists_c_step_H0_and_a_old_lifted` with `s = 2`. -/
def coneV {w : ℕ} (C0 : ℚ) (v_rest : Fin w → ℚ) (c_step : ℚ) : Fin (w + 1) → ℚ :=
  fun c => if _ : c.val = 0 then 2 * c_step + C0 else v_rest ⟨c.val - 1, by have := c.isLt; omega⟩

theorem coneV_zero {w : ℕ} (C0 : ℚ) (v_rest : Fin w → ℚ) (c_step : ℚ) :
    coneV C0 v_rest c_step 0 = 2 * c_step + C0 := by
  simp [coneV]

theorem coneV_succ {w : ℕ} (C0 : ℚ) (v_rest : Fin w → ℚ) (c_step : ℚ) (j : Fin w) :
    coneV C0 v_rest c_step j.succ = v_rest j := by
  simp [coneV]

theorem exists_c_step_H0_and_a_old_lifted_coneV {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (ell : Fin (w + 1) → ℚ) (hu0 : (w : ℚ) < ell 0 / 2) (hui : ∀ k : Fin w, 0 < ell k.succ / 2)
    (mu : ℚ) (hmu : 0 < mu) (C0 : ℚ) (v_rest : Fin w → ℚ) (hv_rest : ∀ j : Fin w, 0 < v_rest j) :
    ∃ c_step_star : ℚ, ∀ c_step : ℚ, c_step_star < c_step →
      ∀ H0 : ℚ, c_step + 1 ≤ H0 →
        (∀ x, 0 < a_old_lifted clock ell mu (coneV C0 v_rest c_step) (2 * H0 - c_step) x) ∧
        ((Matrix.vecMul (a_old_lifted clock ell mu (coneV C0 v_rest c_step) (2 * H0 - c_step))
          (X_gateway_lifted clock ell)) 0 = 2 * H0 - c_step) ∧
        (∀ c : Fin (w + 1),
          (Matrix.vecMul (a_old_lifted clock ell mu (coneV C0 v_rest c_step) (2 * H0 - c_step))
            (X_gateway_lifted clock ell)) c.succ =
            mu * y_sum_uniform clock c + coneV C0 v_rest c_step c) := by
  obtain ⟨cs, h⟩ := exists_c_step_H0_and_a_old_lifted hw clock ell hu0 hui mu hmu 2 C0 (by norm_num)
    v_rest hv_rest
  refine ⟨cs, fun c_step hc H0 hH0 => ?_⟩
  have r := h c_step hc H0 hH0
  exact ⟨r.1, r.2.2.1, r.2.2.2⟩

/-- Parent/reset entries of `a_old_lifted` do not depend on `a_g`; the gateway entry is `a_g`. -/
theorem a_old_lifted_mono_ag {w : ℕ} (clock : AlgebraicClock w) (ell : Fin (w + 1) → ℚ)
    (mu : ℚ) (v : Fin (w + 1) → ℚ) (a_g a_g' : ℚ) (h : a_g ≤ a_g') (y) :
    a_old_lifted clock ell mu v a_g y ≤ a_old_lifted clock ell mu v a_g' y := by
  obtain ⟨z, rfl⟩ := finSumFinEquiv.surjective y
  cases z with
  | inl y =>
    simp only [a_old_lifted, Equiv.symm_apply_apply]
    exact le_refl _
  | inr g =>
    simpa [a_old_lifted] using h

theorem a_old_lifted_gateway {w : ℕ} (clock : AlgebraicClock w) (ell : Fin (w + 1) → ℚ)
    (mu : ℚ) (v : Fin (w + 1) → ℚ) (a_g : ℚ) (g : Fin 1) :
    a_old_lifted clock ell mu v a_g (finSumFinEquiv (Sum.inr g)) = a_g := by
  simp [a_old_lifted]

/-!
## Choice of `mu`
-/

theorem exists_mu_pos_cone {w : ℕ} (hw : 2 ≤ w) (zeta : Fin (w + 1) → ℚ) (hzeta_pos : ∀ c, 0 < zeta c)
    (ys : Fin (w + 1) → ℚ) :
    ∃ mu : ℚ, 0 < mu ∧ ∀ j : Fin w, mu * ys j.succ < zeta j.succ := by
  obtain ⟨j0, -, hj0⟩ := Finset.exists_min_image Finset.univ (fun j : Fin w => zeta j.succ)
    ⟨⟨0, by omega⟩, Finset.mem_univ _⟩
  set zmin := zeta j0.succ with hzmin
  set Y := ∑ j : Fin w, |ys j.succ| with hY
  have hY_nonneg : 0 ≤ Y := Finset.sum_nonneg fun j _ => abs_nonneg _
  have hzmin_pos : 0 < zmin := hzeta_pos _
  refine ⟨zmin / (Y + 1), div_pos hzmin_pos (by linarith), fun j => ?_⟩
  have hmu_eq : zmin / (Y + 1) * (Y + 1) = zmin := div_mul_cancel₀ zmin (by linarith)
  have hmu_pos : 0 < zmin / (Y + 1) := div_pos hzmin_pos (by linarith)
  have h1 : zmin / (Y + 1) * Y + zmin / (Y + 1) = zmin := by
    rw [mul_add, mul_one] at hmu_eq; exact hmu_eq
  have h2 : |ys j.succ| ≤ Y := Finset.single_le_sum (fun i _ => abs_nonneg (ys i.succ)) (Finset.mem_univ j)
  have h3 : ys j.succ ≤ |ys j.succ| := le_abs_self _
  have h4 : zmin / (Y + 1) * ys j.succ ≤ zmin / (Y + 1) * Y :=
    mul_le_mul_of_nonneg_left (le_trans h3 h2) hmu_pos.le
  have h5 : zmin ≤ zeta j.succ := hj0 j (Finset.mem_univ _)
  linarith

/-!
## Main theorem
-/

section Main

variable {w : ℕ} (grc : GroundedRealizedClock w)

/-- Parity-aligned next-level parameters `c', H0'`, a strictly positive cone vector `a_old'`
on the step clock with leader `step_b0 grc`, a uniform margin `eps'`, the gateway margin, and the
cone identity for `zeta_canonical _ grc.step_rc.fc.clock (step_b0 grc) c' H0'`. -/
theorem exists_next_cone_params
    (hH0 : 0 < grc.H0) (hc : 0 < grc.c_step)
    (hR : ∀ c : Fin w, 0 < grc.rc.fc.clock.R grc.b c)
    (colsum_0 : ℤ) (C_min : ℚ) (H_min_fn : ℚ → ℚ) (C_bundle_fn : ℚ → ℚ) :
    ∃ (c' H0' eps' : ℚ) (k_step k_H0 : ℤ) (a_old' : Fin (grc.step_rc.fc.clock.m + 1) → ℚ),
      3 * c' = (colsum_0 : ℚ) + 2 * (k_step : ℚ) ∧
      3 * H0' = 1 + (colsum_0 : ℚ) + 2 * (k_H0 : ℚ) ∧
      C_min ≤ c' ∧ 0 < c' ∧ H_min_fn c' ≤ H0' ∧ c' + 1 ≤ H0' ∧
      0 < eps' ∧ (∀ x, 0 < a_old' x) ∧ (∀ x, eps' ≤ a_old' x / 4) ∧
      a_old' (gatewayOldAct grc.step_rc.fc.clock.m) = 2 * H0' - c' ∧
      4 * (c' + C_bundle_fn eps') < 2 * H0' - c' ∧
      Matrix.vecMul a_old' (X_gateway grc.step_rc.fc.clock) =
        Matrix.vecMul (zeta_canonical (by omega) grc.step_rc.fc.clock (step_b0 grc) c' H0')
          (1 + B_mat (w + 1 + 1)) := by
  classical
  have hw1 : 1 ≤ w := Nat.le_of_succ_le grc.hw
  -- opaque names
  obtain ⟨zeta, hzeta⟩ : ∃ z : Fin (w + 1) → ℚ,
      z = zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0 := ⟨_, rfl⟩
  obtain ⟨ys, hys⟩ : ∃ y : Fin (w + 1) → ℚ, y = y_sum_uniform grc.rc.fc.clock := ⟨_, rfl⟩
  have hzeta_pos : ∀ c, 0 < zeta c := by
    rw [hzeta]
    exact zeta_canonical_pos grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 hH0 hc hR
  have hb0_R : ∀ j, grc.step_rc.fc.clock.R (step_b0 grc) j = zeta j := by
    intro j; rw [step_b0_R', hzeta]
  -- mu
  obtain ⟨mu, hmu, hmu_lt⟩ := exists_mu_pos_cone grc.hw zeta hzeta_pos ys
  -- profile
  set C0 : ℚ := zeta ⟨1, by omega⟩ - mu * ys 0 with hC0
  set v_rest : Fin w → ℚ := fun j =>
    2 * zeta j.succ + (if h : j.val + 2 < w + 1 then zeta ⟨j.val + 2, h⟩ else 0) - mu * ys j.succ
    with hv_rest_def
  have hv_rest : ∀ j : Fin w, 0 < v_rest j := by
    intro j
    simp only [hv_rest_def]
    have h1 := hmu_lt j
    have h2 := hzeta_pos j.succ
    have h3 : 0 ≤ (if h : j.val + 2 < w + 1 then zeta ⟨j.val + 2, h⟩ else 0) := by
      split_ifs
      · exact (hzeta_pos _).le
      · exact le_refl _
    linarith
  -- ell data
  set ell : Fin (w + 1) → ℚ := fun c => 2 * (grc.u c : ℚ) with hell
  have hu0 : (w : ℚ) < ell 0 / 2 := by
    have : ((w : ℚ) + 1) ≤ (grc.u 0 : ℚ) := by exact_mod_cast grc.hu0
    simp only [hell]
    linarith
  have hui : ∀ k : Fin w, 0 < ell k.succ / 2 := by
    intro k
    have : (1 : ℚ) ≤ (grc.u k.succ : ℚ) := by exact_mod_cast grc.hui k
    simp only [hell]
    linarith
  -- base existence
  obtain ⟨c_star, h_base⟩ := exists_c_step_H0_and_a_old_lifted_coneV hw1 grc.rc.fc.clock ell hu0 hui
    mu hmu C0 v_rest hv_rest
  -- parity-aligned c'
  obtain ⟨k_step, -, c', -, hk_step, -, hC_min, hc'_pos, -, -⟩ :=
    exists_parity_aligned_c_step_H0 colsum_0 (max C_min (c_star + 1)) 0
  have hc_star_lt : c_star < c' := by
    have := le_trans (le_max_right C_min (c_star + 1)) hC_min
    linarith
  -- reference vector and eps'
  set a_ref := a_old_lifted grc.rc.fc.clock ell mu (coneV C0 v_rest c') (2 * (c' + 1) - c') with ha_ref
  have h_ref := h_base c' hc_star_lt (c' + 1) (by linarith)
  have h_ref_pos : ∀ x, 0 < a_ref x := h_ref.1
  set vals := Finset.image (fun x => a_ref x / 4) Finset.univ with hvals
  have h_nonempty : vals.Nonempty := by
    refine ⟨a_ref (finSumFinEquiv (Sum.inr 0)) / 4, ?_⟩
    exact Finset.mem_image_of_mem _ (Finset.mem_univ _)
  set eps' := vals.min' h_nonempty with heps'
  have heps_pos : 0 < eps' := by
    have h_mem := Finset.min'_mem vals h_nonempty
    obtain ⟨x, -, hx⟩ := Finset.mem_image.mp h_mem
    show 0 < vals.min' h_nonempty
    rw [← hx]
    have := h_ref_pos x
    linarith
  have heps_le : ∀ x, eps' ≤ a_ref x / 4 := by
    intro x
    apply Finset.min'_le
    exact Finset.mem_image_of_mem _ (Finset.mem_univ x)
  -- parity-aligned H0'
  obtain ⟨-, k_H0, -, H0', -, hk_H0, -, -, hH_min, -⟩ :=
    exists_parity_aligned_c_step_H0 colsum_0 0
      (max (H_min_fn c') (max (c' + 1) ((5 * c' + 4 * C_bundle_fn eps' + 1) / 2)))
  have hH1 : H_min_fn c' ≤ H0' := le_trans (le_max_left _ _) hH_min
  have hH2 : c' + 1 ≤ H0' := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hH_min
  have hH3 : (5 * c' + 4 * C_bundle_fn eps' + 1) / 2 ≤ H0' :=
    le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hH_min
  -- final vector
  set a_old := a_old_lifted grc.rc.fc.clock ell mu (coneV C0 v_rest c') (2 * H0' - c') with ha_old
  have h_fin := h_base c' hc_star_lt H0' hH2
  have h_ref_le : ∀ y, a_ref y ≤ a_old y := fun y =>
    a_old_lifted_mono_ag grc.rc.fc.clock ell mu (coneV C0 v_rest c') _ _ (by linarith) y
  refine ⟨c', H0', eps', k_step, k_H0, a_old ∘ stepActPerm grc, hk_step, hk_H0,
    le_trans (le_max_left _ _) hC_min, hc'_pos, hH1, hH2, heps_pos, ?_, ?_, ?_, ?_, ?_⟩
  · intro x
    exact h_fin.1 _
  · intro x
    have := heps_le (stepActPerm grc x)
    have := h_ref_le (stepActPerm grc x)
    simp only [Function.comp_apply]
    linarith
  · simp only [Function.comp_apply, stepActPerm_gateway, ha_old, a_old_lifted_gateway]
  · linarith
  · rw [vecMul_stepActPerm]
    ext c
    refine Fin.cases ?_ (fun d => ?_) c
    · rw [h_fin.2.1, vecMul_zeta_step_one_add_B_zero grc.hw]
    · rw [h_fin.2.2 d]
      refine Fin.cases ?_ (fun j => ?_) d
      · rw [vecMul_zeta_step_one_add_B_one grc.hw, hb0_R, coneV_zero, ← hys, hC0]
        ring
      · rw [vecMul_zeta_step_one_add_B_succ_succ grc.hw, coneV_succ, ← hys, hv_rest_def]
        simp only [hb0_R]
        ring

end Main



/-! ## RPS base case (fable-prover) -/

lemma hw2 : 2 ≤ 2 := le_rfl
lemma hw1 : 1 ≤ 2 := Nat.le_of_succ_le hw2

def u_of_m5 (m : ℕ) : Fin 3 → ℕ
  | 0 => 57 * m + 19
  | 1 => 7 * m - 10
  | 2 => 3 * m - 3

lemma hu0_of_m5 (m : ℕ) (hm : 2 ≤ m) : 2 + 1 ≤ u_of_m5 m 0 := by
  dsimp [u_of_m5]; omega

lemma hui_of_m5 (m : ℕ) (hm : 2 ≤ m) : ∀ i : Fin 2, 1 ≤ u_of_m5 m i.succ := by
  intro i
  fin_cases i
  · change 1 ≤ u_of_m5 m 1; dsimp [u_of_m5]; omega
  · change 1 ≤ u_of_m5 m 2; dsimp [u_of_m5]; omega

theorem rps_y_sum_0 : y_sum_uniform rpsRealizedClock.fc.clock 0 = 19 := by
  have h := y_sum_uniform_zero hw1 rpsRealizedClock.fc.clock
  rw [h]
  change 1 + ∑ i : Fin 3, C2 i ⟨0, by omega⟩ = 19
  rw [Fin.sum_univ_three]
  change 1 + (5 + 6 + 7 : ℚ) = 19
  norm_num

theorem rps_y_sum_1 : y_sum_uniform rpsRealizedClock.fc.clock ⟨1, by omega⟩ = 27 := by
  have h := y_sum_uniform_one hw2 rpsRealizedClock.fc.clock
  rw [h]
  change (∑ i : Fin 3, C2 i ⟨0, by omega⟩) + (∑ i : Fin 3, C2 i ⟨1, by omega⟩) = 27
  rw [Fin.sum_univ_three, Fin.sum_univ_three]
  change (5 + 6 + 7 : ℚ) + (3 + 3 + 3 : ℚ) = 27
  norm_num

theorem rps_y_sum_2 : y_sum_uniform rpsRealizedClock.fc.clock ⟨2, by omega⟩ = 9 := by
  have h := y_sum_uniform_top hw2 rpsRealizedClock.fc.clock
  have heq : (⟨2 - 1, by omega⟩ : Fin 2) = ⟨1, by omega⟩ := rfl
  rw [h, heq]
  change ∑ i : Fin 3, C2 i ⟨1, by omega⟩ = 9
  rw [Fin.sum_univ_three]
  change (3 + 3 + 3 : ℚ) = 9
  norm_num

theorem rps_hell_eq_uniform5 (m : ℕ) :
    let alpha : ℚ := 3 * (2 * (m : ℚ) + 1)
    ell_uniform_total hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) alpha =
      ell_uniform hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 alpha :=
  ell_uniform_total_eq_ell_uniform_of_CGC_zero hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) _ rps_full_rank_CGC_zero

theorem m_ge_two_of_ell_ge_two5 (m : ℕ)
    (h : 2 ≤ ell_uniform_total hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) (3 * (2 * (m : ℚ) + 1)) 1) :
    2 ≤ m := by
  rw [congr_fun (rps_hell_eq_uniform5 m) 1] at h
  change 2 ≤ (3 * (2 * (m : ℚ) + 1)) * zeta_canonical hw1 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 1 -
    y_sum_uniform rpsRealizedClock.fc.clock 1 at h
  have hz : zeta_canonical hw1 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 1 = 7 / 3 :=
    rps_zeta_canonical_four_thirds_one_H0 19
  have hy : y_sum_uniform rpsRealizedClock.fc.clock 1 = 27 := rps_y_sum_1
  rw [hz, hy] at h
  have h1 : (2 : ℚ) ≤ 14 * (m : ℚ) - 20 := by linarith
  have h2 : (22 / 14 : ℚ) ≤ (m : ℚ) := by linarith
  have : (1 : ℚ) < (22 / 14 : ℚ) := by norm_num
  have hlt : (1 : ℚ) < (m : ℚ) := by linarith
  have hm_gt1 : 1 < m := by exact_mod_cast hlt
  omega

theorem rps_hell_m5 (m : ℕ) (hm : 2 ≤ m) :
    let alpha : ℚ := 3 * (2 * (m : ℚ) + 1)
    ell_uniform_total hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) alpha =
      fun c => 2 * (u_of_m5 m c : ℚ) := by
  intro alpha
  rw [rps_hell_eq_uniform5]
  ext c
  fin_cases c
  · change alpha * zeta_canonical hw1 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 0 - y_sum_uniform rpsRealizedClock.fc.clock 0 = 2 * (u_of_m5 m 0 : ℚ)
    have hz : zeta_canonical hw1 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 0 = 19 := rfl
    rw [hz, rps_y_sum_0]
    dsimp [alpha, u_of_m5]
    push_cast
    ring
  · change alpha * zeta_canonical hw1 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 1 - y_sum_uniform rpsRealizedClock.fc.clock 1 = 2 * (u_of_m5 m 1 : ℚ)
    have hz : zeta_canonical hw1 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 1 = 7 / 3 :=
      rps_zeta_canonical_four_thirds_one_H0 19
    have hy1 : y_sum_uniform rpsRealizedClock.fc.clock 1 = 27 := rps_y_sum_1
    rw [hz, hy1]
    dsimp [alpha, u_of_m5]
    have : (10 : ℚ) ≤ 7 * (m : ℚ) := by
      have : 2 ≤ (m : ℚ) := by exact_mod_cast hm
      linarith
    rw [Nat.cast_sub (by omega)]
    push_cast
    ring
  · change alpha * zeta_canonical hw1 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 2 - y_sum_uniform rpsRealizedClock.fc.clock 2 = 2 * (u_of_m5 m 2 : ℚ)
    have hz : zeta_canonical hw1 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 2 = 1 :=
      rps_zeta_canonical_four_thirds_two_H0 19
    have hy2 : y_sum_uniform rpsRealizedClock.fc.clock 2 = 9 := rps_y_sum_2
    rw [hz, hy2]
    dsimp [alpha, u_of_m5]
    have : (3 : ℚ) ≤ 3 * (m : ℚ) := by
      have : 2 ≤ (m : ℚ) := by exact_mod_cast hm
      linarith
    rw [Nat.cast_sub (by omega)]
    push_cast
    ring

theorem a_old_rps_four_thirds_5_pos (x : Fin 4) : 0 < a_old_rps_four_thirds_H0 19 x := by
  dsimp [a_old_rps_four_thirds_H0]
  split
  · split_ifs <;> norm_num
  · norm_num

theorem rps_exists_eta5 :
    ∃ (m_alpha : ℕ) (eta : ℚ),
      let alpha : ℚ := 3 * (2 * (m_alpha : ℚ) + 1)
      let ell := ell_uniform_total hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) alpha
      let E := E_uniform_total hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) alpha
      let P := P_uniform_total_lower_eta hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) alpha eta rpsRealizedClock.fc.L_C (a_old_rps_four_thirds_H0 19)
      0 < eta ∧
      (2 * (2 + 1 : ℚ) ≤ ell 0) ∧
      (∀ c : Fin (2 + 1), 2 ≤ ell c) ∧
      (ell 0 / 2 - 2 ≠ 0) ∧
      (∀ j : Fin 2, ell j.succ ≠ 0) ∧
      (∀ a b_act : Fin (3 + 3), b_act.val < a.val → 0 < J_lower_eta 2 ell E eta a b_act) ∧
      (∀ (x : Fin 4) (j : Fin 3),
        a_old_rps_four_thirds_H0 19 x / 4 ≤ P x (finSumFinEquiv (Sum.inr j))) ∧
      (∀ (x : Fin 4) (i : Fin 3),
        P x (finSumFinEquiv (Sum.inl i)) ≤ - (a_old_rps_four_thirds_H0 19 x / 4)) := by
  have hzeta_pos : ∀ c, 0 < zeta_canonical (Nat.le_of_succ_le hw2) rpsRealizedClock.fc.clock b_rps (4 / 3) 19 c := by
    intro c; fin_cases c
    · change 0 < zeta_canonical hw1 rpsFullRankClock.clock b_rps_local (4 / 3) 19 0
      dsimp [zeta_canonical]; norm_num
    · change 0 < zeta_canonical hw1 rpsFullRankClock.clock b_rps_local (4 / 3) 19 1
      rw [rps_zeta_canonical_four_thirds_one_H0 19]; norm_num
    · change 0 < zeta_canonical hw1 rpsFullRankClock.clock b_rps_local (4 / 3) 19 2
      rw [rps_zeta_canonical_four_thirds_two_H0 19]; norm_num
  have hR : rpsRealizedClock.fc.clock.R b_rps ⟨2 - 1, by omega⟩ ≠ 0 := by
    change rpsFullRankClock.clock.R b_rps ⟨2 - 1, by omega⟩ ≠ 0
    rw [rps_R_top]; norm_num
  exact exists_odd_alpha_and_eta_for_uniform_total hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2)
    hzeta_pos (a_old_rps_four_thirds_H0 19) a_old_rps_four_thirds_5_pos (vecMul_a_old_rps_four_thirds_H0_X_gateway 19)
    rpsRealizedClock.fc.L_C hR

noncomputable def rps_m_alpha5 : ℕ := Classical.choose rps_exists_eta5
noncomputable def rps_eta5 : ℚ := Classical.choose (Classical.choose_spec rps_exists_eta5)
noncomputable def rps_spec5 := Classical.choose_spec (Classical.choose_spec rps_exists_eta5)

noncomputable def rps_alpha5 : ℚ := 3 * (2 * (rps_m_alpha5 : ℚ) + 1)
lemma rps_hm5 : 2 ≤ rps_m_alpha5 := m_ge_two_of_ell_ge_two5 rps_m_alpha5 (rps_spec5.2.2.1 1)
noncomputable def rps_u5 : Fin 3 → ℕ := u_of_m5 rps_m_alpha5

lemma rps_heta5 : 0 < rps_eta5 := rps_spec5.1
lemma rps_hu05 : 2 + 1 ≤ rps_u5 0 := hu0_of_m5 rps_m_alpha5 rps_hm5
lemma rps_hui5 : ∀ i : Fin 2, 1 ≤ rps_u5 i.succ := hui_of_m5 rps_m_alpha5 rps_hm5
theorem rps_hell5 : ell_uniform_total hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) rps_alpha5 =
    fun c => 2 * (rps_u5 c : ℚ) := rps_hell_m5 rps_m_alpha5 rps_hm5

theorem test_P_equality5 (m : ℕ) (hm : 2 ≤ m) (eta : ℚ) :
    let alpha : ℚ := 3 * (2 * (m : ℚ) + 1)
    let u := u_of_m5 m
    let ell := ell_uniform_total hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) alpha
    let E := E_uniform_total hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) alpha
    let P1 := P_uniform_total_lower_eta hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) alpha eta rpsRealizedClock.fc.L_C (a_old_rps_four_thirds_H0 19)
    let P2 := P_uniform_M hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) (M_lower_nat 2 u)
      (R_M_lower 2 (fun c => 2 * (u c : ℚ)))
      (J_lower_eta 2 (fun c => 2 * (u c : ℚ)) E eta)
      (zeta_canonical hw1 rpsRealizedClock.fc.clock b_rps (4 / 3) 19)
      (P0_cone_old (a_old_rps_four_thirds_H0 19) 2) rpsRealizedClock.fc.L_C
    (hell : ell = fun c => 2 * (u c : ℚ)) →
    P1 = P2 := by
  intro alpha u ell E P1 P2 hell
  change P_uniform_total_lower_eta hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) alpha eta rpsRealizedClock.fc.L_C (a_old_rps_four_thirds_H0 19) =
    P_uniform_M hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) (M_lower_nat 2 u)
      (R_M_lower 2 (fun c => 2 * (u c : ℚ)))
      (J_lower_eta 2 (fun c => 2 * (u c : ℚ)) E eta)
      (zeta_canonical hw1 rpsRealizedClock.fc.clock b_rps (4 / 3) 19)
      (P0_cone_old (a_old_rps_four_thirds_H0 19) 2) rpsRealizedClock.fc.L_C
  dsimp [P_uniform_total_lower_eta, P_uniform_M, P_uniform_interp]
  have hu0 : 2 ≤ u 0 := by dsimp [u, u_of_m5]; omega
  have hM := M_of_nat_M_lower_nat 2 u hu0
  have hell' : ell_uniform_total hw2 rpsRealizedClock.fc.clock b_rps (4 / 3) 19 (1 / 2) alpha = fun c => 2 * (u c : ℚ) := hell
  rw [hell', hM]

