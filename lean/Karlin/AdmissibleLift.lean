  have h0 : (fun i => fc.clock.R.mulVec (binomBasis w 0) i + 0) = fc.clock.R.mulVec (binomBasis w 0) := by
    ext i; ring
  rw [h0] at h_bundle_p
  have hG_diag : ∀ i : Fin fc.clock.m, fc.clock.G i i = 0 := fun i => skew_diag_zero fc.clock.hskew i
  have h_active_p := initial_score_le_active_wordScore_of_isValidPriorityWord fc.clock.G hG_diag
    (fc.clock.R.mulVec (binomBasis w 0)) parent_rank (W_bundle_word parentWord (q + 1)) h_bundle_p k hk_b b
