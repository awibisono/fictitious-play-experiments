import Mathlib.Algebra.Order.Floor.Defs
import Mathlib.Data.Nat.Choose.Basic
import Karlin.GatewayLift
import Karlin.AllOrdersComplete
import Karlin.ChronologyBounds

/-!
# Exact Paper-Faithful Admissible Clock Lift (`AdmissibleClock w`)

This module formalizes the exact paper-faithful Admissible Clock Lift (`AdmissibleClock w`),
eliminating the three algebraic shortcuts in `bundleLiftClock`:

1. **Shortcut A (Explicit Phase-Boundary Leader `b : Fin clock.m` & Rotated Equivalence)**:
   - Generalizes `adjoinGatewayEndpointG` to `AdjoinLeaderEndpointG` by taking an explicit
     phase-boundary leader action `b : Fin clock.m` instead of hardcoding action index `0`.
   - Proves skew-symmetry (`AdjoinLeaderEndpointG_skew`) and compatibility with `adjoinGatewayEndpointG`.

2. **Shortcut B (Ceiling-Matched Height Row `h_row` in `S_bundle`)**:
   - Implements the exact paper height row $h(c) = (\zeta B)_c - R_{b,c}$ matching the leader's
     ceiling in Section 5.1 (`eq:old`, equations (22)–(25)).
   - Evaluates the intermediate score table $S_{\mathrm{mid}} = S + G_O X$ at the end of Stage 2:
     - On parent leader $b$: $(S_{\mathrm{mid}})_{b,:} = \zeta - c_{\mathrm{gain}} \cdot e_0^\top$.
     - On gateway action $g$: $(S_{\mathrm{mid}})_{g,:} = \zeta - (c_{\mathrm{gain}} - \delta) \cdot e_0^\top$.
   - Proves top-column deficit vanishing (`D_paper_last_col_zero`) and $\delta$-independence (`D_paper_independent_of_delta`).

3. **Shortcut C (Cone-Calibrated Reference Coupling `P0_cone` and Lemma 7.2 Sign Bounds)**:
   - Constructs the cone-calibrated baseline coupling `P0_cone a_old w` with entries $\mp a_{\mathrm{old}}(x)$.
   - Proves the early/late reset projection identities (`P0_cone_transpose_mul_X_inl`, `P0_cone_transpose_mul_X_inr`).
   - Proves the key Section 7.2 recombination identity (`P_interp_recombination`).
   - Proves the explicit perturbation sign lemma (`P_interp_waiting_margins`), establishing strict
     negative early columns, strict positive late columns, and the Stage 1 waiting margin $\epsilon_{\mathrm{wait}}$.
-/

namespace Karlin

open scoped BigOperators

/-!
## 1. Explicit Leader Gateway Matrix and Algebraic Properties
-/

/-- The $(m + 1) \times (m + 1)$ skew-symmetric gateway endpoint payoff matrix $G_O$
    from Section 5.1 (`eq:old`), setting row $g = \text{Sum.inr } 0$ to $G_{b,:} + v$
    against parent actions, where $b : \text{Fin } m$ is the explicit phase-boundary leader. -/
def AdjoinLeaderEndpointG {m : ℕ} (G : Matrix (Fin m) (Fin m) ℚ) (b : Fin m) (v : Fin m → ℚ) :
    Matrix (Fin (m + 1)) (Fin (m + 1)) ℚ :=
  let b_val : Fin m → ℚ := fun j => G b j
  Matrix.of fun x y =>
    match finSumFinEquiv.symm x, finSumFinEquiv.symm y with
    | Sum.inl i, Sum.inl j => G i j
    | Sum.inl i, Sum.inr _ => -(b_val i + v i)
    | Sum.inr _, Sum.inl j => b_val j + v j
    | Sum.inr _, Sum.inr _ => 0

/-- Skew-symmetry of `AdjoinLeaderEndpointG`. -/
theorem AdjoinLeaderEndpointG_skew {m : ℕ} (G : Matrix (Fin m) (Fin m) ℚ) (b : Fin m) (v : Fin m → ℚ)
    (hG : IsSkewSymmetric G) :
    IsSkewSymmetric (AdjoinLeaderEndpointG G b v) := by
  intro x y
  simp only [AdjoinLeaderEndpointG, Matrix.of_apply]
  cases finSumFinEquiv.symm x <;> cases finSumFinEquiv.symm y
  · exact hG _ _
  · simp
  · simp
  · simp

/-- Diagonal vanishing of `AdjoinLeaderEndpointG`. -/
theorem AdjoinLeaderEndpointG_diag_zero {m : ℕ} (G : Matrix (Fin m) (Fin m) ℚ) (b : Fin m) (v : Fin m → ℚ)
    (hG : IsSkewSymmetric G) (x : Fin (m + 1)) :
    AdjoinLeaderEndpointG G b v x x = 0 :=
  skew_diag_zero (AdjoinLeaderEndpointG_skew G b v hG) x

/-- Specialization to leader index 0 coincides with `adjoinGatewayEndpointG`. -/
theorem AdjoinLeaderEndpointG_eq_adjoinGatewayEndpointG {m : ℕ} (hm : 0 < m)
    (G : Matrix (Fin m) (Fin m) ℚ) (v : Fin m → ℚ) :
    AdjoinLeaderEndpointG G ⟨0, hm⟩ v = adjoinGatewayEndpointG G v := by
  ext x y
  simp only [AdjoinLeaderEndpointG, adjoinGatewayEndpointG, Matrix.of_apply]
  cases finSumFinEquiv.symm x <;> cases finSumFinEquiv.symm y <;> simp [hm]

/-- Payoff entry in endpoint row $g$ against parent action $j$. -/
theorem leader_endpoint_row {m : ℕ} (G : Matrix (Fin m) (Fin m) ℚ) (b : Fin m) (v : Fin m → ℚ) (j : Fin m) :
    AdjoinLeaderEndpointG G b v (finSumFinEquiv (Sum.inr (0 : Fin 1))) (finSumFinEquiv (Sum.inl j)) =
      G b j + v j := by
  simp [AdjoinLeaderEndpointG]

/-- Payoff entry in parent row $i$ against endpoint action $g$. -/
theorem leader_endpoint_col {m : ℕ} (G : Matrix (Fin m) (Fin m) ℚ) (b : Fin m) (v : Fin m → ℚ) (i : Fin m) :
    AdjoinLeaderEndpointG G b v (finSumFinEquiv (Sum.inl i)) (finSumFinEquiv (Sum.inr (0 : Fin 1))) =
      -(G b i + v i) := by
  simp [AdjoinLeaderEndpointG]

/-!
## 2. Ceiling-Matched Score Tables and Endpoint Identities
-/

/-- The paper height row matching the leader's ceiling in Section 5.1 (eq. (22)–(25)). -/
def h_row_paper {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (zeta : Fin (w + 1) → ℚ) :
    Fin (w + 1) → ℚ :=
  fun c => (Matrix.vecMul zeta (B_mat (w + 1))) c - shiftRightCount clock.R b c

/-- The paper old-and-endpoint score table `S_paper`. -/
def S_paper {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (zeta : Fin (w + 1) → ℚ) (delta : ℚ) :
    Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ :=
  Matrix.of fun x c =>
    match finSumFinEquiv.symm x with
    | Sum.inl i => shiftRightCount clock.R i c + h_row_paper clock b zeta c
    | Sum.inr _ => (Matrix.vecMul zeta (B_mat (w + 1))) c - e1_row (w + 1) c + (if c.val = 0 then delta else 0)

/-- Row `Sum.inl b` of `S_paper` matches the backward ceiling `zeta * B_mat` exactly. -/
theorem S_paper_inl_b {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (zeta : Fin (w + 1) → ℚ)
    (delta : ℚ) (c : Fin (w + 1)) :
    S_paper clock b zeta delta (finSumFinEquiv (Sum.inl b)) c =
      (Matrix.vecMul zeta (B_mat (w + 1))) c := by
  simp [S_paper, h_row_paper]

/-- Mid-phase score table `S_mid_paper = S_paper + G_O * X` at the end of Stage 2. -/
def S_mid_paper {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (zeta : Fin (w + 1) → ℚ) (delta : ℚ) :
    Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ :=
  S_paper clock b zeta delta + AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock

/-- Action of `G_O * X` on parent rows `Sum.inl i`. -/
theorem GO_mul_X_inl_apply {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (i : Fin clock.m) (c : Fin (w + 1)) :
    (AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock) (finSumFinEquiv (Sum.inl i)) c =
      (clock.G * shiftRightCount clock.C) i c - (clock.G b i + clock.v i) * e0_row (w + 1) c := by
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) =>
      AdjoinLeaderEndpointG clock.G b clock.v (finSumFinEquiv (Sum.inl i)) y * X_gateway clock y c).symm
  rw [Matrix.mul_apply, hcomp, Fintype.sum_sum_type]
  have h_inr : (∑ j : Fin 1, AdjoinLeaderEndpointG clock.G b clock.v (finSumFinEquiv (Sum.inl i)) (finSumFinEquiv (Sum.inr j)) *
      X_gateway clock (finSumFinEquiv (Sum.inr j)) c) =
      -(clock.G b i + clock.v i) * e0_row (w + 1) c := by
    simp [AdjoinLeaderEndpointG, X_gateway, X_coupled]
  have h_inl : (∑ j : Fin clock.m, AdjoinLeaderEndpointG clock.G b clock.v (finSumFinEquiv (Sum.inl i)) (finSumFinEquiv (Sum.inl j)) *
      X_gateway clock (finSumFinEquiv (Sum.inl j)) c) =
      (clock.G * shiftRightCount clock.C) i c := by
    simp [AdjoinLeaderEndpointG, X_gateway, X_coupled, Matrix.mul_apply]
  rw [h_inl, h_inr]
  ring

/-- Action of `G_O * X` on endpoint row `Sum.inr 0`. -/
theorem GO_mul_X_inr_apply {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (c : Fin (w + 1)) :
    (AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock) (finSumFinEquiv (Sum.inr (0 : Fin 1))) c =
      (clock.G * shiftRightCount clock.C) b c + e1_row (w + 1) c := by
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) =>
      AdjoinLeaderEndpointG clock.G b clock.v (finSumFinEquiv (Sum.inr 0)) y * X_gateway clock y c).symm
  rw [Matrix.mul_apply, hcomp, Fintype.sum_sum_type]
  have h_inr : (∑ j : Fin 1, AdjoinLeaderEndpointG clock.G b clock.v (finSumFinEquiv (Sum.inr 0)) (finSumFinEquiv (Sum.inr j)) *
      X_gateway clock (finSumFinEquiv (Sum.inr j)) c) = 0 := by
    simp [AdjoinLeaderEndpointG]
  have h_inl : (∑ j : Fin clock.m, AdjoinLeaderEndpointG clock.G b clock.v (finSumFinEquiv (Sum.inr 0)) (finSumFinEquiv (Sum.inl j)) *
      X_gateway clock (finSumFinEquiv (Sum.inl j)) c) =
      (clock.G * shiftRightCount clock.C) b c + e1_row (w + 1) c := by
    simp only [AdjoinLeaderEndpointG, X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply]
    simp_rw [add_mul]
    rw [Finset.sum_add_distrib]
    congr 1
    by_cases hc0 : c.val = 0
    · have he1 : e1_row (w + 1) c = 0 := by simp [e1_row, hc0]
      have hshift0 : ∀ j : Fin clock.m, shiftRightCount clock.C j c = 0 := by
        intro j
        dsimp [shiftRightCount]
        rw [dif_neg (by omega)]
      simp [he1, hshift0]
    · have hc_pos : 0 < c.val := by omega
      let d : Fin w := ⟨c.val - 1, by omega⟩
      have hshift : ∀ j : Fin clock.m, shiftRightCount clock.C j c = clock.C j d := by
        intro j
        dsimp [shiftRightCount]
        rw [dif_pos hc_pos]
      simp_rw [hshift]
      have hvec : (∑ j : Fin clock.m, clock.v j * clock.C j d) = (Matrix.vecMul clock.v clock.C) d := rfl
      rw [hvec, clock.hvC]
      simp only [e0_row, e1_row]
      have heq : (c.val = 1) ↔ (d.val = 0) := by
        dsimp [d]
        omega
      split_ifs with h1 h2
      · rfl
      · omega
      · omega
      · rfl
  rw [h_inl, h_inr, add_zero]

/-- Shift-right table vanishes at column 0. -/
theorem shiftRightCount_zero {α : Type*} [Fintype α] {w : ℕ} (M : Matrix α (Fin w) ℚ)
    (i : α) (c : Fin (w + 1)) (hc0 : c.val = 0) :
    shiftRightCount M i c = 0 := by
  dsimp [shiftRightCount]
  rw [dif_neg (by omega)]

/-- Matrix multiplication by shift-right table vanishes at column 0. -/
theorem mul_shiftRightCount_zero {m w : ℕ} (A : Matrix (Fin m) (Fin m) ℚ)
    (C : Matrix (Fin m) (Fin w) ℚ) (i : Fin m) (c : Fin (w + 1)) (hc0 : c.val = 0) :
    (A * shiftRightCount C) i c = 0 := by
  simp only [Matrix.mul_apply]
  have h0 : ∀ j : Fin m, shiftRightCount C j c = 0 := fun j => shiftRightCount_zero C j c hc0
  simp [h0]

/-- **Parent Leader Intermediate Score Identity (Lemma 5.3, eq. (29))**:
    At the end of Stage 2, parent leader $b$ attains score $\zeta - c_{\mathrm{gain}} \cdot e_0^\top$. -/
theorem S_mid_paper_inl_b {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (zeta : Fin (w + 1) → ℚ) (delta : ℚ) (c_gain : ℚ)
    (hvb : clock.v b = 0)
    (h_gain : Matrix.vecMul zeta (1 - B_mat (w + 1)) =
      (shiftRightCount clock.R * N_mat (w + 1)) b - (clock.R b ⟨0, hw⟩) • e0_row (w + 1) + c_gain • e0_row (w + 1)) :
    (fun c => S_mid_paper clock b zeta delta (finSumFinEquiv (Sum.inl b)) c) =
      fun c => zeta c - c_gain * e0_row (w + 1) c := by
  ext c
  dsimp only [S_mid_paper]
  rw [Matrix.add_apply, S_paper_inl_b, GO_mul_X_inl_apply]
  have hskew : clock.G b b = 0 := skew_diag_zero clock.hskew b
  rw [hskew, hvb, add_zero, zero_mul, sub_zero]
  have hGC : (clock.G * shiftRightCount clock.C) b c =
      (shiftRightCount clock.R * N_mat (w + 1)) b c - (clock.R b ⟨0, hw⟩) * e0_row (w + 1) c := by
    by_cases hc0 : c.val = 0
    · have he0 : e0_row (w + 1) c = 1 := by simp [e0_row, hc0]
      have hGC0 : (clock.G * shiftRightCount clock.C) b c = 0 :=
        mul_shiftRightCount_zero clock.G clock.C b c hc0
      have hRN0 : (shiftRightCount clock.R * N_mat (w + 1)) b c = clock.R b ⟨0, hw⟩ := by
        rw [shiftRightCount_R_mul_N_mat hw clock b c]
        simp [hc0]
      rw [he0, hGC0, hRN0]
      ring
    · have he0 : e0_row (w + 1) c = 0 := by simp [e0_row, hc0]
      rw [he0, mul_zero, sub_zero]
      have hRN : (shiftRightCount clock.R * N_mat (w + 1)) b c = (clock.G * shiftRightCount clock.C) b c := by
        rw [shiftRightCount_R_mul_N_mat hw clock b c]
        simp [hc0]
      exact hRN.symm
  rw [hGC]
  have h_gain_c := congr_fun h_gain c
  rw [Matrix.vecMul_sub, Matrix.vecMul_one] at h_gain_c
  simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul] at h_gain_c
  linarith

/-- **Endpoint Action Intermediate Score Identity (Lemma 5.3, eq. (29))**:
    At the end of Stage 2, endpoint action $g$ attains score $\zeta - (c_{\mathrm{gain}} - \delta) \cdot e_0^\top$. -/
theorem S_mid_paper_inr_0 {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (zeta : Fin (w + 1) → ℚ) (delta : ℚ) (c_gain : ℚ)
    (h_gain : Matrix.vecMul zeta (1 - B_mat (w + 1)) =
      (shiftRightCount clock.R * N_mat (w + 1)) b - (clock.R b ⟨0, hw⟩) • e0_row (w + 1) + c_gain • e0_row (w + 1)) :
    (fun c => S_mid_paper clock b zeta delta (finSumFinEquiv (Sum.inr 0)) c) =
      fun c => zeta c - (c_gain - delta) * e0_row (w + 1) c := by
  ext c
  dsimp only [S_mid_paper, S_paper]
  rw [Matrix.add_apply, Matrix.of_apply]
  simp only [Equiv.symm_apply_apply]
  rw [GO_mul_X_inr_apply]
  have hGC : (clock.G * shiftRightCount clock.C) b c =
      (shiftRightCount clock.R * N_mat (w + 1)) b c - (clock.R b ⟨0, hw⟩) * e0_row (w + 1) c := by
    by_cases hc0 : c.val = 0
    · have he0 : e0_row (w + 1) c = 1 := by simp [e0_row, hc0]
      have hGC0 : (clock.G * shiftRightCount clock.C) b c = 0 :=
        mul_shiftRightCount_zero clock.G clock.C b c hc0
      have hRN0 : (shiftRightCount clock.R * N_mat (w + 1)) b c = clock.R b ⟨0, hw⟩ := by
        rw [shiftRightCount_R_mul_N_mat hw clock b c]
        simp [hc0]
      rw [he0, hGC0, hRN0]
      ring
    · have he0 : e0_row (w + 1) c = 0 := by simp [e0_row, hc0]
      rw [he0, mul_zero, sub_zero]
      have hRN : (shiftRightCount clock.R * N_mat (w + 1)) b c = (clock.G * shiftRightCount clock.C) b c := by
        rw [shiftRightCount_R_mul_N_mat hw clock b c]
        simp [hc0]
      exact hRN.symm
  rw [hGC]
  have h_gain_c := congr_fun h_gain c
  rw [Matrix.vecMul_sub, Matrix.vecMul_one] at h_gain_c
  simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul] at h_gain_c
  have he0_split : (if c.val = 0 then delta else 0) = delta * e0_row (w + 1) c := by
    by_cases hc0 : c.val = 0
    · simp [e0_row, hc0]
    · simp [e0_row, hc0]
  rw [he0_split]
  linarith

/-- Paper deficit table `D_paper = S_paper * N - G_O * X`. -/
def D_paper {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (zeta : Fin (w + 1) → ℚ) (delta : ℚ) :
    Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ :=
  S_paper clock b zeta delta * N_mat (w + 1) - AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock

/-- Vanishing of top-degree column of `D_paper` (`lem:gateway`, Lemma 5.3). -/
theorem D_paper_last_col_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (zeta : Fin (w + 1) → ℚ) (delta : ℚ) (x : Fin (clock.m + 1)) :
    D_paper clock b zeta delta x ⟨w, Nat.lt_succ_self w⟩ = 0 := by
  dsimp only [D_paper]
  simp only [Matrix.sub_apply]
  rw [mul_N_mat_last_col_zero]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) =>
      AdjoinLeaderEndpointG clock.G b clock.v x y * X_gateway clock y ⟨w, Nat.lt_succ_self w⟩).symm
  rw [Matrix.mul_apply, hcomp, Fintype.sum_sum_type]
  have he0_top : e0_row (w + 1) ⟨w, Nat.lt_succ_self w⟩ = 0 := by
    simp only [e0_row]
    split_ifs with h
    · omega
    · rfl
  have hX_inr : ∀ j : Fin 1, X_gateway clock (finSumFinEquiv (Sum.inr j)) ⟨w, Nat.lt_succ_self w⟩ = 0 := by
    intro j
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, he0_top]
  simp only [hX_inr, mul_zero, Finset.sum_const_zero, add_zero]
  have hX_inl : ∀ j : Fin clock.m,
      X_gateway clock (finSumFinEquiv (Sum.inl j)) ⟨w, Nat.lt_succ_self w⟩ = clock.C j ⟨w - 1, by omega⟩ := by
    intro j
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, shiftRightCount]
    have hw_pos : 0 < w := by omega
    simp [hw_pos]
  simp_rw [hX_inl]
  cases hsym : finSumFinEquiv.symm x with
  | inl i =>
    have hG_inl : ∀ j : Fin clock.m,
        AdjoinLeaderEndpointG clock.G b clock.v x (finSumFinEquiv (Sum.inl j)) = clock.G i j := by
      intro j
      simp [AdjoinLeaderEndpointG, hsym]
    simp_rw [hG_inl]
    have hGC : (∑ j : Fin clock.m, clock.G i j * clock.C j ⟨w - 1, by omega⟩) =
        (clock.G * clock.C) i ⟨w - 1, by omega⟩ := rfl
    rw [hGC, clock.hclock, mul_N_mat_apply]
    have hnot : ¬ (w - 1 + 1 < w) := by omega
    simp [hnot]
  | inr _ =>
    have hG_inr : ∀ j : Fin clock.m,
        AdjoinLeaderEndpointG clock.G b clock.v x (finSumFinEquiv (Sum.inl j)) = clock.G b j + clock.v j := by
      intro j
      simp [AdjoinLeaderEndpointG, hsym]
    simp_rw [hG_inr]
    simp_rw [add_mul]
    rw [Finset.sum_add_distrib]
    have hGC : (∑ j : Fin clock.m, clock.G b j * clock.C j ⟨w - 1, by omega⟩) =
        (clock.G * clock.C) b ⟨w - 1, by omega⟩ := rfl
    have hvC : (∑ j : Fin clock.m, clock.v j * clock.C j ⟨w - 1, by omega⟩) =
        (Matrix.vecMul clock.v clock.C) ⟨w - 1, by omega⟩ := rfl
    rw [hGC, hvC, clock.hclock, clock.hvC, mul_N_mat_apply]
    have hnot : ¬ (w - 1 + 1 < w) := by omega
    have he0_last : e0_row w ⟨w - 1, by omega⟩ = 0 := by
      simp only [e0_row]
      split_ifs with h
      · omega
      · rfl
    simp [hnot, he0_last]

/-- Independence of `D_paper` from `delta`. -/
theorem D_paper_independent_of_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (zeta : Fin (w + 1) → ℚ) (delta : ℚ) :
    D_paper clock b zeta delta = D_paper clock b zeta 0 := by
  ext x c
  simp only [D_paper, Matrix.sub_apply]
  congr 1
  rw [mul_N_mat_apply, mul_N_mat_apply]
  by_cases hd : c.val + 1 < w + 1
  · simp only [hd, ↓reduceDIte, S_paper, Matrix.of_apply]
    cases finSumFinEquiv.symm x with
    | inl i => rfl
    | inr _ =>
      have hc : ¬ (c.val + 1 = 0) := by omega
      simp only [hc, ↓reduceIte, add_zero]
  · simp only [hd, ↓reduceDIte]

/-!
## 3. Cone-Calibrated Reference Coupling and Lemma 7.2 Margins
-/

/-- Cone-calibrated reference coupling `P0_cone` from Section 7.2 of the paper. -/
def P0_cone {m : ℕ} (a_old : Fin (m + 1) → ℚ) (w : ℕ) :
    Matrix (Fin (m + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  Matrix.of fun x j =>
    match finSumFinEquiv.symm j with
    | Sum.inl _ => - a_old x
    | Sum.inr _ => a_old x

/-- Early reset projection of `P0_cone`: gives `- z_target`. -/
theorem P0_cone_transpose_mul_X_inl {w : ℕ} (clock : AlgebraicClock w)
    (a_old : Fin (clock.m + 1) → ℚ) (z_target : Fin (w + 1) → ℚ)
    (hz : Matrix.vecMul a_old (X_gateway clock) = z_target)
    (j : Fin (w + 1)) (c : Fin (w + 1)) :
    ((P0_cone a_old w).transpose * X_gateway clock) (finSumFinEquiv (Sum.inl j)) c = - z_target c := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply, P0_cone, Matrix.of_apply, Equiv.symm_apply_apply]
  have hneg : (∑ i : Fin (clock.m + 1), -a_old i * X_gateway clock i c) =
      - ∑ i : Fin (clock.m + 1), a_old i * X_gateway clock i c := by
    rw [← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [hneg]
  have hz_c := congr_fun hz c
  simp only [Matrix.vecMul, dotProduct] at hz_c
  rw [hz_c]

/-- Late reset projection of `P0_cone`: gives `+ z_target`. -/
theorem P0_cone_transpose_mul_X_inr {w : ℕ} (clock : AlgebraicClock w)
    (a_old : Fin (clock.m + 1) → ℚ) (z_target : Fin (w + 1) → ℚ)
    (hz : Matrix.vecMul a_old (X_gateway clock) = z_target)
    (j : Fin (w + 1)) (c : Fin (w + 1)) :
    ((P0_cone a_old w).transpose * X_gateway clock) (finSumFinEquiv (Sum.inr j)) c = z_target c := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply, P0_cone, Matrix.of_apply, Equiv.symm_apply_apply]
  have hz_c := congr_fun hz c
  simp only [Matrix.vecMul, dotProduct] at hz_c
  rw [hz_c]

/-- Recombination identity for interpolated coupling matrix `P_interp` (Section 7.2). -/
theorem P_interp_recombination {m n w : Type*} [Fintype m] [Fintype n] [Fintype w]
    (X L_X : Matrix m w ℚ) (M : Matrix n w ℚ) (R_M : Matrix w n ℚ)
    (D : Matrix m w ℚ) (QR : Matrix n w ℚ) (P0 : Matrix m n ℚ) :
    let DR := D - P0 * M
    let Q := P0.transpose * X + QR
    P_interp X L_X M R_M D Q P0 = P0 + DR * R_M + L_X * (QR.transpose - X.transpose * DR * R_M) := by
  intro DR Q
  dsimp only [P_interp, D_res, Q_res, DR, Q]
  have hQ : P0.transpose * X + QR - P0.transpose * X = QR := by
    ext i j
    simp
  rw [hQ]

/-- Explicit perturbation sign bounds and waiting margins (Lemma 7.2 & Section 9.1). -/
theorem P_interp_waiting_margins {m w : ℕ} (a_old : Fin (m + 1) → ℚ)
    (ha_pos : ∀ x, 0 < a_old x)
    (P : Matrix (Fin (m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (eps_P : ℚ)
    (h_near : ∀ x j, |P x j - P0_cone a_old w x j| < eps_P)
    (x : Fin (m + 1)) (j_early : Fin (w + 1)) (j_late : Fin (w + 1))
    (heps_half : eps_P ≤ a_old x / 2) :
    P x (finSumFinEquiv (Sum.inl j_early)) < - a_old x / 2 ∧
    - a_old x / 2 < 0 ∧
    a_old x / 2 < P x (finSumFinEquiv (Sum.inr j_late)) ∧
    0 < a_old x / 2 ∧
    (∀ eps_wait : ℚ, eps_P < a_old x - eps_wait →
      eps_wait < - P x (finSumFinEquiv (Sum.inl j_early))) := by
  have h_ax := ha_pos x
  have h_bound_early := h_near x (finSumFinEquiv (Sum.inl j_early))
  simp only [P0_cone, Matrix.of_apply, Equiv.symm_apply_apply] at h_bound_early
  rw [abs_lt] at h_bound_early
  have h_bound_late := h_near x (finSumFinEquiv (Sum.inr j_late))
  simp only [P0_cone, Matrix.of_apply, Equiv.symm_apply_apply] at h_bound_late
  rw [abs_lt] at h_bound_late
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · linarith
  · linarith
  · linarith
  · linarith
  · intro eps_wait hwait
    linarith

/-!
## 4. Rotated Leader Equivalence (Fixing Shortcut A Across Recursive Lifts)
-/

/-- Rotated leader equivalence mapping the first reset action `Sum.inr 0` to coordinate 0 of the lifted clock. -/
def rotLeaderEquiv (m1 n_reset : ℕ) :
    Fin m1 ⊕ Fin n_reset ≃ Fin (m1 + n_reset) :=
  if h : 0 < m1 ∧ 0 < n_reset then
    finSumFinEquiv.trans (Equiv.swap ⟨0, by omega⟩ (finSumFinEquiv (Sum.inr ⟨0, h.2⟩)))
  else
    finSumFinEquiv

/-- Forward evaluation of `rotLeaderEquiv` on `Sum.inr 0` lands at coordinate `0`. -/
theorem rotLeaderEquiv_inr_zero {m1 n_reset : ℕ} (hm : 0 < m1) (hn : 0 < n_reset) :
    rotLeaderEquiv m1 n_reset (Sum.inr ⟨0, hn⟩) = ⟨0, by omega⟩ := by
  unfold rotLeaderEquiv
  have h : 0 < m1 ∧ 0 < n_reset := ⟨hm, hn⟩
  rw [dif_pos h]
  simp only [Equiv.trans_apply]
  exact Equiv.swap_apply_right ⟨0, by omega⟩ (finSumFinEquiv (Sum.inr ⟨0, hn⟩))

/-- Inverse evaluation of `rotLeaderEquiv` on coordinate `0` recovers `Sum.inr 0`. -/
theorem rotLeaderEquiv_symm_zero {m1 n_reset : ℕ} (hm : 0 < m1) (hn : 0 < n_reset) :
    (rotLeaderEquiv m1 n_reset).symm ⟨0, by omega⟩ = Sum.inr ⟨0, hn⟩ := by
  have h := rotLeaderEquiv_inr_zero hm hn
  exact (Equiv.symm_apply_eq _).mpr h.symm

/-- Row 0 of the rotated lifted score table matches the exact ceiling `zeta`. -/
theorem rotLeaderEquiv_scoreMat_row_zero {w : ℕ} (clock : AlgebraicClock w)
    (G_O : Matrix (Fin (clock.m + 1)) (Fin (clock.m + 1)) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (S : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (X : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (M : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (hJ_zero : ∀ b : Fin ((w + 1) + (w + 1)), J ⟨0, by omega⟩ b = 0) (c : Fin (w + 1)) :
    (Matrix.of fun x c => liftedScoreMat G_O J S X M zeta
      ((rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))).symm x) c) ⟨0, by omega⟩ c = zeta c := by
  simp only [Matrix.of_apply]
  have hm : 0 < clock.m + 1 := by omega
  have hn : 0 < (w + 1) + (w + 1) := by omega
  rw [rotLeaderEquiv_symm_zero hm hn]
  dsimp only [liftedScoreMat]
  simp only [Matrix.of_apply, Matrix.sub_apply, one_zeta, Matrix.mul_apply]
  have hsum : (∑ ℓ : Fin ((w + 1) + (w + 1)), J ⟨0, by omega⟩ ℓ * M ℓ c) = 0 := by
    rw [Finset.sum_congr rfl (fun ℓ _ => by rw [hJ_zero ℓ, zero_mul])]
    exact Finset.sum_const_zero
  rw [hsum, sub_zero]

/-!
## 5. Complete Admissible Clock Lift
### 5A. Linear Height Row and Admissible Bundle Lift
-/

/-- Width-(w+1) linear height row $h_{\mathrm{row}} = H_0 \cdot e_0^\top + c_h \cdot e_1^\top$. -/
def h_row_lin (w : ℕ) (H0 ch : ℚ) : Fin (w + 1) → ℚ :=
  H0 • e0_row (w + 1) + ch • e1_row (w + 1)

/-- Action of $N$ on $e_1^\top$ yields $e_0^\top$. -/
theorem e1_row_mul_N_mat {w : ℕ} (hw : 1 ≤ w) :
    Matrix.vecMul (e1_row (w + 1)) (N_mat (w + 1)) = e0_row (w + 1) := by
  ext c
  simp only [Matrix.vecMul, dotProduct, e1_row, N_mat, Matrix.of_apply, e0_row]
  rw [Finset.sum_eq_single ⟨1, by omega⟩]
  · by_cases hc : c.val = 0
    · simp [hc]
    · have hne : ¬ (1 = c.val + 1) := by omega
      rw [if_neg hc, if_neg hne]
      ring
  · intro j _ hj
    have hne : j.val ≠ 1 := by
      intro h
      apply hj
      ext; exact h
    simp [hne]
  · intro h
    exact False.elim (h (Finset.mem_univ _))

/-- Right-multiplication of $h_{\mathrm{row\_lin}}$ by $N$ produces $c_h \cdot e_0^\top$. -/
theorem h_row_lin_mul_N_mat {w : ℕ} (hw : 1 ≤ w) (H0 ch : ℚ) :
    Matrix.vecMul (h_row_lin w H0 ch) (N_mat (w + 1)) = ch • e0_row (w + 1) := by
  unfold h_row_lin
  rw [Matrix.add_vecMul, Matrix.smul_vecMul, Matrix.smul_vecMul, e0_row_mul_N_mat, smul_zero, zero_add]
  rw [e1_row_mul_N_mat hw]

/-- Vanishing of $(h_{\mathrm{row\_lin}} N)_r$ on all positive coordinates $r > 0$. -/
theorem h_row_lin_mul_N_mat_pos {w : ℕ} (hw : 1 ≤ w) (H0 ch : ℚ) (r : Fin (w + 1)) (hr : 0 < r.val) :
    Matrix.vecMul (h_row_lin w H0 ch) (N_mat (w + 1)) r = 0 := by
  rw [h_row_lin_mul_N_mat hw]
  simp only [Pi.smul_apply, smul_eq_mul, e0_row]
  have hne : ¬ (r.val = 0) := by omega
  simp [hne]

/-- Admissible old-and-endpoint score table using explicit leader $b$ and linear height row. -/
def S_admissible {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (H0 ch delta : ℚ) :
    Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ :=
  Matrix.of fun x c =>
    match finSumFinEquiv.symm x with
    | Sum.inl i => shiftRightCount clock.R i c + h_row_lin w H0 ch c
    | Sum.inr _ =>
      shiftRightCount clock.R b c + h_row_lin w H0 ch c - e1_row (w + 1) c +
        (if c.val = 0 then delta else 0)

/-- Deficit matrix for the admissible lift: $D = S N - G_O X$. -/
def D_admissible {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (H0 ch delta : ℚ) :
    Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ :=
  S_admissible clock b H0 ch delta * N_mat (w + 1) -
    AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock

/-- Vanishing of $D_{\mathrm{admissible}}$ on parent actions for $r > 0$. -/
theorem D_admissible_inl_eq_zero_of_pos {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (i : Fin clock.m) (r : Fin (w + 1)) (hr : 0 < r.val) :
    D_admissible clock b H0 ch delta (finSumFinEquiv (Sum.inl i)) r = 0 := by
  dsimp only [D_admissible]
  simp only [Matrix.sub_apply]
  rw [GO_mul_X_inl_apply]
  have he0 : e0_row (w + 1) r = 0 := by
    simp only [e0_row]
    have hne : ¬ (r.val = 0) := by omega
    rw [if_neg hne]
  rw [he0, mul_zero, sub_zero]
  have hsum : (S_admissible clock b H0 ch delta * N_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) r =
      (shiftRightCount clock.R * N_mat (w + 1)) i r + Matrix.vecMul (h_row_lin w H0 ch) (N_mat (w + 1)) r := by
    simp only [Matrix.mul_apply, Matrix.vecMul, dotProduct, S_admissible, Matrix.of_apply, Equiv.symm_apply_apply, add_mul]
    rw [Finset.sum_add_distrib]
  rw [hsum]
  rw [h_row_lin_mul_N_mat_pos hw H0 ch r hr, add_zero]
  rw [shiftRightCount_R_mul_N_mat hw clock i r]
  have hr_ne : ¬ (r.val = 0) := by omega
  rw [if_neg hr_ne]
  ring

/-- Vanishing of top-degree column of $D_{\mathrm{admissible}}$. -/
theorem D_admissible_last_col_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (x : Fin (clock.m + 1)) :
    D_admissible clock b H0 ch delta x ⟨w, Nat.lt_succ_self w⟩ = 0 := by
  dsimp only [D_admissible]
  simp only [Matrix.sub_apply]
  rw [mul_N_mat_last_col_zero]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) =>
      AdjoinLeaderEndpointG clock.G b clock.v x y * X_gateway clock y ⟨w, Nat.lt_succ_self w⟩).symm
  rw [Matrix.mul_apply, hcomp, Fintype.sum_sum_type]
  have he0_top : e0_row (w + 1) ⟨w, Nat.lt_succ_self w⟩ = 0 := by
    simp only [e0_row]
    split_ifs with h
    · omega
    · rfl
  have hX_inr : ∀ j : Fin 1, X_gateway clock (finSumFinEquiv (Sum.inr j)) ⟨w, Nat.lt_succ_self w⟩ = 0 := by
    intro j
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, he0_top]
  simp only [hX_inr, mul_zero, Finset.sum_const_zero, add_zero]
  have hX_inl : ∀ j : Fin clock.m,
      X_gateway clock (finSumFinEquiv (Sum.inl j)) ⟨w, Nat.lt_succ_self w⟩ = clock.C j ⟨w - 1, by omega⟩ := by
    intro j
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, shiftRightCount]
    have hw_pos : 0 < w := by omega
    simp [hw_pos]
  simp_rw [hX_inl]
  cases hsym : finSumFinEquiv.symm x with
  | inl i =>
    have hG_inl : ∀ j : Fin clock.m,
        AdjoinLeaderEndpointG clock.G b clock.v x (finSumFinEquiv (Sum.inl j)) = clock.G i j := by
      intro j
      simp [AdjoinLeaderEndpointG, hsym]
    simp_rw [hG_inl]
    have hGC : (∑ j : Fin clock.m, clock.G i j * clock.C j ⟨w - 1, by omega⟩) =
        (clock.G * clock.C) i ⟨w - 1, by omega⟩ := rfl
    rw [hGC, clock.hclock, mul_N_mat_apply]
    have hnot : ¬ (w - 1 + 1 < w) := by omega
    simp [hnot]
  | inr _ =>
    have hG_inr : ∀ j : Fin clock.m,
        AdjoinLeaderEndpointG clock.G b clock.v x (finSumFinEquiv (Sum.inl j)) = clock.G b j + clock.v j := by
      intro j
      simp [AdjoinLeaderEndpointG, hsym]
    simp_rw [hG_inr]
    simp_rw [add_mul]
    rw [Finset.sum_add_distrib]
    have hGC : (∑ j : Fin clock.m, clock.G b j * clock.C j ⟨w - 1, by omega⟩) =
        (clock.G * clock.C) b ⟨w - 1, by omega⟩ := rfl
    have hvC : (∑ j : Fin clock.m, clock.v j * clock.C j ⟨w - 1, by omega⟩) =
        (Matrix.vecMul clock.v clock.C) ⟨w - 1, by omega⟩ := rfl
    rw [hGC, hvC, clock.hclock, clock.hvC, mul_N_mat_apply]
    have hnot : ¬ (w - 1 + 1 < w) := by omega
    have he0_last : e0_row w ⟨w - 1, by omega⟩ = 0 := by
      simp only [e0_row]
      split_ifs with h
      · omega
      · rfl
    simp [hnot, he0_last]

/-- Matrix $K_{\mathrm{admissible}} = D_{\mathrm{admissible}}^\top X$. -/
def K_admissible {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (H0 ch delta : ℚ) :
    Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  (D_admissible clock b H0 ch delta).transpose * X_gateway clock

/-- Vanishing of $K_{\mathrm{admissible}}$ on all positive coordinates $r > 0$ and $c > 0$. -/
theorem K_admissible_supp {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) (r c : Fin (w + 1)) (hr : 0 < r.val) (hc : 0 < c.val) :
    K_admissible clock b H0 ch delta r c = 0 := by
  simp only [K_admissible, Matrix.mul_apply, Matrix.transpose_apply]
  rw [(Equiv.sum_comp finSumFinEquiv fun x =>
    D_admissible clock b H0 ch delta x r * X_gateway clock x c).symm]
  rw [Fintype.sum_sum_type]
  have h1 : (∑ i : Fin clock.m,
      D_admissible clock b H0 ch delta (finSumFinEquiv (Sum.inl i)) r *
      X_gateway clock (finSumFinEquiv (Sum.inl i)) c) = 0 := by
    apply Finset.sum_eq_zero
    intro i _
    rw [D_admissible_inl_eq_zero_of_pos hw clock b H0 ch delta i r hr, zero_mul]
  have h2 : (∑ g : Fin 1,
      D_admissible clock b H0 ch delta (finSumFinEquiv (Sum.inr g)) r *
      X_gateway clock (finSumFinEquiv (Sum.inr g)) c) = 0 := by
    apply Finset.sum_eq_zero
    intro g _
    have hg0 : g = 0 := Subsingleton.elim g 0
    subst hg0
    rw [X_gateway_inr_eq_zero_of_pos clock c hc, mul_zero]
  rw [h1, h2, add_zero]

/-- Vanishing of $K_{\mathrm{admissible}}$ at $(w, 0)$. -/
theorem K_admissible_last_row_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) :
    K_admissible clock b H0 ch delta ⟨w, Nat.lt_succ_self w⟩ ⟨0, Nat.succ_pos w⟩ = 0 := by
  simp only [K_admissible, Matrix.mul_apply, Matrix.transpose_apply]
  apply Finset.sum_eq_zero
  intro x _
  have hD : D_admissible clock b H0 ch delta x ⟨w, Nat.lt_succ_self w⟩ = 0 :=
    D_admissible_last_col_zero hw clock b H0 ch delta x
  rw [hD, zero_mul]

/-- Target height scaling coefficient $d_c$. -/
def dc_admissible {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (H0 ch delta : ℚ) : ℚ :=
  - (K_admissible clock b H0 ch delta ⟨0, Nat.succ_pos w⟩ ⟨w, Nat.lt_succ_self w⟩) / (4 * (w + 1 : ℚ))

/-- Target reset ceiling vector $\zeta_{\mathrm{admissible}} = d_c \cdot e_1^\top$. -/
def zeta_admissible {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (H0 ch delta : ℚ) : Fin (w + 1) → ℚ :=
  dc_admissible clock b H0 ch delta • e1_row (w + 1)

/-- Target moment difference matrix $F_{\mathrm{admissible}} = K - \ell^\top \psi$. -/
def F_admissible {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (H0 ch delta : ℚ) :
    Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  K_admissible clock b H0 ch delta -
    (ell_row (M_coupled w)).transpose * psi_row (zeta_admissible clock b H0 ch delta) (B_mat (w + 1))

/-- Matrix $F_{\mathrm{admissible}}$ is supported in row 0 and column 0. -/
theorem F_admissible_supp {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) (i j : Fin (w + 1)) (hi : 0 < i.val) (hj : 0 < j.val) :
    F_admissible clock b H0 ch delta i j = 0 := by
  simp only [F_admissible, Matrix.sub_apply]
  have hK := K_admissible_supp hw clock b H0 ch delta i j hi hj
  have hpsi := ell_transpose_mul_psi_e1 hw (dc_admissible clock b H0 ch delta) i j
  have hj_ne : ¬ (j.val = 0) := by omega
  simp only [zeta_admissible, hpsi, hj_ne, ↓reduceIte, hK, sub_zero]

/-- Matrix $F_{\mathrm{admissible}}$ is anti-symmetric at $(0, w)$ and $(w, 0)$. -/
theorem F_admissible_anti {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) :
    F_admissible clock b H0 ch delta ⟨0, Nat.succ_pos w⟩ ⟨w, Nat.lt_succ_self w⟩ +
      F_admissible clock b H0 ch delta ⟨w, Nat.lt_succ_self w⟩ ⟨0, Nat.succ_pos w⟩ = 0 := by
  have hw1 : 1 ≤ w := by omega
  simp only [F_admissible, Matrix.sub_apply]
  have hpsi_0w := ell_transpose_mul_psi_e1 hw1 (dc_admissible clock b H0 ch delta)
    ⟨0, Nat.succ_pos w⟩ ⟨w, Nat.lt_succ_self w⟩
  have hw_ne0 : ¬ (w = 0) := by omega
  simp only [zeta_admissible, hpsi_0w, hw_ne0, ↓reduceIte, sub_zero]
  have hpsi_w0 := ell_transpose_mul_psi_e1 hw1 (dc_admissible clock b H0 ch delta)
    ⟨w, Nat.lt_succ_self w⟩ ⟨0, Nat.succ_pos w⟩
  simp only [hpsi_w0, ↓reduceIte]
  have hKw0 := K_admissible_last_row_zero hw clock b H0 ch delta
  rw [hKw0, zero_sub]
  dsimp only [dc_admissible]
  have hden : 4 * (w + 1 : ℚ) ≠ 0 := by positivity
  field_simp [hden]
  ring

/-- Rank-2 Moment Equation solver for $D_{\mathrm{admissible}}$. -/
theorem admissible_bundle_moment_equation {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) :
    E_rank2 (F_admissible clock b H0 ch delta) -
      (E_rank2 (F_admissible clock b H0 ch delta)).transpose * B_mat (w + 1) =
    (D_admissible clock b H0 ch delta).transpose * X_gateway clock -
      (ell_row (M_coupled w)).transpose * psi_row (zeta_admissible clock b H0 ch delta) (B_mat (w + 1)) := by
  have hw1 : 1 ≤ w := by omega
  have hE := E_rank2_solves_moment hw1 (F_admissible clock b H0 ch delta)
    (F_admissible_supp hw1 clock b H0 ch delta) (F_admissible_anti hw clock b H0 ch delta)
  dsimp only [F_admissible, K_admissible] at hE
  exact hE

/-- Interaction matrix $J_{\mathrm{admissible}}$. -/
def J_admissible {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (H0 ch delta : ℚ) :
    Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ :=
  J_general w (E_rank2 (F_admissible clock b H0 ch delta))

/-- General moment compatibility for arbitrary deficit table $D$. -/
theorem general_admissible_moment_compat {w : ℕ} {clock : AlgebraicClock w}
    (D : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (X : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (hmoment :
      E - E.transpose * B_mat (w + 1) =
        D.transpose * X - (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1))) :
    D.transpose * X = (M_coupled w).transpose * Q_reset (J_general w E) (M_coupled w) (B_mat (w + 1)) zeta := by
  have hMJM : (M_coupled w).transpose * J_general w E * M_coupled w = E :=
    M_coupled_transpose_mul_J_general_mul_M_coupled w E
  have hmom' :
      (M_coupled w).transpose * J_general w E * M_coupled w -
        ((M_coupled w).transpose * J_general w E * M_coupled w).transpose * B_mat (w + 1) =
      D.transpose * X - (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)) := by
    rw [hMJM, hmoment]
  exact (moment_equation_iff D X (J_general w E) (M_coupled w) (B_mat (w + 1)) zeta).mpr hmom'

/-- Moment compatibility for $D_{\mathrm{admissible}}$. -/
theorem admissible_moment_compat {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) :
    (D_admissible clock b H0 ch delta).transpose * X_gateway clock =
      (M_coupled w).transpose *
        Q_reset (J_admissible clock b H0 ch delta) (M_coupled w)
          (B_mat (w + 1)) (zeta_admissible clock b H0 ch delta) := by
  have hmom := admissible_bundle_moment_equation hw clock b H0 ch delta
  exact general_admissible_moment_compat (D_admissible clock b H0 ch delta)
    (X_gateway clock) (E_rank2 (F_admissible clock b H0 ch delta)) (zeta_admissible clock b H0 ch delta) hmom

/-- Cone-calibrated coupling matrix $P_{\mathrm{admissible}}$. -/
def P_admissible {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (H0 ch delta : ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  P_interp (X_gateway clock) (L_X_gateway L_C) (M_coupled w) (R_M_coupled w)
    (D_admissible clock b H0 ch delta)
    (Q_reset (J_admissible clock b H0 ch delta) (M_coupled w) (B_mat (w + 1)) (zeta_admissible clock b H0 ch delta))
    (P0_cone (v_old_coupled clock.m) w)

/-- Reset equation $P \cdot M = D$ for $P_{\mathrm{admissible}}$. -/
theorem P_admissible_mul_M {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    P_admissible clock b H0 ch delta L_C * M_coupled w = D_admissible clock b H0 ch delta := by
  exact interpolate_PM (X_gateway clock) (L_X_gateway L_C) (M_coupled w) (R_M_coupled w)
    (D_admissible clock b H0 ch delta)
    (Q_reset (J_admissible clock b H0 ch delta) (M_coupled w) (B_mat (w + 1)) (zeta_admissible clock b H0 ch delta))
    (P0_cone (v_old_coupled clock.m) w)
    (R_M_coupled_mul_M_coupled w) (admissible_moment_compat hw clock b H0 ch delta)

/-- Reverse interaction equation $P^\top \cdot X = Q$ for $P_{\mathrm{admissible}}$. -/
theorem P_admissible_transpose_mul_X {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hLC : clock.C.transpose * L_C = 1) :
    (P_admissible clock b H0 ch delta L_C).transpose * X_gateway clock =
      Q_reset (J_admissible clock b H0 ch delta) (M_coupled w) (B_mat (w + 1)) (zeta_admissible clock b H0 ch delta) := by
  exact interpolate_PtX (X_gateway clock) (L_X_gateway L_C) (M_coupled w) (R_M_coupled w)
    (D_admissible clock b H0 ch delta)
    (Q_reset (J_admissible clock b H0 ch delta) (M_coupled w) (B_mat (w + 1)) (zeta_admissible clock b H0 ch delta))
    (P0_cone (v_old_coupled clock.m) w)
    (X_gateway_transpose_mul_L_X_gateway clock L_C hLC)

/-- Grounded admissible algebraic clock lift using rotated leader equivalence. -/
def admissibleBundleLiftClock {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hLC : clock.C.transpose * L_C = 1) :
    AlgebraicClock (w + 1) :=
  let P := P_admissible clock b H0 ch delta L_C
  let J := J_admissible clock b H0 ch delta
  let G_O := AdjoinLeaderEndpointG clock.G b clock.v
  let S := S_admissible clock b H0 ch delta
  let X := X_gateway clock
  let M := M_coupled w
  let B := B_mat (w + 1)
  let zeta := zeta_admissible clock b H0 ch delta
  let v_old := v_old_coupled clock.m
  let v_reset : Fin ((w + 1) + (w + 1)) → ℚ := 0
  let aP_old : Fin (clock.m + 1) → ℚ := fun _ => 1
  let aP_reset : Fin ((w + 1) + (w + 1)) → ℚ := fun _ => 1
  AlgebraicClock.ofEquiv (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)))
    (liftedGameMat G_O P J)
    (liftedScoreMat G_O J S X M zeta)
    (liftedCountMat X M (N_mat (w + 1)))
    (liftedWeightVec v_old v_reset)
    (liftedWeightVec aP_old aP_reset)
    (liftedGameMat_skew G_O P J (AdjoinLeaderEndpointG_skew clock.G b clock.v clock.hskew))
    (liftedGameMat_mul_liftedCountMat G_O P J S X M B (N_mat (w + 1)) zeta
      (B_mat_mul_one_add_N (w + 1))
      (P_admissible_transpose_mul_X clock b H0 ch delta L_C hLC)
      (P_admissible_mul_M hw clock b H0 ch delta L_C))
    (by
      have hcal := coupled_weight_calibration clock
      exact liftedWeightVec_mul_liftedCountMat X M v_old v_reset hcal)
    (fun s => by
      cases s with
      | inl _ => exact zero_lt_one
      | inr _ => exact zero_lt_one)

/-- Left inverse $L_C$ for `admissibleBundleLiftClock`. -/
def L_C_admissible_bundle_next {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hLC : clock.C.transpose * L_C = 1) :
    Matrix (Fin (admissibleBundleLiftClock hw clock b H0 ch delta L_C hLC).m) (Fin (w + 1)) ℚ :=
  Matrix.of fun x c =>
    match (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))).symm x with
    | Sum.inl _ => 0
    | Sum.inr r => R_M_coupled w c r

/-- Full column rank preservation for `admissibleBundleLiftClock`. -/
theorem admissible_C_transpose_mul_L_C {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hLC : clock.C.transpose * L_C = 1) :
    (admissibleBundleLiftClock hw clock b H0 ch delta L_C hLC).C.transpose *
      L_C_admissible_bundle_next hw clock b H0 ch delta L_C hLC = 1 := by
  ext c1 c2
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  change ∑ x : Fin ((clock.m + 1) + ((w + 1) + (w + 1))),
    (admissibleBundleLiftClock hw clock b H0 ch delta L_C hLC).C x c1 *
      L_C_admissible_bundle_next hw clock b H0 ch delta L_C hLC x c2 =
    (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) c1 c2
  rw [(Equiv.sum_comp (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))) fun y =>
    (admissibleBundleLiftClock hw clock b H0 ch delta L_C hLC).C y c1 *
      L_C_admissible_bundle_next hw clock b H0 ch delta L_C hLC y c2).symm]
  rw [Fintype.sum_sum_type]
  simp only [admissibleBundleLiftClock, AlgebraicClock.ofEquiv, liftedCountMat,
    L_C_admissible_bundle_next, Matrix.of_apply, Equiv.symm_apply_apply,
    mul_zero, Finset.sum_const_zero, zero_add]
  have hRM := congr_fun (congr_fun (R_M_coupled_mul_M_coupled w) c2) c1
  simp only [Matrix.mul_apply, Matrix.one_apply, eq_comm] at hRM ⊢
  simpa [mul_comm] using hRM

/-- Verified full-rank clock of order $w + 1$ from `admissibleBundleLiftClock`. -/
def admissibleBundleFullRankLift {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hLC : clock.C.transpose * L_C = 1) :
    FullRankClock (w + 1) where
  clock := admissibleBundleLiftClock hw clock b H0 ch delta L_C hLC
  L_C := L_C_admissible_bundle_next hw clock b H0 ch delta L_C hLC
  hLC := admissible_C_transpose_mul_L_C hw clock b H0 ch delta L_C hLC

/-!
### 5B. General Paper Ceiling-Matched Lift for Arbitrary Ceiling `zeta`
-/

/-- General paper ceiling-matched algebraic clock lift for arbitrary ceiling `zeta`. -/
def admissiblePaperLiftClock {w : ℕ} (_hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (zeta : Fin (w + 1) → ℚ) (delta : ℚ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hE : E - E.transpose * B_mat (w + 1) =
      (D_paper clock b zeta delta).transpose * X_gateway clock -
      (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (a_old : Fin (clock.m + 1) → ℚ) (_ha_pos : ∀ x, 0 < a_old x)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) :
    AlgebraicClock (w + 1) :=
  let P := P_interp (X_gateway clock) (L_X_gateway L_C) (M_coupled w) (R_M_coupled w)
    (D_paper clock b zeta delta)
    (Q_reset (J_general w E) (M_coupled w) (B_mat (w + 1)) zeta)
    (P0_cone a_old w)
  let J := J_general w E
  let G_O := AdjoinLeaderEndpointG clock.G b clock.v
  let S := S_paper clock b zeta delta
  let X := X_gateway clock
  let M := M_coupled w
  let B := B_mat (w + 1)
  let v_old := v_old_coupled clock.m
  let v_reset : Fin ((w + 1) + (w + 1)) → ℚ := 0
  let aP_old : Fin (clock.m + 1) → ℚ := fun _ => 1
  let aP_reset : Fin ((w + 1) + (w + 1)) → ℚ := fun _ => 1
  AlgebraicClock.ofEquiv (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)))
    (liftedGameMat G_O P J)
    (liftedScoreMat G_O J S X M zeta)
    (liftedCountMat X M (N_mat (w + 1)))
    (liftedWeightVec v_old v_reset)
    (liftedWeightVec aP_old aP_reset)
    (liftedGameMat_skew G_O P J (AdjoinLeaderEndpointG_skew clock.G b clock.v clock.hskew))
    (liftedGameMat_mul_liftedCountMat G_O P J S X M B (N_mat (w + 1)) zeta
      (B_mat_mul_one_add_N (w + 1))
      (by
        exact interpolate_PtX (X_gateway clock) (L_X_gateway L_C) (M_coupled w) (R_M_coupled w)
          (D_paper clock b zeta delta)
          (Q_reset (J_general w E) (M_coupled w) (B_mat (w + 1)) zeta)
          (P0_cone a_old w)
          (X_gateway_transpose_mul_L_X_gateway clock L_C hLC))
      (by
        have hcompat : (D_paper clock b zeta delta).transpose * X_gateway clock =
            (M_coupled w).transpose * Q_reset (J_general w E) (M_coupled w) (B_mat (w + 1)) zeta :=
          general_admissible_moment_compat (D_paper clock b zeta delta) (X_gateway clock) E zeta hE
        exact interpolate_PM (X_gateway clock) (L_X_gateway L_C) (M_coupled w) (R_M_coupled w)
          (D_paper clock b zeta delta)
          (Q_reset (J_general w E) (M_coupled w) (B_mat (w + 1)) zeta)
          (P0_cone a_old w)
          (R_M_coupled_mul_M_coupled w) hcompat))
    (by
      have hcal := coupled_weight_calibration clock
      exact liftedWeightVec_mul_liftedCountMat X M v_old v_reset hcal)
    (fun s => by
      cases s with
      | inl _ => exact zero_lt_one
      | inr _ => exact zero_lt_one)

/-- Left inverse $L_C$ for `admissiblePaperLiftClock`. -/
def L_C_admissible_paper_next {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (zeta : Fin (w + 1) → ℚ) (delta : ℚ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hE : E - E.transpose * B_mat (w + 1) =
      (D_paper clock b zeta delta).transpose * X_gateway clock -
      (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (a_old : Fin (clock.m + 1) → ℚ) (ha_pos : ∀ x, 0 < a_old x)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) :
    Matrix (Fin (admissiblePaperLiftClock hw clock b zeta delta E hE a_old ha_pos L_C hLC).m) (Fin (w + 1)) ℚ :=
  Matrix.of fun x c =>
    match (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))).symm x with
    | Sum.inl _ => 0
    | Sum.inr r => R_M_coupled w c r

/-- Full column rank preservation for `admissiblePaperLiftClock`. -/
theorem admissiblePaper_C_transpose_mul_L_C {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (zeta : Fin (w + 1) → ℚ) (delta : ℚ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hE : E - E.transpose * B_mat (w + 1) =
      (D_paper clock b zeta delta).transpose * X_gateway clock -
      (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (a_old : Fin (clock.m + 1) → ℚ) (ha_pos : ∀ x, 0 < a_old x)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) :
    (admissiblePaperLiftClock hw clock b zeta delta E hE a_old ha_pos L_C hLC).C.transpose *
      L_C_admissible_paper_next hw clock b zeta delta E hE a_old ha_pos L_C hLC = 1 := by
  ext c1 c2
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  change ∑ x : Fin ((clock.m + 1) + ((w + 1) + (w + 1))),
    (admissiblePaperLiftClock hw clock b zeta delta E hE a_old ha_pos L_C hLC).C x c1 *
      L_C_admissible_paper_next hw clock b zeta delta E hE a_old ha_pos L_C hLC x c2 =
    (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) c1 c2
  rw [(Equiv.sum_comp (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))) fun y =>
    (admissiblePaperLiftClock hw clock b zeta delta E hE a_old ha_pos L_C hLC).C y c1 *
      L_C_admissible_paper_next hw clock b zeta delta E hE a_old ha_pos L_C hLC y c2).symm]
  rw [Fintype.sum_sum_type]
  simp only [admissiblePaperLiftClock, AlgebraicClock.ofEquiv, liftedCountMat,
    L_C_admissible_paper_next, Matrix.of_apply, Equiv.symm_apply_apply,
    mul_zero, Finset.sum_const_zero, zero_add]
  have hRM := congr_fun (congr_fun (R_M_coupled_mul_M_coupled w) c2) c1
  simp only [Matrix.mul_apply, Matrix.one_apply, eq_comm] at hRM ⊢
  simpa [mul_comm] using hRM

/-- Verified full-rank clock of order $w + 1$ from `admissiblePaperLiftClock`. -/
def admissiblePaperFullRankLift {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (zeta : Fin (w + 1) → ℚ) (delta : ℚ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hE : E - E.transpose * B_mat (w + 1) =
      (D_paper clock b zeta delta).transpose * X_gateway clock -
      (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (a_old : Fin (clock.m + 1) → ℚ) (ha_pos : ∀ x, 0 < a_old x)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) :
    FullRankClock (w + 1) where
  clock := admissiblePaperLiftClock hw clock b zeta delta E hE a_old ha_pos L_C hLC
  L_C := L_C_admissible_paper_next hw clock b zeta delta E hE a_old ha_pos L_C hLC
  hLC := admissiblePaper_C_transpose_mul_L_C hw clock b zeta delta E hE a_old ha_pos L_C hLC

/-!
## 6. Scaled Admissible Lift and Recursive FullRankClock Family
-/

/-- Scaled admissible ceiling row $\zeta_{\mathrm{admissible\_scaled}} = \zeta_{\mathrm{admissible}} + c_\zeta \cdot \zeta_{\mathrm{coupled}}$. -/
def zeta_admissible_scaled {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta : ℚ) : Fin (w + 1) → ℚ :=
  zeta_admissible clock b H0 ch delta + c_zeta • zeta_coupled w

/-- Scaled admissible moment matrix $E_{\mathrm{admissible\_scaled}} = E_{\mathrm{rank2}} + c_\zeta \cdot (4(w+1) J_{\mathrm{ones}})$. -/
def E_admissible_scaled {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta : ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  E_rank2 (F_admissible clock b H0 ch delta) + c_zeta • ((4 * (w + 1 : ℚ)) • J_ones (w + 1))

/-- Scaled admissible reset interaction matrix $J_{\mathrm{admissible\_scaled}} = J_{\mathrm{general}} + c_\zeta \cdot J_{\mathrm{coupled}}$. -/
def J_admissible_scaled {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta : ℚ) : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ :=
  J_general w (E_rank2 (F_admissible clock b H0 ch delta)) + c_zeta • J_coupled w

/-- Interaction matrix `J_admissible_scaled` is strictly lower-triangular. -/
theorem J_admissible_scaled_lower {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta : ℚ) (a b_idx : Fin ((w + 1) + (w + 1))) (hab : a.val ≤ b_idx.val) :
    J_admissible_scaled clock b H0 ch delta c_zeta a b_idx = 0 := by
  simp only [J_admissible_scaled, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
  rw [J_general_lower w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx hab]
  rw [J_coupled_lower w a b_idx hab]
  ring

/-- Realization of `E_admissible_scaled` by `J_admissible_scaled`. -/
theorem M_coupled_transpose_mul_J_admissible_scaled_mul_M_coupled {w : ℕ}
    (clock : AlgebraicClock w) (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) :
    (M_coupled w).transpose * J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w =
      E_admissible_scaled clock b H0 ch delta c_zeta := by
  dsimp only [J_admissible_scaled, E_admissible_scaled]
  simp only [Matrix.mul_add, Matrix.add_mul, Matrix.mul_smul, Matrix.smul_mul]
  rw [M_coupled_transpose_mul_J_general_mul_M_coupled w (E_rank2 (F_admissible clock b H0 ch delta))]
  rw [M_coupled_transpose_mul_J_coupled_mul_M_coupled w]

/-- Decomposition of `psi_row (zeta_admissible_scaled)`. -/
theorem psi_row_zeta_admissible_scaled {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta : ℚ) :
    psi_row (zeta_admissible_scaled clock b H0 ch delta c_zeta) (B_mat (w + 1)) =
      psi_row (zeta_admissible clock b H0 ch delta) (B_mat (w + 1)) +
        c_zeta • psi_row (zeta_coupled w) (B_mat (w + 1)) := by
  dsimp only [zeta_admissible_scaled]
  rw [psi_row_add, psi_row_smul]

/-- Scaled admissible moment equation. -/
theorem admissible_scaled_moment_equation {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) :
    E_admissible_scaled clock b H0 ch delta c_zeta -
      (E_admissible_scaled clock b H0 ch delta c_zeta).transpose * B_mat (w + 1) =
    (D_admissible clock b H0 ch delta).transpose * X_gateway clock -
      (ell_row (M_coupled w)).transpose * psi_row (zeta_admissible_scaled clock b H0 ch delta c_zeta) (B_mat (w + 1)) := by
  have h1 := admissible_bundle_moment_equation hw clock b H0 ch delta
  have h2 : ((4 * (w + 1 : ℚ)) • J_ones (w + 1)) -
      ((4 * (w + 1 : ℚ)) • J_ones (w + 1)).transpose * B_mat (w + 1) =
      - ((ell_row (M_coupled w)).transpose * psi_row (zeta_coupled w) (B_mat (w + 1))) := by
    have hmom := gateway_moment_equation hw clock 0
    rw [D_deficit_gateway_eq_zero hw clock 0] at hmom
    simp only [Matrix.transpose_zero, Matrix.zero_mul, zero_sub] at hmom
    rw [M_coupled_transpose_mul_J_coupled_mul_M_coupled w] at hmom
    exact hmom
  have hpsi := psi_row_zeta_admissible_scaled clock b H0 ch delta c_zeta
  dsimp only [E_admissible_scaled]
  rw [hpsi]
  rw [Matrix.transpose_add, Matrix.transpose_smul, Matrix.add_mul, Matrix.smul_mul]
  rw [Matrix.mul_add, Matrix.mul_smul]
  have h_sub : E_rank2 (F_admissible clock b H0 ch delta) + c_zeta • ((4 * (w + 1 : ℚ)) • J_ones (w + 1)) -
      ((E_rank2 (F_admissible clock b H0 ch delta)).transpose * B_mat (w + 1) +
        c_zeta • (((4 * (w + 1 : ℚ)) • J_ones (w + 1)).transpose * B_mat (w + 1))) =
      (E_rank2 (F_admissible clock b H0 ch delta) - (E_rank2 (F_admissible clock b H0 ch delta)).transpose * B_mat (w + 1)) +
        c_zeta • (((4 * (w + 1 : ℚ)) • J_ones (w + 1)) -
          ((4 * (w + 1 : ℚ)) • J_ones (w + 1)).transpose * B_mat (w + 1)) := by
    ext a b_idx
    simp only [Matrix.sub_apply, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
    ring
  rw [h_sub, h1, h2]
  ext a b_idx
  simp only [Matrix.sub_apply, Matrix.add_apply, Matrix.smul_apply, Matrix.neg_apply, smul_eq_mul]
  ring

/-- Compatibility from the scaled admissible moment equation. -/
theorem admissible_scaled_moment_compat {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) :
    (D_admissible clock b H0 ch delta).transpose * X_gateway clock =
      (M_coupled w).transpose *
        Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) := by
  have hMJM : (M_coupled w).transpose * J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w =
      E_admissible_scaled clock b H0 ch delta c_zeta :=
    M_coupled_transpose_mul_J_admissible_scaled_mul_M_coupled clock b H0 ch delta c_zeta
  have hmom' :
      (M_coupled w).transpose * J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w -
        ((M_coupled w).transpose * J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w).transpose * B_mat (w + 1) =
      (D_admissible clock b H0 ch delta).transpose * X_gateway clock -
        (ell_row (M_coupled w)).transpose * psi_row (zeta_admissible_scaled clock b H0 ch delta c_zeta) (B_mat (w + 1)) := by
    rw [hMJM, admissible_scaled_moment_equation hw clock b H0 ch delta c_zeta]
  exact (moment_equation_iff
    (D_admissible clock b H0 ch delta)
    (X_gateway clock) (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
    (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mpr hmom'

/-- Scaled admissible interpolation coupling matrix `P_admissible_scaled`. -/
def P_admissible_scaled {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  P_interp (X_gateway clock) (L_X_gateway L_C) (M_coupled w) (R_M_coupled w)
    (D_admissible clock b H0 ch delta)
    (Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
      (zeta_admissible_scaled clock b H0 ch delta c_zeta))
    (c_P0 • P0_cone a_old w)

/-- `P_admissible_scaled` satisfies `P * M = D`. -/
theorem P_admissible_scaled_mul_M {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C * M_coupled w =
      D_admissible clock b H0 ch delta := by
  have hcompat := admissible_scaled_moment_compat hw clock b H0 ch delta c_zeta
  exact interpolate_PM (X_gateway clock) (L_X_gateway L_C) (M_coupled w) (R_M_coupled w)
    (D_admissible clock b H0 ch delta)
    (Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
      (zeta_admissible_scaled clock b H0 ch delta c_zeta))
    (c_P0 • P0_cone a_old w)
    (R_M_coupled_mul_M_coupled w) hcompat

/-- `P_admissible_scaled` satisfies `Pᵀ * X = Q`. -/
theorem P_admissible_scaled_transpose_mul_X {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) :
    (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C).transpose * X_gateway clock =
      Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta) := by
  exact interpolate_PtX (X_gateway clock) (L_X_gateway L_C) (M_coupled w) (R_M_coupled w)
    (D_admissible clock b H0 ch delta)
    (Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
      (zeta_admissible_scaled clock b H0 ch delta c_zeta))
    (c_P0 • P0_cone a_old w)
    (X_gateway_transpose_mul_L_X_gateway clock L_C hLC)

/-- Grounded algebraic clock lift of order `w + 1` from the scaled admissible lift. -/
@[reducible] def admissibleScaledLiftClock {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) :
    AlgebraicClock (w + 1) :=
  let P := P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C
  let J := J_admissible_scaled clock b H0 ch delta c_zeta
  let G_O := AdjoinLeaderEndpointG clock.G b clock.v
  let S := S_admissible clock b H0 ch delta
  let X := X_gateway clock
  let M := M_coupled w
  let B := B_mat (w + 1)
  let zeta := zeta_admissible_scaled clock b H0 ch delta c_zeta
  let v_old := v_old_coupled clock.m
  let v_reset : Fin ((w + 1) + (w + 1)) → ℚ := 0
  let aP_old : Fin (clock.m + 1) → ℚ := fun _ => 1
  let aP_reset : Fin ((w + 1) + (w + 1)) → ℚ := fun _ => 1
  AlgebraicClock.ofEquiv (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)))
    (liftedGameMat G_O P J)
    (liftedScoreMat G_O J S X M zeta)
    (liftedCountMat X M (N_mat (w + 1)))
    (liftedWeightVec v_old v_reset)
    (liftedWeightVec aP_old aP_reset)
    (liftedGameMat_skew G_O P J (AdjoinLeaderEndpointG_skew clock.G b clock.v clock.hskew))
    (liftedGameMat_mul_liftedCountMat G_O P J S X M B (N_mat (w + 1)) zeta
      (B_mat_mul_one_add_N (w + 1))
      (P_admissible_scaled_transpose_mul_X clock b H0 ch delta c_zeta c_P0 a_old L_C hLC)
      (P_admissible_scaled_mul_M hw clock b H0 ch delta c_zeta c_P0 a_old L_C))
    (by
      have hcal := coupled_weight_calibration clock
      exact liftedWeightVec_mul_liftedCountMat X M v_old v_reset hcal)
    (fun s => by
      cases s with
      | inl _ => exact zero_lt_one
      | inr _ => exact zero_lt_one)

/-- Left inverse $L_C$ for `admissibleScaledLiftClock`. -/
def L_C_admissible_scaled_next {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) :
    Matrix (Fin (admissibleScaledLiftClock hw clock b H0 ch delta c_zeta c_P0 a_old L_C hLC).m) (Fin (w + 1)) ℚ :=
  Matrix.of fun x c =>
    match (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))).symm x with
    | Sum.inl _ => 0
    | Sum.inr r => R_M_coupled w c r

/-- Full column rank preservation for `admissibleScaledLiftClock`. -/
theorem admissible_scaled_C_transpose_mul_L_C {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) :
    (admissibleScaledLiftClock hw clock b H0 ch delta c_zeta c_P0 a_old L_C hLC).C.transpose *
      L_C_admissible_scaled_next hw clock b H0 ch delta c_zeta c_P0 a_old L_C hLC = 1 := by
  ext c1 c2
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  change ∑ x : Fin ((clock.m + 1) + ((w + 1) + (w + 1))),
    (admissibleScaledLiftClock hw clock b H0 ch delta c_zeta c_P0 a_old L_C hLC).C x c1 *
      L_C_admissible_scaled_next hw clock b H0 ch delta c_zeta c_P0 a_old L_C hLC x c2 =
    (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) c1 c2
  rw [(Equiv.sum_comp (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))) fun y =>
    (admissibleScaledLiftClock hw clock b H0 ch delta c_zeta c_P0 a_old L_C hLC).C y c1 *
      L_C_admissible_scaled_next hw clock b H0 ch delta c_zeta c_P0 a_old L_C hLC y c2).symm]
  rw [Fintype.sum_sum_type]
  simp only [admissibleScaledLiftClock, AlgebraicClock.ofEquiv, liftedCountMat,
    L_C_admissible_scaled_next, Matrix.of_apply, Equiv.symm_apply_apply,
    mul_zero, Finset.sum_const_zero, zero_add]
  have hRM := congr_fun (congr_fun (R_M_coupled_mul_M_coupled w) c2) c1
  simp only [Matrix.mul_apply, Matrix.one_apply, eq_comm] at hRM ⊢
  simpa [mul_comm] using hRM

/-- Verified full-rank clock of order $w + 1$ from `admissibleScaledLiftClock`. -/
def admissibleScaledFullRankLift {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (fc.clock.m + 1) → ℚ) :
    FullRankClock (w + 1) where
  clock := admissibleScaledLiftClock hw fc.clock b H0 ch delta c_zeta c_P0 a_old fc.L_C fc.hLC
  L_C := L_C_admissible_scaled_next hw fc.clock b H0 ch delta c_zeta c_P0 a_old fc.L_C fc.hLC
  hLC := admissible_scaled_C_transpose_mul_L_C hw fc.clock b H0 ch delta c_zeta c_P0 a_old fc.L_C fc.hLC

/-- Action count recursion for `admissibleScaledFullRankLift`: $m_{w+1} = m_w + 2w + 3$. -/
theorem admissibleScaledFullRankLift_m {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (fc.clock.m + 1) → ℚ) :
    (admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old).clock.m = fc.clock.m + 2 * w + 3 := by
  dsimp only [admissibleScaledFullRankLift, admissibleScaledLiftClock, AlgebraicClock.ofEquiv]
  omega

/-- Strict positivity of dimension for `admissibleScaledFullRankLift`. -/
theorem admissibleScaledFullRankLift_m_pos {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (fc.clock.m + 1) → ℚ) :
    0 < (admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old).clock.m := by
  rw [admissibleScaledFullRankLift_m]
  omega

/-- In `admissibleScaledLiftClock`, the 0-th element of the mapped 4-stage phase word is action 0. -/
theorem admissible_phaseWord_head_eq_zero {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m)) (q : ℕ)
    (h_pos : 0 < ((rawFourStageWord clock parentWord q).map
      (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)))).length) :
    ((rawFourStageWord clock parentWord q).map
      (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))))[0]'h_pos =
    ⟨0, by
      have : 0 < (clock.m + 1) + ((w + 1) + (w + 1)) := by omega
      exact this⟩ := by
  have hraw_pos : 0 < (rawFourStageWord clock parentWord q).length := by
    rw [List.length_map] at h_pos
    exact h_pos
  have hget : ((rawFourStageWord clock parentWord q).map
      (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))))[0]'h_pos =
    (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)))
      ((rawFourStageWord clock parentWord q)[0]'hraw_pos) := by
    simp only [List.getElem_map]
  rw [hget]
  rw [rawFourStageWord_head_eq_inr_zero clock parentWord q hraw_pos]
  exact rotLeaderEquiv_inr_zero (by omega) (by omega)

/-- In `admissibleScaledLiftClock`, row 0 of `.R` equals `zeta_admissible_scaled`. -/
theorem admissibleScaledLiftClock_leader_zero_score {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) (c : Fin (w + 1)) :
    (admissibleScaledLiftClock hw clock b H0 ch delta c_zeta c_P0 a_old L_C hLC).R ⟨0, by
      dsimp [admissibleScaledLiftClock, AlgebraicClock.ofEquiv]
      omega⟩ c = zeta_admissible_scaled clock b H0 ch delta c_zeta c := by
  dsimp only [admissibleScaledLiftClock, AlgebraicClock.ofEquiv]
  simp only [Matrix.of_apply]
  have hm : 0 < clock.m + 1 := by omega
  have hn : 0 < (w + 1) + (w + 1) := by omega
  rw [rotLeaderEquiv_symm_zero hm hn]
  dsimp only [liftedScoreMat]
  simp only [Matrix.of_apply, Matrix.sub_apply, one_zeta, Matrix.mul_apply]
  have hsum : (∑ ℓ : Fin ((w + 1) + (w + 1)),
      J_admissible_scaled clock b H0 ch delta c_zeta ⟨0, by omega⟩ ℓ * M_coupled w ℓ c) = 0 := by
    have hJ_lower := J_admissible_scaled_lower clock b H0 ch delta c_zeta
    have hterm : ∀ ℓ : Fin ((w + 1) + (w + 1)),
        J_admissible_scaled clock b H0 ch delta c_zeta ⟨0, by omega⟩ ℓ = 0 := by
      intro ℓ
      apply hJ_lower
      exact Nat.zero_le _
    rw [Finset.sum_congr rfl (fun ℓ _ => by rw [hterm ℓ, zero_mul])]
    exact Finset.sum_const_zero
  rw [hsum, sub_zero]

/-- Full-rank clock family bundled with the strict positivity of its action dimension. -/
def admissibleFullRankClockFamilyWithPos (H0 ch delta c_zeta c_P0 : ℕ → ℚ) :
    (d : ℕ) → (fc : FullRankClock (d + 2)) ×' (0 < fc.clock.m)
  | 0 => ⟨rpsFullRankClock, by decide⟩
  | d + 1 =>
      let ⟨parent_fc, hpos⟩ := admissibleFullRankClockFamilyWithPos H0 ch delta c_zeta c_P0 d
      let next_fc := admissibleScaledFullRankLift (by omega) parent_fc ⟨0, hpos⟩
        (H0 d) (ch d) (delta d) (c_zeta d) (c_P0 d) (fun _ => 1)
      have hnext_pos : 0 < next_fc.clock.m := by
        dsimp only [next_fc]
        rw [admissibleScaledFullRankLift_m]
        omega
      ⟨next_fc, hnext_pos⟩

/-- Recursive family of full-rank clocks using the scaled admissible lift. -/
def admissibleFullRankClockFamily (H0 ch delta c_zeta c_P0 : ℕ → ℚ) (d : ℕ) : FullRankClock (d + 2) :=
  (admissibleFullRankClockFamilyWithPos H0 ch delta c_zeta c_P0 d).1

/-- Positivity of dimension for `admissibleFullRankClockFamily`. -/
theorem admissibleFullRankClockFamily_pos (H0 ch delta c_zeta c_P0 : ℕ → ℚ) (d : ℕ) :
    0 < (admissibleFullRankClockFamily H0 ch delta c_zeta c_P0 d).clock.m :=
  (admissibleFullRankClockFamilyWithPos H0 ch delta c_zeta c_P0 d).2

/-- Dimension theorem for `admissibleFullRankClockFamily`: $m_{d+2} = (d + 3)^2 - 6$. -/
theorem admissibleFullRankClockFamily_m (H0 ch delta c_zeta c_P0 : ℕ → ℚ) (d : ℕ) :
    (admissibleFullRankClockFamily H0 ch delta c_zeta c_P0 d).clock.m = (d + 3) ^ 2 - 6 := by
  induction d with
  | zero => rfl
  | succ d ih =>
      dsimp only [admissibleFullRankClockFamily, admissibleFullRankClockFamilyWithPos]
      rw [admissibleScaledFullRankLift_m]
      change (admissibleFullRankClockFamily H0 ch delta c_zeta c_P0 d).clock.m + 2 * (d + 2) + 3 = (d + 1 + 3) ^ 2 - 6
      rw [ih]
      have h1 : 9 ≤ (d + 3) ^ 2 := by
        calc 9 ≤ d ^ 2 + 6 * d + 9 := by omega
          _ = (d + 3) ^ 2 := by ring
      have h2 : (d + 1 + 3) ^ 2 = (d + 3) ^ 2 + 1 + ((d + 2 + 1) + (d + 2 + 1)) := by ring
      omega

/-!
## 7. Grounded 4-Stage Admissible RealizedClock Lift
-/

/-- Canonical initial lifted score vector at phase index `q` for the scaled admissible lift. -/
def admissibleInitScoreVec {k : ℕ} (hw : 2 ≤ k) (fc : FullRankClock k)
    (b : Fin fc.clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (fc.clock.m + 1) → ℚ) (q : ℕ) :
    Fin (admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old).clock.m → ℚ :=
  fun i => ((liftedScoreMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
    (J_admissible_scaled fc.clock b H0 ch delta c_zeta) (S_admissible fc.clock b H0 ch delta)
    (X_gateway fc.clock) (M_coupled k)
    (zeta_admissible_scaled fc.clock b H0 ch delta c_zeta)).mulVec (binomBasis (k + 1) q))
    ((rotLeaderEquiv (fc.clock.m + 1) ((k + 1) + (k + 1))).symm i)

/-- Initial lifted score vector evaluates to the exact ceiling score on action 0. -/
theorem admissibleInitScoreVec_zero {k : ℕ} (hw : 2 ≤ k) (fc : FullRankClock k)
    (b : Fin fc.clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (fc.clock.m + 1) → ℚ) (q : ℕ) :
    admissibleInitScoreVec hw fc b H0 ch delta c_zeta c_P0 a_old q ⟨0, by
      have := admissibleScaledFullRankLift_m_pos hw fc b H0 ch delta c_zeta c_P0 a_old
      omega⟩ =
    dotProduct (zeta_admissible_scaled fc.clock b H0 ch delta c_zeta) (binomBasis (k + 1) q) := by
  unfold admissibleInitScoreVec
  have hm : 0 < fc.clock.m + 1 := by omega
  have hn : 0 < (k + 1) + (k + 1) := by omega
  rw [rotLeaderEquiv_symm_zero hm hn]
  exact liftedScoreMat_inr_zero_eq_ceiling
    (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
    (J_admissible_scaled fc.clock b H0 ch delta c_zeta)
    (S_admissible fc.clock b H0 ch delta)
    (X_gateway fc.clock)
    (M_coupled k)
    (zeta_admissible_scaled fc.clock b H0 ch delta c_zeta)
    (J_admissible_scaled_lower fc.clock b H0 ch delta c_zeta)
    q

/-- Canonical tie-removal bias for the scaled admissible lift at phase shift `phaseShift`. -/
def admissibleTieRemovalBias {k : ℕ} (hw : 2 ≤ k) (fc : FullRankClock k)
    (b : Fin fc.clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (fc.clock.m + 1) → ℚ)
    {m_rank : ℕ}
    (rank : Fin (admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old).clock.m → Fin m_rank)
    (phaseShift : ℕ) :
    Fin (admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old).clock.m → ℚ :=
  canonicalTieRemovalBias (admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old).clock.G
    (admissibleInitScoreVec hw fc b H0 ch delta c_zeta c_P0 a_old phaseShift) rank

/-- Biased initial score vector at phase index `q` with phase shift `phaseShift`. -/
def admissibleBiasedInitScoreVec {k : ℕ} (hw : 2 ≤ k) (fc : FullRankClock k)
    (b : Fin fc.clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (fc.clock.m + 1) → ℚ)
    {m_rank : ℕ}
    (rank : Fin (admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old).clock.m → Fin m_rank)
    (phaseShift : ℕ) (q : ℕ) :
    Fin (admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old).clock.m → ℚ :=
  fun i => admissibleInitScoreVec hw fc b H0 ch delta c_zeta c_P0 a_old q i +
    admissibleTieRemovalBias hw fc b H0 ch delta c_zeta c_P0 a_old rank phaseShift i

/-- Biased canonical score shift combining the bias on the leader with the canonical setup shift. -/
def admissibleBiasedScoreShift {k : ℕ} (hw : 2 ≤ k) (fc : FullRankClock k)
    (b : Fin fc.clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (fc.clock.m + 1) → ℚ)
    {m_rank : ℕ}
    (rank : Fin (admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old).clock.m → Fin m_rank)
    (phaseShift : ℕ) : ℚ :=
  admissibleTieRemovalBias hw fc b H0 ch delta c_zeta c_P0 a_old rank phaseShift ⟨0, by
    have := admissibleScaledFullRankLift_m_pos hw fc b H0 ch delta c_zeta c_P0 a_old
    omega⟩ +
  canonicalScoreShift (admissibleBiasedInitScoreVec hw fc b H0 ch delta c_zeta c_P0 a_old rank phaseShift phaseShift)

/-- **Biased Phase-Start Cumulative Score Evaluation (`admissible_biased_phaseStart_cumScore_eq`)**:
    Evaluates the unrolled cumulative score of the biased trajectory at phase start in exact closed form. -/
theorem admissible_biased_phaseStart_cumScore_eq {k : ℕ} (hw : 2 ≤ k) (fc : FullRankClock k)
    (b : Fin fc.clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (fc.clock.m + 1) → ℚ)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis k σ))
    {m_rank : ℕ}
    (rank : Fin (admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old).clock.m → Fin m_rank)
    (phaseShift : ℕ)
    (p : ℕ) :
    let aLift := admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old
    let rotEquiv := rotLeaderEquiv (fc.clock.m + 1) ((k + 1) + (k + 1))
    let defaultAct : Fin aLift.clock.m := ⟨0, by
      have := admissibleScaledFullRankLift_m_pos hw fc b H0 ch delta c_zeta c_P0 a_old
      omega⟩
    let rawWord : ℕ → List (Fin (fc.clock.m + 1) ⊕ Fin ((k + 1) + (k + 1))) := fun q : ℕ =>
      rawFourStageWord fc.clock parentWord (q + phaseShift)
    let phaseWord : ℕ → List (Fin aLift.clock.m) := fun q : ℕ =>
      (rawWord q).map rotEquiv
    let sBiased : ℕ → Fin aLift.clock.m → ℚ := fun q =>
      admissibleBiasedInitScoreVec hw fc b H0 ch delta c_zeta c_P0 a_old rank phaseShift (q + phaseShift)
    cumScore (setupMatrix aLift.clock.G (canonicalSetupVec (sBiased 0)))
      (wordPhaseTrajectory phaseWord defaultAct)
      (wordPhaseStartStep phaseWord p)
      (wordPhaseTrajectory phaseWord defaultAct (wordPhaseStartStep phaseWord p)) =
    dotProduct (zeta_admissible_scaled fc.clock b H0 ch delta c_zeta) (binomBasis (k + 1) (p + phaseShift)) +
      admissibleBiasedScoreShift hw fc b H0 ch delta c_zeta c_P0 a_old rank phaseShift := by
  intro aLift rotEquiv defaultAct rawWord phaseWord sBiased
  let sInit : ℕ → Fin aLift.clock.m → ℚ := fun q =>
    admissibleInitScoreVec hw fc b H0 ch delta c_zeta c_P0 a_old (q + phaseShift)
  have hcount : ∀ q : ℕ, 0 < (phaseWord q).length := by
    intro q
    change 0 < ((rawWord q).map rotEquiv).length
    rw [List.length_map]
    dsimp only [rawWord, rawFourStageWord]
    simp only [List.length_append, List.length_singleton]
    omega
  have hboundary : ∀ q : ℕ,
      wordScore aLift.clock.G (sInit q) (phaseWord q) = sInit (q + 1) := by
    intro q
    ext i
    have hmap := wordScore_map_equiv rotEquiv
      (liftedGameMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        (P_admissible_scaled fc.clock b H0 ch delta c_zeta c_P0 a_old fc.L_C)
        (J_admissible_scaled fc.clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        (J_admissible_scaled fc.clock b H0 ch delta c_zeta)
        (S_admissible fc.clock b H0 ch delta)
        (X_gateway fc.clock) (M_coupled k)
        (zeta_admissible_scaled fc.clock b H0 ch delta c_zeta)).mulVec (binomBasis (k + 1) (q + phaseShift)))
      (rawWord q) i
    have hraw := wordScore_rawFourStageWord fc.clock parentWord hparent_count
      (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
      (P_admissible_scaled fc.clock b H0 ch delta c_zeta c_P0 a_old fc.L_C)
      (J_admissible_scaled fc.clock b H0 ch delta c_zeta)
      (S_admissible fc.clock b H0 ch delta)
      (zeta_admissible_scaled fc.clock b H0 ch delta c_zeta)
      (P_admissible_scaled_transpose_mul_X fc.clock b H0 ch delta c_zeta c_P0 a_old fc.L_C fc.hLC)
      (P_admissible_scaled_mul_M hw fc.clock b H0 ch delta c_zeta c_P0 a_old fc.L_C)
      (q + phaseShift)
    have hshift : q + phaseShift + 1 = q + 1 + phaseShift := by omega
    rw [hshift] at hraw
    have hraw_i := congr_fun hraw (rotEquiv.symm i)
    exact hmap.trans hraw_i
  have hboundary_biased : ∀ q : ℕ,
      wordScore aLift.clock.G (sBiased q) (phaseWord q) = sBiased (q + 1) := by
    intro q
    ext i
    change wordScore aLift.clock.G
      (fun j => sInit q j + admissibleTieRemovalBias hw fc b H0 ch delta c_zeta c_P0 a_old rank phaseShift j)
      (phaseWord q) i =
      sInit (q + 1) i + admissibleTieRemovalBias hw fc b H0 ch delta c_zeta c_P0 a_old rank phaseShift i
    rw [wordScore_add_bias]
    congr 1
    exact congr_fun (hboundary q) i
  let i0 : Fin aLift.clock.m := defaultAct
  have hact : (phaseWord p)[0]'(hcount p) = i0 :=
    admissible_phaseWord_head_eq_zero fc.clock parentWord (p + phaseShift) (hcount p)
  have htraj_at := wordPhaseTrajectory_at_phase_start phaseWord defaultAct hcount p
  have hact_0 : wordPhaseAct phaseWord defaultAct p 0 = i0 := by
    unfold wordPhaseAct
    rw [dif_pos (hcount p)]
    exact hact
  rw [hact_0] at htraj_at
  rw [htraj_at]
  have hcum := wordPhaseTrajectory_cumScore_at_phase_start aLift.clock.G
    (canonicalSetupVec (sBiased 0)) (canonicalScoreShift (sBiased 0)) sBiased phaseWord defaultAct
    hcount (fun _ => rfl) hboundary_biased p i0
  rw [hcum]
  have hsinit_i0 : sInit p i0 =
      dotProduct (zeta_admissible_scaled fc.clock b H0 ch delta c_zeta) (binomBasis (k + 1) (p + phaseShift)) := by
    dsimp only [sInit, i0, defaultAct]
    exact admissibleInitScoreVec_zero hw fc b H0 ch delta c_zeta c_P0 a_old (p + phaseShift)
  have h0 : 0 + phaseShift = phaseShift := by omega
  have hsBiased_i0 : sBiased p i0 =
      dotProduct (zeta_admissible_scaled fc.clock b H0 ch delta c_zeta) (binomBasis (k + 1) (p + phaseShift)) +
      admissibleTieRemovalBias hw fc b H0 ch delta c_zeta c_P0 a_old rank phaseShift i0 := by
    change sInit p i0 + admissibleTieRemovalBias hw fc b H0 ch delta c_zeta c_P0 a_old rank phaseShift i0 = _
    rw [hsinit_i0]
  have hshift_def : admissibleBiasedScoreShift hw fc b H0 ch delta c_zeta c_P0 a_old rank phaseShift =
      admissibleTieRemovalBias hw fc b H0 ch delta c_zeta c_P0 a_old rank phaseShift i0 +
      canonicalScoreShift (sBiased 0) := by
    dsimp only [admissibleBiasedScoreShift, i0, defaultAct, sBiased]
    rw [h0]
  rw [hsBiased_i0, hshift_def]
  ring

/-- Grounded four-stage scaled admissible lift specification with priority tie-breaking. -/
structure AdmissibleLiftSpec {k : ℕ} (hw : 2 ≤ k) (fc : FullRankClock k)
    (b : Fin fc.clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (fc.clock.m + 1) → ℚ) where
  phaseShift : ℕ
  parentWord : ℕ → List (Fin fc.clock.m)
  hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis k σ)
  m_rank : ℕ
  hm_rank : 0 < m_rank
  rank : Fin (admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old).clock.m → Fin m_rank
  hpriority_raw : ∀ p : ℕ,
    IsValidPriorityWord
      (liftedGameMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        (P_admissible_scaled fc.clock b H0 ch delta c_zeta c_P0 a_old fc.L_C)
        (J_admissible_scaled fc.clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        (J_admissible_scaled fc.clock b H0 ch delta c_zeta)
        (S_admissible fc.clock b H0 ch delta)
        (X_gateway fc.clock) (M_coupled k)
        (zeta_admissible_scaled fc.clock b H0 ch delta c_zeta)).mulVec (binomBasis (k + 1) (p + phaseShift)))
      (fun i => rank ((rotLeaderEquiv (fc.clock.m + 1) ((k + 1) + (k + 1))) i))
      (rawFourStageWord fc.clock parentWord (p + phaseShift))
  c_low : ℚ
  c_high : ℚ
  hc_low_pos : 0 < c_low
  hc_high_pos : 0 < c_high
  hgap_low : ∀ p : ℕ,
    c_low * (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map
      (rotLeaderEquiv (fc.clock.m + 1) ((k + 1) + (k + 1)) : _ ≃ Fin (admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old).clock.m)) (p + 1) : ℚ) ^ k ≤
      (2 * (dotProduct (zeta_admissible_scaled fc.clock b H0 ch delta c_zeta) (binomBasis (k + 1) (p + phaseShift)) +
        admissibleBiasedScoreShift hw fc b H0 ch delta c_zeta c_P0 a_old rank phaseShift)) ^ (k + 1)
  hgap_high : ∀ p : ℕ,
    (2 * (dotProduct (zeta_admissible_scaled fc.clock b H0 ch delta c_zeta) (binomBasis (k + 1) (p + 1 + phaseShift)) +
      admissibleBiasedScoreShift hw fc b H0 ch delta c_zeta c_P0 a_old rank phaseShift)) ^ (k + 1) ≤
      c_high * (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map
        (rotLeaderEquiv (fc.clock.m + 1) ((k + 1) + (k + 1)) : _ ≃ Fin (admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old).clock.m)) p : ℚ) ^ k

/-- Grounded four-stage scaled admissible RealizedClock lift. -/
def RealizedClock.ofAdmissibleLift {k : ℕ} (hw : 2 ≤ k) (fc : FullRankClock k)
    (b : Fin fc.clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (fc.clock.m + 1) → ℚ)
    (spec : AdmissibleLiftSpec hw fc b H0 ch delta c_zeta c_P0 a_old) : RealizedClock (k + 1) :=
  let aLift := admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old
  let rotEquiv := rotLeaderEquiv (fc.clock.m + 1) ((k + 1) + (k + 1))
  let defaultAct : Fin aLift.clock.m := ⟨0, by
    have := admissibleScaledFullRankLift_m_pos hw fc b H0 ch delta c_zeta c_P0 a_old
    omega⟩
  let rawWord : ℕ → List (Fin (fc.clock.m + 1) ⊕ Fin ((k + 1) + (k + 1))) := fun p : ℕ =>
    rawFourStageWord fc.clock spec.parentWord (p + spec.phaseShift)
  let phaseWord : ℕ → List (Fin aLift.clock.m) := fun p : ℕ =>
    (rawWord p).map rotEquiv
  let sInit : ℕ → Fin aLift.clock.m → ℚ := fun p =>
    admissibleInitScoreVec hw fc b H0 ch delta c_zeta c_P0 a_old (p + spec.phaseShift)
  let sBiased : ℕ → Fin aLift.clock.m → ℚ := fun p =>
    admissibleBiasedInitScoreVec hw fc b H0 ch delta c_zeta c_P0 a_old spec.rank spec.phaseShift (p + spec.phaseShift)
  have hcount : ∀ p : ℕ, 0 < (phaseWord p).length := by
    intro p
    change 0 < ((rawWord p).map rotEquiv).length
    rw [List.length_map]
    dsimp only [rawWord, rawFourStageWord]
    simp only [List.length_append, List.length_singleton]
    omega
  have hboundary : ∀ p : ℕ,
      wordScore aLift.clock.G (sInit p) (phaseWord p) = sInit (p + 1) := by
    intro p
    ext i
    have hmap := wordScore_map_equiv rotEquiv
      (liftedGameMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        (P_admissible_scaled fc.clock b H0 ch delta c_zeta c_P0 a_old fc.L_C)
        (J_admissible_scaled fc.clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        (J_admissible_scaled fc.clock b H0 ch delta c_zeta)
        (S_admissible fc.clock b H0 ch delta)
        (X_gateway fc.clock) (M_coupled k)
        (zeta_admissible_scaled fc.clock b H0 ch delta c_zeta)).mulVec (binomBasis (k + 1) (p + spec.phaseShift)))
      (rawWord p) i
    have hraw := wordScore_rawFourStageWord fc.clock spec.parentWord spec.hparent_count
      (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
      (P_admissible_scaled fc.clock b H0 ch delta c_zeta c_P0 a_old fc.L_C)
      (J_admissible_scaled fc.clock b H0 ch delta c_zeta)
      (S_admissible fc.clock b H0 ch delta)
      (zeta_admissible_scaled fc.clock b H0 ch delta c_zeta)
      (P_admissible_scaled_transpose_mul_X fc.clock b H0 ch delta c_zeta c_P0 a_old fc.L_C fc.hLC)
      (P_admissible_scaled_mul_M hw fc.clock b H0 ch delta c_zeta c_P0 a_old fc.L_C)
      (p + spec.phaseShift)
    have hshift : p + spec.phaseShift + 1 = p + 1 + spec.phaseShift := by omega
    rw [hshift] at hraw
    have hraw_i := congr_fun hraw (rotEquiv.symm i)
    exact hmap.trans hraw_i
  have hpriority : ∀ p : ℕ,
      IsValidPriorityWord aLift.clock.G (sInit p) spec.rank (phaseWord p) := by
    intro p
    have hequiv := isValidPriorityWord_map_equiv rotEquiv
      (liftedGameMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        (P_admissible_scaled fc.clock b H0 ch delta c_zeta c_P0 a_old fc.L_C)
        (J_admissible_scaled fc.clock b H0 ch delta c_zeta))
      _ (fun i => spec.rank (rotEquiv i)) (rawWord p) (spec.hpriority_raw p)
    have hrank_eq : (fun j => spec.rank (rotEquiv (rotEquiv.symm j))) = spec.rank := by
      ext j
      simp only [Equiv.apply_symm_apply]
    rw [hrank_eq] at hequiv
    exact hequiv
  have h0_phase : 0 + spec.phaseShift = spec.phaseShift := by omega
  have hsInit0 : sInit 0 = admissibleInitScoreVec hw fc b H0 ch delta c_zeta c_P0 a_old spec.phaseShift := by
    dsimp only [sInit]
    rw [h0_phase]
  have hstrict_pair := priority_phase_family_canonical_strict
    aLift.clock.G sInit spec.rank phaseWord spec.hm_rank hboundary hpriority
  have hvalid : ∀ p : ℕ,
      IsValidStrictWord aLift.clock.G (sBiased p) (phaseWord p) := by
    intro p
    have hv := hstrict_pair.1 p
    rw [hsInit0] at hv
    exact hv
  have hboundary_biased : ∀ p : ℕ,
      wordScore aLift.clock.G (sBiased p) (phaseWord p) = sBiased (p + 1) := by
    intro p
    have hb := hstrict_pair.2 p
    rw [hsInit0] at hb
    exact hb
  have hword_pos : ∀ (p v : ℕ) (hv : v < (phaseWord p).length),
      0 < wordScore aLift.clock.G (sBiased p) ((phaseWord p).take v) ((phaseWord p)[v]) +
          canonicalScoreShift (sBiased 0) :=
    wordScore_add_canonicalScoreShift_pos aLift.clock.G aLift.clock.hskew
      sBiased phaseWord hcount hboundary_biased hvalid
  have hstrict :
      IsStrictFPTrajectory (setupMatrix aLift.clock.G (canonicalSetupVec (sBiased 0)))
        (wordPhaseTrajectory phaseWord defaultAct) :=
    word_phase_unroll_isStrictFPTrajectory
      aLift.clock.G (canonicalSetupVec (sBiased 0)) (canonicalScoreShift (sBiased 0))
      sBiased phaseWord defaultAct
      hcount (canonicalSetupVec_nonneg (sBiased 0))
      (fun i => rfl)
      hboundary_biased hvalid hword_pos
  have hskew : IsSkewSymmetric (setupMatrix aLift.clock.G (canonicalSetupVec (sBiased 0))) :=
    setupMatrix_skewSymmetric aLift.clock.hskew (canonicalSetupVec (sBiased 0))
  have hpt_zero := wordPhaseStartStep_zero phaseWord
  have hpt_lt := wordPhaseStartStep_strictMono phaseWord hcount
  have hleader : ∀ p : ℕ, ∃ i0 : Fin aLift.clock.m,
      wordPhaseTrajectory phaseWord defaultAct (wordPhaseStartStep phaseWord p) = some i0 := by
    intro p
    exact ⟨wordPhaseAct phaseWord defaultAct p 0, wordPhaseTrajectory_at_phase_start phaseWord defaultAct hcount p⟩
  { fc := aLift
    setupVec := canonicalSetupVec (sBiased 0)
    phaseShift := spec.phaseShift
    scoreShift := canonicalScoreShift (sBiased 0)
    A_adm := 0
    hA_adm_nonneg := le_rfl
    hsetup_nonneg := canonicalSetupVec_nonneg (sBiased 0)
    trajectory := wordPhaseTrajectory phaseWord defaultAct
    phaseTime := wordPhaseStartStep phaseWord
    htraj_zero := rfl
    hstrict := hstrict
    hphaseTime_zero := hpt_zero
    hphaseTime_lt := hpt_lt
    hphase_leader := hleader
    c_low := spec.c_low
    c_high := spec.c_high
    hc_low_pos := spec.hc_low_pos
    hc_high_pos := spec.hc_high_pos
    hgap_bounds := fun t ht => by
      have hgap_l : ∀ p : ℕ,
        spec.c_low * (wordPhaseStartStep phaseWord (p + 1) : ℚ) ^ k ≤
          (2 * cumScore (setupMatrix aLift.clock.G (canonicalSetupVec (sBiased 0)))
            (wordPhaseTrajectory phaseWord defaultAct)
            (wordPhaseStartStep phaseWord p)
            (wordPhaseTrajectory phaseWord defaultAct (wordPhaseStartStep phaseWord p))) ^ (k + 1) := by
        intro p
        have hcs := admissible_biased_phaseStart_cumScore_eq hw fc b H0 ch delta c_zeta c_P0 a_old
          spec.parentWord spec.hparent_count spec.rank spec.phaseShift p
        rw [hcs]
        exact spec.hgap_low p
      have hgap_h : ∀ p : ℕ,
        (2 * cumScore (setupMatrix aLift.clock.G (canonicalSetupVec (sBiased 0)))
          (wordPhaseTrajectory phaseWord defaultAct)
          (wordPhaseStartStep phaseWord (p + 1))
          (wordPhaseTrajectory phaseWord defaultAct (wordPhaseStartStep phaseWord (p + 1)))) ^ (k + 1) ≤
          spec.c_high * (wordPhaseStartStep phaseWord p : ℚ) ^ k := by
        intro p
        have hcs := admissible_biased_phaseStart_cumScore_eq hw fc b H0 ch delta c_zeta c_P0 a_old
          spec.parentWord spec.hparent_count spec.rank spec.phaseShift (p + 1)
        rw [hcs]
        exact spec.hgap_high p
      exact all_integer_time_power_gap_bounds hskew hstrict hpt_zero hpt_lt
        (Nat.le_add_left 1 k) hgap_l hgap_h t ht }

/-- Underlying full-rank clock of `RealizedClock.ofAdmissibleLift`. -/
theorem RealizedClock.ofAdmissibleLift_fc {k : ℕ} (hw : 2 ≤ k) (fc : FullRankClock k)
    (b : Fin fc.clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (fc.clock.m + 1) → ℚ)
    (spec : AdmissibleLiftSpec hw fc b H0 ch delta c_zeta c_P0 a_old) :
    (RealizedClock.ofAdmissibleLift hw fc b H0 ch delta c_zeta c_P0 a_old spec).fc =
      admissibleScaledFullRankLift hw fc b H0 ch delta c_zeta c_P0 a_old :=
  rfl

/-- Recursive family of realized clocks from four-stage scaled admissible lifts. -/
def admissibleRealizedClockFamily (H0 ch delta c_zeta c_P0 : ℕ → ℚ)
    (lifts : ∀ d : ℕ,
      AdmissibleLiftSpec (by omega)
        (admissibleFullRankClockFamily H0 ch delta c_zeta c_P0 d)
        ⟨0, admissibleFullRankClockFamily_pos H0 ch delta c_zeta c_P0 d⟩
        (H0 d) (ch d) (delta d) (c_zeta d) (c_P0 d) (fun _ => 1)) :
    ∀ d : ℕ, RealizedClock (d + 2)
  | 0 => rpsRealizedClock
  | d + 1 =>
      RealizedClock.ofAdmissibleLift (by omega)
        (admissibleFullRankClockFamily H0 ch delta c_zeta c_P0 d)
        ⟨0, admissibleFullRankClockFamily_pos H0 ch delta c_zeta c_P0 d⟩
        (H0 d) (ch d) (delta d) (c_zeta d) (c_P0 d) (fun _ => 1) (lifts d)

/-- Underlying full-rank clocks of `admissibleRealizedClockFamily`. -/
theorem admissibleRealizedClockFamily_fc (H0 ch delta c_zeta c_P0 : ℕ → ℚ)
    (lifts : ∀ d : ℕ,
      AdmissibleLiftSpec (by omega)
        (admissibleFullRankClockFamily H0 ch delta c_zeta c_P0 d)
        ⟨0, admissibleFullRankClockFamily_pos H0 ch delta c_zeta c_P0 d⟩
        (H0 d) (ch d) (delta d) (c_zeta d) (c_P0 d) (fun _ => 1)) (d : ℕ) :
    (admissibleRealizedClockFamily H0 ch delta c_zeta c_P0 lifts d).fc =
      admissibleFullRankClockFamily H0 ch delta c_zeta c_P0 d := by
  cases d <;> rfl

/-- Dimension theorem for `admissibleRealizedClockFamily`: $m_{d+2} = (d + 3)^2 - 6$. -/
theorem admissibleRealizedClockFamily_m (H0 ch delta c_zeta c_P0 : ℕ → ℚ)
    (lifts : ∀ d : ℕ,
      AdmissibleLiftSpec (by omega)
        (admissibleFullRankClockFamily H0 ch delta c_zeta c_P0 d)
        ⟨0, admissibleFullRankClockFamily_pos H0 ch delta c_zeta c_P0 d⟩
        (H0 d) (ch d) (delta d) (c_zeta d) (c_P0 d) (fun _ => 1)) (d : ℕ) :
    (admissibleRealizedClockFamily H0 ch delta c_zeta c_P0 lifts d).fc.clock.m = (d + 3) ^ 2 - 6 := by
  rw [admissibleRealizedClockFamily_fc]
  exact admissibleFullRankClockFamily_m H0 ch delta c_zeta c_P0 d

/-- **All-Orders Realized Clock Theorem on Admissible Clock Lifts (`all_orders_admissible_realized_karlin_theorem`)**:
    Carrying `RealizedClock.ofAdmissibleLift` recursively from `rpsRealizedClock` along
    a family of grounded four-stage scaled admissible lift specifications `lifts` yields, for every
    order $k \ge 2$, an explicit `rc : RealizedClock k` (`admissibleRealizedClockFamily H0 ch delta c_zeta c_P0 lifts (k - 2)`)
    whose underlying full-rank clock is `admissibleFullRankClockFamily H0 ch delta c_zeta c_P0 (k - 2)`,
    having zero algebraic shortcuts: rotated leader action 0, non-zero linear height row, and cone-calibrated P0. -/
theorem all_orders_admissible_realized_karlin_theorem (H0 ch delta c_zeta c_P0 : ℕ → ℚ)
    (lifts : ∀ d : ℕ,
      AdmissibleLiftSpec (by omega)
        (admissibleFullRankClockFamily H0 ch delta c_zeta c_P0 d)
        ⟨0, admissibleFullRankClockFamily_pos H0 ch delta c_zeta c_P0 d⟩
        (H0 d) (ch d) (delta d) (c_zeta d) (c_P0 d) (fun _ => 1))
    (k : ℕ) (hk : 2 ≤ k) :
    ∃ (rc : RealizedClock k),
      rc.fc.clock.m = (k + 1) ^ 2 - 6 ∧
      Fintype.card (Option (Fin rc.fc.clock.m)) = (k + 1) ^ 2 - 5 ∧
      IsSkewSymmetric rc.gameMatrix ∧
      rc.fc.clock.C.transpose * rc.fc.L_C = 1 ∧
      rc.trajectory 0 = none ∧
      IsStrictFPTrajectory rc.gameMatrix rc.trajectory ∧
      IsStrictTwoPlayerFPTrajectory rc.gameMatrix rc.trajectory rc.trajectory ∧
      (∀ rowPlay colPlay : ℕ → Option (Fin rc.fc.clock.m),
        IsWeakTwoPlayerFPTrajectory rc.gameMatrix rowPlay colPlay →
        rowPlay 0 = none → colPlay 0 = none →
        ∀ t : ℕ, rowPlay t = rc.trajectory t ∧ colPlay t = rc.trajectory t) ∧
      0 < rc.c_low ∧
      0 < rc.c_high ∧
      (∀ t : ℕ, 1 ≤ t →
        rc.c_low ≤
          standardDualityGap rc.gameMatrix rc.trajectory rc.trajectory t ^ k * (t : ℚ) ∧
        standardDualityGap rc.gameMatrix rc.trajectory rc.trajectory t ^ k * (t : ℚ) ≤
          rc.c_high) := by
  obtain ⟨d, rfl⟩ : ∃ d : ℕ, k = d + 2 := ⟨k - 2, by omega⟩
  let rc := admissibleRealizedClockFamily H0 ch delta c_zeta c_P0 lifts d
  have hm : rc.fc.clock.m = (d + 2 + 1) ^ 2 - 6 := by
    exact admissibleRealizedClockFamily_m H0 ch delta c_zeta c_P0 lifts d
  have hcard : Fintype.card (Option (Fin rc.fc.clock.m)) = (d + 2 + 1) ^ 2 - 5 := by
    rw [rc.totalDim_eq, hm]
    have h9 : 9 ≤ (d + 3) ^ 2 := by
      calc 9 ≤ d ^ 2 + 6 * d + 9 := by omega
        _ = (d + 3) ^ 2 := by ring
    change (d + 3) ^ 2 - 6 + 1 = (d + 3) ^ 2 - 5
    omega
  refine ⟨rc, hm, hcard, rc.gameMatrix_skew, rc.fc.hLC,
    rc.htraj_zero, rc.hstrict, rc.isStrictTwoPlayerFP, rc.unique_trajectory,
    rc.hc_low_pos, rc.hc_high_pos, rc.hgap_bounds⟩

/-- **Complete Paper Formalization Synthesis for Admissible Clock Lifts (`admissible_paper_formalization_synthesis`)**:
    Exports the unconditional full-rank clock family and realized clock family on the paper-faithful admissible lift. -/
theorem admissible_paper_formalization_synthesis (H0 ch delta c_zeta c_P0 : ℕ → ℚ) :
    (∀ k : ℕ, 2 ≤ k →
      ∃ (fc : FullRankClock k),
        fc.clock.m = (k + 1) ^ 2 - 6 ∧
        Fintype.card (Option (Fin fc.clock.m)) = (k + 1) ^ 2 - 5 ∧
        IsSkewSymmetric fc.clock.G ∧
        fc.clock.C.transpose * fc.L_C = 1) ∧
    ((∀ d : ℕ,
        AdmissibleLiftSpec (by omega)
          (admissibleFullRankClockFamily H0 ch delta c_zeta c_P0 d)
          ⟨0, admissibleFullRankClockFamily_pos H0 ch delta c_zeta c_P0 d⟩
          (H0 d) (ch d) (delta d) (c_zeta d) (c_P0 d) (fun _ => 1)) →
      ∀ k : ℕ, 2 ≤ k →
        ∃ (rc : RealizedClock k),
          rc.fc.clock.m = (k + 1) ^ 2 - 6 ∧
          Fintype.card (Option (Fin rc.fc.clock.m)) = (k + 1) ^ 2 - 5 ∧
          IsStrictTwoPlayerFPTrajectory rc.gameMatrix rc.trajectory rc.trajectory ∧
          ∀ t : ℕ, 1 ≤ t →
            rc.c_low ≤
              standardDualityGap rc.gameMatrix rc.trajectory rc.trajectory t ^ k * (t : ℚ) ∧
            standardDualityGap rc.gameMatrix rc.trajectory rc.trajectory t ^ k * (t : ℚ) ≤
              rc.c_high) := by
  refine ⟨fun k hk => ?_, fun lifts k hk => ?_⟩
  · obtain ⟨d, rfl⟩ : ∃ d : ℕ, k = d + 2 := ⟨k - 2, by omega⟩
    let fc := admissibleFullRankClockFamily H0 ch delta c_zeta c_P0 d
    have hm : fc.clock.m = (d + 2 + 1) ^ 2 - 6 := admissibleFullRankClockFamily_m H0 ch delta c_zeta c_P0 d
    have hcard : Fintype.card (Option (Fin fc.clock.m)) = (d + 2 + 1) ^ 2 - 5 := by
      simp only [Fintype.card_option, Fintype.card_fin, hm]
      have h9 : 9 ≤ (d + 3) ^ 2 := by
        calc 9 ≤ d ^ 2 + 6 * d + 9 := by omega
          _ = (d + 3) ^ 2 := by ring
      change (d + 3) ^ 2 - 6 + 1 = (d + 3) ^ 2 - 5
      omega
    exact ⟨fc, hm, hcard, fc.clock.hskew, fc.hLC⟩
  · obtain ⟨rc, hm, hcard, hskew, hLC, h0, hstrict, h2p, huniq, hlow_pos, hhigh_pos, hgap⟩ :=
      all_orders_admissible_realized_karlin_theorem H0 ch delta c_zeta c_P0 lifts k hk
    exact ⟨rc, hm, hcard, h2p, hgap⟩

/-!
## 8. Canonical Ceiling Scale and Leader-Preserving Bundle Score Evolution
-/

/-- Canonical ceiling scaling constant guaranteeing `1 ≤ zeta_admissible_scaled c` for all `c`
    and `(4(w+1))⁻¹ ≤ J_admissible_scaled a b` for all `b < a`. -/
def canonicalCZeta_admissible {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) : ℚ :=
  1 + |dc_admissible clock b H0 ch delta| +
    4 * (w + 1 : ℚ) * ∑ a : Fin ((w + 1) + (w + 1)), ∑ b_idx : Fin ((w + 1) + (w + 1)),
      |J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx|

/-- The canonical ceiling scaling constant is at least 1. -/
theorem one_le_canonicalCZeta_admissible {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) :
    1 ≤ canonicalCZeta_admissible clock b H0 ch delta := by
  unfold canonicalCZeta_admissible
  have h1 : 0 ≤ |dc_admissible clock b H0 ch delta| := abs_nonneg _
  have h2 : 0 ≤ 4 * (w + 1 : ℚ) := by positivity
  have h3 : 0 ≤ ∑ a : Fin ((w + 1) + (w + 1)), ∑ b_idx : Fin ((w + 1) + (w + 1)),
      |J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx| := by
    refine Finset.sum_nonneg fun a _ => ?_
    refine Finset.sum_nonneg fun b_idx _ => ?_
    exact abs_nonneg _
  have h4 : 0 ≤ 4 * (w + 1 : ℚ) * ∑ a, ∑ b_idx, |J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx| :=
    mul_nonneg h2 h3
  linarith

/-- Every coordinate of the scaled admissible ceiling vector is at least 1 under `canonicalCZeta_admissible`. -/
theorem zeta_admissible_scaled_canonicalCZeta_ge_one {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) (c : Fin (w + 1)) :
    1 ≤ zeta_admissible_scaled clock b H0 ch delta (canonicalCZeta_admissible clock b H0 ch delta) c := by
  unfold zeta_admissible_scaled zeta_admissible zeta_coupled canonicalCZeta_admissible
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, mul_one]
  have h_sum_nonneg : 0 ≤ 4 * (w + 1 : ℚ) * ∑ a, ∑ b_idx, |J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx| := by
    have h2 : 0 ≤ 4 * (w + 1 : ℚ) := by positivity
    have h3 : 0 ≤ ∑ a : Fin ((w + 1) + (w + 1)), ∑ b_idx : Fin ((w + 1) + (w + 1)),
        |J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx| :=
      Finset.sum_nonneg fun a _ => Finset.sum_nonneg fun b_idx _ => abs_nonneg _
    exact mul_nonneg h2 h3
  have h_abs : -dc_admissible clock b H0 ch delta ≤ |dc_admissible clock b H0 ch delta| := neg_le_abs _
  by_cases hc : c.val = 1
  · have he1 : e1_row (w + 1) c = 1 := by
      unfold e1_row
      rw [if_pos hc]
    rw [he1]
    linarith
  · have he1 : e1_row (w + 1) c = 0 := by
      unfold e1_row
      rw [if_neg hc]
    rw [he1]
    have h_abs_pos : 0 ≤ |dc_admissible clock b H0 ch delta| := abs_nonneg _
    linarith

/-- Strict subdiagonal positivity of `J_admissible_scaled` when `c_zeta` dominates `J_general`. -/
theorem J_admissible_scaled_subdiag_pos {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta : ℚ)
    (hc_zeta : 0 ≤ c_zeta := by positivity)
    (a b_idx : Fin ((w + 1) + (w + 1))) (hab : b_idx.val < a.val)
    (hdom : -((c_zeta - 1) * (4 * (w + 1 : ℚ))⁻¹) ≤ J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx) :
    (4 * (w + 1 : ℚ))⁻¹ ≤ J_admissible_scaled clock b H0 ch delta c_zeta a b_idx ∧
      0 < J_admissible_scaled clock b H0 ch delta c_zeta a b_idx := by
  have hJ := (J_coupled_subdiag_ge w a b_idx hab).1
  have hpos : 0 < (4 * (w + 1 : ℚ))⁻¹ := by positivity
  dsimp only [J_admissible_scaled]
  simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
  have h1 : (4 * (w + 1 : ℚ))⁻¹ ≤ J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx + c_zeta * J_coupled w a b_idx := by
    have h_prod : c_zeta * (4 * (w + 1 : ℚ))⁻¹ ≤ c_zeta * J_coupled w a b_idx :=
      mul_le_mul_of_nonneg_left hJ hc_zeta
    linarith
  have h2 : 0 < J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx + c_zeta * J_coupled w a b_idx := by
    linarith
  exact ⟨h1, h2⟩

/-- Strict subdiagonal positivity of `J_admissible_scaled` holds unconditionally under `canonicalCZeta_admissible`. -/
theorem J_admissible_scaled_canonicalCZeta_subdiag_pos {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) (a b_idx : Fin ((w + 1) + (w + 1))) (hab : b_idx.val < a.val) :
    (4 * (w + 1 : ℚ))⁻¹ ≤ J_admissible_scaled clock b H0 ch delta (canonicalCZeta_admissible clock b H0 ch delta) a b_idx ∧
      0 < J_admissible_scaled clock b H0 ch delta (canonicalCZeta_admissible clock b H0 ch delta) a b_idx := by
  have hc_nonneg : 0 ≤ canonicalCZeta_admissible clock b H0 ch delta := by
    have := one_le_canonicalCZeta_admissible clock b H0 ch delta
    linarith
  have hdom : -((canonicalCZeta_admissible clock b H0 ch delta - 1) * (4 * (w + 1 : ℚ))⁻¹) ≤
      J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx := by
    have h_single : |J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx| ≤
        ∑ a' : Fin ((w + 1) + (w + 1)), ∑ b' : Fin ((w + 1) + (w + 1)),
          |J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a' b'| := by
      have h_inner : |J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx| ≤
          ∑ b' : Fin ((w + 1) + (w + 1)), |J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b'| :=
        Finset.single_le_sum (fun b' _ => abs_nonneg (J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b')) (Finset.mem_univ b_idx)
      have h_outer : (∑ b' : Fin ((w + 1) + (w + 1)), |J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b'|) ≤
          ∑ a' : Fin ((w + 1) + (w + 1)), ∑ b' : Fin ((w + 1) + (w + 1)),
            |J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a' b'| :=
        Finset.single_le_sum (fun a' _ => Finset.sum_nonneg fun b' _ => abs_nonneg (J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a' b')) (Finset.mem_univ a)
      exact le_trans h_inner h_outer
    have h_neg : -J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx ≤
        |J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx| := neg_le_abs _
    have h_le_sum : -J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx ≤
        ∑ a' : Fin ((w + 1) + (w + 1)), ∑ b' : Fin ((w + 1) + (w + 1)),
          |J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a' b'| :=
      le_trans h_neg h_single
    have h_mul_le : 4 * (w + 1 : ℚ) * (-J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx) ≤
        4 * (w + 1 : ℚ) * ∑ a', ∑ b', |J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a' b'| :=
      mul_le_mul_of_nonneg_left h_le_sum (by positivity)
    have h_step : 4 * (w + 1 : ℚ) * (-J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx) ≤
        canonicalCZeta_admissible clock b H0 ch delta - 1 := by
      unfold canonicalCZeta_admissible
      have h_abs_dc : 0 ≤ |dc_admissible clock b H0 ch delta| := abs_nonneg _
      linarith
    have h_step2 : -(canonicalCZeta_admissible clock b H0 ch delta - 1) ≤
        4 * (w + 1 : ℚ) * J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx := by linarith
    have h_step3 : -(canonicalCZeta_admissible clock b H0 ch delta - 1) * (4 * (w + 1 : ℚ))⁻¹ ≤
        (4 * (w + 1 : ℚ) * J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx) * (4 * (w + 1 : ℚ))⁻¹ :=
      mul_le_mul_of_nonneg_right h_step2 (by positivity)
    have h_cancel : (4 * (w + 1 : ℚ) * J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx) * (4 * (w + 1 : ℚ))⁻¹ =
        J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx := by
      have h_ne : 4 * (w + 1 : ℚ) ≠ 0 := by positivity
      calc (4 * (w + 1 : ℚ) * J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx) * (4 * (w + 1 : ℚ))⁻¹
        _ = (J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx * (4 * (w + 1 : ℚ))) * (4 * (w + 1 : ℚ))⁻¹ := by ring
        _ = J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx * ((4 * (w + 1 : ℚ)) * (4 * (w + 1 : ℚ))⁻¹) := by ring
        _ = J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx * 1 := by rw [mul_inv_cancel₀ h_ne]
        _ = J_general w (E_rank2 (F_admissible clock b H0 ch delta)) a b_idx := mul_one _
    rw [h_cancel] at h_step3
    have h_neg_distrib : -(canonicalCZeta_admissible clock b H0 ch delta - 1) * (4 * (w + 1 : ℚ))⁻¹ =
        -((canonicalCZeta_admissible clock b H0 ch delta - 1) * (4 * (w + 1 : ℚ))⁻¹) := by ring
    rw [h_neg_distrib] at h_step3
    exact h_step3
  exact J_admissible_scaled_subdiag_pos clock b H0 ch delta
    (canonicalCZeta_admissible clock b H0 ch delta) hc_nonneg a b_idx hab hdom

/-- Entrywise nonnegativity of `J_admissible_scaled` holds unconditionally under `canonicalCZeta_admissible`. -/
theorem J_admissible_scaled_canonicalCZeta_nonneg {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) (a b_idx : Fin ((w + 1) + (w + 1))) :
    0 ≤ J_admissible_scaled clock b H0 ch delta (canonicalCZeta_admissible clock b H0 ch delta) a b_idx := by
  by_cases hab : a.val ≤ b_idx.val
  · rw [J_admissible_scaled_lower clock b H0 ch delta (canonicalCZeta_admissible clock b H0 ch delta) a b_idx hab]
  · have hlt : b_idx.val < a.val := by omega
    exact le_of_lt (J_admissible_scaled_canonicalCZeta_subdiag_pos clock b H0 ch delta a b_idx hlt).2

/-- Unconditional degree-`w` lower bound on the phase-start ceiling score for the admissible lift. -/
theorem ceiling_canonicalCZeta_admissible_ge_choose {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (q : ℕ) :
    1 + (Nat.choose q w : ℚ) ≤
      dotProduct (zeta_admissible_scaled clock b H0 ch delta (canonicalCZeta_admissible clock b H0 ch delta))
        (binomBasis (w + 1) q) := by
  let f : Fin (w + 1) → ℚ := fun c =>
    zeta_admissible_scaled clock b H0 ch delta (canonicalCZeta_admissible clock b H0 ch delta) c * binomBasis (w + 1) q c
  have hf_nonneg : ∀ c : Fin (w + 1), 0 ≤ f c := by
    intro c
    dsimp only [f]
    have h1 : 0 ≤ zeta_admissible_scaled clock b H0 ch delta (canonicalCZeta_admissible clock b H0 ch delta) c := by
      have := zeta_admissible_scaled_canonicalCZeta_ge_one clock b H0 ch delta c
      linarith
    have h2 : 0 ≤ binomBasis (w + 1) q c := by
      unfold binomBasis
      positivity
    exact mul_nonneg h1 h2
  let c0 : Fin (w + 1) := ⟨0, by omega⟩
  let cw : Fin (w + 1) := ⟨w, by omega⟩
  have h_ne : c0 ≠ cw := by
    intro h
    injection h with hval
    omega
  have h_pair : f c0 + f cw ≤ ∑ c : Fin (w + 1), f c := by
    have h_sub : ({c0, cw} : Finset (Fin (w + 1))) ⊆ Finset.univ := Finset.subset_univ _
    have h_le := Finset.sum_le_sum_of_subset_of_nonneg h_sub (fun c _ _ => hf_nonneg c)
    have h_sum_pair : (∑ c ∈ ({c0, cw} : Finset (Fin (w + 1))), f c) = f c0 + f cw := by
      rw [Finset.sum_pair h_ne]
    rw [h_sum_pair] at h_le
    exact h_le
  have hf_c0 : 1 ≤ f c0 := by
    dsimp only [f, c0]
    have h1 := zeta_admissible_scaled_canonicalCZeta_ge_one clock b H0 ch delta ⟨0, by omega⟩
    have h2 : binomBasis (w + 1) q ⟨0, by omega⟩ = 1 := by
      unfold binomBasis
      simp
    rw [h2, mul_one]
    exact h1
  have hf_cw : (Nat.choose q w : ℚ) ≤ f cw := by
    dsimp only [f, cw]
    have h1 := zeta_admissible_scaled_canonicalCZeta_ge_one clock b H0 ch delta ⟨w, by omega⟩
    have h2 : binomBasis (w + 1) q ⟨w, by omega⟩ = (Nat.choose q w : ℚ) := by
      unfold binomBasis
      simp
    calc (Nat.choose q w : ℚ) = 1 * (Nat.choose q w : ℚ) := by ring
      _ ≤ zeta_admissible_scaled clock b H0 ch delta (canonicalCZeta_admissible clock b H0 ch delta) ⟨w, by omega⟩ *
            (Nat.choose q w : ℚ) := by
        refine mul_le_mul_of_nonneg_right h1 (by positivity)
      _ = f cw := by
        dsimp only [f, cw]
        rw [h2]
  calc 1 + (Nat.choose q w : ℚ) ≤ f c0 + f cw := by linarith
    _ ≤ ∑ c : Fin (w + 1), f c := h_pair
    _ = dotProduct (zeta_admissible_scaled clock b H0 ch delta (canonicalCZeta_admissible clock b H0 ch delta))
          (binomBasis (w + 1) q) := rfl

/-- Entrywise action of `AdjoinLeaderEndpointG` on parent actions recovers parent game `G`. -/
theorem AdjoinLeaderEndpointG_parent_parent {m : ℕ} (G : Matrix (Fin m) (Fin m) ℚ)
    (b : Fin m) (v : Fin m → ℚ) (i j : Fin m) :
    AdjoinLeaderEndpointG G b v (parentToOldAct m i) (parentToOldAct m j) = G i j := by
  simp [parentToOldAct, AdjoinLeaderEndpointG]

/-- Parent actions score evolution across `W_bundle_word` in `AdjoinLeaderEndpointG`. -/
theorem wordScore_bundle_word_old_inl_leader {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (s_old : Fin (clock.m + 1) → ℚ) (c_shift : ℚ) (Q : ℕ)
    (hs_inl : ∀ i : Fin clock.m, s_old (parentToOldAct clock.m i) = clock.R.mulVec (binomBasis w 0) i + c_shift)
    (i : Fin clock.m) :
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v) s_old
      ((W_bundle_word parentWord Q).map (parentToOldAct clock.m))
      (parentToOldAct clock.m i) =
    clock.R.mulVec (binomBasis w Q) i + c_shift := by
  have hinj : Function.Injective (parentToOldAct clock.m) := by
    intro a b_idx hab
    simp only [parentToOldAct, Equiv.apply_eq_iff_eq, Sum.inl.injEq] at hab
    exact hab
  simp only [wordScore, scoreVec, Matrix.mulVec, dotProduct]
  rw [(Equiv.sum_comp finSumFinEquiv fun y => (AdjoinLeaderEndpointG clock.G b clock.v) (parentToOldAct clock.m i) y *
    wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) y).symm]
  rw [Fintype.sum_sum_type]
  have hcount_inr : ∀ v : Fin 1,
      wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inr v)) = 0 := by
    intro v
    unfold wordCountVec
    have hnone : ∀ y ∈ (W_bundle_word parentWord Q).map (parentToOldAct clock.m),
        y ≠ finSumFinEquiv (Sum.inr v) := by
      intro y hy h
      simp only [List.mem_map] at hy
      rcases hy with ⟨j, _, rfl⟩
      simp only [parentToOldAct, Equiv.apply_eq_iff_eq] at h
      contradiction
    exact_mod_cast list_count_eq_zero_of_forall_ne hnone
  simp only [hcount_inr, mul_zero, Finset.sum_const_zero, add_zero]
  have hcount_inl : ∀ j : Fin clock.m,
      wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (parentToOldAct clock.m j) =
      totalPhaseCount clock Q j := by
    intro j
    unfold wordCountVec
    rw [list_count_map_of_injective (parentToOldAct clock.m) hinj (W_bundle_word parentWord Q) j]
    exact wordCountVec_bundle_word parentWord clock rfl hparent_count Q j
  have hsum_j : (∑ j : Fin clock.m, (AdjoinLeaderEndpointG clock.G b clock.v) (parentToOldAct clock.m i) (parentToOldAct clock.m j) *
      wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (parentToOldAct clock.m j)) =
      (clock.G.mulVec (totalPhaseCount clock Q)) i := by
    simp only [Matrix.mulVec, dotProduct]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hcount_inl j, AdjoinLeaderEndpointG_parent_parent clock.G b clock.v i j]
  change s_old (parentToOldAct clock.m i) + (∑ a₁, AdjoinLeaderEndpointG clock.G b clock.v (parentToOldAct clock.m i) (parentToOldAct clock.m a₁) *
    wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (parentToOldAct clock.m a₁)) = _
  rw [hsum_j, hs_inl i]
  have htrans := congr_fun (AlgebraicClock.multi_phase_score_transition clock Q) i
  simp only [scoreVec, Matrix.mulVec, dotProduct] at *
  linarith

/-- Gateway endpoint action score evolution across `W_bundle_word` in `AdjoinLeaderEndpointG`. -/
theorem wordScore_bundle_word_old_inr_leader {w : ℕ} (hw : 0 < w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (s_old : Fin (clock.m + 1) → ℚ) (c_shift delta : ℚ) (Q : ℕ)
    (hs_inr : s_old (gatewayOldAct clock.m) =
      clock.R.mulVec (binomBasis w 0) b + c_shift - (Q : ℚ) + delta) :
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v) s_old
      ((W_bundle_word parentWord Q).map (parentToOldAct clock.m))
      (gatewayOldAct clock.m) =
    clock.R.mulVec (binomBasis w Q) b + c_shift + delta := by
  have hinj : Function.Injective (parentToOldAct clock.m) := by
    intro a b_idx hab
    simp only [parentToOldAct, Equiv.apply_eq_iff_eq, Sum.inl.injEq] at hab
    exact hab
  simp only [wordScore, scoreVec, Matrix.mulVec, dotProduct]
  rw [(Equiv.sum_comp finSumFinEquiv fun y => (AdjoinLeaderEndpointG clock.G b clock.v) (gatewayOldAct clock.m) y *
    wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) y).symm]
  rw [Fintype.sum_sum_type]
  have hcount_inr : ∀ v : Fin 1,
      wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inr v)) = 0 := by
    intro v
    unfold wordCountVec
    have hnone : ∀ y ∈ (W_bundle_word parentWord Q).map (parentToOldAct clock.m),
        y ≠ finSumFinEquiv (Sum.inr v) := by
      intro y hy h
      simp only [List.mem_map] at hy
      rcases hy with ⟨j, _, rfl⟩
      simp only [parentToOldAct, Equiv.apply_eq_iff_eq] at h
      contradiction
    exact_mod_cast list_count_eq_zero_of_forall_ne hnone
  simp only [hcount_inr, mul_zero, Finset.sum_const_zero, add_zero]
  have hcount_inl : ∀ j : Fin clock.m,
      wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (parentToOldAct clock.m j) =
      totalPhaseCount clock Q j := by
    intro j
    unfold wordCountVec
    have hmap := list_count_map_of_injective (parentToOldAct clock.m) hinj (W_bundle_word parentWord Q) j
    rw [hmap]
    exact wordCountVec_bundle_word parentWord clock rfl hparent_count Q j
  have hsum_j : (∑ j : Fin clock.m, (AdjoinLeaderEndpointG clock.G b clock.v) (gatewayOldAct clock.m) (parentToOldAct clock.m j) *
      wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (parentToOldAct clock.m j)) =
      (clock.G.mulVec (totalPhaseCount clock Q)) b + dotProduct clock.v (totalPhaseCount clock Q) := by
    simp only [Matrix.mulVec, dotProduct]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hcount_inl j]
    have hrow := leader_endpoint_row clock.G b clock.v j
    have hg : gatewayOldAct clock.m = finSumFinEquiv (Sum.inr 0) := rfl
    have hp : parentToOldAct clock.m j = finSumFinEquiv (Sum.inl j) := rfl
    rw [hg, hp, hrow]
    ring
  change s_old (gatewayOldAct clock.m) + (∑ a₁, AdjoinLeaderEndpointG clock.G b clock.v (gatewayOldAct clock.m) (parentToOldAct clock.m a₁) *
    wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (parentToOldAct clock.m a₁)) = _
  rw [hsum_j, hs_inr]
  have hcounter := AlgebraicClock.multi_phase_endpoint_counter clock hw Q
  rw [hcounter]
  have htrans := congr_fun (AlgebraicClock.multi_phase_score_transition clock Q) b
  simp only [scoreVec, Matrix.mulVec, dotProduct] at *
  linarith

/-- Gateway takeover over parent actions at bundle completion with explicit leader `b`. -/
theorem gateway_dominates_parent_at_bundle_end_leader {w : ℕ} (hw : 0 < w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (s_old : Fin (clock.m + 1) → ℚ) (c_shift delta : ℚ) (Q : ℕ)
    (hdelta : 0 < delta)
    (hs_inl : ∀ i : Fin clock.m, s_old (parentToOldAct clock.m i) = clock.R.mulVec (binomBasis w 0) i + c_shift)
    (hs_inr : s_old (gatewayOldAct clock.m) =
      clock.R.mulVec (binomBasis w 0) b + c_shift - (Q : ℚ) + delta)
    (i : Fin clock.m)
    (hleader : clock.R.mulVec (binomBasis w Q) i ≤ clock.R.mulVec (binomBasis w Q) b) :
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v) s_old
      ((W_bundle_word parentWord Q).map (parentToOldAct clock.m))
      (parentToOldAct clock.m i) <
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v) s_old
      ((W_bundle_word parentWord Q).map (parentToOldAct clock.m))
      (gatewayOldAct clock.m) := by
  have hinl := wordScore_bundle_word_old_inl_leader clock b parentWord hparent_count s_old c_shift Q hs_inl i
  have hinr := wordScore_bundle_word_old_inr_leader hw clock b parentWord hparent_count s_old c_shift delta Q hs_inr
  rw [hinl, hinr]
  linarith

/-- At degree `Q = 1`, `(shiftRightCount R).mulVec` on parent actions equals `R.mulVec (binomBasis w 0)`. -/
theorem shiftRightCount_mulVec_binomBasis_one {α : Type*} {w : ℕ} (hw : 0 < w)
    (R : Matrix α (Fin w) ℚ) (i : α) :
    (shiftRightCount R).mulVec (binomBasis (w + 1) 1) i = R.mulVec (binomBasis w 0) i := by
  have hw1 : 1 < w + 1 := by omega
  have hL : (shiftRightCount R).mulVec (binomBasis (w + 1) 1) i = R i ⟨0, hw⟩ := by
    simp only [Matrix.mulVec, dotProduct, binomBasis]
    rw [Finset.sum_eq_single ⟨1, hw1⟩]
    · dsimp [shiftRightCount]
      simp only [Nat.choose_self, Nat.cast_one, mul_one]
    · intro j _ hj
      by_cases hj0 : j.val = 0
      · dsimp [shiftRightCount]
        rw [dif_neg (by omega)]
        simp
      · have hj_gt : 1 < j.val := by
          have : j.val ≠ 1 := fun h => hj (by ext; exact h)
          omega
        have : Nat.choose 1 j.val = 0 := Nat.choose_eq_zero_of_lt hj_gt
        simp [this]
    · intro h
      exact False.elim (h (Finset.mem_univ _))
  have hR : R.mulVec (binomBasis w 0) i = R i ⟨0, hw⟩ := by
    simp only [Matrix.mulVec, dotProduct, binomBasis]
    rw [Finset.sum_eq_single ⟨0, hw⟩]
    · simp
    · intro j _ hj
      have hj_pos : 0 < j.val := by
        have : j.val ≠ 0 := fun h => hj (by ext; exact h)
        omega
      have : Nat.choose 0 j.val = 0 := Nat.choose_eq_zero_of_lt hj_pos
      simp [this]
    · intro h
      exact False.elim (h (Finset.mem_univ _))
  rw [hL, hR]

/-- Linear evaluation of `S_admissible` on parent actions under `binomBasis (w + 1) Q`. -/
theorem S_admissible_mulVec_binomBasis_inl {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (Q : ℕ) (i : Fin clock.m) :
    (S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) Q) (parentToOldAct clock.m i) =
      (shiftRightCount clock.R).mulVec (binomBasis (w + 1) Q) i +
        dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) Q) := by
  simp only [Matrix.mulVec, dotProduct, S_admissible, parentToOldAct, Matrix.of_apply,
    Equiv.symm_apply_apply, add_mul]
  rw [Finset.sum_add_distrib]

/-- Evaluation of `S_admissible` on parent actions at degree `Q = 1`. -/
theorem S_admissible_after_reset_inl_eq {w : ℕ} (hw : 0 < w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (i : Fin clock.m) :
    (S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) 1) (parentToOldAct clock.m i) =
      clock.R.mulVec (binomBasis w 0) i +
        dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) 1) := by
  rw [S_admissible_mulVec_binomBasis_inl]
  rw [shiftRightCount_mulVec_binomBasis_one hw clock.R i]

/-- Action of `e1_row` on `binomBasis (w + 1) Q` evaluates to `Q`. -/
theorem e1_row_dot_binomBasis {w : ℕ} (hw : 1 ≤ w) (Q : ℕ) :
    dotProduct (e1_row (w + 1)) (binomBasis (w + 1) Q) = (Q : ℚ) := by
  simp only [dotProduct, e1_row, binomBasis]
  rw [Finset.sum_eq_single ⟨1, by omega⟩]
  · simp [Nat.choose_one_right]
  · intro j _ hj
    have hne : j.val ≠ 1 := by
      intro h
      apply hj
      ext; exact h
    simp [hne]
  · intro h
    exact False.elim (h (Finset.mem_univ _))

/-- Linear evaluation of `S_admissible` on gateway action under `binomBasis (w + 1) Q`. -/
theorem S_admissible_mulVec_binomBasis_inr {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (Q : ℕ) :
    (S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) Q) (gatewayOldAct clock.m) =
      (shiftRightCount clock.R).mulVec (binomBasis (w + 1) Q) b +
        dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) Q) - (Q : ℚ) + delta := by
  simp only [Matrix.mulVec, dotProduct, S_admissible, gatewayOldAct, Matrix.of_apply,
    Equiv.symm_apply_apply]
  have hdistrib : (∑ x : Fin (w + 1),
      (shiftRightCount clock.R b x + h_row_lin w H0 ch x - e1_row (w + 1) x + (if x.val = 0 then delta else 0)) * binomBasis (w + 1) Q x) =
      (∑ x, shiftRightCount clock.R b x * binomBasis (w + 1) Q x) +
      (∑ x, h_row_lin w H0 ch x * binomBasis (w + 1) Q x) -
      (∑ x, e1_row (w + 1) x * binomBasis (w + 1) Q x) +
      (∑ x, (if x.val = 0 then delta else 0) * binomBasis (w + 1) Q x) := by
    rw [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun x _ => by ring
  rw [hdistrib]
  have he1 := e1_row_dot_binomBasis hw Q
  dsimp only [dotProduct] at he1
  rw [he1]
  have he0 : (∑ x : Fin (w + 1), (if x.val = 0 then delta else 0) * binomBasis (w + 1) Q x) = delta := by
    rw [Finset.sum_eq_single ⟨0, by omega⟩]
    · simp [binomBasis]
    · intro j _ hj
      have hj0 : j.val ≠ 0 := by
        intro h
        apply hj
        ext
        exact h
      simp [hj0]
    · intro h
      exact False.elim (h (Finset.mem_univ _))
  rw [he0]

/-- Evaluation of `S_admissible` on gateway action at degree `Q = 1`. -/
theorem S_admissible_after_reset_inr_eq {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    (S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) 1) (gatewayOldAct clock.m) =
      clock.R.mulVec (binomBasis w 0) b +
        dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) 1) - (1 : ℚ) + delta := by
  rw [S_admissible_mulVec_binomBasis_inr hw clock b H0 ch delta 1]
  rw [shiftRightCount_mulVec_binomBasis_one (by omega) clock.R b]
  push_cast
  rfl

/-!
## 9. Paper Unification and Reset-Run Score Evolution

In this section, we establish two fundamental structural properties of the admissible lift:
1. **Unification of `S_paper` and `S_admissible`**: We prove that `S_admissible` and `D_admissible`
   are exact instances of the paper ceiling-matched tables `S_paper` and `D_paper` under the
   linear ceiling vector `zeta_paper_lin`.
2. **Exact Score Evolution Across Reset Stages**: We specialize the 2-stage reset score evolution
   theorems `wordScore_after_reset_stages_inl` and `wordScore_after_reset_stages_inr` to the
   scaled admissible lift clock `admissibleScaledLiftClock`, deriving exact polynomial evaluations
   at the reset-run boundary across parent actions, gateway action, and reset actions.
-/

/-- The paper ceiling vector matching `S_admissible`. -/
def zeta_paper_lin {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m) (H0 ch : ℚ) :
    Fin (w + 1) → ℚ :=
  Matrix.vecMul (fun c => shiftRightCount clock.R b c + h_row_lin w H0 ch c) (1 + N_mat (w + 1))

/-- Backward transformation of `zeta_paper_lin` under `B_mat` recovers the leader's row of `S_admissible`. -/
theorem vecMul_zeta_paper_lin_B_mat {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch : ℚ) :
    Matrix.vecMul (zeta_paper_lin clock b H0 ch) (B_mat (w + 1)) =
      fun c => shiftRightCount clock.R b c + h_row_lin w H0 ch c := by
  dsimp only [zeta_paper_lin]
  rw [Matrix.vecMul_vecMul]
  rw [one_add_N_mul_B_mat (w + 1)]
  rw [Matrix.vecMul_one]

/-- Paper height row for `zeta_paper_lin` coincides with the linear height row `h_row_lin`. -/
theorem h_row_paper_zeta_paper_lin_eq {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch : ℚ) :
    h_row_paper clock b (zeta_paper_lin clock b H0 ch) = h_row_lin w H0 ch := by
  ext c
  dsimp only [h_row_paper]
  rw [vecMul_zeta_paper_lin_B_mat]
  dsimp only
  ring

/-- Exact equivalence between `S_paper` with ceiling `zeta_paper_lin` and `S_admissible`. -/
theorem S_paper_zeta_paper_lin_eq_S_admissible {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) :
    S_paper clock b (zeta_paper_lin clock b H0 ch) delta = S_admissible clock b H0 ch delta := by
  ext x c
  dsimp only [S_paper, S_admissible]
  simp only [Matrix.of_apply]
  cases hx : finSumFinEquiv.symm x with
  | inl i =>
    have h_hrow := congr_fun (h_row_paper_zeta_paper_lin_eq clock b H0 ch) c
    rw [h_hrow]
  | inr v =>
    have h_vec := congr_fun (vecMul_zeta_paper_lin_B_mat clock b H0 ch) c
    rw [h_vec]

/-- Exact equivalence between `D_paper` with ceiling `zeta_paper_lin` and `D_admissible`. -/
theorem D_paper_zeta_paper_lin_eq_D_admissible {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) :
    D_paper clock b (zeta_paper_lin clock b H0 ch) delta = D_admissible clock b H0 ch delta := by
  dsimp only [D_paper, D_admissible]
  rw [S_paper_zeta_paper_lin_eq_S_admissible]

/-- Exact score evolution on old actions after the reset stages `W_early_word ++ W_late_word`. -/
theorem wordScore_after_reset_stages_admissible_inl {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (q : ℕ) (u : Fin (clock.m + 1)) :
    wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
          (J_admissible_scaled clock b H0 ch delta c_zeta)
          (S_admissible clock b H0 ch delta)
          (X_gateway clock) (M_coupled w)
          (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q))
      (W_early_word clock.m w q ++ W_late_word clock.m w q) (Sum.inl u) =
    (S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) (q + 1)) u := by
  have hPM := P_admissible_scaled_mul_M hw clock b H0 ch delta c_zeta c_P0 a_old L_C
  dsimp only [D_admissible] at hPM
  exact wordScore_after_reset_stages_inl clock
    (AdjoinLeaderEndpointG clock.G b clock.v)
    (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
    (J_admissible_scaled clock b H0 ch delta c_zeta)
    (S_admissible clock b H0 ch delta)
    (zeta_admissible_scaled clock b H0 ch delta c_zeta)
    hPM q u

/-- Exact score evolution on parent actions after the reset stages `W_early_word ++ W_late_word`. -/
theorem wordScore_after_reset_stages_admissible_parent {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (q : ℕ) (i : Fin clock.m) :
    wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
          (J_admissible_scaled clock b H0 ch delta c_zeta)
          (S_admissible clock b H0 ch delta)
          (X_gateway clock) (M_coupled w)
          (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q))
      (W_early_word clock.m w q ++ W_late_word clock.m w q) (Sum.inl (parentToOldAct clock.m i)) =
    (shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)) i +
      dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) (q + 1)) := by
  rw [wordScore_after_reset_stages_admissible_inl hw clock b H0 ch delta c_zeta c_P0 a_old L_C q (parentToOldAct clock.m i)]
  rw [S_admissible_mulVec_binomBasis_inl clock b H0 ch delta (q + 1) i]

/-- Exact score evolution on gateway action after the reset stages `W_early_word ++ W_late_word`. -/
theorem wordScore_after_reset_stages_admissible_gateway {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (q : ℕ) :
    wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
          (J_admissible_scaled clock b H0 ch delta c_zeta)
          (S_admissible clock b H0 ch delta)
          (X_gateway clock) (M_coupled w)
          (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q))
      (W_early_word clock.m w q ++ W_late_word clock.m w q) (Sum.inl (gatewayOldAct clock.m)) =
    (shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)) b +
      dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) (q + 1)) - (q + 1 : ℚ) + delta := by
  rw [wordScore_after_reset_stages_admissible_inl hw clock b H0 ch delta c_zeta c_P0 a_old L_C q (gatewayOldAct clock.m)]
  rw [S_admissible_mulVec_binomBasis_inr (by omega) clock b H0 ch delta (q + 1)]
  push_cast
  rfl

/-- Exact score evolution on reset actions after the reset stages `W_early_word ++ W_late_word`. -/
theorem wordScore_after_reset_stages_admissible_inr {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (q : ℕ) (r : Fin ((w + 1) + (w + 1))) :
    wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
          (J_admissible_scaled clock b H0 ch delta c_zeta)
          (S_admissible clock b H0 ch delta)
          (X_gateway clock) (M_coupled w)
          (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q))
      (W_early_word clock.m w q ++ W_late_word clock.m w q) (Sum.inr r) =
    (one_zeta (Fin ((w + 1) + (w + 1))) (zeta_admissible_scaled clock b H0 ch delta c_zeta) -
      (J_admissible_scaled clock b H0 ch delta c_zeta).transpose * M_coupled w).mulVec
        (binomBasis (w + 1) q) r := by
  exact wordScore_after_reset_stages_inr clock
    (AdjoinLeaderEndpointG clock.G b clock.v)
    (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
    (J_admissible_scaled clock b H0 ch delta c_zeta)
    (S_admissible clock b H0 ch delta)
    (zeta_admissible_scaled clock b H0 ch delta c_zeta)
    q r

/-!
## 10. General-Q Stage 3 Score Evolution and All-Q Gateway-vs-Leader Dominance

In this section, we establish the general-`Q` polynomial score evolution across the Stage 3
bundle word `(W_bundle_word parentWord Q).map (parentToOldAct clock.m)` starting from the
degree-`Q` admissible score table `s_old = (S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) Q)`.
We prove:
1. Exact score evolution on every parent action `parentToOldAct clock.m i` for arbitrary `Q : ℕ`.
2. Exact score evolution on the gateway action `gatewayOldAct clock.m` for arbitrary `Q : ℕ`.
3. The exact difference identity showing that at the end of the bundle, the gateway action's score
   minus the explicit leader's score is identically equal to `delta` for all `Q : ℕ`.
-/

/-- General-`Q` score evolution across `W_bundle_word` for parent actions under `S_admissible`. -/
theorem wordScore_bundle_word_admissible_parent_all_Q {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (Q : ℕ) (i : Fin clock.m) :
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v)
      ((S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) Q))
      ((W_bundle_word parentWord Q).map (parentToOldAct clock.m))
      (parentToOldAct clock.m i) =
    (shiftRightCount clock.R).mulVec (binomBasis (w + 1) Q) i +
      (clock.R.mulVec (binomBasis w Q) i - clock.R.mulVec (binomBasis w 0) i) +
      dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) Q) := by
  have hinj : Function.Injective (parentToOldAct clock.m) := by
    intro a b_idx hab
    simp only [parentToOldAct, Equiv.apply_eq_iff_eq, Sum.inl.injEq] at hab
    exact hab
  simp only [wordScore, scoreVec, Matrix.mulVec, dotProduct]
  rw [(Equiv.sum_comp finSumFinEquiv fun y => (AdjoinLeaderEndpointG clock.G b clock.v) (parentToOldAct clock.m i) y *
    wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) y).symm]
  rw [Fintype.sum_sum_type]
  have hcount_inr : ∀ v : Fin 1,
      wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inr v)) = 0 := by
    intro v
    unfold wordCountVec
    have hnone : ∀ y ∈ (W_bundle_word parentWord Q).map (parentToOldAct clock.m),
        y ≠ finSumFinEquiv (Sum.inr v) := by
      intro y hy h
      simp only [List.mem_map] at hy
      rcases hy with ⟨j, _, rfl⟩
      simp only [parentToOldAct, Equiv.apply_eq_iff_eq] at h
      contradiction
    exact_mod_cast list_count_eq_zero_of_forall_ne hnone
  simp only [hcount_inr, mul_zero, Finset.sum_const_zero, add_zero]
  have hcount_inl : ∀ j : Fin clock.m,
      wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (parentToOldAct clock.m j) =
      totalPhaseCount clock Q j := by
    intro j
    unfold wordCountVec
    rw [list_count_map_of_injective (parentToOldAct clock.m) hinj (W_bundle_word parentWord Q) j]
    exact wordCountVec_bundle_word parentWord clock rfl hparent_count Q j
  have hsum_j : (∑ j : Fin clock.m, (AdjoinLeaderEndpointG clock.G b clock.v) (parentToOldAct clock.m i) (parentToOldAct clock.m j) *
      wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (parentToOldAct clock.m j)) =
      (clock.G.mulVec (totalPhaseCount clock Q)) i := by
    simp only [Matrix.mulVec, dotProduct]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hcount_inl j, AdjoinLeaderEndpointG_parent_parent clock.G b clock.v i j]
  change (S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) Q) (parentToOldAct clock.m i) +
    (∑ a₁, AdjoinLeaderEndpointG clock.G b clock.v (parentToOldAct clock.m i) (parentToOldAct clock.m a₁) *
      wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (parentToOldAct clock.m a₁)) = _
  rw [hsum_j, S_admissible_mulVec_binomBasis_inl clock b H0 ch delta Q i]
  have htrans := congr_fun (AlgebraicClock.multi_phase_score_transition clock Q) i
  simp only [scoreVec, Matrix.mulVec, dotProduct] at *
  linarith

/-- General-`Q` score evolution across `W_bundle_word` for gateway action under `S_admissible`. -/
theorem wordScore_bundle_word_admissible_gateway_all_Q {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (Q : ℕ) :
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v)
      ((S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) Q))
      ((W_bundle_word parentWord Q).map (parentToOldAct clock.m))
      (gatewayOldAct clock.m) =
    (shiftRightCount clock.R).mulVec (binomBasis (w + 1) Q) b +
      (clock.R.mulVec (binomBasis w Q) b - clock.R.mulVec (binomBasis w 0) b) +
      dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) Q) + delta := by
  have hinj : Function.Injective (parentToOldAct clock.m) := by
    intro a b_idx hab
    simp only [parentToOldAct, Equiv.apply_eq_iff_eq, Sum.inl.injEq] at hab
    exact hab
  simp only [wordScore, scoreVec, Matrix.mulVec, dotProduct]
  rw [(Equiv.sum_comp finSumFinEquiv fun y => (AdjoinLeaderEndpointG clock.G b clock.v) (gatewayOldAct clock.m) y *
    wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) y).symm]
  rw [Fintype.sum_sum_type]
  have hcount_inr : ∀ v : Fin 1,
      wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inr v)) = 0 := by
    intro v
    unfold wordCountVec
    have hnone : ∀ y ∈ (W_bundle_word parentWord Q).map (parentToOldAct clock.m),
        y ≠ finSumFinEquiv (Sum.inr v) := by
      intro y hy h
      simp only [List.mem_map] at hy
      rcases hy with ⟨j, _, rfl⟩
      simp only [parentToOldAct, Equiv.apply_eq_iff_eq] at h
      contradiction
    exact_mod_cast list_count_eq_zero_of_forall_ne hnone
  simp only [hcount_inr, mul_zero, Finset.sum_const_zero, add_zero]
  have hcount_inl : ∀ j : Fin clock.m,
      wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (parentToOldAct clock.m j) =
      totalPhaseCount clock Q j := by
    intro j
    unfold wordCountVec
    have hmap := list_count_map_of_injective (parentToOldAct clock.m) hinj (W_bundle_word parentWord Q) j
    rw [hmap]
    exact wordCountVec_bundle_word parentWord clock rfl hparent_count Q j
  have hsum_j : (∑ j : Fin clock.m, (AdjoinLeaderEndpointG clock.G b clock.v) (gatewayOldAct clock.m) (parentToOldAct clock.m j) *
      wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (parentToOldAct clock.m j)) =
      (clock.G.mulVec (totalPhaseCount clock Q)) b + dotProduct clock.v (totalPhaseCount clock Q) := by
    simp only [Matrix.mulVec, dotProduct]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hcount_inl j]
    have hrow := leader_endpoint_row clock.G b clock.v j
    have hg : gatewayOldAct clock.m = finSumFinEquiv (Sum.inr 0) := rfl
    have hp : parentToOldAct clock.m j = finSumFinEquiv (Sum.inl j) := rfl
    rw [hg, hp, hrow]
    ring
  change (S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) Q) (gatewayOldAct clock.m) +
    (∑ a₁, AdjoinLeaderEndpointG clock.G b clock.v (gatewayOldAct clock.m) (parentToOldAct clock.m a₁) *
      wordCountVec ((W_bundle_word parentWord Q).map (parentToOldAct clock.m)) (parentToOldAct clock.m a₁)) = _
  rw [hsum_j, S_admissible_mulVec_binomBasis_inr hw clock b H0 ch delta Q]
  have hcounter := AlgebraicClock.multi_phase_endpoint_counter clock (by omega) Q
  rw [hcounter]
  have htrans := congr_fun (AlgebraicClock.multi_phase_score_transition clock Q) b
  simp only [scoreVec, Matrix.mulVec, dotProduct] at *
  linarith

/-- All-`Q` gateway-vs-leader dominance identity at completion of `W_bundle_word`. -/
theorem gateway_sub_leader_at_bundle_end_all_Q {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (Q : ℕ) :
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v)
      ((S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) Q))
      ((W_bundle_word parentWord Q).map (parentToOldAct clock.m))
      (gatewayOldAct clock.m) -
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v)
      ((S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) Q))
      ((W_bundle_word parentWord Q).map (parentToOldAct clock.m))
      (parentToOldAct clock.m b) = delta := by
  have hgw := wordScore_bundle_word_admissible_gateway_all_Q hw clock b H0 ch delta parentWord hparent_count Q
  have hlead := wordScore_bundle_word_admissible_parent_all_Q clock b H0 ch delta parentWord hparent_count Q b
  rw [hgw, hlead]
  ring
/-!
## 11. Algebraic Coupling Decompositions and Linearity

In this section, we establish exact algebraic decomposition lemmas for `P0_cone`, `D_res`,
`Q_reset`, and `P_admissible_scaled`, proving:
1. Annihilation `P0_cone * M_coupled = 0` via early/late reset sign cancellation.
2. Deficit residual invariance `D_res D (c_P0 • P0_cone) M_coupled = D`.
3. Additive and scalar linearity of `Q_reset` in `(J, zeta)`, yielding the exact decomposition
   of `Q_reset` for the scaled admissible lift into its general and coupled components.
4. Exact simplified formula for `P_admissible_scaled` via residual cancellation, and its
   three-term affine-linear decomposition in `c_zeta` and `c_P0`.
-/

/-- Annihilation of the cone-calibrated coupling matrix against the coupled count matrix. -/
theorem P0_cone_mul_M_coupled {m w : ℕ} (a_old : Fin (m + 1) → ℚ) :
    P0_cone a_old w * M_coupled w = 0 := by
  ext x c
  simp only [Matrix.mul_apply, Matrix.zero_apply]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun y : Fin ((w + 1) + (w + 1)) =>
      P0_cone a_old w x y * M_coupled w y c).symm
  rw [hcomp, Fintype.sum_sum_type]
  have h_inl : (∑ i : Fin (w + 1), P0_cone a_old w x (finSumFinEquiv (Sum.inl i)) *
      M_coupled w (finSumFinEquiv (Sum.inl i)) c) =
      - ∑ i : Fin (w + 1), a_old x * W_coupled w i c := by
    simp only [P0_cone, M_coupled, Matrix.of_apply, Equiv.symm_apply_apply, neg_mul]
    rw [← Finset.sum_neg_distrib]
  have h_inr : (∑ i : Fin (w + 1), P0_cone a_old w x (finSumFinEquiv (Sum.inr i)) *
      M_coupled w (finSumFinEquiv (Sum.inr i)) c) =
      ∑ i : Fin (w + 1), a_old x * W_coupled w i c := by
    simp only [P0_cone, M_coupled, Matrix.of_apply, Equiv.symm_apply_apply]
  rw [h_inl, h_inr]
  ring

/-- Residual deficit under `c_P0 • P0_cone` reduces identically to the target deficit matrix. -/
theorem D_res_P0_cone_smul_eq {m w : ℕ} (D : Matrix (Fin (m + 1)) (Fin (w + 1)) ℚ)
    (c_P0 : ℚ) (a_old : Fin (m + 1) → ℚ) :
    D_res D (c_P0 • P0_cone a_old w) (M_coupled w) = D := by
  dsimp only [D_res]
  rw [Matrix.smul_mul, P0_cone_mul_M_coupled, smul_zero, sub_zero]

/-- Linearity of `Q_reset` with respect to addition of interaction matrix and ceiling vector. -/
theorem Q_reset_add {n w : Type*} [Fintype n] [Fintype w]
    (J1 J2 : Matrix n n ℚ) (M : Matrix n w ℚ) (B : Matrix w w ℚ) (zeta1 zeta2 : w → ℚ) :
    Q_reset (J1 + J2) M B (zeta1 + zeta2) = Q_reset J1 M B zeta1 + Q_reset J2 M B zeta2 := by
  dsimp only [Q_reset]
  have hz : one_zeta n (zeta1 + zeta2) = one_zeta n zeta1 + one_zeta n zeta2 := by ext; rfl
  rw [hz, Matrix.add_mul, Matrix.add_mul, Matrix.transpose_add, Matrix.add_mul, Matrix.add_mul]
  abel

/-- Linearity of `Q_reset` with respect to scalar scaling of interaction matrix and ceiling vector. -/
theorem Q_reset_smul {n w : Type*} [Fintype n] [Fintype w]
    (c : ℚ) (J : Matrix n n ℚ) (M : Matrix n w ℚ) (B : Matrix w w ℚ) (zeta : w → ℚ) :
    Q_reset (c • J) M B (c • zeta) = c • Q_reset J M B zeta := by
  dsimp only [Q_reset]
  have hz : one_zeta n (c • zeta) = c • one_zeta n zeta := by ext; rfl
  rw [hz, Matrix.smul_mul, Matrix.transpose_smul, Matrix.smul_mul, Matrix.smul_mul, Matrix.smul_mul]
  simp only [smul_sub, smul_add]

/-- Exact additive decomposition of `Q_reset` for the scaled admissible lift. -/
theorem Q_reset_admissible_scaled_decomp {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) :
    Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta) =
      Q_reset (J_general w (E_rank2 (F_admissible clock b H0 ch delta))) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible clock b H0 ch delta) +
        c_zeta • Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) := by
  dsimp only [J_admissible_scaled, zeta_admissible_scaled]
  rw [Q_reset_add, Q_reset_smul]

/-- Simplified interpolation formula for `P_admissible_scaled` via residual cancellation. -/
theorem P_admissible_scaled_eq_simplified {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C =
      c_P0 • P0_cone a_old w + D_admissible clock b H0 ch delta * R_M_coupled w +
        L_X_gateway L_C *
          ((Q_res (Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
              (zeta_admissible_scaled clock b H0 ch delta c_zeta))
            (c_P0 • P0_cone a_old w) (X_gateway clock)).transpose -
            (X_gateway clock).transpose * D_admissible clock b H0 ch delta * R_M_coupled w) := by
  dsimp only [P_admissible_scaled, P_interp]
  rw [D_res_P0_cone_smul_eq]

/-- Exact three-term affine-linear decomposition of `P_admissible_scaled` in `c_zeta` and `c_P0`. -/
theorem P_admissible_scaled_linear_decomp {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C =
      P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C +
        c_zeta • (L_X_gateway L_C * (Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w)).transpose) +
        c_P0 • (P0_cone a_old w - L_X_gateway L_C * ((P0_cone a_old w).transpose * X_gateway clock).transpose) := by
  rw [P_admissible_scaled_eq_simplified, P_admissible_scaled_eq_simplified]
  dsimp only [Q_res]
  rw [Q_reset_admissible_scaled_decomp]
  rw [Q_reset_admissible_scaled_decomp clock b H0 ch delta 0]
  simp only [zero_smul, add_zero, Matrix.transpose_zero, Matrix.zero_mul, sub_zero]
  rw [Matrix.transpose_smul, Matrix.smul_mul]
  rw [Matrix.transpose_sub, Matrix.transpose_add, Matrix.transpose_smul, Matrix.transpose_smul]
  simp only [Matrix.mul_sub, Matrix.mul_add, Matrix.mul_smul, smul_sub]
  ext x r
  simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, Matrix.zero_apply, smul_eq_mul]
  ring
/-!
## 12. Synchronized Cone-Calibrated Scaling, Bundle Decompositions, and Sign-Definite Bounds

In this section, we establish:
1. Specialization of `P0_cone` with all-ones weights to `P0_coupled`, yielding
   `P0_coupled * M_coupled = 0`.
2. Bundle-lift counterparts `P_bundle_eq_simplified` and `P_bundle_linear_decomp`.
3. Synchronized cone-calibrated scaling where `c_P0 = c_zeta`, showing that when
   `P0_cone` matches the coupled target table `Q_reset`, `P_admissible_scaled` collapses
   to a two-term sum `c_zeta • P0_cone + P_base`.
4. Sign-definite coupling bounds on early (`Sum.inl`) and late (`Sum.inr`) reset actions.
-/

/-- Evaluation of `P0_cone` with constant weight 1 coincides with `P0_coupled`. -/
theorem P0_cone_ones_eq_P0_coupled (m w : ℕ) :
    P0_cone (fun _ : Fin (m + 1) => (1 : ℚ)) w = P0_coupled m w := by
  ext x r
  dsimp only [P0_cone, P0_coupled]
  simp only [Matrix.of_apply]
  cases finSumFinEquiv.symm r <;> rfl

/-- Annihilation of `P0_coupled` against `M_coupled`. -/
theorem P0_coupled_mul_M_coupled (m w : ℕ) :
    P0_coupled m w * M_coupled w = 0 := by
  rw [← P0_cone_ones_eq_P0_coupled]
  exact P0_cone_mul_M_coupled (fun _ => 1)

/-- Residual deficit under `c_P0 • P0_coupled` reduces identically to the target deficit matrix. -/
theorem D_res_P0_coupled_smul_eq {m w : ℕ} (D : Matrix (Fin (m + 1)) (Fin (w + 1)) ℚ)
    (c_P0 : ℚ) :
    D_res D (c_P0 • P0_coupled m w) (M_coupled w) = D := by
  dsimp only [D_res]
  rw [Matrix.smul_mul, P0_coupled_mul_M_coupled, smul_zero, sub_zero]

/-- Exact additive decomposition of `Q_reset` for the scaled bundle lift. -/
theorem Q_reset_bundle_scaled_decomp {w : ℕ} (clock : AlgebraicClock w)
    (delta c_zeta : ℚ) :
    Q_reset (J_bundle clock delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_bundle_scaled clock delta c_zeta) =
      Q_reset (J_general w (E_bundle clock delta)) (M_coupled w) (B_mat (w + 1))
        (zeta_bundle clock delta) +
        c_zeta • Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) := by
  dsimp only [J_bundle, zeta_bundle_scaled]
  rw [Q_reset_add, Q_reset_smul]

/-- Simplified interpolation formula for `P_bundle` via residual cancellation. -/
theorem P_bundle_eq_simplified {w : ℕ} (clock : AlgebraicClock w)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (delta c_zeta c_P0 : ℚ) :
    P_bundle clock L_C delta c_zeta c_P0 =
      c_P0 • P0_coupled clock.m w + D_bundle clock 0 delta * R_M_coupled w +
        L_X_gateway L_C *
          ((Q_res (Q_reset (J_bundle clock delta c_zeta) (M_coupled w) (B_mat (w + 1))
              (zeta_bundle_scaled clock delta c_zeta))
            (c_P0 • P0_coupled clock.m w) (X_gateway clock)).transpose -
            (X_gateway clock).transpose * D_bundle clock 0 delta * R_M_coupled w) := by
  dsimp only [P_bundle, P_interp]
  rw [D_res_P0_coupled_smul_eq]

/-- Exact three-term affine-linear decomposition of `P_bundle` in `c_zeta` and `c_P0`. -/
theorem P_bundle_linear_decomp {w : ℕ} (clock : AlgebraicClock w)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (delta c_zeta c_P0 : ℚ) :
    P_bundle clock L_C delta c_zeta c_P0 =
      P_bundle clock L_C delta 0 0 +
        c_zeta • (L_X_gateway L_C * (Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w)).transpose) +
        c_P0 • (P0_coupled clock.m w - L_X_gateway L_C * ((P0_coupled clock.m w).transpose * X_gateway clock).transpose) := by
  rw [P_bundle_eq_simplified, P_bundle_eq_simplified]
  dsimp only [Q_res]
  rw [Q_reset_bundle_scaled_decomp]
  rw [Q_reset_bundle_scaled_decomp clock delta 0]
  simp only [zero_smul, add_zero, Matrix.transpose_zero, Matrix.zero_mul, sub_zero]
  rw [Matrix.transpose_smul, Matrix.smul_mul]
  rw [Matrix.transpose_sub, Matrix.transpose_add, Matrix.transpose_smul, Matrix.transpose_smul]
  simp only [Matrix.mul_sub, Matrix.mul_add, Matrix.mul_smul, smul_sub]
  ext x r
  simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, Matrix.zero_apply, smul_eq_mul]
  ring

/-- Synchronized scaling decomposition of `P_admissible_scaled` when `c_P0 = c_zeta`. -/
theorem P_admissible_scaled_synchronized_decomp {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C =
      c_zeta • P0_cone a_old w +
        P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C +
        c_zeta • (L_X_gateway L_C *
          (Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) -
            (P0_cone a_old w).transpose * X_gateway clock).transpose) := by
  have hlin := P_admissible_scaled_linear_decomp clock b H0 ch delta c_zeta c_zeta a_old L_C
  rw [hlin]
  simp only [Matrix.transpose_sub, Matrix.mul_sub, smul_sub]
  ext x r
  simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul]
  ring

/-- Exact two-term collapse of `P_admissible_scaled` under exact cone target matching. -/
theorem P_admissible_scaled_exact_cone_match {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hcone : (P0_cone a_old w).transpose * X_gateway clock =
      Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w)) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C =
      c_zeta • P0_cone a_old w + P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C := by
  rw [P_admissible_scaled_synchronized_decomp]
  rw [← hcone]
  simp only [sub_self, Matrix.transpose_zero, Matrix.mul_zero, smul_zero, add_zero]

/-- Strict upper bound on early reset action coupling entries under cone dominance. -/
theorem P_admissible_scaled_cone_early_bound {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hcone : (P0_cone a_old w).transpose * X_gateway clock =
      Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w))
    (ha_pos : ∀ x, 0 < a_old x) (hc_pos : 0 < c_zeta)
    (hdom : ∀ x r, |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r| ≤ c_zeta * a_old x / 2)
    (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C x (finSumFinEquiv (Sum.inl j)) ≤
      - (c_zeta * a_old x / 2) ∧
    P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C x (finSumFinEquiv (Sum.inl j)) < 0 := by
  have hmatch := P_admissible_scaled_exact_cone_match clock b H0 ch delta c_zeta a_old L_C hcone
  have h_entry : P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C x (finSumFinEquiv (Sum.inl j)) =
      - (c_zeta * a_old x) + P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x (finSumFinEquiv (Sum.inl j)) := by
    rw [hmatch]
    simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul, P0_cone, Matrix.of_apply,
      Equiv.symm_apply_apply]
    ring
  rw [h_entry]
  have h_le := (abs_le.mp (hdom x (finSumFinEquiv (Sum.inl j)))).2
  have h_pos : 0 < c_zeta * a_old x / 2 := by
    have h1 := ha_pos x
    positivity
  constructor
  · linarith
  · linarith

/-- Strict lower bound on late reset action coupling entries under cone dominance. -/
theorem P_admissible_scaled_cone_late_bound {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hcone : (P0_cone a_old w).transpose * X_gateway clock =
      Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w))
    (ha_pos : ∀ x, 0 < a_old x) (hc_pos : 0 < c_zeta)
    (hdom : ∀ x r, |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r| ≤ c_zeta * a_old x / 2)
    (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    c_zeta * a_old x / 2 ≤
      P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C x (finSumFinEquiv (Sum.inr j)) ∧
    0 < P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C x (finSumFinEquiv (Sum.inr j)) := by
  have hmatch := P_admissible_scaled_exact_cone_match clock b H0 ch delta c_zeta a_old L_C hcone
  have h_entry : P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C x (finSumFinEquiv (Sum.inr j)) =
      c_zeta * a_old x + P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x (finSumFinEquiv (Sum.inr j)) := by
    rw [hmatch]
    simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul, P0_cone, Matrix.of_apply,
      Equiv.symm_apply_apply]
  rw [h_entry]
  have h_ge := (abs_le.mp (hdom x (finSumFinEquiv (Sum.inr j)))).1
  have h_pos : 0 < c_zeta * a_old x / 2 := by
    have h1 := ha_pos x
    positivity
  constructor
  · linarith
  · linarith

/-- Sign-definite coupling bounds on early and late reset actions under synchronized cone scaling. -/
theorem P_admissible_scaled_cone_sign_bounds {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hcone : (P0_cone a_old w).transpose * X_gateway clock =
      Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w))
    (ha_pos : ∀ x, 0 < a_old x) (hc_pos : 0 < c_zeta)
    (hdom : ∀ x r, |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r| ≤ c_zeta * a_old x / 2)
    (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    (P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C x (finSumFinEquiv (Sum.inl j)) ≤
        - (c_zeta * a_old x / 2) ∧
      P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C x (finSumFinEquiv (Sum.inl j)) < 0) ∧
    (c_zeta * a_old x / 2 ≤
        P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C x (finSumFinEquiv (Sum.inr j)) ∧
      0 < P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C x (finSumFinEquiv (Sum.inr j))) :=
  ⟨P_admissible_scaled_cone_early_bound clock b H0 ch delta c_zeta a_old L_C hcone ha_pos hc_pos hdom x j,
   P_admissible_scaled_cone_late_bound clock b H0 ch delta c_zeta a_old L_C hcone ha_pos hc_pos hdom x j⟩

/-!
## 13. Exact Stage 3 Reset Score Evolution & Explicit Cone Threshold (`canonicalCP0_admissible`)

In this section, we establish:
1. The exact polynomial identity relating `(one_zeta _ zeta - Jᵀ * M) * p_{w+1}(q)` to
   `V_reset J M B zeta * p_{w+1}(q + 1)` across the binomial basis transition `p_{w+1}(q + 1) = (1 + N) p_{w+1}(q)`.
2. The exact closed-form identity for the score of every reset action `Sum.inr r` at the end of
   Stage 3 (`W_early_word ++ W_late_word ++ (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)`):
   $$\text{score}_{\mathrm{Stage3End}}(\mathrm{inr}\;r) = \zeta \cdot p_{w+1}(q+1) - (J M p_{w+1}(q+1))_r + P_{g, r}.$$
3. The explicit closed-form cone dominance threshold `canonicalCP0_admissible` and unconditional
   sign-definiteness (`P_{x, \mathrm{inl}\;j} < 0` and `0 < P_{x, \mathrm{inr}\;j}`) whenever
   `canonicalCP0_admissible clock b H0 ch delta a_old L_C ≤ c_zeta`.
-/

/-- `V_reset J M (B_mat (w + 1)) zeta * (1 + N_mat (w + 1)) = one_zeta n zeta - J.transpose * M`. -/
theorem V_reset_mul_one_add_N {n : Type*} [Fintype n] (w : ℕ)
    (J : Matrix n n ℚ) (M : Matrix n (Fin (w + 1)) ℚ) (zeta : Fin (w + 1) → ℚ) :
    V_reset J M (B_mat (w + 1)) zeta * (1 + N_mat (w + 1)) =
      one_zeta n zeta - J.transpose * M := by
  unfold V_reset
  rw [Matrix.sub_mul, Matrix.mul_assoc, Matrix.mul_assoc, B_mat_mul_one_add_N (w + 1),
    Matrix.mul_one, Matrix.mul_one]

/-- Evaluating `(one_zeta n zeta - J.transpose * M)` on `binomBasis (w + 1) q` equals evaluating
    `V_reset J M (B_mat (w + 1)) zeta` on `binomBasis (w + 1) (q + 1)`. -/
theorem one_zeta_sub_J_transpose_mul_M_mulVec_binomBasis {n : Type*} [Fintype n] (w : ℕ)
    (J : Matrix n n ℚ) (M : Matrix n (Fin (w + 1)) ℚ) (zeta : Fin (w + 1) → ℚ) (q : ℕ) :
    (one_zeta n zeta - J.transpose * M).mulVec (binomBasis (w + 1) q) =
      (V_reset J M (B_mat (w + 1)) zeta).mulVec (binomBasis (w + 1) (q + 1)) := by
  have hsucc : binomBasis (w + 1) (q + 1) = (1 + N_mat (w + 1)).mulVec (binomBasis (w + 1) q) := by
    rw [← T_mat, ← binomBasis_succ]
  rw [hsucc, Matrix.mulVec_mulVec, V_reset_mul_one_add_N]

/-- Across any word `W` supported on old actions (`wordCountVec W (Sum.inr r') = 0`), the score of
    reset action `Sum.inr r` changes by `- ∑ u, P u r * wordCountVec W (Sum.inl u)`. -/
theorem wordScore_liftedGameMat_old_word_inr {m k : ℕ}
    (G_O : Matrix (Fin (m + 1)) (Fin (m + 1)) ℚ)
    (P : Matrix (Fin (m + 1)) (Fin ((k + 1) + (k + 1))) ℚ)
    (J : Matrix (Fin ((k + 1) + (k + 1))) (Fin ((k + 1) + (k + 1))) ℚ)
    (s : Fin (m + 1) ⊕ Fin ((k + 1) + (k + 1)) → ℚ)
    (W : List (Fin (m + 1) ⊕ Fin ((k + 1) + (k + 1))))
    (hW_inr : ∀ r', wordCountVec W (Sum.inr r') = 0)
    (r : Fin ((k + 1) + (k + 1))) :
    wordScore (liftedGameMat G_O P J) s W (Sum.inr r) =
      s (Sum.inr r) - ∑ u : Fin (m + 1), P u r * wordCountVec W (Sum.inl u) := by
  simp only [wordScore, scoreVec, liftedGameMat]
  rw [Fintype.sum_sum_type]
  simp only [Matrix.fromBlocks_apply₂₁, Matrix.fromBlocks_apply₂₂, Matrix.neg_apply,
    Matrix.transpose_apply, hW_inr, mul_zero, Finset.sum_const_zero, add_zero, neg_mul,
    Finset.sum_neg_distrib]
  ring

/-- The Stage 3 word `(W_bundle_word parentWord Q).map (bundleToLiftedAct clock.m w)` has zero
    count on every reset action `Sum.inr r'`. -/
theorem wordCountVec_bundle_word_lifted_inr {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m)) (Q : ℕ) (r' : Fin ((w + 1) + (w + 1))) :
    wordCountVec ((W_bundle_word parentWord Q).map (bundleToLiftedAct clock.m w)) (Sum.inr r') = 0 := by
  unfold wordCountVec
  have hnone : ∀ y ∈ (W_bundle_word parentWord Q).map (bundleToLiftedAct clock.m w),
      y ≠ Sum.inr r' := by
    intro y hy h
    simp only [List.mem_map] at hy
    rcases hy with ⟨j, _, rfl⟩
    simp only [bundleToLiftedAct] at h
    contradiction
  exact_mod_cast list_count_eq_zero_of_forall_ne hnone

/-- The Stage 3 word `(W_bundle_word parentWord Q).map (bundleToLiftedAct clock.m w)` has zero
    count on the gateway action `Sum.inl (gatewayOldAct clock.m)`. -/
theorem wordCountVec_bundle_word_lifted_gateway {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m)) (Q : ℕ) :
    wordCountVec ((W_bundle_word parentWord Q).map (bundleToLiftedAct clock.m w))
      (Sum.inl (gatewayOldAct clock.m)) = 0 := by
  unfold wordCountVec
  have hnone : ∀ y ∈ (W_bundle_word parentWord Q).map (bundleToLiftedAct clock.m w),
      y ≠ Sum.inl (gatewayOldAct clock.m) := by
    intro y hy h
    simp only [List.mem_map] at hy
    rcases hy with ⟨j, _, rfl⟩
    simp only [bundleToLiftedAct, gatewayOldAct, Sum.inl.injEq, Equiv.apply_eq_iff_eq] at h
    contradiction
  exact_mod_cast list_count_eq_zero_of_forall_ne hnone

/-- The Stage 3 word `(W_bundle_word parentWord Q).map (bundleToLiftedAct clock.m w)` has count
    `totalPhaseCount clock Q i` on each parent action `Sum.inl (parentToOldAct clock.m i)`. -/
theorem wordCountVec_bundle_word_lifted_parent {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (Q : ℕ) (i : Fin clock.m) :
    wordCountVec ((W_bundle_word parentWord Q).map (bundleToLiftedAct clock.m w))
      (Sum.inl (parentToOldAct clock.m i)) =
    totalPhaseCount clock Q i := by
  have hinj : Function.Injective (bundleToLiftedAct clock.m w) := by
    intro a b_idx hab
    simp only [bundleToLiftedAct, Sum.inl.injEq, Equiv.apply_eq_iff_eq, Sum.inl.injEq] at hab
    exact hab
  unfold wordCountVec
  have heq : Sum.inl (parentToOldAct clock.m i) = bundleToLiftedAct clock.m w i := rfl
  rw [heq, list_count_map_of_injective (bundleToLiftedAct clock.m w) hinj (W_bundle_word parentWord Q) i]
  exact wordCountVec_bundle_word parentWord clock rfl hparent_count Q i

/-- General-`Q` Pascal hockey-stick identity: `(shiftRightCount clock.C).mulVec (binomBasis (w + 1) Q) i = totalPhaseCount clock Q i`. -/
theorem shiftRightCount_C_mulVec_binomBasis {w : ℕ} (clock : AlgebraicClock w)
    (Q : ℕ) (i : Fin clock.m) :
    ((shiftRightCount clock.C).mulVec (binomBasis (w + 1) Q)) i =
      totalPhaseCount clock Q i := by
  simp only [Matrix.mulVec, dotProduct, totalPhaseCount]
  rw [Fin.sum_univ_succ]
  have h0 : shiftRightCount clock.C i 0 = 0 := by
    simp [shiftRightCount]
  rw [h0, zero_mul, zero_add, Finset.sum_comm]
  refine Finset.sum_congr rfl fun d _ => ?_
  have hshift : shiftRightCount clock.C i d.succ = clock.C i d := by
    simp [shiftRightCount]
  rw [hshift]
  simp only [binomBasis]
  have hchoose := sum_range_choose d.val Q
  have hdsucc : d.succ.val = d.val + 1 := rfl
  rw [hdsucc, ← hchoose, Finset.mul_sum]

/-- Exact coupling sum across `W_bundle_word parentWord Q` for reset action `r`:
    `∑ u, P u r * wordCountVec ((W_bundle_word parentWord Q).map ...) (Sum.inl u) =
      ((P.transpose * X_gateway clock).mulVec (binomBasis (w + 1) Q)) r - P (gatewayOldAct clock.m) r`. -/
theorem sum_P_mul_wordCountVec_bundle_word_lifted {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (P : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (Q : ℕ) (r : Fin ((w + 1) + (w + 1))) :
    (∑ u : Fin (clock.m + 1),
      P u r * wordCountVec ((W_bundle_word parentWord Q).map (bundleToLiftedAct clock.m w)) (Sum.inl u)) =
    ((P.transpose * X_gateway clock).mulVec (binomBasis (w + 1) Q)) r - P (gatewayOldAct clock.m) r := by
  rw [(Equiv.sum_comp finSumFinEquiv fun u : Fin (clock.m + 1) =>
    P u r * wordCountVec ((W_bundle_word parentWord Q).map (bundleToLiftedAct clock.m w)) (Sum.inl u)).symm]
  rw [Fintype.sum_sum_type]
  have hinr : (∑ v : Fin 1,
      P (finSumFinEquiv (Sum.inr v)) r *
        wordCountVec ((W_bundle_word parentWord Q).map (bundleToLiftedAct clock.m w))
          (Sum.inl (finSumFinEquiv (Sum.inr v)))) = 0 := by
    apply Finset.sum_eq_zero
    intro v _
    have hv : v = 0 := Subsingleton.elim v 0
    subst hv
    have hg : finSumFinEquiv (Sum.inr (0 : Fin 1)) = gatewayOldAct clock.m := rfl
    rw [hg, wordCountVec_bundle_word_lifted_gateway clock parentWord Q, mul_zero]
  rw [hinr, add_zero]
  have hinl : (∑ i : Fin clock.m,
      P (finSumFinEquiv (Sum.inl i)) r *
        wordCountVec ((W_bundle_word parentWord Q).map (bundleToLiftedAct clock.m w))
          (Sum.inl (finSumFinEquiv (Sum.inl i)))) =
      ∑ i : Fin clock.m, P (parentToOldAct clock.m i) r * totalPhaseCount clock Q i := by
    refine Finset.sum_congr rfl fun i _ => ?_
    have hp : finSumFinEquiv (Sum.inl i) = parentToOldAct clock.m i := rfl
    rw [hp, wordCountVec_bundle_word_lifted_parent clock parentWord hparent_count Q i]
  rw [hinl]
  have hPtX : ((P.transpose * X_gateway clock).mulVec (binomBasis (w + 1) Q)) r =
      (P.transpose.mulVec ((X_gateway clock).mulVec (binomBasis (w + 1) Q))) r := by
    rw [Matrix.mulVec_mulVec]
  rw [hPtX]
  simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply]
  rw [(Equiv.sum_comp finSumFinEquiv fun u : Fin (clock.m + 1) =>
    P u r * (∑ c : Fin (w + 1), X_gateway clock u c * binomBasis (w + 1) Q c)).symm]
  rw [Fintype.sum_sum_type, Fin.sum_univ_one]
  have hX_inl : ∀ i : Fin clock.m,
      (∑ c : Fin (w + 1), X_gateway clock (finSumFinEquiv (Sum.inl i)) c * binomBasis (w + 1) Q c) =
      totalPhaseCount clock Q i := by
    intro i
    rw [← shiftRightCount_C_mulVec_binomBasis clock Q i]
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, Matrix.mulVec, dotProduct]
  have hX_inr : (∑ c : Fin (w + 1), X_gateway clock (finSumFinEquiv (Sum.inr 0)) c * binomBasis (w + 1) Q c) = 1 := by
    have he0_rew : (∑ c : Fin (w + 1), X_gateway clock (finSumFinEquiv (Sum.inr 0)) c * binomBasis (w + 1) Q c) =
        ∑ c : Fin (w + 1), if c = 0 then binomBasis (w + 1) Q c else 0 := by
      refine Finset.sum_congr rfl fun c _ => ?_
      simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, e0_row]
      by_cases hc : c.val = 0
      · have hc0 : c = 0 := by ext; exact hc
        simp [hc0]
      · have hc0 : c ≠ 0 := fun h => hc (by subst h; rfl)
        simp [hc, hc0]
    rw [he0_rew, Finset.sum_ite_eq' Finset.univ 0]
    simp [binomBasis]
  have hsum_eq : (∑ i : Fin clock.m,
      P (finSumFinEquiv (Sum.inl i)) r *
        (∑ c : Fin (w + 1), X_gateway clock (finSumFinEquiv (Sum.inl i)) c * binomBasis (w + 1) Q c)) =
      ∑ i : Fin clock.m, P (parentToOldAct clock.m i) r * totalPhaseCount clock Q i := by
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hX_inl i]
    rfl
  rw [hsum_eq, hX_inr, mul_one]
  have hg : finSumFinEquiv (Sum.inr (0 : Fin 1)) = gatewayOldAct clock.m := rfl
  rw [hg]
  ring

/-- **Exact Stage 3 End Reset Score Identity (`wordScore_after_stage3_inr`)**:
    At the end of Stage 3 (`W_early_word ++ W_late_word ++ (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)`),
    immediately before the gateway action `g` is played in Stage 4, the score of every reset action
    `Sum.inr r` is given by the exact closed-form identity:
    `dotProduct zeta (binomBasis (w + 1) (q + 1)) - ((J * M_coupled w).mulVec (binomBasis (w + 1) (q + 1))) r + P (gatewayOldAct clock.m) r`. -/
theorem wordScore_after_stage3_inr {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (G_O : Matrix (Fin (clock.m + 1)) (Fin (clock.m + 1)) ℚ)
    (P : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (S : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (hPtX : P.transpose * X_gateway clock = Q_reset J (M_coupled w) (B_mat (w + 1)) zeta)
    (q : ℕ) (r : Fin ((w + 1) + (w + 1))) :
    wordScore (liftedGameMat G_O P J)
      ((liftedScoreMat G_O J S (X_gateway clock) (M_coupled w) zeta).mulVec (binomBasis (w + 1) q))
      (W_early_word clock.m w q ++ W_late_word clock.m w q ++
        (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w))
      (Sum.inr r) =
    dotProduct zeta (binomBasis (w + 1) (q + 1)) -
      ((J * M_coupled w).mulVec (binomBasis (w + 1) (q + 1))) r +
      P (gatewayOldAct clock.m) r := by
  rw [wordScore_append]
  have hW_inr := wordCountVec_bundle_word_lifted_inr clock parentWord (q + 1)
  rw [wordScore_liftedGameMat_old_word_inr G_O P J _ _ hW_inr r]
  rw [wordScore_after_reset_stages_inr clock G_O P J S zeta q r]
  have hV := congr_fun (one_zeta_sub_J_transpose_mul_M_mulVec_binomBasis w J (M_coupled w) zeta q) r
  rw [hV]
  rw [sum_P_mul_wordCountVec_bundle_word_lifted clock parentWord hparent_count P (q + 1) r]
  rw [hPtX]
  have hVQ : ((V_reset J (M_coupled w) (B_mat (w + 1)) zeta).mulVec (binomBasis (w + 1) (q + 1))) r -
      ((Q_reset J (M_coupled w) (B_mat (w + 1)) zeta).mulVec (binomBasis (w + 1) (q + 1))) r =
      ((one_zeta (Fin ((w + 1) + (w + 1))) zeta - J * M_coupled w).mulVec (binomBasis (w + 1) (q + 1))) r := by
    rw [← Pi.sub_apply, ← Matrix.sub_mulVec, rotated_reset_score_identity]
  have hone_zeta : ((one_zeta (Fin ((w + 1) + (w + 1))) zeta - J * M_coupled w).mulVec (binomBasis (w + 1) (q + 1))) r =
      dotProduct zeta (binomBasis (w + 1) (q + 1)) - ((J * M_coupled w).mulVec (binomBasis (w + 1) (q + 1))) r := by
    rw [Matrix.sub_mulVec, Pi.sub_apply]
    congr 1
  linarith

/-- Specialization of `wordScore_after_stage3_inr` to the scaled admissible lift. -/
theorem wordScore_after_stage3_admissible_inr {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (q : ℕ) (r : Fin ((w + 1) + (w + 1))) :
    wordScore
      (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (J_admissible_scaled clock b H0 ch delta c_zeta)
        (S_admissible clock b H0 ch delta)
        (X_gateway clock) (M_coupled w)
        (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q))
      (W_early_word clock.m w q ++ W_late_word clock.m w q ++
        (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w))
      (Sum.inr r) =
    dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) (q + 1)) -
      ((J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w).mulVec (binomBasis (w + 1) (q + 1))) r +
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (gatewayOldAct clock.m) r := by
  exact wordScore_after_stage3_inr clock parentWord hparent_count
    (AdjoinLeaderEndpointG clock.G b clock.v)
    (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
    (J_admissible_scaled clock b H0 ch delta c_zeta)
    (S_admissible clock b H0 ch delta)
    (zeta_admissible_scaled clock b H0 ch delta c_zeta)
    (P_admissible_scaled_transpose_mul_X clock b H0 ch delta c_zeta c_P0 a_old L_C hLC)
    q r

/-- Specialization of `wordScore_after_stage3_inr` to the scaled bundle lift. -/
theorem wordScore_after_stage3_bundle_inr {w : ℕ} (clock : AlgebraicClock w)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (delta c_zeta c_P0 : ℚ)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (q : ℕ) (r : Fin ((w + 1) + (w + 1))) :
    wordScore
      (liftedGameMat (adjoinGatewayEndpointG clock.G clock.v)
        (P_bundle clock L_C delta c_zeta c_P0)
        (J_bundle clock delta c_zeta))
      ((liftedScoreMat (adjoinGatewayEndpointG clock.G clock.v)
        (J_bundle clock delta c_zeta)
        (S_bundle clock 0 delta)
        (X_gateway clock) (M_coupled w)
        (zeta_bundle_scaled clock delta c_zeta)).mulVec (binomBasis (w + 1) q))
      (W_early_word clock.m w q ++ W_late_word clock.m w q ++
        (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w))
      (Sum.inr r) =
    dotProduct (zeta_bundle_scaled clock delta c_zeta) (binomBasis (w + 1) (q + 1)) -
      ((J_bundle clock delta c_zeta * M_coupled w).mulVec (binomBasis (w + 1) (q + 1))) r +
      P_bundle clock L_C delta c_zeta c_P0 (gatewayOldAct clock.m) r := by
  exact wordScore_after_stage3_inr clock parentWord hparent_count
    (adjoinGatewayEndpointG clock.G clock.v)
    (P_bundle clock L_C delta c_zeta c_P0)
    (J_bundle clock delta c_zeta)
    (S_bundle clock 0 delta)
    (zeta_bundle_scaled clock delta c_zeta)
    (P_bundle_transpose_mul_X clock L_C hLC delta c_zeta c_P0)
    q r

/-- Explicit closed-form cone dominance threshold `canonicalCP0_admissible` guaranteeing
    `|P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r| ≤ c_zeta * a_old x / 2`
    for all `x` and `r` whenever `canonicalCP0_admissible clock b H0 ch delta a_old L_C ≤ c_zeta`. -/
def canonicalCP0_admissible {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) : ℚ :=
  1 + 2 * ∑ x : Fin (clock.m + 1), ∑ r : Fin ((w + 1) + (w + 1)),
    |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r| / |a_old x|

/-- `1 ≤ canonicalCP0_admissible`. -/
theorem one_le_canonicalCP0_admissible {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    1 ≤ canonicalCP0_admissible clock b H0 ch delta a_old L_C := by
  unfold canonicalCP0_admissible
  have hsum : 0 ≤ ∑ x : Fin (clock.m + 1), ∑ r : Fin ((w + 1) + (w + 1)),
      |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r| / |a_old x| := by
    apply Finset.sum_nonneg; intro x _
    apply Finset.sum_nonneg; intro r _
    positivity
  linarith

/-- Whenever `canonicalCP0_admissible clock b H0 ch delta a_old L_C ≤ c_zeta` and `∀ x, 0 < a_old x`,
    the base residual coupling `P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C` is bounded by
    `c_zeta * a_old x / 2` in magnitude for every `x` and `r`. -/
theorem P_admissible_scaled_dom_of_ge_canonicalCP0 {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (ha_pos : ∀ x, 0 < a_old x)
    (h_cp : canonicalCP0_admissible clock b H0 ch delta a_old L_C ≤ c_zeta)
    (x : Fin (clock.m + 1)) (r : Fin ((w + 1) + (w + 1))) :
    |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r| ≤ c_zeta * a_old x / 2 := by
  have h_term_le_sum :
      |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r| / |a_old x| ≤
      ∑ x' : Fin (clock.m + 1), ∑ r' : Fin ((w + 1) + (w + 1)),
        |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x' r'| / |a_old x'| := by
    have h1 : |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r| / |a_old x| ≤
        ∑ r' : Fin ((w + 1) + (w + 1)),
          |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r'| / |a_old x| :=
      Finset.single_le_sum
        (f := fun r' : Fin ((w + 1) + (w + 1)) =>
          |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r'| / |a_old x|)
        (fun r' _ => by positivity) (Finset.mem_univ r)
    have h2 : (∑ r' : Fin ((w + 1) + (w + 1)),
          |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r'| / |a_old x|) ≤
        ∑ x' : Fin (clock.m + 1), ∑ r' : Fin ((w + 1) + (w + 1)),
          |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x' r'| / |a_old x'| :=
      Finset.single_le_sum
        (f := fun x' : Fin (clock.m + 1) =>
          ∑ r' : Fin ((w + 1) + (w + 1)),
            |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x' r'| / |a_old x'|)
        (fun x' _ => Finset.sum_nonneg fun r' _ => by positivity)
        (Finset.mem_univ x)
    exact le_trans h1 h2
  have h_le_cz : 2 * (|P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r| / |a_old x|) ≤ c_zeta := by
    unfold canonicalCP0_admissible at h_cp
    linarith
  have ha_x := ha_pos x
  have habs_a : |a_old x| = a_old x := abs_of_pos ha_x
  rw [habs_a] at h_le_cz
  have h_mul := mul_le_mul_of_nonneg_right h_le_cz (le_of_lt ha_x)
  have h_cancel : 2 * (|P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r| / a_old x) * a_old x =
      2 * |P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x r| := by
    have hne : a_old x ≠ 0 := ne_of_gt ha_x
    field_simp [hne]
  rw [h_cancel] at h_mul
  linarith

/-- Unconditional cone sign bounds for `P_admissible_scaled` whenever
    `canonicalCP0_admissible clock b H0 ch delta a_old L_C ≤ c_zeta`. -/
theorem P_admissible_scaled_cone_sign_bounds_of_ge {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hcone : (P0_cone a_old w).transpose * X_gateway clock =
      Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w))
    (ha_pos : ∀ x, 0 < a_old x)
    (h_cp : canonicalCP0_admissible clock b H0 ch delta a_old L_C ≤ c_zeta)
    (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    (P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C x (finSumFinEquiv (Sum.inl j)) ≤
        - (c_zeta * a_old x / 2) ∧
      P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C x (finSumFinEquiv (Sum.inl j)) < 0) ∧
    (c_zeta * a_old x / 2 ≤
        P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C x (finSumFinEquiv (Sum.inr j)) ∧
      0 < P_admissible_scaled clock b H0 ch delta c_zeta c_zeta a_old L_C x (finSumFinEquiv (Sum.inr j))) := by
  have hc_pos : 0 < c_zeta := by
    have h1 := one_le_canonicalCP0_admissible clock b H0 ch delta a_old L_C
    linarith
  have hdom := P_admissible_scaled_dom_of_ge_canonicalCP0 clock b H0 ch delta c_zeta a_old L_C ha_pos h_cp
  exact P_admissible_scaled_cone_sign_bounds clock b H0 ch delta c_zeta a_old L_C hcone ha_pos hc_pos hdom x j

/-- For any word `W` and prefix length `k`, `wordCountVec (W.take k) x + wordCountVec (W.drop k) x = wordCountVec W x`. -/
theorem wordCountVec_take_add_drop {α : Type*} [DecidableEq α] (W : List α) (k : ℕ) (x : α) :
    wordCountVec (W.take k) x + wordCountVec (W.drop k) x = wordCountVec W x := by
  rw [← wordCountVec_append, List.take_append_drop]

/-- Both `wordCountVec (W.take k) x` and `wordCountVec (W.drop k) x` are non-negative and bounded above by `wordCountVec W x`. -/
theorem wordCountVec_take_drop_bounds {α : Type*} [DecidableEq α] (W : List α) (k : ℕ) (x : α) :
    0 ≤ wordCountVec (W.take k) x ∧
    0 ≤ wordCountVec (W.drop k) x ∧
    wordCountVec (W.take k) x ≤ wordCountVec W x ∧
    wordCountVec (W.drop k) x ≤ wordCountVec W x := by
  have h1 : 0 ≤ wordCountVec (W.take k) x := by unfold wordCountVec; positivity
  have h2 : 0 ≤ wordCountVec (W.drop k) x := by unfold wordCountVec; positivity
  have hsum := wordCountVec_take_add_drop W k x
  refine ⟨h1, h2, by linarith, by linarith⟩

/-- Any prefix `((W.map (bundleToLiftedAct m w)).take k)` has zero count on every reset action `Sum.inr r'`. -/
theorem wordCountVec_take_bundleToLiftedAct_inr (m w : ℕ) (W : List (Fin m)) (k : ℕ)
    (r' : Fin ((w + 1) + (w + 1))) :
    wordCountVec ((W.map (bundleToLiftedAct m w)).take k) (Sum.inr r') = 0 := by
  rw [← List.map_take]
  unfold wordCountVec
  have hnone : ∀ y ∈ (W.take k).map (bundleToLiftedAct m w), y ≠ Sum.inr r' := by
    intro y hy h
    simp only [List.mem_map] at hy
    rcases hy with ⟨j, _, rfl⟩
    simp only [bundleToLiftedAct] at h
    contradiction
  exact_mod_cast list_count_eq_zero_of_forall_ne hnone

/-- Any suffix `((W.map (bundleToLiftedAct m w)).drop k)` has zero count on every reset action `Sum.inr r'`. -/
theorem wordCountVec_drop_bundleToLiftedAct_inr (m w : ℕ) (W : List (Fin m)) (k : ℕ)
    (r' : Fin ((w + 1) + (w + 1))) :
    wordCountVec ((W.map (bundleToLiftedAct m w)).drop k) (Sum.inr r') = 0 := by
  rw [← List.map_drop]
  unfold wordCountVec
  have hnone : ∀ y ∈ (W.drop k).map (bundleToLiftedAct m w), y ≠ Sum.inr r' := by
    intro y hy h
    simp only [List.mem_map] at hy
    rcases hy with ⟨j, _, rfl⟩
    simp only [bundleToLiftedAct] at h
    contradiction
  exact_mod_cast list_count_eq_zero_of_forall_ne hnone

/-- Any prefix `((W.map (bundleToLiftedAct m w)).take k)` has zero count on `Sum.inl (gatewayOldAct m)`. -/
theorem wordCountVec_take_bundleToLiftedAct_gateway (m w : ℕ) (W : List (Fin m)) (k : ℕ) :
    wordCountVec ((W.map (bundleToLiftedAct m w)).take k) (Sum.inl (gatewayOldAct m)) = 0 := by
  rw [← List.map_take]
  unfold wordCountVec
  have hnone : ∀ y ∈ (W.take k).map (bundleToLiftedAct m w), y ≠ Sum.inl (gatewayOldAct m) := by
    intro y hy h
    simp only [List.mem_map] at hy
    rcases hy with ⟨j, _, rfl⟩
    simp only [bundleToLiftedAct, gatewayOldAct, Sum.inl.injEq, Equiv.apply_eq_iff_eq] at h
    contradiction
  exact_mod_cast list_count_eq_zero_of_forall_ne hnone

/-- Any suffix `((W.map (bundleToLiftedAct m w)).drop k)` has zero count on `Sum.inl (gatewayOldAct m)`. -/
theorem wordCountVec_drop_bundleToLiftedAct_gateway (m w : ℕ) (W : List (Fin m)) (k : ℕ) :
    wordCountVec ((W.map (bundleToLiftedAct m w)).drop k) (Sum.inl (gatewayOldAct m)) = 0 := by
  rw [← List.map_drop]
  unfold wordCountVec
  have hnone : ∀ y ∈ (W.drop k).map (bundleToLiftedAct m w), y ≠ Sum.inl (gatewayOldAct m) := by
    intro y hy h
    simp only [List.mem_map] at hy
    rcases hy with ⟨j, _, rfl⟩
    simp only [bundleToLiftedAct, gatewayOldAct, Sum.inl.injEq, Equiv.apply_eq_iff_eq] at h
    contradiction
  exact_mod_cast list_count_eq_zero_of_forall_ne hnone

/-- **Backward Stage 3 Prefix Reset Score Identity (`wordScore_stage3_take_inr_eq_end_add_drop`)**:
    At any intermediate step `k` during Stage 3 (`(W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)`),
    the score of reset action `Sum.inr r` equals its Stage 3 end score
    `dotProduct zeta (binomBasis (w + 1) (q + 1)) - ((J * M_coupled w).mulVec (binomBasis (w + 1) (q + 1))) r + P (gatewayOldAct clock.m) r`
    plus the remaining parent coupling sum `∑ u, P u r * wordCountVec (W_stage3.drop k) (Sum.inl u)`. -/
theorem wordScore_stage3_take_inr_eq_end_add_drop {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (G_O : Matrix (Fin (clock.m + 1)) (Fin (clock.m + 1)) ℚ)
    (P : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (S : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (hPtX : P.transpose * X_gateway clock = Q_reset J (M_coupled w) (B_mat (w + 1)) zeta)
    (q k : ℕ) (r : Fin ((w + 1) + (w + 1))) :
    let s0 := (liftedScoreMat G_O J S (X_gateway clock) (M_coupled w) zeta).mulVec (binomBasis (w + 1) q)
    let W_stage3 := (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)
    wordScore (liftedGameMat G_O P J)
      (wordScore (liftedGameMat G_O P J) s0 (W_early_word clock.m w q ++ W_late_word clock.m w q))
      (W_stage3.take k) (Sum.inr r) =
    dotProduct zeta (binomBasis (w + 1) (q + 1)) -
      ((J * M_coupled w).mulVec (binomBasis (w + 1) (q + 1))) r +
      P (gatewayOldAct clock.m) r +
      ∑ u : Fin (clock.m + 1), P u r * wordCountVec (W_stage3.drop k) (Sum.inl u) := by
  intro s0 W_stage3
  have hend := wordScore_after_stage3_inr clock parentWord hparent_count G_O P J S zeta hPtX q r
  change wordScore (liftedGameMat G_O P J) s0
    ((W_early_word clock.m w q ++ W_late_word clock.m w q) ++ W_stage3) (Sum.inr r) = _ at hend
  rw [wordScore_append] at hend
  have hsplit : W_stage3 = W_stage3.take k ++ W_stage3.drop k := (List.take_append_drop k W_stage3).symm
  conv_lhs at hend => rw [hsplit, wordScore_append]
  have hdrop_inr := wordCountVec_drop_bundleToLiftedAct_inr clock.m w (W_bundle_word parentWord (q + 1)) k
  rw [wordScore_liftedGameMat_old_word_inr G_O P J _ _ hdrop_inr r] at hend
  linarith

/-- **Stage 3 Early Reset Monotonicity Upper Bound (`wordScore_stage3_take_early_inr_le_end`)**:
    When `∀ u, P u (finSumFinEquiv (Sum.inl j)) ≤ 0`, the score of early reset action
    `r = finSumFinEquiv (Sum.inl j)` is non-increasing throughout Stage 3, so at every step `k`
    it is bounded above by its Stage 3 end value:
    `dotProduct zeta (binomBasis (w + 1) (q + 1)) - ((J * M_coupled w).mulVec (binomBasis (w + 1) (q + 1))) r + P (gatewayOldAct clock.m) r`. -/
theorem wordScore_stage3_take_early_inr_le_end {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (G_O : Matrix (Fin (clock.m + 1)) (Fin (clock.m + 1)) ℚ)
    (P : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (S : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (hPtX : P.transpose * X_gateway clock = Q_reset J (M_coupled w) (B_mat (w + 1)) zeta)
    (j : Fin (w + 1))
    (hP_early : ∀ u : Fin (clock.m + 1), P u (finSumFinEquiv (Sum.inl j)) ≤ 0)
    (q k : ℕ) :
    let s0 := (liftedScoreMat G_O J S (X_gateway clock) (M_coupled w) zeta).mulVec (binomBasis (w + 1) q)
    let W_stage3 := (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)
    let r := finSumFinEquiv (Sum.inl j)
    wordScore (liftedGameMat G_O P J)
      (wordScore (liftedGameMat G_O P J) s0 (W_early_word clock.m w q ++ W_late_word clock.m w q))
      (W_stage3.take k) (Sum.inr r) ≤
    dotProduct zeta (binomBasis (w + 1) (q + 1)) -
      ((J * M_coupled w).mulVec (binomBasis (w + 1) (q + 1))) r +
      P (gatewayOldAct clock.m) r := by
  intro s0 W_stage3 r
  have hback := wordScore_stage3_take_inr_eq_end_add_drop clock parentWord hparent_count G_O P J S zeta hPtX q k r
  dsimp only at hback
  rw [hback]
  have hsum_nonpos : ∑ u : Fin (clock.m + 1), P u r * wordCountVec (W_stage3.drop k) (Sum.inl u) ≤ 0 := by
    apply Finset.sum_nonpos
    intro u _
    have h1 := hP_early u
    have h2 : 0 ≤ wordCountVec (W_stage3.drop k) (Sum.inl u) := by unfold wordCountVec; positivity
    exact mul_nonpos_of_nonpos_of_nonneg h1 h2
  linarith

/-- **Stage 3 Late Reset Monotonicity Upper Bound (`wordScore_stage3_take_late_inr_le_start`)**:
    When `∀ u, 0 ≤ P u (finSumFinEquiv (Sum.inr j))`, the score of late reset action
    `r = finSumFinEquiv (Sum.inr j)` is non-increasing throughout Stage 3, so at every step `k`
    it is bounded above by its Stage 3 start value:
    `((V_reset J (M_coupled w) (B_mat (w + 1)) zeta).mulVec (binomBasis (w + 1) (q + 1))) r`. -/
theorem wordScore_stage3_take_late_inr_le_start {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (G_O : Matrix (Fin (clock.m + 1)) (Fin (clock.m + 1)) ℚ)
    (P : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (S : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (j : Fin (w + 1))
    (hP_late : ∀ u : Fin (clock.m + 1), 0 ≤ P u (finSumFinEquiv (Sum.inr j)))
    (q k : ℕ) :
    let s0 := (liftedScoreMat G_O J S (X_gateway clock) (M_coupled w) zeta).mulVec (binomBasis (w + 1) q)
    let W_stage3 := (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)
    let r := finSumFinEquiv (Sum.inr j)
    wordScore (liftedGameMat G_O P J)
      (wordScore (liftedGameMat G_O P J) s0 (W_early_word clock.m w q ++ W_late_word clock.m w q))
      (W_stage3.take k) (Sum.inr r) ≤
    ((V_reset J (M_coupled w) (B_mat (w + 1)) zeta).mulVec (binomBasis (w + 1) (q + 1))) r := by
  intro s0 W_stage3 r
  have htake_inr := wordCountVec_take_bundleToLiftedAct_inr clock.m w (W_bundle_word parentWord (q + 1)) k
  rw [wordScore_liftedGameMat_old_word_inr G_O P J _ _ htake_inr r]
  rw [wordScore_after_reset_stages_inr clock G_O P J S zeta q r]
  have hV := congr_fun (one_zeta_sub_J_transpose_mul_M_mulVec_binomBasis w J (M_coupled w) zeta q) r
  rw [hV]
  have hsum_nonneg : 0 ≤ ∑ u : Fin (clock.m + 1), P u r * wordCountVec (W_stage3.take k) (Sum.inl u) := by
    apply Finset.sum_nonneg
    intro u _
    have h1 := hP_late u
    have h2 : 0 ≤ wordCountVec (W_stage3.take k) (Sum.inl u) := by unfold wordCountVec; positivity
    exact mul_nonneg h1 h2
  linarith

/-- **Exact Stage 3 End Parent Score Identity on `liftedGameMat` (`wordScore_after_stage3_admissible_parent`)**:
    At the end of Stage 3 (`W_early_word ++ W_late_word ++ (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)`),
    immediately before the gateway action `g` is played in Stage 4, the score of every parent action
    `Sum.inl (parentToOldAct clock.m i)` is given by:
    `(shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)) i + (clock.R.mulVec (binomBasis w (q + 1)) i - clock.R.mulVec (binomBasis w 0) i) + dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) (q + 1))`. -/
theorem wordScore_after_stage3_admissible_parent {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (q : ℕ) (i : Fin clock.m) :
    wordScore
      (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (J_admissible_scaled clock b H0 ch delta c_zeta)
        (S_admissible clock b H0 ch delta)
        (X_gateway clock) (M_coupled w)
        (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q))
      (W_early_word clock.m w q ++ W_late_word clock.m w q ++
        (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w))
      (Sum.inl (parentToOldAct clock.m i)) =
    (shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)) i +
      (clock.R.mulVec (binomBasis w (q + 1)) i - clock.R.mulVec (binomBasis w 0) i) +
      dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) (q + 1)) := by
  have hs_mid : (fun u => wordScore
      (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (J_admissible_scaled clock b H0 ch delta c_zeta)
        (S_admissible clock b H0 ch delta)
        (X_gateway clock) (M_coupled w)
        (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q))
      (W_early_word clock.m w q ++ W_late_word clock.m w q) (Sum.inl u)) =
      (S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) (q + 1)) := by
    ext u
    exact wordScore_after_reset_stages_admissible_inl hw clock b H0 ch delta c_zeta c_P0 a_old L_C q u
  rw [wordScore_append, map_bundleToLiftedAct_eq_map_inl]
  have hold := wordScore_map_inl_old
    (AdjoinLeaderEndpointG clock.G b clock.v)
    (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
    (J_admissible_scaled clock b H0 ch delta c_zeta)
    (wordScore
      (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (J_admissible_scaled clock b H0 ch delta c_zeta)
        (S_admissible clock b H0 ch delta)
        (X_gateway clock) (M_coupled w)
        (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q))
      (W_early_word clock.m w q ++ W_late_word clock.m w q))
    ((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m))
    (parentToOldAct clock.m i)
  change wordScore (liftedGameMat _ _ _) _ _ _ = _ at hold
  rw [hold, hs_mid]
  exact wordScore_bundle_word_admissible_parent_all_Q clock b H0 ch delta parentWord hparent_count (q + 1) i

/-- **Exact Stage 3 End Gateway Score Identity on `liftedGameMat` (`wordScore_after_stage3_admissible_gateway`)**:
    At the end of Stage 3 (`W_early_word ++ W_late_word ++ (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)`),
    immediately before the gateway action `g` is played in Stage 4, the score of the gateway action
    `gatewayToLiftedAct clock.m w = Sum.inl (gatewayOldAct clock.m)` is given by:
    `(shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)) b + (clock.R.mulVec (binomBasis w (q + 1)) b - clock.R.mulVec (binomBasis w 0) b) + dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) (q + 1)) + delta`. -/
theorem wordScore_after_stage3_admissible_gateway {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (q : ℕ) :
    wordScore
      (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (J_admissible_scaled clock b H0 ch delta c_zeta)
        (S_admissible clock b H0 ch delta)
        (X_gateway clock) (M_coupled w)
        (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q))
      (W_early_word clock.m w q ++ W_late_word clock.m w q ++
        (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w))
      (gatewayToLiftedAct clock.m w) =
    (shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)) b +
      (clock.R.mulVec (binomBasis w (q + 1)) b - clock.R.mulVec (binomBasis w 0) b) +
      dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) (q + 1)) + delta := by
  have hgw_eq : gatewayToLiftedAct clock.m w = Sum.inl (gatewayOldAct clock.m) := rfl
  have hs_mid : (fun u => wordScore
      (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (J_admissible_scaled clock b H0 ch delta c_zeta)
        (S_admissible clock b H0 ch delta)
        (X_gateway clock) (M_coupled w)
        (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q))
      (W_early_word clock.m w q ++ W_late_word clock.m w q) (Sum.inl u)) =
      (S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) (q + 1)) := by
    ext u
    exact wordScore_after_reset_stages_admissible_inl hw clock b H0 ch delta c_zeta c_P0 a_old L_C q u
  rw [hgw_eq, wordScore_append, map_bundleToLiftedAct_eq_map_inl]
  have hold := wordScore_map_inl_old
    (AdjoinLeaderEndpointG clock.G b clock.v)
    (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
    (J_admissible_scaled clock b H0 ch delta c_zeta)
    (wordScore
      (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (J_admissible_scaled clock b H0 ch delta c_zeta)
        (S_admissible clock b H0 ch delta)
        (X_gateway clock) (M_coupled w)
        (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q))
      (W_early_word clock.m w q ++ W_late_word clock.m w q))
    ((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m))
    (gatewayOldAct clock.m)
  change wordScore (liftedGameMat _ _ _) _ _ _ = _ at hold
  rw [hold, hs_mid]
  exact wordScore_bundle_word_admissible_gateway_all_Q (by omega) clock b H0 ch delta parentWord hparent_count (q + 1)

/-- **Stage 4 All-Competitor Gateway Dominance Reduction (`admissible_stage4_gw_of_parent_and_reset_bounds`)**:
    At the Stage 4 boundary (end of Stage 3), strict dominance of `gatewayToLiftedAct clock.m w`
    over every competitor `y ≠ gatewayToLiftedAct clock.m w` reduces to:
    1. `0 < delta` (discharging the designated leader `b` unconditionally),
    2. For every non-leader parent action `i ≠ b`, its polynomial score at `q + 1` is within `delta`
       of the leader `b`'s polynomial score, and
    3. For every reset action `r`, its Stage 3 end score `zeta · p(q+1) - (J M p(q+1))_r + P_{g, r}`
       is strictly below the gateway score. -/
theorem admissible_stage4_gw_of_parent_and_reset_bounds {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (q : ℕ)
    (hdelta_pos : 0 < delta)
    (hparent_bound : ∀ i : Fin clock.m, i ≠ b →
      (shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)) i +
        (clock.R.mulVec (binomBasis w (q + 1)) i - clock.R.mulVec (binomBasis w 0) i) <
      (shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)) b +
        (clock.R.mulVec (binomBasis w (q + 1)) b - clock.R.mulVec (binomBasis w 0) b) + delta)
    (hreset_bound : ∀ r : Fin ((w + 1) + (w + 1)),
      dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) (q + 1)) -
        ((J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w).mulVec (binomBasis (w + 1) (q + 1))) r +
        P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (gatewayOldAct clock.m) r <
      (shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)) b +
        (clock.R.mulVec (binomBasis w (q + 1)) b - clock.R.mulVec (binomBasis w 0) b) +
        dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) (q + 1)) + delta) :
    let M_game := liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
      (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
      (J_admissible_scaled clock b H0 ch delta c_zeta)
    let s0 := (liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
      (J_admissible_scaled clock b H0 ch delta c_zeta)
      (S_admissible clock b H0 ch delta)
      (X_gateway clock) (M_coupled w)
      (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q)
    let W_stage123 := W_early_word clock.m w q ++ W_late_word clock.m w q ++
      (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)
    ∀ y, y ≠ gatewayToLiftedAct clock.m w →
      wordScore M_game s0 W_stage123 y <
        wordScore M_game s0 W_stage123 (gatewayToLiftedAct clock.m w) := by
  intro M_game s0 W_stage123 y hy
  rw [wordScore_after_stage3_admissible_gateway hw clock b H0 ch delta c_zeta c_P0 a_old L_C parentWord hparent_count q]
  cases y with
  | inl u =>
    rcases (finSumFinEquiv : Fin clock.m ⊕ Fin 1 ≃ Fin (clock.m + 1)).surjective u with ⟨s, rfl⟩
    cases s with
    | inl i =>
      have hp : finSumFinEquiv (Sum.inl i) = parentToOldAct clock.m i := rfl
      rw [hp, wordScore_after_stage3_admissible_parent hw clock b H0 ch delta c_zeta c_P0 a_old L_C parentWord hparent_count q i]
      by_cases hib : i = b
      · subst hib
        linarith
      · have hpb := hparent_bound i hib
        linarith
    | inr v =>
      have hv0 : v = 0 := Subsingleton.elim v 0
      subst hv0
      exact (hy rfl).elim
  | inr r =>
    rw [wordScore_after_stage3_admissible_inr clock b H0 ch delta c_zeta c_P0 a_old L_C hLC parentWord hparent_count q r]
    exact hreset_bound r

/-- **Stage 3 Prefix Gateway-vs-Leader Score Difference (`wordScore_bundle_take_gateway_sub_leader`)**:
    At any prefix `k` during the Stage 3 parent bundle `(W_bundle_word parentWord Q).map (parentToOldAct clock.m)`,
    the gateway score minus the designated leader `b`'s score on `AdjoinLeaderEndpointG` is given by:
    `delta - (Q : ℚ) + dotProduct clock.v (wordCountVec ((W_bundle_word parentWord Q).take k))`. -/
theorem wordScore_bundle_take_gateway_sub_leader {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ)
    (W_p : List (Fin clock.m)) (Q k : ℕ) :
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v)
      ((S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) Q))
      ((W_p.map (parentToOldAct clock.m)).take k)
      (gatewayOldAct clock.m) -
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v)
      ((S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) Q))
      ((W_p.map (parentToOldAct clock.m)).take k)
      (parentToOldAct clock.m b) =
    delta - (Q : ℚ) + dotProduct clock.v (wordCountVec (W_p.take k)) := by
  have hinj : Function.Injective (parentToOldAct clock.m) := by
    intro a b_idx hab
    simp only [parentToOldAct, Equiv.apply_eq_iff_eq, Sum.inl.injEq] at hab
    exact hab
  rw [← List.map_take]
  simp only [wordScore, scoreVec, Matrix.mulVec, dotProduct]
  rw [(Equiv.sum_comp finSumFinEquiv fun y => (AdjoinLeaderEndpointG clock.G b clock.v) (gatewayOldAct clock.m) y *
    wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) y).symm]
  rw [(Equiv.sum_comp finSumFinEquiv fun y => (AdjoinLeaderEndpointG clock.G b clock.v) (parentToOldAct clock.m b) y *
    wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) y).symm]
  rw [Fintype.sum_sum_type, Fintype.sum_sum_type]
  have hcount_inr : ∀ v : Fin 1,
      wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inr v)) = 0 := by
    intro v
    unfold wordCountVec
    have hnone : ∀ y ∈ (W_p.take k).map (parentToOldAct clock.m),
        y ≠ finSumFinEquiv (Sum.inr v) := by
      intro y hy h
      simp only [List.mem_map] at hy
      rcases hy with ⟨j, _, rfl⟩
      simp only [parentToOldAct, Equiv.apply_eq_iff_eq] at h
      contradiction
    exact_mod_cast list_count_eq_zero_of_forall_ne hnone
  simp only [hcount_inr, mul_zero, Finset.sum_const_zero, add_zero]
  have hcount_inl : ∀ j : Fin clock.m,
      wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inl j)) =
      wordCountVec (W_p.take k) j := by
    intro j
    have hp : finSumFinEquiv (Sum.inl j) = parentToOldAct clock.m j := rfl
    rw [hp]
    unfold wordCountVec
    rw [list_count_map_of_injective (parentToOldAct clock.m) hinj (W_p.take k) j]
  have hsum_gw : (∑ j : Fin clock.m, (AdjoinLeaderEndpointG clock.G b clock.v) (gatewayOldAct clock.m) (finSumFinEquiv (Sum.inl j)) *
      wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inl j))) =
      (∑ j : Fin clock.m, clock.G b j * wordCountVec (W_p.take k) j) +
      (∑ j : Fin clock.m, clock.v j * wordCountVec (W_p.take k) j) := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hcount_inl j]
    have hrow := leader_endpoint_row clock.G b clock.v j
    have hg : gatewayOldAct clock.m = finSumFinEquiv (Sum.inr 0) := rfl
    rw [hg, hrow]
    ring
  have hsum_lead : (∑ j : Fin clock.m, (AdjoinLeaderEndpointG clock.G b clock.v) (parentToOldAct clock.m b) (finSumFinEquiv (Sum.inl j)) *
      wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inl j))) =
      ∑ j : Fin clock.m, clock.G b j * wordCountVec (W_p.take k) j := by
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hcount_inl j]
    have hp : finSumFinEquiv (Sum.inl j) = parentToOldAct clock.m j := rfl
    rw [hp, AdjoinLeaderEndpointG_parent_parent clock.G b clock.v b j]
  have hs_gw := S_admissible_mulVec_binomBasis_inr hw clock b H0 ch delta Q
  have hs_lead := S_admissible_mulVec_binomBasis_inl clock b H0 ch delta Q b
  simp only [Matrix.mulVec, dotProduct] at hs_gw hs_lead
  rw [hs_gw, hs_lead, hsum_gw, hsum_lead]
  ring

/-- Entrywise nonnegativity of the coupled reset count matrix `M_coupled w`. -/
theorem M_coupled_nonneg (w : ℕ) (r : Fin ((w + 1) + (w + 1))) (c : Fin (w + 1)) :
    0 ≤ M_coupled w r c := by
  have := M_coupled_entry_ge_one w r c
  linarith

/-- Entrywise nonnegativity of `J_admissible_scaled` whenever `c_zeta` dominates `canonicalCZeta_admissible`. -/
theorem J_admissible_scaled_nonneg_of_ge {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta : ℚ) (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta)
    (a b_idx : Fin ((w + 1) + (w + 1))) :
    0 ≤ J_admissible_scaled clock b H0 ch delta c_zeta a b_idx := by
  by_cases hab : a.val ≤ b_idx.val
  · rw [J_admissible_scaled_lower clock b H0 ch delta c_zeta a b_idx hab]
  · have hab' : b_idx.val < a.val := by omega
    have hcan := (J_admissible_scaled_canonicalCZeta_subdiag_pos clock b H0 ch delta a b_idx hab').2
    have hJ := (J_coupled_subdiag_ge w a b_idx hab').2
    have hdiff : J_admissible_scaled clock b H0 ch delta c_zeta a b_idx =
        J_admissible_scaled clock b H0 ch delta (canonicalCZeta_admissible clock b H0 ch delta) a b_idx +
          (c_zeta - canonicalCZeta_admissible clock b H0 ch delta) * J_coupled w a b_idx := by
      dsimp only [J_admissible_scaled]
      simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
      ring
    have h_prod : 0 ≤ (c_zeta - canonicalCZeta_admissible clock b H0 ch delta) * J_coupled w a b_idx :=
      mul_nonneg (by linarith) (le_of_lt hJ)
    rw [hdiff]
    linarith

/-- Nonnegativity of `(J_admissible_scaled * M_coupled).mulVec (binomBasis (w + 1) Q)` entrywise. -/
theorem JM_admissible_scaled_mulVec_binomBasis_nonneg {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ)
    (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta) (Q : ℕ)
    (r : Fin ((w + 1) + (w + 1))) :
    0 ≤ ((J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w).mulVec (binomBasis (w + 1) Q)) r := by
  simp only [Matrix.mulVec, dotProduct, Matrix.mul_apply]
  apply Finset.sum_nonneg
  intro c _
  have h_basis : 0 ≤ binomBasis (w + 1) Q c := by
    unfold binomBasis
    exact Nat.cast_nonneg _
  apply mul_nonneg _ h_basis
  apply Finset.sum_nonneg
  intro k _
  have hJ := J_admissible_scaled_nonneg_of_ge clock b H0 ch delta c_zeta h_cz r k
  have hM := M_coupled_nonneg w k c
  exact mul_nonneg hJ hM

/-- Nonnegativity of `((J_admissible_scaled)ᵀ * M_coupled).mulVec (binomBasis (w + 1) Q)` entrywise. -/
theorem JTM_admissible_scaled_mulVec_binomBasis_nonneg {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ)
    (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta) (Q : ℕ)
    (r : Fin ((w + 1) + (w + 1))) :
    0 ≤ (((J_admissible_scaled clock b H0 ch delta c_zeta).transpose * M_coupled w).mulVec (binomBasis (w + 1) Q)) r := by
  simp only [Matrix.mulVec, dotProduct, Matrix.mul_apply, Matrix.transpose_apply]
  apply Finset.sum_nonneg
  intro c _
  have h_basis : 0 ≤ binomBasis (w + 1) Q c := by
    unfold binomBasis
    exact Nat.cast_nonneg _
  apply mul_nonneg _ h_basis
  apply Finset.sum_nonneg
  intro k _
  have hJ := J_admissible_scaled_nonneg_of_ge clock b H0 ch delta c_zeta h_cz k r
  have hM := M_coupled_nonneg w k c
  exact mul_nonneg hJ hM

/-- Upper bound evaluating `V_reset` on `binomBasis (w + 1) (q + 1)` by `dotProduct zeta (binomBasis (w + 1) q)`. -/
theorem V_reset_admissible_scaled_mulVec_binomBasis_le_zeta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ)
    (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta) (q : ℕ)
    (r : Fin ((w + 1) + (w + 1))) :
    ((V_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
      (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec
        (binomBasis (w + 1) (q + 1))) r ≤
      dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) q) := by
  have hV := congr_fun (one_zeta_sub_J_transpose_mul_M_mulVec_binomBasis w
    (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w)
    (zeta_admissible_scaled clock b H0 ch delta c_zeta) q) r
  rw [← hV]
  simp only [Matrix.sub_mulVec, Pi.sub_apply]
  have h_one : ((one_zeta (Fin ((w + 1) + (w + 1)))
      (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec
        (binomBasis (w + 1) q)) r =
      dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) q) := by
    simp only [Matrix.mulVec, dotProduct, one_zeta, Matrix.of_apply]
  rw [h_one]
  have h_jtm := JTM_admissible_scaled_mulVec_binomBasis_nonneg clock b H0 ch delta c_zeta h_cz q r
  linarith

/-- Upper bound on reset action score at the end of Stage 3 for the scaled admissible lift. -/
theorem wordScore_after_stage3_admissible_inr_le_zeta_add_P {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta)
    (q : ℕ) (r : Fin ((w + 1) + (w + 1))) :
    wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (J_admissible_scaled clock b H0 ch delta c_zeta)
        (S_admissible clock b H0 ch delta)
        (X_gateway clock) (M_coupled w)
        (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q))
      (W_early_word clock.m w q ++ W_late_word clock.m w q ++
        (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w))
      (Sum.inr r) ≤
    dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) (q + 1)) +
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (gatewayOldAct clock.m) r := by
  rw [wordScore_after_stage3_admissible_inr clock b H0 ch delta c_zeta c_P0 a_old L_C hLC parentWord hparent_count q r]
  have hjm := JM_admissible_scaled_mulVec_binomBasis_nonneg clock b H0 ch delta c_zeta h_cz (q + 1) r
  linarith

/-- **Stage 3 Early Reset Monotonicity Upper Bound for Scaled Admissible Lift (`wordScore_stage3_take_early_admissible_le_zeta_add_P`)**:
    When early columns of `P_admissible_scaled` are non-positive (`hP_early`), at any intermediate
    step `k` during Stage 3, the score of early reset action `r = finSumFinEquiv (Sum.inl j)`
    is bounded above by `dotProduct zeta (binomBasis (w + 1) (q + 1)) + P (gatewayOldAct clock.m) r`. -/
theorem wordScore_stage3_take_early_admissible_le_zeta_add_P {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta)
    (j : Fin (w + 1))
    (hP_early : ∀ u : Fin (clock.m + 1),
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C u (finSumFinEquiv (Sum.inl j)) ≤ 0)
    (q k : ℕ) :
    let s0 := (liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
      (J_admissible_scaled clock b H0 ch delta c_zeta)
      (S_admissible clock b H0 ch delta)
      (X_gateway clock) (M_coupled w)
      (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q)
    let W_stage3 := (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)
    let r := finSumFinEquiv (Sum.inl j)
    wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      (wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
        s0 (W_early_word clock.m w q ++ W_late_word clock.m w q))
      (W_stage3.take k) (Sum.inr r) ≤
    dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) (q + 1)) +
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (gatewayOldAct clock.m) r := by
  intro s0 W_stage3 r
  have hbase := wordScore_stage3_take_early_inr_le_end clock parentWord hparent_count
    (AdjoinLeaderEndpointG clock.G b clock.v)
    (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
    (J_admissible_scaled clock b H0 ch delta c_zeta)
    (S_admissible clock b H0 ch delta)
    (zeta_admissible_scaled clock b H0 ch delta c_zeta)
    (P_admissible_scaled_transpose_mul_X clock b H0 ch delta c_zeta c_P0 a_old L_C hLC)
    j hP_early q k
  dsimp only at hbase
  have hjm := JM_admissible_scaled_mulVec_binomBasis_nonneg clock b H0 ch delta c_zeta h_cz (q + 1) r
  linarith

/-- **Stage 3 Late Reset Monotonicity Upper Bound for Scaled Admissible Lift (`wordScore_stage3_take_late_admissible_le_zeta_prev`)**:
    When late columns of `P_admissible_scaled` are non-negative (`hP_late`), at any intermediate
    step `k` during Stage 3, the score of late reset action `r = finSumFinEquiv (Sum.inr j)`
    is bounded above by its Stage 3 start ceiling:
    `dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) q)`. -/
theorem wordScore_stage3_take_late_admissible_le_zeta_prev {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (parentWord : ℕ → List (Fin clock.m))
    (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta)
    (j : Fin (w + 1))
    (hP_late : ∀ u : Fin (clock.m + 1),
      0 ≤ P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C u (finSumFinEquiv (Sum.inr j)))
    (q k : ℕ) :
    let s0 := (liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
      (J_admissible_scaled clock b H0 ch delta c_zeta)
      (S_admissible clock b H0 ch delta)
      (X_gateway clock) (M_coupled w)
      (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q)
    let W_stage3 := (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)
    let r := finSumFinEquiv (Sum.inr j)
    wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      (wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
        s0 (W_early_word clock.m w q ++ W_late_word clock.m w q))
      (W_stage3.take k) (Sum.inr r) ≤
    dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) q) := by
  intro s0 W_stage3 r
  have hbase := wordScore_stage3_take_late_inr_le_start clock parentWord
    (AdjoinLeaderEndpointG clock.G b clock.v)
    (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
    (J_admissible_scaled clock b H0 ch delta c_zeta)
    (S_admissible clock b H0 ch delta)
    (zeta_admissible_scaled clock b H0 ch delta c_zeta)
    j hP_late q k
  dsimp only at hbase
  have hV := V_reset_admissible_scaled_mulVec_binomBasis_le_zeta clock b H0 ch delta c_zeta h_cz q r
  linarith

/-- Universal degree-shifted count matrix evaluation identity:
    for any matrix `R : Matrix α (Fin w) ℚ`, evaluating `shiftRightCount R` at `binomBasis (w + 1) Q`
    yields the cumulative sum $\sum_{\sigma < Q} R p_w(\sigma)$. -/
theorem shiftRightCount_mulVec_binomBasis_eq_sum {α : Type*} {w : ℕ} (R : Matrix α (Fin w) ℚ)
    (Q : ℕ) (i : α) :
    ((shiftRightCount R).mulVec (binomBasis (w + 1) Q)) i =
      ∑ σ ∈ Finset.range Q, (R.mulVec (binomBasis w σ)) i := by
  simp only [Matrix.mulVec, dotProduct]
  rw [Fin.sum_univ_succ]
  have h0 : shiftRightCount R i 0 = 0 := by
    simp [shiftRightCount]
  rw [h0, zero_mul, zero_add, Finset.sum_comm]
  refine Finset.sum_congr rfl fun d _ => ?_
  have hshift : shiftRightCount R i d.succ = R i d := by
    simp [shiftRightCount]
  rw [hshift]
  simp only [binomBasis]
  have hchoose := sum_range_choose d.val Q
  have hdsucc : d.succ.val = d.val + 1 := rfl
  rw [hdsucc, ← hchoose, Finset.mul_sum]

/-- Telescoping decomposition of Stage 3 cumulative parent score:
    for any matrix `R : Matrix α (Fin w) ℚ`, the sum of degree-shifted score and the net boundary change
    $(R p_w(q+1) - R p_w(0))$ equals the phase-shifted sum $\sum_{\sigma < q + 1} R p_w(\sigma + 1)$.
    The phase-0 initial score term $R p_w(0)$ cancels exactly with the lower boundary of the sum. -/
theorem stage3_end_parent_score_base_eq_sum_succ {α : Type*} {w : ℕ} (R : Matrix α (Fin w) ℚ)
    (q : ℕ) (i : α) :
    ((shiftRightCount R).mulVec (binomBasis (w + 1) (q + 1))) i +
      (R.mulVec (binomBasis w (q + 1)) i - R.mulVec (binomBasis w 0) i) =
    ∑ σ ∈ Finset.range (q + 1), (R.mulVec (binomBasis w (σ + 1))) i := by
  rw [shiftRightCount_mulVec_binomBasis_eq_sum]
  rw [Finset.sum_range_succ' (fun σ => (R.mulVec (binomBasis w σ)) i) q]
  have hlast : (∑ σ ∈ Finset.range (q + 1), (R.mulVec (binomBasis w (σ + 1))) i) =
      (∑ σ ∈ Finset.range q, (R.mulVec (binomBasis w (σ + 1))) i) +
        (R.mulVec (binomBasis w (q + 1)) i) :=
    Finset.sum_range_succ (fun σ => (R.mulVec (binomBasis w (σ + 1))) i) q
  rw [hlast]
  ring

/-- Strict parent score bound at Stage 4 boundary from phase leadership:
    if competitor `i` has polynomial score $\le$ leader `b` at each phase $1 \le \sigma + 1 \le q + 1$,
    then its accumulated Stage 3 parent score is strictly less than $b$'s score plus $\delta$. -/
theorem stage4_parent_bound_of_phase_leader {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (delta : ℚ) (hdelta : 0 < delta) (q : ℕ) (i : Fin clock.m)
    (hlead : ∀ σ ∈ Finset.range (q + 1),
      (clock.R.mulVec (binomBasis w (σ + 1))) i ≤ (clock.R.mulVec (binomBasis w (σ + 1))) b) :
    (shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)) i +
      (clock.R.mulVec (binomBasis w (q + 1)) i - clock.R.mulVec (binomBasis w 0) i) <
    (shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)) b +
      (clock.R.mulVec (binomBasis w (q + 1)) b - clock.R.mulVec (binomBasis w 0) b) + delta := by
  rw [stage3_end_parent_score_base_eq_sum_succ clock.R q i]
  rw [stage3_end_parent_score_base_eq_sum_succ clock.R q b]
  have hsum :
      (∑ σ ∈ Finset.range (q + 1), (clock.R.mulVec (binomBasis w (σ + 1))) i) ≤
        ∑ σ ∈ Finset.range (q + 1), (clock.R.mulVec (binomBasis w (σ + 1))) b :=
    Finset.sum_le_sum fun σ hσ => hlead σ hσ
  linarith

/-- **Stage 4 All-Competitor Gateway Dominance from Phase Leadership (`admissible_stage4_gw_of_phase_leader_and_reset_bounds`)**:
    At the Stage 4 boundary (end of Stage 3), strict dominance of `gatewayToLiftedAct clock.m w`
    over every competitor `y ≠ gatewayToLiftedAct clock.m w` holds whenever:
    1. `0 < delta`,
    2. The designated leader `b` dominates every non-leader parent action `i ≠ b` across all phases
       `1 ≤ σ + 1 ≤ q + 1`, and
    3. For every reset action `r`, its Stage 3 end score is strictly below the gateway score. -/
theorem admissible_stage4_gw_of_phase_leader_and_reset_bounds {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (q : ℕ)
    (hdelta_pos : 0 < delta)
    (hphase_leader : ∀ i : Fin clock.m, i ≠ b → ∀ σ ∈ Finset.range (q + 1),
      (clock.R.mulVec (binomBasis w (σ + 1))) i ≤ (clock.R.mulVec (binomBasis w (σ + 1))) b)
    (hreset_bound : ∀ r : Fin ((w + 1) + (w + 1)),
      dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) (q + 1)) -
        ((J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w).mulVec (binomBasis (w + 1) (q + 1))) r +
        P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (gatewayOldAct clock.m) r <
      (shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)) b +
        (clock.R.mulVec (binomBasis w (q + 1)) b - clock.R.mulVec (binomBasis w 0) b) +
        dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) (q + 1)) + delta) :
    let M_game := liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
      (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
      (J_admissible_scaled clock b H0 ch delta c_zeta)
    let s0 := (liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
      (J_admissible_scaled clock b H0 ch delta c_zeta)
      (S_admissible clock b H0 ch delta)
      (X_gateway clock) (M_coupled w)
      (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q)
    let W_stage123 := W_early_word clock.m w q ++ W_late_word clock.m w q ++
      (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)
    ∀ y, y ≠ gatewayToLiftedAct clock.m w →
      wordScore M_game s0 W_stage123 y <
        wordScore M_game s0 W_stage123 (gatewayToLiftedAct clock.m w) := by
  exact admissible_stage4_gw_of_parent_and_reset_bounds hw clock b H0 ch delta c_zeta c_P0 a_old L_C hLC parentWord
    hparent_count q hdelta_pos
    (fun i hib => stage4_parent_bound_of_phase_leader clock b delta hdelta_pos q i (hphase_leader i hib))
    hreset_bound

/-- Pointwise play count addition across word concatenation (extensional function equality). -/
theorem wordCountVec_append_fun {α : Type*} [DecidableEq α] (W1 W2 : List α) :
    wordCountVec (W1 ++ W2) = wordCountVec W1 + wordCountVec W2 := by
  ext a
  exact wordCountVec_append W1 W2 a

/-- Dot product distributes over `wordCountVec` of concatenated words. -/
theorem dotProduct_wordCountVec_append {α : Type*} [Fintype α] [DecidableEq α]
    (v : α → ℚ) (W1 W2 : List α) :
    dotProduct v (wordCountVec (W1 ++ W2)) =
      dotProduct v (wordCountVec W1) + dotProduct v (wordCountVec W2) := by
  simp only [dotProduct, wordCountVec_append, mul_add, Finset.sum_add_distrib]

/-- Successor expansion of flatMap over `List.range (Q + 1)`. -/
theorem range_succ_flatMap {α : Type*} (f : ℕ → List α) (Q : ℕ) :
    (List.range (Q + 1)).flatMap f = (List.range Q).flatMap f ++ f Q := by
  rw [@List.range_succ Q, List.flatMap_append]
  simp

/-- Exact dot product evaluation for flatMap across `Q` full words of unit dot product. -/
theorem dotProduct_wordCountVec_flatMap_eq {α : Type*} [Fintype α] [DecidableEq α]
    (v : α → ℚ) (f : ℕ → List α) (hfull : ∀ σ : ℕ, dotProduct v (wordCountVec (f σ)) = 1)
    (Q : ℕ) :
    dotProduct v (wordCountVec ((List.range Q).flatMap f)) = (Q : ℚ) := by
  induction Q with
  | zero =>
      simp only [List.range_zero, List.flatMap_nil, wordCountVec, List.count_nil,
        Nat.cast_zero, mul_zero, Finset.sum_const_zero, dotProduct]
  | succ Q ih =>
      rw [range_succ_flatMap, dotProduct_wordCountVec_append, ih, hfull Q]
      push_cast
      ring

/-- Upper bound on the dot product of any proper prefix of a concatenated bundle word. -/
theorem dotProduct_wordCountVec_flatMap_take_le {α : Type*} [Fintype α] [DecidableEq α]
    (v : α → ℚ) (f : ℕ → List α) (hfull : ∀ σ : ℕ, dotProduct v (wordCountVec (f σ)) = 1)
    (hproper : ∀ (σ r : ℕ), r < (f σ).length → dotProduct v (wordCountVec ((f σ).take r)) ≤ 0)
    (Q k : ℕ) (hk : k < ((List.range Q).flatMap f).length) :
    dotProduct v (wordCountVec (((List.range Q).flatMap f).take k)) ≤ (Q : ℚ) - 1 := by
  induction Q generalizing k with
  | zero =>
      simp only [List.range_zero, List.flatMap_nil, List.length_nil] at hk
      omega
  | succ Q ih =>
      rw [range_succ_flatMap]
      have h_len : ((List.range (Q + 1)).flatMap f).length =
          ((List.range Q).flatMap f).length + (f Q).length := by
        rw [range_succ_flatMap, List.length_append]
      rw [h_len] at hk
      by_cases hk1 : k < ((List.range Q).flatMap f).length
      · have htake : ((List.range Q).flatMap f ++ f Q).take k = ((List.range Q).flatMap f).take k :=
          List.take_append_of_le_length (le_of_lt hk1)
        rw [htake]
        have h_ih := ih k hk1
        have hQ : (Q : ℚ) - 1 ≤ ((Q + 1 : ℕ) : ℚ) - 1 := by
          push_cast
          linarith
        exact le_trans h_ih hQ
      · have hle : ((List.range Q).flatMap f).length ≤ k := le_of_not_gt hk1
        have hk2 : k - ((List.range Q).flatMap f).length < (f Q).length := by omega
        have htake : ((List.range Q).flatMap f ++ f Q).take k =
            (List.range Q).flatMap f ++ (f Q).take (k - ((List.range Q).flatMap f).length) := by
          rw [List.take_append, List.take_of_length_le hle]
        rw [htake, dotProduct_wordCountVec_append]
        have hfull_Q := dotProduct_wordCountVec_flatMap_eq v f hfull Q
        have hprop := hproper Q (k - ((List.range Q).flatMap f).length) hk2
        rw [hfull_Q]
        push_cast
        linarith

/-- At any proper prefix of `rawFourStageWord`, the dot product with the lifted endpoint weight vector is zero. -/
theorem rawFourStageWord_take_v_dot_eq_zero {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m)) (σ r : ℕ)
    (hr : r < (rawFourStageWord clock parentWord σ).length) :
    dotProduct (liftedWeightVec (v_old_coupled clock.m) (0 : Fin ((w + 1) + (w + 1)) → ℚ))
      (wordCountVec ((rawFourStageWord clock parentWord σ).take r)) = 0 := by
  let W_prefix : List (Fin (clock.m + 1) ⊕ Fin ((w + 1) + (w + 1))) :=
    (W_early_word clock.m w σ ++ W_late_word clock.m w σ) ++
      (W_bundle_word parentWord (σ + 1)).map (bundleToLiftedAct clock.m w)
  have h_raw : rawFourStageWord clock parentWord σ = W_prefix ++ [gatewayToLiftedAct clock.m w] := by
    unfold rawFourStageWord W_prefix
    simp only [List.append_assoc]
  have h_len : r ≤ W_prefix.length := by
    have h_tot : (rawFourStageWord clock parentWord σ).length = W_prefix.length + 1 := by
      rw [h_raw, List.length_append, List.length_singleton]
    omega
  have htake : (rawFourStageWord clock parentWord σ).take r = W_prefix.take r := by
    rw [h_raw]
    exact List.take_append_of_le_length h_len
  have h_prefix_count : wordCountVec W_prefix (gatewayToLiftedAct clock.m w) = 0 := by
    dsimp only [W_prefix]
    have hgw : gatewayToLiftedAct clock.m w = Sum.inl (gatewayOldAct clock.m) := rfl
    rw [hgw, wordCountVec_append]
    have hreset := wordCountVec_reset_stages_inl clock.m w σ (gatewayOldAct clock.m)
    have hdrop := wordCountVec_drop_bundleToLiftedAct_gateway clock.m w (W_bundle_word parentWord (σ + 1)) 0
    rw [List.drop_zero] at hdrop
    rw [hreset, hdrop, add_zero]
  have h_take_zero : wordCountVec ((rawFourStageWord clock parentWord σ).take r) (gatewayToLiftedAct clock.m w) = 0 := by
    rw [htake]
    have h1 := (wordCountVec_take_drop_bounds W_prefix r (gatewayToLiftedAct clock.m w)).1
    have h2 := (wordCountVec_take_drop_bounds W_prefix r (gatewayToLiftedAct clock.m w)).2.2.1
    rw [h_prefix_count] at h2
    linarith
  simp only [dotProduct]
  apply Finset.sum_eq_zero
  intro y _
  cases y with
  | inr r' =>
    have : liftedWeightVec (v_old_coupled clock.m) (0 : Fin ((w + 1) + (w + 1)) → ℚ) (Sum.inr r') = 0 := rfl
    rw [this, zero_mul]
  | inl u =>
    obtain ⟨sa, rfl⟩ := finSumFinEquiv.surjective u
    rcases sa with i | v
    · have hv : v_old_coupled clock.m (finSumFinEquiv (Sum.inl i)) = 0 := by
        dsimp only [v_old_coupled]
        rw [Equiv.symm_apply_apply]
      have hvec : liftedWeightVec (v_old_coupled clock.m) (0 : Fin ((w + 1) + (w + 1)) → ℚ)
          (Sum.inl (finSumFinEquiv (Sum.inl i))) = 0 := hv
      rw [hvec, zero_mul]
    · have hv0 : v = 0 := Subsingleton.elim v 0
      subst hv0
      have hy : Sum.inl (finSumFinEquiv (Sum.inr (0 : Fin 1))) = gatewayToLiftedAct clock.m w := rfl
      rw [hy, h_take_zero, mul_zero]

/-- Exact Stage 3 prefix score of parent action under embedding `parentToOldAct clock.m`:
    the lifted score on `AdjoinLeaderEndpointG` equals the parent game's score shifted by
    the constant linear polynomial `dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) Q)`. -/
theorem wordScore_bundle_take_parentToOldAct {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ)
    (W_p : List (Fin clock.m)) (Q k : ℕ) (i : Fin clock.m) :
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v)
      ((S_admissible clock b H0 ch delta).mulVec (binomBasis (w + 1) Q))
      ((W_p.map (parentToOldAct clock.m)).take k)
      (parentToOldAct clock.m i) =
    wordScore clock.G
      ((shiftRightCount clock.R).mulVec (binomBasis (w + 1) Q))
      (W_p.take k) i +
    dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) Q) := by
  have hinj : Function.Injective (parentToOldAct clock.m) := by
    intro a b_idx hab
    simp only [parentToOldAct, Equiv.apply_eq_iff_eq, Sum.inl.injEq] at hab
    exact hab
  rw [← List.map_take]
  simp only [wordScore, scoreVec, Matrix.mulVec, dotProduct]
  rw [(Equiv.sum_comp finSumFinEquiv fun y => (AdjoinLeaderEndpointG clock.G b clock.v) (parentToOldAct clock.m i) y *
    wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) y).symm]
  rw [Fintype.sum_sum_type]
  have hcount_inr : ∀ v : Fin 1,
      wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inr v)) = 0 := by
    intro v
    unfold wordCountVec
    have hnone : ∀ y ∈ (W_p.take k).map (parentToOldAct clock.m),
        y ≠ finSumFinEquiv (Sum.inr v) := by
      intro y hy h
      simp only [List.mem_map] at hy
      rcases hy with ⟨j, _, rfl⟩
      simp only [parentToOldAct, Equiv.apply_eq_iff_eq] at h
      contradiction
    exact_mod_cast list_count_eq_zero_of_forall_ne hnone
  simp only [hcount_inr, mul_zero, Finset.sum_const_zero, add_zero]
  have hcount_inl : ∀ j : Fin clock.m,
      wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inl j)) =
      wordCountVec (W_p.take k) j := by
    intro j
    have hp : finSumFinEquiv (Sum.inl j) = parentToOldAct clock.m j := rfl
    rw [hp]
    unfold wordCountVec
    rw [list_count_map_of_injective (parentToOldAct clock.m) hinj (W_p.take k) j]
  have hsum_i : (∑ j : Fin clock.m, (AdjoinLeaderEndpointG clock.G b clock.v) (parentToOldAct clock.m i) (finSumFinEquiv (Sum.inl j)) *
      wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inl j))) =
      ∑ j : Fin clock.m, clock.G i j * wordCountVec (W_p.take k) j := by
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hcount_inl j]
    have hp : finSumFinEquiv (Sum.inl j) = parentToOldAct clock.m j := rfl
    rw [hp, AdjoinLeaderEndpointG_parent_parent clock.G b clock.v i j]
  have hs_i := S_admissible_mulVec_binomBasis_inl clock b H0 ch delta Q i
  simp only [Matrix.mulVec, dotProduct] at hs_i
  rw [hs_i, hsum_i]
  ring

/-!
### 13. Subdiagonal Scaling Lower Bounds for `JM` and `JᵀM`
-/

/-- Subdiagonal lower bound for `J_admissible_scaled` scaling linearly with `c_zeta`:
    for any `c_zeta ≥ canonicalCZeta_admissible`, every subdiagonal entry `b_idx.val < a.val`
    is bounded below by `(1 + (c_zeta - canonicalCZeta)) * (4 * (w + 1))⁻¹`. -/
theorem J_admissible_scaled_subdiag_ge_of_ge {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta : ℚ) (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta)
    (a b_idx : Fin ((w + 1) + (w + 1))) (hab : b_idx.val < a.val) :
    (1 + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta)) * (4 * (w + 1 : ℚ))⁻¹ ≤
      J_admissible_scaled clock b H0 ch delta c_zeta a b_idx := by
  have h_can := (J_admissible_scaled_canonicalCZeta_subdiag_pos clock b H0 ch delta a b_idx hab).1
  have h_coup := (J_coupled_subdiag_ge w a b_idx hab).1
  have h_diff : 0 ≤ c_zeta - canonicalCZeta_admissible clock b H0 ch delta := by linarith
  have h_mul : (c_zeta - canonicalCZeta_admissible clock b H0 ch delta) * (4 * (w + 1 : ℚ))⁻¹ ≤
      (c_zeta - canonicalCZeta_admissible clock b H0 ch delta) * J_coupled w a b_idx :=
    mul_le_mul_of_nonneg_left h_coup h_diff
  have h_expand : (c_zeta - canonicalCZeta_admissible clock b H0 ch delta) * J_coupled w a b_idx =
      c_zeta * J_coupled w a b_idx - canonicalCZeta_admissible clock b H0 ch delta * J_coupled w a b_idx := by
    ring
  rw [h_expand] at h_mul
  dsimp only [J_admissible_scaled] at h_can ⊢
  simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul] at h_can ⊢
  have h_lhs : (1 + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta)) * (4 * (w + 1 : ℚ))⁻¹ =
      (4 * (w + 1 : ℚ))⁻¹ + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta) * (4 * (w + 1 : ℚ))⁻¹ := by
    ring
  rw [h_lhs]
  linarith

/-- Entrywise lower bound on `J_admissible_scaled * M_coupled w` for positive row indices `0 < r.val`:
    every column entry `c` is bounded below by `(1 + (c_zeta - canonicalCZeta)) * (4 * (w + 1))⁻¹`. -/
theorem JM_admissible_scaled_entry_ge_of_pos {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta : ℚ) (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta)
    (r : Fin ((w + 1) + (w + 1))) (hr : 0 < r.val) (c : Fin (w + 1)) :
    (1 + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta)) * (4 * (w + 1 : ℚ))⁻¹ ≤
      (J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w) r c := by
  let k0 : Fin ((w + 1) + (w + 1)) := ⟨0, by omega⟩
  have h_single : J_admissible_scaled clock b H0 ch delta c_zeta r k0 * M_coupled w k0 c ≤
      (J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w) r c := by
    simp only [Matrix.mul_apply]
    exact Finset.single_le_sum
      (fun k _ => mul_nonneg
        (J_admissible_scaled_nonneg_of_ge clock b H0 ch delta c_zeta h_cz r k)
        (M_coupled_nonneg w k c))
      (Finset.mem_univ k0)
  have hJ : (1 + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta)) * (4 * (w + 1 : ℚ))⁻¹ ≤
      J_admissible_scaled clock b H0 ch delta c_zeta r k0 :=
    J_admissible_scaled_subdiag_ge_of_ge clock b H0 ch delta c_zeta h_cz r k0 hr
  have hM := M_coupled_entry_ge_one w k0 c
  have hJ_nonneg := J_admissible_scaled_nonneg_of_ge clock b H0 ch delta c_zeta h_cz r k0
  have h_prod : J_admissible_scaled clock b H0 ch delta c_zeta r k0 ≤
      J_admissible_scaled clock b H0 ch delta c_zeta r k0 * M_coupled w k0 c := by
    calc J_admissible_scaled clock b H0 ch delta c_zeta r k0
      _ = J_admissible_scaled clock b H0 ch delta c_zeta r k0 * 1 := by ring
      _ ≤ J_admissible_scaled clock b H0 ch delta c_zeta r k0 * M_coupled w k0 c :=
        mul_le_mul_of_nonneg_left hM hJ_nonneg
  linarith

/-- Vector evaluation lower bound for `(J_admissible_scaled * M_coupled w).mulVec (binomBasis (w + 1) Q)`
    at positive row indices `0 < r.val`. -/
theorem JM_admissible_scaled_mulVec_binomBasis_ge_of_pos {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta : ℚ) (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta)
    (Q : ℕ) (r : Fin ((w + 1) + (w + 1))) (hr : 0 < r.val) :
    (1 + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta)) * (4 * (w + 1 : ℚ))⁻¹ *
      (∑ c : Fin (w + 1), binomBasis (w + 1) Q c) ≤
    ((J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w).mulVec (binomBasis (w + 1) Q)) r := by
  have h_basis : ∀ c : Fin (w + 1), 0 ≤ binomBasis (w + 1) Q c := by
    intro c
    unfold binomBasis
    exact Nat.cast_nonneg _
  have h_sum : ∑ c : Fin (w + 1),
      (1 + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta)) * (4 * (w + 1 : ℚ))⁻¹ * binomBasis (w + 1) Q c ≤
      ∑ c : Fin (w + 1), (J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w) r c * binomBasis (w + 1) Q c := by
    refine Finset.sum_le_sum fun c _ => ?_
    have h_entry := JM_admissible_scaled_entry_ge_of_pos clock b H0 ch delta c_zeta h_cz r hr c
    exact mul_le_mul_of_nonneg_right h_entry (h_basis c)
  simp only [Matrix.mulVec, dotProduct]
  rw [Finset.mul_sum]
  exact h_sum

/-- Entrywise lower bound on `(J_admissible_scaled)ᵀ * M_coupled w` for row indices below top `r.val < (w + 1) + w`:
    every column entry `c` is bounded below by `(1 + (c_zeta - canonicalCZeta)) * (4 * (w + 1))⁻¹`. -/
theorem JTM_admissible_scaled_entry_ge_of_lt {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta : ℚ) (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta)
    (r : Fin ((w + 1) + (w + 1))) (hr : r.val < (w + 1) + w) (c : Fin (w + 1)) :
    (1 + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta)) * (4 * (w + 1 : ℚ))⁻¹ ≤
      ((J_admissible_scaled clock b H0 ch delta c_zeta).transpose * M_coupled w) r c := by
  have hk : (w + 1) + w < (w + 1) + (w + 1) := by omega
  let ktop : Fin ((w + 1) + (w + 1)) := ⟨(w + 1) + w, hk⟩
  have h_single : J_admissible_scaled clock b H0 ch delta c_zeta ktop r * M_coupled w ktop c ≤
      ((J_admissible_scaled clock b H0 ch delta c_zeta).transpose * M_coupled w) r c := by
    simp only [Matrix.mul_apply, Matrix.transpose_apply]
    exact Finset.single_le_sum
      (fun k _ => mul_nonneg
        (J_admissible_scaled_nonneg_of_ge clock b H0 ch delta c_zeta h_cz k r)
        (M_coupled_nonneg w k c))
      (Finset.mem_univ ktop)
  have hJ : (1 + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta)) * (4 * (w + 1 : ℚ))⁻¹ ≤
      J_admissible_scaled clock b H0 ch delta c_zeta ktop r :=
    J_admissible_scaled_subdiag_ge_of_ge clock b H0 ch delta c_zeta h_cz ktop r hr
  have hM := M_coupled_entry_ge_one w ktop c
  have hJ_nonneg := J_admissible_scaled_nonneg_of_ge clock b H0 ch delta c_zeta h_cz ktop r
  have h_prod : J_admissible_scaled clock b H0 ch delta c_zeta ktop r ≤
      J_admissible_scaled clock b H0 ch delta c_zeta ktop r * M_coupled w ktop c := by
    calc J_admissible_scaled clock b H0 ch delta c_zeta ktop r
      _ = J_admissible_scaled clock b H0 ch delta c_zeta ktop r * 1 := by ring
      _ ≤ J_admissible_scaled clock b H0 ch delta c_zeta ktop r * M_coupled w ktop c :=
        mul_le_mul_of_nonneg_left hM hJ_nonneg
  linarith

/-- Vector evaluation lower bound for `((J_admissible_scaled)ᵀ * M_coupled w).mulVec (binomBasis (w + 1) Q)`
    at row indices below top `r.val < (w + 1) + w`. -/
theorem JTM_admissible_scaled_mulVec_binomBasis_ge_of_lt {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta c_zeta : ℚ) (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta)
    (Q : ℕ) (r : Fin ((w + 1) + (w + 1))) (hr : r.val < (w + 1) + w) :
    (1 + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta)) * (4 * (w + 1 : ℚ))⁻¹ *
      (∑ c : Fin (w + 1), binomBasis (w + 1) Q c) ≤
    (((J_admissible_scaled clock b H0 ch delta c_zeta).transpose * M_coupled w).mulVec (binomBasis (w + 1) Q)) r := by
  have h_basis : ∀ c : Fin (w + 1), 0 ≤ binomBasis (w + 1) Q c := by
    intro c
    unfold binomBasis
    exact Nat.cast_nonneg _
  have h_sum : ∑ c : Fin (w + 1),
      (1 + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta)) * (4 * (w + 1 : ℚ))⁻¹ * binomBasis (w + 1) Q c ≤
      ∑ c : Fin (w + 1), ((J_admissible_scaled clock b H0 ch delta c_zeta).transpose * M_coupled w) r c * binomBasis (w + 1) Q c := by
    refine Finset.sum_le_sum fun c _ => ?_
    have h_entry := JTM_admissible_scaled_entry_ge_of_lt clock b H0 ch delta c_zeta h_cz r hr c
    exact mul_le_mul_of_nonneg_right h_entry (h_basis c)
  simp only [Matrix.mulVec, dotProduct]
  rw [Finset.mul_sum]
  exact h_sum

/-!
### 14. $H_0$-Independence of Deficit, Moment, Coupling, and Thresholds
-/

/-- Action of `e0_row` on `binomBasis (w + 1) Q` evaluates to 1. -/
theorem e0_row_succ_dot_binomBasis (w Q : ℕ) :
    dotProduct (e0_row (w + 1)) (binomBasis (w + 1) Q) = 1 := by
  simp only [dotProduct, e0_row, binomBasis]
  rw [Finset.sum_eq_single ⟨0, Nat.succ_pos w⟩]
  · simp [Nat.choose_zero_right]
  · intro j _ hj
    have hne : j.val ≠ 0 := by
      intro h
      apply hj
      ext
      exact h
    simp [hne]
  · intro h
    exact False.elim (h (Finset.mem_univ _))

/-- Linear evaluation of `h_row_lin w H0 ch` on `binomBasis (w + 1) Q` evaluates to `H0 + ch * Q`. -/
theorem dotProduct_h_row_lin_binomBasis {w : ℕ} (hw : 1 ≤ w) (H0 ch : ℚ) (Q : ℕ) :
    dotProduct (h_row_lin w H0 ch) (binomBasis (w + 1) Q) = H0 + ch * (Q : ℚ) := by
  dsimp only [h_row_lin]
  simp only [dotProduct, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  have hdistrib : (∑ x : Fin (w + 1), (H0 * e0_row (w + 1) x + ch * e1_row (w + 1) x) * binomBasis (w + 1) Q x) =
      H0 * (∑ x, e0_row (w + 1) x * binomBasis (w + 1) Q x) +
      ch * (∑ x, e1_row (w + 1) x * binomBasis (w + 1) Q x) := by
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun x _ => by ring
  rw [hdistrib]
  have he0 := e0_row_succ_dot_binomBasis w Q
  have he1 := e1_row_dot_binomBasis hw Q
  dsimp only [dotProduct] at he0 he1
  rw [he0, he1]
  ring

/-- Product `S_admissible * N` is independent of the height baseline `H0`. -/
theorem S_admissible_mul_N_mat_indep_of_H0 {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    S_admissible clock b H0 ch delta * N_mat (w + 1) =
      S_admissible clock b 0 ch delta * N_mat (w + 1) := by
  ext x r
  simp only [Matrix.mul_apply]
  have hS : ∀ c : Fin (w + 1),
      S_admissible clock b H0 ch delta x c =
        S_admissible clock b 0 ch delta x c + H0 * e0_row (w + 1) c := by
    intro c
    dsimp [S_admissible, h_row_lin]
    cases finSumFinEquiv.symm x <;> ring
  have hsum : (∑ c : Fin (w + 1), S_admissible clock b H0 ch delta x c * N_mat (w + 1) c r) =
      (∑ c : Fin (w + 1), S_admissible clock b 0 ch delta x c * N_mat (w + 1) c r) +
        H0 * (∑ c : Fin (w + 1), e0_row (w + 1) c * N_mat (w + 1) c r) := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [hS c]
    ring
  rw [hsum]
  have he0 : (∑ c : Fin (w + 1), e0_row (w + 1) c * N_mat (w + 1) c r) = 0 := by
    have he0_vec := congr_fun (e0_row_mul_N_mat (w + 1)) r
    simp only [Matrix.vecMul, dotProduct, Pi.zero_apply] at he0_vec
    exact he0_vec
  rw [he0, mul_zero, add_zero]

/-- Deficit matrix `D_admissible` is independent of the height baseline `H0`. -/
theorem D_admissible_indep_of_H0 {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    D_admissible clock b H0 ch delta = D_admissible clock b 0 ch delta := by
  dsimp only [D_admissible]
  rw [S_admissible_mul_N_mat_indep_of_H0 clock b H0 ch delta]

/-- Product `K_admissible = Dᵀ * X` is independent of `H0`. -/
theorem K_admissible_indep_of_H0 {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    K_admissible clock b H0 ch delta = K_admissible clock b 0 ch delta := by
  dsimp only [K_admissible]
  rw [D_admissible_indep_of_H0 clock b H0 ch delta]

/-- Height coefficient `dc_admissible` is independent of `H0`. -/
theorem dc_admissible_indep_of_H0 {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    dc_admissible clock b H0 ch delta = dc_admissible clock b 0 ch delta := by
  dsimp only [dc_admissible]
  rw [K_admissible_indep_of_H0 clock b H0 ch delta]

/-- Target ceiling vector `zeta_admissible` is independent of `H0`. -/
theorem zeta_admissible_indep_of_H0 {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    zeta_admissible clock b H0 ch delta = zeta_admissible clock b 0 ch delta := by
  dsimp only [zeta_admissible]
  rw [dc_admissible_indep_of_H0 clock b H0 ch delta]

/-- Scaled ceiling vector `zeta_admissible_scaled` is independent of `H0`. -/
theorem zeta_admissible_scaled_indep_of_H0 {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) :
    zeta_admissible_scaled clock b H0 ch delta c_zeta =
      zeta_admissible_scaled clock b 0 ch delta c_zeta := by
  dsimp only [zeta_admissible_scaled]
  rw [zeta_admissible_indep_of_H0 clock b H0 ch delta]

/-- Difference matrix `F_admissible = K - ℓᵀ * ψ(ζ)` is independent of `H0`. -/
theorem F_admissible_indep_of_H0 {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    F_admissible clock b H0 ch delta = F_admissible clock b 0 ch delta := by
  dsimp only [F_admissible]
  rw [K_admissible_indep_of_H0 clock b H0 ch delta]
  rw [zeta_admissible_indep_of_H0 clock b H0 ch delta]

/-- Scaled moment matrix `E_admissible_scaled` is independent of `H0`. -/
theorem E_admissible_scaled_indep_of_H0 {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) :
    E_admissible_scaled clock b H0 ch delta c_zeta =
      E_admissible_scaled clock b 0 ch delta c_zeta := by
  dsimp only [E_admissible_scaled]
  rw [F_admissible_indep_of_H0 clock b H0 ch delta]

/-- Reset interaction matrix `J_admissible_scaled` is independent of `H0`. -/
theorem J_admissible_scaled_indep_of_H0 {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) :
    J_admissible_scaled clock b H0 ch delta c_zeta =
      J_admissible_scaled clock b 0 ch delta c_zeta := by
  dsimp only [J_admissible_scaled]
  rw [F_admissible_indep_of_H0 clock b H0 ch delta]

/-- Interpolation matrix `P_admissible_scaled` is independent of `H0`. -/
theorem P_admissible_scaled_indep_of_H0 {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C =
      P_admissible_scaled clock b 0 ch delta c_zeta c_P0 a_old L_C := by
  dsimp only [P_admissible_scaled]
  rw [D_admissible_indep_of_H0 clock b H0 ch delta]
  rw [J_admissible_scaled_indep_of_H0 clock b H0 ch delta c_zeta]
  rw [zeta_admissible_scaled_indep_of_H0 clock b H0 ch delta c_zeta]

/-- Canonical ceiling scale `canonicalCZeta_admissible` is independent of `H0`. -/
theorem canonicalCZeta_admissible_indep_of_H0 {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    canonicalCZeta_admissible clock b H0 ch delta =
      canonicalCZeta_admissible clock b 0 ch delta := by
  dsimp only [canonicalCZeta_admissible]
  rw [dc_admissible_indep_of_H0 clock b H0 ch delta]
  rw [F_admissible_indep_of_H0 clock b H0 ch delta]

/-- Canonical cone dominance threshold `canonicalCP0_admissible` is independent of `H0`. -/
theorem canonicalCP0_admissible_indep_of_H0 {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    canonicalCP0_admissible clock b H0 ch delta a_old L_C =
      canonicalCP0_admissible clock b 0 ch delta a_old L_C := by
  dsimp only [canonicalCP0_admissible]
  rw [P_admissible_scaled_indep_of_H0 clock b H0 ch delta 0 0 a_old L_C]

/-!
### 15. Stage 3 Parent Bundle Trajectory & Degree-Shifted Priority Validity
-/

/-- Concatenation of valid priority words: `W1 ++ W2` is a valid priority word from `s0`
    if and only if `W1` is valid from `s0` and `W2` is valid from `wordScore M s0 W1`. -/
theorem isValidPriorityWord_append_iff {α : Type*} [Fintype α] [DecidableEq α] {m : ℕ}
    (M : Matrix α α ℚ) (s0 : α → ℚ) (rank : α → Fin m) (W1 W2 : List α) :
    IsValidPriorityWord M s0 rank (W1 ++ W2) ↔
      IsValidPriorityWord M s0 rank W1 ∧ IsValidPriorityWord M (wordScore M s0 W1) rank W2 := by
  constructor
  · intro h
    refine ⟨?_, ?_⟩
    · intro k hk j
      have hk_app : k < (W1 ++ W2).length := by
        rw [List.length_append]
        omega
      have htake : (W1 ++ W2).take k = W1.take k :=
        List.take_append_of_le_length (le_of_lt hk)
      have hget : (W1 ++ W2)[k] = W1[k] := List.getElem_append_left hk
      have h_step := h k hk_app j
      rw [htake, hget] at h_step
      exact h_step
    · intro k hk j
      have hk_app : W1.length + k < (W1 ++ W2).length := by
        rw [List.length_append]
        omega
      have hle : W1.length ≤ W1.length + k := by omega
      have htake : (W1 ++ W2).take (W1.length + k) = W1 ++ W2.take k := by
        rw [List.take_append, List.take_of_length_le hle]
        congr 2
        omega
      have hget : (W1 ++ W2)[W1.length + k] = W2[k] := by
        have := List.getElem_append_right (as := W1) (bs := W2) (i := W1.length + k) (h₂ := hk_app) hle
        simp [this]
      have h_step := h (W1.length + k) hk_app j
      rw [htake, hget, wordScore_append] at h_step
      exact h_step
  · rintro ⟨h1, h2⟩ k hk j
    rw [List.length_append] at hk
    by_cases hk1 : k < W1.length
    · have htake : (W1 ++ W2).take k = W1.take k :=
        List.take_append_of_le_length (le_of_lt hk1)
      have hget : (W1 ++ W2)[k] = W1[k] := List.getElem_append_left hk1
      rw [htake, hget]
      exact h1 k hk1 j
    · have hle : W1.length ≤ k := le_of_not_gt hk1
      have hk2 : k - W1.length < W2.length := by omega
      have htake : (W1 ++ W2).take k = W1 ++ W2.take (k - W1.length) := by
        rw [List.take_append, List.take_of_length_le hle]
      have hget : (W1 ++ W2)[k] = W2[k - W1.length] := List.getElem_append_right hle
      rw [htake, hget, wordScore_append]
      exact h2 (k - W1.length) hk2 j

/-- Priority validity of the Stage 3 parent bundle at width degree `Q = 1`
    under the degree-shifted initial score `(shiftRightCount clock.R).mulVec (binomBasis (w + 1) 1)`.
    At `Q = 1`, the degree-shifted initial score simplifies to `clock.R.mulVec (binomBasis w 0)`
    and `W_bundle_word parentWord 1` reduces to `parentWord 0`. -/
theorem isValidPriorityWord_bundle_word_shiftRightCount_one {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (parent_rank : Fin clock.m → Fin clock.m)
    (hparent_valid : ∀ σ : ℕ,
      IsValidPriorityWord clock.G (clock.R.mulVec (binomBasis w σ)) parent_rank (parentWord σ)) :
    IsValidPriorityWord clock.G ((shiftRightCount clock.R).mulVec (binomBasis (w + 1) 1))
      parent_rank (W_bundle_word parentWord 1) := by
  have hflat : W_bundle_word parentWord 1 = parentWord 0 := by
    have hsucc : W_bundle_word parentWord 1 = W_bundle_word parentWord 0 ++ parentWord 0 := by
      unfold W_bundle_word
      rw [@List.range_succ 0, List.flatMap_append]
      simp
    have hzero : W_bundle_word parentWord 0 = [] := by
      simp [W_bundle_word]
    rw [hsucc, hzero, List.nil_append]
  have hscore : (shiftRightCount clock.R).mulVec (binomBasis (w + 1) 1) =
      clock.R.mulVec (binomBasis w 0) := by
    ext i
    rw [shiftRightCount_mulVec_binomBasis_eq_sum, Finset.sum_range_one]
  rw [hflat, hscore]
  exact hparent_valid 0

/-- Word score evolution of `W_bundle_word parentWord idx` from an arbitrary initial score `s_init`:
    the cumulative score on any coordinate `i` equals `s_init i` plus the net boundary score change
    `clock.R.mulVec (binomBasis w idx) i - clock.R.mulVec (binomBasis w 0) i`. -/
theorem wordScore_W_bundle_word_general {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (s_init : Fin clock.m → ℚ) (idx : ℕ) (i : Fin clock.m) :
    wordScore clock.G s_init (W_bundle_word parentWord idx) i =
      s_init i + (clock.R.mulVec (binomBasis w idx) i - clock.R.mulVec (binomBasis w 0) i) := by
  have h_decomp : s_init = fun j => (clock.R.mulVec (binomBasis w 0) j + 0) +
      (s_init j - clock.R.mulVec (binomBasis w 0) j) := by
    ext j; ring
  rw [h_decomp, wordScore_add_bias]
  have hbase := congr_fun (wordScore_bundle_word clock parentWord hparent_count 0 idx) i
  rw [hbase]
  ring

/-- Word score evolution of `W_bundle_word parentWord idx` starting from the degree-shifted
    initial score vector `(shiftRightCount clock.R).mulVec (binomBasis (w + 1) Q)`. -/
theorem wordScore_shiftRightCount_W_bundle_word {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (Q idx : ℕ) (i : Fin clock.m) :
    wordScore clock.G ((shiftRightCount clock.R).mulVec (binomBasis (w + 1) Q))
      (W_bundle_word parentWord idx) i =
    (∑ σ ∈ Finset.range Q, (clock.R.mulVec (binomBasis w σ)) i) +
      (clock.R.mulVec (binomBasis w idx) i - clock.R.mulVec (binomBasis w 0) i) := by
  rw [wordScore_W_bundle_word_general clock parentWord hparent_count]
  rw [shiftRightCount_mulVec_binomBasis_eq_sum]

/-- Telescoping simplification of the Stage 3 bundle score at phase index `q + 1`:
    the phase-0 term `clock.R.mulVec (binomBasis w 0) i` cancels with the lower boundary
    term of the sum, leaving the active score term `clock.R.mulVec (binomBasis w idx) i`
    plus the phase-shifted sum `∑ σ ∈ Finset.range q, clock.R.mulVec (binomBasis w (σ + 1)) i`. -/
theorem wordScore_shiftRightCount_W_bundle_word_succ {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (q idx : ℕ) (i : Fin clock.m) :
    wordScore clock.G ((shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)))
      (W_bundle_word parentWord idx) i =
    (clock.R.mulVec (binomBasis w idx)) i +
      ∑ σ ∈ Finset.range q, (clock.R.mulVec (binomBasis w (σ + 1))) i := by
  rw [wordScore_shiftRightCount_W_bundle_word clock parentWord hparent_count]
  rw [Finset.sum_range_succ' (fun σ => (clock.R.mulVec (binomBasis w σ)) i) q]
  ring

/-- At the completion of Stage 3 (`idx = q + 1`), the parent score simplifies exactly to the
    sum across all phases `1 ≤ σ + 1 ≤ q + 1`. -/
theorem wordScore_shiftRightCount_W_bundle_word_succ_end {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (q : ℕ) (i : Fin clock.m) :
    wordScore clock.G ((shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)))
      (W_bundle_word parentWord (q + 1)) i =
    ∑ σ ∈ Finset.range (q + 1), (clock.R.mulVec (binomBasis w (σ + 1))) i := by
  rw [wordScore_shiftRightCount_W_bundle_word_succ clock parentWord hparent_count q (q + 1)]
  rw [Finset.sum_range_succ (fun σ => (clock.R.mulVec (binomBasis w (σ + 1))) i) q]
  ring

/-- **Stage 3 Parent Bundle Priority Validity from Subphase Validity (`isValidPriorityWord_W_bundle_word_of_subphase_valid`)**:
    If at each subphase `idx < q + 1`, the component parent word `parentWord idx` is a valid
    priority word from its exact accumulated score vector
    `fun i => clock.R.mulVec (binomBasis w idx) i + ∑ σ < q, clock.R.mulVec (binomBasis w (σ + 1)) i`,
    then the concatenated Stage 3 parent bundle `W_bundle_word parentWord (q + 1)` is a valid
    priority word under `parent_rank` from initial score `(shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1))`. -/
theorem isValidPriorityWord_W_bundle_word_of_subphase_valid {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (parent_rank : Fin clock.m → Fin clock.m)
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (q : ℕ)
    (h_subphase : ∀ (idx : ℕ) (_ : idx < q + 1),
      IsValidPriorityWord clock.G
        (fun i => (clock.R.mulVec (binomBasis w idx)) i +
          ∑ σ ∈ Finset.range q, (clock.R.mulVec (binomBasis w (σ + 1))) i)
        parent_rank (parentWord idx)) :
    IsValidPriorityWord clock.G
      ((shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)))
      parent_rank (W_bundle_word parentWord (q + 1)) := by
  have h_ind : ∀ K ≤ q + 1,
      IsValidPriorityWord clock.G
        ((shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)))
        parent_rank (W_bundle_word parentWord K) := by
    intro K
    induction K with
    | zero =>
      intro _ k hk
      simp [W_bundle_word] at hk
    | succ K ih =>
      intro hK
      have hflat : W_bundle_word parentWord (K + 1) =
          W_bundle_word parentWord K ++ parentWord K := by
        unfold W_bundle_word
        rw [@List.range_succ K, List.flatMap_append]
        simp
      rw [hflat, isValidPriorityWord_append_iff]
      have hK_le : K ≤ q + 1 := by omega
      have hK_lt : K < q + 1 := by omega
      refine ⟨ih hK_le, ?_⟩
      have hws : wordScore clock.G
          ((shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)))
          (W_bundle_word parentWord K) =
          fun i => (clock.R.mulVec (binomBasis w K)) i +
            ∑ σ ∈ Finset.range q, (clock.R.mulVec (binomBasis w (σ + 1))) i := by
        ext i
        exact wordScore_shiftRightCount_W_bundle_word_succ clock parentWord hparent_count q K i
      rw [hws]
      exact h_subphase K hK_lt
  exact h_ind (q + 1) le_rfl

/-- Seed RPS score table evaluation in binomial basis:
    for every phase index `σ : ℕ`, `R2.mulVec (binomBasis 2 σ)` equals the phase-entry
    score vector `r2Vec (σ : ℚ)`. -/
theorem R2_mulVec_binomBasis_eq_r2Vec (σ : ℕ) :
    R2.mulVec (binomBasis 2 σ) = r2Vec (σ : ℚ) := by
  ext i
  fin_cases i <;>
    simp [Matrix.mulVec, dotProduct, Fin.sum_univ_two, binomBasis, R2, r2Vec,
      Nat.choose_zero_right, Nat.choose_one_right] <;>
    ring

/-- At `σ = 0`, `R2.mulVec (binomBasis 2 0)` equals the phase-0 entry score vector `r2Vec 0`. -/
theorem R2_mulVec_binomBasis_zero :
    R2.mulVec (binomBasis 2 0) = r2Vec 0 :=
  R2_mulVec_binomBasis_eq_r2Vec 0

/-- At width degree 1, `(shiftRightCount R2).mulVec (binomBasis 3 1)` equals `r2Vec 0`. -/
theorem shiftRightCount_R2_mulVec_binomBasis_one (i : Fin 3) :
    (shiftRightCount R2).mulVec (binomBasis 3 1) i = r2Vec 0 i := by
  rw [shiftRightCount_mulVec_binomBasis_one (by omega) R2 i]
  have h := congr_fun (R2_mulVec_binomBasis_eq_r2Vec 0) i
  exact h

/-- Strict phase-entry leader dominance for the seed RPS clock:
    for every phase index `σ : ℕ`, leader action `0` strictly beats competitor actions `1` and `2`
    with gap `1/3` over action `2` and gap `3 * σ + 14 / 3` over action `1`. -/
theorem R2_mulVec_binomBasis_leader_dom (σ : ℕ) :
    (R2.mulVec (binomBasis 2 σ)) 1 < (R2.mulVec (binomBasis 2 σ)) 0 ∧
    (R2.mulVec (binomBasis 2 σ)) 2 < (R2.mulVec (binomBasis 2 σ)) 0 := by
  have h := R2_mulVec_binomBasis_eq_r2Vec σ
  have h0 : (R2.mulVec (binomBasis 2 σ)) 0 = (σ : ℚ) + 1 := by
    have := congr_fun h 0; simpa [r2Vec] using this
  have h1 : (R2.mulVec (binomBasis 2 σ)) 1 = -2 * (σ : ℚ) - 11 / 3 := by
    have := congr_fun h 1; simpa [r2Vec] using this
  have h2 : (R2.mulVec (binomBasis 2 σ)) 2 = (σ : ℚ) + 2 / 3 := by
    have := congr_fun h 2; simpa [r2Vec] using this
  constructor
  · rw [h0, h1]
    have hσ : 0 ≤ (σ : ℚ) := Nat.cast_nonneg σ
    linarith
  · rw [h0, h2]
    linarith

/-!
### 16. Independence of `delta` and Affine-Linear Decomposition in `ch`
-/

/-- Product `S_admissible * N` is independent of the gateway margin `delta`.
    The margin `delta` appears only in row `gateway` at column 0 (`delta • e0_row`),
    which is annihilated by `e0_row_mul_N_mat`. -/
theorem S_admissible_mul_N_mat_indep_of_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    S_admissible clock b H0 ch delta * N_mat (w + 1) =
      S_admissible clock b H0 ch 0 * N_mat (w + 1) := by
  ext x r
  simp only [Matrix.mul_apply]
  have hS : ∀ c : Fin (w + 1),
      S_admissible clock b H0 ch delta x c =
        S_admissible clock b H0 ch 0 x c +
          (match finSumFinEquiv.symm x with | Sum.inl _ => 0 | Sum.inr _ => delta) * e0_row (w + 1) c := by
    intro c
    dsimp [S_admissible, e0_row]
    cases finSumFinEquiv.symm x <;> split_ifs <;> ring
  have hsum : (∑ c : Fin (w + 1), S_admissible clock b H0 ch delta x c * N_mat (w + 1) c r) =
      (∑ c : Fin (w + 1), S_admissible clock b H0 ch 0 x c * N_mat (w + 1) c r) +
        (match finSumFinEquiv.symm x with | Sum.inl _ => 0 | Sum.inr _ => delta) *
          (∑ c : Fin (w + 1), e0_row (w + 1) c * N_mat (w + 1) c r) := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [hS c]
    ring
  rw [hsum]
  have he0 : (∑ c : Fin (w + 1), e0_row (w + 1) c * N_mat (w + 1) c r) = 0 := by
    have he0_vec := congr_fun (e0_row_mul_N_mat (w + 1)) r
    simp only [Matrix.vecMul, dotProduct, Pi.zero_apply] at he0_vec
    exact he0_vec
  rw [he0, mul_zero, add_zero]

/-- Deficit matrix `D_admissible` is independent of `delta`. -/
theorem D_admissible_indep_of_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    D_admissible clock b H0 ch delta = D_admissible clock b H0 ch 0 := by
  dsimp only [D_admissible]
  rw [S_admissible_mul_N_mat_indep_of_delta clock b H0 ch delta]

/-- The product `(S_admissible * N)` decomposes into its `ch = 0` baseline plus `ch • e0_row`. -/
theorem S_admissible_mul_N_mat_decomp_ch {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (ch : ℚ) (x : Fin (clock.m + 1)) (r : Fin (w + 1)) :
    (S_admissible clock b 0 ch 0 * N_mat (w + 1)) x r =
      (S_admissible clock b 0 0 0 * N_mat (w + 1)) x r + ch * e0_row (w + 1) r := by
  simp only [Matrix.mul_apply]
  have hS : ∀ c : Fin (w + 1),
      S_admissible clock b 0 ch 0 x c =
        S_admissible clock b 0 0 0 x c + ch * e1_row (w + 1) c := by
    intro c
    dsimp [S_admissible, h_row_lin]
    cases finSumFinEquiv.symm x <;> ring
  have hsum : (∑ c : Fin (w + 1), S_admissible clock b 0 ch 0 x c * N_mat (w + 1) c r) =
      (∑ c : Fin (w + 1), S_admissible clock b 0 0 0 x c * N_mat (w + 1) c r) +
        ch * (∑ c : Fin (w + 1), e1_row (w + 1) c * N_mat (w + 1) c r) := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [hS c]
    ring
  rw [hsum]
  have he1 : (∑ c : Fin (w + 1), e1_row (w + 1) c * N_mat (w + 1) c r) = e0_row (w + 1) r := by
    have he1_vec := congr_fun (e1_row_mul_N_mat hw) r
    simp only [Matrix.vecMul, dotProduct] at he1_vec
    exact he1_vec
  rw [he1]

/-- **Linear Decomposition of `D_admissible` in `ch` (`D_admissible_decomp_ch`)**:
    For any width `1 ≤ w`, `D_admissible clock b H0 ch delta` decomposes into the zero-baseline
    matrix `D_admissible clock b 0 0 0` plus `ch * e0_row (w + 1) c`.
    In particular, it is completely independent of both `H0` and `delta`. -/
theorem D_admissible_decomp_ch {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (x : Fin (clock.m + 1)) (c : Fin (w + 1)) :
    D_admissible clock b H0 ch delta x c =
      D_admissible clock b 0 0 0 x c + ch * e0_row (w + 1) c := by
  rw [D_admissible_indep_of_H0 clock b H0 ch delta]
  rw [D_admissible_indep_of_delta clock b 0 ch delta]
  dsimp only [D_admissible]
  simp only [Matrix.sub_apply]
  rw [S_admissible_mul_N_mat_decomp_ch hw clock b ch x c]
  ring

/-- Deficit matrix `D_admissible` is independent of both `H0` and `delta`. -/
theorem D_admissible_indep_of_H0_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    D_admissible clock b H0 ch delta = D_admissible clock b 0 ch 0 := by
  rw [D_admissible_indep_of_H0, D_admissible_indep_of_delta]

/-- Product `K_admissible = Dᵀ * X` is independent of `delta`. -/
theorem K_admissible_indep_of_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    K_admissible clock b H0 ch delta = K_admissible clock b H0 ch 0 := by
  dsimp only [K_admissible]
  rw [D_admissible_indep_of_delta clock b H0 ch delta]

/-- Product `K_admissible = Dᵀ * X` is independent of both `H0` and `delta`. -/
theorem K_admissible_indep_of_H0_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    K_admissible clock b H0 ch delta = K_admissible clock b 0 ch 0 := by
  rw [K_admissible_indep_of_H0, K_admissible_indep_of_delta]

/-- Height coefficient `dc_admissible` is independent of `delta`. -/
theorem dc_admissible_indep_of_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    dc_admissible clock b H0 ch delta = dc_admissible clock b H0 ch 0 := by
  dsimp only [dc_admissible]
  rw [K_admissible_indep_of_delta clock b H0 ch delta]

/-- Height coefficient `dc_admissible` is independent of both `H0` and `delta`. -/
theorem dc_admissible_indep_of_H0_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    dc_admissible clock b H0 ch delta = dc_admissible clock b 0 ch 0 := by
  rw [dc_admissible_indep_of_H0, dc_admissible_indep_of_delta]

/-- Target ceiling vector `zeta_admissible` is independent of `delta`. -/
theorem zeta_admissible_indep_of_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    zeta_admissible clock b H0 ch delta = zeta_admissible clock b H0 ch 0 := by
  dsimp only [zeta_admissible]
  rw [dc_admissible_indep_of_delta clock b H0 ch delta]

/-- Target ceiling vector `zeta_admissible` is independent of both `H0` and `delta`. -/
theorem zeta_admissible_indep_of_H0_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    zeta_admissible clock b H0 ch delta = zeta_admissible clock b 0 ch 0 := by
