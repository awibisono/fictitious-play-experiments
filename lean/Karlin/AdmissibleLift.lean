/-- Scaled ceiling vector `zeta_admissible_scaled` is independent of `delta`. -/
theorem zeta_admissible_scaled_indep_of_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) :
    zeta_admissible_scaled clock b H0 ch delta c_zeta =
      zeta_admissible_scaled clock b H0 ch 0 c_zeta := by
