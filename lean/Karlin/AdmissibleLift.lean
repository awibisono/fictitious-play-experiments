    canonicalCZeta_admissible clock b H0 ch delta =
      canonicalCZeta_admissible clock b H0 ch 0 := by
  dsimp only [canonicalCZeta_admissible]
  rw [dc_admissible_indep_of_delta clock b H0 ch delta]
  rw [F_admissible_indep_of_delta clock b H0 ch delta]

/-- Canonical ceiling scale `canonicalCZeta_admissible` is independent of both `H0` and `delta`. -/
theorem canonicalCZeta_admissible_indep_of_H0_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    canonicalCZeta_admissible clock b H0 ch delta =
      canonicalCZeta_admissible clock b 0 ch 0 := by
  rw [canonicalCZeta_admissible_indep_of_H0, canonicalCZeta_admissible_indep_of_delta]

/-- Canonical cone dominance threshold `canonicalCP0_admissible` is independent of `delta`. -/
theorem canonicalCP0_admissible_indep_of_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    canonicalCP0_admissible clock b H0 ch delta a_old L_C =
      canonicalCP0_admissible clock b H0 ch 0 a_old L_C := by
  dsimp only [canonicalCP0_admissible]
  rw [P_admissible_scaled_indep_of_delta clock b H0 ch delta 0 0 a_old L_C]

/-- Canonical cone dominance threshold `canonicalCP0_admissible` is independent of both `H0` and `delta`. -/
theorem canonicalCP0_admissible_indep_of_H0_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    canonicalCP0_admissible clock b H0 ch delta a_old L_C =
      canonicalCP0_admissible clock b 0 ch 0 a_old L_C := by
  rw [canonicalCP0_admissible_indep_of_H0, canonicalCP0_admissible_indep_of_delta]

/-- Action of `D_admissibleᵀ * X` decomposes into baseline plus `ch * e0_row r * topColSum`. -/
theorem K_admissible_decomp_ch {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (r c : Fin (w + 1)) :
    K_admissible clock b H0 ch delta r c =
      K_admissible clock b 0 0 0 r c +
        ch * e0_row (w + 1) r * (∑ x : Fin (clock.m + 1), X_gateway clock x c) := by
  simp only [K_admissible, Matrix.mul_apply, Matrix.transpose_apply]
  have hD : ∀ x : Fin (clock.m + 1),
      D_admissible clock b H0 ch delta x r =
        D_admissible clock b 0 0 0 x r + ch * e0_row (w + 1) r :=
    fun x => D_admissible_decomp_ch hw clock b H0 ch delta x r
  simp_rw [hD, add_mul]
  rw [Finset.sum_add_distrib]
  congr 1
  rw [← Finset.mul_sum]

/-- Sum of the top-degree column of the gateway count table `X_gateway clock`. -/
def topColSum_X_gateway {w : ℕ} (clock : AlgebraicClock w) : ℚ :=
  ∑ x : Fin (clock.m + 1), X_gateway clock x ⟨w, Nat.lt_succ_self w⟩

/-- The top-degree column sum of `X_gateway clock` equals the sum of the parent count table's
    top degree column `∑ j, clock.C j ⟨w - 1, _⟩`. -/
theorem topColSum_X_gateway_eq_sum_C {w : ℕ} (clock : AlgebraicClock w) (hw : 1 ≤ w) :
    topColSum_X_gateway clock = ∑ j : Fin clock.m, clock.C j ⟨w - 1, by omega⟩ := by
  dsimp only [topColSum_X_gateway]
  rw [(Equiv.sum_comp finSumFinEquiv fun x =>
    X_gateway clock x ⟨w, Nat.lt_succ_self w⟩).symm]
  rw [Fintype.sum_sum_type]
  have he0_top : e0_row (w + 1) ⟨w, Nat.lt_succ_self w⟩ = 0 := by
    simp only [e0_row]
    split_ifs with h
    · omega
    · rfl
  have hX_inr : (∑ g : Fin 1, X_gateway clock (finSumFinEquiv (Sum.inr g)) ⟨w, Nat.lt_succ_self w⟩) = 0 := by
    apply Finset.sum_eq_zero
    intro g _
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, he0_top]
  rw [hX_inr, add_zero]
  refine Finset.sum_congr rfl fun j _ => ?_
  simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, shiftRightCount]
  have hw_pos : 0 < w := by omega
  simp [hw_pos]

/-- Decomposition of the top-corner entry $K_{0, w}$ in `ch`. -/
theorem K_admissible_top_corner_decomp_ch {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    K_admissible clock b H0 ch delta ⟨0, Nat.succ_pos w⟩ ⟨w, Nat.lt_succ_self w⟩ =
      K_admissible clock b 0 0 0 ⟨0, Nat.succ_pos w⟩ ⟨w, Nat.lt_succ_self w⟩ +
        ch * topColSum_X_gateway clock := by
  have h := K_admissible_decomp_ch hw clock b H0 ch delta ⟨0, Nat.succ_pos w⟩ ⟨w, Nat.lt_succ_self w⟩
  rw [h]
  have he0 : e0_row (w + 1) ⟨0, Nat.succ_pos w⟩ = 1 := by
    simp [e0_row]
  rw [he0, mul_one]
  rfl

/-- **Affine Linearity of `dc_admissible` in `ch` (`dc_admissible_decomp_ch`)**:
    The height scaling coefficient $d_c$ is affine-linear in $c_h$ with slope
    $- \frac{\text{topColSum}}{4(w+1)}$ and is completely independent of $H_0$ and $\delta$. -/
theorem dc_admissible_decomp_ch {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    dc_admissible clock b H0 ch delta =
      dc_admissible clock b 0 0 0 - ch * (topColSum_X_gateway clock / (4 * (w + 1 : ℚ))) := by
  dsimp only [dc_admissible]
  rw [K_admissible_top_corner_decomp_ch hw clock b H0 ch delta]
  ring

/-- Slope formula for `dc_admissible`: the difference between evaluations at `ch1` and `ch2`
    is exactly proportional to `-(ch1 - ch2)`. -/
theorem dc_admissible_sub_eq_slope {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch1 ch2 delta : ℚ) :
    dc_admissible clock b H0 ch1 delta - dc_admissible clock b H0 ch2 delta =
      - (ch1 - ch2) * (topColSum_X_gateway clock / (4 * (w + 1 : ℚ))) := by
  rw [dc_admissible_decomp_ch hw clock b H0 ch1 delta]
  rw [dc_admissible_decomp_ch hw clock b H0 ch2 delta]
  ring

/-- **Exact Closed Form for the Gateway Row of `P_admissible_scaled` (`P_admissible_scaled_gateway_row_eq_Q_reset`)**:
    Because column `0` of `X_gateway clock` is the unit indicator vector on `gatewayOldAct clock.m`,
    the projection identity `Pᵀ * X = Q_reset` evaluates at column `0` to give
    `P_admissible_scaled ... (gatewayOldAct clock.m) r = Q_reset ... r 0`.
    In particular, the gateway row of `P_admissible_scaled` is completely independent of `c_P0`, `a_old`, and `L_C`! -/
theorem P_admissible_scaled_gateway_row_eq_Q_reset {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (r : Fin ((w + 1) + (w + 1))) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (gatewayOldAct clock.m) r =
      (Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta)) r 0 := by
  have hPtX := congr_fun (congr_fun
    (P_admissible_scaled_transpose_mul_X clock b H0 ch delta c_zeta c_P0 a_old L_C hLC) r) 0
  simp only [Matrix.mul_apply, Matrix.transpose_apply] at hPtX
  have hcomp := (Equiv.sum_comp finSumFinEquiv fun x : Fin (clock.m + 1) =>
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C x r * X_gateway clock x 0).symm
  rw [hcomp, Fintype.sum_sum_type] at hPtX
  have h_inl : (∑ i : Fin clock.m,
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (finSumFinEquiv (Sum.inl i)) r *
      X_gateway clock (finSumFinEquiv (Sum.inl i)) 0) = 0 := by
    apply Finset.sum_eq_zero
    intro i _
    have hX : X_gateway clock (finSumFinEquiv (Sum.inl i)) 0 = 0 := by
      simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply]
      exact shiftRightCount_zero clock.C i 0 rfl
    rw [hX, mul_zero]
  have h_inr : (∑ v : Fin 1,
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (finSumFinEquiv (Sum.inr v)) r *
      X_gateway clock (finSumFinEquiv (Sum.inr v)) 0) =
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (gatewayOldAct clock.m) r := by
    have hX : ∀ v : Fin 1, X_gateway clock (finSumFinEquiv (Sum.inr v)) 0 = 1 := by
      intro v
      simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, e0_row, Fin.val_zero, ↓reduceIte]
    simp only [Fin.sum_univ_one, hX 0, mul_one]
    rfl
  rw [h_inl, h_inr, zero_add] at hPtX
  exact hPtX

/-- Independence of `P_admissible_scaled` at the gateway row with respect to `c_P0`. -/
theorem P_admissible_scaled_gateway_row_indep_of_cP0 {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 c_P0' : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (r : Fin ((w + 1) + (w + 1))) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (gatewayOldAct clock.m) r =
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0' a_old L_C (gatewayOldAct clock.m) r := by
  rw [P_admissible_scaled_gateway_row_eq_Q_reset clock b H0 ch delta c_zeta c_P0 a_old L_C hLC r]
  rw [P_admissible_scaled_gateway_row_eq_Q_reset clock b H0 ch delta c_zeta c_P0' a_old L_C hLC r]

/-- Independence of `P_admissible_scaled` at the gateway row with respect to `a_old`. -/
theorem P_admissible_scaled_gateway_row_indep_of_a_old {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old a_old' : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (r : Fin ((w + 1) + (w + 1))) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (gatewayOldAct clock.m) r =
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old' L_C (gatewayOldAct clock.m) r := by
  rw [P_admissible_scaled_gateway_row_eq_Q_reset clock b H0 ch delta c_zeta c_P0 a_old L_C hLC r]
  rw [P_admissible_scaled_gateway_row_eq_Q_reset clock b H0 ch delta c_zeta c_P0 a_old' L_C hLC r]

/-- Independence of `P_admissible_scaled` at the gateway row with respect to `L_C`. -/
theorem P_admissible_scaled_gateway_row_indep_of_LC {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C L_C' : Matrix (Fin clock.m) (Fin w) ℚ)
    (hLC : clock.C.transpose * L_C = 1) (hLC' : clock.C.transpose * L_C' = 1)
    (r : Fin ((w + 1) + (w + 1))) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (gatewayOldAct clock.m) r =
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C' (gatewayOldAct clock.m) r := by
  rw [P_admissible_scaled_gateway_row_eq_Q_reset clock b H0 ch delta c_zeta c_P0 a_old L_C hLC r]
  rw [P_admissible_scaled_gateway_row_eq_Q_reset clock b H0 ch delta c_zeta c_P0 a_old L_C' hLC' r]

/-- At phase `q = 0`, the binomial basis vector `binomBasis (w + 1) 0` is identically `e0_row (w + 1)`. -/
theorem binomBasis_zero (w : ℕ) (c : Fin (w + 1)) :
    binomBasis (w + 1) 0 c = e0_row (w + 1) c := by
  dsimp [binomBasis, e0_row]
  rcases c with ⟨c, hc⟩
  cases c with
  | zero => simp
  | succ c' => simp

/-- Matrix-vector multiplication by `binomBasis (w + 1) 0` extracts column 0. -/
theorem mulVec_binomBasis_zero {α : Type*} {w : ℕ} (A : Matrix α (Fin (w + 1)) ℚ) (r : α) :
    (A.mulVec (binomBasis (w + 1) 0)) r = A r 0 := by
  simp only [Matrix.mulVec, dotProduct]
  have h_sum : (∑ j : Fin (w + 1), A r j * binomBasis (w + 1) 0 j) =
      (∑ j : Fin (w + 1), if j = 0 then A r j else 0) := by
    apply Finset.sum_congr rfl
    intro j _
    rw [binomBasis_zero w j]
    dsimp [e0_row]
    by_cases hj : j = 0
    · subst hj; simp
    · have hjval : j.val ≠ 0 := fun h => hj (Fin.ext h)
      simp [hj, hjval]
  rw [h_sum, Finset.sum_ite_eq' Finset.univ (0 : Fin (w + 1))]
  simp

/-- Exact coordinate formula for `Q_reset` in terms of `V_reset` and `J * M`. -/
theorem Q_reset_eq_V_reset_sub_one_zeta_add_JM {n w : Type*} [Fintype n] [Fintype w]
    (J : Matrix n n ℚ) (M : Matrix n w ℚ) (B : Matrix w w ℚ) (zeta : w → ℚ) (r : n) (c : w) :
    Q_reset J M B zeta r c =
      V_reset J M B zeta r c - zeta c + (J * M) r c := by
  have h := congr_fun (congr_fun (rotated_reset_score_identity J M B zeta) r) c
  simp only [Matrix.sub_apply, one_zeta, Matrix.of_apply] at h
  linarith

/-- Evaluating `Q_reset` at column 0 via `mulVec (binomBasis (w + 1) 0)`. -/
theorem Q_reset_col_zero_eq_mulVec {n : Type*} [Fintype n] (w : ℕ)
    (J : Matrix n n ℚ) (M : Matrix n (Fin (w + 1)) ℚ) (zeta : Fin (w + 1) → ℚ) (r : n) :
    Q_reset J M (B_mat (w + 1)) zeta r 0 =
      ((Q_reset J M (B_mat (w + 1)) zeta).mulVec (binomBasis (w + 1) 0)) r := by
  rw [mulVec_binomBasis_zero]

/-- Exact affine-linear decomposition of `P_admissible_scaled` at the gateway row in `c_zeta`. -/
theorem P_admissible_scaled_gateway_row_decomp {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (r : Fin ((w + 1) + (w + 1))) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (gatewayOldAct clock.m) r =
      (Q_reset (J_general w (E_rank2 (F_admissible clock b H0 ch delta))) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible clock b H0 ch delta)) r 0 +
      c_zeta * (Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w)) r 0 := by
  rw [P_admissible_scaled_gateway_row_eq_Q_reset clock b H0 ch delta c_zeta c_P0 a_old L_C hLC r]
  rw [Q_reset_admissible_scaled_decomp]
  simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]

/-- Action of rank-one matrix `one_zeta` on a vector equals the scalar dot product. -/
theorem one_zeta_mulVec_eq_dotProduct {n w : Type*} [Fintype w]
    (zeta : w → ℚ) (v : w → ℚ) (r : n) :
    ((one_zeta n zeta).mulVec v) r = dotProduct zeta v := by
  simp only [Matrix.mulVec, dotProduct, one_zeta, Matrix.of_apply]

/-- Refined upper bound on `V_reset` along the binomial basis transition for row indices
    below the top degree (`r.val < (w + 1) + w`), subtracting the positive moment drift. -/
theorem V_reset_admissible_scaled_mulVec_binomBasis_le_zeta_sub_of_lt {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ)
    (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta) (q : ℕ)
    (r : Fin ((w + 1) + (w + 1))) (hr : r.val < (w + 1) + w) :
    ((V_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
      (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec
        (binomBasis (w + 1) (q + 1))) r ≤
      dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) q) -
        (1 + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta)) * (4 * (w + 1 : ℚ))⁻¹ *
          (∑ c : Fin (w + 1), binomBasis (w + 1) q c) := by
  have hV := congr_fun (one_zeta_sub_J_transpose_mul_M_mulVec_binomBasis w
    (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w)
    (zeta_admissible_scaled clock b H0 ch delta c_zeta) q) r
  rw [← hV]
  simp only [Matrix.sub_mulVec, Pi.sub_apply]
  rw [one_zeta_mulVec_eq_dotProduct]
  have h_jtm := JTM_admissible_scaled_mulVec_binomBasis_ge_of_lt clock b H0 ch delta c_zeta h_cz q r hr
  linarith

/-- Exact upper bound on the reset action score at Stage 3 end for positive reset actions `0 < r.val`,
    incorporating the gateway row value `Q_reset ... r 0` and subtracting the positive moment drift. -/
theorem stage3_end_inr_admissible_le_zeta_sub_of_pos {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta)
    (Q : ℕ) (r : Fin ((w + 1) + (w + 1))) (hr : 0 < r.val) :
    dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) Q) -
      ((J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w).mulVec (binomBasis (w + 1) Q)) r +
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (gatewayOldAct clock.m) r ≤
    dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) Q) -
      (1 + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta)) * (4 * (w + 1 : ℚ))⁻¹ *
        (∑ c : Fin (w + 1), binomBasis (w + 1) Q c) +
      (Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta)) r 0 := by
  have hP := P_admissible_scaled_gateway_row_eq_Q_reset clock b H0 ch delta c_zeta c_P0 a_old L_C hLC r
  rw [hP]
  have hjm := JM_admissible_scaled_mulVec_binomBasis_ge_of_pos clock b H0 ch delta c_zeta h_cz Q r hr
  linarith

/-- Row 0 of `J_admissible_scaled` is identically zero by lower-triangularity. -/
theorem J_admissible_scaled_row_zero_eq_zero {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (b_idx : Fin ((w + 1) + (w + 1))) :
    J_admissible_scaled clock b H0 ch delta c_zeta ⟨0, by omega⟩ b_idx = 0 := by
  apply J_admissible_scaled_lower clock b H0 ch delta c_zeta ⟨0, by omega⟩ b_idx
  exact Nat.zero_le b_idx.val

/-- Row 0 of `J_admissible_scaled * M_coupled w` is identically zero. -/
theorem JM_admissible_scaled_row_zero_eq_zero {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (c : Fin (w + 1)) :
    (J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w) ⟨0, by omega⟩ c = 0 := by
  simp only [Matrix.mul_apply]
  apply Finset.sum_eq_zero
  intro k _
  rw [J_admissible_scaled_row_zero_eq_zero clock b H0 ch delta c_zeta k, zero_mul]

/-- Evaluating `(J_admissible_scaled * M_coupled w).mulVec` on any vector gives zero at row 0. -/
theorem JM_admissible_scaled_mulVec_row_zero_eq_zero {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (v : Fin (w + 1) → ℚ) :
    ((J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w).mulVec v) ⟨0, by omega⟩ = 0 := by
  simp only [Matrix.mulVec, dotProduct]
  apply Finset.sum_eq_zero
  intro c _
  rw [JM_admissible_scaled_row_zero_eq_zero clock b H0 ch delta c_zeta c, zero_mul]

/-- For the maximum reset action `r_top = ⟨(w + 1) + w, by omega⟩`, the column of `J_admissible_scaled`
    is identically zero, because every index `a` satisfies `a.val ≤ r_top.val`. -/
theorem J_admissible_scaled_col_top_eq_zero {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (a : Fin ((w + 1) + (w + 1))) :
    J_admissible_scaled clock b H0 ch delta c_zeta a ⟨(w + 1) + w, by omega⟩ = 0 := by
  apply J_admissible_scaled_lower
  change a.val ≤ (w + 1) + w
  have ha := a.isLt
  omega

/-- Row `r_top = ⟨(w + 1) + w, by omega⟩` of `(J_admissible_scaled)ᵀ * M_coupled w` is identically zero. -/
theorem JTM_admissible_scaled_row_top_eq_zero {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (c : Fin (w + 1)) :
    ((J_admissible_scaled clock b H0 ch delta c_zeta).transpose * M_coupled w) ⟨(w + 1) + w, by omega⟩ c = 0 := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  apply Finset.sum_eq_zero
  intro a _
  rw [J_admissible_scaled_col_top_eq_zero clock b H0 ch delta c_zeta a, zero_mul]

/-- Action of `((J_admissible_scaled)ᵀ * M_coupled w).mulVec` on any vector `v` at row `r_top` is identically zero. -/
theorem JTM_admissible_scaled_mulVec_row_top_eq_zero {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (v : Fin (w + 1) → ℚ) :
    (((J_admissible_scaled clock b H0 ch delta c_zeta).transpose * M_coupled w).mulVec v) ⟨(w + 1) + w, by omega⟩ = 0 := by
  simp only [Matrix.mulVec, dotProduct]
  apply Finset.sum_eq_zero
  intro c _
  rw [JTM_admissible_scaled_row_top_eq_zero clock b H0 ch delta c_zeta c, zero_mul]

/-- Exact evaluation of `V_reset` on `binomBasis (w + 1) (q + 1)` at the top reset action
    `r_top = ⟨(w + 1) + w, by omega⟩`: the subtractive interaction term vanishes identically,
    yielding exact equality to `dotProduct (zeta_admissible_scaled ...) (binomBasis (w + 1) q)`. -/
theorem V_reset_admissible_scaled_mulVec_binomBasis_row_top_eq {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (q : ℕ) :
    ((V_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
      (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) (q + 1))) ⟨(w + 1) + w, by omega⟩ =
    dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) q) := by
  have h := congr_fun (one_zeta_sub_J_transpose_mul_M_mulVec_binomBasis w
    (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w)
    (zeta_admissible_scaled clock b H0 ch delta c_zeta) q) ⟨(w + 1) + w, by omega⟩
  rw [← h]
  simp only [Matrix.sub_mulVec, Pi.sub_apply]
  rw [JTM_admissible_scaled_mulVec_row_top_eq_zero clock b H0 ch delta c_zeta]
  simp only [sub_zero, Matrix.mulVec, dotProduct, one_zeta, Matrix.of_apply]

/-- Exact coordinate formula for `Q_reset` at row 0:
    because row 0 of `J * M` vanishes, `Q_reset ... 0 c` equals `V_reset ... 0 c - zeta c`. -/
theorem Q_reset_admissible_scaled_row_zero_eq {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (c : Fin (w + 1)) :
    Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
      (zeta_admissible_scaled clock b H0 ch delta c_zeta) ⟨0, by omega⟩ c =
    V_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
      (zeta_admissible_scaled clock b H0 ch delta c_zeta) ⟨0, by omega⟩ c -
      zeta_admissible_scaled clock b H0 ch delta c_zeta c := by
  rw [Q_reset_eq_V_reset_sub_one_zeta_add_JM]
  rw [JM_admissible_scaled_row_zero_eq_zero clock b H0 ch delta c_zeta c]
  ring

/-- Specialization of `Q_reset_admissible_scaled_row_zero_eq` to column 0. -/
theorem Q_reset_admissible_scaled_row_zero_col_zero_eq {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) :
    Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
      (zeta_admissible_scaled clock b H0 ch delta c_zeta) ⟨0, by omega⟩ 0 =
    V_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
      (zeta_admissible_scaled clock b H0 ch delta c_zeta) ⟨0, by omega⟩ 0 -
      zeta_admissible_scaled clock b H0 ch delta c_zeta 0 :=
  Q_reset_admissible_scaled_row_zero_eq clock b H0 ch delta c_zeta 0

/-- At row 0 (`r = ⟨0, by omega⟩`), the Stage 3 end reset score equals `zeta · p_Q + Q_reset ... 0 0`
    with exact equality (no `J * M` loss). -/
theorem stage3_end_inr_admissible_row_zero_eq {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) (Q : ℕ) :
    dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) Q) -
      ((J_admissible_scaled clock b H0 ch delta c_zeta * M_coupled w).mulVec (binomBasis (w + 1) Q)) ⟨0, by omega⟩ +
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C (gatewayOldAct clock.m) ⟨0, by omega⟩ =
    dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) Q) +
      (Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta)) ⟨0, by omega⟩ 0 := by
  rw [JM_admissible_scaled_mulVec_row_zero_eq_zero]
  rw [P_admissible_scaled_gateway_row_eq_Q_reset clock b H0 ch delta c_zeta c_P0 a_old L_C hLC ⟨0, by omega⟩]
  ring

/-- Row 0 of `J_coupled w` is identically zero by lower-triangularity. -/
theorem J_coupled_row_zero_eq_zero (w : ℕ) (b_idx : Fin ((w + 1) + (w + 1))) :
    J_coupled w ⟨0, by omega⟩ b_idx = 0 := by
  apply J_coupled_lower w ⟨0, by omega⟩ b_idx
  exact Nat.zero_le b_idx.val

/-- Row 0 of `J_coupled w * M_coupled w` is identically zero. -/
theorem JM_coupled_row_zero_eq_zero (w : ℕ) (c : Fin (w + 1)) :
    (J_coupled w * M_coupled w) ⟨0, by omega⟩ c = 0 := by
  simp only [Matrix.mul_apply]
  apply Finset.sum_eq_zero
  intro k _
  rw [J_coupled_row_zero_eq_zero w k, zero_mul]

/-- Row 0 of `J_general w E` is identically zero by lower-triangularity. -/
theorem J_general_row_zero_eq_zero (w : ℕ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (b_idx : Fin ((w + 1) + (w + 1))) :
    J_general w E ⟨0, by omega⟩ b_idx = 0 := by
  apply J_general_lower w E ⟨0, by omega⟩ b_idx
  exact Nat.zero_le b_idx.val

/-- Row 0 of `J_general w E * M_coupled w` is identically zero. -/
theorem JM_general_row_zero_eq_zero (w : ℕ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (c : Fin (w + 1)) :
    (J_general w E * M_coupled w) ⟨0, by omega⟩ c = 0 := by
  simp only [Matrix.mul_apply]
  apply Finset.sum_eq_zero
  intro k _
  rw [J_general_row_zero_eq_zero w E k, zero_mul]

/-- Explicit value of `B_mat` at entry `(1, 0)` is `-1`. -/
theorem B_mat_one_zero {w : ℕ} (hw : 1 ≤ w) :
    B_mat (w + 1) ⟨1, by omega⟩ 0 = -1 := by
  simp only [B_mat, Matrix.of_apply, Fin.val_zero]
  have hle : (0 : ℕ) ≤ 1 := by omega
  simp [hle]

/-- Explicit value of `B_mat` at entry `(0, 0)` is `1`. -/
theorem B_mat_zero_zero (w : ℕ) :
    B_mat (w + 1) ⟨0, by omega⟩ 0 = 1 := by
  rw [B_mat_zero_row (Nat.succ_pos w) 0]
  simp [e0_row]

/-- Exact column 0 evaluation of `(one_zeta (zeta_admissible) * B_mat) 0 0 - zeta_admissible 0`:
    since `zeta_admissible = dc • e1_row`, only entry `(1, 0)` of `B_mat` survives in the sum,
    yielding exact equality to `- dc_admissible`. -/
theorem zeta_admissible_mul_B_mat_col_zero {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    (one_zeta (Fin ((w + 1) + (w + 1))) (zeta_admissible clock b H0 ch delta) * B_mat (w + 1)) ⟨0, by omega⟩ 0 -
      zeta_admissible clock b H0 ch delta 0 =
    - dc_admissible clock b H0 ch delta := by
  have h1_lt : 1 < w + 1 := by omega
  let j1 : Fin (w + 1) := ⟨1, h1_lt⟩
  have hzeta : ∀ j, zeta_admissible clock b H0 ch delta j =
      dc_admissible clock b H0 ch delta * e1_row (w + 1) j := by
    intro j
    simp only [zeta_admissible, Pi.smul_apply, smul_eq_mul]
  have hmul : (one_zeta (Fin ((w + 1) + (w + 1))) (zeta_admissible clock b H0 ch delta) * B_mat (w + 1)) ⟨0, by omega⟩ 0 =
      dc_admissible clock b H0 ch delta * B_mat (w + 1) j1 0 := by
    simp only [Matrix.mul_apply, one_zeta, Matrix.of_apply, hzeta]
    rw [Finset.sum_eq_single j1]
    · simp [j1, e1_row]
    · intro i _ hi
      have hne : i.val ≠ 1 := by
        intro h
        apply hi
        ext
        exact h
      simp [e1_row, hne]
    · intro h
      exact False.elim (h (Finset.mem_univ _))
  have hzeta0 : zeta_admissible clock b H0 ch delta 0 = 0 := by
    rw [hzeta 0]
    simp [e1_row]
  rw [hmul, hzeta0, sub_zero]
  have hB : B_mat (w + 1) j1 0 = -1 := B_mat_one_zero hw
  rw [hB]
  ring

/-- Equivalence mapping of top late reset action `Sum.inr ⟨w, ...⟩` to `⟨(w + 1) + w, ...⟩`. -/
theorem finSumFinEquiv_inr_top_eq (w : ℕ) :
    (finSumFinEquiv (Sum.inr ⟨w, Nat.lt_succ_self w⟩) : Fin ((w + 1) + (w + 1))) =
      ⟨(w + 1) + w, by omega⟩ := by
  ext
  rw [finSumFinEquiv_apply_right, Fin.val_natAdd]

/-- For `j : Fin (w + 1)` with `j.val < w`, its late reset index in `Fin ((w + 1) + (w + 1))`
    is strictly below the top degree `(w + 1) + w`. -/
theorem finSumFinEquiv_inr_val_lt_of_lt (w : ℕ) (j : Fin (w + 1)) (hj : j.val < w) :
    (finSumFinEquiv (Sum.inr j) : Fin ((w + 1) + (w + 1))).val < (w + 1) + w := by
  rw [finSumFinEquiv_apply_right, Fin.val_natAdd]
  omega

/-- Late reset action intermediate Stage 3 score bound for `j.val < w`:
    subtracts the positive moment drift from the Stage 3 start ceiling. -/
theorem wordScore_stage3_take_late_admissible_lt_top_le_zeta_prev_sub_drift {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (parentWord : ℕ → List (Fin clock.m))
    (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta)
    (j : Fin (w + 1)) (hj : j.val < w)
    (hP_late : ∀ u : Fin (clock.m + 1),
      0 ≤ P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C u (finSumFinEquiv (Sum.inr j)))
    (q k : ℕ) :
    let s0 := (liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
      (J_admissible_scaled clock b H0 ch delta c_zeta)
      (S_admissible clock b H0 ch delta)
      (X_gateway clock) (M_coupled w)
      (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q)
    let W_stage3 := (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)
    let r := finSumFinEquiv (Sum.inr j)
    wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      (wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
        s0 (W_early_word clock.m w q ++ W_late_word clock.m w q))
      (W_stage3.take k) (Sum.inr r) ≤
    dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) q) -
      (1 + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta)) * (4 * (w + 1 : ℚ))⁻¹ *
        (∑ c : Fin (w + 1), binomBasis (w + 1) q c) := by
  intro s0 W_stage3 r
  have hbase := wordScore_stage3_take_late_inr_le_start clock parentWord
    (AdjoinLeaderEndpointG clock.G b clock.v)
    (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
    (J_admissible_scaled clock b H0 ch delta c_zeta)
    (S_admissible clock b H0 ch delta)
    (zeta_admissible_scaled clock b H0 ch delta c_zeta)
    j hP_late q k
  dsimp only at hbase
  have hr : r.val < (w + 1) + w := finSumFinEquiv_inr_val_lt_of_lt w j hj
  have hV := V_reset_admissible_scaled_mulVec_binomBasis_le_zeta_sub_of_lt clock b H0 ch delta c_zeta h_cz q r hr
  linarith

/-- Early reset action intermediate Stage 3 score bound for positive reset actions `0 < j.val`:
    subtracts the positive moment drift from the Stage 3 end ceiling and adds the gateway row value. -/
theorem wordScore_stage3_take_early_admissible_pos_le_zeta_sub_drift_add_Q_reset {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (h_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta)
    (j : Fin (w + 1)) (hj : 0 < j.val)
    (hP_early : ∀ u : Fin (clock.m + 1),
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C u (finSumFinEquiv (Sum.inl j)) ≤ 0)
    (q k : ℕ) :
    let s0 := (liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
      (J_admissible_scaled clock b H0 ch delta c_zeta)
      (S_admissible clock b H0 ch delta)
      (X_gateway clock) (M_coupled w)
      (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q)
    let W_stage3 := (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)
    let r := finSumFinEquiv (Sum.inl j)
    wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      (wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
        s0 (W_early_word clock.m w q ++ W_late_word clock.m w q))
      (W_stage3.take k) (Sum.inr r) ≤
    dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) (q + 1)) -
      (1 + (c_zeta - canonicalCZeta_admissible clock b H0 ch delta)) * (4 * (w + 1 : ℚ))⁻¹ *
        (∑ c : Fin (w + 1), binomBasis (w + 1) (q + 1) c) +
      (Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta)) r 0 := by
  intro s0 W_stage3 r
  have hbase := wordScore_stage3_take_early_inr_le_end clock parentWord hparent_count
    (AdjoinLeaderEndpointG clock.G b clock.v)
    (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
    (J_admissible_scaled clock b H0 ch delta c_zeta)
    (S_admissible clock b H0 ch delta)
    (zeta_admissible_scaled clock b H0 ch delta c_zeta)
    (P_admissible_scaled_transpose_mul_X clock b H0 ch delta c_zeta c_P0 a_old L_C hLC)
    j hP_early q k
  dsimp only at hbase
  have hr : 0 < r.val := by
    change 0 < (finSumFinEquiv (Sum.inl j) : Fin ((w + 1) + (w + 1))).val
    rw [finSumFinEquiv_apply_left, Fin.val_castAdd]
    exact hj
  have hP := P_admissible_scaled_gateway_row_eq_Q_reset clock b H0 ch delta c_zeta c_P0 a_old L_C hLC r
  have hjm := JM_admissible_scaled_mulVec_binomBasis_ge_of_pos clock b H0 ch delta c_zeta h_cz (q + 1) r hr
  linarith

/-- The kernel-projected cone reference matrix `P0_cone_proj`. -/
def P0_cone_proj {w : ℕ} (clock : AlgebraicClock w) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  P0_cone a_old w - L_X_gateway L_C * ((P0_cone a_old w).transpose * X_gateway clock).transpose

/-- The projected cone weight vector `a_old_proj`. -/
def a_old_proj {w : ℕ} (clock : AlgebraicClock w) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (x : Fin (clock.m + 1)) : ℚ :=
  a_old x - (L_X_gateway L_C).mulVec (Matrix.vecMul a_old (X_gateway clock)) x

/-- Early reset projection of `P0_cone_proj` yields `- a_old_proj x` uniformly for all early actions `j`. -/
theorem P0_cone_proj_inl {w : ℕ} (clock : AlgebraicClock w) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    P0_cone_proj clock a_old L_C x (finSumFinEquiv (Sum.inl j)) = - a_old_proj clock a_old L_C x := by
  dsimp only [P0_cone_proj, a_old_proj]
  rw [Matrix.sub_apply]
  have hP0 : P0_cone a_old w x (finSumFinEquiv (Sum.inl j)) = - a_old x := by
    simp only [P0_cone, Matrix.of_apply, Equiv.symm_apply_apply]
  rw [hP0]
  have hY : ∀ c : Fin (w + 1), ((P0_cone a_old w).transpose * X_gateway clock) (finSumFinEquiv (Sum.inl j)) c =
      - (Matrix.vecMul a_old (X_gateway clock)) c := by
    intro c
    exact P0_cone_transpose_mul_X_inl clock a_old (Matrix.vecMul a_old (X_gateway clock)) rfl j c
  have h_sum : (L_X_gateway L_C * ((P0_cone a_old w).transpose * X_gateway clock).transpose) x (finSumFinEquiv (Sum.inl j)) =
      - (L_X_gateway L_C).mulVec (Matrix.vecMul a_old (X_gateway clock)) x := by
    rw [Matrix.mul_apply]
    simp only [Matrix.transpose_apply, Matrix.mulVec, dotProduct]
    rw [← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro c _
    rw [hY c]
    ring
  rw [h_sum]
  ring

/-- Late reset projection of `P0_cone_proj` yields `+ a_old_proj x` uniformly for all late actions `j`. -/
theorem P0_cone_proj_inr {w : ℕ} (clock : AlgebraicClock w) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    P0_cone_proj clock a_old L_C x (finSumFinEquiv (Sum.inr j)) = a_old_proj clock a_old L_C x := by
  dsimp only [P0_cone_proj, a_old_proj]
  rw [Matrix.sub_apply]
  have hP0 : P0_cone a_old w x (finSumFinEquiv (Sum.inr j)) = a_old x := by
    simp only [P0_cone, Matrix.of_apply, Equiv.symm_apply_apply]
  rw [hP0]
  have hY : ∀ c : Fin (w + 1), ((P0_cone a_old w).transpose * X_gateway clock) (finSumFinEquiv (Sum.inr j)) c =
      (Matrix.vecMul a_old (X_gateway clock)) c := by
    intro c
    exact P0_cone_transpose_mul_X_inr clock a_old (Matrix.vecMul a_old (X_gateway clock)) rfl j c
  have h_sum : (L_X_gateway L_C * ((P0_cone a_old w).transpose * X_gateway clock).transpose) x (finSumFinEquiv (Sum.inr j)) =
      (L_X_gateway L_C).mulVec (Matrix.vecMul a_old (X_gateway clock)) x := by
    rw [Matrix.mul_apply]
    simp only [Matrix.transpose_apply, Matrix.mulVec, dotProduct]
    apply Finset.sum_congr rfl
    intro c _
    rw [hY c]
  rw [h_sum]

/-- The projected cone weight vector vanishes identically on the gateway action `gatewayOldAct clock.m`. -/
theorem a_old_proj_gateway_eq_zero {w : ℕ} (clock : AlgebraicClock w) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    a_old_proj clock a_old L_C (gatewayOldAct clock.m) = 0 := by
  have hL : L_X_gateway L_C (gatewayOldAct clock.m) = e0_row (w + 1) := by
    ext c
    simp only [L_X_gateway, L_X_coupled, Matrix.of_apply, gatewayOldAct, Equiv.symm_apply_apply]
  have hvm : (L_X_gateway L_C).mulVec (Matrix.vecMul a_old (X_gateway clock)) (gatewayOldAct clock.m) =
      (Matrix.vecMul a_old (X_gateway clock)) 0 := by
    simp only [Matrix.mulVec, dotProduct, hL]
    rw [Finset.sum_eq_single (0 : Fin (w + 1))]
    · simp [e0_row]
    · intro c _ hc
      have hne : c.val ≠ 0 := fun h => hc (Fin.ext h)
      simp [e0_row, hne]
    · intro h
      exact False.elim (h (Finset.mem_univ _))
  have hX0 : (Matrix.vecMul a_old (X_gateway clock)) 0 = a_old (gatewayOldAct clock.m) := by
    simp only [Matrix.vecMul, dotProduct]
    rw [(Equiv.sum_comp finSumFinEquiv fun x => a_old x * X_gateway clock x 0).symm]
    rw [Fintype.sum_sum_type]
    have h_inl : (∑ i : Fin clock.m, a_old (finSumFinEquiv (Sum.inl i)) *
        X_gateway clock (finSumFinEquiv (Sum.inl i)) 0) = 0 := by
      apply Finset.sum_eq_zero
      intro i _
      have hX : X_gateway clock (finSumFinEquiv (Sum.inl i)) 0 = 0 := by
        simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply]
        exact shiftRightCount_zero clock.C i 0 rfl
      rw [hX, mul_zero]
    have h_inr : (∑ v : Fin 1, a_old (finSumFinEquiv (Sum.inr v)) *
        X_gateway clock (finSumFinEquiv (Sum.inr v)) 0) = a_old (gatewayOldAct clock.m) := by
      have hX : ∀ v : Fin 1, X_gateway clock (finSumFinEquiv (Sum.inr v)) 0 = 1 := by
        intro v
        simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, e0_row, Fin.val_zero, ↓reduceIte]
      simp only [Fin.sum_univ_one, hX 0, mul_one]
      rfl
    rw [h_inl, h_inr, zero_add]
  dsimp [a_old_proj]
  rw [hvm, hX0, sub_self]

/-- Exact coordinate formula for `P_admissible_scaled` on early reset columns `Sum.inl j`:
    the `c_P0` dependence is strictly given by `- c_P0 * a_old_proj x`. -/
theorem P_admissible_scaled_inl_eq_proj {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C x (finSumFinEquiv (Sum.inl j)) =
      P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x (finSumFinEquiv (Sum.inl j)) +
        c_zeta * (L_X_gateway L_C * (Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w)).transpose) x (finSumFinEquiv (Sum.inl j)) -
        c_P0 * a_old_proj clock a_old L_C x := by
  have hdecomp := congr_fun (congr_fun (P_admissible_scaled_linear_decomp clock b H0 ch delta c_zeta c_P0 a_old L_C) x) (finSumFinEquiv (Sum.inl j))
  simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul] at hdecomp
  rw [hdecomp]
  have hP0 : (P0_cone a_old w - L_X_gateway L_C * ((P0_cone a_old w).transpose * X_gateway clock).transpose) x (finSumFinEquiv (Sum.inl j)) =
      - a_old_proj clock a_old L_C x := by
    exact P0_cone_proj_inl clock a_old L_C x j
  rw [hP0]
  ring

/-- Exact coordinate formula for `P_admissible_scaled` on late reset columns `Sum.inr j`:
    the `c_P0` dependence is strictly given by `+ c_P0 * a_old_proj x`. -/
theorem P_admissible_scaled_inr_eq_proj {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C x (finSumFinEquiv (Sum.inr j)) =
      P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x (finSumFinEquiv (Sum.inr j)) +
        c_zeta * (L_X_gateway L_C * (Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w)).transpose) x (finSumFinEquiv (Sum.inr j)) +
        c_P0 * a_old_proj clock a_old L_C x := by
  have hdecomp := congr_fun (congr_fun (P_admissible_scaled_linear_decomp clock b H0 ch delta c_zeta c_P0 a_old L_C) x) (finSumFinEquiv (Sum.inr j))
  simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul] at hdecomp
  rw [hdecomp]
  have hP0 : (P0_cone a_old w - L_X_gateway L_C * ((P0_cone a_old w).transpose * X_gateway clock).transpose) x (finSumFinEquiv (Sum.inr j)) =
      a_old_proj clock a_old L_C x := by
    exact P0_cone_proj_inr clock a_old L_C x j
  rw [hP0]

/-- Exact coordinate formula for `Q_reset` at row 0 for general block-lower triangular `J_general w E`:
    because row 0 of `J_general w E * M_coupled w` vanishes, the `+ J * M` term is zero. -/
theorem Q_reset_general_row_zero_eq (w : ℕ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ) (c : Fin (w + 1)) :
    Q_reset (J_general w E) (M_coupled w) (B_mat (w + 1)) zeta ⟨0, by omega⟩ c =
      (one_zeta (Fin ((w + 1) + (w + 1))) zeta * B_mat (w + 1)) ⟨0, by omega⟩ c -
        zeta c -
        ((J_general w E).transpose * M_coupled w * B_mat (w + 1)) ⟨0, by omega⟩ c := by
  have h := Q_reset_eq_V_reset_sub_one_zeta_add_JM (J_general w E) (M_coupled w) (B_mat (w + 1)) zeta ⟨0, by omega⟩ c
  rw [h]
  unfold V_reset
  simp only [Matrix.sub_apply]
  rw [JM_general_row_zero_eq_zero w E c]
  ring

/-- Exact coordinate formula for `Q_reset` at row 0 for `J_coupled w`:
    because row 0 of `J_coupled w * M_coupled w` vanishes, the `+ J * M` term is zero. -/
theorem Q_reset_coupled_row_zero_eq (w : ℕ) (c : Fin (w + 1)) :
    Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) ⟨0, by omega⟩ c =
      (one_zeta (Fin ((w + 1) + (w + 1))) (zeta_coupled w) * B_mat (w + 1)) ⟨0, by omega⟩ c -
        zeta_coupled w c -
        ((J_coupled w).transpose * M_coupled w * B_mat (w + 1)) ⟨0, by omega⟩ c := by
  have h := Q_reset_eq_V_reset_sub_one_zeta_add_JM (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) ⟨0, by omega⟩ c
  rw [h]
  unfold V_reset
  simp only [Matrix.sub_apply]
  rw [JM_coupled_row_zero_eq_zero w c]
  ring

/-- Exact evaluation of `Q_reset` for the unscaled admissible lift at row 0, column 0:
    the first term `(one_zeta * B_mat) 0 0 - zeta 0` reduces to `- dc_admissible`. -/
theorem Q_reset_admissible_row_zero_col_zero_eq {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    Q_reset (J_general w (E_rank2 (F_admissible clock b H0 ch delta))) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible clock b H0 ch delta) ⟨0, by omega⟩ 0 =
      - dc_admissible clock b H0 ch delta -
        ((J_general w (E_rank2 (F_admissible clock b H0 ch delta))).transpose * M_coupled w * B_mat (w + 1)) ⟨0, by omega⟩ 0 := by
  rw [Q_reset_general_row_zero_eq w (E_rank2 (F_admissible clock b H0 ch delta)) (zeta_admissible clock b H0 ch delta) 0]
  rw [zeta_admissible_mul_B_mat_col_zero hw clock b H0 ch delta]

/-- Exact decomposition of `Q_reset` for the scaled admissible lift at row 0, column 0:
    expresses entry `(0, 0)` as `- dc_admissible - (J_generalᵀ M B) 0 0 + c_zeta * Q_reset (coupled) 0 0`. -/
theorem Q_reset_admissible_scaled_row_zero_col_zero_decomp {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) :
    Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta) ⟨0, by omega⟩ 0 =
      - dc_admissible clock b H0 ch delta -
        ((J_general w (E_rank2 (F_admissible clock b H0 ch delta))).transpose * M_coupled w * B_mat (w + 1)) ⟨0, by omega⟩ 0 +
        c_zeta * Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) ⟨0, by omega⟩ 0 := by
  have h := congr_fun (congr_fun (Q_reset_admissible_scaled_decomp clock b H0 ch delta c_zeta) ⟨0, by omega⟩) 0
  simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul] at h
  rw [h, Q_reset_admissible_row_zero_col_zero_eq hw clock b H0 ch delta]

/-- **Annihilation of `Q_reset (J_coupled)` against `(M_coupled)ᵀ` (`M_coupled_transpose_mul_Q_reset_coupled`)**:
    Follows directly from `coupled_moment_equation` and `M_transpose_mul_Q_reset`. -/
theorem M_coupled_transpose_mul_Q_reset_coupled {w : ℕ} (clock : AlgebraicClock w) :
    (M_coupled w).transpose * Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) = 0 := by
  have hmom := coupled_moment_equation clock
  rw [D_deficit_coupled_eq_zero, Matrix.transpose_zero, Matrix.zero_mul, zero_sub] at hmom
  rw [M_transpose_mul_Q_reset]
  have h_add : (ell_row (M_coupled w)).transpose * psi_row (zeta_coupled w) (B_mat (w + 1)) +
      ((M_coupled w).transpose * J_coupled w * M_coupled w -
        ((M_coupled w).transpose * J_coupled w * M_coupled w).transpose * B_mat (w + 1)) =
      (ell_row (M_coupled w)).transpose * psi_row (zeta_coupled w) (B_mat (w + 1)) +
        (- ((ell_row (M_coupled w)).transpose * psi_row (zeta_coupled w) (B_mat (w + 1)))) := by
    rw [hmom]
  rw [h_add, add_neg_cancel]

/-- **Odd Anti-Symmetry of `Q_reset (J_coupled)` under Early/Late Reset Exchange (`Q_reset_coupled_odd`)**:
    Since `M_coupled = [W; W]` with invertible `W`, `Mᵀ Q = Wᵀ (Q_inl + Q_inr) = 0`
    implies `Q_inl + Q_inr = 0`. -/
theorem Q_reset_coupled_odd {w : ℕ} (clock : AlgebraicClock w)
    (j : Fin (w + 1)) (c : Fin (w + 1)) :
    Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl j)) c +
      Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr j)) c = 0 := by
  have hM := M_coupled_transpose_mul_Q_reset_coupled clock
  have hW : (W_coupled w).transpose *
      (Matrix.of fun j c =>
        Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl j)) c +
        Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr j)) c) = 0 := by
    ext i k
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Matrix.zero_apply]
    have hMi := congr_fun (congr_fun hM i) k
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.zero_apply] at hMi
    rw [(Equiv.sum_comp finSumFinEquiv fun r => (M_coupled w) r i *
      Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) r k).symm] at hMi
    rw [Fintype.sum_sum_type] at hMi
    have h_split : (∑ j_idx : Fin (w + 1), (M_coupled w) (finSumFinEquiv (Sum.inl j_idx)) i *
        Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl j_idx)) k) +
      (∑ j_idx : Fin (w + 1), (M_coupled w) (finSumFinEquiv (Sum.inr j_idx)) i *
        Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr j_idx)) k) =
      ∑ j_idx : Fin (w + 1), W_coupled w j_idx i *
        (Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl j_idx)) k +
         Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr j_idx)) k) := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun j_idx _ => ?_
      have hMinl : M_coupled w (finSumFinEquiv (Sum.inl j_idx)) i = W_coupled w j_idx i := by
        simp only [M_coupled, Matrix.of_apply, Equiv.symm_apply_apply]
      have hMinr : M_coupled w (finSumFinEquiv (Sum.inr j_idx)) i = W_coupled w j_idx i := by
        simp only [M_coupled, Matrix.of_apply, Equiv.symm_apply_apply]
      rw [hMinl, hMinr, mul_add]
    rw [← h_split, hMi]
  have h_inv : (Matrix.of fun j c =>
      Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl j)) c +
      Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr j)) c) = 0 := by
    calc (Matrix.of fun j c =>
        Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl j)) c +
        Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr j)) c)
      _ = 1 * (Matrix.of fun j c =>
        Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl j)) c +
        Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr j)) c) := by rw [Matrix.one_mul]
      _ = ((W_coupled_inv w).transpose * (W_coupled w).transpose) * (Matrix.of fun j c =>
        Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl j)) c +
        Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr j)) c) := by
        have h1 : (W_coupled_inv w).transpose * (W_coupled w).transpose = (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) := by
          rw [← Matrix.transpose_mul, W_coupled_mul_inv, Matrix.transpose_one]
        rw [h1]
      _ = (W_coupled_inv w).transpose * ((W_coupled w).transpose * (Matrix.of fun j c =>
        Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl j)) c +
        Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr j)) c)) := by rw [Matrix.mul_assoc]
      _ = (W_coupled_inv w).transpose * 0 := by rw [hW]
      _ = 0 := Matrix.mul_zero _
  have h_entry := congr_fun (congr_fun h_inv j) c
  simp only [Matrix.of_apply, Matrix.zero_apply] at h_entry
  exact h_entry

/-- **Late Reset Row Negation Identity (`Q_reset_coupled_inr_eq_neg_inl`)**:
    In `Q_reset (J_coupled)`, each late reset row is the exact negation of the early reset row. -/
theorem Q_reset_coupled_inr_eq_neg_inl {w : ℕ} (clock : AlgebraicClock w)
    (j : Fin (w + 1)) (c : Fin (w + 1)) :
    Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr j)) c =
      - Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl j)) c := by
  have h := Q_reset_coupled_odd clock j c
  linarith

/-- Exact coordinate formula for `Q_reset (J_coupled)` at row 0, column 0:
    equals `V_reset (J_coupled) 0 0 - 1`. -/
theorem Q_reset_coupled_row_zero_col_zero_eq (w : ℕ) :
    Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) ⟨0, by omega⟩ 0 =
      V_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) ⟨0, by omega⟩ 0 - 1 := by
  have h := Q_reset_eq_V_reset_sub_one_zeta_add_JM (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) ⟨0, by omega⟩ 0
  rw [h]
  have hJM := JM_coupled_row_zero_eq_zero w 0
  have hzeta : zeta_coupled w 0 = 1 := rfl
  rw [hJM, hzeta]
  ring

/-- Late reset action 0 value of `Q_reset (J_coupled)` at column 0 equals `1 - V_reset (J_coupled) 0 0`. -/
theorem Q_reset_coupled_inr_zero_col_zero_eq {w : ℕ} (clock : AlgebraicClock w) :
    Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr (0 : Fin (w + 1)))) 0 =
      1 - V_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) ⟨0, by omega⟩ 0 := by
  have h_odd := Q_reset_coupled_inr_eq_neg_inl clock 0 0
  have h0 : (finSumFinEquiv (Sum.inl (0 : Fin (w + 1))) : Fin ((w + 1) + (w + 1))) = ⟨0, by omega⟩ := by
    ext
    simp only [finSumFinEquiv_apply_left, Fin.val_castAdd, Fin.val_zero]
  rw [h0] at h_odd
  rw [h_odd, Q_reset_coupled_row_zero_col_zero_eq]
  ring

/-- **Gateway Deficit Duality for Column 0 (`K_admissible_col_zero_eq`)**:
    Column 0 of `K_admissible` coincides with the gateway row `gatewayOldAct clock.m` of `D_admissible`. -/
theorem K_admissible_col_zero_eq {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (H0 ch delta : ℚ) (r : Fin (w + 1)) :
    K_admissible clock b H0 ch delta r 0 =
      D_admissible clock b H0 ch delta (gatewayOldAct clock.m) r := by
  dsimp only [K_admissible]
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  rw [(Equiv.sum_comp finSumFinEquiv fun x =>
    D_admissible clock b H0 ch delta x r * X_gateway clock x 0).symm]
  rw [Fintype.sum_sum_type]
  have h_inl : (∑ i : Fin clock.m,
      D_admissible clock b H0 ch delta (finSumFinEquiv (Sum.inl i)) r *
      X_gateway clock (finSumFinEquiv (Sum.inl i)) 0) = 0 := by
    apply Finset.sum_eq_zero
    intro i _
    have hX0 : X_gateway clock (finSumFinEquiv (Sum.inl i)) 0 = 0 := by
      simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply]
      exact shiftRightCount_zero clock.C i 0 rfl
    rw [hX0, mul_zero]
  have h_inr : (∑ g : Fin 1,
      D_admissible clock b H0 ch delta (finSumFinEquiv (Sum.inr g)) r *
      X_gateway clock (finSumFinEquiv (Sum.inr g)) 0) =
      D_admissible clock b H0 ch delta (gatewayOldAct clock.m) r := by
    have hX : ∀ v : Fin 1, X_gateway clock (finSumFinEquiv (Sum.inr v)) 0 = 1 := by
      intro v
      simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, e0_row, Fin.val_zero, ↓reduceIte]
    simp only [Fin.sum_univ_one, hX 0, mul_one]
    rfl
  rw [h_inl, h_inr, zero_add]

/-- **Action of `(M_coupled)ᵀ * Q_reset (J_admissible_scaled)` at Column 0 (`M_coupled_transpose_mul_Q_reset_admissible_scaled_col_zero`)**:
    Evaluates identically to the gateway deficit row `D_admissible (gatewayOldAct clock.m) r`,
    completely independent of `c_zeta`. -/
theorem M_coupled_transpose_mul_Q_reset_admissible_scaled_col_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (r : Fin (w + 1)) :
    ((M_coupled w).transpose *
      Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta)) r 0 =
      D_admissible clock b H0 ch delta (gatewayOldAct clock.m) r := by
  have hmom := congr_fun (congr_fun (admissible_scaled_moment_compat hw clock b H0 ch delta c_zeta) r) 0
  rw [← hmom]
  exact K_admissible_col_zero_eq clock b H0 ch delta r

/-- **Decomposition of the Deviation from Anti-Symmetry (`Q_reset_admissible_scaled_sum_inl_inr`)**:
    The sum of early and late reset rows for `Q_reset (J_admissible_scaled)` is governed
    entirely by `(W_coupled_inv)ᵀ * K_admissible` and is completely independent of `c_zeta`. -/
theorem Q_reset_admissible_scaled_sum_inl_inr {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (j : Fin (w + 1)) (c : Fin (w + 1)) :
    Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inl j)) c +
      Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inr j)) c =
    ((W_coupled_inv w).transpose * K_admissible clock b H0 ch delta) j c := by
  have hmom := admissible_scaled_moment_compat hw clock b H0 ch delta c_zeta
  have hW : (W_coupled w).transpose *
      (Matrix.of fun j c =>
        Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inl j)) c +
        Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inr j)) c) =
      K_admissible clock b H0 ch delta := by
    ext i k
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply]
    have h_entry := congr_fun (congr_fun hmom.symm i) k
    simp only [Matrix.mul_apply, Matrix.transpose_apply] at h_entry
    rw [(Equiv.sum_comp finSumFinEquiv fun r => (M_coupled w) r i *
      Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta) r k).symm] at h_entry
    rw [Fintype.sum_sum_type] at h_entry
    have h_split : (∑ j_idx : Fin (w + 1), (M_coupled w) (finSumFinEquiv (Sum.inl j_idx)) i *
        Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inl j_idx)) k) +
      (∑ j_idx : Fin (w + 1), (M_coupled w) (finSumFinEquiv (Sum.inr j_idx)) i *
        Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inr j_idx)) k) =
      ∑ j_idx : Fin (w + 1), W_coupled w j_idx i *
        (Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inl j_idx)) k +
         Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inr j_idx)) k) := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun j_idx _ => ?_
      have hMinl : M_coupled w (finSumFinEquiv (Sum.inl j_idx)) i = W_coupled w j_idx i := by
        simp only [M_coupled, Matrix.of_apply, Equiv.symm_apply_apply]
      have hMinr : M_coupled w (finSumFinEquiv (Sum.inr j_idx)) i = W_coupled w j_idx i := by
        simp only [M_coupled, Matrix.of_apply, Equiv.symm_apply_apply]
      rw [hMinl, hMinr, mul_add]
    rw [← h_split, h_entry]
    dsimp only [K_admissible]
    simp only [Matrix.mul_apply, Matrix.transpose_apply]
  have h_inv : (Matrix.of fun j c =>
      Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inl j)) c +
      Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inr j)) c) =
      (W_coupled_inv w).transpose * K_admissible clock b H0 ch delta := by
    calc (Matrix.of fun j c =>
        Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inl j)) c +
        Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inr j)) c)
      _ = 1 * (Matrix.of fun j c =>
        Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inl j)) c +
        Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inr j)) c) := by rw [Matrix.one_mul]
      _ = ((W_coupled_inv w).transpose * (W_coupled w).transpose) * (Matrix.of fun j c =>
        Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inl j)) c +
        Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inr j)) c) := by
        have h1 : (W_coupled_inv w).transpose * (W_coupled w).transpose = (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) := by
          rw [← Matrix.transpose_mul, W_coupled_mul_inv, Matrix.transpose_one]
        rw [h1]
      _ = (W_coupled_inv w).transpose * ((W_coupled w).transpose * (Matrix.of fun j c =>
        Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inl j)) c +
        Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inr j)) c)) := by rw [Matrix.mul_assoc]
      _ = (W_coupled_inv w).transpose * K_admissible clock b H0 ch delta := by rw [hW]
  have h_entry := congr_fun (congr_fun h_inv j) c
  simp only [Matrix.of_apply] at h_entry
  exact h_entry

/-- **Independence of Column 0 of `K_admissible` from `H0` and `delta` (`K_admissible_col_zero_indep_of_H0_delta`)**. -/
theorem K_admissible_col_zero_indep_of_H0_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (r : Fin (w + 1)) :
    K_admissible clock b H0 ch delta r 0 = K_admissible clock b 0 ch 0 r 0 := by
  have h := congr_fun (congr_fun (K_admissible_indep_of_H0_delta clock b H0 ch delta) r) 0
  exact h

/-- **Global Parameter Decoupling of Odd-Symmetry Deviation (`Q_reset_admissible_scaled_sum_inl_inr_indep_of_H0_delta_c_zeta`)**:
    The sum of early and late reset rows for `Q_reset (J_admissible_scaled)` is completely
    independent of `H0`, `delta`, and `c_zeta`. -/
theorem Q_reset_admissible_scaled_sum_inl_inr_indep_of_H0_delta_c_zeta {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (j : Fin (w + 1)) (c : Fin (w + 1)) :
    Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inl j)) c +
      Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inr j)) c =
    Q_reset (J_admissible_scaled clock b 0 ch 0 0) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b 0 ch 0 0) (finSumFinEquiv (Sum.inl j)) c +
      Q_reset (J_admissible_scaled clock b 0 ch 0 0) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b 0 ch 0 0) (finSumFinEquiv (Sum.inr j)) c := by
  rw [Q_reset_admissible_scaled_sum_inl_inr hw clock b H0 ch delta c_zeta j c]
  rw [Q_reset_admissible_scaled_sum_inl_inr hw clock b 0 ch 0 0 j c]
  rw [K_admissible_indep_of_H0_delta clock b H0 ch delta]

/-- **Explicit Closed-Form Formula for `D_admissible` on Gateway Row (`D_admissible_gateway_eq`)**:
    At `r = 0` it is `clock.R b ⟨0, hw⟩ + ch - 1`, at `r = 1` it is `-1`, and for `r ≥ 2` it vanishes. -/
theorem D_admissible_gateway_eq {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (r : Fin (w + 1)) :
    D_admissible clock b H0 ch delta (gatewayOldAct clock.m) r =
      (if r.val = 0 then clock.R b ⟨0, hw⟩ + ch - 1 else if r.val = 1 then -1 else 0) := by
  rw [D_admissible_decomp_ch hw clock b H0 ch delta (gatewayOldAct clock.m) r]
  dsimp only [D_admissible]
  simp only [Matrix.sub_apply]
  have hGO : (AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock) (gatewayOldAct clock.m) r =
      (clock.G * shiftRightCount clock.C) b r + e1_row (w + 1) r :=
    GO_mul_X_inr_apply clock b r
  rw [hGO]
  have hS : ∀ c : Fin (w + 1),
      S_admissible clock b 0 0 0 (gatewayOldAct clock.m) c =
        shiftRightCount clock.R b c - e1_row (w + 1) c := by
    intro c
    dsimp [S_admissible, h_row_lin, gatewayOldAct]
    simp
  have hSN : (S_admissible clock b 0 0 0 * N_mat (w + 1)) (gatewayOldAct clock.m) r =
      (shiftRightCount clock.R * N_mat (w + 1)) b r - e0_row (w + 1) r := by
    simp only [Matrix.mul_apply]
    have hsum : (∑ c : Fin (w + 1), S_admissible clock b 0 0 0 (gatewayOldAct clock.m) c * N_mat (w + 1) c r) =
        (∑ c : Fin (w + 1), (shiftRightCount clock.R b c - e1_row (w + 1) c) * N_mat (w + 1) c r) := by
      refine Finset.sum_congr rfl fun c _ => by rw [hS c]
    rw [hsum]
    simp_rw [sub_mul]
    rw [Finset.sum_sub_distrib]
    have he1 : (∑ c : Fin (w + 1), e1_row (w + 1) c * N_mat (w + 1) c r) = e0_row (w + 1) r := by
      have he1_vec := congr_fun (e1_row_mul_N_mat hw) r
      simp only [Matrix.vecMul, dotProduct] at he1_vec
      exact he1_vec
    rw [he1]
  rw [hSN, shiftRightCount_R_mul_N_mat hw clock b r]
  by_cases hr0 : r.val = 0
  · have he0 : e0_row (w + 1) r = 1 := by simp [e0_row, hr0]
    have he1 : e1_row (w + 1) r = 0 := by simp [e1_row, hr0]
    have hGC0 : (clock.G * shiftRightCount clock.C) b r = 0 :=
      mul_shiftRightCount_zero clock.G clock.C b r hr0
    simp only [hr0, ↓reduceIte, he0, he1, hGC0, add_zero, sub_zero]
    ring
  · have he0 : e0_row (w + 1) r = 0 := by simp [e0_row, hr0]
    simp only [hr0, ↓reduceIte, he0, mul_zero, add_zero, sub_zero]
    by_cases hr1 : r.val = 1
    · have he1 : e1_row (w + 1) r = 1 := by simp [e1_row, hr1]
      simp only [hr1, ↓reduceIte, he1]
      ring
    · have he1 : e1_row (w + 1) r = 0 := by
        simp only [e1_row, hr1, ↓reduceIte]
      simp only [hr1, ↓reduceIte, he1, add_zero]
      ring

/-- Gateway row column 0 value of `D_admissible`. -/
theorem D_admissible_gateway_col_zero {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    D_admissible clock b H0 ch delta (gatewayOldAct clock.m) 0 =
      clock.R b ⟨0, hw⟩ + ch - 1 := by
  have h := D_admissible_gateway_eq hw clock b H0 ch delta 0
  simp only [Fin.val_zero, ↓reduceIte] at h
  exact h

/-- Value of `K_admissible` at `(0, 0)`. -/
theorem K_admissible_zero_zero {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    K_admissible clock b H0 ch delta 0 0 =
      clock.R b ⟨0, hw⟩ + ch - 1 := by
  rw [K_admissible_col_zero_eq, D_admissible_gateway_col_zero hw]

/-- `Q_reset` for the scaled admissible lift is independent of both `H0` and `delta`. -/
theorem Q_reset_admissible_scaled_indep_of_H0_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) :
    Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta) =
      Q_reset (J_admissible_scaled clock b 0 ch 0 c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b 0 ch 0 c_zeta) := by
  rw [J_admissible_scaled_indep_of_H0, J_admissible_scaled_indep_of_delta,
    zeta_admissible_scaled_indep_of_H0, zeta_admissible_scaled_indep_of_delta]

/-- **Closed Form Coordinate Expansion for `Q_reset` (`Q_reset_entry_decomp`)**:
    For any `J, M, B, zeta`, entry `(r, c)` decomposes into four explicit terms:
    `Q r c = (one_zeta zeta * B) r c - zeta c + (J * M) r c - (Jᵀ * M * B) r c`. -/
theorem Q_reset_entry_decomp {n w : Type*} [Fintype n] [Fintype w]
    (J : Matrix n n ℚ) (M : Matrix n w ℚ) (B : Matrix w w ℚ) (zeta : w → ℚ) (r : n) (c : w) :
    Q_reset J M B zeta r c =
      (one_zeta n zeta * B) r c - zeta c + (J * M) r c - (J.transpose * M * B) r c := by
  have h := Q_reset_eq_V_reset_sub_one_zeta_add_JM J M B zeta r c
  unfold V_reset at h
  simp only [Matrix.sub_apply] at h ⊢
  linarith

/-- **General Column 0 Evaluation Formula for `Q_reset` (`Q_reset_col_zero_formula`)**:
    At column 0 with `B = B_mat (w + 1)`, the entrance ceiling term is `∑ j, zeta j * B_mat (w + 1) j 0 - zeta 0`. -/
theorem Q_reset_col_zero_formula {n : Type*} [Fintype n] {w : ℕ}
    (J : Matrix n n ℚ) (M : Matrix n (Fin (w + 1)) ℚ) (zeta : Fin (w + 1) → ℚ) (r : n) :
    Q_reset J M (B_mat (w + 1)) zeta r 0 =
      (∑ j : Fin (w + 1), zeta j * B_mat (w + 1) j 0) - zeta 0 +
        (J * M) r 0 - ((J.transpose * M * B_mat (w + 1)) r 0) := by
  have h := Q_reset_entry_decomp J M (B_mat (w + 1)) zeta r 0
  simp only [Matrix.mul_apply, one_zeta, Matrix.of_apply] at h
  exact h

/-- **Early Reset Action Formula for `Q_reset (J_coupled)` (`Q_reset_coupled_inl_eq`)**. -/
theorem Q_reset_coupled_inl_eq {w : ℕ} (_clock : AlgebraicClock w)
    (j : Fin (w + 1)) (c : Fin (w + 1)) :
    Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl j)) c =
      (V_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w)) (finSumFinEquiv (Sum.inl j)) c - 1 +
        (J_coupled w * M_coupled w) (finSumFinEquiv (Sum.inl j)) c := by
  have h := Q_reset_eq_V_reset_sub_one_zeta_add_JM (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w)
    (finSumFinEquiv (Sum.inl j)) c
  have hz : zeta_coupled w c = 1 := rfl
  rw [hz] at h
  exact h

/-- **Late Reset Action Formula for `Q_reset (J_coupled)` (`Q_reset_coupled_inr_eq`)**. -/
theorem Q_reset_coupled_inr_eq {w : ℕ} (clock : AlgebraicClock w)
    (j : Fin (w + 1)) (c : Fin (w + 1)) :
    Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr j)) c =
      - Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl j)) c :=
  Q_reset_coupled_inr_eq_neg_inl clock j c

/-- **Vanishing of `E_last w` on Sub-Terminal Rows (`E_last_zero_of_lt`)**:
    For all rows `i.val < w`, `E_last w i j = 0`. -/
theorem E_last_zero_of_lt (w : ℕ) (i j : Fin (w + 1)) (hi : i.val < w) :
    E_last w i j = 0 := by
  dsimp only [E_last]
  simp only [Matrix.of_apply]
  have hne : i ≠ ⟨w, Nat.lt_succ_self w⟩ := by
    intro h
    have hval : i.val = w := congr_arg Fin.val h
    omega
  rw [if_neg hne]

/-- **Explicit Entry Formula for `W_coupled_inv w` on Sub-Terminal Rows (`W_coupled_inv_apply_of_lt`)**:
    For rows `i.val < w`, the `E_last` component vanishes identically, leaving
    `(if i = j then 1 else 0) - (w + 1 : ℚ)⁻¹`. -/
theorem W_coupled_inv_apply_of_lt (w : ℕ) (i j : Fin (w + 1)) (hi : i.val < w) :
    W_coupled_inv w i j = (if i = j then 1 else 0) - (w + 1 : ℚ)⁻¹ := by
  dsimp only [W_coupled_inv]
  simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul,
    Matrix.one_apply, J_ones, Matrix.of_apply, mul_one]
  rw [E_last_zero_of_lt w i j hi, mul_zero, zero_add]

/-- **Closed-Form Action of `(W_coupled_inv)ᵀ` on Column 0 of `K_admissible` (`W_coupled_inv_transpose_mul_K_admissible_col_zero`)**:
    Evaluates to `D_admissible (gatewayOldAct clock.m) j - (w + 1 : ℚ)⁻¹ * (clock.R b 0 + ch - 2)`
    by isolating the two non-vanishing deficit contributions at `r = 0` and `r = 1`. -/
theorem W_coupled_inv_transpose_mul_K_admissible_col_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (j : Fin (w + 1)) :
    ((W_coupled_inv w).transpose * K_admissible clock b H0 ch delta) j 0 =
      D_admissible clock b H0 ch delta (gatewayOldAct clock.m) j -
        (w + 1 : ℚ)⁻¹ * (clock.R b ⟨0, by omega⟩ + ch - 2) := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  let r0 : Fin (w + 1) := ⟨0, by omega⟩
  let r1 : Fin (w + 1) := ⟨1, by omega⟩
  have hr0_lt : r0.val < w := by change 0 < w; omega
  have hr1_lt : r1.val < w := by change 1 < w; omega
  have hterm : ∀ r : Fin (w + 1),
      W_coupled_inv w r j * K_admissible clock b H0 ch delta r 0 =
        (if r = r0 then W_coupled_inv w r0 j * (clock.R b ⟨0, by omega⟩ + ch - 1) else 0) +
        (if r = r1 then W_coupled_inv w r1 j * (-1) else 0) := by
    intro r
    rw [K_admissible_col_zero_eq, D_admissible_gateway_eq (by omega)]
    by_cases hr0 : r = r0
    · subst hr0
      have hr1 : r0 ≠ r1 := by
        intro h
        have hval : r0.val = r1.val := congr_arg Fin.val h
        change 0 = 1 at hval
        omega
      have hval0 : r0.val = 0 := rfl
      simp only [↓reduceIte, hr1, hval0, add_zero]
    · by_cases hr1 : r = r1
      · subst hr1
        have hval1 : r1.val = 1 := rfl
        simp only [hr0, ↓reduceIte, hval1, one_ne_zero, zero_add]
      · have hval0 : ¬ (r.val = 0) := fun h => hr0 (Fin.ext h)
        have hval1 : ¬ (r.val = 1) := fun h => hr1 (Fin.ext h)
        simp only [hr0, hr1, ↓reduceIte, hval0, hval1, mul_zero, add_zero]
  have h_sum : (∑ r : Fin (w + 1), W_coupled_inv w r j * K_admissible clock b H0 ch delta r 0) =
      (∑ r : Fin (w + 1), (if r = r0 then W_coupled_inv w r0 j * (clock.R b ⟨0, by omega⟩ + ch - 1) else 0)) +
      (∑ r : Fin (w + 1), (if r = r1 then W_coupled_inv w r1 j * (-1) else 0)) := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun r _ => hterm r
  rw [h_sum, Finset.sum_ite_eq' Finset.univ r0, Finset.sum_ite_eq' Finset.univ r1]
  simp only [Finset.mem_univ, ↓reduceIte]
  rw [W_coupled_inv_apply_of_lt w r0 j hr0_lt]
  rw [W_coupled_inv_apply_of_lt w r1 j hr1_lt]
  have hj_r0 : (r0 = j) ↔ (j.val = 0) := by
    constructor
    · intro h; subst h; rfl
    · intro h; ext; exact h.symm
  have hj_r1 : (r1 = j) ↔ (j.val = 1) := by
    constructor
    · intro h; subst h; rfl
    · intro h; ext; exact h.symm
  rw [D_admissible_gateway_eq (by omega) clock b H0 ch delta j]
  by_cases hj0 : j.val = 0
  · have hr0 : r0 = j := hj_r0.mpr hj0
    have hr1 : ¬ (r1 = j) := by intro h; have := hj_r1.mp h; omega
    simp only [hj0, ↓reduceIte, hr0, hr1]
    ring
  · have hr0 : ¬ (r0 = j) := by intro h; have := hj_r0.mp h; contradiction
    by_cases hj1 : j.val = 1
    · have hr1 : r1 = j := hj_r1.mpr hj1
      rw [if_neg hj0, if_pos hj1, if_neg hr0, if_pos hr1]
      ring
    · have hr1 : ¬ (r1 = j) := by intro h; have := hj_r1.mp h; contradiction
      rw [if_neg hj0, if_neg hj1, if_neg hr0, if_neg hr1]
      ring

/-- **Closed-Form Representation of Late Reset Row at Column 0 (`Q_reset_admissible_scaled_inr_col_zero_eq`)**:
    Evaluates entry `(finSumFinEquiv (Sum.inr j), 0)` as the negation of the early reset entry
    plus the gateway deficit row and an explicit width-(w+1) harmonic correction. -/
theorem Q_reset_admissible_scaled_inr_col_zero_eq {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (j : Fin (w + 1)) :
    Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inr j)) 0 =
      - Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta) (finSumFinEquiv (Sum.inl j)) 0 +
        D_admissible clock b H0 ch delta (gatewayOldAct clock.m) j -
        (w + 1 : ℚ)⁻¹ * (clock.R b ⟨0, by omega⟩ + ch - 2) := by
  have hsum := Q_reset_admissible_scaled_sum_inl_inr hw clock b H0 ch delta c_zeta j 0
  have hK := W_coupled_inv_transpose_mul_K_admissible_col_zero hw clock b H0 ch delta j
  linarith

/-- **Every Entry of `W_coupled w` Is at Most `3` (`W_coupled_entry_le_three`)**:
    For all `i, j : Fin (w + 1)`, `W_coupled w i j ∈ {1, 2, 3}`, hence `W_coupled w i j ≤ 3`. -/
theorem W_coupled_entry_le_three (w : ℕ) (i j : Fin (w + 1)) :
    W_coupled w i j ≤ 3 := by
  simp only [W_coupled, V0_coupled, J_ones, E_last, Matrix.add_apply, Matrix.sub_apply,
    Matrix.smul_apply, Matrix.one_apply, Matrix.of_apply, smul_eq_mul, mul_one]
  split_ifs <;> norm_num

/-- **Action of `J_coupled w * M_coupled w` on Early Reset Rows (`JM_coupled_inl_apply`)**:
    Because the early/late cross block of `J_coupled` vanishes, the product on `Sum.inl i`
    evaluates to `(4(w + 1))⁻¹ * (L_strict (w + 1) * W_coupled w) i c`. -/
theorem JM_coupled_inl_apply (w : ℕ) (i c : Fin (w + 1)) :
    (J_coupled w * M_coupled w) (finSumFinEquiv (Sum.inl i)) c =
      (4 * (w + 1 : ℚ))⁻¹ * (L_strict (w + 1) * W_coupled w) i c := by
  simp only [Matrix.mul_apply]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      J_coupled w (finSumFinEquiv (Sum.inl i)) r * M_coupled w r c).symm
  rw [hcomp, Fintype.sum_sum_type]
  have h_inr : (∑ j : Fin (w + 1),
      J_coupled w (finSumFinEquiv (Sum.inl i)) (finSumFinEquiv (Sum.inr j)) *
        M_coupled w (finSumFinEquiv (Sum.inr j)) c) = 0 := by
    apply Finset.sum_eq_zero
    intro j _
    simp only [J_coupled, Matrix.of_apply, Equiv.symm_apply_apply, zero_mul]
  rw [h_inr, add_zero]
  simp only [J_coupled, M_coupled, Matrix.of_apply, Equiv.symm_apply_apply,
    Matrix.smul_apply, smul_eq_mul]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => by ring

/-- **Action of `(J_coupled w)ᵀ * M_coupled w` on Early Reset Rows (`JTM_coupled_inl_apply`)**:
    Evaluates to `2 - (4(w + 1))⁻¹ * ((L_strict (w + 1))ᵀ * W_coupled w) i c`. -/
theorem JTM_coupled_inl_apply (w : ℕ) (i c : Fin (w + 1)) :
    ((J_coupled w).transpose * M_coupled w) (finSumFinEquiv (Sum.inl i)) c =
      2 - (4 * (w + 1 : ℚ))⁻¹ * ((L_strict (w + 1)).transpose * W_coupled w) i c := by
  let η : ℚ := (4 * (w + 1 : ℚ))⁻¹
  let κ : ℚ := (w + 1 : ℚ)⁻¹
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      J_coupled w r (finSumFinEquiv (Sum.inl i)) * M_coupled w r c).symm
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  rw [hcomp, Fintype.sum_sum_type]
  have h_terms :
      (∑ j : Fin (w + 1), J_coupled w (finSumFinEquiv (Sum.inl j)) (finSumFinEquiv (Sum.inl i)) *
          M_coupled w (finSumFinEquiv (Sum.inl j)) c) +
      (∑ j : Fin (w + 1), J_coupled w (finSumFinEquiv (Sum.inr j)) (finSumFinEquiv (Sum.inl i)) *
          M_coupled w (finSumFinEquiv (Sum.inr j)) c) =
      ∑ j : Fin (w + 1),
        (κ • J_ones (w + 1) - η • L_strict (w + 1)) j i * W_coupled w j c := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [J_coupled, M_coupled, Matrix.of_apply, Equiv.symm_apply_apply,
      Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul]
    ring
  rw [h_terms]
  have h_split : (∑ j : Fin (w + 1),
      (κ • J_ones (w + 1) - η • L_strict (w + 1)) j i * W_coupled w j c) =
      (κ * ∑ j : Fin (w + 1), W_coupled w j c) -
        η * ∑ j : Fin (w + 1), L_strict (w + 1) j i * W_coupled w j c := by
    have h_congr : (∑ j : Fin (w + 1),
        (κ • J_ones (w + 1) - η • L_strict (w + 1)) j i * W_coupled w j c) =
        ∑ j : Fin (w + 1), (κ * W_coupled w j c - η * (L_strict (w + 1) j i * W_coupled w j c)) := by
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul, J_ones, Matrix.of_apply]
      ring
    rw [h_congr, Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
  rw [h_split]
  have hW := congr_fun (congr_fun (one_row_mul_W_coupled w) ()) c
  simp only [one_row, Matrix.mul_apply, Matrix.of_apply, Matrix.smul_apply, smul_eq_mul, one_mul, mul_one] at hW
  rw [hW]
  have hw : (w : ℚ) + 1 ≠ 0 := by positivity
  have hκ : κ * (2 * (w + 1 : ℚ)) = 2 := by
    dsimp only [κ]
    field_simp [hw]
  rw [hκ]

/-- **Closed Form Coordinate Evaluation of `Q_reset (J_coupled)` on Early Reset Rows (`Q_reset_coupled_inl_apply`)**:
    Decomposes into `-1 - ∑ k, B_mat k c + (4(w+1))⁻¹ * ((L_strict * W) + (L_strictᵀ * W * B)) i c`. -/
theorem Q_reset_coupled_inl_apply (w : ℕ) (i c : Fin (w + 1)) :
    Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl i)) c =
      -1 - (∑ k : Fin (w + 1), B_mat (w + 1) k c) +
        (4 * (w + 1 : ℚ))⁻¹ *
          ((L_strict (w + 1) * W_coupled w) i c +
           ((L_strict (w + 1)).transpose * W_coupled w * B_mat (w + 1)) i c) := by
  have hdecomp := Q_reset_entry_decomp (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w)
    (finSumFinEquiv (Sum.inl i)) c
  rw [hdecomp]
  have hz : zeta_coupled w c = 1 := rfl
  have hone : (one_zeta (Fin ((w + 1) + (w + 1))) (zeta_coupled w) * B_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) c =
      ∑ k : Fin (w + 1), B_mat (w + 1) k c := by
    simp only [Matrix.mul_apply, one_zeta, Matrix.of_apply]
    refine Finset.sum_congr rfl fun k _ => ?_
    have hzk : zeta_coupled w k = 1 := rfl
    rw [hzk, one_mul]
  have hJM := JM_coupled_inl_apply w i c
  have hJTMB : ((J_coupled w).transpose * M_coupled w * B_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) c =
      2 * (∑ k : Fin (w + 1), B_mat (w + 1) k c) -
        (4 * (w + 1 : ℚ))⁻¹ * ((L_strict (w + 1)).transpose * W_coupled w * B_mat (w + 1)) i c := by
    rw [Matrix.mul_apply]
    have hterm : (∑ k : Fin (w + 1),
        ((J_coupled w).transpose * M_coupled w) (finSumFinEquiv (Sum.inl i)) k * B_mat (w + 1) k c) =
        ∑ k : Fin (w + 1),
          (2 * B_mat (w + 1) k c -
            (4 * (w + 1 : ℚ))⁻¹ * (((L_strict (w + 1)).transpose * W_coupled w) i k * B_mat (w + 1) k c)) := by
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [JTM_coupled_inl_apply w i k]
      ring
    rw [hterm, Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    rfl
  rw [hz, hone, hJM, hJTMB]
  ring

/-- Helper lemma tracking alternating sum and power parity by induction on `n`. -/
theorem sum_neg_one_pow_and_pow (n : ℕ) :
    ((∑ k ∈ Finset.range n, (-1 : ℚ) ^ k) = 0 ∧ (-1 : ℚ) ^ n = 1) ∨
    ((∑ k ∈ Finset.range n, (-1 : ℚ) ^ k) = 1 ∧ (-1 : ℚ) ^ n = -1) := by
  induction n with
  | zero =>
    left
    simp
  | succ n ih =>
    rw [Finset.sum_range_succ, pow_succ]
    rcases ih with ⟨hs, hp⟩ | ⟨hs, hp⟩
    · right
      rw [hs, hp]
      constructor <;> ring
    · left
      rw [hs, hp]
      constructor <;> ring

/-- **Universal Bounds on Finite Alternating Power Sums (`sum_neg_one_pow_bounds`)**:
    For all `n : ℕ`, `0 ≤ ∑_{k < n} (-1)^k ≤ 1`. -/
theorem sum_neg_one_pow_bounds (n : ℕ) :
    0 ≤ (∑ k ∈ Finset.range n, (-1 : ℚ) ^ k) ∧ (∑ k ∈ Finset.range n, (-1 : ℚ) ^ k) ≤ 1 := by
  rcases sum_neg_one_pow_and_pow n with ⟨hs, _⟩ | ⟨hs, _⟩
  · rw [hs]; constructor <;> linarith
  · rw [hs]; constructor <;> linarith

/-- **Universal Bounds on Column 0 Sum of `B_mat` (`sum_B_mat_col_zero_bounds`)**:
    For all widths `w : ℕ`, `0 ≤ ∑_{k : Fin(w+1)} B_mat(w+1) k 0 ≤ 1`. -/
theorem sum_B_mat_col_zero_bounds (w : ℕ) :
    0 ≤ (∑ k : Fin (w + 1), B_mat (w + 1) k 0) ∧ (∑ k : Fin (w + 1), B_mat (w + 1) k 0) ≤ 1 := by
  have hB : (∑ k : Fin (w + 1), B_mat (w + 1) k 0) = ∑ k ∈ Finset.range (w + 1), (-1 : ℚ) ^ k := by
    rw [← Fin.sum_univ_eq_sum_range (fun k => (-1 : ℚ) ^ k) (w + 1)]
    refine Finset.sum_congr rfl fun k _ => ?_
    simp only [B_mat, Matrix.of_apply, Fin.val_zero, Nat.zero_le, ↓reduceIte, tsub_zero]
  rw [hB]
  exact sum_neg_one_pow_bounds (w + 1)

/-- **Upper Bound on Product `(W_coupled * B_mat) j 0 ≤ 3` (`W_coupled_mul_B_mat_col_zero_le_three`)**:
    For all `w : ℕ` and `j : Fin (w + 1)`, the column 0 product is bounded above by 3. -/
theorem W_coupled_mul_B_mat_col_zero_le_three (w : ℕ) (j : Fin (w + 1)) :
    (W_coupled w * B_mat (w + 1)) j 0 ≤ 3 := by
  have hW_def : W_coupled w = (2 : ℚ) • J_ones (w + 1) + (1 - E_last w) := rfl
  have hmul : W_coupled w * B_mat (w + 1) =
      (2 : ℚ) • (J_ones (w + 1) * B_mat (w + 1)) + (B_mat (w + 1) - E_last w * B_mat (w + 1)) := by
    rw [hW_def, Matrix.add_mul, Matrix.sub_mul, Matrix.smul_mul, Matrix.one_mul]
  have h_entry : (W_coupled w * B_mat (w + 1)) j 0 =
      2 * (∑ k : Fin (w + 1), B_mat (w + 1) k 0) + B_mat (w + 1) j 0 -
        (∑ k : Fin (w + 1), E_last w j k * B_mat (w + 1) k 0) := by
    rw [hmul]
    simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul, Matrix.mul_apply, J_ones, Matrix.of_apply, one_mul]
    rw [Finset.mul_sum]
    ring
  have hE : (∑ k : Fin (w + 1), E_last w j k * B_mat (w + 1) k 0) =
      (if j = ⟨w, Nat.lt_succ_self w⟩ then 1 else 0) * (∑ k : Fin (w + 1), B_mat (w + 1) k 0) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    dsimp [E_last]
  rw [hE] at h_entry
  have hbounds := sum_B_mat_col_zero_bounds w
  have hS0 := hbounds.1
  have hS1 := hbounds.2
  have hB_le_one : B_mat (w + 1) j 0 ≤ 1 := by
    simp only [B_mat, Matrix.of_apply, Fin.val_zero, Nat.zero_le, ↓reduceIte, tsub_zero]
    rcases sum_neg_one_pow_and_pow j.val with ⟨_, hp⟩ | ⟨_, hp⟩ <;> linarith
  rw [h_entry]
  split_ifs with hj <;> linarith

/-- **Universal Upper Bound on Early Reset Row 0 (`Q_reset_coupled_inl_col_zero_le_neg_quarter`)**:
    For all widths `w : ℕ` and all reset indices `i : Fin (w + 1)`,
    `Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl i)) 0 ≤ -1/4`. -/
theorem Q_reset_coupled_inl_col_zero_le_neg_quarter (w : ℕ) (i : Fin (w + 1)) :
    Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl i)) 0 ≤ - (1 / 4 : ℚ) := by
  have hterm_le : ∀ j : Fin (w + 1),
      L_strict (w + 1) i j * W_coupled w j 0 +
        (L_strict (w + 1)).transpose i j * (W_coupled w * B_mat (w + 1)) j 0 ≤ 3 := by
    intro j
    simp only [Matrix.transpose_apply, L_strict, Matrix.of_apply]
    have hW_le := W_coupled_entry_le_three w j 0
    have hWB_le := W_coupled_mul_B_mat_col_zero_le_three w j
    by_cases hij : j.val < i.val
    · have hji : ¬ (i.val < j.val) := by omega
      simp only [hij, hji, ↓reduceIte, one_mul, zero_mul, add_zero]
      exact hW_le
    · by_cases hji : i.val < j.val
      · simp only [hij, hji, ↓reduceIte, zero_mul, one_mul, zero_add]
        exact hWB_le
      · simp only [hij, hji, ↓reduceIte, zero_mul, add_zero]
        linarith
  have hsum_le : (L_strict (w + 1) * W_coupled w) i 0 +
      ((L_strict (w + 1)).transpose * W_coupled w * B_mat (w + 1)) i 0 ≤ 3 * (w + 1 : ℚ) := by
    rw [Matrix.mul_assoc]
    change (∑ j : Fin (w + 1), L_strict (w + 1) i j * W_coupled w j 0) +
      (∑ j : Fin (w + 1), (L_strict (w + 1)).transpose i j * (W_coupled w * B_mat (w + 1)) j 0) ≤ 3 * (w + 1 : ℚ)
    rw [← Finset.sum_add_distrib]
    have h_le := Finset.sum_le_sum fun j (_ : j ∈ Finset.univ) => hterm_le j
    have h_const : (∑ _j : Fin (w + 1), (3 : ℚ)) = 3 * (w + 1 : ℚ) := by
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      push_cast
      ring
    linarith
  rw [Q_reset_coupled_inl_apply w i 0]
  have hB_nonneg := (sum_B_mat_col_zero_bounds w).1
  have hw_pos : 0 < (w + 1 : ℚ) := by positivity
  have h_mul_le : (4 * (w + 1 : ℚ))⁻¹ *
      ((L_strict (w + 1) * W_coupled w) i 0 + ((L_strict (w + 1)).transpose * W_coupled w * B_mat (w + 1)) i 0) ≤
      (4 * (w + 1 : ℚ))⁻¹ * (3 * (w + 1 : ℚ)) := by
    apply mul_le_mul_of_nonneg_left hsum_le
    positivity
  have h_cancel : (4 * (w + 1 : ℚ))⁻¹ * (3 * (w + 1 : ℚ)) = 3 / 4 := by
    have hne : (w + 1 : ℚ) ≠ 0 := by positivity
    field_simp [hne]
  linarith

/-- **Universal Lower Bound on Late Reset Row 0 (`Q_reset_coupled_inr_col_zero_ge_quarter`)**:
    For all widths `w : ℕ` and all reset indices `i : Fin (w + 1)`,
    `1/4 ≤ Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr i)) 0`. -/
theorem Q_reset_coupled_inr_col_zero_ge_quarter {w : ℕ} (clock : AlgebraicClock w) (i : Fin (w + 1)) :
    (1 / 4 : ℚ) ≤
      Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr i)) 0 := by
  rw [Q_reset_coupled_inr_eq_neg_inl clock i 0]
  have h_inl := Q_reset_coupled_inl_col_zero_le_neg_quarter w i
  linarith

/-- **Lower Bound on Product `(W_coupled * B_mat) j 0 ≥ -1` (`W_coupled_mul_B_mat_col_zero_ge_neg_one`)**:
    For all `w : ℕ` and `j : Fin (w + 1)`, the column 0 product is bounded below by -1. -/
theorem W_coupled_mul_B_mat_col_zero_ge_neg_one (w : ℕ) (j : Fin (w + 1)) :
    -1 ≤ (W_coupled w * B_mat (w + 1)) j 0 := by
  have hW_def : W_coupled w = (2 : ℚ) • J_ones (w + 1) + (1 - E_last w) := rfl
  have hmul : W_coupled w * B_mat (w + 1) =
      (2 : ℚ) • (J_ones (w + 1) * B_mat (w + 1)) + (B_mat (w + 1) - E_last w * B_mat (w + 1)) := by
    rw [hW_def, Matrix.add_mul, Matrix.sub_mul, Matrix.smul_mul, Matrix.one_mul]
  have h_entry : (W_coupled w * B_mat (w + 1)) j 0 =
      2 * (∑ k : Fin (w + 1), B_mat (w + 1) k 0) + B_mat (w + 1) j 0 -
        (∑ k : Fin (w + 1), E_last w j k * B_mat (w + 1) k 0) := by
    rw [hmul]
    simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul, Matrix.mul_apply, J_ones, Matrix.of_apply, one_mul]
    rw [Finset.mul_sum]
    ring
  have hE : (∑ k : Fin (w + 1), E_last w j k * B_mat (w + 1) k 0) =
      (if j = ⟨w, Nat.lt_succ_self w⟩ then 1 else 0) * (∑ k : Fin (w + 1), B_mat (w + 1) k 0) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    dsimp [E_last]
  rw [hE] at h_entry
  have hbounds := sum_B_mat_col_zero_bounds w
  have hS0 := hbounds.1
  have hS1 := hbounds.2
  have hB_ge_neg_one : -1 ≤ B_mat (w + 1) j 0 := by
    simp only [B_mat, Matrix.of_apply, Fin.val_zero, Nat.zero_le, ↓reduceIte, tsub_zero]
    rcases sum_neg_one_pow_and_pow j.val with ⟨_, hp⟩ | ⟨_, hp⟩ <;> linarith
  rw [h_entry]
  split_ifs with hj <;> linarith

/-- **Universal Lower Bound on Early Reset Row 0 (`Q_reset_coupled_inl_col_zero_ge_neg_nine_quarters`)**:
    For all widths `w : ℕ` and all reset indices `i : Fin (w + 1)`,
    `-9/4 ≤ Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl i)) 0`. -/
theorem Q_reset_coupled_inl_col_zero_ge_neg_nine_quarters (w : ℕ) (i : Fin (w + 1)) :
    - (9 / 4 : ℚ) ≤
      Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inl i)) 0 := by
  have hterm_ge : ∀ j : Fin (w + 1),
      -1 ≤ L_strict (w + 1) i j * W_coupled w j 0 +
        (L_strict (w + 1)).transpose i j * (W_coupled w * B_mat (w + 1)) j 0 := by
    intro j
    simp only [Matrix.transpose_apply, L_strict, Matrix.of_apply]
    have hW_ge := W_coupled_entry_ge_one w j 0
    have hWB_ge := W_coupled_mul_B_mat_col_zero_ge_neg_one w j
    by_cases hij : j.val < i.val
    · have hji : ¬ (i.val < j.val) := by omega
      simp only [hij, hji, ↓reduceIte, one_mul, zero_mul, add_zero]
      linarith
    · by_cases hji : i.val < j.val
      · simp only [hij, hji, ↓reduceIte, zero_mul, one_mul, zero_add]
        exact hWB_ge
      · simp only [hij, hji, ↓reduceIte, zero_mul, add_zero]
        linarith
  have hsum_ge : - (w + 1 : ℚ) ≤ (L_strict (w + 1) * W_coupled w) i 0 +
      ((L_strict (w + 1)).transpose * W_coupled w * B_mat (w + 1)) i 0 := by
    rw [Matrix.mul_assoc]
    change - (w + 1 : ℚ) ≤ (∑ j : Fin (w + 1), L_strict (w + 1) i j * W_coupled w j 0) +
      (∑ j : Fin (w + 1), (L_strict (w + 1)).transpose i j * (W_coupled w * B_mat (w + 1)) j 0)
    rw [← Finset.sum_add_distrib]
    have h_ge := Finset.sum_le_sum fun j (_ : j ∈ Finset.univ) => hterm_ge j
    have h_const : (∑ _j : Fin (w + 1), (-1 : ℚ)) = - (w + 1 : ℚ) := by
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      push_cast
      ring
    linarith
  rw [Q_reset_coupled_inl_apply w i 0]
  have hB_le_one := (sum_B_mat_col_zero_bounds w).2
  have hw_pos : 0 < (w + 1 : ℚ) := by positivity
  have h_mul_ge : - (1 / 4 : ℚ) ≤ (4 * (w + 1 : ℚ))⁻¹ *
      ((L_strict (w + 1) * W_coupled w) i 0 + ((L_strict (w + 1)).transpose * W_coupled w * B_mat (w + 1)) i 0) := by
    have h1 : (4 * (w + 1 : ℚ))⁻¹ * (- (w + 1 : ℚ)) ≤
        (4 * (w + 1 : ℚ))⁻¹ *
          ((L_strict (w + 1) * W_coupled w) i 0 + ((L_strict (w + 1)).transpose * W_coupled w * B_mat (w + 1)) i 0) := by
      apply mul_le_mul_of_nonneg_left hsum_ge
      positivity
    have h_cancel : (4 * (w + 1 : ℚ))⁻¹ * (- (w + 1 : ℚ)) = - (1 / 4 : ℚ) := by
      have hne : (w + 1 : ℚ) ≠ 0 := by positivity
      field_simp [hne]
    linarith
  linarith

/-- **Universal Upper Bound on Late Reset Row 0 (`Q_reset_coupled_inr_col_zero_le_nine_quarters`)**:
    For all widths `w : ℕ` and all reset indices `i : Fin (w + 1)`,
    `Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr i)) 0 ≤ 9/4`. -/
theorem Q_reset_coupled_inr_col_zero_le_nine_quarters {w : ℕ} (clock : AlgebraicClock w) (i : Fin (w + 1)) :
    Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) (finSumFinEquiv (Sum.inr i)) 0 ≤
      (9 / 4 : ℚ) := by
  rw [Q_reset_coupled_inr_eq_neg_inl clock i 0]
  have h_inl := Q_reset_coupled_inl_col_zero_ge_neg_nine_quarters w i
  linarith

/-- **Monotonicity of Binomial Basis Vector Entries in Phase Index (`binomBasis_le_succ`)**:
    For all widths `w`, phases `q`, and coordinate indices `c : Fin w`,
    `binomBasis w q c ≤ binomBasis w (q + 1) c`. -/
theorem binomBasis_le_succ (w q : ℕ) (c : Fin w) :
    binomBasis w q c ≤ binomBasis w (q + 1) c := by
  dsimp only [binomBasis]
  have h := Nat.choose_le_succ q c.val
  exact_mod_cast h

/-!
## Section 22: Closed-Form Ceiling Evaluation and Effective Linear Slope (`dc_admissible_sub_ch_eq`)

In this section, we establish the exact closed-form expansion of
`dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) Q)`
into its linear term `dc_admissible * Q` and binomial sum `c_zeta * ∑ c, binomBasis (w + 1) Q c`,
along with the explicit decomposition of the effective linear slope `dc_admissible - ch`.
-/

/-- **Action of `zeta_coupled` on Binomial Basis (`dotProduct_zeta_coupled_binomBasis`)**:
    Since all entries of `zeta_coupled w` equal 1, the dot product with `binomBasis (w + 1) Q`
    reduces to the unweighted sum `∑ c, binomBasis (w + 1) Q c`. -/
theorem dotProduct_zeta_coupled_binomBasis (w Q : ℕ) :
    dotProduct (zeta_coupled w) (binomBasis (w + 1) Q) = ∑ c : Fin (w + 1), binomBasis (w + 1) Q c := by
  simp only [dotProduct, zeta_coupled, one_mul]

/-- **Action of `zeta_admissible` on Binomial Basis (`dotProduct_zeta_admissible_binomBasis`)**:
    Since `zeta_admissible = dc • e1_row` and `e1_row • binomBasis = Q`, the dot product
    evaluates to `dc * Q`. -/
theorem dotProduct_zeta_admissible_binomBasis {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (Q : ℕ) :
    dotProduct (zeta_admissible clock b H0 ch delta) (binomBasis (w + 1) Q) =
      dc_admissible clock b H0 ch delta * (Q : ℚ) := by
  dsimp only [zeta_admissible]
  rw [smul_dotProduct, smul_eq_mul, e1_row_dot_binomBasis hw Q]

/-- **Decomposition of Scaled Ceiling Vector Evaluation (`dotProduct_zeta_admissible_scaled_binomBasis_eq`)**:
    Evaluates `dotProduct (zeta_admissible_scaled ...) (binomBasis (w + 1) Q)` as
    `dc * Q + c_zeta * (∑ c, binomBasis (w + 1) Q c)`. -/
theorem dotProduct_zeta_admissible_scaled_binomBasis_eq {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta : ℚ) (Q : ℕ) :
    dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) Q) =
      dc_admissible clock b H0 ch delta * (Q : ℚ) +
        c_zeta * (∑ c : Fin (w + 1), binomBasis (w + 1) Q c) := by
  dsimp only [zeta_admissible_scaled]
  rw [add_dotProduct, smul_dotProduct, smul_eq_mul]
  rw [dotProduct_zeta_admissible_binomBasis hw clock b H0 ch delta Q]
  rw [dotProduct_zeta_coupled_binomBasis w Q]

/-- **Zero-Baseline Representation of Top-Corner Entry $K_{0, w}$ (`K_admissible_zero_last_zero_eq`)**:
    At `H0 = 0, ch = 0, delta = 0`, entry `(0, w)` of `K_admissible` equals the inner product
    of column 0 of `D_admissible` on parent actions with the top degree column of `clock.C`. -/
theorem K_admissible_zero_last_zero_eq {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) :
    K_admissible clock b 0 0 0 ⟨0, Nat.succ_pos w⟩ ⟨w, Nat.lt_succ_self w⟩ =
      ∑ i : Fin clock.m, D_admissible clock b 0 0 0 (finSumFinEquiv (Sum.inl i)) 0 * clock.C i ⟨w - 1, by omega⟩ := by
  have h0 : (⟨0, Nat.succ_pos w⟩ : Fin (w + 1)) = 0 := rfl
  rw [h0]
  dsimp only [K_admissible]
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  rw [(Equiv.sum_comp finSumFinEquiv fun x =>
    D_admissible clock b 0 0 0 x 0 * X_gateway clock x ⟨w, Nat.lt_succ_self w⟩).symm]
  rw [Fintype.sum_sum_type]
  have he0_top : e0_row (w + 1) ⟨w, Nat.lt_succ_self w⟩ = 0 := by
    simp only [e0_row]
    split_ifs with h
    · omega
    · rfl
  have hX_inr : (∑ g : Fin 1,
      D_admissible clock b 0 0 0 (finSumFinEquiv (Sum.inr g)) 0 *
      X_gateway clock (finSumFinEquiv (Sum.inr g)) ⟨w, Nat.lt_succ_self w⟩) = 0 := by
    apply Finset.sum_eq_zero
    intro g _
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, he0_top, mul_zero]
  rw [hX_inr, add_zero]
  refine Finset.sum_congr rfl fun i _ => ?_
  congr 1
  simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, shiftRightCount]
  have hw_pos : 0 < w := by omega
  simp [hw_pos]

/-- **Full Closed Form of Top-Corner Entry $K_{0, w}$ in $c_h$ (`K_admissible_zero_last_eq`)**:
    For all `H0, ch, delta`, $K_{0, w}$ equals the baseline sum plus `ch * (∑ i, clock.C i (w - 1))`. -/
theorem K_admissible_zero_last_eq {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    K_admissible clock b H0 ch delta ⟨0, Nat.succ_pos w⟩ ⟨w, Nat.lt_succ_self w⟩ =
      (∑ i : Fin clock.m, D_admissible clock b 0 0 0 (finSumFinEquiv (Sum.inl i)) 0 * clock.C i ⟨w - 1, by omega⟩) +
        ch * (∑ i : Fin clock.m, clock.C i ⟨w - 1, by omega⟩) := by
  rw [K_admissible_top_corner_decomp_ch hw clock b H0 ch delta]
  rw [K_admissible_zero_last_zero_eq hw clock b]
  rw [topColSum_X_gateway_eq_sum_C clock hw]

/-- **Exact Closed-Form Decomposition of $d_c$ in $c_h$ (`dc_admissible_eq_sum_decomp`)**:
    Decomposes $d_c(\dots, c_h)$ into the zero-baseline term minus $c_h \cdot \frac{\sum C}{4(w+1)}$. -/
theorem dc_admissible_eq_sum_decomp {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    dc_admissible clock b H0 ch delta =
      - (∑ i : Fin clock.m, D_admissible clock b 0 0 0 (finSumFinEquiv (Sum.inl i)) 0 * clock.C i ⟨w - 1, by omega⟩) / (4 * (w + 1 : ℚ)) -
        ch * ((∑ i : Fin clock.m, clock.C i ⟨w - 1, by omega⟩) / (4 * (w + 1 : ℚ))) := by
  dsimp only [dc_admissible]
  rw [K_admissible_zero_last_eq hw clock b H0 ch delta]
  ring

/-- **Closed-Form Representation of Zero-Baseline $d_c$ (`dc_admissible_zero_baseline_eq`)**. -/
theorem dc_admissible_zero_baseline_eq {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) :
    dc_admissible clock b 0 0 0 =
      - (∑ i : Fin clock.m, D_admissible clock b 0 0 0 (finSumFinEquiv (Sum.inl i)) 0 * clock.C i ⟨w - 1, by omega⟩) / (4 * (w + 1 : ℚ)) := by
  linarith [dc_admissible_eq_sum_decomp hw clock b 0 0 0]

/-- **Effective Linear Slope Decomposition (`dc_admissible_sub_ch_eq`)**:
    The combined linear slope `dc_admissible clock b H0 ch delta - ch` equals
    `dc_admissible clock b 0 0 0 - ch * (1 + topColSum_X_gateway clock / (4 * (w + 1 : ℚ)))`. -/
theorem dc_admissible_sub_ch_eq {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    dc_admissible clock b H0 ch delta - ch =
      dc_admissible clock b 0 0 0 - ch * (1 + topColSum_X_gateway clock / (4 * (w + 1 : ℚ))) := by
  rw [dc_admissible_decomp_ch hw clock b H0 ch delta]
  ring

/-!
## Section 23: Early Reset Left-Inverse Annihilation and Exact Coupling Decomposition

In this section, we establish:
1. Identical vanishing of `R_M_coupled w` on early reset columns `Sum.inl j`.
2. Vanishing of any matrix product `A * R_M_coupled w` on early reset columns.
3. Closed-form evaluation of `P_admissible_scaled` at `c_zeta = 0, c_P0 = 0` on early columns.
4. Exact affine decomposition of `P_admissible_scaled` on early columns into `L_X * Q_resetᵀ - c_P0 * a_old_proj`.
5. Odd anti-symmetry of `L_X_gateway L_C * (Q_reset (J_coupled w))ᵀ` under early/late exchange.
6. Simultaneous cancellation of `c_zeta` and `c_P0` in the early + late reset sum `P(inl) + P(inr)`.
-/

/-- **Early Reset Columns of `R_M_coupled` Vanish Identically (`R_M_coupled_inl_eq_zero`)**:
    For all widths `w : ℕ`, columns `c : Fin (w + 1)`, and early reset indices `j : Fin (w + 1)`,
    `R_M_coupled w c (finSumFinEquiv (Sum.inl j)) = 0`. -/
theorem R_M_coupled_inl_eq_zero (w : ℕ) (c : Fin (w + 1)) (j : Fin (w + 1)) :
    R_M_coupled w c (finSumFinEquiv (Sum.inl j)) = 0 := by
  simp only [R_M_coupled, Matrix.of_apply, Equiv.symm_apply_apply]

/-- **Action of Any Matrix Multiplied by `R_M_coupled` on Early Reset Columns (`mul_R_M_coupled_inl_eq_zero`)**:
    For any row indexing type `α` and any matrix `A : Matrix α (Fin (w + 1)) ℚ`, the product
    `A * R_M_coupled w` vanishes identically on all early reset columns `Sum.inl j`. -/
theorem mul_R_M_coupled_inl_eq_zero {α : Type*} [Fintype α] {w : ℕ}
    (A : Matrix α (Fin (w + 1)) ℚ) (x : α) (j : Fin (w + 1)) :
    (A * R_M_coupled w) x (finSumFinEquiv (Sum.inl j)) = 0 := by
  simp only [Matrix.mul_apply, R_M_coupled_inl_eq_zero, mul_zero, Finset.sum_const_zero]

/-- **Zero-Baseline Coupling Evaluation on Early Reset Columns (`P_admissible_scaled_zero_inl_eq_L_X_mul_Q_reset`)**:
    At scaling parameters `c_zeta = 0` and `c_P0 = 0`, the early reset columns of `P_admissible_scaled`
    reduce strictly to `L_X_gateway L_C * (Q_reset (J_admissible_scaled ... 0))ᵀ` because all terms
    factoring through `R_M_coupled w` vanish identically. -/
theorem P_admissible_scaled_zero_inl_eq_L_X_mul_Q_reset {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x (finSumFinEquiv (Sum.inl j)) =
      (L_X_gateway L_C *
        (Q_reset (J_admissible_scaled clock b H0 ch delta 0) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta 0)).transpose) x (finSumFinEquiv (Sum.inl j)) := by
  have hsimp := congr_fun (congr_fun (P_admissible_scaled_eq_simplified clock b H0 ch delta 0 0 a_old L_C) x)
    (finSumFinEquiv (Sum.inl j))
  dsimp only [Q_res] at hsimp
  simp only [zero_smul, Matrix.transpose_zero, Matrix.zero_mul, sub_zero] at hsimp
  rw [Matrix.mul_sub] at hsimp
  simp only [Matrix.add_apply, Matrix.sub_apply, zero_add] at hsimp
  rw [mul_R_M_coupled_inl_eq_zero (D_admissible clock b H0 ch delta) x j] at hsimp
  have hR : (L_X_gateway L_C * ((X_gateway clock).transpose * D_admissible clock b H0 ch delta * R_M_coupled w)) x
      (finSumFinEquiv (Sum.inl j)) = 0 := by
    rw [← Matrix.mul_assoc (L_X_gateway L_C) ((X_gateway clock).transpose * D_admissible clock b H0 ch delta) (R_M_coupled w)]
    exact mul_R_M_coupled_inl_eq_zero (L_X_gateway L_C * ((X_gateway clock).transpose * D_admissible clock b H0 ch delta)) x j
  rw [hR] at hsimp
  simp only [zero_add, sub_zero] at hsimp
  exact hsimp

/-- **Exact Scaling Representation on Early Reset Columns (`P_admissible_scaled_inl_eq_L_X_mul_Q_reset_sub_proj`)**:
    For all scaling parameters `c_zeta` and `c_P0`, entry `(x, Sum.inl j)` of `P_admissible_scaled` equals
    the interpolated target table `(L_X_gateway L_C * (Q_reset (scaled c_zeta))ᵀ) x (Sum.inl j)` minus
    the cone projection contribution `c_P0 * a_old_proj x`. -/
theorem P_admissible_scaled_inl_eq_L_X_mul_Q_reset_sub_proj {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C x (finSumFinEquiv (Sum.inl j)) =
      (L_X_gateway L_C *
        (Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
          (zeta_admissible_scaled clock b H0 ch delta c_zeta)).transpose) x (finSumFinEquiv (Sum.inl j)) -
        c_P0 * a_old_proj clock a_old L_C x := by
  have hQ : Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
      (zeta_admissible_scaled clock b H0 ch delta c_zeta) =
    Q_reset (J_admissible_scaled clock b H0 ch delta 0) (M_coupled w) (B_mat (w + 1))
      (zeta_admissible_scaled clock b H0 ch delta 0) +
      c_zeta • Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w) := by
    rw [Q_reset_admissible_scaled_decomp, Q_reset_admissible_scaled_decomp clock b H0 ch delta 0]
    simp only [zero_smul, add_zero]
  rw [P_admissible_scaled_inl_eq_proj]
  rw [P_admissible_scaled_zero_inl_eq_L_X_mul_Q_reset]
  rw [hQ]
  rw [Matrix.transpose_add, Matrix.transpose_smul]
  rw [Matrix.mul_add, Matrix.mul_smul]
  simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]

/-- **Odd Anti-Symmetry of Interpolated Coupled Matrix (`L_X_gateway_mul_Q_reset_coupled_transpose_inr_eq_neg_inl`)**:
    Under matrix multiplication by `L_X_gateway L_C`, the late reset column `Sum.inr j` of
    `(L_X_gateway L_C * (Q_reset (J_coupled w))ᵀ)` is the exact negation of the early reset column `Sum.inl j`. -/
theorem L_X_gateway_mul_Q_reset_coupled_transpose_inr_eq_neg_inl {w : ℕ} (clock : AlgebraicClock w)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    (L_X_gateway L_C * (Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w)).transpose) x
        (finSumFinEquiv (Sum.inr j)) =
      - (L_X_gateway L_C * (Q_reset (J_coupled w) (M_coupled w) (B_mat (w + 1)) (zeta_coupled w)).transpose) x
          (finSumFinEquiv (Sum.inl j)) := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  rw [← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun c _ => ?_
  rw [Q_reset_coupled_inr_eq_neg_inl clock j c]
  ring

/-- **Simultaneous Vanishing of `c_zeta` and `c_P0` in Early/Late Coupling Sum (`P_admissible_scaled_sum_inl_inr_eq_zero_base`)**:
    Summing early and late reset columns of `P_admissible_scaled` cancels both `c_zeta` (via odd anti-symmetry)
    and `c_P0` (via cone projection anti-symmetry), leaving the sum identically equal to its zero-baseline value. -/
theorem P_admissible_scaled_sum_inl_inr_eq_zero_base {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C x (finSumFinEquiv (Sum.inl j)) +
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C x (finSumFinEquiv (Sum.inr j)) =
    P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x (finSumFinEquiv (Sum.inl j)) +
      P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x (finSumFinEquiv (Sum.inr j)) := by
  rw [P_admissible_scaled_inl_eq_proj, P_admissible_scaled_inr_eq_proj]
  rw [L_X_gateway_mul_Q_reset_coupled_transpose_inr_eq_neg_inl clock L_C x j]
  ring

/-!
## Section 24: Coupling Sum Closed Form and Parent Deficit Action

In this section, we establish:
1. Exact late reset column formula for `R_M_coupled w`.
2. Action of any matrix product `A * R_M_coupled w` on late reset columns.
3. Closed-form evaluation of the zero-baseline sum `P(0, 0)(inl) + P(0, 0)(inr)` as `D * W_inv`.
4. Universal cancellation of `c_zeta` and `c_P0` in `P(c_zeta, c_P0)(inl) + P(c_zeta, c_P0)(inr) = D * W_inv`
   and parameter-free evaluation at `(0, ch, 0)`.
5. Exact closed-form coordinate representation of `D_admissible` on parent rows `Sum.inl i`.
6. Explicit closed-form action of `D_admissible * W_coupled_inv w` on parent rows.
-/

/-- **Late Reset Columns of `R_M_coupled` Equal `W_coupled_inv` (`R_M_coupled_inr_eq`)**:
    For all widths `w : ℕ`, columns `c : Fin (w + 1)`, and late reset indices `j : Fin (w + 1)`,
    `R_M_coupled w c (finSumFinEquiv (Sum.inr j)) = W_coupled_inv w c j`. -/
theorem R_M_coupled_inr_eq (w : ℕ) (c : Fin (w + 1)) (j : Fin (w + 1)) :
    R_M_coupled w c (finSumFinEquiv (Sum.inr j)) = W_coupled_inv w c j := by
  simp only [R_M_coupled, Matrix.of_apply, Equiv.symm_apply_apply]

/-- **Action of Any Matrix Multiplied by `R_M_coupled` on Late Reset Columns (`mul_R_M_coupled_inr_eq`)**:
    For any row indexing type `α` and any matrix `A : Matrix α (Fin (w + 1)) ℚ`, the product
    `A * R_M_coupled w` on late reset columns `Sum.inr j` coincides with `(A * W_coupled_inv w) x j`. -/
theorem mul_R_M_coupled_inr_eq {α : Type*} [Fintype α] {w : ℕ}
    (A : Matrix α (Fin (w + 1)) ℚ) (x : α) (j : Fin (w + 1)) :
    (A * R_M_coupled w) x (finSumFinEquiv (Sum.inr j)) = (A * W_coupled_inv w) x j := by
  simp only [Matrix.mul_apply, R_M_coupled_inr_eq]

/-- **Closed Form for the Zero-Baseline Coupling Sum (`P_admissible_scaled_zero_sum_inl_inr_eq`)**:
    At `c_zeta = 0, c_P0 = 0`, the sum of early and late reset columns of `P_admissible_scaled`
    reduces strictly to `(D_admissible * W_coupled_inv w) x j` because the target residual terms
    cancel identically against `(W_inv)ᵀ * K_admissible`. -/
theorem P_admissible_scaled_zero_sum_inl_inr_eq {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x (finSumFinEquiv (Sum.inl j)) +
      P_admissible_scaled clock b H0 ch delta 0 0 a_old L_C x (finSumFinEquiv (Sum.inr j)) =
    (D_admissible clock b H0 ch delta * W_coupled_inv w) x j := by
  have hinl := P_admissible_scaled_zero_inl_eq_L_X_mul_Q_reset clock b H0 ch delta a_old L_C x j
  have hinr := congr_fun (congr_fun (P_admissible_scaled_eq_simplified clock b H0 ch delta 0 0 a_old L_C) x)
    (finSumFinEquiv (Sum.inr j))
  dsimp only [Q_res] at hinr
  simp only [zero_smul, Matrix.transpose_zero, Matrix.zero_mul, sub_zero] at hinr
  rw [Matrix.mul_sub] at hinr
  simp only [Matrix.add_apply, Matrix.sub_apply, zero_add] at hinr
  rw [mul_R_M_coupled_inr_eq (D_admissible clock b H0 ch delta) x j] at hinr
  have hR : (L_X_gateway L_C * ((X_gateway clock).transpose * D_admissible clock b H0 ch delta * R_M_coupled w)) x
      (finSumFinEquiv (Sum.inr j)) =
      (L_X_gateway L_C * (((X_gateway clock).transpose * D_admissible clock b H0 ch delta) * W_coupled_inv w)) x j := by
    rw [← Matrix.mul_assoc (L_X_gateway L_C) ((X_gateway clock).transpose * D_admissible clock b H0 ch delta) (R_M_coupled w)]
    rw [mul_R_M_coupled_inr_eq (L_X_gateway L_C * ((X_gateway clock).transpose * D_admissible clock b H0 ch delta)) x j]
    rw [Matrix.mul_assoc]
  rw [hR] at hinr
  let Q0 := Q_reset (J_admissible_scaled clock b H0 ch delta 0) (M_coupled w) (B_mat (w + 1))
    (zeta_admissible_scaled clock b H0 ch delta 0)
  have h_sum_Q : (L_X_gateway L_C * Q0.transpose) x (finSumFinEquiv (Sum.inl j)) +
      (L_X_gateway L_C * Q0.transpose) x (finSumFinEquiv (Sum.inr j)) =
      (L_X_gateway L_C * (((X_gateway clock).transpose * D_admissible clock b H0 ch delta) * W_coupled_inv w)) x j := by
    have h_KW : ((X_gateway clock).transpose * D_admissible clock b H0 ch delta) * W_coupled_inv w =
        ((W_coupled_inv w).transpose * K_admissible clock b H0 ch delta).transpose := by
      dsimp only [K_admissible]
      rw [Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.transpose_transpose]
    rw [h_KW]
    simp only [Matrix.mul_apply, Matrix.transpose_apply]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [← mul_add]
    congr 1
    exact Q_reset_admissible_scaled_sum_inl_inr hw clock b H0 ch delta 0 j c
  rw [hinl, hinr]
  linarith [h_sum_Q]

/-- **Universal Cancellation of Scaling Parameters in Early + Late Coupling Sum (`P_admissible_scaled_sum_inl_inr_eq`)**:
    For all widths `w ≥ 2` and arbitrary scaling parameters `c_zeta, c_P0`, the early + late reset column sum
    of `P_admissible_scaled` equals `(D_admissible * W_coupled_inv w) x j`, completely independent of `c_zeta`,
    `c_P0`, `a_old`, and `L_C`. -/
theorem P_admissible_scaled_sum_inl_inr_eq {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C x (finSumFinEquiv (Sum.inl j)) +
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C x (finSumFinEquiv (Sum.inr j)) =
    (D_admissible clock b H0 ch delta * W_coupled_inv w) x j := by
  rw [P_admissible_scaled_sum_inl_inr_eq_zero_base]
  exact P_admissible_scaled_zero_sum_inl_inr_eq hw clock b H0 ch delta a_old L_C x j

/-- **Parameter-Independent Zero-Baseline Evaluation of the Early/Late Coupling Sum (`P_admissible_scaled_sum_inl_inr_zero_eq`)**:
    The sum of early and late reset columns of `P_admissible_scaled` equals `(D_admissible clock b 0 ch 0 * W_coupled_inv w) x j`. -/
theorem P_admissible_scaled_sum_inl_inr_zero_eq {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (x : Fin (clock.m + 1)) (j : Fin (w + 1)) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C x (finSumFinEquiv (Sum.inl j)) +
      P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C x (finSumFinEquiv (Sum.inr j)) =
    (D_admissible clock b 0 ch 0 * W_coupled_inv w) x j := by
  rw [P_admissible_scaled_sum_inl_inr_eq hw clock b H0 ch delta c_zeta c_P0 a_old L_C x j]
  rw [D_admissible_indep_of_H0_delta clock b H0 ch delta]

/-- **Exact Closed-Form Representation of `D_admissible` on Parent Rows (`D_admissible_inl_eq`)**:
    For all parent actions `i : Fin clock.m`, column `0` evaluates to
    `clock.R i 0 + ch + clock.G b i + clock.v i`, while all higher columns `r > 0` vanish identically. -/
theorem D_admissible_inl_eq {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (i : Fin clock.m) (r : Fin (w + 1)) :
    D_admissible clock b H0 ch delta (finSumFinEquiv (Sum.inl i)) r =
      if r.val = 0 then clock.R i ⟨0, hw⟩ + ch + clock.G b i + clock.v i else 0 := by
  by_cases hr0 : r.val = 0
  · dsimp only [D_admissible]
    simp only [Matrix.sub_apply]
    rw [GO_mul_X_inl_apply]
    have he0 : e0_row (w + 1) r = 1 := by simp [e0_row, hr0]
    have hGC0 : (clock.G * shiftRightCount clock.C) i r = 0 :=
      mul_shiftRightCount_zero clock.G clock.C i r hr0
    rw [he0, hGC0, zero_sub]
    have hsum : (S_admissible clock b H0 ch delta * N_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) r =
        (shiftRightCount clock.R * N_mat (w + 1)) i r + Matrix.vecMul (h_row_lin w H0 ch) (N_mat (w + 1)) r := by
      simp only [Matrix.mul_apply, Matrix.vecMul, dotProduct, S_admissible, Matrix.of_apply, Equiv.symm_apply_apply, add_mul]
      rw [Finset.sum_add_distrib]
    rw [hsum]
    rw [shiftRightCount_R_mul_N_mat hw clock i r]
    rw [h_row_lin_mul_N_mat hw]
    simp only [hr0, ↓reduceIte, Pi.smul_apply, smul_eq_mul, he0, mul_one]
    ring
  · have hr_pos : 0 < r.val := by omega
    have hzero := D_admissible_inl_eq_zero_of_pos hw clock b H0 ch delta i r hr_pos
    simp only [hr0, ↓reduceIte]
    exact hzero

/-- **Explicit Action of `D_admissible * W_coupled_inv` on Parent Rows (`D_admissible_mul_W_coupled_inv_inl_eq`)**:
    Because `D_admissible` is supported strictly on column `0` for parent actions `i`, the matrix product
    with `W_coupled_inv w` factors as `(clock.R i 0 + ch + clock.G b i + clock.v i) * W_inv(0, j)`. -/
theorem D_admissible_mul_W_coupled_inv_inl_eq {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) (i : Fin clock.m) (j : Fin (w + 1)) :
    (D_admissible clock b H0 ch delta * W_coupled_inv w) (finSumFinEquiv (Sum.inl i)) j =
      (clock.R i ⟨0, hw⟩ + ch + clock.G b i + clock.v i) *
        ((if (0 : Fin (w + 1)) = j then 1 else 0) - (w + 1 : ℚ)⁻¹) := by
  simp only [Matrix.mul_apply]
  let r0 : Fin (w + 1) := ⟨0, by omega⟩
  have hr0_lt : r0.val < w := by change 0 < w; omega
  have hterm : ∀ r : Fin (w + 1),
      D_admissible clock b H0 ch delta (finSumFinEquiv (Sum.inl i)) r * W_coupled_inv w r j =
        if r = r0 then (clock.R i ⟨0, hw⟩ + ch + clock.G b i + clock.v i) *
          ((if (0 : Fin (w + 1)) = j then 1 else 0) - (w + 1 : ℚ)⁻¹) else 0 := by
    intro r
    rw [D_admissible_inl_eq hw clock b H0 ch delta i r]
    by_cases hr : r = r0
    · subst hr
      have hval0 : r0.val = 0 := rfl
      have hr0_eq : r0 = (0 : Fin (w + 1)) := rfl
      simp only [hval0, ↓reduceIte]
      rw [W_coupled_inv_apply_of_lt w r0 j hr0_lt]
      rw [hr0_eq]
    · have hval_ne : ¬ (r.val = 0) := by
        intro h
        apply hr
        ext
        exact h
      simp only [hval_ne, ↓reduceIte, zero_mul, hr]
  have h_sum : (∑ r : Fin (w + 1), D_admissible clock b H0 ch delta (finSumFinEquiv (Sum.inl i)) r * W_coupled_inv w r j) =
      ∑ r : Fin (w + 1), if r = r0 then (clock.R i ⟨0, hw⟩ + ch + clock.G b i + clock.v i) *
        ((if (0 : Fin (w + 1)) = j then 1 else 0) - (w + 1 : ℚ)⁻¹) else 0 :=
    Finset.sum_congr rfl fun r _ => hterm r
  rw [h_sum, Finset.sum_ite_eq' Finset.univ r0]
  simp only [Finset.mem_univ, ↓reduceIte]

/-!
## Section 25: Zero-Row Left-Inverse Simplification and `L_C_admissible_scaled_next` Block Structure

In this section, we establish:
1. `L_X_gateway_inl_apply`: on parent rows `Sum.inl i`, `L_X_gateway L_C` is `shiftRightCount L_C i`.
2. `L_X_gateway_inl_eq_zero_of_row_zero`: whenever row `i` of `L_C` vanishes (`∀ d, L_C i d = 0`),
   row `Sum.inl i` of `L_X_gateway L_C` vanishes identically.
3. `a_old_proj_inl_eq_of_row_zero`: whenever row `i` of `L_C` vanishes, `a_old_proj` on `Sum.inl i`
   equals `a_old (Sum.inl i)`.
4. `P_admissible_scaled_inl_inl_eq_neg_cP0_of_row_zero`: whenever row `i` of `L_C` vanishes,
   the early reset coupling `P(inl i, inl j)` reduces identically to `- c_P0 * a_old (inl i)`.
5. `L_C_admissible_scaled_next_inl_eq_zero`, `L_C_admissible_scaled_next_inr_inl_eq_zero`, and
   `L_C_admissible_scaled_next_inr_inr_eq`: in every lifted clock, `L_C_admissible_scaled_next`
   vanishes on all old actions and all early reset actions, and equals `W_coupled_inv w` on late reset actions.
-/

/-- Action of `L_X_gateway L_C` on parent rows `Sum.inl i`. -/
theorem L_X_gateway_inl_apply {w : ℕ} {clock : AlgebraicClock w}
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (i : Fin clock.m) (c : Fin (w + 1)) :
    L_X_gateway L_C (finSumFinEquiv (Sum.inl i)) c = shiftRightCount L_C i c := by
  simp only [L_X_gateway, L_X_coupled, Matrix.of_apply, Equiv.symm_apply_apply]

/-- If row `i` of `L_C` vanishes identically, then row `Sum.inl i` of `L_X_gateway L_C` vanishes identically. -/
theorem L_X_gateway_inl_eq_zero_of_row_zero {w : ℕ} {clock : AlgebraicClock w}
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (i : Fin clock.m)
    (hrow : ∀ d : Fin w, L_C i d = 0) (c : Fin (w + 1)) :
    L_X_gateway L_C (finSumFinEquiv (Sum.inl i)) c = 0 := by
  rw [L_X_gateway_inl_apply]
  simp only [shiftRightCount, Matrix.of_apply]
  split_ifs with h
  · exact hrow ⟨c.val - 1, by omega⟩
  · rfl

/-- If row `i` of `L_C` vanishes identically, then `a_old_proj` on `Sum.inl i` equals `a_old (Sum.inl i)`. -/
theorem a_old_proj_inl_eq_of_row_zero {w : ℕ} (clock : AlgebraicClock w)
    (a_old : Fin (clock.m + 1) → ℚ) (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (i : Fin clock.m) (hrow : ∀ d : Fin w, L_C i d = 0) :
    a_old_proj clock a_old L_C (finSumFinEquiv (Sum.inl i)) = a_old (finSumFinEquiv (Sum.inl i)) := by
  dsimp only [a_old_proj, Matrix.mulVec, dotProduct]
  have hsum : (∑ c : Fin (w + 1),
      L_X_gateway L_C (finSumFinEquiv (Sum.inl i)) c * Matrix.vecMul a_old (X_gateway clock) c) = 0 := by
    apply Finset.sum_eq_zero
    intro c _
    rw [L_X_gateway_inl_eq_zero_of_row_zero L_C i hrow c, zero_mul]
  rw [hsum, sub_zero]

/-- If row `i` of `L_C` vanishes identically, then `P_admissible_scaled` on `(Sum.inl i, Sum.inl j)`
    reduces strictly to `- c_P0 * a_old (Sum.inl i)`. -/
theorem P_admissible_scaled_inl_inl_eq_neg_cP0_of_row_zero {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (i : Fin clock.m)
    (hrow : ∀ d : Fin w, L_C i d = 0) (j : Fin (w + 1)) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C
      (finSumFinEquiv (Sum.inl i)) (finSumFinEquiv (Sum.inl j)) =
    - c_P0 * a_old (finSumFinEquiv (Sum.inl i)) := by
  rw [P_admissible_scaled_inl_eq_L_X_mul_Q_reset_sub_proj, a_old_proj_inl_eq_of_row_zero clock a_old L_C i hrow]
  have hsum : (L_X_gateway L_C *
      (Q_reset (J_admissible_scaled clock b H0 ch delta c_zeta) (M_coupled w) (B_mat (w + 1))
        (zeta_admissible_scaled clock b H0 ch delta c_zeta)).transpose)
      (finSumFinEquiv (Sum.inl i)) (finSumFinEquiv (Sum.inl j)) = 0 := by
    simp only [Matrix.mul_apply]
    apply Finset.sum_eq_zero
    intro c _
    rw [L_X_gateway_inl_eq_zero_of_row_zero L_C i hrow c, zero_mul]
  rw [hsum, zero_sub]
  ring

/-- `L_C_admissible_scaled_next` vanishes on all old actions `Sum.inl y` of the lifted clock. -/
theorem L_C_admissible_scaled_next_inl_eq_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (y : Fin (clock.m + 1)) (c : Fin (w + 1)) :
    L_C_admissible_scaled_next hw clock b H0 ch delta c_zeta c_P0 a_old L_C hLC
      (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)) (Sum.inl y)) c = 0 := by
  simp only [L_C_admissible_scaled_next, Matrix.of_apply, Equiv.symm_apply_apply]

/-- `L_C_admissible_scaled_next` vanishes on all early reset actions `Sum.inr (inl j)` of the lifted clock. -/
theorem L_C_admissible_scaled_next_inr_inl_eq_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (j : Fin (w + 1)) (c : Fin (w + 1)) :
    L_C_admissible_scaled_next hw clock b H0 ch delta c_zeta c_P0 a_old L_C hLC
      (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)) (Sum.inr (finSumFinEquiv (Sum.inl j)))) c = 0 := by
  simp only [L_C_admissible_scaled_next, Matrix.of_apply, Equiv.symm_apply_apply, R_M_coupled_inl_eq_zero]

/-- `L_C_admissible_scaled_next` on late reset actions `Sum.inr (inr j)` equals `W_coupled_inv w c j`. -/
theorem L_C_admissible_scaled_next_inr_inr_eq {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (j : Fin (w + 1)) (c : Fin (w + 1)) :
    L_C_admissible_scaled_next hw clock b H0 ch delta c_zeta c_P0 a_old L_C hLC
      (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)) (Sum.inr (finSumFinEquiv (Sum.inr j)))) c =
    W_coupled_inv w c j := by
  simp only [L_C_admissible_scaled_next, Matrix.of_apply, Equiv.symm_apply_apply, R_M_coupled_inr_eq]

/-- If a property `P : α → ℚ → Prop` holds for `(W1[k], wordScore G s0 (W1.take k) W1[k])` for all `k < W1.length`
    and for `(W2[k], wordScore G (wordScore G s0 W1) (W2.take k) W2[k])` for all `k < W2.length`,
    then it holds for `((W1 ++ W2)[k], wordScore G s0 ((W1 ++ W2).take k) (W1 ++ W2)[k])` for all `k < (W1 ++ W2).length`. -/
theorem wordScore_append_take_forall {α : Type*} [Fintype α] [DecidableEq α]
    (G : Matrix α α ℚ) (s0 : α → ℚ) (W1 W2 : List α) (P : α → ℚ → Prop)
    (h1 : ∀ (k : ℕ) (hk : k < W1.length), P W1[k] (wordScore G s0 (W1.take k) W1[k]))
    (h2 : ∀ (k : ℕ) (hk : k < W2.length), P W2[k] (wordScore G (wordScore G s0 W1) (W2.take k) W2[k])) :
    ∀ (k : ℕ) (hk : k < (W1 ++ W2).length),
      P (W1 ++ W2)[k] (wordScore G s0 ((W1 ++ W2).take k) (W1 ++ W2)[k]) := by
  intro k hk
  rw [List.length_append] at hk
  by_cases hk1 : k < W1.length
  · have htake : (W1 ++ W2).take k = W1.take k :=
      List.take_append_of_le_length (le_of_lt hk1)
    have hget : (W1 ++ W2)[k] = W1[k] := List.getElem_append_left hk1
    rw [htake, hget]
    exact h1 k hk1
  · have hle : W1.length ≤ k := le_of_not_gt hk1
    have hk2 : k - W1.length < W2.length := by omega
    have htake : (W1 ++ W2).take k = W1 ++ W2.take (k - W1.length) := by
      rw [List.take_append, List.take_of_length_le hle]
    have hget : (W1 ++ W2)[k] = W2[k - W1.length] := List.getElem_append_right hle
    rw [htake, hget, wordScore_append]
    exact h2 (k - W1.length) hk2

/-- **Subphase Reduction for Stage 3 Bundle Active Score (`wordScore_shiftRightCount_W_bundle_word_take_forall`)**:
    To prove a property `P act score` at every step `k < (W_bundle_word parentWord (q + 1)).length`,
    it suffices to prove `P act (wordScore clock.G (clock.R.mulVec (binomBasis w idx)) ((parentWord idx).take k) act + ∑ σ ∈ Finset.range q, (clock.R.mulVec (binomBasis w (σ + 1))) act)`
    for every subphase `idx < q + 1` and every `k < (parentWord idx).length` with `act = (parentWord idx)[k]`. -/
theorem wordScore_shiftRightCount_W_bundle_word_take_forall {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (q : ℕ) (P : Fin clock.m → ℚ → Prop)
    (h_subphase : ∀ (idx : ℕ) (_ : idx < q + 1) (k : ℕ) (hk : k < (parentWord idx).length),
      let act := (parentWord idx)[k]
      P act (wordScore clock.G (clock.R.mulVec (binomBasis w idx)) ((parentWord idx).take k) act +
        ∑ σ ∈ Finset.range q, (clock.R.mulVec (binomBasis w (σ + 1))) act)) :
    ∀ (k : ℕ) (hk : k < (W_bundle_word parentWord (q + 1)).length),
      let W_p := W_bundle_word parentWord (q + 1)
      P W_p[k] (wordScore clock.G ((shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)))
        (W_p.take k) W_p[k]) := by
  have h_ind : ∀ K ≤ q + 1,
      ∀ (k : ℕ) (hk : k < (W_bundle_word parentWord K).length),
        P (W_bundle_word parentWord K)[k]
          (wordScore clock.G ((shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)))
            ((W_bundle_word parentWord K).take k) (W_bundle_word parentWord K)[k]) := by
    intro K
    induction K with
    | zero =>
      intro _ k hk
      simp [W_bundle_word] at hk
    | succ K ih =>
      intro hK
      have hflat : W_bundle_word parentWord (K + 1) =
          W_bundle_word parentWord K ++ parentWord K := by
        unfold W_bundle_word
        rw [@List.range_succ K, List.flatMap_append]
        simp
      intro k hk
      have hk_app : k < (W_bundle_word parentWord K ++ parentWord K).length := by
        rw [← hflat]
        exact hk
      have h_app := wordScore_append_take_forall clock.G
        ((shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)))
        (W_bundle_word parentWord K) (parentWord K) P (ih (by omega))
        (fun k' hk' => by
          have hws : wordScore clock.G
              ((shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)))
              (W_bundle_word parentWord K) =
              fun i => (clock.R.mulVec (binomBasis w K)) i +
                ∑ σ ∈ Finset.range q, (clock.R.mulVec (binomBasis w (σ + 1))) i := by
            ext i
            exact wordScore_shiftRightCount_W_bundle_word_succ clock parentWord hparent_count q K i
          rw [hws, wordScore_add_bias]
          exact h_subphase K (by omega) k' hk')
        k hk_app
      simpa only [hflat] using h_app
  exact h_ind (q + 1) le_rfl

/-- **Stage 3 Bundle Score-Gap Domination from Subphase Score-Gap Bounds (`stage3_bundle_score_gap_lt_of_subphase`)**:
    If for every subphase `idx < q + 1` and step `k < (parentWord idx).length` with `act = (parentWord idx)[k]`,
    `(∑ σ ∈ Finset.range q, ((clock.R.mulVec (binomBasis w (σ + 1))) b - (clock.R.mulVec (binomBasis w (σ + 1))) act)) + ((clock.R.mulVec (binomBasis w (q + 1))) b - wordScore clock.G (clock.R.mulVec (binomBasis w idx)) ((parentWord idx).take k) act) < B`,
    then for every `k < (W_bundle_word parentWord (q + 1)).length` with `W_p = W_bundle_word parentWord (q + 1)`,
    `(∑ σ ∈ Finset.range (q + 1), (clock.R.mulVec (binomBasis w (σ + 1))) b) - wordScore clock.G ((shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1))) (W_p.take k) W_p[k] < B`. -/
theorem stage3_bundle_score_gap_lt_of_subphase {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (q : ℕ) (B : ℚ)
    (h_subphase : ∀ (idx : ℕ) (_ : idx < q + 1) (k : ℕ) (hk : k < (parentWord idx).length),
      let act := (parentWord idx)[k]
      (∑ σ ∈ Finset.range q,
        ((clock.R.mulVec (binomBasis w (σ + 1))) b - (clock.R.mulVec (binomBasis w (σ + 1))) act)) +
      ((clock.R.mulVec (binomBasis w (q + 1))) b -
        wordScore clock.G (clock.R.mulVec (binomBasis w idx)) ((parentWord idx).take k) act) < B) :
    ∀ (k : ℕ) (hk : k < (W_bundle_word parentWord (q + 1)).length),
      let W_p := W_bundle_word parentWord (q + 1)
      (∑ σ ∈ Finset.range (q + 1), (clock.R.mulVec (binomBasis w (σ + 1))) b) -
        wordScore clock.G ((shiftRightCount clock.R).mulVec (binomBasis (w + 1) (q + 1)))
          (W_p.take k) W_p[k] < B := by
  refine wordScore_shiftRightCount_W_bundle_word_take_forall clock parentWord hparent_count q
    (fun _ score => (∑ σ ∈ Finset.range (q + 1), (clock.R.mulVec (binomBasis w (σ + 1))) b) - score < B) ?_
  intro idx hidx k hk
  have hsub := h_subphase idx hidx k hk
  dsimp only at hsub ⊢
  rw [Finset.sum_sub_distrib] at hsub
  have hsplit := Finset.sum_range_succ (fun σ => (clock.R.mulVec (binomBasis w (σ + 1))) b) q
  linarith

/-- **Sharpened Stage 2 Reset Priority Validity for Scaled Admissible Lift**:
    Reduces full priority validity of `W_late_word` to the sharpened old-action
    waiting condition with `- P_admissible_scaled ... (inr w)` on the LHS. -/
theorem admissible_stage2_priority_valid_of_start_sharp {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (parent_rank : Fin clock.m → Fin clock.m)
    (hbase_le_cz : canonicalCZeta_admissible clock b H0 ch delta ≤ c_zeta)
    (hP_late_nonneg : ∀ (j : Fin (w + 1)) (x : Fin (clock.m + 1)),
      0 ≤ P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C x (finSumFinEquiv (Sum.inr j)))
    (q : ℕ)
    (h_old_wait : ∀ x : Fin (clock.m + 1),
      wordScore (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
        ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
          (J_admissible_scaled clock b H0 ch delta c_zeta)
          (S_admissible clock b H0 ch delta)
          (X_gateway clock) (M_coupled w)
          (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q))
        (W_early_word clock.m w q ++ W_late_word clock.m w q) (Sum.inl x) -
        P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C x (finSumFinEquiv (Sum.inr ⟨w, Nat.lt_succ_self w⟩)) <
        dotProduct (zeta_admissible_scaled clock b H0 ch delta c_zeta) (binomBasis (w + 1) q)) :
    IsValidPriorityWord
      (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
        (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
        (J_admissible_scaled clock b H0 ch delta c_zeta))
      (wordScore
        (liftedGameMat (AdjoinLeaderEndpointG clock.G b clock.v)
          (P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C)
          (J_admissible_scaled clock b H0 ch delta c_zeta))
        ((liftedScoreMat (AdjoinLeaderEndpointG clock.G b clock.v)
          (J_admissible_scaled clock b H0 ch delta c_zeta)
          (S_admissible clock b H0 ch delta)
          (X_gateway clock) (M_coupled w)
          (zeta_admissible_scaled clock b H0 ch delta c_zeta)).mulVec (binomBasis (w + 1) q))
        (W_early_word clock.m w q))
      (paperPriorityRank clock.m w parent_rank)
      (W_late_word clock.m w q) := by
  apply isValidPriorityWord_W_late_word_of_end_sharp
  · intro a b_idx hab
    exact J_admissible_scaled_lower clock b H0 ch delta c_zeta a b_idx hab
  · intro a b_idx hab
    have hbase := (J_admissible_scaled_canonicalCZeta_subdiag_pos clock b H0 ch delta a b_idx hab).2
    have hJ := (J_coupled_subdiag_ge w a b_idx hab).2
    have hsplit : J_admissible_scaled clock b H0 ch delta c_zeta a b_idx =
        J_admissible_scaled clock b H0 ch delta (canonicalCZeta_admissible clock b H0 ch delta) a b_idx +
          (c_zeta - canonicalCZeta_admissible clock b H0 ch delta) * J_coupled w a b_idx := by
      dsimp only [J_admissible_scaled]
      simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
      ring
    rw [hsplit]
    have h_nonneg : 0 ≤ (c_zeta - canonicalCZeta_admissible clock b H0 ch delta) * J_coupled w a b_idx :=
      mul_nonneg (by linarith) (le_of_lt hJ)
    linarith
  · exact hP_late_nonneg
  · exact h_old_wait

/-! ### Part 1: W_zeta, M_zeta, and Universal Column Sum -/

open Matrix

theorem sum_V0_coupled_col (w : ℕ) (j : Fin (w + 1)) :
    ∑ i : Fin (w + 1), V0_coupled w i j = 0 := by
  dsimp [V0_coupled, E_last]
  simp only [Matrix.one_apply]
  rw [Finset.sum_sub_distrib, Finset.sum_ite_eq', Finset.sum_ite_eq']
  simp

def W_zeta (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  fun i j => 2 * zeta_0 j + V0_coupled w i j

theorem vecMul_one_W_zeta (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) (j : Fin (w + 1)) :
    (vecMul (fun _ : Fin (w + 1) => (1 : ℚ)) (W_zeta w zeta_0)) j = 2 * (w + 1 : ℚ) * zeta_0 j := by
  dsimp [vecMul, dotProduct, W_zeta]
  simp_rw [one_mul, Finset.sum_add_distrib]
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  rw [sum_V0_coupled_col, add_zero]
  push_cast
  ring

def M_zeta (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) :
    Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ :=
  Matrix.of fun r c =>
    match finSumFinEquiv.symm r with
    | Sum.inl i => W_zeta w zeta_0 i c
    | Sum.inr i => W_zeta w zeta_0 i c

theorem vecMul_const_M_zeta (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) (c_R : ℚ) (c : Fin (w + 1)) :
    (vecMul (fun _ => c_R / (4 * (w + 1 : ℚ))) (M_zeta w zeta_0)) c = c_R * zeta_0 c := by
  dsimp [vecMul, dotProduct, M_zeta]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      c_R / (4 * (w + 1 : ℚ)) *
        (match finSumFinEquiv.symm r with
        | Sum.inl i => W_zeta w zeta_0 i c
        | Sum.inr i => W_zeta w zeta_0 i c)).symm
  rw [hcomp, Fintype.sum_sum_type]
  simp only [Equiv.symm_apply_apply]
  simp_rw [← Finset.mul_sum]
  have hW : (∑ i : Fin (w + 1), W_zeta w zeta_0 i c) = 2 * (w + 1 : ℚ) * zeta_0 c := by
    have h1 := vecMul_one_W_zeta w zeta_0 c
    dsimp [vecMul, dotProduct] at h1
    simp_rw [one_mul] at h1
    exact h1
  rw [hW]
  have hw : (w + 1 : ℚ) ≠ 0 := by positivity
  field_simp [hw]
  ring

theorem a_reset_pos (w : ℕ) (c_R : ℚ) (hc_R : 0 < c_R) (_ : Fin ((w + 1) + (w + 1))) :
    0 < c_R / (4 * (w + 1 : ℚ)) := by
  have hw : (0 : ℚ) < 4 * (w + 1 : ℚ) := by positivity
  exact div_pos hc_R hw

/-! ### Part 2: Two-Sided Inverse of (1 + B_mat w) -/

theorem one_add_B_mul_one_add_N (w : ℕ) :
    (1 + B_mat w) * (1 + N_mat w) = (2 : ℚ) • 1 + N_mat w := by
  rw [add_mul, Matrix.one_mul, B_mat_mul_one_add_N]
  ext i j
  simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
  ring

def two_add_N_inv (w : ℕ) : Matrix (Fin w) (Fin w) ℚ :=
  Matrix.of fun i j =>
    if j.val ≤ i.val then (-1 : ℚ) ^ (i.val - j.val) / (2 : ℚ) ^ (i.val - j.val + 1) else 0

theorem two_add_N_mul_inv (w : ℕ) :
    ((2 : ℚ) • 1 + N_mat w) * two_add_N_inv w = 1 := by
  rw [add_mul, smul_mul, Matrix.one_mul]
  ext i j
  simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
  rw [N_mat_mul_apply]
  dsimp [two_add_N_inv]
  by_cases hij : i = j
  · subst hij
    simp only [le_refl, Nat.sub_self, pow_zero]
    by_cases hi : 0 < i.val
    · have hnot : ¬ (i.val ≤ i.val - 1) := by omega
      simp [hi, hnot]
    · simp [hi]
  · have hne : ¬ (i.val = j.val) := fun h => hij (Fin.ext h)
    simp only [hij, if_false]
    by_cases hle : j.val ≤ i.val
    · have hlt : j.val < i.val := lt_of_le_of_ne hle (Ne.symm hne)
      have hpos : 0 < i.val := by omega
      have hle_prev : j.val ≤ i.val - 1 := by omega
      simp only [hle, if_true, hpos, hle_prev]
      have hexp : i.val - j.val = (i.val - 1 - j.val) + 1 := by omega
      rw [hexp, pow_succ]
      have hpow : (2 : ℚ) ^ ((i.val - 1 - j.val) + 1 + 1) = (2 : ℚ) * (2 : ℚ) ^ ((i.val - 1 - j.val) + 1) := by
        rw [pow_succ]
        ring
      rw [hpow]
      ring
    · have hnot : ¬ (j.val ≤ i.val) := hle
      have h_lt_prev : ¬ (j.val ≤ i.val - 1) := by omega
      by_cases hpos : 0 < i.val
      · simp [hnot, hpos, h_lt_prev]
      · simp [hnot, hpos]

def one_add_B_mat_inv (w : ℕ) : Matrix (Fin w) (Fin w) ℚ :=
  (1 + N_mat w) * two_add_N_inv w

theorem one_add_B_mat_mul_inv (w : ℕ) :
    (1 + B_mat w) * one_add_B_mat_inv w = 1 := by
  dsimp [one_add_B_mat_inv]
  rw [← Matrix.mul_assoc, one_add_B_mul_one_add_N, two_add_N_mul_inv]

theorem one_add_B_mat_inv_mul (w : ℕ) :
    one_add_B_mat_inv w * (1 + B_mat w) = 1 := by
  rw [mul_eq_one_comm]
  exact one_add_B_mat_mul_inv w

theorem vecMul_vecMul_one_add_B_mat_inv (w : ℕ) (zeta : Fin w → ℚ) :
    vecMul (vecMul zeta (one_add_B_mat_inv w)) (1 + B_mat w) = zeta := by
  rw [Matrix.vecMul_vecMul, one_add_B_mat_inv_mul, Matrix.vecMul_one]

/-! ### Part 3: Tail Modification and Extension -/

def tail_zeta (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) (c_R : ℚ) : Fin (w + 1) → ℚ :=
  zeta_0 + c_R • vecMul zeta_0 (one_add_B_mat_inv (w + 1))

theorem vecMul_tail_zeta_one_add_B (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) (c_R : ℚ) :
    vecMul (tail_zeta w zeta_0 c_R) (1 + B_mat (w + 1)) =
      vecMul zeta_0 (1 + B_mat (w + 1)) + c_R • zeta_0 := by
  dsimp [tail_zeta]
  rw [Matrix.add_vecMul, Matrix.smul_vecMul, vecMul_vecMul_one_add_B_mat_inv]

theorem tail_zeta_pos_of_bound (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) (c_R : ℚ)
    (h_pos : ∀ j, 0 < zeta_0 j)
    (hc_bound : ∀ j, c_R * |vecMul zeta_0 (one_add_B_mat_inv (w + 1)) j| ≤ (1 / 2) * zeta_0 j)
    (hc_nonneg : 0 ≤ c_R) (j : Fin (w + 1)) :
    0 < tail_zeta w zeta_0 c_R j := by
  dsimp [tail_zeta]
  change 0 < zeta_0 j + c_R * vecMul zeta_0 (one_add_B_mat_inv (w + 1)) j
  have h_le := hc_bound j
  have h1 : - |vecMul zeta_0 (one_add_B_mat_inv (w + 1)) j| ≤ vecMul zeta_0 (one_add_B_mat_inv (w + 1)) j :=
    neg_le_of_abs_le (le_refl _)
  have h_abs : -(c_R * |vecMul zeta_0 (one_add_B_mat_inv (w + 1)) j|) ≤ c_R * vecMul zeta_0 (one_add_B_mat_inv (w + 1)) j := by
    nlinarith
  have hz := h_pos j
  linarith

theorem one_add_B_mat_succ (w : ℕ) (i j : Fin (w + 1)) :
    (1 + B_mat (w + 2)) i.succ j.succ = (1 + B_mat (w + 1)) i j := by
  simp only [Matrix.add_apply, Matrix.one_apply, B_mat, Matrix.of_apply]
  have h_eq : (i.succ = j.succ) ↔ (i = j) := Fin.succ_inj
  rw [if_congr h_eq rfl rfl]
  have h_le : (j.succ.val ≤ i.succ.val) ↔ (j.val ≤ i.val) := by
    simp only [Fin.val_succ]
    omega
  have h_sub : i.succ.val - j.succ.val = i.val - j.val := by
    simp only [Fin.val_succ]
    omega
  rw [if_congr h_le rfl rfl, h_sub]

theorem one_add_B_mat_zero_succ (w : ℕ) (j : Fin (w + 1)) :
    (1 + B_mat (w + 2)) 0 j.succ = 0 := by
  simp only [Matrix.add_apply, Matrix.one_apply, B_mat, Matrix.of_apply]
  have hne : ¬((0 : Fin (w + 2)) = j.succ) := Ne.symm (Fin.succ_ne_zero j)
  have hnot : ¬(j.succ.val ≤ (0 : Fin (w + 2)).val) := by
    simp only [Fin.val_succ, Fin.val_zero]
    omega
  simp only [hne, if_false, hnot, add_zero]

def extend_tail {w : ℕ} (z0 : ℚ) (tail : Fin (w + 1) → ℚ) : Fin (w + 2) → ℚ :=
  Fin.cases z0 tail

theorem vecMul_extend_tail_one_add_B_mat_succ {w : ℕ} (z0 : ℚ) (tail : Fin (w + 1) → ℚ) (j : Fin (w + 1)) :
    (vecMul (extend_tail z0 tail) (1 + B_mat (w + 2))) j.succ =
    (vecMul tail (1 + B_mat (w + 1))) j := by
  dsimp [vecMul, dotProduct]
  rw [Fin.sum_univ_succ]
  simp only [extend_tail, Fin.cases_zero, Fin.cases_succ]
  have h0 : (1 + B_mat (w + 2)) 0 j.succ = 0 := one_add_B_mat_zero_succ w j
  rw [Matrix.add_apply] at h0
  rw [h0, mul_zero, zero_add]
  apply Finset.sum_congr rfl
  intro i _
  have hsucc : (1 + B_mat (w + 2)) i.succ j.succ = (1 + B_mat (w + 1)) i j :=
    one_add_B_mat_succ w i j
  rw [Matrix.add_apply] at hsucc
  rw [hsucc, Matrix.add_apply]

def zeta_next {w : ℕ} (z0 : ℚ) (zeta_0 : Fin (w + 1) → ℚ) (c_R : ℚ) : Fin (w + 2) → ℚ :=
  extend_tail z0 (tail_zeta w zeta_0 c_R)

theorem zeta_next_pos {w : ℕ} (z0 : ℚ) (zeta_0 : Fin (w + 1) → ℚ) (c_R : ℚ)
    (hz0 : 0 < z0)
    (htail : ∀ j, 0 < tail_zeta w zeta_0 c_R j) (k : Fin (w + 2)) :
    0 < zeta_next z0 zeta_0 c_R k := by
  dsimp [zeta_next, extend_tail]
  cases k using Fin.cases with
  | zero => exact hz0
  | succ j => exact htail j

/-! ### Part 4: Inductive Count Tables and Exact Cone Matching -/

def C_lift (w m : ℕ) (X : Matrix (Fin (m + 1)) (Fin (w + 1)) ℚ)
    (M : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ) :
    Matrix (Fin ((m + 1) + ((w + 1) + (w + 1)))) (Fin (w + 1)) ℚ :=
  Matrix.of fun y c =>
    match finSumFinEquiv.symm y with
    | Sum.inl i => X i c
    | Sum.inr r => M r c

def X_lift (w m : ℕ) (X : Matrix (Fin (m + 1)) (Fin (w + 1)) ℚ)
    (M : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ) :
    Matrix (Fin (((m + 1) + ((w + 1) + (w + 1))) + 1)) (Fin (w + 2)) ℚ :=
  Matrix.of fun x c =>
    match finSumFinEquiv.symm x with
    | Sum.inl y => shiftRightCount (C_lift w m X M) y c
    | Sum.inr _ => e0_row (w + 2) c

theorem hshift_proof (w m : ℕ) (X : Matrix (Fin (m + 1)) (Fin (w + 1)) ℚ)
    (M : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ)
    (j : Fin (w + 1)) (y : Fin ((m + 1) + ((w + 1) + (w + 1)))) :
    X_lift w m X M (finSumFinEquiv (Sum.inl y)) j.succ = C_lift w m X M y j := by
  simp only [X_lift, Matrix.of_apply, Equiv.symm_apply_apply, shiftRightCount]
  simp

def a_old_next (m w : ℕ) (a_old : Fin (m + 1) → ℚ) (c_R a_g : ℚ) :
    Fin (((m + 1) + ((w + 1) + (w + 1))) + 1) → ℚ :=
  fun x =>
    match finSumFinEquiv.symm x with
    | Sum.inl y =>
      match finSumFinEquiv.symm y with
      | Sum.inl i => a_old i
      | Sum.inr _ => c_R / (4 * (w + 1 : ℚ))
    | Sum.inr _ => a_g

theorem a_old_next_pos (m w : ℕ) (a_old : Fin (m + 1) → ℚ) (c_R a_g : ℚ)
    (ha_old : ∀ i, 0 < a_old i) (hc_R : 0 < c_R) (ha_g : 0 < a_g)
    (x : Fin (((m + 1) + ((w + 1) + (w + 1))) + 1)) :
    0 < a_old_next m w a_old c_R a_g x := by
  dsimp [a_old_next]
  split
  · split
    · exact ha_old _
    · have hw : (0 : ℚ) < 4 * (w + 1 : ℚ) := by positivity
      exact div_pos hc_R hw
  · exact ha_g

theorem vecMul_a_old_next_X_lift_zero (m w : ℕ) (a_old : Fin (m + 1) → ℚ)
    (X : Matrix (Fin (m + 1)) (Fin (w + 1)) ℚ)
    (M : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ) (c_R a_g : ℚ) :
    (vecMul (a_old_next m w a_old c_R a_g) (X_lift w m X M)) 0 = a_g := by
  dsimp [vecMul, dotProduct]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun x =>
      a_old_next m w a_old c_R a_g x * X_lift w m X M x 0).symm
  rw [hcomp, Fintype.sum_sum_type]
  have h_inl : (∑ y : Fin ((m + 1) + ((w + 1) + (w + 1))),
      a_old_next m w a_old c_R a_g (finSumFinEquiv (Sum.inl y)) *
      X_lift w m X M (finSumFinEquiv (Sum.inl y)) 0) = 0 := by
    apply Finset.sum_eq_zero
    intro y _
    simp only [X_lift, Matrix.of_apply, Equiv.symm_apply_apply]
    dsimp [shiftRightCount]
    simp
  have h_inr : (∑ g : Fin 1,
      a_old_next m w a_old c_R a_g (finSumFinEquiv (Sum.inr g)) *
      X_lift w m X M (finSumFinEquiv (Sum.inr g)) 0) = a_g := by
    rw [Fin.sum_univ_one]
    simp only [X_lift, a_old_next, Matrix.of_apply, Equiv.symm_apply_apply]
    simp [e0_row]
  rw [h_inl, zero_add, h_inr]

theorem vecMul_a_old_next_X_lift_succ (m w : ℕ) (a_old : Fin (m + 1) → ℚ)
    (X : Matrix (Fin (m + 1)) (Fin (w + 1)) ℚ)
    (zeta_0 : Fin (w + 1) → ℚ) (c_R a_g z0 : ℚ)
    (hX : vecMul a_old X = vecMul zeta_0 (1 + B_mat (w + 1)))
    (j : Fin (w + 1)) :
    (vecMul (a_old_next m w a_old c_R a_g) (X_lift w m X (M_zeta w zeta_0))) j.succ =
      (vecMul (zeta_next z0 zeta_0 c_R) (1 + B_mat (w + 2))) j.succ := by
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun x =>
      a_old_next m w a_old c_R a_g x * X_lift w m X (M_zeta w zeta_0) x j.succ).symm
  have he0 : e0_row (w + 2) j.succ = 0 := by
    simp only [e0_row]
    have hne : ¬ (j.succ.val = 0) := by
      simp only [Fin.val_succ]
      omega
    simp
  have h_inr : (∑ g : Fin 1,
      a_old_next m w a_old c_R a_g (finSumFinEquiv (Sum.inr g)) *
      X_lift w m X (M_zeta w zeta_0) (finSumFinEquiv (Sum.inr g)) j.succ) = 0 := by
    rw [Fin.sum_univ_one]
    simp only [X_lift, Matrix.of_apply, Equiv.symm_apply_apply, he0, mul_zero]
  have hcomp2 :=
    (Equiv.sum_comp finSumFinEquiv fun y =>
      a_old_next m w a_old c_R a_g (finSumFinEquiv (Sum.inl y)) *
      C_lift w m X (M_zeta w zeta_0) y j).symm
  have hC_inl : ∀ i : Fin (m + 1),
      C_lift w m X (M_zeta w zeta_0) (finSumFinEquiv (Sum.inl i)) j = X i j := by
    intro i
    simp only [C_lift, Matrix.of_apply, Equiv.symm_apply_apply]
  have hC_inr : ∀ r : Fin ((w + 1) + (w + 1)),
      C_lift w m X (M_zeta w zeta_0) (finSumFinEquiv (Sum.inr r)) j = M_zeta w zeta_0 r j := by
    intro r
    simp only [C_lift, Matrix.of_apply, Equiv.symm_apply_apply]
  have ha_inl : ∀ i : Fin (m + 1),
      a_old_next m w a_old c_R a_g (finSumFinEquiv (Sum.inl (finSumFinEquiv (Sum.inl i)))) = a_old i := by
    intro i
    simp only [a_old_next, Equiv.symm_apply_apply]
  have ha_inr : ∀ r : Fin ((w + 1) + (w + 1)),
      a_old_next m w a_old c_R a_g (finSumFinEquiv (Sum.inl (finSumFinEquiv (Sum.inr r)))) =
        c_R / (4 * (w + 1 : ℚ)) := by
    intro r
    simp only [a_old_next, Equiv.symm_apply_apply]
  have h_a_old_X : (∑ i : Fin (m + 1), a_old i * X i j) = (vecMul a_old X) j := rfl
  have h_M_zeta : (∑ r : Fin ((w + 1) + (w + 1)), c_R / (4 * (w + 1 : ℚ)) * M_zeta w zeta_0 r j) =
      (vecMul (fun _ => c_R / (4 * (w + 1 : ℚ))) (M_zeta w zeta_0)) j := rfl
  dsimp [vecMul, dotProduct]
  rw [hcomp, Fintype.sum_sum_type, h_inr, add_zero]
  have hshift : ∀ y : Fin ((m + 1) + ((w + 1) + (w + 1))),
      X_lift w m X (M_zeta w zeta_0) (finSumFinEquiv (Sum.inl y)) j.succ =
        C_lift w m X (M_zeta w zeta_0) y j :=
    fun y => hshift_proof w m X (M_zeta w zeta_0) j y
  simp_rw [hshift]
  rw [hcomp2, Fintype.sum_sum_type]
  simp_rw [ha_inl, ha_inr, hC_inl, hC_inr]
  rw [h_a_old_X, h_M_zeta, vecMul_const_M_zeta, hX]
  have h_tail := congr_fun (vecMul_tail_zeta_one_add_B w zeta_0 c_R) j
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at h_tail
  rw [← h_tail]
  have h_ext := vecMul_extend_tail_one_add_B_mat_succ z0 (tail_zeta w zeta_0 c_R) j
  dsimp [zeta_next, vecMul, dotProduct] at h_ext ⊢
  exact h_ext.symm

/-- **Full Exact Cone-Matching Induction Theorem**:
    With `a_g := (vecMul (zeta_next z0 zeta_0 c_R) (1 + B_mat (w + 2))) 0`,
    `vecMul (a_old_next m w a_old c_R a_g) (X_lift w m X (M_zeta w zeta_0)) = vecMul (zeta_next z0 zeta_0 c_R) (1 + B_mat (w + 2))`
    identically across ALL columns. -/
theorem vecMul_a_old_next_X_lift_eq (m w : ℕ) (a_old : Fin (m + 1) → ℚ)
    (X : Matrix (Fin (m + 1)) (Fin (w + 1)) ℚ)
    (zeta_0 : Fin (w + 1) → ℚ) (c_R z0 : ℚ)
    (hX : vecMul a_old X = vecMul zeta_0 (1 + B_mat (w + 1))) :
    let a_g := (vecMul (zeta_next z0 zeta_0 c_R) (1 + B_mat (w + 2))) 0
    vecMul (a_old_next m w a_old c_R a_g) (X_lift w m X (M_zeta w zeta_0)) =
      vecMul (zeta_next z0 zeta_0 c_R) (1 + B_mat (w + 2)) := by
  intro a_g
  ext c
  cases c using Fin.cases with
  | zero =>
    have hz := vecMul_a_old_next_X_lift_zero m w a_old X (M_zeta w zeta_0) c_R a_g
    dsimp [a_g] at hz ⊢
    rw [hz]
  | succ j =>
    have hs := vecMul_a_old_next_X_lift_succ m w a_old X zeta_0 c_R a_g z0 hX j
    exact hs

/-!
## Cross-Coupling Constant Matrix `J_cross_const` and Exact Cone-Matching

We define `J_cross_const w` with entry `(w + 1)⁻¹` on the lower-left block `(Sum.inr i, Sum.inl j)`
and `0` elsewhere, satisfying `J M = (0, 2 * zeta_0)` and `Jᵀ M = (2 * zeta_0, 0)`.
This produces `Q_reset = ∓ vecMul zeta_0 (1 + B_{w+1})`, matching `P0_coneᵀ * X` identically
under `vecMul a_old X = vecMul zeta_0 (1 + B_{w+1})`.
-/

def J_cross_const (w : ℕ) : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ :=
  Matrix.of fun r c =>
    match finSumFinEquiv.symm r, finSumFinEquiv.symm c with
    | Sum.inr _, Sum.inl _ => ((w + 1 : ℚ))⁻¹
    | _, _ => 0

theorem J_cross_const_inl (w : ℕ) (i : Fin (w + 1)) (k : Fin ((w + 1) + (w + 1))) :
    J_cross_const w (finSumFinEquiv (Sum.inl i)) k = 0 := by
  simp only [J_cross_const, Matrix.of_apply, Equiv.symm_apply_apply]

theorem J_cross_const_inr_inl (w : ℕ) (i j : Fin (w + 1)) :
    J_cross_const w (finSumFinEquiv (Sum.inr i)) (finSumFinEquiv (Sum.inl j)) = ((w + 1 : ℚ))⁻¹ := by
  simp only [J_cross_const, Matrix.of_apply, Equiv.symm_apply_apply]

theorem J_cross_const_inr_inr (w : ℕ) (i j : Fin (w + 1)) :
    J_cross_const w (finSumFinEquiv (Sum.inr i)) (finSumFinEquiv (Sum.inr j)) = 0 := by
  simp only [J_cross_const, Matrix.of_apply, Equiv.symm_apply_apply]

theorem JM_cross_const_inl (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) (i : Fin (w + 1)) (c : Fin (w + 1)) :
    (J_cross_const w * M_zeta w zeta_0) (finSumFinEquiv (Sum.inl i)) c = 0 := by
  simp only [Matrix.mul_apply]
  simp_rw [J_cross_const_inl, zero_mul, Finset.sum_const_zero]

theorem JM_cross_const_inr (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) (i : Fin (w + 1)) (c : Fin (w + 1)) :
    (J_cross_const w * M_zeta w zeta_0) (finSumFinEquiv (Sum.inr i)) c = 2 * zeta_0 c := by
  simp only [Matrix.mul_apply]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun k : Fin ((w + 1) + (w + 1)) =>
      J_cross_const w (finSumFinEquiv (Sum.inr i)) k * M_zeta w zeta_0 k c).symm
  rw [hcomp, Fintype.sum_sum_type]
  have h_inr : (∑ x : Fin (w + 1), J_cross_const w (finSumFinEquiv (Sum.inr i)) (finSumFinEquiv (Sum.inr x)) *
      M_zeta w zeta_0 (finSumFinEquiv (Sum.inr x)) c) = 0 := by
    simp_rw [J_cross_const_inr_inr, zero_mul, Finset.sum_const_zero]
  rw [h_inr, add_zero]
  simp_rw [J_cross_const_inr_inl]
  have hM : ∀ x : Fin (w + 1), M_zeta w zeta_0 (finSumFinEquiv (Sum.inl x)) c = W_zeta w zeta_0 x c := by
    intro x
    simp only [M_zeta, Matrix.of_apply, Equiv.symm_apply_apply]
  simp_rw [hM, ← Finset.mul_sum]
  have hW : (∑ x : Fin (w + 1), W_zeta w zeta_0 x c) = 2 * (w + 1 : ℚ) * zeta_0 c := by
    have h1 := vecMul_one_W_zeta w zeta_0 c
    dsimp [vecMul, dotProduct] at h1
    simp_rw [one_mul] at h1
    exact h1
  rw [hW]
  have hw : (w + 1 : ℚ) ≠ 0 := by positivity
  field_simp [hw]

theorem JTM_cross_const_inl (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) (i : Fin (w + 1)) (c : Fin (w + 1)) :
    ((J_cross_const w).transpose * M_zeta w zeta_0) (finSumFinEquiv (Sum.inl i)) c = 2 * zeta_0 c := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun k : Fin ((w + 1) + (w + 1)) =>
      J_cross_const w k (finSumFinEquiv (Sum.inl i)) * M_zeta w zeta_0 k c).symm
  rw [hcomp, Fintype.sum_sum_type]
  have h_inl : (∑ x : Fin (w + 1), J_cross_const w (finSumFinEquiv (Sum.inl x)) (finSumFinEquiv (Sum.inl i)) *
      M_zeta w zeta_0 (finSumFinEquiv (Sum.inl x)) c) = 0 := by
    simp_rw [J_cross_const_inl, zero_mul, Finset.sum_const_zero]
  rw [h_inl, zero_add]
  simp_rw [J_cross_const_inr_inl]
  have hM : ∀ x : Fin (w + 1), M_zeta w zeta_0 (finSumFinEquiv (Sum.inr x)) c = W_zeta w zeta_0 x c := by
    intro x
    simp only [M_zeta, Matrix.of_apply, Equiv.symm_apply_apply]
  simp_rw [hM, ← Finset.mul_sum]
  have hW : (∑ x : Fin (w + 1), W_zeta w zeta_0 x c) = 2 * (w + 1 : ℚ) * zeta_0 c := by
    have h1 := vecMul_one_W_zeta w zeta_0 c
    dsimp [vecMul, dotProduct] at h1
    simp_rw [one_mul] at h1
    exact h1
  rw [hW]
  have hw : (w + 1 : ℚ) ≠ 0 := by positivity
  field_simp [hw]

theorem JTM_cross_const_inr (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) (i : Fin (w + 1)) (c : Fin (w + 1)) :
    ((J_cross_const w).transpose * M_zeta w zeta_0) (finSumFinEquiv (Sum.inr i)) c = 0 := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun k : Fin ((w + 1) + (w + 1)) =>
      J_cross_const w k (finSumFinEquiv (Sum.inr i)) * M_zeta w zeta_0 k c).symm
  rw [hcomp, Fintype.sum_sum_type]
  have h_inl : (∑ x : Fin (w + 1), J_cross_const w (finSumFinEquiv (Sum.inl x)) (finSumFinEquiv (Sum.inr i)) *
      M_zeta w zeta_0 (finSumFinEquiv (Sum.inl x)) c) = 0 := by
    simp_rw [J_cross_const_inl, zero_mul, Finset.sum_const_zero]
  have h_inr : (∑ x : Fin (w + 1), J_cross_const w (finSumFinEquiv (Sum.inr x)) (finSumFinEquiv (Sum.inr i)) *
      M_zeta w zeta_0 (finSumFinEquiv (Sum.inr x)) c) = 0 := by
    simp_rw [J_cross_const_inr_inr, zero_mul, Finset.sum_const_zero]
  rw [h_inl, h_inr, add_zero]

theorem Q_reset_cross_const_inl (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) (j : Fin (w + 1)) (c : Fin (w + 1)) :
    Q_reset (J_cross_const w) (M_zeta w zeta_0) (B_mat (w + 1)) zeta_0 (finSumFinEquiv (Sum.inl j)) c =
      - (vecMul zeta_0 (1 + B_mat (w + 1))) c := by
  dsimp [Q_reset]
  have hJM : (J_cross_const w * M_zeta w zeta_0) (finSumFinEquiv (Sum.inl j)) c = 0 :=
    JM_cross_const_inl w zeta_0 j c
  have hJTM_B : ((J_cross_const w).transpose * M_zeta w zeta_0 * B_mat (w + 1)) (finSumFinEquiv (Sum.inl j)) c =
      2 * (vecMul zeta_0 (B_mat (w + 1))) c := by
    change (∑ x : Fin (w + 1), ((J_cross_const w).transpose * M_zeta w zeta_0) (finSumFinEquiv (Sum.inl j)) x * B_mat (w + 1) x c) = _
    simp_rw [JTM_cross_const_inl]
    dsimp [vecMul, dotProduct]
    simp_rw [mul_assoc, ← Finset.mul_sum]
  have honeB : (one_zeta (Fin ((w + 1) + (w + 1))) zeta_0 * B_mat (w + 1)) (finSumFinEquiv (Sum.inl j)) c =
      (vecMul zeta_0 (B_mat (w + 1))) c := rfl
  have hone : (one_zeta (Fin ((w + 1) + (w + 1))) zeta_0) (finSumFinEquiv (Sum.inl j)) c = zeta_0 c := rfl
  change (one_zeta (Fin ((w + 1) + (w + 1))) zeta_0 * B_mat (w + 1)) (finSumFinEquiv (Sum.inl j)) c -
      (one_zeta (Fin ((w + 1) + (w + 1))) zeta_0) (finSumFinEquiv (Sum.inl j)) c +
      (J_cross_const w * M_zeta w zeta_0) (finSumFinEquiv (Sum.inl j)) c -
      ((J_cross_const w).transpose * M_zeta w zeta_0 * B_mat (w + 1)) (finSumFinEquiv (Sum.inl j)) c = _
  rw [hJM, hJTM_B, honeB, hone]
  have h1B : (vecMul zeta_0 (1 + B_mat (w + 1))) c = zeta_0 c + (vecMul zeta_0 (B_mat (w + 1))) c := by
    rw [vecMul_add, vecMul_one]
    rfl
  rw [h1B]
  ring

theorem Q_reset_cross_const_inr (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) (j : Fin (w + 1)) (c : Fin (w + 1)) :
    Q_reset (J_cross_const w) (M_zeta w zeta_0) (B_mat (w + 1)) zeta_0 (finSumFinEquiv (Sum.inr j)) c =
      (vecMul zeta_0 (1 + B_mat (w + 1))) c := by
  dsimp [Q_reset]
  have hJM : (J_cross_const w * M_zeta w zeta_0) (finSumFinEquiv (Sum.inr j)) c = 2 * zeta_0 c :=
    JM_cross_const_inr w zeta_0 j c
  have hJTM_B : ((J_cross_const w).transpose * M_zeta w zeta_0 * B_mat (w + 1)) (finSumFinEquiv (Sum.inr j)) c = 0 := by
    change (∑ x : Fin (w + 1), ((J_cross_const w).transpose * M_zeta w zeta_0) (finSumFinEquiv (Sum.inr j)) x * B_mat (w + 1) x c) = _
    simp_rw [JTM_cross_const_inr, zero_mul, Finset.sum_const_zero]
  have honeB : (one_zeta (Fin ((w + 1) + (w + 1))) zeta_0 * B_mat (w + 1)) (finSumFinEquiv (Sum.inr j)) c =
      (vecMul zeta_0 (B_mat (w + 1))) c := rfl
  have hone : (one_zeta (Fin ((w + 1) + (w + 1))) zeta_0) (finSumFinEquiv (Sum.inr j)) c = zeta_0 c := rfl
  change (one_zeta (Fin ((w + 1) + (w + 1))) zeta_0 * B_mat (w + 1)) (finSumFinEquiv (Sum.inr j)) c -
      (one_zeta (Fin ((w + 1) + (w + 1))) zeta_0) (finSumFinEquiv (Sum.inr j)) c +
      (J_cross_const w * M_zeta w zeta_0) (finSumFinEquiv (Sum.inr j)) c -
      ((J_cross_const w).transpose * M_zeta w zeta_0 * B_mat (w + 1)) (finSumFinEquiv (Sum.inr j)) c = _
  rw [hJM, hJTM_B, honeB, hone]
  have h1B : (vecMul zeta_0 (1 + B_mat (w + 1))) c = zeta_0 c + (vecMul zeta_0 (B_mat (w + 1))) c := by
    rw [vecMul_add, vecMul_one]
    rfl
  rw [h1B]
  ring

theorem Q_reset_cross_const_eq_P0_cone_transpose_mul_X {m w : ℕ} (a_old : Fin (m + 1) → ℚ)
    (X : Matrix (Fin (m + 1)) (Fin (w + 1)) ℚ) (zeta_0 : Fin (w + 1) → ℚ)
    (hX : vecMul a_old X = vecMul zeta_0 (1 + B_mat (w + 1))) :
    Q_reset (J_cross_const w) (M_zeta w zeta_0) (B_mat (w + 1)) zeta_0 =
      (P0_cone a_old w).transpose * X := by
  ext r c
  have hequiv : r = finSumFinEquiv (finSumFinEquiv.symm r) := (Equiv.apply_symm_apply finSumFinEquiv r).symm
  rw [hequiv]
  cases finSumFinEquiv.symm r with
  | inl j =>
    rw [Q_reset_cross_const_inl]
    simp only [Matrix.mul_apply, Matrix.transpose_apply, P0_cone, Matrix.of_apply, Equiv.symm_apply_apply]
    have hsum : (∑ i : Fin (m + 1), -a_old i * X i c) = - (vecMul a_old X) c := by
      dsimp [vecMul, dotProduct]
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro i _
      ring
    rw [hsum, hX]
  | inr j =>
    rw [Q_reset_cross_const_inr]
    simp only [Matrix.mul_apply, Matrix.transpose_apply, P0_cone, Matrix.of_apply, Equiv.symm_apply_apply]
    have hsum : (∑ i : Fin (m + 1), a_old i * X i c) = (vecMul a_old X) c := rfl
    rw [hsum, hX]

/-!
## RPS Base-Case Seed Verification

We verify the inductive hypothesis base case on `rpsFullRankClock` (`w = 2, m = 3`):
There exists a strictly positive weight vector `a_old_rps` on `Fin 4` and strictly
positive target profile `zeta_0_rps` on `Fin 3` such that
`vecMul a_old_rps (X_gateway rpsFullRankClock.clock) = vecMul zeta_0_rps (1 + B_mat 3)`.
-/

def a_old_rps : Fin (rpsFullRankClock.clock.m + 1) → ℚ :=
  fun x =>
    match finSumFinEquiv.symm x with
    | Sum.inl _ => 1 / 3
    | Sum.inr _ => 2

theorem a_old_rps_pos (x : Fin (rpsFullRankClock.clock.m + 1)) : 0 < a_old_rps x := by
  dsimp [a_old_rps]
  split
  · norm_num
  · norm_num

def zeta_0_rps : Fin 3 → ℚ
  | ⟨0, _⟩ => 17 / 8
  | ⟨1, _⟩ => 15 / 4
  | ⟨2, _⟩ => 3 / 2

theorem zeta_0_rps_pos (j : Fin 3) : 0 < zeta_0_rps j := by
  fin_cases j <;> norm_num [zeta_0_rps]

theorem shiftRightCount_pos {α : Type*} {w : ℕ} (M : Matrix α (Fin w) ℚ)
    (i : α) (c : Fin (w + 1)) (hc : 0 < c.val) :
    shiftRightCount M i c = M i ⟨c.val - 1, by omega⟩ := by
  dsimp [shiftRightCount]
  rw [dif_pos hc]

theorem C2_zero_zero : C2 0 0 = 5 := rfl
theorem C2_zero_one  : C2 0 1 = 3 := rfl
theorem C2_one_zero  : C2 1 0 = 6 := rfl
theorem C2_one_one   : C2 1 1 = 3 := rfl
theorem C2_two_zero  : C2 2 0 = 7 := rfl
theorem C2_two_one   : C2 2 1 = 3 := rfl

theorem B_mat_3_0_0 : B_mat 3 0 0 = 1 := by simp [B_mat]
theorem B_mat_3_0_1 : B_mat 3 0 1 = 0 := by simp [B_mat]
theorem B_mat_3_0_2 : B_mat 3 0 2 = 0 := by simp [B_mat]
theorem B_mat_3_1_0 : B_mat 3 1 0 = -1 := by simp [B_mat]
theorem B_mat_3_1_1 : B_mat 3 1 1 = 1 := by simp [B_mat]
theorem B_mat_3_1_2 : B_mat 3 1 2 = 0 := by simp [B_mat]
theorem B_mat_3_2_0 : B_mat 3 2 0 = 1 := by simp [B_mat]
theorem B_mat_3_2_1 : B_mat 3 2 1 = -1 := by simp [B_mat]
theorem B_mat_3_2_2 : B_mat 3 2 2 = 1 := by simp [B_mat]

theorem one_3_0_0 : (1 : Matrix (Fin 3) (Fin 3) ℚ) 0 0 = 1 := Matrix.one_apply_eq 0
theorem one_3_1_1 : (1 : Matrix (Fin 3) (Fin 3) ℚ) 1 1 = 1 := Matrix.one_apply_eq 1
theorem one_3_2_2 : (1 : Matrix (Fin 3) (Fin 3) ℚ) 2 2 = 1 := Matrix.one_apply_eq 2
theorem one_3_0_1 : (1 : Matrix (Fin 3) (Fin 3) ℚ) 0 1 = 0 := Matrix.one_apply_ne (by decide)
theorem one_3_0_2 : (1 : Matrix (Fin 3) (Fin 3) ℚ) 0 2 = 0 := Matrix.one_apply_ne (by decide)
theorem one_3_1_0 : (1 : Matrix (Fin 3) (Fin 3) ℚ) 1 0 = 0 := Matrix.one_apply_ne (by decide)
theorem one_3_1_2 : (1 : Matrix (Fin 3) (Fin 3) ℚ) 1 2 = 0 := Matrix.one_apply_ne (by decide)
theorem one_3_2_0 : (1 : Matrix (Fin 3) (Fin 3) ℚ) 2 0 = 0 := Matrix.one_apply_ne (by decide)
theorem one_3_2_1 : (1 : Matrix (Fin 3) (Fin 3) ℚ) 2 1 = 0 := Matrix.one_apply_ne (by decide)

theorem vecMul_a_old_rps_X_gateway :
    vecMul a_old_rps (X_gateway rpsFullRankClock.clock) = vecMul zeta_0_rps (1 + B_mat 3) := by
  ext c
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun x =>
      a_old_rps x * X_gateway rpsFullRankClock.clock x c).symm
  dsimp [vecMul, dotProduct]
  rw [hcomp, Fintype.sum_sum_type]
  have hX_inr : (∑ g : Fin 1, a_old_rps (finSumFinEquiv (Sum.inr g)) *
      X_gateway rpsFullRankClock.clock (finSumFinEquiv (Sum.inr g)) c) =
      2 * e0_row 3 c := by
    rw [Fin.sum_univ_one]
    dsimp [a_old_rps, X_gateway, X_coupled]
    simp [e0_row]
  rw [hX_inr]
  have hX_inl : (∑ i : Fin 3, a_old_rps (finSumFinEquiv (Sum.inl i)) *
      X_gateway rpsFullRankClock.clock (finSumFinEquiv (Sum.inl i)) c) =
      (1 / 3 : ℚ) * ∑ i : Fin 3, shiftRightCount C2 i c := by
    dsimp [a_old_rps, X_gateway, X_coupled, rpsFullRankClock, rpsAlgebraicClock]
    simp_rw [Equiv.symm_apply_apply]
    rw [← Finset.mul_sum]
  change (∑ i : Fin 3, a_old_rps (finSumFinEquiv (Sum.inl i)) *
      X_gateway rpsFullRankClock.clock (finSumFinEquiv (Sum.inl i)) c) + 2 * e0_row 3 c = _
  rw [hX_inl]
  rcases c with ⟨c, hc⟩
  interval_cases c
  · -- c = 0
    have : (⟨0, hc⟩ : Fin 3) = 0 := rfl
    rw [this]
    rw [Fin.sum_univ_three]
    have h0_0 : shiftRightCount C2 0 0 = 0 := shiftRightCount_zero C2 0 0 rfl
    have h0_1 : shiftRightCount C2 1 0 = 0 := shiftRightCount_zero C2 1 0 rfl
    have h0_2 : shiftRightCount C2 2 0 = 0 := shiftRightCount_zero C2 2 0 rfl
    rw [h0_0, h0_1, h0_2]
    rw [Fin.sum_univ_three]
    rw [B_mat_3_0_0, B_mat_3_1_0, B_mat_3_2_0]
    rw [one_3_0_0, one_3_1_0, one_3_2_0]
    dsimp [e0_row, zeta_0_rps]
    norm_num
  · -- c = 1
    have : (⟨1, hc⟩ : Fin 3) = 1 := rfl
    rw [this]
    rw [Fin.sum_univ_three]
    have h1_0 : shiftRightCount C2 0 1 = C2 0 0 := shiftRightCount_pos C2 0 1 (by decide)
    have h1_1 : shiftRightCount C2 1 1 = C2 1 0 := shiftRightCount_pos C2 1 1 (by decide)
    have h1_2 : shiftRightCount C2 2 1 = C2 2 0 := shiftRightCount_pos C2 2 1 (by decide)
    rw [h1_0, h1_1, h1_2, C2_zero_zero, C2_one_zero, C2_two_zero]
    rw [Fin.sum_univ_three]
    rw [B_mat_3_0_1, B_mat_3_1_1, B_mat_3_2_1]
    rw [one_3_0_1, one_3_1_1, one_3_2_1]
    dsimp [e0_row, zeta_0_rps]
    norm_num
  · -- c = 2
    have : (⟨2, hc⟩ : Fin 3) = 2 := rfl
    rw [this]
    rw [Fin.sum_univ_three]
    have h2_0 : shiftRightCount C2 0 2 = C2 0 1 := shiftRightCount_pos C2 0 2 (by decide)
    have h2_1 : shiftRightCount C2 1 2 = C2 1 1 := shiftRightCount_pos C2 1 2 (by decide)
    have h2_2 : shiftRightCount C2 2 2 = C2 2 1 := shiftRightCount_pos C2 2 2 (by decide)
    rw [h2_0, h2_1, h2_2, C2_zero_one, C2_one_one, C2_two_one]
    rw [Fin.sum_univ_three]
    rw [B_mat_3_0_2, B_mat_3_1_2, B_mat_3_2_2]
    rw [one_3_0_2, one_3_1_2, one_3_2_2]
    dsimp [e0_row, zeta_0_rps]
    norm_num

/-!
# Drift-Free Score Table and Stage 3 Subphase Priority Preservation

This module formalizes the drift-free score table `S_uniform` (`R_{i, 0} e_0^\top + \vec{h}`),
proving:
1. `isValidPriorityWord_add_const`: invariance of priority words under constant shift.
2. `S_uniform_parent_eval`: entry score on parent rows has uniform height translation.
3. `stage3_subphase_parent_score`: exact cancellation of `R_{i, 0}` with `(R p_w(0))_i`.
4. `stage3_subphase_priority_valid`: unconditional validity of parent priority words.
5. `stage3_gateway_takeover`: gateway action `g` beats leader `b` by exactly `delta`,
   and beats every parent action by at least `delta > 0`.
-/

/-- Invariance of priority word validity under adding a constant to all scores. -/
theorem isValidPriorityWord_add_const {α : Type*} [Fintype α] [DecidableEq α] {m : ℕ}
    (M : Matrix α α ℚ) (s : α → ℚ) (C : ℚ) (rank : α → Fin m) (W : List α) :
    IsValidPriorityWord M (fun i => s i + C) rank W ↔ IsValidPriorityWord M s rank W := by
  constructor <;> intro h k hk j
  · have h1 := (h k hk j).1
    have h2 := (h k hk j).2
    rw [wordScore_add_bias, wordScore_add_bias] at h1
    simp only [add_le_add_iff_right] at h1
    refine ⟨h1, fun hne heq => ?_⟩
    have heq_C : wordScore M (fun i => s i + C) (W.take k) j =
                 wordScore M (fun i => s i + C) (W.take k) W[k] := by
      rw [wordScore_add_bias, wordScore_add_bias, heq]
    exact h2 hne heq_C
  · have h1 := (h k hk j).1
    have h2 := (h k hk j).2
    rw [wordScore_add_bias, wordScore_add_bias]
    simp only [add_le_add_iff_right]
    refine ⟨h1, fun hne heq => ?_⟩
    have heq' : wordScore M s (W.take k) j = wordScore M s (W.take k) W[k] :=
      add_right_cancel heq
    exact h2 hne heq'

/-- Drift-free score table `S_uniform`: parent rows start at `R_{i, 0} e_0^\top + h`. -/
def S_uniform {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (h : Fin (w + 1) → ℚ) (delta : ℚ) : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ :=
  Matrix.of fun x c =>
    match finSumFinEquiv.symm x with
    | Sum.inl i => (if c.val = 0 then clock.R i ⟨0, hw⟩ else 0) + h c
    | Sum.inr _ => (if c.val = 0 then clock.R b ⟨0, hw⟩ + delta else 0) -
                   (if c.val = 1 then 1 else 0) + h c

/-- The initial evaluation of `S_uniform` on parent row `i` at phase `q + 1`. -/
theorem S_uniform_parent_eval {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (h : Fin (w + 1) → ℚ) (delta : ℚ) (i : Fin clock.m) (q : ℕ) :
    ((S_uniform hw clock b h delta).mulVec (binomBasis (w + 1) (q + 1))) (finSumFinEquiv (Sum.inl i)) =
      clock.R i ⟨0, hw⟩ + dotProduct h (binomBasis (w + 1) (q + 1)) := by
  simp only [S_uniform, Matrix.mulVec, dotProduct, Matrix.of_apply, Equiv.symm_apply_apply]
  have hsplit : (∑ c : Fin (w + 1), ((if c.val = 0 then clock.R i ⟨0, hw⟩ else 0) + h c) *
      binomBasis (w + 1) (q + 1) c) =
    (∑ c : Fin (w + 1), (if c.val = 0 then clock.R i ⟨0, hw⟩ else 0) * binomBasis (w + 1) (q + 1) c) +
    ∑ c : Fin (w + 1), h c * binomBasis (w + 1) (q + 1) c := by
    simp only [add_mul]
    exact Finset.sum_add_distrib
  rw [hsplit]
  congr 1
  have h0 : (∑ c : Fin (w + 1), (if c.val = 0 then clock.R i ⟨0, hw⟩ else 0) * binomBasis (w + 1) (q + 1) c) =
      (if (0 : ℕ) = 0 then clock.R i ⟨0, hw⟩ else 0) * binomBasis (w + 1) (q + 1) ⟨0, by omega⟩ := by
    rw [Finset.sum_eq_single ⟨0, by omega⟩]
    · intro c _ hc
      have hne : c.val ≠ 0 := by
        intro h
        apply hc
        ext
        exact h
      simp [hne]
    · intro h
      exact False.elim (h (Finset.mem_univ _))
  rw [h0]
  simp only [↓reduceIte, binomBasis, Nat.choose_zero_right]
  ring

/-- The initial evaluation of `S_uniform` on gateway row at phase `q + 1`. -/
theorem S_uniform_gateway_eval {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (h : Fin (w + 1) → ℚ) (delta : ℚ) (q : ℕ) :
    ((S_uniform hw clock b h delta).mulVec (binomBasis (w + 1) (q + 1))) (finSumFinEquiv (Sum.inr 0)) =
      clock.R b ⟨0, hw⟩ + delta - ((q + 1 : ℕ) : ℚ) + dotProduct h (binomBasis (w + 1) (q + 1)) := by
  simp only [S_uniform, Matrix.mulVec, dotProduct, Matrix.of_apply, Equiv.symm_apply_apply]
  have h0 : (∑ c : Fin (w + 1), (if c.val = 0 then clock.R b ⟨0, hw⟩ + delta else 0) * binomBasis (w + 1) (q + 1) c) =
      clock.R b ⟨0, hw⟩ + delta := by
    rw [Finset.sum_eq_single ⟨0, by omega⟩]
    · simp only [↓reduceIte, binomBasis, Nat.choose_zero_right]
      ring
    · intro c _ hc
      have hne : c.val ≠ 0 := by intro h; apply hc; ext; exact h
      simp [hne]
    · intro h; exact False.elim (h (Finset.mem_univ _))
  have h1 : (∑ c : Fin (w + 1), (if c.val = 1 then 1 else 0) * binomBasis (w + 1) (q + 1) c) =
      ((q + 1 : ℕ) : ℚ) := by
    rw [Finset.sum_eq_single ⟨1, by omega⟩]
    · simp only [↓reduceIte, binomBasis, Nat.choose_one_right]
      ring
    · intro c _ hc
      have hne : c.val ≠ 1 := by intro h; apply hc; ext; exact h
      simp [hne]
    · intro h; exact False.elim (h (Finset.mem_univ _))
  have h_comb : (∑ c : Fin (w + 1),
      (((if c.val = 0 then clock.R b ⟨0, hw⟩ + delta else 0) -
        (if c.val = 1 then 1 else 0)) + h c) * binomBasis (w + 1) (q + 1) c) =
    (∑ c : Fin (w + 1), (if c.val = 0 then clock.R b ⟨0, hw⟩ + delta else 0) * binomBasis (w + 1) (q + 1) c) -
    (∑ c : Fin (w + 1), (if c.val = 1 then 1 else 0) * binomBasis (w + 1) (q + 1) c) +
    ∑ c : Fin (w + 1), h c * binomBasis (w + 1) (q + 1) c := by
    calc
      (∑ c : Fin (w + 1),
        (((if c.val = 0 then clock.R b ⟨0, hw⟩ + delta else 0) -
          (if c.val = 1 then 1 else 0)) + h c) * binomBasis (w + 1) (q + 1) c)
      _ = ∑ c : Fin (w + 1),
        (((if c.val = 0 then clock.R b ⟨0, hw⟩ + delta else 0) * binomBasis (w + 1) (q + 1) c -
          (if c.val = 1 then 1 else 0) * binomBasis (w + 1) (q + 1) c) +
          h c * binomBasis (w + 1) (q + 1) c) := by
        refine Finset.sum_congr rfl fun c _ => ?_
        ring
      _ = (∑ c : Fin (w + 1),
            ((if c.val = 0 then clock.R b ⟨0, hw⟩ + delta else 0) * binomBasis (w + 1) (q + 1) c -
             (if c.val = 1 then 1 else 0) * binomBasis (w + 1) (q + 1) c)) +
          ∑ c : Fin (w + 1), h c * binomBasis (w + 1) (q + 1) c :=
        Finset.sum_add_distrib
      _ = (∑ c : Fin (w + 1), (if c.val = 0 then clock.R b ⟨0, hw⟩ + delta else 0) * binomBasis (w + 1) (q + 1) c) -
          (∑ c : Fin (w + 1), (if c.val = 1 then 1 else 0) * binomBasis (w + 1) (q + 1) c) +
          ∑ c : Fin (w + 1), h c * binomBasis (w + 1) (q + 1) c := by
        rw [Finset.sum_sub_distrib]
  rw [h_comb, h0, h1]

/-- **Stage 3 Subphase Cancellation Identity (`stage3_subphase_parent_score`)**:
    When the bundle transfer gain `(R p_w(idx))_i - (R p_w(0))_i` is added to the initial
    score `R_{i, 0} + C`, the `R_{i, 0}` terms cancel identically since
    `p_w(0) = e_0` so `(R p_w(0))_i = R_{i, 0}`. -/
theorem stage3_subphase_parent_score {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (i : Fin clock.m) (idx : ℕ) (C : ℚ) :
    clock.R i ⟨0, hw⟩ + C + (clock.R.mulVec (binomBasis w idx) i - clock.R.mulVec (binomBasis w 0) i) =
      clock.R.mulVec (binomBasis w idx) i + C := by
  have hp0 : binomBasis w 0 = fun c => if c.val = 0 then 1 else 0 := by
    ext c
    simp only [binomBasis]
    cases c.val with
    | zero => simp
    | succ n => simp [Nat.choose_eq_zero_of_lt]
  have hR0 : clock.R.mulVec (binomBasis w 0) i = clock.R i ⟨0, hw⟩ := by
    simp only [Matrix.mulVec, dotProduct, hp0]
    rw [Finset.sum_eq_single ⟨0, hw⟩]
    · simp
    · intro c _ hc
      have hne : c.val ≠ 0 := by intro h; apply hc; ext; exact h
      simp [hne]
    · intro h; exact False.elim (h (Finset.mem_univ _))
  rw [hR0]
  ring

/-- **Unconditional Priority Validity on Parent Subphases**:
    Because the score at subphase `idx` equals `clock.R.mulVec (binomBasis w idx) i + C`,
    priority validity follows directly from native validity for every `idx` and `q`. -/
theorem stage3_subphase_priority_valid {w : ℕ} {m_rank : ℕ} (clock : AlgebraicClock w)
    (idx : ℕ) (C : ℚ) (rank : Fin clock.m → Fin m_rank) (W : List (Fin clock.m))
    (h_native : IsValidPriorityWord clock.G
      (fun i => clock.R.mulVec (binomBasis w idx) i) rank W) :
    IsValidPriorityWord clock.G
      (fun i => clock.R.mulVec (binomBasis w idx) i + C)
      rank W := by
  rw [isValidPriorityWord_add_const]
  exact h_native

/-- **Stage 3 Completion Gateway Takeover (`stage3_gateway_takeover`)**:
    At the completion of Stage 3 (`idx = q + 1`), gateway action `g` beats parent leader `b`
    by exactly `delta`, and strictly beats every parent action `i` by at least `delta > 0`. -/
theorem stage3_gateway_takeover {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (q : ℕ) (C delta : ℚ)
    (s_parent : Fin clock.m → ℚ) (s_gateway : ℚ)
    (h_parent : ∀ i, s_parent i = clock.R.mulVec (binomBasis w (q + 1)) i + C)
    (h_gateway : s_gateway = clock.R.mulVec (binomBasis w (q + 1)) b + C + delta)
    (hleader : ∀ i, clock.R.mulVec (binomBasis w (q + 1)) i ≤ clock.R.mulVec (binomBasis w (q + 1)) b) :
    s_gateway - s_parent b = delta ∧
    ∀ i : Fin clock.m, delta ≤ s_gateway - s_parent i := by
  have h_diff_b : s_gateway - s_parent b = delta := by
    rw [h_gateway, h_parent b]
    ring
  refine ⟨h_diff_b, fun i => ?_⟩
  rw [h_gateway, h_parent i]
  have hle := hleader i
  linarith

/-- Ceiling-aligned uniform height row `h_uniform`. -/
def h_uniform {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (zeta : Fin (w + 1) → ℚ) (c_step : ℚ) : Fin (w + 1) → ℚ :=
  fun c =>
    zeta c -
      (if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0) -
      (if c.val = 0 then c_step else 0)

/-- **Exact Dot Product Identity for `h_uniform`**:
    For any `Q : ℕ`, `dotProduct (h_uniform clock b zeta c_step) (binomBasis (w + 1) Q)`
    evaluates to `dotProduct zeta (binomBasis (w + 1) Q) - (R p_w(Q))_b - c_step`. -/
theorem h_uniform_eval {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (zeta : Fin (w + 1) → ℚ) (c_step : ℚ) (Q : ℕ) :
    dotProduct (h_uniform clock b zeta c_step) (binomBasis (w + 1) Q) =
      dotProduct zeta (binomBasis (w + 1) Q) - clock.R.mulVec (binomBasis w Q) b - c_step := by
  simp only [h_uniform, dotProduct]
  have hsplit : (∑ c : Fin (w + 1),
      (zeta c -
        (if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0) -
        (if c.val = 0 then c_step else 0)) * binomBasis (w + 1) Q c) =
    (∑ c : Fin (w + 1), zeta c * binomBasis (w + 1) Q c) -
    (∑ c : Fin (w + 1), (if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0) * binomBasis (w + 1) Q c) -
    (∑ c : Fin (w + 1), (if c.val = 0 then c_step else 0) * binomBasis (w + 1) Q c) := by
    simp only [sub_mul]
    rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
  rw [hsplit]
  have h_cstep : (∑ c : Fin (w + 1), (if c.val = 0 then c_step else 0) * binomBasis (w + 1) Q c) = c_step := by
    rw [Finset.sum_eq_single ⟨0, by omega⟩]
    · simp only [↓reduceIte, binomBasis, Nat.choose_zero_right]
      ring
    · intro c _ hc
      have hne : c.val ≠ 0 := by intro h; apply hc; ext; exact h
      simp [hne]
    · intro h; exact False.elim (h (Finset.mem_univ _))
  have h_Rb : (∑ c : Fin (w + 1), (if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0) * binomBasis (w + 1) Q c) =
      clock.R.mulVec (binomBasis w Q) b := by
    simp only [Matrix.mulVec, dotProduct]
    have heq_sum := (Fin.sum_univ_castSucc (fun c : Fin (w + 1) =>
      (if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0) * binomBasis (w + 1) Q c)).symm
    rw [← heq_sum]
    have h_last : ((if hc : (Fin.last w).val < w then clock.R b ⟨(Fin.last w).val, hc⟩ else 0) *
        binomBasis (w + 1) Q (Fin.last w)) = 0 := by
      have hnot : ¬ ((Fin.last w).val < w) := by
        simp only [Fin.val_last, lt_self_iff_false, not_false_eq_true]
      simp only [hnot, ↓reduceDIte, zero_mul]
    rw [h_last, add_zero]
    refine Finset.sum_congr rfl fun c _ => ?_
    have hc_lt : (Fin.castSucc c).val < w := c.isLt
    simp only [hc_lt, ↓reduceDIte]
    rfl
  rw [h_cstep, h_Rb]

/-- **Universal Stage 4 Leader Score Formula**:
    Under `h_uniform`, at the end of Stage 3 (`idx = q + 1`), parent leader `b`'s score
    is identically `zeta(q + 1) - c_step`. -/
theorem stage4_leader_score_h_uniform {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (zeta : Fin (w + 1) → ℚ) (c_step : ℚ) (q : ℕ) :
    clock.R.mulVec (binomBasis w (q + 1)) b + dotProduct (h_uniform clock b zeta c_step) (binomBasis (w + 1) (q + 1)) =
      dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step := by
  rw [h_uniform_eval]
  ring

/-- **Universal Stage 4 Gateway Score Formula**:
    Under `h_uniform`, at the end of Stage 3 (`idx = q + 1`), gateway action `g`'s score
    is identically `zeta(q + 1) - c_step + delta`. -/
theorem stage4_gateway_score_h_uniform {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (zeta : Fin (w + 1) → ℚ) (c_step delta : ℚ) (q : ℕ) :
    clock.R.mulVec (binomBasis w (q + 1)) b + dotProduct (h_uniform clock b zeta c_step) (binomBasis (w + 1) (q + 1)) + delta =
      dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + delta := by
  rw [stage4_leader_score_h_uniform]

/-- **Universal Stage 4 Parent Domination**:
    Under `h_uniform`, every parent action `i` is strictly beaten by gateway action `g`
    by at least `delta > 0`. -/
theorem stage4_parent_domination_h_uniform {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (zeta : Fin (w + 1) → ℚ) (c_step delta : ℚ) (q : ℕ) (i : Fin clock.m)
    (hleader : clock.R.mulVec (binomBasis w (q + 1)) i ≤ clock.R.mulVec (binomBasis w (q + 1)) b) :
    delta ≤
      (clock.R.mulVec (binomBasis w (q + 1)) b + dotProduct (h_uniform clock b zeta c_step) (binomBasis (w + 1) (q + 1)) + delta) -
      (clock.R.mulVec (binomBasis w (q + 1)) i + dotProduct (h_uniform clock b zeta c_step) (binomBasis (w + 1) (q + 1))) := by
  linarith

/-- **Universal Stage 4 Reset Domination**:
    Under `h_uniform`, gateway action `g` strictly beats any reset action `r`
    whenever the gateway coupling satisfies `-P_{g, r} > c_step - delta`. -/
theorem stage4_reset_domination_h_uniform {w : ℕ}
    (zeta : Fin (w + 1) → ℚ) (c_step delta : ℚ) (q : ℕ)
    (s_reset : ℚ) (P_g_r : ℚ)
    (h_reset_bound : s_reset ≤ dotProduct zeta (binomBasis (w + 1) (q + 1)) + P_g_r)
    (h_coupling : c_step - delta < -P_g_r) :
    s_reset < (dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + delta) := by
  linarith

/-!
### 5. Canonical Drift-Free Ceiling Profile `zeta_canonical` and Stage 2 Handoff
-/

/-- Pascal inverse action on binomial basis columns: `B * p(q + 1) = p(q)`. -/
theorem B_mat_mulVec_binomBasis (w q : ℕ) :
    (B_mat w).mulVec (binomBasis w (q + 1)) = binomBasis w q := by
  have hsucc := binomBasis_succ w q
  have hB := (B_mat_mul_T_mat w).1
  calc
    (B_mat w).mulVec (binomBasis w (q + 1)) =
      (B_mat w).mulVec ((T_mat w).mulVec (binomBasis w q)) := by rw [hsucc]
    _ = (B_mat w * T_mat w).mulVec (binomBasis w q) := by rw [Matrix.mulVec_mulVec]
    _ = (1 : Matrix (Fin w) (Fin w) ℚ).mulVec (binomBasis w q) := by rw [hB]
    _ = binomBasis w q := Matrix.one_mulVec _

/-- Coordinate-wise action of vector multiplication by `N_mat`. -/
theorem vecMul_N_mat_apply {w : ℕ} (v : Fin w → ℚ) (c : Fin w) :
    Matrix.vecMul v (N_mat w) c = if hc : c.val + 1 < w then v ⟨c.val + 1, hc⟩ else 0 := by
  have h := mul_N_mat_apply (Matrix.of fun (_ : Unit) => v) () c
  simp only [Matrix.mul_apply, N_mat, Matrix.of_apply, Matrix.vecMul, dotProduct] at h ⊢
  exact h

/-- Difference row vector `v_step`. -/
def v_step {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m) (c_step : ℚ) :
    Fin (w + 1) → ℚ :=
  fun c =>
    (if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0) -
    (if c.val = 0 then clock.R b ⟨0, hw⟩ else 0) +
    (if c.val = 0 then c_step else 0)

/-- Top coordinate of `v_step` vanishes: `v_step ⟨w, _⟩ = 0`. -/
theorem v_step_top {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m) (c_step : ℚ) :
    v_step hw clock b c_step ⟨w, Nat.lt_succ_self w⟩ = 0 := by
  dsimp [v_step]
  have h2 : ¬ (w = 0) := by omega
  simp [h2]

/-- Canonical ceiling profile `zeta_canonical` with free baseline `H0`. -/
def zeta_canonical {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) : Fin (w + 1) → ℚ :=
  fun c =>
    if hc0 : c.val = 0 then H0
    else
      let c_prev : Fin (w + 1) := ⟨c.val - 1, by omega⟩
      Matrix.vecMul (v_step hw clock b c_step) (1 + N_mat (w + 1)) c_prev

/-- Action of `N_mat` on `zeta_canonical` produces `v_step * (1 + N_mat)`. -/
theorem vecMul_zeta_canonical_N_mat {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) :
    Matrix.vecMul (zeta_canonical hw clock b c_step H0) (N_mat (w + 1)) =
      Matrix.vecMul (v_step hw clock b c_step) (1 + N_mat (w + 1)) := by
  ext c
  rw [vecMul_N_mat_apply]
  by_cases hc : c.val + 1 < w + 1
  · simp only [hc, ↓reduceDIte]
    have hne : ¬ ((⟨c.val + 1, hc⟩ : Fin (w + 1)).val = 0) := by
      dsimp
      omega
    simp [zeta_canonical]
  · have hc_top : c.val = w := by
      have hc_lt := c.isLt
      omega
    have hc_eq : c = ⟨w, Nat.lt_succ_self w⟩ := by ext; exact hc_top
    subst hc_eq
    simp only [hc, ↓reduceDIte]
    simp only [Matrix.vecMul_add, Matrix.vecMul_one, Pi.add_apply]
    rw [v_step_top hw clock b c_step, vecMul_N_mat_apply]
    have hnot : ¬ (w + 1 < w + 1) := lt_irrefl _
    simp only [hnot, ↓reduceDIte, add_zero]

/-- **Closed-Form Master Equation for `zeta_canonical` (`vecMul_zeta_canonical_one_sub_B_mat`)**:
    `zeta_canonical * (1 - B) = v_step` identically for all widths `w ≥ 1`. -/
theorem vecMul_zeta_canonical_one_sub_B_mat {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) :
    Matrix.vecMul (zeta_canonical hw clock b c_step H0) (1 - B_mat (w + 1)) =
      v_step hw clock b c_step := by
  have hN := vecMul_zeta_canonical_N_mat hw clock b c_step H0
  have hNB := (B_mat_mul_N_mat (w + 1)).2
  have hTB := one_add_N_mul_B_mat (w + 1)
  have h_mul := congr_arg (fun v => Matrix.vecMul v (B_mat (w + 1))) hN
  simp only [Matrix.vecMul_vecMul] at h_mul
  rw [hNB, hTB, Matrix.vecMul_one] at h_mul
  exact h_mul

/-- **Identity of `h_uniform` with `zeta * B - R_{b, 0} e_0`**:
    Equation (23) (`\eqref{eq:y}`) of `master_v15.tex`. -/
theorem h_uniform_zeta_canonical_eq {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) (c : Fin (w + 1)) :
    h_uniform clock b (zeta_canonical hw clock b c_step H0) c_step c =
      Matrix.vecMul (zeta_canonical hw clock b c_step H0) (B_mat (w + 1)) c -
        (if c.val = 0 then clock.R b ⟨0, hw⟩ else 0) := by
  have h_step := congr_fun (vecMul_zeta_canonical_one_sub_B_mat hw clock b c_step H0) c
  simp only [Matrix.vecMul_sub, Matrix.vecMul_one, Pi.sub_apply] at h_step
  dsimp only [h_uniform, v_step] at h_step ⊢
  linarith

/-- **Exact Dot Product of `h_uniform` with `binomBasis (w + 1) (q + 1)`**:
    Evaluates to `zeta(q) - R_{b, 0}` using `B * p(q + 1) = p(q)`. -/
theorem h_uniform_zeta_canonical_eval {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) (q : ℕ) :
    dotProduct (h_uniform clock b (zeta_canonical hw clock b c_step H0) c_step) (binomBasis (w + 1) (q + 1)) =
      dotProduct (zeta_canonical hw clock b c_step H0) (binomBasis (w + 1) q) - clock.R b ⟨0, hw⟩ := by
  have heq : h_uniform clock b (zeta_canonical hw clock b c_step H0) c_step =
      fun c => Matrix.vecMul (zeta_canonical hw clock b c_step H0) (B_mat (w + 1)) c -
        (if c.val = 0 then clock.R b ⟨0, hw⟩ else 0) := by
    ext c
    exact h_uniform_zeta_canonical_eq hw clock b c_step H0 c
  rw [heq]
  change (∑ c : Fin (w + 1), (Matrix.vecMul (zeta_canonical hw clock b c_step H0) (B_mat (w + 1)) c -
      (if c.val = 0 then clock.R b ⟨0, hw⟩ else 0)) * binomBasis (w + 1) (q + 1) c) = _
  simp_rw [sub_mul]
  rw [Finset.sum_sub_distrib]
  have h0 : (∑ c : Fin (w + 1), (if c.val = 0 then clock.R b ⟨0, hw⟩ else 0) * binomBasis (w + 1) (q + 1) c) =
      clock.R b ⟨0, hw⟩ := by
    rw [Finset.sum_eq_single ⟨0, by omega⟩]
    · simp only [↓reduceIte, binomBasis, Nat.choose_zero_right]
      ring
    · intro c _ hc
      have hne : c.val ≠ 0 := by intro h; apply hc; ext; exact h
      simp [hne]
    · intro h; exact False.elim (h (Finset.mem_univ _))
  have h_B : (∑ c : Fin (w + 1), Matrix.vecMul (zeta_canonical hw clock b c_step H0) (B_mat (w + 1)) c *
      binomBasis (w + 1) (q + 1) c) =
      dotProduct (zeta_canonical hw clock b c_step H0) (binomBasis (w + 1) q) := by
    change dotProduct (Matrix.vecMul (zeta_canonical hw clock b c_step H0) (B_mat (w + 1)))
      (binomBasis (w + 1) (q + 1)) = _
    rw [← Matrix.dotProduct_mulVec, B_mat_mulVec_binomBasis (w + 1) q]
  rw [h0, h_B]

/-- **Stage 2 Handoff Parent Score Identity**:
    At the end of Stage 2 (entrance to Stage 3), parent action `i`'s score under `S_uniform`
    is identically `zeta(q) + (R_{i, 0} - R_{b, 0})`. -/
theorem stage2_parent_score_canonical {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (i : Fin clock.m) (q : ℕ) :
    ((S_uniform hw clock b (h_uniform clock b (zeta_canonical hw clock b c_step H0) c_step) delta).mulVec
      (binomBasis (w + 1) (q + 1))) (finSumFinEquiv (Sum.inl i)) =
      dotProduct (zeta_canonical hw clock b c_step H0) (binomBasis (w + 1) q) +
        (clock.R i ⟨0, hw⟩ - clock.R b ⟨0, hw⟩) := by
  rw [S_uniform_parent_eval hw clock b _ delta i q]
  rw [h_uniform_zeta_canonical_eval hw clock b c_step H0 q]
  ring

/-- **q-Independent Constant Stage 2 Ceiling Margin**:
    The condition `score_after_stage2 (inl i) - P(i, reset_last) < zeta(q)` reduces
    to the absolute constant inequality `R_{i, 0} - R_{b, 0} < P(i, reset_last)`. -/
theorem stage2_parent_end_sharp_canonical {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (i : Fin clock.m) (q : ℕ) (P_i_reset : ℚ)
    (h_const : clock.R i ⟨0, hw⟩ - clock.R b ⟨0, hw⟩ < P_i_reset) :
    ((S_uniform hw clock b (h_uniform clock b (zeta_canonical hw clock b c_step H0) c_step) delta).mulVec
      (binomBasis (w + 1) (q + 1))) (finSumFinEquiv (Sum.inl i)) - P_i_reset <
      dotProduct (zeta_canonical hw clock b c_step H0) (binomBasis (w + 1) q) := by
  rw [stage2_parent_score_canonical hw clock b c_step H0 delta i q]
  linarith

/-- Dot product of `v_step` with binomial basis:
    `v_step · p(Q) = (R p_w(Q))_b - R_{b, 0} + c_step`. -/
theorem v_step_dotProduct_binomBasis {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step : ℚ) (Q : ℕ) :
    dotProduct (v_step hw clock b c_step) (binomBasis (w + 1) Q) =
      clock.R.mulVec (binomBasis w Q) b - clock.R b ⟨0, hw⟩ + c_step := by
  simp only [v_step, dotProduct]
  have hsplit : (∑ c : Fin (w + 1),
      ((if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0) -
       (if c.val = 0 then clock.R b ⟨0, hw⟩ else 0) +
       (if c.val = 0 then c_step else 0)) * binomBasis (w + 1) Q c) =
    (∑ c : Fin (w + 1), (if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0) * binomBasis (w + 1) Q c) -
    (∑ c : Fin (w + 1), (if c.val = 0 then clock.R b ⟨0, hw⟩ else 0) * binomBasis (w + 1) Q c) +
    (∑ c : Fin (w + 1), (if c.val = 0 then c_step else 0) * binomBasis (w + 1) Q c) := by
    simp only [add_mul, sub_mul]
    rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
  rw [hsplit]
  have h_Rb : (∑ c : Fin (w + 1), (if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0) * binomBasis (w + 1) Q c) =
      clock.R.mulVec (binomBasis w Q) b := by
    simp only [Matrix.mulVec, dotProduct]
    have heq_sum := (Fin.sum_univ_castSucc (fun c : Fin (w + 1) =>
      (if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0) * binomBasis (w + 1) Q c)).symm
    rw [← heq_sum]
    have h_last : ((if hc : (Fin.last w).val < w then clock.R b ⟨(Fin.last w).val, hc⟩ else 0) *
        binomBasis (w + 1) Q (Fin.last w)) = 0 := by
      have hnot : ¬ ((Fin.last w).val < w) := by
        simp only [Fin.val_last, lt_self_iff_false, not_false_eq_true]
      simp only [hnot, ↓reduceDIte, zero_mul]
    rw [h_last, add_zero]
    refine Finset.sum_congr rfl fun c _ => ?_
    have hc_lt : (Fin.castSucc c).val < w := c.isLt
    simp only [hc_lt, ↓reduceDIte]
    rfl
  have h0 : (∑ c : Fin (w + 1), (if c.val = 0 then clock.R b ⟨0, hw⟩ else 0) * binomBasis (w + 1) Q c) =
      clock.R b ⟨0, hw⟩ := by
    rw [Finset.sum_eq_single ⟨0, by omega⟩]
    · simp only [↓reduceIte, binomBasis, Nat.choose_zero_right]
      ring
    · intro c _ hc
      have hne : c.val ≠ 0 := by intro h; apply hc; ext; exact h
      simp [hne]
    · intro h; exact False.elim (h (Finset.mem_univ _))
  have h_cstep : (∑ c : Fin (w + 1), (if c.val = 0 then c_step else 0) * binomBasis (w + 1) Q c) = c_step := by
    rw [Finset.sum_eq_single ⟨0, by omega⟩]
    · simp only [↓reduceIte, binomBasis, Nat.choose_zero_right]
      ring
    · intro c _ hc
      have hne : c.val ≠ 0 := by intro h; apply hc; ext; exact h
      simp [hne]
    · intro h; exact False.elim (h (Finset.mem_univ _))
  rw [h_Rb, h0, h_cstep]

/-- **Successive Step Difference of Canonical Ceiling Profile**:
    `zeta(q + 1) - zeta(q) = (R p_w(q + 1))_b - R_{b, 0} + c_step` identically for all `q : ℕ`. -/
theorem zeta_canonical_diff_succ {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) (q : ℕ) :
    dotProduct (zeta_canonical hw clock b c_step H0) (binomBasis (w + 1) (q + 1)) -
      dotProduct (zeta_canonical hw clock b c_step H0) (binomBasis (w + 1) q) =
      clock.R.mulVec (binomBasis w (q + 1)) b - clock.R b ⟨0, hw⟩ + c_step := by
  have hB : binomBasis (w + 1) q = (B_mat (w + 1)).mulVec (binomBasis (w + 1) (q + 1)) :=
    (B_mat_mulVec_binomBasis (w + 1) q).symm
  rw [hB, Matrix.dotProduct_mulVec]
  have h_sub : dotProduct (zeta_canonical hw clock b c_step H0) (binomBasis (w + 1) (q + 1)) -
      dotProduct (Matrix.vecMul (zeta_canonical hw clock b c_step H0) (B_mat (w + 1))) (binomBasis (w + 1) (q + 1)) =
      dotProduct (Matrix.vecMul (zeta_canonical hw clock b c_step H0) (1 - B_mat (w + 1)))
        (binomBasis (w + 1) (q + 1)) := by
    simp only [dotProduct, Matrix.vecMul_sub, Matrix.vecMul_one, Pi.sub_apply]
    simp_rw [sub_mul]
    rw [Finset.sum_sub_distrib]
  rw [h_sub]
  rw [vecMul_zeta_canonical_one_sub_B_mat hw clock b c_step H0]
  exact v_step_dotProduct_binomBasis hw clock b c_step (q + 1)

/-- **Stage 3 Early Reset Waiting Condition**:
    Under the drift-free architecture, the early reset waiting condition
    `score(early reset) < score(active parent)` simplifies by cancellation of `R_{b, 0}` to:
    `(R p_w(q + 1))_b - wordScore G (R p_w(idx)) (take r_step) act + c_step < - P_{g, early}`. -/
theorem stage3_early_reset_waiting {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) (q idx r_step : ℕ) (parent_sub : List (Fin clock.m)) (act : Fin clock.m)
    (s_early P_g_early : ℚ)
    (h_early_bound : s_early ≤ dotProduct (zeta_canonical hw clock b c_step H0) (binomBasis (w + 1) (q + 1)) + P_g_early)
    (s_parent : ℚ)
    (h_parent : s_parent = wordScore clock.G (fun i => clock.R.mulVec (binomBasis w idx) i) (parent_sub.take r_step) act +
      dotProduct (zeta_canonical hw clock b c_step H0) (binomBasis (w + 1) q) - clock.R b ⟨0, hw⟩)
    (h_waiting : clock.R.mulVec (binomBasis w (q + 1)) b -
      wordScore clock.G (fun i => clock.R.mulVec (binomBasis w idx) i) (parent_sub.take r_step) act + c_step < - P_g_early) :
    s_early < s_parent := by
  have hdiff := zeta_canonical_diff_succ hw clock b c_step H0 q
  linarith

/-- **Stage 3 Late Reset Waiting Condition**:
    Under the drift-free architecture, the late reset waiting condition
    `score(late reset) < score(active parent)` simplifies by cancellation of `zeta(q)` to:
    `R_{b, 0} - JM_term < wordScore G (R p_w(idx)) (take r_step) act`. -/
theorem stage3_late_reset_waiting {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) (q idx r_step : ℕ) (parent_sub : List (Fin clock.m)) (act : Fin clock.m)
    (s_late JM_term : ℚ)
    (h_late_bound : s_late ≤ dotProduct (zeta_canonical hw clock b c_step H0) (binomBasis (w + 1) q) - JM_term)
    (s_parent : ℚ)
    (h_parent : s_parent = wordScore clock.G (fun i => clock.R.mulVec (binomBasis w idx) i) (parent_sub.take r_step) act +
      dotProduct (zeta_canonical hw clock b c_step H0) (binomBasis (w + 1) q) - clock.R b ⟨0, hw⟩)
    (h_waiting : clock.R b ⟨0, hw⟩ - JM_term <
      wordScore clock.G (fun i => clock.R.mulVec (binomBasis w idx) i) (parent_sub.take r_step) act) :
    s_late < s_parent := by
  linarith

/-- **Exact Stage 3 Active Parent Score Formula under `S_uniform`**:
    Combines `stage3_subphase_parent_score` with `h_uniform_zeta_canonical_eval` to show that
    the active parent score is identically
    `wordScore G (R p_w(idx)) (take r_step) act + zeta(q) - R_{b, 0}`. -/
theorem stage3_subphase_active_parent_canonical {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (q idx : ℕ) (parent_sub : List (Fin clock.m)) (r_step : ℕ) (act : Fin clock.m) :
    wordScore clock.G
      (fun i =>
        ((S_uniform hw clock b (h_uniform clock b (zeta_canonical hw clock b c_step H0) c_step) delta).mulVec
          (binomBasis (w + 1) (q + 1))) (finSumFinEquiv (Sum.inl i)) +
        (clock.R.mulVec (binomBasis w idx) i - clock.R.mulVec (binomBasis w 0) i))
      (parent_sub.take r_step) act =
    wordScore clock.G (fun i => clock.R.mulVec (binomBasis w idx) i) (parent_sub.take r_step) act +
      dotProduct (zeta_canonical hw clock b c_step H0) (binomBasis (w + 1) q) - clock.R b ⟨0, hw⟩ := by
  have h_score_fun : (fun i =>
        ((S_uniform hw clock b (h_uniform clock b (zeta_canonical hw clock b c_step H0) c_step) delta).mulVec
          (binomBasis (w + 1) (q + 1))) (finSumFinEquiv (Sum.inl i)) +
        (clock.R.mulVec (binomBasis w idx) i - clock.R.mulVec (binomBasis w 0) i)) =
      (fun i => clock.R.mulVec (binomBasis w idx) i +
        dotProduct (h_uniform clock b (zeta_canonical hw clock b c_step H0) c_step) (binomBasis (w + 1) (q + 1))) := by
    ext i
    rw [S_uniform_parent_eval hw clock b _ delta i q]
    exact stage3_subphase_parent_score hw clock i idx _
  rw [h_score_fun]
  rw [wordScore_add_bias]
  rw [h_uniform_zeta_canonical_eval hw clock b c_step H0 q]
  ring

/-!
### 6. Symmetric Forward/Backward Leader Comparison for Stage 3 Reset Waiting

Because `parentWord idx` is a valid priority word on parent actions, the active parent action `act`
satisfies `score_k(inl b) ≤ score_k(inl act)` at every step `k`.
Therefore, `score_k(inr r) < score_k(inl act)` is established by comparing reset `r` against leader `b`.
By entrywise bounds between `P` and `clock.G b :`:
- **Late resets `r = inr j`**: step forward from `k = 0` using `- G(b, i) ≤ P(i, r)`.
- **Early resets `r = inl j`**: step backward from `k = end` using `G(b, i) ≤ - P(i, r)`.
Both eliminate intra-subphase oscillation `𝒪(A_k)` and q-dependent score gaps entirely.
-/

/-- Monotonicity of list map sum under pointwise comparison. -/
theorem list_sum_map_le {α : Type*} (w : List α) (f g : α → ℚ)
    (hle : ∀ x ∈ w, f x ≤ g x) :
    (w.map f).sum ≤ (w.map g).sum := by
  induction w with
  | nil => simp
  | cons x xs ih =>
    simp only [List.map_cons, List.sum_cons]
    have hx : f x ≤ g x := hle x List.mem_cons_self
    have hxs : (xs.map f).sum ≤ (xs.map g).sum := ih (fun y hy => hle y (List.mem_cons_of_mem x hy))
    linarith

/-- **Forward Leader Comparison for Late Reset Waiting**:
    Step forward along prefix `w_pre : List α`.
    When each step `i` adds `G_b i` to leader `b` and `- P_i` to late reset `r`,
    and `- G_b i ≤ P_i` (i.e. `- P_i ≤ G_b i`), the late reset can never catch the leader. -/
theorem stage3_late_reset_waiting_forward_leader {α : Type*}
    (w_pre : List α) (G_b P_r : α → ℚ)
    (s0_b s0_r score_b score_r score_act : ℚ)
    (h_step_b : score_b = s0_b + (w_pre.map G_b).sum)
    (h_step_r : score_r = s0_r + (w_pre.map (fun i => - P_r i)).sum)
    (h_start : s0_r < s0_b)
    (h_coupling : ∀ i ∈ w_pre, - G_b i ≤ P_r i)
    (h_leader_le_act : score_b ≤ score_act) :
    score_r < score_act := by
  have h_le : (w_pre.map (fun i => - P_r i)).sum ≤ (w_pre.map G_b).sum := by
    apply list_sum_map_le
    intro i hi
    have h := h_coupling i hi
    linarith
  linarith

/-- **Backward Leader Comparison for Early Reset Waiting**:
    Step backward along suffix `w_rem : List α`.
    When each step `i` adds `G_b i` to leader `b` and `- P_i` to early reset `r`,
    and `G_b i ≤ - P_i`, the early reset can never catch the leader. -/
theorem stage3_early_reset_waiting_backward_leader {α : Type*}
    (w_rem : List α) (G_b P_r : α → ℚ)
    (score_b score_r send_b send_r score_act : ℚ)
    (h_step_b : send_b = score_b + (w_rem.map G_b).sum)
    (h_step_r : send_r = score_r + (w_rem.map (fun i => - P_r i)).sum)
    (h_end : send_r < send_b)
    (h_coupling : ∀ i ∈ w_rem, G_b i ≤ - P_r i)
    (h_leader_le_act : score_b ≤ score_act) :
    score_r < score_act := by
  have h_le : (w_rem.map G_b).sum ≤ (w_rem.map (fun i => - P_r i)).sum := by
    apply list_sum_map_le
    intro i hi
    exact h_coupling i hi
  linarith



/-!
### Gauge Invariance Lemmas for Column 0 Baseline Shift

Shifting `zeta_canonical` by an arbitrary `H0 • e_0` does not change
`vecMul zeta (1 - B_mat) = v_step` or `D_uniform` or `a_P` (columns 1..w of `vecMul zeta (1 + B_mat)`),
while shifting `a_g` (column 0 of `vecMul zeta (1 + B_mat)`) by `+ 2 * H0`.
-/

theorem vecMul_e0_one_sub_B_mat (w : ℕ) (H0 : ℚ) :
    Matrix.vecMul (fun c : Fin (w + 1) => if c.val = 0 then H0 else 0) (1 - B_mat (w + 1)) = 0 := by
  ext c
  dsimp [Matrix.vecMul, dotProduct]
  rw [Finset.sum_eq_single ⟨0, Nat.succ_pos w⟩]
  · simp only [↓reduceIte]
    have h0 : (⟨0, Nat.succ_pos w⟩ : Fin (w + 1)) = 0 := rfl
    rw [h0]
    rw [Matrix.one_apply]
    have hB := B_mat_zero_row (Nat.succ_pos w) c
    dsimp [e0_row] at hB
    rw [hB]
    cases c using Fin.cases with
    | zero => simp
    | succ j =>
      have hjne : (0 : Fin (w + 1)) ≠ j.succ := by
        intro h
        have := congr_arg Fin.val h
        simp at this
      simp [hjne]
  · intro j _ hj
    have hne : j.val ≠ 0 := by
      intro h
      apply hj
      ext
      exact h
    simp [hne]
  · intro h
    exact False.elim (h (Finset.mem_univ _))

theorem vecMul_e0_one_add_B_mat (w : ℕ) (H0 : ℚ) :
    Matrix.vecMul (fun c : Fin (w + 1) => if c.val = 0 then H0 else 0) (1 + B_mat (w + 1)) =
      fun c => if c.val = 0 then 2 * H0 else 0 := by
  ext c
  dsimp [Matrix.vecMul, dotProduct]
  rw [Finset.sum_eq_single ⟨0, Nat.succ_pos w⟩]
  · simp only [↓reduceIte]
    have h0 : (⟨0, Nat.succ_pos w⟩ : Fin (w + 1)) = 0 := rfl
    rw [h0]
    rw [Matrix.one_apply]
    have hB := B_mat_zero_row (Nat.succ_pos w) c
    dsimp [e0_row] at hB
    rw [hB]
    cases c using Fin.cases with
    | zero =>
      simp
      ring
    | succ j =>
      have hjne : (0 : Fin (w + 1)) ≠ j.succ := by
        intro h
        have := congr_arg Fin.val h
        simp at this
      simp [hjne]
  · intro j _ hj
    have hne : j.val ≠ 0 := by
      intro h
      apply hj
      ext
      exact h
    simp [hne]
  · intro h
    exact False.elim (h (Finset.mem_univ _))

/-! ### Section 27: Exact Inversion of W_zeta, Left Inverse of M_zeta, and Arbitrary Moment Realization -/

/-- The exact rational inverse of `W_zeta w zeta_0` for any width `w` and weight vector `zeta_0`.
    - For rows `i < w`: `(W_zeta_inv)_{i, j} = (if i = j then 1 else 0) - (w + 1)⁻¹`.
    - For the last row `i = w`:
      `(W_zeta_inv)_{w, j} = (1 + 2 * ∑_{k<w} zeta_0(k) - (if j < w then 2(w+1)zeta_0(j) else 0)) / (2(w+1)zeta_0(w))`. -/
def W_zeta_inv (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  fun i j =>
    if i.val < w then
      (if i = j then 1 else 0) - (w + 1 : ℚ)⁻¹
    else
      let pref := ∑ k : Fin w, zeta_0 (Fin.castSucc k)
      let j_term := if j.val < w then 2 * (w + 1 : ℚ) * zeta_0 j else 0
      (1 + 2 * pref - j_term) / (2 * (w + 1 : ℚ) * zeta_0 ⟨w, Nat.lt_succ_self w⟩)

/-- Entry formula for early rows `i < w` of `W_zeta_inv`. -/
theorem W_zeta_inv_apply_early {w : ℕ} (zeta_0 : Fin (w + 1) → ℚ) (i j : Fin (w + 1))
    (hi : i.val < w) :
    W_zeta_inv w zeta_0 i j = (if i = j then 1 else 0) - (w + 1 : ℚ)⁻¹ := by
  dsimp [W_zeta_inv]
  rw [if_pos hi]

/-- Entry formula for the last row `i = w` and early column `j < w` of `W_zeta_inv`. -/
theorem W_zeta_inv_apply_last_early {w : ℕ} (zeta_0 : Fin (w + 1) → ℚ) (j : Fin (w + 1))
    (hj : j.val < w) :
    W_zeta_inv w zeta_0 ⟨w, Nat.lt_succ_self w⟩ j =
      (1 + 2 * (∑ k : Fin w, zeta_0 (Fin.castSucc k)) - 2 * (w + 1 : ℚ) * zeta_0 j) /
        (2 * (w + 1 : ℚ) * zeta_0 ⟨w, Nat.lt_succ_self w⟩) := by
  dsimp [W_zeta_inv]
  have hnot : ¬ (w < w) := by omega
  rw [if_neg hnot, if_pos hj]

/-- Entry formula for the bottom-right corner `(w, w)` of `W_zeta_inv`. -/
theorem W_zeta_inv_apply_last_last {w : ℕ} (zeta_0 : Fin (w + 1) → ℚ) :
    W_zeta_inv w zeta_0 ⟨w, Nat.lt_succ_self w⟩ ⟨w, Nat.lt_succ_self w⟩ =
      (1 + 2 * (∑ k : Fin w, zeta_0 (Fin.castSucc k))) /
        (2 * (w + 1 : ℚ) * zeta_0 ⟨w, Nat.lt_succ_self w⟩) := by
  dsimp [W_zeta_inv]
  have hnot : ¬ (w < w) := by omega
  rw [if_neg hnot, if_neg hnot, sub_zero]

/-- Row sum of any early row `i < w` of `W_zeta_inv` vanishes identically. -/
theorem sum_W_zeta_inv_row_early {w : ℕ} (zeta_0 : Fin (w + 1) → ℚ) (i : Fin (w + 1))
    (hi : i.val < w) :
    ∑ j : Fin (w + 1), W_zeta_inv w zeta_0 i j = 0 := by
  have h1 : ∀ j : Fin (w + 1), W_zeta_inv w zeta_0 i j = (if i = j then 1 else 0) - (w + 1 : ℚ)⁻¹ :=
    fun j => W_zeta_inv_apply_early zeta_0 i j hi
  simp_rw [h1, Finset.sum_sub_distrib]
  simp only [Finset.sum_ite_eq, Finset.mem_univ, if_true]
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hw : (w + 1 : ℚ) ≠ 0 := by positivity
  field_simp [hw]
  push_cast
  ring

/-- Row sum of the last row `i = w` of `W_zeta_inv` is exactly `(2 * zeta_0(w))⁻¹`. -/
theorem sum_W_zeta_inv_row_last {w : ℕ} (zeta_0 : Fin (w + 1) → ℚ)
    (hzw : zeta_0 ⟨w, Nat.lt_succ_self w⟩ ≠ 0) :
    ∑ j : Fin (w + 1), W_zeta_inv w zeta_0 ⟨w, Nat.lt_succ_self w⟩ j =
      (2 * zeta_0 ⟨w, Nat.lt_succ_self w⟩)⁻¹ := by
  rw [Fin.sum_univ_castSucc]
  have hlast : W_zeta_inv w zeta_0 ⟨w, Nat.lt_succ_self w⟩ (Fin.last w) =
      (1 + 2 * (∑ k : Fin w, zeta_0 (Fin.castSucc k))) /
        (2 * (w + 1 : ℚ) * zeta_0 ⟨w, Nat.lt_succ_self w⟩) := by
    have hl : Fin.last w = ⟨w, Nat.lt_succ_self w⟩ := rfl
    rw [hl]
    exact W_zeta_inv_apply_last_last zeta_0
  have hcast : ∀ j : Fin w, W_zeta_inv w zeta_0 ⟨w, Nat.lt_succ_self w⟩ (Fin.castSucc j) =
      (1 + 2 * (∑ k : Fin w, zeta_0 (Fin.castSucc k)) - 2 * (w + 1 : ℚ) * zeta_0 (Fin.castSucc j)) /
        (2 * (w + 1 : ℚ) * zeta_0 ⟨w, Nat.lt_succ_self w⟩) := by
    intro j
    apply W_zeta_inv_apply_last_early
    exact j.isLt
  simp_rw [hcast]
  rw [hlast]
  let P := ∑ k : Fin w, zeta_0 (Fin.castSucc k)
  let D := 2 * (w + 1 : ℚ) * zeta_0 ⟨w, Nat.lt_succ_self w⟩
  have hsum_cast : (∑ j : Fin w, (1 + 2 * P - 2 * (w + 1 : ℚ) * zeta_0 (Fin.castSucc j)) / D) =
      ((w : ℚ) * (1 + 2 * P) - 2 * (w + 1 : ℚ) * P) / D := by
    simp_rw [div_eq_mul_inv, ← Finset.sum_mul]
    rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    rw [← Finset.mul_sum]
  rw [hsum_cast]
  rw [← add_div]
  have hnum : (w : ℚ) * (1 + 2 * P) - 2 * (w + 1 : ℚ) * P + (1 + 2 * P) = (w + 1 : ℚ) := by
    ring
  rw [hnum]
  dsimp [D]
  have hw : (w + 1 : ℚ) ≠ 0 := by positivity
  field_simp [hw, hzw]

/-- Explicit entry formula for `W_zeta`. -/
theorem W_zeta_apply (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) (j l : Fin (w + 1)) :
    W_zeta w zeta_0 j l = 2 * zeta_0 l + (if j = l then 1 else 0) - (if j = ⟨w, Nat.lt_succ_self w⟩ then 1 else 0) := by
  dsimp [W_zeta, V0_coupled, E_last]
  have hiff : (j.val = w) ↔ j = ⟨w, Nat.lt_succ_self w⟩ := by
    constructor
    · intro h; ext; exact h
    · intro h; rw [h]
  by_cases hj : j.val = w
  · rw [if_pos (hiff.mp hj)]
    simp only [Matrix.one_apply]
    ring
  · rw [if_neg (mt hiff.mpr hj)]
    simp only [Matrix.one_apply]
    ring

/-- **Left Inverse of `W_zeta` (`W_zeta_inv_mul_W_zeta`)**:
    `W_zeta_inv w zeta_0 * W_zeta w zeta_0 = 1` holds whenever `zeta_0(w) ≠ 0`. -/
theorem W_zeta_inv_mul_W_zeta (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ)
    (hzw : zeta_0 ⟨w, Nat.lt_succ_self w⟩ ≠ 0) :
    W_zeta_inv w zeta_0 * W_zeta w zeta_0 = 1 := by
  ext i l
  rw [Matrix.mul_apply]
  have hW : ∀ j : Fin (w + 1), W_zeta w zeta_0 j l =
      2 * zeta_0 l + (if j = l then 1 else 0) - (if j = ⟨w, Nat.lt_succ_self w⟩ then 1 else 0) :=
    fun j => W_zeta_apply w zeta_0 j l
  simp_rw [hW]
  have h_split : (∑ j : Fin (w + 1), W_zeta_inv w zeta_0 i j *
        (2 * zeta_0 l + (if j = l then 1 else 0) - (if j = ⟨w, Nat.lt_succ_self w⟩ then 1 else 0))) =
      (2 * zeta_0 l) * (∑ j : Fin (w + 1), W_zeta_inv w zeta_0 i j) +
      (∑ j : Fin (w + 1), W_zeta_inv w zeta_0 i j * (if j = l then 1 else 0)) -
      (∑ j : Fin (w + 1), W_zeta_inv w zeta_0 i j * (if j = ⟨w, Nat.lt_succ_self w⟩ then 1 else 0)) := by
    simp_rw [mul_sub, mul_add, Finset.sum_sub_distrib, Finset.sum_add_distrib]
    congr 1
    congr 1
    simp_rw [mul_comm (W_zeta_inv w zeta_0 i _)]
    rw [← Finset.mul_sum]
  rw [h_split]
  have hdiag_sum : (∑ j : Fin (w + 1), W_zeta_inv w zeta_0 i j * (if j = l then 1 else 0)) =
      W_zeta_inv w zeta_0 i l := by
    have hterm : ∀ j : Fin (w + 1), W_zeta_inv w zeta_0 i j * (if j = l then (1 : ℚ) else 0) =
        if j = l then W_zeta_inv w zeta_0 i l else 0 := by
      intro j
      split_ifs with hj
      · subst hj; ring
      · ring
    simp_rw [hterm]
    simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
  rw [hdiag_sum]
  have hlast_sum : (∑ j : Fin (w + 1), W_zeta_inv w zeta_0 i j * (if j = ⟨w, Nat.lt_succ_self w⟩ then 1 else 0)) =
      W_zeta_inv w zeta_0 i ⟨w, Nat.lt_succ_self w⟩ := by
    have hterm : ∀ j : Fin (w + 1), W_zeta_inv w zeta_0 i j * (if j = ⟨w, Nat.lt_succ_self w⟩ then (1 : ℚ) else 0) =
        if j = ⟨w, Nat.lt_succ_self w⟩ then W_zeta_inv w zeta_0 i ⟨w, Nat.lt_succ_self w⟩ else 0 := by
      intro j
      split_ifs with hj
      · subst hj; ring
      · ring
    simp_rw [hterm]
    simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
  rw [hlast_sum]
  by_cases hi : i.val < w
  · rw [sum_W_zeta_inv_row_early zeta_0 i hi, mul_zero, zero_add]
    rw [W_zeta_inv_apply_early zeta_0 i l hi]
    rw [W_zeta_inv_apply_early zeta_0 i ⟨w, Nat.lt_succ_self w⟩ hi]
    have hne : ¬ (i = ⟨w, Nat.lt_succ_self w⟩) := by
      intro heq
      have hval : i.val = w := congr_arg Fin.val heq
      change i.val = w at hval
      omega
    rw [if_neg hne]
    simp only [Matrix.one_apply]
    split_ifs <;> ring
  · have hi_w : i = ⟨w, Nat.lt_succ_self w⟩ := by
      ext
      change i.val = w
      have := i.isLt
      omega
    subst hi_w
    rw [sum_W_zeta_inv_row_last zeta_0 hzw]
    have h_prod : 2 * zeta_0 l * (2 * zeta_0 ⟨w, Nat.lt_succ_self w⟩)⁻¹ =
        zeta_0 l / zeta_0 ⟨w, Nat.lt_succ_self w⟩ := by
      have h2 : (2 : ℚ) ≠ 0 := by norm_num
      field_simp [h2, hzw]
    rw [h_prod]
    by_cases hl : l.val < w
    · rw [W_zeta_inv_apply_last_early zeta_0 l hl]
      rw [W_zeta_inv_apply_last_last zeta_0]
      have hne : ¬ (⟨w, Nat.lt_succ_self w⟩ = l) := by
        intro heq
        have hval : w = l.val := congr_arg Fin.val heq
        change w = l.val at hval
        omega
      simp only [Matrix.one_apply, if_neg hne]
      have hw : (w + 1 : ℚ) ≠ 0 := by positivity
      have h2 : (2 : ℚ) ≠ 0 := by norm_num
      field_simp [hw, h2, hzw]
      ring
    · have hl_w : l = ⟨w, Nat.lt_succ_self w⟩ := by
        ext
        change l.val = w
        have := l.isLt
        omega
      subst hl_w
      simp only [Matrix.one_apply, if_true]
      have h_sub : W_zeta_inv w zeta_0 ⟨w, Nat.lt_succ_self w⟩ ⟨w, Nat.lt_succ_self w⟩ -
          W_zeta_inv w zeta_0 ⟨w, Nat.lt_succ_self w⟩ ⟨w, Nat.lt_succ_self w⟩ = 0 := sub_self _
      rw [add_sub_assoc, h_sub, add_zero]
      exact div_self hzw

/-- **Right Inverse of `W_zeta` (`W_zeta_mul_W_zeta_inv`)**:
    `W_zeta w zeta_0 * W_zeta_inv w zeta_0 = 1` holds whenever `zeta_0(w) ≠ 0`. -/
theorem W_zeta_mul_W_zeta_inv (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ)
    (hzw : zeta_0 ⟨w, Nat.lt_succ_self w⟩ ≠ 0) :
    W_zeta w zeta_0 * W_zeta_inv w zeta_0 = 1 := by
  rw [mul_eq_one_comm]
  exact W_zeta_inv_mul_W_zeta w zeta_0 hzw

/-- Explicit left inverse `R_M_zeta = [0 | W_zeta_inv w zeta_0] ∈ ℚ^{(w + 1) × 2(w + 1)}`
    for `M_zeta w zeta_0`. -/
def R_M_zeta (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ) :
    Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  Matrix.of fun c r =>
    match finSumFinEquiv.symm r with
    | Sum.inl _ => 0
    | Sum.inr i => W_zeta_inv w zeta_0 c i

/-- **Full Column Rank of `M_zeta w zeta_0` (`R_M_zeta_mul_M_zeta`)**:
    `R_M_zeta w zeta_0 * M_zeta w zeta_0 = 1` holds whenever `zeta_0(w) ≠ 0`. -/
theorem R_M_zeta_mul_M_zeta (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ)
    (hzw : zeta_0 ⟨w, Nat.lt_succ_self w⟩ ≠ 0) :
    R_M_zeta w zeta_0 * M_zeta w zeta_0 = 1 := by
  ext c1 c2
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      R_M_zeta w zeta_0 c1 r * M_zeta w zeta_0 r c2).symm
  rw [Matrix.mul_apply, hcomp, Fintype.sum_sum_type]
  simp only [R_M_zeta, M_zeta, Matrix.of_apply, Equiv.symm_apply_apply,
    zero_mul, Finset.sum_const_zero, zero_add]
  exact congr_fun (congr_fun (W_zeta_inv_mul_W_zeta w zeta_0 hzw) c1) c2

/-- General strictly lower-triangular block interaction matrix `J_zeta` realizing arbitrary moment target `E`. -/
def J_zeta (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) :
    Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ :=
  let η : ℚ := (4 * (w + 1 : ℚ))⁻¹
  let X_mid := (W_zeta_inv w zeta_0).transpose * E * W_zeta_inv w zeta_0
  Matrix.of fun a b =>
    match finSumFinEquiv.symm a, finSumFinEquiv.symm b with
    | Sum.inl i, Sum.inl j => (η • L_strict (w + 1)) i j
    | Sum.inl _, Sum.inr _ => 0
    | Sum.inr i, Sum.inl j => (X_mid - (2 * η) • L_strict (w + 1)) i j
    | Sum.inr i, Sum.inr j => (η • L_strict (w + 1)) i j

/-- **Universal Moment Realization Identity for `M_zeta`**:
    `(M_zeta)ᵀ * (J_zeta w zeta_0 E) * (M_zeta) = E` holds identically for EVERY matrix `E`
    whenever `zeta_0(w) ≠ 0`. -/
theorem M_zeta_transpose_mul_J_zeta_mul_M_zeta (w : ℕ) (zeta_0 : Fin (w + 1) → ℚ)
    (hzw : zeta_0 ⟨w, Nat.lt_succ_self w⟩ ≠ 0)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) :
    (M_zeta w zeta_0).transpose * J_zeta w zeta_0 E * M_zeta w zeta_0 = E := by
  let η : ℚ := (4 * (w + 1 : ℚ))⁻¹
  let X_mid := (W_zeta_inv w zeta_0).transpose * E * W_zeta_inv w zeta_0
  have h_sum_blocks :
      η • L_strict (w + 1) + 0 + (X_mid - (2 * η) • L_strict (w + 1)) +
        η • L_strict (w + 1) = X_mid := by
    ext i j
    simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, Matrix.zero_apply,
      smul_eq_mul]
    ring
  have h_eq :
      (M_zeta w zeta_0).transpose * J_zeta w zeta_0 E * M_zeta w zeta_0 =
        (W_zeta w zeta_0).transpose * X_mid * W_zeta w zeta_0 := by
    rw [← h_sum_blocks]
    ext c1 c2
    simp only [Matrix.mul_apply, Matrix.transpose_apply]
    have hcomp1 :
        ∀ b : Fin ((w + 1) + (w + 1)),
          (∑ a : Fin ((w + 1) + (w + 1)), M_zeta w zeta_0 a c1 * J_zeta w zeta_0 E a b) =
            (∑ i : Fin (w + 1), W_zeta w zeta_0 i c1 * J_zeta w zeta_0 E (finSumFinEquiv (Sum.inl i)) b) +
            (∑ i : Fin (w + 1), W_zeta w zeta_0 i c1 * J_zeta w zeta_0 E (finSumFinEquiv (Sum.inr i)) b) := by
      intro b
      have hc := (Equiv.sum_comp finSumFinEquiv fun a => M_zeta w zeta_0 a c1 * J_zeta w zeta_0 E a b).symm
      rw [hc, Fintype.sum_sum_type]
      simp only [M_zeta, Matrix.of_apply, Equiv.symm_apply_apply]
    simp_rw [hcomp1]
    have hcomp2 :=
      (Equiv.sum_comp finSumFinEquiv fun b : Fin ((w + 1) + (w + 1)) =>
        ((∑ i : Fin (w + 1), W_zeta w zeta_0 i c1 * J_zeta w zeta_0 E (finSumFinEquiv (Sum.inl i)) b) +
         (∑ i : Fin (w + 1), W_zeta w zeta_0 i c1 * J_zeta w zeta_0 E (finSumFinEquiv (Sum.inr i)) b)) *
        M_zeta w zeta_0 b c2).symm
    rw [hcomp2, Fintype.sum_sum_type]
    simp only [M_zeta, J_zeta, Matrix.of_apply, Equiv.symm_apply_apply,
      Matrix.add_apply, Matrix.zero_apply]
    change
      ((∑ x : Fin (w + 1),
        ((∑ i : Fin (w + 1), W_zeta w zeta_0 i c1 * (η • L_strict (w + 1)) i x) +
         (∑ i : Fin (w + 1), W_zeta w zeta_0 i c1 * (X_mid - (2 * η) • L_strict (w + 1)) i x)) *
        W_zeta w zeta_0 x c2) +
       (∑ x : Fin (w + 1),
        ((∑ i : Fin (w + 1), W_zeta w zeta_0 i c1 * 0) +
         (∑ i : Fin (w + 1), W_zeta w zeta_0 i c1 * (η • L_strict (w + 1)) i x)) *
        W_zeta w zeta_0 x c2)) =
      ∑ x : Fin (w + 1),
        (∑ i : Fin (w + 1),
          W_zeta w zeta_0 i c1 *
            ((η • L_strict (w + 1)) i x + 0 +
             (X_mid - (2 * η) • L_strict (w + 1)) i x +
             (η • L_strict (w + 1)) i x)) *
        W_zeta w zeta_0 x c2
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun x _ => ?_
    simp only [← add_mul, ← Finset.sum_add_distrib, ← mul_add]
    congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    ring
  rw [h_eq]
  dsimp only [X_mid]
  have h1 : (W_zeta w zeta_0).transpose * (W_zeta_inv w zeta_0).transpose =
      (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) := by
    rw [← Matrix.transpose_mul, W_zeta_inv_mul_W_zeta w zeta_0 hzw, Matrix.transpose_one]
  have h2 : (W_zeta_inv w zeta_0) * (W_zeta w zeta_0) =
      (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) :=
    W_zeta_inv_mul_W_zeta w zeta_0 hzw
  calc
    (W_zeta w zeta_0).transpose * ((W_zeta_inv w zeta_0).transpose * E * W_zeta_inv w zeta_0) * W_zeta w zeta_0
      = ((W_zeta w zeta_0).transpose * (W_zeta_inv w zeta_0).transpose) * E * (W_zeta_inv w zeta_0 * W_zeta w zeta_0) := by
        simp only [Matrix.mul_assoc]
    _ = 1 * E * 1 := by rw [h1, h2]
    _ = E := by
      have he1 : (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) * E = E := Matrix.one_mul E
      have he2 : E * (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) = E := Matrix.mul_one E
      rw [he1, he2]

end Karlin




/-!
### Section 28: Master Moment Equation for Uniform Ceiling Score Table `S_uniform`

This section formalizes the master moment equation `L(E) = Dᵀ X - ℓᵀ ψ`
for the uniform ceiling score table `S_uniform` and canonical ceiling profile `zeta_canonical`:
1. Top-column vanishing of the lifted payoff-count product and deficit table:
   `AdjoinLeaderEndpointG_mul_X_last_col_zero` and `D_uniform_last_col_zero`.
2. Interaction table `K_uniform = Dᵀ X` vanishing at row `w`:
   `K_uniform_last_row_zero` and `F_gw_uniform_last_row_zero`.
3. Unconditional anti-symmetry at top degree: `(F_gw)_{0, w} + (F_gw)_{w, 0} = 0`
   (`F_gw_uniform_anti`) for all `w ≥ 2` and every `AlgebraicClock w`.
4. Shift compatibility `h_uniform(r + 1) = v_step(r)` for `0 < r < w`
   (`h_uniform_succ_eq_v_step`) and exact positive deficit rows `D_uniform_inl_pos`.
5. Exact skew block identity on positive coordinates `0 < r < w, 0 < c ≤ w`:
   `F_gw(r, c) = - (Cᵀ G C)_{c-1, r-1}` (`F_gw_uniform_pos`).
6. Universal sparse support error vanishing whenever `Cᵀ G C = 0` (`F_gw_uniform_supp_of_CGC_zero`).
7. Vanishing of the 2×2 cone interaction for Rock-Paper-Scissors: `C₂ᵀ A_RPS C₂ = 0`
   (`rps_CGC_zero`) and unconditional sparse support (`rps_F_gw_supp`).
8. Master moment equations:
   - `E_uniform_moment_equation_of_CGC_zero`: For any algebraic clock with `Cᵀ G C = 0`.
   - `rps_E_uniform_moment_equation`: Completely unconditional theorem with ZERO hypotheses for
     the canonical 3-action RPS clock.
-/

namespace Karlin

open scoped BigOperators


theorem matrix_moment_add {n : Type*} [Fintype n] [DecidableEq n] (A B M : Matrix n n ℚ) :
    (A + B) - (A + B).transpose * M = (A - A.transpose * M) + (B - B.transpose * M) := by
  ext i j
  simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.mul_apply, Matrix.transpose_apply]
  have h_sum : (∑ k, (A k i + B k i) * M k j) = (∑ k, A k i * M k j) + (∑ k, B k i * M k j) := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun k _ => by ring
  rw [h_sum]
  ring

/-- Total action count row $\vec{x}_{\mathrm{sum}} = \mathbf{1}^\top X_{\mathrm{gateway}}$. -/
def x_sum_uniform {w : ℕ} (clock : AlgebraicClock w) : Fin (w + 1) → ℚ :=
  Matrix.vecMul (fun _ => 1) (X_gateway clock)

/-- Shifted count row $\vec{y} = \vec{x}_{\mathrm{sum}} (1 + N)$. -/
def y_sum_uniform {w : ℕ} (clock : AlgebraicClock w) : Fin (w + 1) → ℚ :=
  Matrix.vecMul (x_sum_uniform clock) (1 + N_mat (w + 1))

/-- Outer product term $v_{\mathrm{step}}^\top \vec{x}_{\mathrm{sum}}$. -/
def G_outer_target {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m) (c_step : ℚ) :
    Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  Matrix.of fun r c => v_step (by omega) clock b c_step r * x_sum_uniform clock c

/-- Deficit matrix for the drift-free score table `S_uniform`. -/
def D_uniform {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ :=
  D_deficit (AdjoinLeaderEndpointG clock.G b clock.v)
    (S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta)
    (X_gateway clock) (N_mat (w + 1))

/-- Vanishing of the last column $c = w$ of `AdjoinLeaderEndpointG * X_gateway`. -/
theorem AdjoinLeaderEndpointG_mul_X_last_col_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (x : Fin (clock.m + 1)) :
    (AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock) x ⟨w, Nat.lt_succ_self w⟩ = 0 := by
  let c_top : Fin (w + 1) := ⟨w, Nat.lt_succ_self w⟩
  let c_last : Fin w := ⟨w - 1, by omega⟩
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) =>
      AdjoinLeaderEndpointG clock.G b clock.v x y * X_gateway clock y c_top).symm
  rw [Matrix.mul_apply, hcomp, Fintype.sum_sum_type]
  have he0_top : e0_row (w + 1) c_top = 0 := by
    simp only [e0_row, c_top]
    split_ifs with h
    · omega
    · rfl
  have hX_inr : ∀ j : Fin 1, X_gateway clock (finSumFinEquiv (Sum.inr j)) c_top = 0 := by
    intro j
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, he0_top]
  simp only [hX_inr, mul_zero, Finset.sum_const_zero, add_zero]
  have hX_inl : ∀ j : Fin clock.m,
      X_gateway clock (finSumFinEquiv (Sum.inl j)) c_top = clock.C j c_last := by
    intro j
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply,
      shiftRightCount, c_top, c_last]
    split_ifs with h
    · rfl
    · omega
  simp_rw [hX_inl]
  cases hsym : finSumFinEquiv.symm x with
  | inl i =>
    have hG_inl : ∀ j : Fin clock.m,
        AdjoinLeaderEndpointG clock.G b clock.v x (finSumFinEquiv (Sum.inl j)) = clock.G i j := by
      intro j
      simp only [AdjoinLeaderEndpointG, Matrix.of_apply, hsym, Equiv.symm_apply_apply]
    simp_rw [hG_inl]
    have hGC : (∑ j : Fin clock.m, clock.G i j * clock.C j c_last) =
        (clock.G * clock.C) i c_last := rfl
    rw [hGC, clock.hclock, mul_N_mat_apply]
    have hnot : ¬ (c_last.val + 1 < w) := by
      change ¬ (w - 1 + 1 < w)
      omega
    simp [hnot]
  | inr _ =>
    have hG_inr : ∀ j : Fin clock.m,
        AdjoinLeaderEndpointG clock.G b clock.v x (finSumFinEquiv (Sum.inl j)) =
          clock.G b j + clock.v j := by
      intro j
      simp only [AdjoinLeaderEndpointG, Matrix.of_apply, hsym, Equiv.symm_apply_apply]
    simp_rw [hG_inr, add_mul, Finset.sum_add_distrib]
    have hGC : (∑ j : Fin clock.m, clock.G b j * clock.C j c_last) =
        (clock.G * clock.C) b c_last := rfl
    have hvC : (∑ j : Fin clock.m, clock.v j * clock.C j c_last) =
        (Matrix.vecMul clock.v clock.C) c_last := rfl
    rw [hGC, hvC, clock.hclock, clock.hvC, mul_N_mat_apply]
    have hnot : ¬ (c_last.val + 1 < w) := by
      change ¬ (w - 1 + 1 < w)
      omega
    have he0_last : e0_row w c_last = 0 := by
      simp only [e0_row, c_last]
      split_ifs with h
      · omega
      · rfl
    simp [hnot, he0_last]

/-- Deficit column $w$ vanishes: `D_uniform x ⟨w, _⟩ = 0`. -/
theorem D_uniform_last_col_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (x : Fin (clock.m + 1)) :
    D_uniform hw clock b c_step H0 delta x ⟨w, Nat.lt_succ_self w⟩ = 0 := by
  dsimp [D_uniform, D_deficit]
  rw [mul_N_mat_last_col_zero]
  rw [AdjoinLeaderEndpointG_mul_X_last_col_zero hw clock b x, sub_zero]

/-- Gateway interaction table $K = D^\top X$. -/
def K_uniform {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock

/-- Matrix `K_uniform` has zero row $w$: `K_uniform ⟨w, _⟩ j = 0`. -/
theorem K_uniform_last_row_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (j : Fin (w + 1)) :
    K_uniform hw clock b c_step H0 delta ⟨w, Nat.lt_succ_self w⟩ j = 0 := by
  dsimp [K_uniform]
  rw [Matrix.mul_apply]
  simp only [Matrix.transpose_apply]
  have h_zero : ∀ x : Fin (clock.m + 1), D_uniform hw clock b c_step H0 delta x ⟨w, Nat.lt_succ_self w⟩ = 0 :=
    D_uniform_last_col_zero hw clock b c_step H0 delta
  simp only [h_zero, zero_mul, Finset.sum_const_zero]

/-- Sparse gateway error matrix $F_{\mathrm{gw}} = K - v_{\mathrm{step}}^\top \vec{x}_{\mathrm{sum}}$. -/
def F_gw_uniform {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  K_uniform hw clock b c_step H0 delta - G_outer_target hw clock b c_step

/-- Row $w$ of `F_gw_uniform` is identically zero: `F_gw_uniform ⟨w, _⟩ j = 0`. -/
theorem F_gw_uniform_last_row_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (j : Fin (w + 1)) :
    F_gw_uniform hw clock b c_step H0 delta ⟨w, Nat.lt_succ_self w⟩ j = 0 := by
  dsimp [F_gw_uniform, G_outer_target]
  rw [K_uniform_last_row_zero hw clock b c_step H0 delta j]
  rw [v_step_top (by omega) clock b c_step, zero_mul, sub_zero]

theorem v_step_zero {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m) (c_step : ℚ) :
    v_step hw clock b c_step ⟨0, Nat.succ_pos w⟩ = c_step := by
  dsimp [v_step]
  have h : 0 < w := by omega
  simp only [h, ↓reduceDIte]
  ring

theorem h_uniform_one_eq_c_step {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) :
    h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step ⟨1, by omega⟩ = c_step := by
  have heq := h_uniform_zeta_canonical_eq (by omega) clock b c_step H0 ⟨1, by omega⟩
  have h_step := congr_fun (vecMul_zeta_canonical_one_sub_B_mat (by omega) clock b c_step H0) ⟨1, by omega⟩
  simp only [Matrix.vecMul_sub, Matrix.vecMul_one, Pi.sub_apply] at h_step
  have hzeta1 : zeta_canonical (by omega) clock b c_step H0 ⟨1, by omega⟩ =
      c_step + clock.R b ⟨1, by omega⟩ := by
    unfold zeta_canonical
    split_ifs <;> try contradiction
    have h_cprev : (⟨1 - 1, by omega⟩ : Fin (w + 1)) = ⟨0, Nat.succ_pos w⟩ := by ext; rfl
    rw [h_cprev]
    simp only [Matrix.vecMul_add, Matrix.vecMul_one, Pi.add_apply]
    rw [v_step_zero (by omega) clock b c_step]
    have h_N : Matrix.vecMul (v_step (by omega) clock b c_step) (N_mat (w + 1)) ⟨0, Nat.succ_pos w⟩ =
        clock.R b ⟨1, by omega⟩ := by
      rw [vecMul_N_mat_apply]
      have hlt : 0 + 1 < w + 1 := by omega
      simp only [hlt, ↓reduceDIte]
      have h1_w : (⟨0 + 1, hlt⟩ : Fin (w + 1)) = ⟨1, by omega⟩ := by ext; rfl
      rw [h1_w]
      dsimp [v_step]
      have h1_lt_w : 1 < w := by omega
      simp only [h1_lt_w, ↓reduceDIte, sub_zero, add_zero]
    rw [h_N]
  have hv_step1 : v_step (by omega) clock b c_step ⟨1, by omega⟩ = clock.R b ⟨1, by omega⟩ := by
    dsimp [v_step]
    have h1_lt_w : 1 < w := by omega
    simp only [h1_lt_w, ↓reduceDIte, sub_zero, add_zero]
  have h0 : ¬ ((⟨1, by omega⟩ : Fin (w + 1)).val = 0) := by
    intro h
    change 1 = 0 at h
    contradiction
  simp only [h0, ↓reduceIte, sub_zero] at heq
  linarith

/-- Deficit row evaluation on parent actions at column 0:
    $D_{\mathrm{uniform}}(\mathrm{inl } i, 0) = c_{\mathrm{step}} + G b i + v i$. -/
theorem D_uniform_inl_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (i : Fin clock.m) :
    D_uniform hw clock b c_step H0 delta (finSumFinEquiv (Sum.inl i)) 0 =
      c_step + clock.G b i + clock.v i := by
  have h0 : (0 : Fin (w + 1)) = ⟨0, Nat.succ_pos w⟩ := rfl
  change (S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta *
      N_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) 0 -
      (AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock) (finSumFinEquiv (Sum.inl i)) 0 = _
  rw [h0]
  have hSN : (S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta *
      N_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) ⟨0, Nat.succ_pos w⟩ = c_step := by
    rw [mul_N_mat_apply]
    have hlt : 0 + 1 < w + 1 := by omega
    simp only [hlt, ↓reduceDIte]
    have h1 : (⟨0 + 1, hlt⟩ : Fin (w + 1)) = ⟨1, by omega⟩ := by ext; rfl
    rw [h1]
    simp only [S_uniform, Matrix.of_apply, Equiv.symm_apply_apply]
    have hne : ¬ ((1 : ℕ) = 0) := by decide
    simp only [hne, ↓reduceIte, zero_add]
    exact h_uniform_one_eq_c_step hw clock b c_step H0
  have hGX : (AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock) (finSumFinEquiv (Sum.inl i)) ⟨0, Nat.succ_pos w⟩ =
      - (clock.G b i + clock.v i) := by
    let c0 : Fin (w + 1) := ⟨0, Nat.succ_pos w⟩
    have hcomp :=
      (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) =>
        AdjoinLeaderEndpointG clock.G b clock.v (finSumFinEquiv (Sum.inl i)) y * X_gateway clock y c0).symm
    rw [Matrix.mul_apply, hcomp, Fintype.sum_sum_type]
    have hX_inl : ∀ j : Fin clock.m, X_gateway clock (finSumFinEquiv (Sum.inl j)) c0 = 0 := by
      intro j
      simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, shiftRightCount, c0]
      have hnot : ¬ (0 < 0) := lt_irrefl 0
      simp
    have he0_0 : e0_row (w + 1) c0 = 1 := by
      simp only [e0_row, c0, ↓reduceIte]
    have hX_inr : ∀ j : Fin 1, X_gateway clock (finSumFinEquiv (Sum.inr j)) c0 = 1 := by
      intro j
      simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, he0_0]
    simp only [hX_inl, mul_zero, Finset.sum_const_zero, zero_add]
    have hG_inr : ∀ j : Fin 1,
        AdjoinLeaderEndpointG clock.G b clock.v (finSumFinEquiv (Sum.inl i)) (finSumFinEquiv (Sum.inr j)) =
          - (clock.G b i + clock.v i) := by
      intro j
      simp only [AdjoinLeaderEndpointG, Matrix.of_apply, Equiv.symm_apply_apply]
    simp only [hG_inr, hX_inr, mul_one, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
      Nat.cast_one, one_mul]
  rw [hSN, hGX]
  ring

/-- Top-degree column vanishing of $F_{\mathrm{gw}}$ at row 0: $(F_{\mathrm{gw}})_{0, w} = 0$. -/
theorem F_gw_uniform_zero_last_col {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) :
    F_gw_uniform hw clock b c_step H0 delta ⟨0, Nat.succ_pos w⟩ ⟨w, Nat.lt_succ_self w⟩ = 0 := by
  dsimp [F_gw_uniform, G_outer_target, K_uniform]
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  have hv0 : v_step (by omega) clock b c_step 0 = c_step := v_step_zero (by omega) clock b c_step
  rw [hv0]
  let cw : Fin (w + 1) := ⟨w, Nat.lt_succ_self w⟩
  let c_last : Fin w := ⟨w - 1, by omega⟩
  change (∑ y : Fin (clock.m + 1), D_uniform hw clock b c_step H0 delta y 0 * X_gateway clock y cw) -
      c_step * x_sum_uniform clock cw = 0
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) =>
      D_uniform hw clock b c_step H0 delta y 0 * X_gateway clock y cw).symm
  rw [hcomp, Fintype.sum_sum_type]
  have he0_w : e0_row (w + 1) cw = 0 := by
    simp only [e0_row, cw]
    split_ifs with h
    · omega
    · rfl
  have hX_inr : ∀ j : Fin 1, X_gateway clock (finSumFinEquiv (Sum.inr j)) cw = 0 := by
    intro j
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, he0_w]
  simp only [hX_inr, mul_zero, Finset.sum_const_zero, add_zero]
  have hX_inl : ∀ j : Fin clock.m,
      X_gateway clock (finSumFinEquiv (Sum.inl j)) cw = clock.C j c_last := by
    intro j
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply,
      shiftRightCount, cw, c_last]
    split_ifs with h
    · rfl
    · omega
  simp_rw [hX_inl]
  have hD := fun i => D_uniform_inl_zero hw clock b c_step H0 delta i
  simp_rw [hD]
  have hsum_split : (∑ x : Fin clock.m, (c_step + clock.G b x + clock.v x) * clock.C x c_last) =
      c_step * (∑ x : Fin clock.m, clock.C x c_last) +
      (∑ x : Fin clock.m, clock.G b x * clock.C x c_last) +
      (∑ x : Fin clock.m, clock.v x * clock.C x c_last) := by
    simp only [add_mul]
    rw [Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.mul_sum]
  rw [hsum_split]
  have hGC : (∑ x : Fin clock.m, clock.G b x * clock.C x c_last) =
      (clock.G * clock.C) b c_last := rfl
  have hvC : (∑ x : Fin clock.m, clock.v x * clock.C x c_last) =
      (Matrix.vecMul clock.v clock.C) c_last := rfl
  rw [hGC, hvC, clock.hclock, clock.hvC, mul_N_mat_apply]
  have hnot : ¬ (c_last.val + 1 < w) := by
    change ¬ (w - 1 + 1 < w)
    omega
  have he0_last : e0_row w c_last = 0 := by
    simp only [e0_row, c_last]
    split_ifs with h
    · omega
    · rfl
  simp only [hnot, ↓reduceDIte, he0_last, add_zero]
  have hx_sum : x_sum_uniform clock cw = ∑ x : Fin clock.m, clock.C x c_last := by
    dsimp [x_sum_uniform, Matrix.vecMul, dotProduct]
    have hsum_cw :=
      (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) =>
        (1 : ℚ) * X_gateway clock y cw).symm
    rw [hsum_cw, Fintype.sum_sum_type]
    simp only [one_mul, hX_inr, Finset.sum_const_zero, add_zero, hX_inl]
  rw [hx_sum]
  ring

/-- **Unconditional Anti-Symmetry of `F_gw_uniform` at Top Degree**:
    $(F_{\mathrm{gw}})_{0, w} + (F_{\mathrm{gw}})_{w, 0} = 0$. -/
theorem F_gw_uniform_anti {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) :
    F_gw_uniform hw clock b c_step H0 delta ⟨0, Nat.succ_pos w⟩ ⟨w, Nat.lt_succ_self w⟩ +
      F_gw_uniform hw clock b c_step H0 delta ⟨w, Nat.lt_succ_self w⟩ ⟨0, Nat.succ_pos w⟩ = 0 := by
  have hw0 := F_gw_uniform_last_row_zero hw clock b c_step H0 delta ⟨0, Nat.succ_pos w⟩
  have h0w := F_gw_uniform_zero_last_col hw clock b c_step H0 delta
  rw [hw0, h0w, add_zero]

/-- Positive row evaluation of `v_step`. -/
theorem v_step_pos {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m) (c_step : ℚ)
    (c : Fin (w + 1)) (hc_pos : 0 < c.val) :
    v_step hw clock b c_step c = if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0 := by
  dsimp [v_step]
  have h0 : ¬ (c.val = 0) := by omega
  simp [h0]

/-- The shift identity $h_{\mathrm{uniform}}(r + 1) = v_{\mathrm{step}}(r)$ for $0 < r < w$. -/
theorem h_uniform_succ_eq_v_step {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) (r : Fin (w + 1)) (hr_pos : 0 < r.val) (hr_lt : r.val < w) :
    h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step ⟨r.val + 1, by omega⟩ =
      v_step (by omega) clock b c_step r := by
  have hr_succ_ne : ¬ (r.val + 1 = 0) := by omega
  have hzeta : zeta_canonical (by omega) clock b c_step H0 ⟨r.val + 1, by omega⟩ =
      v_step (by omega) clock b c_step r +
        if hc : r.val + 1 < w then clock.R b ⟨r.val + 1, hc⟩ else 0 := by
    unfold zeta_canonical
    simp only [hr_succ_ne, ↓reduceDIte]
    have hr_prev : (⟨r.val + 1 - 1, by omega⟩ : Fin (w + 1)) = r := by
      ext
      dsimp
    rw [hr_prev]
    simp only [Matrix.vecMul_add, Matrix.vecMul_one, Pi.add_apply]
    rw [vecMul_N_mat_apply]
    have h_next : r.val + 1 < w + 1 := by omega
    simp only [h_next, ↓reduceDIte]
    have hr_pos' : 0 < (⟨r.val + 1, h_next⟩ : Fin (w + 1)).val := by
      dsimp
      omega
    rw [v_step_pos (by omega) clock b c_step ⟨r.val + 1, h_next⟩ hr_pos']
  dsimp [h_uniform]
  rw [hzeta]
  split_ifs <;> ring

/-- Positive deficit rows for parent actions:
    $D(\mathrm{inl } i, r) = v_{\mathrm{step}}(r) - (G C)_{i, r-1}$. -/
theorem D_uniform_inl_pos {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (i : Fin clock.m) (r : Fin (w + 1))
    (hr_pos : 0 < r.val) (hr_lt : r.val < w) :
    let r_prev : Fin w := ⟨r.val - 1, by omega⟩
    D_uniform hw clock b c_step H0 delta (finSumFinEquiv (Sum.inl i)) r =
      v_step (by omega) clock b c_step r - (clock.G * clock.C) i r_prev := by
  intro r_prev
  dsimp [D_uniform, D_deficit]
  have hSN : (S_uniform (by omega) clock b
      (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta *
      N_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) r =
      v_step (by omega) clock b c_step r := by
    rw [mul_N_mat_apply]
    have hr_succ_lt : r.val + 1 < w + 1 := by omega
    simp only [hr_succ_lt, ↓reduceDIte]
    simp only [S_uniform, Matrix.of_apply, Equiv.symm_apply_apply]
    have hr_succ_ne : ¬ (r.val + 1 = 0) := by omega
    simp only [hr_succ_ne, ↓reduceIte, zero_add]
    exact h_uniform_succ_eq_v_step hw clock b c_step H0 r hr_pos hr_lt
  have hGX : (AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock) (finSumFinEquiv (Sum.inl i)) r =
      (clock.G * clock.C) i r_prev := by
    have hcomp :=
      (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) =>
        AdjoinLeaderEndpointG clock.G b clock.v (finSumFinEquiv (Sum.inl i)) y * X_gateway clock y r).symm
    rw [Matrix.mul_apply, hcomp, Fintype.sum_sum_type]
    have he0_r : e0_row (w + 1) r = 0 := by
      simp only [e0_row]
      split_ifs with h
      · omega
      · rfl
    have hX_inr : ∀ j : Fin 1, X_gateway clock (finSumFinEquiv (Sum.inr j)) r = 0 := by
      intro j
      simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, he0_r]
    simp only [hX_inr, mul_zero, Finset.sum_const_zero, add_zero]
    have hX_inl : ∀ j : Fin clock.m,
        X_gateway clock (finSumFinEquiv (Sum.inl j)) r = clock.C j r_prev := by
      intro j
      simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply,
        shiftRightCount, hr_pos, r_prev]
      rfl
    simp_rw [hX_inl]
    have hG_inl : ∀ j : Fin clock.m,
        AdjoinLeaderEndpointG clock.G b clock.v (finSumFinEquiv (Sum.inl i)) (finSumFinEquiv (Sum.inl j)) =
          clock.G i j := by
      intro j
      simp only [AdjoinLeaderEndpointG, Matrix.of_apply, Equiv.symm_apply_apply]
    simp_rw [hG_inl]
    rfl
  change (S_uniform (by omega) clock b
      (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta *
      N_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) r -
      (AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock) (finSumFinEquiv (Sum.inl i)) r = _
  rw [hSN, hGX]

/-- Interaction matrix $K_{\mathrm{uniform}}$ on positive indices:
    $K(r, c) = v_{\mathrm{step}}(r) x_{\mathrm{sum}}(c) - (C^\top G C)_{c-1, r-1}$. -/
theorem K_uniform_pos {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (r c : Fin (w + 1))
    (hr_pos : 0 < r.val) (hr_lt : r.val < w) (hc_pos : 0 < c.val) :
    let r_prev : Fin w := ⟨r.val - 1, by omega⟩
    let c_prev : Fin w := ⟨c.val - 1, by omega⟩
    K_uniform hw clock b c_step H0 delta r c =
      v_step (by omega) clock b c_step r * x_sum_uniform clock c -
        (clock.C.transpose * clock.G * clock.C) c_prev r_prev := by
  intro r_prev c_prev
  dsimp [K_uniform]
  rw [Matrix.mul_apply]
  simp only [Matrix.transpose_apply]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) =>
      D_uniform hw clock b c_step H0 delta y r * X_gateway clock y c).symm
  rw [hcomp, Fintype.sum_sum_type]
  have he0_c : e0_row (w + 1) c = 0 := by
    simp only [e0_row]
    split_ifs with h
    · omega
    · rfl
  have hX_inr : ∀ j : Fin 1, X_gateway clock (finSumFinEquiv (Sum.inr j)) c = 0 := by
    intro j
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply, he0_c]
  simp only [hX_inr, mul_zero, Finset.sum_const_zero, add_zero]
  have hX_inl : ∀ j : Fin clock.m,
      X_gateway clock (finSumFinEquiv (Sum.inl j)) c = clock.C j c_prev := by
    intro j
    simp only [X_gateway, X_coupled, Matrix.of_apply, Equiv.symm_apply_apply,
      shiftRightCount, hc_pos, c_prev]
    rfl


  simp_rw [hX_inl]
  have hD := fun i => D_uniform_inl_pos hw clock b c_step H0 delta i r hr_pos hr_lt
  simp_rw [hD]
  have hsum_split : (∑ x : Fin clock.m, (v_step (by omega) clock b c_step r - (clock.G * clock.C) x r_prev) * clock.C x c_prev) =
      v_step (by omega) clock b c_step r * (∑ x : Fin clock.m, clock.C x c_prev) -
      (∑ x : Fin clock.m, (clock.G * clock.C) x r_prev * clock.C x c_prev) := by
    simp only [sub_mul]
    rw [Finset.sum_sub_distrib, Finset.mul_sum]
  rw [hsum_split]
  have hx_sum : x_sum_uniform clock c = ∑ x : Fin clock.m, clock.C x c_prev := by
    dsimp [x_sum_uniform, Matrix.vecMul, dotProduct]
    have hsum_c :=
      (Equiv.sum_comp finSumFinEquiv fun y : Fin (clock.m + 1) =>
        (1 : ℚ) * X_gateway clock y c).symm
    rw [hsum_c, Fintype.sum_sum_type]
    simp only [one_mul, hX_inr, Finset.sum_const_zero, add_zero, hX_inl]
  rw [hx_sum]
  have hCGC : (clock.C.transpose * clock.G * clock.C) c_prev r_prev =
      ∑ x : Fin clock.m, (clock.G * clock.C) x r_prev * clock.C x c_prev := by
    rw [Matrix.mul_assoc]
    rw [Matrix.mul_apply]
    simp only [Matrix.transpose_apply]
    refine Finset.sum_congr rfl fun x _ => by ring
  rw [hCGC]

/-- Gateway error matrix entry on positive coordinates:
    $F_{\mathrm{gw}}(r, c) = - (C^\top G C)_{c-1, r-1}$. -/
theorem F_gw_uniform_pos {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (r c : Fin (w + 1))
    (hr_pos : 0 < r.val) (hr_lt : r.val < w) (hc_pos : 0 < c.val) :
    let r_prev : Fin w := ⟨r.val - 1, by omega⟩
    let c_prev : Fin w := ⟨c.val - 1, by omega⟩
    F_gw_uniform hw clock b c_step H0 delta r c =
      - (clock.C.transpose * clock.G * clock.C) c_prev r_prev := by
  intro r_prev c_prev
  dsimp [F_gw_uniform, G_outer_target]
  rw [K_uniform_pos hw clock b c_step H0 delta r c hr_pos hr_lt hc_pos]
  ring

/-- Universal vanishing of sparse gateway support error whenever $C^\top G C = 0$. -/
theorem F_gw_uniform_supp_of_CGC_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ)
    (hCGC : clock.C.transpose * clock.G * clock.C = 0) :
    ∀ i j : Fin (w + 1), 0 < i.val → 0 < j.val →
      F_gw_uniform hw clock b c_step H0 delta i j = 0 := by
  intro i j hi hj
  by_cases hi_w : i.val = w
  · have hi_eq : i = ⟨w, Nat.lt_succ_self w⟩ := by ext; exact hi_w
    rw [hi_eq]
    exact F_gw_uniform_last_row_zero hw clock b c_step H0 delta j
  · have hi_lt : i.val < w := by
      have := i.isLt
      omega
    rw [F_gw_uniform_pos hw clock b c_step H0 delta i j hi hi_lt hj]
    rw [hCGC]
    rfl

/-- Vanishing of the inner cone interaction $C^\top G C = 0$ for the RPS seed clock. -/
theorem rps_CGC_zero :
    rpsAlgebraicClock.C.transpose * rpsAlgebraicClock.G * rpsAlgebraicClock.C = 0 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_three, rpsAlgebraicClock, A_RPS, C2] <;> norm_num

/-- **Unconditional Sparse Gateway Support for the RPS Clock**:
    Zero hypotheses required! -/
theorem rps_F_gw_supp (b : Fin rpsAlgebraicClock.m) (c_step H0 delta : ℚ) :
    ∀ i j : Fin 3, 0 < i.val → 0 < j.val →
      F_gw_uniform (by norm_num) rpsAlgebraicClock b c_step H0 delta i j = 0 :=
  F_gw_uniform_supp_of_CGC_zero (by norm_num) rpsAlgebraicClock b c_step H0 delta rps_CGC_zero




/-- Uniform reset count row $\vec{\ell} = \alpha \vec{\zeta} - \vec{y}$. -/
def ell_uniform {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 alpha : ℚ) : Fin (w + 1) → ℚ :=
  alpha • zeta_canonical (by omega) clock b c_step H0 - y_sum_uniform clock

/-- First outer term $E_1 = - \vec{y}^\top v_{\mathrm{step}}$. -/
def E_outer1 {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m) (c_step : ℚ) :
    Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  Matrix.of fun i j => - (y_sum_uniform clock i * v_step (by omega) clock b c_step j)

/-- Second outer term $E_2 = \alpha \vec{\zeta}^\top \vec{\zeta}$. -/
def E_outer2 {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 alpha : ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  Matrix.of fun i j => alpha * zeta_canonical (by omega) clock b c_step H0 i *
    zeta_canonical (by omega) clock b c_step H0 j

/-- Inversion identity for $\vec{y} B = \vec{x}_{\mathrm{sum}}$. -/
theorem vecMul_y_sum_B_mat {w : ℕ} (clock : AlgebraicClock w) :
    Matrix.vecMul (y_sum_uniform clock) (B_mat (w + 1)) = x_sum_uniform clock := by
  dsimp [y_sum_uniform]
  rw [Matrix.vecMul_vecMul, one_add_N_mul_B_mat (w + 1), Matrix.vecMul_one]

/-- Moment equation for $E_1$: $E_1 - E_1^\top B = v_{\mathrm{step}}^\top \vec{x}_{\mathrm{sum}} - \vec{y}^\top v_{\mathrm{step}}$. -/
theorem E_outer1_moment {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step : ℚ) (i j : Fin (w + 1)) :
    (E_outer1 hw clock b c_step - (E_outer1 hw clock b c_step).transpose * B_mat (w + 1)) i j =
      v_step (by omega) clock b c_step i * x_sum_uniform clock j -
        y_sum_uniform clock i * v_step (by omega) clock b c_step j := by
  simp only [E_outer1, Matrix.sub_apply, Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply]
  have h_sum : (∑ k : Fin (w + 1), -(y_sum_uniform clock k * v_step (by omega) clock b c_step i) * B_mat (w + 1) k j) =
      - v_step (by omega) clock b c_step i * Matrix.vecMul (y_sum_uniform clock) (B_mat (w + 1)) j := by
    simp only [Matrix.vecMul, dotProduct]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => by ring
  rw [h_sum, vecMul_y_sum_B_mat clock]
  ring

/-- Moment equation for $E_2$: $E_2 - E_2^\top B = \alpha \vec{\zeta}^\top v_{\mathrm{step}}$. -/
theorem E_outer2_moment {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 alpha : ℚ) (i j : Fin (w + 1)) :
    (E_outer2 hw clock b c_step H0 alpha - (E_outer2 hw clock b c_step H0 alpha).transpose * B_mat (w + 1)) i j =
      alpha * zeta_canonical (by omega) clock b c_step H0 i * v_step (by omega) clock b c_step j := by
  simp only [E_outer2, Matrix.sub_apply, Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply]
  have h_sum : (∑ k : Fin (w + 1),
      (alpha * zeta_canonical (by omega) clock b c_step H0 k * zeta_canonical (by omega) clock b c_step H0 i) *
        B_mat (w + 1) k j) =
      alpha * zeta_canonical (by omega) clock b c_step H0 i *
        Matrix.vecMul (zeta_canonical (by omega) clock b c_step H0) (B_mat (w + 1)) j := by
    simp only [Matrix.vecMul, dotProduct]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => by ring
  rw [h_sum]
  have h_step := congr_fun (vecMul_zeta_canonical_one_sub_B_mat (by omega) clock b c_step H0) j
  simp only [Matrix.vecMul_sub, Matrix.vecMul_one, Pi.sub_apply] at h_step
  have h_mul : alpha * zeta_canonical (by omega) clock b c_step H0 i * zeta_canonical (by omega) clock b c_step H0 j -
      alpha * zeta_canonical (by omega) clock b c_step H0 i *
        Matrix.vecMul (zeta_canonical (by omega) clock b c_step H0) (B_mat (w + 1)) j =
      alpha * zeta_canonical (by omega) clock b c_step H0 i *
        (zeta_canonical (by omega) clock b c_step H0 j -
          Matrix.vecMul (zeta_canonical (by omega) clock b c_step H0) (B_mat (w + 1)) j) := by ring
  rw [h_mul, h_step]

/-- Identification of $\psi_{\mathrm{row}} \vec{\zeta} B = - v_{\mathrm{step}}$. -/
theorem psi_row_zeta_canonical_eq {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) (j : Fin (w + 1)) :
    psi_row (zeta_canonical (by omega) clock b c_step H0) (B_mat (w + 1)) () j =
      - v_step (by omega) clock b c_step j := by
  simp only [psi_row, zeta_row, Matrix.sub_apply, Matrix.mul_apply, Matrix.of_apply]
  have h_step := congr_fun (vecMul_zeta_canonical_one_sub_B_mat (by omega) clock b c_step H0) j
  simp only [Matrix.vecMul_sub, Matrix.vecMul_one, Pi.sub_apply] at h_step
  have h_sum : (∑ k : Fin (w + 1), zeta_canonical (by omega) clock b c_step H0 k * B_mat (w + 1) k j) =
      Matrix.vecMul (zeta_canonical (by omega) clock b c_step H0) (B_mat (w + 1)) j := rfl
  rw [h_sum]
  linarith

/-- Identification of the coupling target $\ell^\top \psi = - \vec{\ell}^\top v_{\mathrm{step}}$. -/
theorem ell_psi_row_apply {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 alpha : ℚ) (i j : Fin (w + 1)) :
    ((Matrix.of fun (_ : Unit) c => ell_uniform hw clock b c_step H0 alpha c).transpose *
      psi_row (zeta_canonical (by omega) clock b c_step H0) (B_mat (w + 1))) i j =
      - (ell_uniform hw clock b c_step H0 alpha i * v_step (by omega) clock b c_step j) := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Fintype.univ_punit, Finset.sum_singleton]
  rw [psi_row_zeta_canonical_eq hw clock b c_step H0]
  ring

/-- Sum of the two outer parts $E_{\mathrm{outer}} = E_1 + E_2$. -/
def E_outer {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 alpha : ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  E_outer1 hw clock b c_step + E_outer2 hw clock b c_step H0 alpha

/-- Combined moment equation for $E_{\mathrm{outer}}$:
    $E_{\mathrm{outer}} - E_{\mathrm{outer}}^\top B = v_{\mathrm{step}}^\top \vec{x}_{\mathrm{sum}} + \vec{\ell}^\top v_{\mathrm{step}}$. -/
theorem E_outer_moment {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 alpha : ℚ) :
    E_outer hw clock b c_step H0 alpha - (E_outer hw clock b c_step H0 alpha).transpose * B_mat (w + 1) =
      Matrix.of (fun i j => v_step (by omega) clock b c_step i * x_sum_uniform clock j +
        ell_uniform hw clock b c_step H0 alpha i * v_step (by omega) clock b c_step j) := by
  dsimp [E_outer]
  rw [matrix_moment_add]
  ext i j
  simp only [Matrix.add_apply, Matrix.of_apply]
  rw [E_outer1_moment hw clock b c_step i j, E_outer2_moment hw clock b c_step H0 alpha i j]
  dsimp [ell_uniform]
  ring

/-- Full Moment matrix $E_{\mathrm{uniform}} = E_{\mathrm{rank2}}(F_{\mathrm{gw}}) + E_{\mathrm{outer}}$. -/
def E_uniform {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta alpha : ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  E_rank2 (F_gw_uniform hw clock b c_step H0 delta) +
    E_outer hw clock b c_step H0 alpha

/-- **Master Moment Equation for $S_{\mathrm{uniform}}$ and $\zeta_{\mathrm{canonical}}$**:
    Under the sparse gateway support condition, $E_{\mathrm{uniform}}$ solves the Moment Equation identically:
    $E - E^\top B = D^\top X - \ell^\top \psi$.
    The anti-symmetry condition `hF_anti` is discharged unconditionally by `F_gw_uniform_anti`. -/
theorem E_uniform_moment_equation {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta alpha : ℚ)
    (hF_supp : ∀ i j : Fin (w + 1), 0 < i.val → 0 < j.val →
      F_gw_uniform hw clock b c_step H0 delta i j = 0) :
    E_uniform hw clock b c_step H0 delta alpha -
      (E_uniform hw clock b c_step H0 delta alpha).transpose * B_mat (w + 1) =
    (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
      (Matrix.of fun (_ : Unit) c => ell_uniform hw clock b c_step H0 alpha c).transpose *
        psi_row (zeta_canonical (by omega) clock b c_step H0) (B_mat (w + 1)) := by
  have hF_anti := F_gw_uniform_anti hw clock b c_step H0 delta
  have h_r2 := E_rank2_solves_moment (by omega) (F_gw_uniform hw clock b c_step H0 delta) hF_supp hF_anti
  dsimp [E_uniform]
  rw [matrix_moment_add, h_r2, E_outer_moment]
  ext i j
  simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.of_apply]
  rw [ell_psi_row_apply hw clock b c_step H0 alpha i j]
  dsimp [F_gw_uniform, K_uniform, G_outer_target]
  ring

/-- **Master Moment Equation for Clocks with $C^\top G C = 0$**:
    For any algebraic clock with vanishing inner cone interaction (such as RPS),
    the moment equation holds with zero sparse support hypotheses:
    both `hF_supp` and `hF_anti` are discharged unconditionally. -/
theorem E_uniform_moment_equation_of_CGC_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta alpha : ℚ)
    (hCGC : clock.C.transpose * clock.G * clock.C = 0) :
    E_uniform hw clock b c_step H0 delta alpha -
      (E_uniform hw clock b c_step H0 delta alpha).transpose * B_mat (w + 1) =
    (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
      (Matrix.of fun (_ : Unit) c => ell_uniform hw clock b c_step H0 alpha c).transpose *
        psi_row (zeta_canonical (by omega) clock b c_step H0) (B_mat (w + 1)) :=
  E_uniform_moment_equation hw clock b c_step H0 delta alpha
    (F_gw_uniform_supp_of_CGC_zero hw clock b c_step H0 delta hCGC)

/-- **Completely Unconditional Moment Equation for the RPS Seed Clock**:
    Zero `hF` hypotheses (`hF_supp` and `hF_anti` completely eliminated)!
    Proves that $E_{\mathrm{uniform}}$ exactly solves the master moment equation
    $\mathcal{L}(E) = D^\top X - \ell^\top \psi$ for the canonical 3-action RPS clock. -/
theorem rps_E_uniform_moment_equation (b : Fin rpsAlgebraicClock.m)
    (c_step H0 delta alpha : ℚ) :
    E_uniform (by norm_num) rpsAlgebraicClock b c_step H0 delta alpha -
      (E_uniform (by norm_num) rpsAlgebraicClock b c_step H0 delta alpha).transpose * B_mat 3 =
    (D_uniform (by norm_num) rpsAlgebraicClock b c_step H0 delta).transpose * X_gateway rpsAlgebraicClock -
      (Matrix.of fun (_ : Unit) c => ell_uniform (by norm_num) rpsAlgebraicClock b c_step H0 alpha c).transpose *
        psi_row (zeta_canonical (by norm_num) rpsAlgebraicClock b c_step H0) (B_mat 3) :=
  E_uniform_moment_equation (by norm_num) rpsAlgebraicClock b c_step H0 delta alpha
    (rps_F_gw_supp b c_step H0 delta)





-- Pure structural definition of U(k, i) on G
def U_mat (G : ℕ → ℕ → ℚ) : ℕ → ℕ → ℚ
  | 0, _ => 0
  | 1, i => G i i
  | 2, i => G i (i + 1) + G (i + 1) i - U_mat G 1 (i + 1)
  | k + 3, i =>
      G i (i + k + 2) + G (i + k + 2) i + G (i + 1) (i + k + 2) -
        U_mat G (k + 1) (i + 1) - U_mat G (k + 2) (i + 1)

-- Lemma A: U_mat depends only on rows ≥ r
theorem U_mat_congr_of_ge (G₁ G₂ : ℕ → ℕ → ℚ) (r : ℕ)
    (h : ∀ a ≥ r, ∀ b, G₁ a b = G₂ a b) :
    ∀ k, U_mat G₁ k r = U_mat G₂ k r
  | 0 => rfl
  | 1 => by
      show G₁ r r = G₂ r r
      exact h r (by omega) r
  | 2 => by
      show G₁ r (r + 1) + G₁ (r + 1) r - U_mat G₁ 1 (r + 1) =
           G₂ r (r + 1) + G₂ (r + 1) r - U_mat G₂ 1 (r + 1)
      have h1 := h r (by omega) (r + 1)
      have h2 := h (r + 1) (by omega) r
      have h3 := U_mat_congr_of_ge G₁ G₂ (r + 1) (fun a ha => h a (by omega)) 1
      rw [h1, h2, h3]
  | k + 3 => by
      show G₁ r (r + k + 2) + G₁ (r + k + 2) r + G₁ (r + 1) (r + k + 2) -
             U_mat G₁ (k + 1) (r + 1) - U_mat G₁ (k + 2) (r + 1) =
           G₂ r (r + k + 2) + G₂ (r + k + 2) r + G₂ (r + 1) (r + k + 2) -
             U_mat G₂ (k + 1) (r + 1) - U_mat G₂ (k + 2) (r + 1)
      have h1 := h r (by omega) (r + k + 2)
      have h2 := h (r + k + 2) (by omega) r
      have h3 := h (r + 1) (by omega) (r + k + 2)
      have h4 := U_mat_congr_of_ge G₁ G₂ (r + 1) (fun a ha => h a (by omega)) (k + 1)
      have h5 := U_mat_congr_of_ge G₁ G₂ (r + 1) (fun a ha => h a (by omega)) (k + 2)
      rw [h1, h2, h3, h4, h5]

-- Lemma B: U_mat difference when G₁ and G₂ agree on rows ≥ r + 1
theorem U_mat_sub_of_gt (G₁ G₂ : ℕ → ℕ → ℚ) (r : ℕ)
    (h : ∀ a ≥ r + 1, ∀ b, G₁ a b = G₂ a b) :
    ∀ k ≥ 1, U_mat G₁ k r - U_mat G₂ k r = G₁ r (r + k - 1) - G₂ r (r + k - 1)
  | 1, _ => by
      show G₁ r r - G₂ r r = G₁ r (r + 1 - 1) - G₂ r (r + 1 - 1)
      have heq : r + 1 - 1 = r := by omega
      rw [heq]
  | 2, _ => by
      show G₁ r (r + 1) + G₁ (r + 1) r - U_mat G₁ 1 (r + 1) -
           (G₂ r (r + 1) + G₂ (r + 1) r - U_mat G₂ 1 (r + 1)) =
           G₁ r (r + 2 - 1) - G₂ r (r + 2 - 1)
      have h2 := h (r + 1) (by omega) r
      have h3 := U_mat_congr_of_ge G₁ G₂ (r + 1) h 1
      have heq : r + 2 - 1 = r + 1 := by omega
      rw [h2, h3, heq]
      ring
  | k + 3, _ => by
      show G₁ r (r + k + 2) + G₁ (r + k + 2) r + G₁ (r + 1) (r + k + 2) -
             U_mat G₁ (k + 1) (r + 1) - U_mat G₁ (k + 2) (r + 1) -
           (G₂ r (r + k + 2) + G₂ (r + k + 2) r + G₂ (r + 1) (r + k + 2) -
             U_mat G₂ (k + 1) (r + 1) - U_mat G₂ (k + 2) (r + 1)) =
           G₁ r (r + (k + 3) - 1) - G₂ r (r + (k + 3) - 1)
      have h2 := h (r + k + 2) (by omega) r
      have h3 := h (r + 1) (by omega) (r + k + 2)
      have h4 := U_mat_congr_of_ge G₁ G₂ (r + 1) h (k + 1)
      have h5 := U_mat_congr_of_ge G₁ G₂ (r + 1) h (k + 2)
      have heq : r + (k + 3) - 1 = r + k + 2 := by omega
      rw [h2, h3, h4, h5, heq]
      ring

-- Lemma C: Boundary step
theorem U_mat_boundary_step (G : ℕ → ℕ → ℚ) (w i : ℕ)
    (h_row : ∀ a ≤ w, G w a = 0) (h_col : ∀ a ≤ w, G a w = 0)
    (h_le : i + 2 ≤ w) :
    U_mat G (w + 1 - i) i =
      - U_mat G (w - 1 - i) (i + 1) - U_mat G (w - i) (i + 1) := by
  let m := w - 2 - i
  have hm : w + 1 - i = m + 3 := by omega
  have hm1 : w - 1 - i = m + 1 := by omega
  have hm2 : w - i = m + 2 := by omega
  have heq : i + m + 2 = w := by omega
  rw [hm, hm1, hm2]
  show G i (i + m + 2) + G (i + m + 2) i + G (i + 1) (i + m + 2) -
       U_mat G (m + 1) (i + 1) - U_mat G (m + 2) (i + 1) = _
  rw [heq]
  have h1 : G i w = 0 := h_col i (by omega)
  have h2 : G w i = 0 := h_row i (by omega)
  have h3 : G (i + 1) w = 0 := h_col (i + 1) (by omega)
  rw [h1, h2, h3]
  ring

theorem U_mat_boundary_zero_step (G : ℕ → ℕ → ℚ) (w i : ℕ)
    (h_row : ∀ a ≤ w, G w a = 0) (h_col : ∀ a ≤ w, G a w = 0)
    (h_le : i + 2 ≤ w)
    (h_diag : U_mat G (w - i) (i + 1) = 0)
    (h_off : U_mat G (w - 1 - i) (i + 1) = 0) :
    U_mat G (w + 1 - i) i = 0 := by
  rw [U_mat_boundary_step G w i h_row h_col h_le]
  rw [h_diag, h_off]
  ring

theorem U_mat_boundary_base_w (G : ℕ → ℕ → ℚ) (w : ℕ)
    (h_row : ∀ a ≤ w, G w a = 0) :
    U_mat G 1 w = 0 := by
  show G w w = 0
  exact h_row w le_rfl

theorem U_mat_boundary_base_w_pred (G : ℕ → ℕ → ℚ) (w : ℕ) (hw : 1 ≤ w)
    (h_row : ∀ a ≤ w, G w a = 0) (h_col : ∀ a ≤ w, G a w = 0) :
    U_mat G 2 (w - 1) = 0 := by
  have heq : w - 1 + 1 = w := by omega
  show G (w - 1) (w - 1 + 1) + G (w - 1 + 1) (w - 1) - U_mat G 1 (w - 1 + 1) = 0
  rw [heq]
  have h1 := h_col (w - 1) (by omega)
  have h2 := h_row (w - 1) (by omega)
  have h3 : U_mat G 1 w = 0 := U_mat_boundary_base_w G w h_row
  rw [h1, h2, h3]
  ring

def G_with_ell (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ) (ell : ℕ → ℚ) (a b : ℕ) : ℚ :=
  G_base a b + ell a * (v b + v (b + 1))

def ell_seq (w : ℕ) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ) : ℕ → (ℕ → ℚ)
  | 0 => fun _ => 0
  | m + 1 =>
      let prev := ell_seq w G_base v m
      let r := w - 1 - m
      fun a => if a = r ∧ 1 ≤ r then - U_mat (G_with_ell G_base v prev) (m + 1) r / v (w - 1) else prev a

-- ell_seq vanishes at and above w
theorem ell_seq_ge_w (w : ℕ) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ) (m : ℕ) (a : ℕ) (ha : w ≤ a) :
    ell_seq w G_base v m a = 0 := by
  induction m with
  | zero => rfl
  | succ m ih =>
      dsimp [ell_seq]
      split_ifs with h
      · have : w - 1 - m < w := by omega
        have : a = w - 1 - m := h.1
        omega
      · exact ih

-- ell_seq vanishes at and below w - 1 - m
theorem ell_seq_le_r (w : ℕ) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ) (m : ℕ) (a : ℕ) (ha : a ≤ w - 1 - m) :
    ell_seq w G_base v m a = 0 := by
  induction m with
  | zero => rfl
  | succ m ih =>
      dsimp [ell_seq]
      split_ifs with h
      · have : a = w - 1 - m := h.1
        omega
      · exact ih (by omega)

theorem G_with_ell_row_w (w : ℕ) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ) (m : ℕ) (a : ℕ)
    (h_row : G_base w a = 0) :
    G_with_ell G_base v (ell_seq w G_base v m) w a = 0 := by
  dsimp [G_with_ell]
  have h_ell := ell_seq_ge_w w G_base v m w (by omega)
  rw [h_row, h_ell, zero_mul, add_zero]

theorem G_with_ell_col_w (w : ℕ) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ) (ell : ℕ → ℚ) (a : ℕ)
    (h_col : G_base a w = 0) (hv_w : v w = 0) (hv_w1 : v (w + 1) = 0) :
    G_with_ell G_base v ell a w = 0 := by
  dsimp [G_with_ell]
  rw [h_col, hv_w, hv_w1, add_zero, mul_zero, add_zero]

-- Agreement on rows ≥ r + 1 between step m and step m + 1
theorem G_with_ell_step_agree_of_gt (w : ℕ) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ) (m : ℕ) (a b : ℕ)
    (ha : w - 1 - m + 1 ≤ a) :
    G_with_ell G_base v (ell_seq w G_base v (m + 1)) a b =
      G_with_ell G_base v (ell_seq w G_base v m) a b := by
  dsimp [G_with_ell, ell_seq]
  split_ifs with h
  · have : a = w - 1 - m := h.1
    omega
  · rfl

-- At row r, on column w, G agrees because v w = 0 and v (w + 1) = 0
theorem G_with_ell_step_agree_row_r_col_w (w : ℕ) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ) (m : ℕ)
    (hv_w : v w = 0) (hv_w1 : v (w + 1) = 0) :
    G_with_ell G_base v (ell_seq w G_base v (m + 1)) (w - 1 - m) w =
      G_with_ell G_base v (ell_seq w G_base v m) (w - 1 - m) w := by
  dsimp [G_with_ell]
  rw [hv_w, hv_w1, add_zero, mul_zero, mul_zero]

-- At row r, on column w - 1, the difference is ell(r) * v (w - 1)
theorem G_with_ell_step_sub_row_r_col_w_pred (w : ℕ) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ) (m : ℕ)
    (hr : 1 ≤ w - 1 - m) (hv_w : v w = 0) (hv_nz : v (w - 1) ≠ 0) :
    G_with_ell G_base v (ell_seq w G_base v (m + 1)) (w - 1 - m) (w - 1) -
      G_with_ell G_base v (ell_seq w G_base v m) (w - 1 - m) (w - 1) =
      - U_mat (G_with_ell G_base v (ell_seq w G_base v m)) (m + 1) (w - 1 - m) := by
  let prev := ell_seq w G_base v m
  let r := w - 1 - m
  have h_prev : ell_seq w G_base v m (w - 1 - m) = 0 := ell_seq_le_r w G_base v m r (by omega)
  dsimp [G_with_ell, ell_seq]
  have h_cond : r = r ∧ 1 ≤ r := ⟨rfl, hr⟩
  rw [if_pos h_cond]
  have heq : w - 1 + 1 = w := by omega
  rw [heq, hv_w, add_zero, h_prev, zero_mul, add_zero]
  have hmul : (- U_mat (G_with_ell G_base v prev) (m + 1) r / v (w - 1)) * v (w - 1) =
      - U_mat (G_with_ell G_base v prev) (m + 1) r := div_mul_cancel₀ _ hv_nz
  linarith

-- U_mat at row r with offset m + 1 vanishes at step m + 1
theorem U_mat_step_off_diag_zero (w : ℕ) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ) (m : ℕ)
    (hm : m + 2 ≤ w) (hv_w : v w = 0) (hv_nz : v (w - 1) ≠ 0) :
    U_mat (G_with_ell G_base v (ell_seq w G_base v (m + 1))) (m + 1) (w - 1 - m) = 0 := by
  let r := w - 1 - m
  let G₁ := G_with_ell G_base v (ell_seq w G_base v (m + 1))
  let G₂ := G_with_ell G_base v (ell_seq w G_base v m)
  have hr : 1 ≤ r := by omega
  have h_agree : ∀ a ≥ r + 1, ∀ b, G₁ a b = G₂ a b := by
    intro a ha b
    exact G_with_ell_step_agree_of_gt w G_base v m a b ha
  have h_sub := U_mat_sub_of_gt G₁ G₂ r h_agree (m + 1) (by omega)
  have heq : r + (m + 1) - 1 = w - 1 := by omega
  rw [heq] at h_sub
  have h_diff := G_with_ell_step_sub_row_r_col_w_pred w G_base v m hr hv_w hv_nz
  linarith

-- U_mat at row r with offset m + 2 is unchanged between step m and step m + 1
theorem U_mat_step_diag_eq (w : ℕ) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ) (m : ℕ)
    (hm : m + 2 ≤ w) (hv_w : v w = 0) (hv_w1 : v (w + 1) = 0) :
    U_mat (G_with_ell G_base v (ell_seq w G_base v (m + 1))) (m + 2) (w - 1 - m) =
      U_mat (G_with_ell G_base v (ell_seq w G_base v m)) (m + 2) (w - 1 - m) := by
  let r := w - 1 - m
  let G₁ := G_with_ell G_base v (ell_seq w G_base v (m + 1))
  let G₂ := G_with_ell G_base v (ell_seq w G_base v m)
  have h_agree : ∀ a ≥ r + 1, ∀ b, G₁ a b = G₂ a b := by
    intro a ha b
    exact G_with_ell_step_agree_of_gt w G_base v m a b ha
  have h_sub := U_mat_sub_of_gt G₁ G₂ r h_agree (m + 2) (by omega)
  have heq : r + (m + 2) - 1 = w := by omega
  rw [heq] at h_sub
  have h_col := G_with_ell_step_agree_row_r_col_w w G_base v m hv_w hv_w1
  linarith

-- For j ≥ r + 1, U_mat is unchanged
theorem U_mat_step_ge (w : ℕ) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ) (m : ℕ) (j : ℕ)
    (hj : w - 1 - m + 1 ≤ j) (k : ℕ) :
    U_mat (G_with_ell G_base v (ell_seq w G_base v (m + 1))) k j =
      U_mat (G_with_ell G_base v (ell_seq w G_base v m)) k j := by
  let G₁ := G_with_ell G_base v (ell_seq w G_base v (m + 1))
  let G₂ := G_with_ell G_base v (ell_seq w G_base v m)
  have h_agree : ∀ a ≥ j, ∀ b, G₁ a b = G₂ a b := by
    intro a ha b
    exact G_with_ell_step_agree_of_gt w G_base v m a b (by omega)
  exact U_mat_congr_of_ge G₁ G₂ j h_agree k

-- Row w vanishes for all m
theorem G_with_ell_step_row_w (w : ℕ) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ) (m : ℕ)
    (h_row : ∀ a ≤ w, G_base w a = 0) (a : ℕ) (ha : a ≤ w) :
    G_with_ell G_base v (ell_seq w G_base v m) w a = 0 :=
  G_with_ell_row_w w G_base v m a (h_row a ha)

-- Col w vanishes for all m
theorem G_with_ell_step_col_w (w : ℕ) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ) (m : ℕ)
    (h_col : ∀ a ≤ w, G_base a w = 0) (hv_w : v w = 0) (hv_w1 : v (w + 1) = 0) (a : ℕ) (ha : a ≤ w) :
    G_with_ell G_base v (ell_seq w G_base v m) a w = 0 :=
  G_with_ell_col_w w G_base v (ell_seq w G_base v m) a (h_col a ha) hv_w hv_w1

-- Main Downward Induction Theorem
theorem ell_seq_boundary_zero (w : ℕ) (hw : 2 ≤ w) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ)
    (h_row : ∀ a ≤ w, G_base w a = 0) (h_col : ∀ a ≤ w, G_base a w = 0)
    (hv_w : v w = 0) (hv_w1 : v (w + 1) = 0) (hv_nz : v (w - 1) ≠ 0) :
    ∀ m ≤ w - 1, ∀ j, w - 1 - m ≤ j → j ≤ w →
      U_mat (G_with_ell G_base v (ell_seq w G_base v m)) (w + 1 - j) j = 0 := by
  intro m hm
  induction m with
  | zero =>
      intro j hj hjw
      have hj_cases : j = w - 1 ∨ j = w := by omega
      cases hj_cases with
      | inl hj_pred =>
          have heq : w + 1 - j = 2 := by omega
          rw [heq, hj_pred]
          exact U_mat_boundary_base_w_pred (G_with_ell G_base v (ell_seq w G_base v 0)) w (by omega)
            (G_with_ell_step_row_w w G_base v 0 h_row)
            (G_with_ell_step_col_w w G_base v 0 h_col hv_w hv_w1)
      | inr hj_w =>
          have heq : w + 1 - j = 1 := by omega
          rw [heq, hj_w]
          exact U_mat_boundary_base_w (G_with_ell G_base v (ell_seq w G_base v 0)) w
            (G_with_ell_step_row_w w G_base v 0 h_row)
  | succ m ih =>
      have hm_pred : m ≤ w - 1 := by omega
      have hm_bound : m + 2 ≤ w := by omega
      have ih_m := ih hm_pred
      intro j hj hjw
      let r := w - 1 - m
      have hr : 1 ≤ r := by omega
      have hj_split : j = r - 1 ∨ j = r ∨ r + 1 ≤ j := by omega
      rcases hj_split with hj1 | hj2 | hj_gt
      · -- j = r - 1
        have h_le : (r - 1) + 2 ≤ w := by omega
        have hr_eq : (r - 1) + 1 = r := by omega
        have h_diag : U_mat (G_with_ell G_base v (ell_seq w G_base v (m + 1))) (w - (r - 1)) ((r - 1) + 1) = 0 := by
          rw [hr_eq]
          have heq : w - (r - 1) = m + 2 := by omega
          rw [heq]
          rw [U_mat_step_diag_eq w G_base v m hm_bound hv_w hv_w1]
          have heq2 : m + 2 = w + 1 - r := by omega
          rw [heq2]
          exact ih_m r (by omega) (by omega)
        have h_off : U_mat (G_with_ell G_base v (ell_seq w G_base v (m + 1))) (w - 1 - (r - 1)) ((r - 1) + 1) = 0 := by
          rw [hr_eq]
          have heq : w - 1 - (r - 1) = m + 1 := by omega
          rw [heq]
          exact U_mat_step_off_diag_zero w G_base v m hm_bound hv_w hv_nz
        have h_step := U_mat_boundary_zero_step (G_with_ell G_base v (ell_seq w G_base v (m + 1))) w (r - 1)
          (G_with_ell_step_row_w w G_base v (m + 1) h_row)
          (G_with_ell_step_col_w w G_base v (m + 1) h_col hv_w hv_w1)
          h_le h_diag h_off
        subst hj1
        exact h_step
      · -- j = r
        subst hj2
        have heq : w + 1 - r = m + 2 := by omega
        rw [heq]
        rw [U_mat_step_diag_eq w G_base v m hm_bound hv_w hv_w1]
        have heq2 : m + 2 = w + 1 - r := by omega
        rw [heq2]
        exact ih_m r (by omega) (by omega)
      · -- j ≥ r + 1
        rw [U_mat_step_ge w G_base v m j hj_gt (w + 1 - j)]
        exact ih_m j (by omega) hjw

-- Specialization at m = w - 1: all boundary terms vanish
theorem ell_seq_boundary_all_zero (w : ℕ) (hw : 2 ≤ w) (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ)
    (h_row : ∀ a ≤ w, G_base w a = 0) (h_col : ∀ a ≤ w, G_base a w = 0)
    (hv_w : v w = 0) (hv_w1 : v (w + 1) = 0) (hv_nz : v (w - 1) ≠ 0) :
    ∀ j ≤ w, U_mat (G_with_ell G_base v (ell_seq w G_base v (w - 1))) (w + 1 - j) j = 0 := by
  intro j hj
  have h_ind := ell_seq_boundary_zero w hw G_base v h_row h_col hv_w hv_w1 hv_nz (w - 1) (by omega) j
  have heq : w - 1 - (w - 1) = 0 := by omega
  rw [heq] at h_ind
  exact h_ind (by omega) hj

-- Definition of E(G)
def E_from_U (G : ℕ → ℕ → ℚ) (i j : ℕ) : ℚ :=
  if i < j then U_mat G (j - i) i
  else if i = j then G i i
  else U_mat G (i - j) j + U_mat G (i - j + 1) j - G j i

-- Pointwise identity cases
theorem E_diag_eq (G : ℕ → ℕ → ℚ) (i : ℕ) :
    E_from_U G i i - E_from_U G i i + E_from_U G i (i + 1) = G i i := by
  dsimp [E_from_U]
  have h1 : i < i + 1 := by omega
  simp [h1, U_mat]

theorem E_upper_eq (G : ℕ → ℕ → ℚ) (i j : ℕ) (h : i < j) :
    E_from_U G i j - E_from_U G j i + E_from_U G i (j + 1) = G i j := by
  have h_lt : i < j := h
  have h_gt : ¬ (j < i) := by omega
  have h_ne : ¬ (j = i) := by omega
  have h_next : i < j + 1 := by omega
  have h_sub : j + 1 - i = (j - i) + 1 := by omega
  dsimp [E_from_U]
  simp [h_lt, h_gt, h_ne, h_next, h_sub]
  ring

theorem E_subdiag_eq (G : ℕ → ℕ → ℚ) (j : ℕ) :
    E_from_U G (j + 1) j - E_from_U G j (j + 1) + E_from_U G (j + 1) (j + 1) = G (j + 1) j := by
  have h1 : j < j + 1 := by omega
  have h2 : ¬ (j + 1 < j) := by omega
  have h4 : j + 1 - j = 1 := by omega
  dsimp [E_from_U]
  simp [h1, h2, h4]
  change U_mat G 1 j + U_mat G 2 j - G j (j + 1) - U_mat G 1 j + G (j + 1) (j + 1) = G (j + 1) j
  rw [show U_mat G 2 j = G j (j + 1) + G (j + 1) j - U_mat G 1 (j + 1) by rfl]
  rw [show U_mat G 1 (j + 1) = G (j + 1) (j + 1) by rfl]
  ring

theorem E_lower_eq (G : ℕ → ℕ → ℚ) (i j : ℕ) (h : j + 1 < i) :
    E_from_U G i j - E_from_U G j i + E_from_U G i (j + 1) = G i j := by
  have h1 : ¬ (i < j) := by omega
  have h2 : ¬ (i = j) := by omega
  have h3 : j < i := by omega
  have h4 : ¬ (i < j + 1) := by omega
  have h5 : ¬ (i = j + 1) := by omega
  dsimp [E_from_U]
  simp [h1, h2, h3, h4, h5]
  let d := i - (j + 1)
  have hd_pos : 0 < d := by omega
  have hd1 : i - j = d + 1 := by omega
  have hd3 : i - (j + 1) = d := by omega
  have hd4 : i - (j + 1) + 1 = d + 1 := by omega
  rw [hd1, hd3, hd4]
  have h_U : U_mat G (d + 1 + 1) j =
      G j i + G i j + G (j + 1) i - U_mat G d (j + 1) - U_mat G (d + 1) (j + 1) := by
    have heq_k : d + 1 + 1 = (d - 1) + 3 := by omega
    rw [heq_k]
    show U_mat G ((d - 1) + 3) j = _
    rw [U_mat]
    have heq : j + (d - 1) + 2 = i := by omega
    rw [heq]
    have heq2 : (d - 1) + 1 = d := by omega
    have heq3 : (d - 1) + 2 = d + 1 := by omega
    rw [heq2, heq3]
  rw [h_U]
  ring

theorem E_pointwise_eq (G : ℕ → ℕ → ℚ) (i j : ℕ) :
    E_from_U G i j - E_from_U G j i + E_from_U G i (j + 1) = G i j := by
  rcases lt_trichotomy i j with h_lt | rfl | h_gt
  · exact E_upper_eq G i j h_lt
  · exact E_diag_eq G i
  · by_cases h_sub : i = j + 1
    · subst h_sub; exact E_subdiag_eq G j
    · have h_low : j + 1 < i := by omega
      exact E_lower_eq G i j h_low

def E_mat_U (w : ℕ) (G : ℕ → ℕ → ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  Matrix.of fun i j => E_from_U G i.val j.val

theorem E_mat_U_shift_apply_lt (w : ℕ) (G : ℕ → ℕ → ℚ)
    (i j : Fin (w + 1)) (hj : j.val < w) :
    ((E_mat_U w G - (E_mat_U w G).transpose) + E_mat_U w G * N_mat (w + 1)) i j =
      G i.val j.val := by
  have h_shift : (E_mat_U w G * N_mat (w + 1)) i j = E_mat_U w G i ⟨j.val + 1, by omega⟩ := by
    rw [mul_N_mat_apply]
    have hlt : j.val + 1 < w + 1 := by omega
    simp [hlt]
  rw [Matrix.add_apply, Matrix.sub_apply, Matrix.transpose_apply, h_shift]
  simp only [E_mat_U, Matrix.of_apply]
  exact E_pointwise_eq G i.val j.val

theorem E_from_U_last_col (G : ℕ → ℕ → ℚ) (i : ℕ) (w : ℕ) (h : i < w + 1) :
    E_from_U G i (w + 1) = U_mat G (w + 1 - i) i := by
  dsimp [E_from_U]
  simp [h]

theorem E_mat_U_shift_apply_last (w : ℕ) (G : ℕ → ℕ → ℚ)
    (i : Fin (w + 1)) :
    ((E_mat_U w G - (E_mat_U w G).transpose) + E_mat_U w G * N_mat (w + 1)) i ⟨w, Nat.lt_succ_self w⟩ =
      G i.val w - U_mat G (w + 1 - i.val) i.val := by
  have h_shift : (E_mat_U w G * N_mat (w + 1)) i ⟨w, Nat.lt_succ_self w⟩ = 0 := by
    rw [mul_N_mat_apply]
    have hnot : ¬ (w + 1 < w + 1) := by omega
    simp only [hnot, ↓reduceDIte]
  rw [Matrix.add_apply, Matrix.sub_apply, Matrix.transpose_apply, h_shift, add_zero]
  simp only [E_mat_U, Matrix.of_apply]
  have h_pw := E_pointwise_eq G i.val w
  have h_last := E_from_U_last_col G i.val w i.isLt
  rw [h_last] at h_pw
  linarith

theorem E_mat_U_shift_eq (w : ℕ) (G : ℕ → ℕ → ℚ)
    (hU : ∀ i : Fin (w + 1), U_mat G (w + 1 - i.val) i.val = 0) :
    (E_mat_U w G - (E_mat_U w G).transpose) + E_mat_U w G * N_mat (w + 1) =
      Matrix.of fun i j => G i.val j.val := by
  ext i j
  by_cases hj : j.val < w
  · rw [E_mat_U_shift_apply_lt w G i j hj]
    simp only [Matrix.of_apply]
  · have hj_eq : j = ⟨w, Nat.lt_succ_self w⟩ := by
      ext
      have hj_lt := j.isLt
      dsimp
      omega
    subst hj_eq
    rw [E_mat_U_shift_apply_last w G i]
    rw [hU i]
    simp only [sub_zero, Matrix.of_apply]

theorem moment_eq_of_E_mat_U (w : ℕ) (G : ℕ → ℕ → ℚ)
    (F : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hG : ∀ i j : Fin (w + 1), (F * (1 + N_mat (w + 1))) i j = G i.val j.val)
    (hU : ∀ i : Fin (w + 1), U_mat G (w + 1 - i.val) i.val = 0) :
    E_mat_U w G - (E_mat_U w G).transpose * B_mat (w + 1) = F := by
  have hTB : (1 + N_mat (w + 1)) * B_mat (w + 1) = 1 := one_add_N_mul_B_mat (w + 1)
  have hBT : B_mat (w + 1) * (1 + N_mat (w + 1)) = 1 := B_mat_mul_one_add_N (w + 1)
  have h_shift := E_mat_U_shift_eq w G hU
  have h_mul : ((E_mat_U w G - (E_mat_U w G).transpose) + E_mat_U w G * N_mat (w + 1)) * B_mat (w + 1) =
      E_mat_U w G - (E_mat_U w G).transpose * B_mat (w + 1) := by
    calc ((E_mat_U w G - (E_mat_U w G).transpose) + E_mat_U w G * N_mat (w + 1)) * B_mat (w + 1)
      _ = (E_mat_U w G * (1 + N_mat (w + 1)) - (E_mat_U w G).transpose) * B_mat (w + 1) := by
        congr 1
        simp only [Matrix.mul_add, Matrix.mul_one]
        abel
      _ = E_mat_U w G * ((1 + N_mat (w + 1)) * B_mat (w + 1)) - (E_mat_U w G).transpose * B_mat (w + 1) := by
        simp only [Matrix.sub_mul, Matrix.mul_assoc]
      _ = E_mat_U w G * 1 - (E_mat_U w G).transpose * B_mat (w + 1) := by rw [hTB]
      _ = E_mat_U w G - (E_mat_U w G).transpose * B_mat (w + 1) := by rw [Matrix.mul_one]
  rw [← h_mul, h_shift]
  have hF : (Matrix.of fun i j => G i.val j.val) = F * (1 + N_mat (w + 1)) := by
    ext i j
    simp only [Matrix.of_apply]
    exact (hG i j).symm
  rw [hF, Matrix.mul_assoc, hTB, Matrix.mul_one]

-- Top-level Closed-Form Moment Solver for any base matrix
theorem E_inner_solves_moment (w : ℕ) (hw : 2 ≤ w)
    (G_base : ℕ → ℕ → ℚ) (v : ℕ → ℚ)
    (F : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (h_row : ∀ a ≤ w, G_base w a = 0) (h_col : ∀ a ≤ w, G_base a w = 0)
    (hv_w : v w = 0) (hv_w1 : v (w + 1) = 0) (hv_nz : v (w - 1) ≠ 0)
    (hF_G : ∀ i j : Fin (w + 1),
      (F * (1 + N_mat (w + 1))) i j =
        G_with_ell G_base v (ell_seq w G_base v (w - 1)) i.val j.val) :
    E_mat_U w (G_with_ell G_base v (ell_seq w G_base v (w - 1))) -
      (E_mat_U w (G_with_ell G_base v (ell_seq w G_base v (w - 1)))).transpose * B_mat (w + 1) = F := by
  have hU : ∀ i : Fin (w + 1),
      U_mat (G_with_ell G_base v (ell_seq w G_base v (w - 1))) (w + 1 - i.val) i.val = 0 := by
    intro i
    exact ell_seq_boundary_all_zero w hw G_base v h_row h_col hv_w hv_w1 hv_nz i.val (by omega)
  exact moment_eq_of_E_mat_U w (G_with_ell G_base v (ell_seq w G_base v (w - 1))) F hF_G hU



/-!
## 29. Uniform Algebraic and Full-Rank Clock Lift

This section implements the uniform-score algebraic and full-rank clock lifts
using the drift-free score table `S_uniform`, canonical ceiling `zeta_canonical`,
and deficit matrix `D_uniform`.
-/

/-!
### 1. General Interpolation and Moment Compatibility for `D_uniform`
-/

/-- General uniform interpolation coupling matrix `P_uniform_interp`. -/
def P_uniform_interp {w n : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (M : Matrix (Fin n) (Fin (w + 1)) ℚ) (R_M : Matrix (Fin (w + 1)) (Fin n) ℚ)
    (J : Matrix (Fin n) (Fin n) ℚ) (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin n) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    Matrix (Fin (clock.m + 1)) (Fin n) ℚ :=
  P_interp (X_gateway clock) (L_X_gateway L_C) M R_M
    (D_uniform hw clock b c_step H0 delta)
    (Q_reset J M (B_mat (w + 1)) zeta)
    P0

/-- Derivation of matrix compatibility `Dᵀ X = Mᵀ Q` from the master moment equation. -/
theorem uniform_moment_compat {w n : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (M : Matrix (Fin n) (Fin (w + 1)) ℚ) (J : Matrix (Fin n) (Fin n) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (zeta : Fin (w + 1) → ℚ)
    (hMJM : M.transpose * J * M = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row M).transpose * psi_row zeta (B_mat (w + 1))) :
    (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock =
      M.transpose * Q_reset J M (B_mat (w + 1)) zeta := by
  have hmom' :
      M.transpose * J * M - (M.transpose * J * M).transpose * B_mat (w + 1) =
        (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
          (ell_row M).transpose * psi_row zeta (B_mat (w + 1)) := by
    rw [hMJM, hmoment]
  exact (moment_equation_iff
    (D_uniform hw clock b c_step H0 delta)
    (X_gateway clock) J M (B_mat (w + 1)) zeta).mpr hmom'

/-- The interpolated coupling matrix `P_uniform_interp` satisfies `Pᵀ * X = Q`. -/
theorem P_uniform_interp_transpose_mul_X {w n : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (M : Matrix (Fin n) (Fin (w + 1)) ℚ) (R_M : Matrix (Fin (w + 1)) (Fin n) ℚ)
    (J : Matrix (Fin n) (Fin n) ℚ) (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin n) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) :
    (P_uniform_interp hw clock b c_step H0 delta M R_M J zeta P0 L_C).transpose * X_gateway clock =
      Q_reset J M (B_mat (w + 1)) zeta :=
  interpolate_PtX (X_gateway clock) (L_X_gateway L_C) M R_M
    (D_uniform hw clock b c_step H0 delta)
    (Q_reset J M (B_mat (w + 1)) zeta)
    P0
    (X_gateway_transpose_mul_L_X_gateway clock L_C hLC)

/-- The interpolated coupling matrix `P_uniform_interp` satisfies `P * M = D`. -/
theorem P_uniform_interp_mul_M {w n : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (M : Matrix (Fin n) (Fin (w + 1)) ℚ) (R_M : Matrix (Fin (w + 1)) (Fin n) ℚ)
    (J : Matrix (Fin n) (Fin n) ℚ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ) (P0 : Matrix (Fin (clock.m + 1)) (Fin n) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hRM : R_M * M = 1)
    (hMJM : M.transpose * J * M = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row M).transpose * psi_row zeta (B_mat (w + 1))) :
    P_uniform_interp hw clock b c_step H0 delta M R_M J zeta P0 L_C * M =
      D_uniform hw clock b c_step H0 delta := by
  have hcompat := uniform_moment_compat hw clock b c_step H0 delta M J E zeta hMJM hmoment
  exact interpolate_PM (X_gateway clock) (L_X_gateway L_C) M R_M
    (D_uniform hw clock b c_step H0 delta)
    (Q_reset J M (B_mat (w + 1)) zeta)
    P0
    hRM hcompat

/-!
### 2. Coupled Specialization and Algebraic Clock Lift `uniformLiftClock`
-/

/-- Coupled uniform interpolation coupling matrix `P_uniform_coupled`. -/
def P_uniform_coupled {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  P_uniform_interp hw clock b c_step H0 delta (M_coupled w) (R_M_coupled w) J zeta P0 L_C

/-- `P_uniform_coupled` satisfies `P * M = D`. -/
theorem P_uniform_coupled_mul_M {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1))) :
    P_uniform_coupled hw clock b c_step H0 delta J zeta P0 L_C * M_coupled w =
      D_uniform hw clock b c_step H0 delta :=
  P_uniform_interp_mul_M hw clock b c_step H0 delta (M_coupled w) (R_M_coupled w) J E zeta P0 L_C
    (R_M_coupled_mul_M_coupled w) hMJM hmoment

/-- `P_uniform_coupled` satisfies `Pᵀ * X = Q`. -/
theorem P_uniform_coupled_transpose_mul_X {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) :
    (P_uniform_coupled hw clock b c_step H0 delta J zeta P0 L_C).transpose * X_gateway clock =
      Q_reset J (M_coupled w) (B_mat (w + 1)) zeta :=
  P_uniform_interp_transpose_mul_X hw clock b c_step H0 delta (M_coupled w) (R_M_coupled w) J zeta P0 L_C hLC

/-- Inductive algebraic clock lift of order `w + 1` from the uniform score table architecture. -/
@[reducible] def uniformLiftClock {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1))) :
    AlgebraicClock (w + 1) :=
  let P := P_uniform_coupled hw clock b c_step H0 delta J zeta P0 L_C
  let G_O := AdjoinLeaderEndpointG clock.G b clock.v
  let h_row := h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step
  let S := S_uniform (by omega) clock b h_row delta
  let X := X_gateway clock
  let M := M_coupled w
  let B := B_mat (w + 1)
  let v_old := v_old_coupled clock.m
  let v_reset : Fin ((w + 1) + (w + 1)) → ℚ := 0
  let aP_old : Fin (clock.m + 1) → ℚ := fun _ => 1
  let aP_reset : Fin ((w + 1) + (w + 1)) → ℚ := fun _ => 1
  AlgebraicClock.ofEquiv (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)))
    (liftedGameMat G_O P J)
    (liftedScoreMat G_O J S X M zeta)
    (liftedCountMat X M (N_mat (w + 1)))
    (liftedWeightVec v_old v_reset)
    (liftedWeightVec aP_old aP_reset)
    (liftedGameMat_skew G_O P J (AdjoinLeaderEndpointG_skew clock.G b clock.v clock.hskew))
    (liftedGameMat_mul_liftedCountMat G_O P J S X M B (N_mat (w + 1)) zeta
      (B_mat_mul_one_add_N (w + 1))
      (P_uniform_coupled_transpose_mul_X hw clock b c_step H0 delta J zeta P0 L_C hLC)
      (P_uniform_coupled_mul_M hw clock b c_step H0 delta J E zeta P0 L_C hMJM hmoment))
    (by
      have hcal := coupled_weight_calibration clock
      exact liftedWeightVec_mul_liftedCountMat X M v_old v_reset hcal)
    (fun s => by
      cases s with
      | inl _ => exact zero_lt_one
      | inr _ => exact zero_lt_one)

/-- Universal left inverse $L_C$ for `uniformLiftClock`. -/
def L_C_uniform_next {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1))) :
    Matrix (Fin (uniformLiftClock hw clock b c_step H0 delta J E zeta P0 L_C hLC hMJM hmoment).m) (Fin (w + 1)) ℚ :=
  Matrix.of fun x c =>
    match (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))).symm x with
    | Sum.inl _ => 0
    | Sum.inr r => R_M_coupled w c r

/-- Full column rank preservation for `uniformLiftClock`. -/
theorem uniform_C_transpose_mul_L_C {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1))) :
    (uniformLiftClock hw clock b c_step H0 delta J E zeta P0 L_C hLC hMJM hmoment).C.transpose *
      L_C_uniform_next hw clock b c_step H0 delta J E zeta P0 L_C hLC hMJM hmoment = 1 := by
  ext c1 c2
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  change ∑ x : Fin ((clock.m + 1) + ((w + 1) + (w + 1))),
    (uniformLiftClock hw clock b c_step H0 delta J E zeta P0 L_C hLC hMJM hmoment).C x c1 *
      L_C_uniform_next hw clock b c_step H0 delta J E zeta P0 L_C hLC hMJM hmoment x c2 =
    (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) c1 c2
  rw [(Equiv.sum_comp (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))) fun y =>
    (uniformLiftClock hw clock b c_step H0 delta J E zeta P0 L_C hLC hMJM hmoment).C y c1 *
      L_C_uniform_next hw clock b c_step H0 delta J E zeta P0 L_C hLC hMJM hmoment y c2).symm]
  rw [Fintype.sum_sum_type]
  simp only [uniformLiftClock, AlgebraicClock.ofEquiv, liftedCountMat,
    L_C_uniform_next, Matrix.of_apply, Equiv.symm_apply_apply,
    mul_zero, Finset.sum_const_zero, zero_add]
  have hRM := congr_fun (congr_fun (R_M_coupled_mul_M_coupled w) c2) c1
  simp only [Matrix.mul_apply, Matrix.one_apply, eq_comm] at hRM ⊢
  simpa [mul_comm] using hRM

/-- Verified full-rank clock of order `w + 1` from `uniformLiftClock`. -/
def uniformFullRankLift {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1))) :
    FullRankClock (w + 1) where
  clock := uniformLiftClock hw fc.clock b c_step H0 delta J E zeta P0 fc.L_C fc.hLC hMJM hmoment
  L_C := L_C_uniform_next hw fc.clock b c_step H0 delta J E zeta P0 fc.L_C fc.hLC hMJM hmoment
  hLC := uniform_C_transpose_mul_L_C hw fc.clock b c_step H0 delta J E zeta P0 fc.L_C fc.hLC hMJM hmoment

/-- Action count recursion for `uniformFullRankLift`: $m_{w+1} = m_w + 2w + 3$. -/
theorem uniformFullRankLift_m {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1))) :
    (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m = fc.clock.m + 2 * w + 3 := by
  dsimp only [uniformFullRankLift, uniformLiftClock, AlgebraicClock.ofEquiv]
  omega

/-- Strict positivity of dimension for `uniformFullRankLift`. -/
theorem uniformFullRankLift_m_pos {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1))) :
    0 < (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m := by
  rw [uniformFullRankLift_m]
  omega

/-- In `uniformLiftClock`, the 0-th element of the mapped 4-stage phase word is action 0. -/
theorem uniform_phaseWord_head_eq_zero {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m)) (q : ℕ)
    (h_pos : 0 < ((rawFourStageWord clock parentWord q).map
      (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)))).length) :
    ((rawFourStageWord clock parentWord q).map
      (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))))[0]'h_pos =
    ⟨0, by
      have : 0 < (clock.m + 1) + ((w + 1) + (w + 1)) := by omega
      exact this⟩ := by
  have hraw_pos : 0 < (rawFourStageWord clock parentWord q).length := by
    rw [List.length_map] at h_pos
    exact h_pos
  have hget : ((rawFourStageWord clock parentWord q).map
      (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))))[0]'h_pos =
    (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)))
      ((rawFourStageWord clock parentWord q)[0]'hraw_pos) := by
    simp only [List.getElem_map]
  rw [hget]
  rw [rawFourStageWord_head_eq_inr_zero clock parentWord q hraw_pos]
  exact rotLeaderEquiv_inr_zero (by omega) (by omega)

/-- In `uniformLiftClock`, row 0 of `.R` equals `zeta` when `J` has zero first row. -/
theorem uniformLiftClock_leader_zero_score {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (hJ_row0 : ∀ ℓ : Fin ((w + 1) + (w + 1)), J ⟨0, by omega⟩ ℓ = 0)
    (c : Fin (w + 1)) :
    (uniformLiftClock hw clock b c_step H0 delta J E zeta P0 L_C hLC hMJM hmoment).R ⟨0, by
      dsimp [uniformLiftClock, AlgebraicClock.ofEquiv]
      omega⟩ c = zeta c := by
  dsimp only [uniformLiftClock, AlgebraicClock.ofEquiv]
  simp only [Matrix.of_apply]
  have hm : 0 < clock.m + 1 := by omega
  have hn : 0 < (w + 1) + (w + 1) := by omega
  rw [rotLeaderEquiv_symm_zero hm hn]
  dsimp only [liftedScoreMat]
  simp only [Matrix.of_apply, Matrix.sub_apply, one_zeta, Matrix.mul_apply]
  have hsum : (∑ ℓ : Fin ((w + 1) + (w + 1)),
      J ⟨0, by omega⟩ ℓ * M_coupled w ℓ c) = 0 := by
    rw [Finset.sum_congr rfl (fun ℓ _ => by rw [hJ_row0 ℓ, zero_mul])]
    exact Finset.sum_const_zero
  rw [hsum, sub_zero]

/-!
## 30. Grounded RealizedClock Lift for Uniform Clock (`RealizedClock.ofUniformLift`)

This section implements `RealizedClock.ofUniformLift`, constructing a `RealizedClock (w + 1)`
from a parent `RealizedClock w` using `uniformFullRankLift`, the drift-free score table
`S_uniform`, canonical ceiling `zeta_canonical`, and deficit matrix `D_uniform`.
-/

/-- Canonical initial lifted score vector at phase index `q` for the uniform clock lift. -/
def uniformInitScoreVec {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (q : ℕ) :
    Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m → ℚ :=
  fun i => ((liftedScoreMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
    J
    (S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta)
    (X_gateway fc.clock) (M_coupled w)
    zeta).mulVec (binomBasis (w + 1) q))
    ((rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1))).symm i)

/-- Initial lifted score vector evaluates to the exact ceiling score on action 0. -/
theorem uniformInitScoreVec_zero {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0)
    (q : ℕ) :
    uniformInitScoreVec hw fc b c_step H0 delta J E zeta P0 hMJM hmoment q ⟨0, by
      have := uniformFullRankLift_m_pos hw fc b c_step H0 delta J E zeta P0 hMJM hmoment
      omega⟩ =
    dotProduct zeta (binomBasis (w + 1) q) := by
  unfold uniformInitScoreVec
  have hm : 0 < fc.clock.m + 1 := by omega
  have hn : 0 < (w + 1) + (w + 1) := by omega
  rw [rotLeaderEquiv_symm_zero hm hn]
  exact liftedScoreMat_inr_zero_eq_ceiling
    (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
    J
    (S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta)
    (X_gateway fc.clock)
    (M_coupled w)
    zeta
    hJ_lower
    q

/-- Canonical tie-removal bias for the uniform clock lift at phase shift `phaseShift`. -/
def uniformTieRemovalBias {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    {m_rank : ℕ}
    (rank : Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m → Fin m_rank)
    (phaseShift : ℕ) :
    Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m → ℚ :=
  canonicalTieRemovalBias (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.G
    (uniformInitScoreVec hw fc b c_step H0 delta J E zeta P0 hMJM hmoment phaseShift) rank

/-- Biased initial score vector at phase index `q` with phase shift `phaseShift`. -/
def uniformBiasedInitScoreVec {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    {m_rank : ℕ}
    (rank : Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m → Fin m_rank)
    (phaseShift : ℕ) (q : ℕ) :
    Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m → ℚ :=
  fun i => uniformInitScoreVec hw fc b c_step H0 delta J E zeta P0 hMJM hmoment q i +
    uniformTieRemovalBias hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift i

/-- Biased canonical score shift combining the bias on the leader with the canonical setup shift. -/
def uniformBiasedScoreShift {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    {m_rank : ℕ}
    (rank : Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m → Fin m_rank)
    (phaseShift : ℕ) : ℚ :=
  uniformTieRemovalBias hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift ⟨0, by
    have := uniformFullRankLift_m_pos hw fc b c_step H0 delta J E zeta P0 hMJM hmoment
    omega⟩ +
  canonicalScoreShift (uniformBiasedInitScoreVec hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift phaseShift)

/-- **Biased Phase-Start Cumulative Score Evaluation for Uniform Lift (`uniform_biased_phaseStart_cumScore_eq`)**:
    Evaluates the unrolled cumulative score of the biased trajectory at phase start in exact closed form. -/
theorem uniform_biased_phaseStart_cumScore_eq {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis w σ))
    {m_rank : ℕ}
    (rank : Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m → Fin m_rank)
    (phaseShift : ℕ)
    (p : ℕ) :
    let uLift := uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment
    let rotEquiv := rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1))
    let defaultAct : Fin uLift.clock.m := ⟨0, by
      have := uniformFullRankLift_m_pos hw fc b c_step H0 delta J E zeta P0 hMJM hmoment
      omega⟩
    let rawWord : ℕ → List (Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1))) := fun q : ℕ =>
      rawFourStageWord fc.clock parentWord (q + phaseShift)
    let phaseWord : ℕ → List (Fin uLift.clock.m) := fun q : ℕ =>
      (rawWord q).map rotEquiv
    let sBiased : ℕ → Fin uLift.clock.m → ℚ := fun q =>
      uniformBiasedInitScoreVec hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift (q + phaseShift)
    cumScore (setupMatrix uLift.clock.G (canonicalSetupVec (sBiased 0)))
      (wordPhaseTrajectory phaseWord defaultAct)
      (wordPhaseStartStep phaseWord p)
      (wordPhaseTrajectory phaseWord defaultAct (wordPhaseStartStep phaseWord p)) =
    dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) +
      uniformBiasedScoreShift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift := by
  intro uLift rotEquiv defaultAct rawWord phaseWord sBiased
  let sInit : ℕ → Fin uLift.clock.m → ℚ := fun q =>
    uniformInitScoreVec hw fc b c_step H0 delta J E zeta P0 hMJM hmoment (q + phaseShift)
  have hcount : ∀ q : ℕ, 0 < (phaseWord q).length := by
    intro q
    change 0 < ((rawWord q).map rotEquiv).length
    rw [List.length_map]
    dsimp only [rawWord, rawFourStageWord]
    simp only [List.length_append, List.length_singleton]
    omega
  have hboundary : ∀ q : ℕ,
      wordScore uLift.clock.G (sInit q) (phaseWord q) = sInit (q + 1) := by
    intro q
    ext i
    have hmap := wordScore_map_equiv rotEquiv
      (liftedGameMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        (P_uniform_coupled hw fc.clock b c_step H0 delta J zeta P0 fc.L_C)
        J)
      ((liftedScoreMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        J
        (S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta)
        (X_gateway fc.clock) (M_coupled w)
        zeta).mulVec (binomBasis (w + 1) (q + phaseShift)))
      (rawWord q) i
    have hraw := wordScore_rawFourStageWord fc.clock parentWord hparent_count
      (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
      (P_uniform_coupled hw fc.clock b c_step H0 delta J zeta P0 fc.L_C)
      J
      (S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta)
      zeta
      (P_uniform_coupled_transpose_mul_X hw fc.clock b c_step H0 delta J zeta P0 fc.L_C fc.hLC)
      (P_uniform_coupled_mul_M hw fc.clock b c_step H0 delta J E zeta P0 fc.L_C hMJM hmoment)
      (q + phaseShift)
    have hshift : q + phaseShift + 1 = q + 1 + phaseShift := by omega
    rw [hshift] at hraw
    have hraw_i := congr_fun hraw (rotEquiv.symm i)
    exact hmap.trans hraw_i
  have hboundary_biased : ∀ q : ℕ,
      wordScore uLift.clock.G (sBiased q) (phaseWord q) = sBiased (q + 1) := by
    intro q
    ext i
    change wordScore uLift.clock.G
      (fun j => sInit q j + uniformTieRemovalBias hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift j)
      (phaseWord q) i =
      sInit (q + 1) i + uniformTieRemovalBias hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift i
    rw [wordScore_add_bias]
    congr 1
    exact congr_fun (hboundary q) i
  let i0 : Fin uLift.clock.m := defaultAct
  have hact : (phaseWord p)[0]'(hcount p) = i0 :=
    uniform_phaseWord_head_eq_zero fc.clock parentWord (p + phaseShift) (hcount p)
  have htraj_at := wordPhaseTrajectory_at_phase_start phaseWord defaultAct hcount p
  have hact_0 : wordPhaseAct phaseWord defaultAct p 0 = i0 := by
    unfold wordPhaseAct
    rw [dif_pos (hcount p)]
    exact hact
  rw [hact_0] at htraj_at
  rw [htraj_at]
  have hcum := wordPhaseTrajectory_cumScore_at_phase_start uLift.clock.G
    (canonicalSetupVec (sBiased 0)) (canonicalScoreShift (sBiased 0)) sBiased phaseWord defaultAct
    hcount (fun _ => rfl) hboundary_biased p i0
  rw [hcum]
  have hsinit_i0 : sInit p i0 =
      dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) := by
    dsimp only [sInit, i0, defaultAct]
    exact uniformInitScoreVec_zero hw fc b c_step H0 delta J E zeta P0 hMJM hmoment hJ_lower (p + phaseShift)
  have h0 : 0 + phaseShift = phaseShift := by omega
  have hsBiased_i0 : sBiased p i0 =
      dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) +
      uniformTieRemovalBias hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift i0 := by
    change sInit p i0 + uniformTieRemovalBias hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift i0 = _
    rw [hsinit_i0]
  have hshift_def : uniformBiasedScoreShift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift =
      uniformTieRemovalBias hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift i0 +
      canonicalScoreShift (sBiased 0) := by
    dsimp only [uniformBiasedScoreShift, i0, defaultAct, sBiased]
    rw [h0]
  rw [hsBiased_i0, hshift_def]
  ring

/-- Grounded four-stage uniform lift specification with priority tie-breaking. -/
structure UniformLiftSpec {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0) where
  phaseShift : ℕ
  parentWord : ℕ → List (Fin fc.clock.m)
  hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis w σ)
  m_rank : ℕ
  hm_rank : 0 < m_rank
  rank : Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m → Fin m_rank
  hpriority_raw : ∀ p : ℕ,
    IsValidPriorityWord
      (liftedGameMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        (P_uniform_coupled hw fc.clock b c_step H0 delta J zeta P0 fc.L_C)
        J)
      ((liftedScoreMat (AdjoinLeaderEndpointG fc.clock.G b fc.clock.v)
        J
        (S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta)
        (X_gateway fc.clock) (M_coupled w)
        zeta).mulVec (binomBasis (w + 1) (p + phaseShift)))
      (fun i => rank ((rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1))) i))
      (rawFourStageWord fc.clock parentWord (p + phaseShift))
  c_low : ℚ
  c_high : ℚ
  hc_low_pos : 0 < c_low
  hc_high_pos : 0 < c_high
  hgap_low : ∀ p : ℕ,
    c_low * (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map
      (rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1)) : _ ≃ Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m)) (p + 1) : ℚ) ^ w ≤
      (2 * (dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) +
        uniformBiasedScoreShift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift)) ^ (w + 1)
  hgap_high : ∀ p : ℕ,
    (2 * (dotProduct zeta (binomBasis (w + 1) (p + 1 + phaseShift)) +
      uniformBiasedScoreShift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift)) ^ (w + 1) ≤
      c_high * (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map
        (rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1)) : _ ≃ Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m)) p : ℚ) ^ w

/-- Grounded four-stage uniform RealizedClock lift taking `RealizedClock w` to `RealizedClock (w + 1)`. -/
def RealizedClock.ofUniformLift {w : ℕ} (hw : 2 ≤ w) (rc : RealizedClock w)
    (b : Fin rc.fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (rc.fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw rc.fc.clock b c_step H0 delta).transpose * X_gateway rc.fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0)
    (spec : UniformLiftSpec hw rc.fc b c_step H0 delta J E zeta P0 hMJM hmoment hJ_lower) : RealizedClock (w + 1) :=
  let uLift := uniformFullRankLift hw rc.fc b c_step H0 delta J E zeta P0 hMJM hmoment
  let rotEquiv := rotLeaderEquiv (rc.fc.clock.m + 1) ((w + 1) + (w + 1))
  let defaultAct : Fin uLift.clock.m := ⟨0, by
    have := uniformFullRankLift_m_pos hw rc.fc b c_step H0 delta J E zeta P0 hMJM hmoment
    omega⟩
  let rawWord : ℕ → List (Fin (rc.fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1))) := fun p : ℕ =>
    rawFourStageWord rc.fc.clock spec.parentWord (p + spec.phaseShift)
  let phaseWord : ℕ → List (Fin uLift.clock.m) := fun p : ℕ =>
    (rawWord p).map rotEquiv
  let sInit : ℕ → Fin uLift.clock.m → ℚ := fun p =>
    uniformInitScoreVec hw rc.fc b c_step H0 delta J E zeta P0 hMJM hmoment (p + spec.phaseShift)
  let sBiased : ℕ → Fin uLift.clock.m → ℚ := fun p =>
    uniformBiasedInitScoreVec hw rc.fc b c_step H0 delta J E zeta P0 hMJM hmoment spec.rank spec.phaseShift (p + spec.phaseShift)
  have hcount : ∀ p : ℕ, 0 < (phaseWord p).length := by
    intro p
    change 0 < ((rawWord p).map rotEquiv).length
    rw [List.length_map]
    dsimp only [rawWord, rawFourStageWord]
    simp only [List.length_append, List.length_singleton]
    omega
  have hboundary : ∀ p : ℕ,
      wordScore uLift.clock.G (sInit p) (phaseWord p) = sInit (p + 1) := by
    intro p
    ext i
    have hmap := wordScore_map_equiv rotEquiv
      (liftedGameMat (AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v)
        (P_uniform_coupled hw rc.fc.clock b c_step H0 delta J zeta P0 rc.fc.L_C)
        J)
      ((liftedScoreMat (AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v)
        J
        (S_uniform (by omega) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (by omega) rc.fc.clock b c_step H0) c_step) delta)
        (X_gateway rc.fc.clock) (M_coupled w)
        zeta).mulVec (binomBasis (w + 1) (p + spec.phaseShift)))
      (rawWord p) i
    have hraw := wordScore_rawFourStageWord rc.fc.clock spec.parentWord spec.hparent_count
      (AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v)
      (P_uniform_coupled hw rc.fc.clock b c_step H0 delta J zeta P0 rc.fc.L_C)
      J
      (S_uniform (by omega) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (by omega) rc.fc.clock b c_step H0) c_step) delta)
      zeta
      (P_uniform_coupled_transpose_mul_X hw rc.fc.clock b c_step H0 delta J zeta P0 rc.fc.L_C rc.fc.hLC)
      (P_uniform_coupled_mul_M hw rc.fc.clock b c_step H0 delta J E zeta P0 rc.fc.L_C hMJM hmoment)
      (p + spec.phaseShift)
    have hshift : p + spec.phaseShift + 1 = p + 1 + spec.phaseShift := by omega
    rw [hshift] at hraw
    have hraw_i := congr_fun hraw (rotEquiv.symm i)
    exact hmap.trans hraw_i
  have hpriority : ∀ p : ℕ,
      IsValidPriorityWord uLift.clock.G (sInit p) spec.rank (phaseWord p) := by
    intro p
    have hequiv := isValidPriorityWord_map_equiv rotEquiv
      (liftedGameMat (AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v)
        (P_uniform_coupled hw rc.fc.clock b c_step H0 delta J zeta P0 rc.fc.L_C)
        J)
      _ (fun i => spec.rank (rotEquiv i)) (rawWord p) (spec.hpriority_raw p)
    have hrank_eq : (fun j => spec.rank (rotEquiv (rotEquiv.symm j))) = spec.rank := by
      ext j
      simp only [Equiv.apply_symm_apply]
    rw [hrank_eq] at hequiv
    exact hequiv
  have h0_phase : 0 + spec.phaseShift = spec.phaseShift := by omega
  have hsInit0 : sInit 0 = uniformInitScoreVec hw rc.fc b c_step H0 delta J E zeta P0 hMJM hmoment spec.phaseShift := by
    dsimp only [sInit]
    rw [h0_phase]
  have hstrict_pair := priority_phase_family_canonical_strict
    uLift.clock.G sInit spec.rank phaseWord spec.hm_rank hboundary hpriority
  have hvalid : ∀ p : ℕ,
      IsValidStrictWord uLift.clock.G (sBiased p) (phaseWord p) := by
    intro p
    have hv := hstrict_pair.1 p
    rw [hsInit0] at hv
    exact hv
  have hboundary_biased : ∀ p : ℕ,
      wordScore uLift.clock.G (sBiased p) (phaseWord p) = sBiased (p + 1) := by
    intro p
    have hb := hstrict_pair.2 p
    rw [hsInit0] at hb
    exact hb
  have hword_pos : ∀ (p v : ℕ) (hv : v < (phaseWord p).length),
      0 < wordScore uLift.clock.G (sBiased p) ((phaseWord p).take v) ((phaseWord p)[v]) +
          canonicalScoreShift (sBiased 0) :=
    wordScore_add_canonicalScoreShift_pos uLift.clock.G uLift.clock.hskew
      sBiased phaseWord hcount hboundary_biased hvalid
  have hstrict :
      IsStrictFPTrajectory (setupMatrix uLift.clock.G (canonicalSetupVec (sBiased 0)))
        (wordPhaseTrajectory phaseWord defaultAct) :=
    word_phase_unroll_isStrictFPTrajectory
      uLift.clock.G (canonicalSetupVec (sBiased 0)) (canonicalScoreShift (sBiased 0))
      sBiased phaseWord defaultAct
      hcount (canonicalSetupVec_nonneg (sBiased 0))
      (fun i => rfl)
      hboundary_biased hvalid hword_pos
  have hskew : IsSkewSymmetric (setupMatrix uLift.clock.G (canonicalSetupVec (sBiased 0))) :=
    setupMatrix_skewSymmetric uLift.clock.hskew (canonicalSetupVec (sBiased 0))
  have hpt_zero := wordPhaseStartStep_zero phaseWord
  have hpt_lt := wordPhaseStartStep_strictMono phaseWord hcount
  have hleader : ∀ p : ℕ, ∃ i0 : Fin uLift.clock.m,
      wordPhaseTrajectory phaseWord defaultAct (wordPhaseStartStep phaseWord p) = some i0 := by
    intro p
    exact ⟨wordPhaseAct phaseWord defaultAct p 0, wordPhaseTrajectory_at_phase_start phaseWord defaultAct hcount p⟩
  { fc := uLift
    setupVec := canonicalSetupVec (sBiased 0)
    phaseShift := spec.phaseShift
    scoreShift := canonicalScoreShift (sBiased 0)
    A_adm := 0
    hA_adm_nonneg := le_rfl
    hsetup_nonneg := canonicalSetupVec_nonneg (sBiased 0)
    trajectory := wordPhaseTrajectory phaseWord defaultAct
    phaseTime := wordPhaseStartStep phaseWord
    htraj_zero := rfl
    hstrict := hstrict
    hphaseTime_zero := hpt_zero
    hphaseTime_lt := hpt_lt
    hphase_leader := hleader
    c_low := spec.c_low
    c_high := spec.c_high
    hc_low_pos := spec.hc_low_pos
    hc_high_pos := spec.hc_high_pos
    hgap_bounds := fun t ht => by
      have hgap_l : ∀ p : ℕ,
        spec.c_low * (wordPhaseStartStep phaseWord (p + 1) : ℚ) ^ w ≤
          (2 * cumScore (setupMatrix uLift.clock.G (canonicalSetupVec (sBiased 0)))
            (wordPhaseTrajectory phaseWord defaultAct)
            (wordPhaseStartStep phaseWord p)
            (wordPhaseTrajectory phaseWord defaultAct (wordPhaseStartStep phaseWord p))) ^ (w + 1) := by
        intro p
        have hcs := uniform_biased_phaseStart_cumScore_eq hw rc.fc b c_step H0 delta J E zeta P0 hMJM hmoment hJ_lower
          spec.parentWord spec.hparent_count spec.rank spec.phaseShift p
        rw [hcs]
        exact spec.hgap_low p
      have hgap_h : ∀ p : ℕ,
        (2 * cumScore (setupMatrix uLift.clock.G (canonicalSetupVec (sBiased 0)))
          (wordPhaseTrajectory phaseWord defaultAct)
          (wordPhaseStartStep phaseWord (p + 1))
          (wordPhaseTrajectory phaseWord defaultAct (wordPhaseStartStep phaseWord (p + 1)))) ^ (w + 1) ≤
          spec.c_high * (wordPhaseStartStep phaseWord p : ℚ) ^ w := by
        intro p
        have hcs := uniform_biased_phaseStart_cumScore_eq hw rc.fc b c_step H0 delta J E zeta P0 hMJM hmoment hJ_lower
          spec.parentWord spec.hparent_count spec.rank spec.phaseShift (p + 1)
        rw [hcs]
        exact spec.hgap_high p
      exact all_integer_time_power_gap_bounds hskew hstrict hpt_zero hpt_lt
        (Nat.le_add_left 1 w) hgap_l hgap_h t ht }

/-- Underlying full-rank clock of `RealizedClock.ofUniformLift`. -/
theorem RealizedClock.ofUniformLift_fc {w : ℕ} (hw : 2 ≤ w) (rc : RealizedClock w)
    (b : Fin rc.fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (rc.fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw rc.fc.clock b c_step H0 delta).transpose * X_gateway rc.fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0)
    (spec : UniformLiftSpec hw rc.fc b c_step H0 delta J E zeta P0 hMJM hmoment hJ_lower) :
    (RealizedClock.ofUniformLift hw rc b c_step H0 delta J E zeta P0 hMJM hmoment hJ_lower spec).fc =
      uniformFullRankLift hw rc.fc b c_step H0 delta J E zeta P0 hMJM hmoment :=
  rfl


/-!
### Section 31: Grounded Uniform Lift Specification and Duality Gap Bounds
-/

def C_len {k : ℕ} (fc : FullRankClock k) : ℚ :=
  1 + ∑ x : Fin (fc.clock.m + 1) ⊕ Fin ((k + 1) + (k + 1)),
    ∑ c : Fin (k + 1), |(liftedCountMat (X_gateway fc.clock) (M_coupled k) (N_mat (k + 1))) x c|

theorem C_len_pos {k : ℕ} (fc : FullRankClock k) : 0 < C_len fc := by
  unfold C_len
  have : 0 ≤ ∑ x : Fin (fc.clock.m + 1) ⊕ Fin ((k + 1) + (k + 1)),
      ∑ c : Fin (k + 1), |(liftedCountMat (X_gateway fc.clock) (M_coupled k) (N_mat (k + 1))) x c| := by
    refine Finset.sum_nonneg fun x _ => ?_
    refine Finset.sum_nonneg fun c _ => abs_nonneg _
  linarith

def bundle_c_low {k : ℕ} (fc : FullRankClock k) (phaseShift : ℕ) : ℚ :=
  (2 / (k.factorial : ℚ)) ^ (k + 1) / ((1 + C_len fc * ((phaseShift + 1 : ℚ) ^ k)) ^ k)

theorem bundle_c_low_pos {k : ℕ} (fc : FullRankClock k) (phaseShift : ℕ) :
    0 < bundle_c_low fc phaseShift := by
  unfold bundle_c_low
  have hfact_pos : 0 < (k.factorial : ℚ) := by positivity
  have hbase : 0 < 2 / (k.factorial : ℚ) := by positivity
  have hdenom : 0 < 1 + C_len fc * ((phaseShift + 1 : ℚ) ^ k) := by
    have : 0 < C_len fc := C_len_pos fc
    positivity
  positivity


theorem choose_le_pow (n c k : ℕ) (hc : c ≤ k) : Nat.choose n c ≤ (n + 1) ^ k := by
  have h1 : Nat.choose n c ≤ (n + 1) ^ c := by
    have h_c_le : Nat.choose n c ≤ (n + 1).choose c := Nat.choose_le_choose c (Nat.le_succ n)
    exact le_trans h_c_le (Nat.choose_le_pow (n + 1) c)
  have h2 : (n + 1) ^ c ≤ (n + 1) ^ k :=
    Nat.pow_le_pow_right (Nat.succ_pos n) hc
  exact le_trans h1 h2

theorem binomBasis_upper_bound (k : ℕ) (q phaseShift : ℕ) (c : Fin (k + 1)) :
    binomBasis (k + 1) (q + phaseShift) c ≤ ((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k) := by
  unfold binomBasis
  have hc : c.val ≤ k := by
    have := c.isLt
    omega
  have h_nat_choose : Nat.choose (q + phaseShift) c.val ≤ (q + phaseShift + 1) ^ k :=
    choose_le_pow (q + phaseShift) c.val k hc
  have h_base : q + phaseShift + 1 ≤ (phaseShift + 1) * (q + 1) := by
    nlinarith
  have h_pow_le : (q + phaseShift + 1) ^ k ≤ ((phaseShift + 1) * (q + 1)) ^ k :=
    Nat.pow_le_pow_left h_base k
  rw [Nat.mul_pow] at h_pow_le
  have h_rat : (Nat.choose (q + phaseShift) c.val : ℚ) ≤ (((phaseShift + 1) ^ k * (q + 1) ^ k : ℕ) : ℚ) := by
    exact_mod_cast le_trans h_nat_choose h_pow_le
  push_cast at h_rat
  exact h_rat


theorem pow_le_factorial_mul_choose (k q : ℕ) :
    (q + 1) ^ k ≤ k.factorial * Nat.choose (q + k) k := by
  induction k with
  | zero => simp
  | succ k ih =>
    have h_le1 : (q + 1) ^ k * (q + 1) ≤ (k.factorial * Nat.choose (q + k) k) * (q + 1) :=
      Nat.mul_le_mul_right (q + 1) ih
    have h_le2 : (k.factorial * Nat.choose (q + k) k) * (q + 1) ≤
        (k.factorial * Nat.choose (q + k) k) * (q + k + 1) :=
      Nat.mul_le_mul_left _ (by omega)
    have h_assoc1 : (k.factorial * Nat.choose (q + k) k) * (q + k + 1) =
        k.factorial * ((q + k + 1) * Nat.choose (q + k) k) := by ring
    have h_succ_mul : (q + k + 1) * Nat.choose (q + k) k =
        (k + 1) * Nat.choose (q + (k + 1)) (k + 1) := by
      have h := Nat.add_one_mul_choose_eq (q + k) k
      have h3 : Nat.choose (q + k + 1) (k + 1) = Nat.choose (q + (k + 1)) (k + 1) := by
        congr 1
      rw [h3] at h
      rw [h, mul_comm]
    have h_assoc2 : k.factorial * ((k + 1) * Nat.choose (q + (k + 1)) (k + 1)) =
        (k + 1).factorial * Nat.choose (q + (k + 1)) (k + 1) := by
      rw [Nat.factorial_succ]
      ring
    rw [pow_succ]
    calc (q + 1) ^ k * (q + 1) ≤ (k.factorial * Nat.choose (q + k) k) * (q + 1) := h_le1
      _ ≤ (k.factorial * Nat.choose (q + k) k) * (q + k + 1) := h_le2
      _ = k.factorial * ((q + k + 1) * Nat.choose (q + k) k) := h_assoc1
      _ = k.factorial * ((k + 1) * Nat.choose (q + (k + 1)) (k + 1)) := by rw [h_succ_mul]
      _ = (k + 1).factorial * Nat.choose (q + (k + 1)) (k + 1) := h_assoc2

theorem pow_le_factorial_mul_choose_shifted (k phaseShift : ℕ) (hshift : k ≤ phaseShift) (p : ℕ) :
    (p + 1) ^ k ≤ k.factorial * Nat.choose (p + phaseShift) k := by
  let q := p + (phaseShift - k)
  have h_le : p + 1 ≤ q + 1 := by omega
  have h_pow : (p + 1) ^ k ≤ (q + 1) ^ k := Nat.pow_le_pow_left h_le k
  have h_choose := pow_le_factorial_mul_choose k q
  have h_eq : q + k = p + phaseShift := by omega
  rw [h_eq] at h_choose
  exact le_trans h_pow h_choose

theorem sum_range_choose_offset (k p : ℕ) :
    (∑ q ∈ Finset.range p, Nat.choose (q + k) k) = Nat.choose (p + k) (k + 1) := by
  induction p with
  | zero => simp
  | succ p ih =>
    rw [Finset.sum_range_succ, ih]
    have h_rec := Nat.choose_succ_succ (p + k) k
    have h_succ : (p + k).succ = p + 1 + k := by omega
    have h_ksucc : k.succ = k + 1 := rfl
    rw [h_succ, h_ksucc] at h_rec
    rw [h_rec]
    omega

theorem sum_range_shifted_choose (k phaseShift p : ℕ) (hshift : k ≤ phaseShift) :
    Nat.choose (p + k) (k + 1) ≤ ∑ q ∈ Finset.range p, Nat.choose (q + phaseShift) k := by
  rw [← sum_range_choose_offset k p]
  refine Finset.sum_le_sum fun q _ => ?_
  exact Nat.choose_le_choose k (by omega)

theorem wordPhaseStartStep_shifted_lower_pow {k : ℕ} (fc : FullRankClock k)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis k σ))
    (phaseShift : ℕ) (hshift : k ≤ phaseShift) (p : ℕ) :
    ((p + 1 : ℚ) ^ (k + 1)) / ((2 ^ (k + 1) * (k + 1).factorial : ℕ) : ℚ) ≤
      (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map finSumFinEquiv) p : ℚ) := by
  let phaseWord : ℕ → List (Fin (fc.clock.m + 1 + ((k + 1) + (k + 1)))) := fun q =>
    (rawFourStageWord fc.clock parentWord (q + phaseShift)).map finSumFinEquiv
  have h_len_eq : ∀ r : ℕ, (phaseWord r).length = (rawFourStageWord fc.clock parentWord (r + phaseShift)).length := by
    intro r
    dsimp only [phaseWord]
    rw [List.length_map]
  have h_step_eq : ((wordPhaseStartStep phaseWord p : ℕ) : ℚ) =
      (∑ r ∈ Finset.range p, ((phaseWord r).length : ℚ)) + 1 := by
    unfold wordPhaseStartStep runStart
    push_cast
    ring
  cases p with
  | zero =>
    rw [h_step_eq]
    have h_denom_pos : 0 < (2 ^ (k + 1) * (k + 1).factorial : ℕ) := by positivity
    have h_denom_ge_one : 1 ≤ ((2 ^ (k + 1) * (k + 1).factorial : ℕ) : ℚ) := by
      exact_mod_cast Nat.succ_le_of_lt h_denom_pos
    have h_lhs : ((0 + 1 : ℚ) ^ (k + 1)) / ((2 ^ (k + 1) * (k + 1).factorial : ℕ) : ℚ) ≤ 1 := by
      have : ((0 + 1 : ℚ) ^ (k + 1)) = 1 := by ring
      rw [this]
      exact div_le_one_of_le₀ h_denom_ge_one (by positivity)
    simp only [Finset.range_zero, Finset.sum_empty, zero_add]
    exact h_lhs
  | succ m =>
    rw [h_step_eq]
    have h_term_ge : ∀ r : ℕ, (Nat.choose (r + phaseShift) k : ℚ) ≤ ((phaseWord r).length : ℚ) := by
      intro r
      rw [h_len_eq r]
      have h1 := rawFourStageWord_length_ge_reset fc.clock parentWord hparent_count (r + phaseShift)
      have h_factor : 1 ≤ 2 * (k + 1 : ℚ) := by
        have : (2 : ℚ) ≤ 2 * (k + 1 : ℚ) := by linarith
        linarith
      have h_nonneg : 0 ≤ (Nat.choose (r + phaseShift) k : ℚ) := by positivity
      calc (Nat.choose (r + phaseShift) k : ℚ) = 1 * (Nat.choose (r + phaseShift) k : ℚ) := by ring
        _ ≤ (2 * (k + 1 : ℚ)) * (Nat.choose (r + phaseShift) k : ℚ) := mul_le_mul_of_nonneg_right h_factor h_nonneg
        _ ≤ ((rawFourStageWord fc.clock parentWord (r + phaseShift)).length : ℚ) := h1
    have h_sum_ge := Finset.sum_le_sum fun r (_ : r ∈ Finset.range (m + 1)) => h_term_ge r
    have h_shifted := sum_range_shifted_choose k phaseShift (m + 1) hshift
    have h_rat_shifted : (Nat.choose (m + 1 + k) (k + 1) : ℚ) ≤
        ∑ r ∈ Finset.range (m + 1), (Nat.choose (r + phaseShift) k : ℚ) := by
      exact_mod_cast h_shifted
    have h_choose_le_sum : (Nat.choose (m + 1 + k) (k + 1) : ℚ) ≤
        ∑ r ∈ Finset.range (m + 1), ((phaseWord r).length : ℚ) :=
      le_trans h_rat_shifted h_sum_ge
    have h_pow_double : (m + 1 + 1) ^ (k + 1) ≤ 2 ^ (k + 1) * (m + 1) ^ (k + 1) := by
      have h_double : m + 1 + 1 ≤ 2 * (m + 1) := by omega
      have h := Nat.pow_le_pow_left h_double (k + 1)
      rw [Nat.mul_pow] at h
      exact h
    have h_pow_choose : (m + 1) ^ (k + 1) ≤ (k + 1).factorial * Nat.choose (m + 1 + k) (k + 1) := by
      have h := pow_le_factorial_mul_choose (k + 1) m
      have hm : m + (k + 1) = m + 1 + k := by omega
      rw [hm] at h
      exact h
    have h_comb : (m + 1 + 1) ^ (k + 1) ≤ (2 ^ (k + 1) * (k + 1).factorial) * Nat.choose (m + 1 + k) (k + 1) := by
      have h_mul := Nat.mul_le_mul_left (2 ^ (k + 1)) h_pow_choose
      have h_assoc : 2 ^ (k + 1) * ((k + 1).factorial * Nat.choose (m + 1 + k) (k + 1)) =
          (2 ^ (k + 1) * (k + 1).factorial) * Nat.choose (m + 1 + k) (k + 1) := by ring
      rw [h_assoc] at h_mul
      exact le_trans h_pow_double h_mul
    have h_rat_comb : ((m + 1 + 1 : ℚ) ^ (k + 1)) ≤
        ((2 ^ (k + 1) * (k + 1).factorial : ℕ) : ℚ) * (Nat.choose (m + 1 + k) (k + 1) : ℚ) := by
      have h_cast : (((m + 1 + 1) ^ (k + 1) : ℕ) : ℚ) ≤
          (((2 ^ (k + 1) * (k + 1).factorial) * Nat.choose (m + 1 + k) (k + 1) : ℕ) : ℚ) := by
        exact_mod_cast h_comb
      push_cast at h_cast ⊢
      exact h_cast
    have h_denom_pos : 0 < ((2 ^ (k + 1) * (k + 1).factorial : ℕ) : ℚ) := by positivity
    have h_div_le : ((m + 1 + 1 : ℚ) ^ (k + 1)) / ((2 ^ (k + 1) * (k + 1).factorial : ℕ) : ℚ) ≤
        (Nat.choose (m + 1 + k) (k + 1) : ℚ) :=
      (div_le_iff₀ h_denom_pos).mpr (by linarith [h_rat_comb])
    have h_trans : ((m + 1 + 1 : ℚ) ^ (k + 1)) / ((2 ^ (k + 1) * (k + 1).factorial : ℕ) : ℚ) ≤
        ∑ r ∈ Finset.range (m + 1), ((phaseWord r).length : ℚ) :=
      le_trans h_div_le h_choose_le_sum
    have h_cast_m : ((m + 1 : ℕ) + 1 : ℚ) = (m + 1 + 1 : ℚ) := by push_cast; ring
    rw [h_cast_m]
    linarith

theorem rawFourStageWord_length_upper_bound {k : ℕ} (fc : FullRankClock k)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis k σ))
    (phaseShift q : ℕ) :
    ((rawFourStageWord fc.clock parentWord (q + phaseShift)).length : ℚ) ≤
      C_len fc * ((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k) := by
  let L := liftedCountMat (X_gateway fc.clock) (M_coupled k) (N_mat (k + 1))
  have h_len := rawFourStageWord_length_eq_sum_liftedCountMat fc.clock parentWord hparent_count (q + phaseShift)
  rw [h_len]
  have h_binom_nonneg : ∀ c : Fin (k + 1), 0 ≤ binomBasis (k + 1) (q + phaseShift) c := by
    intro c; unfold binomBasis; positivity
  have h_bound_x : ∀ x : Fin (fc.clock.m + 1) ⊕ Fin ((k + 1) + (k + 1)),
      (L.mulVec (binomBasis (k + 1) (q + phaseShift))) x ≤
        (∑ c : Fin (k + 1), |L x c|) * (((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k)) := by
    intro x
    dsimp only [Matrix.mulVec, dotProduct]
    have h_le_c : ∀ c ∈ (Finset.univ : Finset (Fin (k + 1))), L x c * binomBasis (k + 1) (q + phaseShift) c ≤
        |L x c| * (((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k)) := by
      intro c _
      have h1 : L x c ≤ |L x c| := le_abs_self _
      have h2 := binomBasis_upper_bound k q phaseShift c
      have h_nonneg_prod : 0 ≤ ((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k) := by positivity
      calc L x c * binomBasis (k + 1) (q + phaseShift) c ≤
          |L x c| * binomBasis (k + 1) (q + phaseShift) c := mul_le_mul_of_nonneg_right h1 (h_binom_nonneg c)
        _ ≤ |L x c| * (((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k)) :=
          mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
    have h_sum_c := Finset.sum_le_sum h_le_c
    rw [← Finset.sum_mul] at h_sum_c
    exact h_sum_c
  have h_total_sum := Finset.sum_le_sum fun x (_ : x ∈ Finset.univ) => h_bound_x x
  rw [← Finset.sum_mul] at h_total_sum
  have h_sum_le_C_len : (∑ x : Fin (fc.clock.m + 1) ⊕ Fin ((k + 1) + (k + 1)), ∑ c : Fin (k + 1), |L x c|) ≤ C_len fc := by
    unfold C_len
    linarith
  have h_prod_nonneg : 0 ≤ ((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k) := by positivity
  calc ∑ x : Fin (fc.clock.m + 1) ⊕ Fin ((k + 1) + (k + 1)), (L.mulVec (binomBasis (k + 1) (q + phaseShift))) x ≤
      (∑ x : Fin (fc.clock.m + 1) ⊕ Fin ((k + 1) + (k + 1)), ∑ c : Fin (k + 1), |L x c|) *
        (((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k)) := h_total_sum
    _ ≤ C_len fc * (((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k)) :=
      mul_le_mul_of_nonneg_right h_sum_le_C_len h_prod_nonneg
    _ = C_len fc * ((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k) := by ring

theorem wordPhaseStartStep_shifted_upper_pow {k : ℕ} (fc : FullRankClock k)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis k σ))
    (phaseShift p : ℕ) :
    (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map finSumFinEquiv) (p + 1) : ℚ) ≤
      (1 + C_len fc * ((phaseShift + 1 : ℚ) ^ k)) * ((p + 1 : ℚ) ^ (k + 1)) := by
  let phaseWord : ℕ → List (Fin (fc.clock.m + 1 + ((k + 1) + (k + 1)))) := fun q =>
    (rawFourStageWord fc.clock parentWord (q + phaseShift)).map finSumFinEquiv
  have h_len_eq : ∀ r : ℕ, (phaseWord r).length = (rawFourStageWord fc.clock parentWord (r + phaseShift)).length := by
    intro r
    dsimp only [phaseWord]
    rw [List.length_map]
  have h_step_eq : ((wordPhaseStartStep phaseWord (p + 1) : ℕ) : ℚ) =
      (∑ r ∈ Finset.range (p + 1), ((phaseWord r).length : ℚ)) + 1 := by
    unfold wordPhaseStartStep runStart
    push_cast
    ring
  rw [h_step_eq]
  have h_term_le : ∀ r ∈ Finset.range (p + 1),
      ((phaseWord r).length : ℚ) ≤ C_len fc * ((phaseShift + 1 : ℚ) ^ k) * ((p + 1 : ℚ) ^ k) := by
    intro r hr
    rw [Finset.mem_range] at hr
    have hr_le : r + 1 ≤ p + 1 := by omega
    have hr_pow : (r + 1 : ℚ) ^ k ≤ (p + 1 : ℚ) ^ k := by
      have : (r + 1 : ℚ) ≤ (p + 1 : ℚ) := by exact_mod_cast hr_le
      exact pow_le_pow_left₀ (by positivity) this k
    rw [h_len_eq r]
    have h_upper_r := rawFourStageWord_length_upper_bound fc parentWord hparent_count phaseShift r
    have h_coeff_nonneg : 0 ≤ C_len fc * ((phaseShift + 1 : ℚ) ^ k) := by
      have : 0 < C_len fc := C_len_pos fc
      positivity
    calc ((rawFourStageWord fc.clock parentWord (r + phaseShift)).length : ℚ) ≤
        C_len fc * ((phaseShift + 1 : ℚ) ^ k) * ((r + 1 : ℚ) ^ k) := h_upper_r
      _ ≤ C_len fc * ((phaseShift + 1 : ℚ) ^ k) * ((p + 1 : ℚ) ^ k) :=
        mul_le_mul_of_nonneg_left hr_pow h_coeff_nonneg
  have h_sum_le := Finset.sum_le_sum h_term_le
  have h_sum_const : (∑ r ∈ Finset.range (p + 1), C_len fc * ((phaseShift + 1 : ℚ) ^ k) * ((p + 1 : ℚ) ^ k)) =
      ((p + 1 : ℕ) : ℚ) * (C_len fc * ((phaseShift + 1 : ℚ) ^ k) * ((p + 1 : ℚ) ^ k)) := by
    simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  rw [h_sum_const] at h_sum_le
  have h_reassoc : ((p + 1 : ℕ) : ℚ) * (C_len fc * ((phaseShift + 1 : ℚ) ^ k) * ((p + 1 : ℚ) ^ k)) =
      (C_len fc * ((phaseShift + 1 : ℚ) ^ k)) * ((p + 1 : ℚ) ^ (k + 1)) := by
    have hp_succ : (p + 1 : ℚ) ^ (k + 1) = (p + 1 : ℚ) ^ k * (p + 1 : ℚ) := by
      exact pow_succ (p + 1 : ℚ) k
    push_cast
    rw [hp_succ]
    ring
  rw [h_reassoc] at h_sum_le
  have h_one_le : (1 : ℚ) ≤ 1 * ((p + 1 : ℚ) ^ (k + 1)) := by
    have hp1_ge1 : (1 : ℚ) ≤ (p + 1 : ℚ) := by
      have : (0 : ℚ) ≤ (p : ℚ) := Nat.cast_nonneg p
      linarith
    have hp1_pow_ge1 : (1 : ℚ) ≤ (p + 1 : ℚ) ^ (k + 1) :=
      one_le_pow₀ hp1_ge1
    calc (1 : ℚ) = 1 * 1 := by ring
      _ ≤ 1 * ((p + 1 : ℚ) ^ (k + 1)) := mul_le_mul_of_nonneg_left hp1_pow_ge1 (by linarith)
  linarith


theorem canonicalTieRemovalBias_nonneg {α : Type*} [Fintype α] {m_rank : ℕ}
    (M : Matrix α α ℚ) (s0 : α → ℚ) (hm : 0 < m_rank) (rank : α → Fin m_rank) (i : α) :
    0 ≤ canonicalTieRemovalBias M s0 rank i := by
  unfold canonicalTieRemovalBias tieRemovalBias
  have h_rank_lt : (rank i).val < m_rank := (rank i).isLt
  have h_rank_le : (rank i).val ≤ m_rank - 1 := by omega
  have h_num_nonneg : 0 ≤ (m_rank : ℚ) - 1 - ((rank i).val : ℚ) := by
    have : ((rank i).val : ℚ) ≤ (m_rank - 1 : ℕ) := by exact_mod_cast h_rank_le
    have h_cast : ((m_rank - 1 : ℕ) : ℚ) = (m_rank : ℚ) - 1 := by
      have : 1 ≤ m_rank := by omega
      exact Nat.cast_sub this
    rw [h_cast] at this
    linarith
  have h_D0_pos : 0 < canonicalGridDenom M s0 := canonicalGridDenom_pos M s0
  have h_denom_pos : 0 < 4 * (m_rank : ℚ) * canonicalGridDenom M s0 := by
    have : 0 < (m_rank : ℚ) := by exact_mod_cast hm
    positivity
  exact div_nonneg h_num_nonneg (le_of_lt h_denom_pos)

theorem one_le_canonicalScoreShift {m : ℕ} (s0 : Fin m → ℚ) :
    1 ≤ canonicalScoreShift s0 := by
  unfold canonicalScoreShift
  have : 0 ≤ ∑ i : Fin m, |s0 i| := Finset.sum_nonneg fun i _ => abs_nonneg (s0 i)
  linarith


/-- Nonnegativity of `uniformBiasedScoreShift`. -/
theorem uniform_score_shift_nonneg {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    {m_rank : ℕ} (hm : 0 < m_rank)
    (rank : Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m → Fin m_rank)
    (phaseShift : ℕ) :
    0 ≤ uniformBiasedScoreShift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift := by
  unfold uniformBiasedScoreShift uniformTieRemovalBias
  have h1 : 0 ≤ canonicalTieRemovalBias
      (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.G
      (uniformInitScoreVec hw fc b c_step H0 delta J E zeta P0 hMJM hmoment phaseShift) rank
      ⟨0, by have := uniformFullRankLift_m_pos hw fc b c_step H0 delta J E zeta P0 hMJM hmoment; omega⟩ :=
    canonicalTieRemovalBias_nonneg _ _ hm rank _
  have h2 : 1 ≤ canonicalScoreShift
      (uniformBiasedInitScoreVec hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift phaseShift) :=
    one_le_canonicalScoreShift _
  linarith

/-- Universal Cauchy-Schwarz bound on `dotProduct zeta (binomBasis (w + 1) (q + phaseShift))`. -/
theorem dotProduct_zeta_le_general {w : ℕ} (zeta : Fin (w + 1) → ℚ) (q phaseShift : ℕ) :
    dotProduct zeta (binomBasis (w + 1) (q + phaseShift)) ≤
      (∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * ((q + 1 : ℚ) ^ w) := by
  dsimp only [dotProduct]
  have h_term_le : ∀ c ∈ (Finset.univ : Finset (Fin (w + 1))),
      zeta c * binomBasis (w + 1) (q + phaseShift) c ≤
        |zeta c| * (((phaseShift + 1 : ℚ) ^ w) * ((q + 1 : ℚ) ^ w)) := by
    intro c _
    have h1 : zeta c ≤ |zeta c| := le_abs_self _
    have h2 := binomBasis_upper_bound w q phaseShift c
    have h_nonneg : 0 ≤ binomBasis (w + 1) (q + phaseShift) c := by unfold binomBasis; positivity
    calc zeta c * binomBasis (w + 1) (q + phaseShift) c ≤
        |zeta c| * binomBasis (w + 1) (q + phaseShift) c :=
          mul_le_mul_of_nonneg_right h1 h_nonneg
      _ ≤ |zeta c| * (((phaseShift + 1 : ℚ) ^ w) * ((q + 1 : ℚ) ^ w)) :=
        mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
  have h_sum_le := Finset.sum_le_sum h_term_le
  rw [← Finset.sum_mul] at h_sum_le
  rw [mul_assoc]
  exact h_sum_le

/-- Linear-in-`(p + 1)^w` upper bound on the shifted score under arbitrary `zeta`. -/
theorem score_upper_bound_uniform {w : ℕ} (zeta : Fin (w + 1) → ℚ) (shift : ℚ)
    (phaseShift p : ℕ) :
    2 * (dotProduct zeta (binomBasis (w + 1) (p + 1 + phaseShift)) + shift) ≤
      (2 * ((∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * 2 ^ w + (|shift| + 1))) * (p + 1 : ℚ) ^ w := by
  have h_dot := dotProduct_zeta_le_general zeta (p + 1) phaseShift
  have h_p2_pow : (p + 1 + 1 : ℚ) ^ w ≤ (2 ^ w : ℚ) * (p + 1 : ℚ) ^ w := by
    have h1 : (p + 1 + 1 : ℚ) ≤ 2 * (p + 1 : ℚ) := by linarith
    have h2 : 0 ≤ (p + 1 + 1 : ℚ) := by positivity
    have h3 := pow_le_pow_left₀ h2 h1 w
    rw [mul_pow] at h3
    exact h3
  have h_C_nonneg : 0 ≤ (∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) := by
    have : 0 ≤ ∑ c : Fin (w + 1), |zeta c| := Finset.sum_nonneg fun c _ => abs_nonneg _
    positivity
  have h_cast_p1 : ((p + 1 : ℕ) + 1 : ℚ) = (p + 1 + 1 : ℚ) := by push_cast; ring
  rw [h_cast_p1] at h_dot
  have h_dot_le : dotProduct zeta (binomBasis (w + 1) (p + 1 + phaseShift)) ≤
      ((∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * 2 ^ w) * (p + 1 : ℚ) ^ w := by
    calc dotProduct zeta (binomBasis (w + 1) (p + 1 + phaseShift)) ≤
        (∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * ((p + 1 + 1 : ℚ) ^ w) := h_dot
      _ ≤ (∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * ((2 ^ w : ℚ) * (p + 1 : ℚ) ^ w) :=
        mul_le_mul_of_nonneg_left h_p2_pow h_C_nonneg
      _ = ((∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * 2 ^ w) * (p + 1 : ℚ) ^ w := by ring
  have h_shift_le : shift ≤ (|shift| + 1) * (p + 1 : ℚ) ^ w := by
    have h1 : shift ≤ |shift| := le_abs_self shift
    have h2 : |shift| ≤ |shift| + 1 := by linarith
    have hp : 1 ≤ (p + 1 : ℚ) := by
      have : (0 : ℚ) ≤ (p : ℚ) := Nat.cast_nonneg p
      linarith
    have h3 : (1 : ℚ) ≤ (p + 1 : ℚ) ^ w := one_le_pow₀ hp
    have hpos : 0 ≤ |shift| + 1 := by positivity
    calc shift ≤ |shift| := h1
      _ ≤ |shift| + 1 := h2
      _ = (|shift| + 1) * 1 := by ring
      _ ≤ (|shift| + 1) * (p + 1 : ℚ) ^ w := mul_le_mul_of_nonneg_left h3 hpos
  have h_sum_le : dotProduct zeta (binomBasis (w + 1) (p + 1 + phaseShift)) + shift ≤
      ((∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * 2 ^ w + (|shift| + 1)) * (p + 1 : ℚ) ^ w := by
    calc dotProduct zeta (binomBasis (w + 1) (p + 1 + phaseShift)) + shift ≤
        ((∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * 2 ^ w) * (p + 1 : ℚ) ^ w +
          (|shift| + 1) * (p + 1 : ℚ) ^ w := by linarith [h_dot_le, h_shift_le]
      _ = ((∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * 2 ^ w + (|shift| + 1)) * (p + 1 : ℚ) ^ w := by ring
  calc 2 * (dotProduct zeta (binomBasis (w + 1) (p + 1 + phaseShift)) + shift) ≤
      2 * (((∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * 2 ^ w + (|shift| + 1)) * (p + 1 : ℚ) ^ w) :=
        mul_le_mul_of_nonneg_left h_sum_le (by positivity)
    _ = (2 * ((∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * 2 ^ w + (|shift| + 1))) * (p + 1 : ℚ) ^ w := by ring

/-- Explicit upper gap constant for the uniform lift. -/
def uniform_c_high (w : ℕ) (zeta : Fin (w + 1) → ℚ) (shift : ℚ) (phaseShift : ℕ) : ℚ :=
  let C_base := 2 * ((∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * 2 ^ w + (|shift| + 1))
  C_base ^ (w + 1) * ((2 ^ (w + 1) * (w + 1).factorial : ℕ) : ℚ) ^ w

/-- Positivity of `uniform_c_high`. -/
theorem uniform_c_high_pos (w : ℕ) (zeta : Fin (w + 1) → ℚ) (shift : ℚ) (phaseShift : ℕ) :
    0 < uniform_c_high w zeta shift phaseShift := by
  unfold uniform_c_high
  have h_base : 0 < 2 * ((∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * 2 ^ w + (|shift| + 1)) := by
    have h1 : 0 ≤ (∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * 2 ^ w := by
      have : 0 ≤ ∑ c : Fin (w + 1), |zeta c| := Finset.sum_nonneg fun c _ => abs_nonneg _
      positivity
    have h2 : 0 < |shift| + 1 := by positivity
    linarith
  have h_fact : 0 < ((2 ^ (w + 1) * (w + 1).factorial : ℕ) : ℚ) := by positivity
  positivity

/-- **Unconditional Lower Gap Bound for Uniform Lift (`uniform_hgap_low`)**:
    Proves that for any full-rank clock and ceiling with `dotProduct zeta (binomBasis (w + 1) q) ≥ 1 + choose q w`,
    the degree-`w` phase start power bound holds with constant `bundle_c_low fc phaseShift`. -/
theorem uniform_hgap_low {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (phaseShift : ℕ) (hshift : w ≤ phaseShift)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis w σ))
    {m_rank : ℕ} (hm_rank : 0 < m_rank)
    (rank : Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m → Fin m_rank)
    (h_dot_ge : ∀ p : ℕ, 1 + (Nat.choose (p + phaseShift) w : ℚ) ≤ dotProduct zeta (binomBasis (w + 1) (p + phaseShift)))
    (p : ℕ) :
    let rotEquiv : _ ≃ Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m :=
      rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1))
    let shift := uniformBiasedScoreShift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift
    bundle_c_low fc phaseShift * (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map rotEquiv) (p + 1) : ℚ) ^ w ≤
      (2 * (dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) + shift)) ^ (w + 1) := by
  intro rotEquiv shift
  have hshift_nonneg : 0 ≤ shift := uniform_score_shift_nonneg hw fc b c_step H0 delta J E zeta P0 hMJM hmoment hm_rank rank phaseShift
  have h_choose_le : (p + 1 : ℚ) ^ w ≤ (w.factorial : ℚ) * (Nat.choose (p + phaseShift) w : ℚ) := by
    exact_mod_cast pow_le_factorial_mul_choose_shifted w phaseShift hshift p
  have h_fact_pos : 0 < (w.factorial : ℚ) := by positivity
  have h_choose_div : (p + 1 : ℚ) ^ w / (w.factorial : ℚ) ≤ (Nat.choose (p + phaseShift) w : ℚ) := by
    rw [div_le_iff₀ h_fact_pos]
    linarith [h_choose_le]
  have h_score_ge : (p + 1 : ℚ) ^ w / (w.factorial : ℚ) ≤
      dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) + shift := by
    calc (p + 1 : ℚ) ^ w / (w.factorial : ℚ) ≤ (Nat.choose (p + phaseShift) w : ℚ) := h_choose_div
      _ ≤ 1 + (Nat.choose (p + phaseShift) w : ℚ) := by linarith
      _ ≤ dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) := h_dot_ge p
      _ ≤ dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) + shift := by linarith [hshift_nonneg]
  have h_score_mul : (2 / (w.factorial : ℚ)) * ((p + 1 : ℚ) ^ w) ≤
      2 * (dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) + shift) := by
    calc (2 / (w.factorial : ℚ)) * ((p + 1 : ℚ) ^ w) = 2 * ((p + 1 : ℚ) ^ w / (w.factorial : ℚ)) := by ring
      _ ≤ 2 * (dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) + shift) :=
        mul_le_mul_of_nonneg_left h_score_ge (by positivity)
  have h_pow_score : ((2 / (w.factorial : ℚ)) * ((p + 1 : ℚ) ^ w)) ^ (w + 1) ≤
      (2 * (dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) + shift)) ^ (w + 1) := by
    have h_nonneg_lhs : 0 ≤ (2 / (w.factorial : ℚ)) * ((p + 1 : ℚ) ^ w) := by positivity
    exact pow_le_pow_left₀ h_nonneg_lhs h_score_mul (w + 1)
  rw [mul_pow] at h_pow_score
  have h_pow_comm1 : (((p + 1 : ℚ) ^ w) ^ (w + 1)) = (p + 1 : ℚ) ^ (w * (w + 1)) := by
    exact (pow_mul (p + 1 : ℚ) w (w + 1)).symm
  rw [h_pow_comm1] at h_pow_score
  have h_step_equiv :
      (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map rotEquiv) (p + 1) : ℚ) =
      (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map finSumFinEquiv) (p + 1) : ℚ) := by
    unfold wordPhaseStartStep runStart
    simp only [List.length_map]
  rw [h_step_equiv]
  have h_upper := wordPhaseStartStep_shifted_upper_pow fc parentWord hparent_count phaseShift p
  have h_step_nonneg : 0 ≤ (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map finSumFinEquiv) (p + 1) : ℚ) := by positivity
  have h_upper_pow : (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map finSumFinEquiv) (p + 1) : ℚ) ^ w ≤
      ((1 + C_len fc * ((phaseShift + 1 : ℚ) ^ w)) * ((p + 1 : ℚ) ^ (w + 1))) ^ w :=
    pow_le_pow_left₀ h_step_nonneg h_upper w
  rw [mul_pow] at h_upper_pow
  have h_pow_comm2 : (((p + 1 : ℚ) ^ (w + 1)) ^ w) = (p + 1 : ℚ) ^ (w * (w + 1)) := by
    have h1 : (((p + 1 : ℚ) ^ (w + 1)) ^ w) = (p + 1 : ℚ) ^ ((w + 1) * w) := by
      exact (pow_mul (p + 1 : ℚ) (w + 1) w).symm
    have h2 : (w + 1) * w = w * (w + 1) := by ring
    rw [h1, h2]
  rw [h_pow_comm2] at h_upper_pow
  have h_denom_pos : 0 < (1 + C_len fc * ((phaseShift + 1 : ℚ) ^ w)) ^ w := by
    have : 0 < C_len fc := C_len_pos fc
    positivity
  have h_low_step : bundle_c_low fc phaseShift * (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map finSumFinEquiv) (p + 1) : ℚ) ^ w ≤
      (2 / (w.factorial : ℚ)) ^ (w + 1) * (p + 1 : ℚ) ^ (w * (w + 1)) := by
    unfold bundle_c_low
    have h_div_mul : (2 / (w.factorial : ℚ)) ^ (w + 1) / ((1 + C_len fc * ((phaseShift + 1 : ℚ) ^ w)) ^ w) *
        (((1 + C_len fc * ((phaseShift + 1 : ℚ) ^ w)) ^ w) * (p + 1 : ℚ) ^ (w * (w + 1))) =
        (2 / (w.factorial : ℚ)) ^ (w + 1) * (p + 1 : ℚ) ^ (w * (w + 1)) := by
      calc (2 / (w.factorial : ℚ)) ^ (w + 1) / ((1 + C_len fc * ((phaseShift + 1 : ℚ) ^ w)) ^ w) *
          (((1 + C_len fc * ((phaseShift + 1 : ℚ) ^ w)) ^ w) * (p + 1 : ℚ) ^ (w * (w + 1))) =
          ((2 / (w.factorial : ℚ)) ^ (w + 1) / ((1 + C_len fc * ((phaseShift + 1 : ℚ) ^ w)) ^ w) *
            ((1 + C_len fc * ((phaseShift + 1 : ℚ) ^ w)) ^ w)) * (p + 1 : ℚ) ^ (w * (w + 1)) := by ring
        _ = (2 / (w.factorial : ℚ)) ^ (w + 1) * (p + 1 : ℚ) ^ (w * (w + 1)) := by
          rw [div_mul_cancel₀ _ (ne_of_gt h_denom_pos)]
    calc (2 / (w.factorial : ℚ)) ^ (w + 1) / ((1 + C_len fc * ((phaseShift + 1 : ℚ) ^ w)) ^ w) *
          (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map finSumFinEquiv) (p + 1) : ℚ) ^ w ≤
        (2 / (w.factorial : ℚ)) ^ (w + 1) / ((1 + C_len fc * ((phaseShift + 1 : ℚ) ^ w)) ^ w) *
          (((1 + C_len fc * ((phaseShift + 1 : ℚ) ^ w)) ^ w) * (p + 1 : ℚ) ^ (w * (w + 1))) :=
        mul_le_mul_of_nonneg_left h_upper_pow (by positivity)
      _ = (2 / (w.factorial : ℚ)) ^ (w + 1) * (p + 1 : ℚ) ^ (w * (w + 1)) := h_div_mul
  exact le_trans h_low_step h_pow_score

/-- **Unconditional Upper Gap Bound for Uniform Lift (`uniform_hgap_high`)**:
    Proves that for any full-rank clock and nonnegative ceiling, the degree-`w` upper gap bound holds
    with constant `uniform_c_high w zeta shift phaseShift`. -/
theorem uniform_hgap_high {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (phaseShift : ℕ) (hshift : w ≤ phaseShift)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis w σ))
    {m_rank : ℕ} (hm_rank : 0 < m_rank)
    (rank : Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m → Fin m_rank)
    (h_dot_ge : ∀ p : ℕ, 0 ≤ dotProduct zeta (binomBasis (w + 1) (p + 1 + phaseShift)))
    (p : ℕ) :
    let rotEquiv : _ ≃ Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m :=
      rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1))
    let shift := uniformBiasedScoreShift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment rank phaseShift
    (2 * (dotProduct zeta (binomBasis (w + 1) (p + 1 + phaseShift)) + shift)) ^ (w + 1) ≤
      uniform_c_high w zeta shift phaseShift *
        (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map rotEquiv) p : ℚ) ^ w := by
  intro rotEquiv shift
  have hshift_nonneg : 0 ≤ shift := uniform_score_shift_nonneg hw fc b c_step H0 delta J E zeta P0 hMJM hmoment hm_rank rank phaseShift
  let C_base := 2 * ((∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * 2 ^ w + (|shift| + 1))
  have h_nonneg_score : 0 ≤ 2 * (dotProduct zeta (binomBasis (w + 1) (p + 1 + phaseShift)) + shift) := by
    have h1 := h_dot_ge p
    have h2 : 0 ≤ dotProduct zeta (binomBasis (w + 1) (p + 1 + phaseShift)) + shift := by linarith [hshift_nonneg]
    linarith
  have h_bound_lin := score_upper_bound_uniform zeta shift phaseShift p
  have h_bound_pow : (2 * (dotProduct zeta (binomBasis (w + 1) (p + 1 + phaseShift)) + shift)) ^ (w + 1) ≤
      (C_base * (p + 1 : ℚ) ^ w) ^ (w + 1) :=
    pow_le_pow_left₀ h_nonneg_score h_bound_lin (w + 1)
  have h_rhs_rw : (C_base * (p + 1 : ℚ) ^ w) ^ (w + 1) = C_base ^ (w + 1) * (p + 1 : ℚ) ^ (w * (w + 1)) := by
    rw [mul_pow]
    have h_pow_comm : (((p + 1 : ℚ) ^ w) ^ (w + 1)) = (p + 1 : ℚ) ^ (w * (w + 1)) := by
      exact (pow_mul (p + 1 : ℚ) w (w + 1)).symm
    rw [h_pow_comm]
  rw [h_rhs_rw] at h_bound_pow
  have hC_base_nonneg : 0 ≤ C_base := by
    have : 0 ≤ (∑ c : Fin (w + 1), |zeta c|) * ((phaseShift + 1 : ℚ) ^ w) * 2 ^ w := by
      have : 0 ≤ ∑ c : Fin (w + 1), |zeta c| := Finset.sum_nonneg fun c _ => abs_nonneg _
      positivity
    linarith [abs_nonneg shift]
  have hC_base_pow_nonneg : 0 ≤ C_base ^ (w + 1) := pow_nonneg hC_base_nonneg (w + 1)
  have h_step_equiv :
      (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map rotEquiv) p : ℚ) =
      (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map finSumFinEquiv) p : ℚ) := by
    unfold wordPhaseStartStep runStart
    simp only [List.length_map]
  let phaseWord : ℕ → List (Fin (fc.clock.m + 1 + ((w + 1) + (w + 1)))) := fun q =>
    (rawFourStageWord fc.clock parentWord (q + phaseShift)).map finSumFinEquiv
  have h_step_rw : (wordPhaseStartStep (fun q => (rawFourStageWord fc.clock parentWord (q + phaseShift)).map rotEquiv) p : ℚ) =
      (wordPhaseStartStep phaseWord p : ℚ) := h_step_equiv
  rw [h_step_rw]
  cases p with
  | zero =>
    have h_p0_step : (wordPhaseStartStep phaseWord 0 : ℚ) = 1 := by
      unfold wordPhaseStartStep runStart
      push_cast
      simp only [Finset.range_zero, Finset.sum_empty, zero_add]
    have hp0_pow : (↑(0 : ℕ) + 1 : ℚ) ^ (w * (w + 1)) = 1 := by ring
    rw [hp0_pow, mul_one] at h_bound_pow
    have h_denom_pos_nat : 0 < 2 ^ (w + 1) * (w + 1).factorial := by positivity
    have h_denom_ge_one : 1 ≤ ((2 ^ (w + 1) * (w + 1).factorial : ℕ) : ℚ) := by
      exact_mod_cast Nat.succ_le_of_lt h_denom_pos_nat
    have h_pow_denom_ge_one : 1 ≤ ((2 ^ (w + 1) * (w + 1).factorial : ℕ) : ℚ) ^ w :=
      one_le_pow₀ h_denom_ge_one
    have h_c_high_ge : C_base ^ (w + 1) ≤ uniform_c_high w zeta shift phaseShift := by
      unfold uniform_c_high
      calc C_base ^ (w + 1) = C_base ^ (w + 1) * 1 := by ring
        _ ≤ C_base ^ (w + 1) * ((2 ^ (w + 1) * (w + 1).factorial : ℕ) : ℚ) ^ w :=
          mul_le_mul_of_nonneg_left h_pow_denom_ge_one hC_base_pow_nonneg
    have h_trans := le_trans h_bound_pow h_c_high_ge
    rw [h_p0_step, one_pow, mul_one]
    exact h_trans
  | succ m =>
    have h_lower := wordPhaseStartStep_shifted_lower_pow fc parentWord hparent_count phaseShift hshift (m + 1)
    have h_denom_pos : 0 < ((2 ^ (w + 1) * (w + 1).factorial : ℕ) : ℚ) := by positivity
    have h_cast_m : ((m + 1 : ℕ) + 1 : ℚ) = (m + 1 + 1 : ℚ) := by push_cast; ring
    rw [h_cast_m] at h_lower
    have h_m1_le : (m + 1 + 1 : ℚ) ^ (w + 1) ≤ ((2 ^ (w + 1) * (w + 1).factorial : ℕ) : ℚ) * (wordPhaseStartStep phaseWord (m + 1) : ℚ) := by
      have h := (div_le_iff₀ h_denom_pos).mp h_lower
      linarith [h]
    have h_m1_pow_k : ((m + 1 + 1 : ℚ) ^ (w + 1)) ^ w ≤
        (((2 ^ (w + 1) * (w + 1).factorial : ℕ) : ℚ) * (wordPhaseStartStep phaseWord (m + 1) : ℚ)) ^ w :=
      pow_le_pow_left₀ (by positivity) h_m1_le w
    rw [mul_pow] at h_m1_pow_k
    have h_pow_comm2 : (((m + 1 + 1 : ℚ) ^ (w + 1)) ^ w) = (m + 1 + 1 : ℚ) ^ (w * (w + 1)) := by
      have h1 : (((m + 1 + 1 : ℚ) ^ (w + 1)) ^ w) = (m + 1 + 1 : ℚ) ^ ((w + 1) * w) := by
        exact (pow_mul (m + 1 + 1 : ℚ) (w + 1) w).symm
      have h2 : (w + 1) * w = w * (w + 1) := by ring
      rw [h1, h2]
    rw [h_pow_comm2] at h_m1_pow_k
    have h_step_bound : C_base ^ (w + 1) * (m + 1 + 1 : ℚ) ^ (w * (w + 1)) ≤
        (C_base ^ (w + 1) * ((2 ^ (w + 1) * (w + 1).factorial : ℕ) : ℚ) ^ w) *
          (wordPhaseStartStep phaseWord (m + 1) : ℚ) ^ w := by
      calc C_base ^ (w + 1) * (m + 1 + 1 : ℚ) ^ (w * (w + 1)) ≤
          C_base ^ (w + 1) * ((((2 ^ (w + 1) * (w + 1).factorial : ℕ) : ℚ) ^ w) * (wordPhaseStartStep phaseWord (m + 1) : ℚ) ^ w) :=
            mul_le_mul_of_nonneg_left h_m1_pow_k hC_base_pow_nonneg
        _ = (C_base ^ (w + 1) * ((2 ^ (w + 1) * (w + 1).factorial : ℕ) : ℚ) ^ w) *
              (wordPhaseStartStep phaseWord (m + 1) : ℚ) ^ w := by ring
    rw [h_cast_m] at h_bound_pow
    exact le_trans h_bound_pow h_step_bound

/-!
### 2. Four-Stage Priority Decomposition for Uniform Lift
-/

/-- **Master Four-Stage Priority Reduction for the Uniform Lift**:
    Proves that priority validity of `rawFourStageWord` on the uniform lifted game matrix follows directly
    from priority validity of the four individual stages. -/
theorem uniform_hpriority_raw_of_stages {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (parent_rank : Fin fc.clock.m → Fin fc.clock.m)
    (q : ℕ) :
    let G_O := AdjoinLeaderEndpointG fc.clock.G b fc.clock.v
    let P := P_uniform_coupled hw fc.clock b c_step H0 delta J zeta P0 fc.L_C
    let S := S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta
    let X := X_gateway fc.clock
    let M := M_coupled w
    let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)
    (h_early : IsValidPriorityWord (liftedGameMat G_O P J) s0
      (paperPriorityRank fc.clock.m w parent_rank) (W_early_word fc.clock.m w q)) →
    (h_late : IsValidPriorityWord (liftedGameMat G_O P J)
      (wordScore (liftedGameMat G_O P J) s0 (W_early_word fc.clock.m w q))
      (paperPriorityRank fc.clock.m w parent_rank) (W_late_word fc.clock.m w q)) →
    (h_bundle : IsValidPriorityWord (liftedGameMat G_O P J)
      (wordScore (liftedGameMat G_O P J) s0 (W_early_word fc.clock.m w q ++ W_late_word fc.clock.m w q))
      (paperPriorityRank fc.clock.m w parent_rank)
      ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct fc.clock.m w))) →
    (h_gw : ∀ y, y ≠ gatewayToLiftedAct fc.clock.m w →
      wordScore (liftedGameMat G_O P J) s0
        (W_early_word fc.clock.m w q ++ W_late_word fc.clock.m w q ++
          ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct fc.clock.m w))) y <
      wordScore (liftedGameMat G_O P J) s0
        (W_early_word fc.clock.m w q ++ W_late_word fc.clock.m w q ++
          ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct fc.clock.m w)))
        (gatewayToLiftedAct fc.clock.m w)) →
    IsValidPriorityWord (liftedGameMat G_O P J) s0
      (paperPriorityRank fc.clock.m w parent_rank)
      (rawFourStageWord fc.clock parentWord q) := by
  intro G_O P S X M s0 h_early h_late h_bundle h_gw
  exact chronology_rawFourStageWord_of_stage_conditions fc.clock parentWord q G_O P J parent_rank s0
    h_early h_late h_bundle h_gw

/-- In the rotated coordinate system of `uniformFullRankLift`, the paper priority rank transports
    to an action rank on `Fin (uniformFullRankLift ...).clock.m`. -/
def uniformActionRank {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (parent_rank : Fin fc.clock.m → Fin fc.clock.m) :
    Fin (uniformFullRankLift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment).clock.m →
      Fin (fc.clock.m + 2 * (w + 1) + 1) := fun i =>
  paperPriorityRank fc.clock.m w parent_rank
    ((rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1))).symm i)

/-- Mapped action rank satisfies the identity `rank (rotLeaderEquiv x) = paperPriorityRank x`. -/
theorem uniformActionRank_rotLeaderEquiv {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (parent_rank : Fin fc.clock.m → Fin fc.clock.m)
    (x : Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1))) :
    uniformActionRank hw fc b c_step H0 delta J E zeta P0 hMJM hmoment parent_rank
      ((rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1))) x) =
    paperPriorityRank fc.clock.m w parent_rank x := by
  dsimp only [uniformActionRank]
  rw [Equiv.symm_apply_apply]

/-- **Stage 4 Domination from Component Conditions**:
    Combines parent domination `stage4_parent_domination_h_uniform` and reset domination
    `stage4_reset_domination_h_uniform` to prove that the single gateway action strictly beats
    all other actions at the end of Stage 3. -/
theorem uniform_stage4_gateway_dominance {w : ℕ} (_hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step delta : ℚ) (hdelta : 0 < delta)
    (zeta : Fin (w + 1) → ℚ) (q : ℕ)
    (s_end : Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)) → ℚ)
    (h_parent : ∀ i : Fin fc.clock.m,
      s_end (Sum.inl (finSumFinEquiv (Sum.inl i))) =
        fc.clock.R.mulVec (binomBasis w (q + 1)) i +
          dotProduct (h_uniform fc.clock b zeta c_step) (binomBasis (w + 1) (q + 1)))
    (h_leader : ∀ i : Fin fc.clock.m,
      fc.clock.R.mulVec (binomBasis w (q + 1)) i ≤ fc.clock.R.mulVec (binomBasis w (q + 1)) b)
    (h_gw : s_end (gatewayToLiftedAct fc.clock.m w) =
      fc.clock.R.mulVec (binomBasis w (q + 1)) b +
        dotProduct (h_uniform fc.clock b zeta c_step) (binomBasis (w + 1) (q + 1)) + delta)
    (h_reset : ∀ r : Fin ((w + 1) + (w + 1)),
      s_end (Sum.inr r) < dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + delta) :
    ∀ y : Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
      y ≠ gatewayToLiftedAct fc.clock.m w →
      s_end y < s_end (gatewayToLiftedAct fc.clock.m w) := by
  intro y hy
  cases y with
  | inl x =>
    cases hx : finSumFinEquiv.symm x with
    | inl i =>
      have hx_eq : x = finSumFinEquiv (Sum.inl i) := by rw [← hx, Equiv.apply_symm_apply]
      rw [hx_eq, h_parent i, h_gw]
      have hdom := stage4_parent_domination_h_uniform fc.clock b zeta c_step delta q i (h_leader i)
      linarith
    | inr v =>
      have hv0 : v = 0 := Subsingleton.elim v 0
      have hx_gw : x = gatewayOldAct fc.clock.m := by
        apply finSumFinEquiv.symm.injective
        rw [hx, hv0]
        exact (finSumFinEquiv.symm_apply_apply (Sum.inr 0)).symm
      have hy_gw : Sum.inl x = gatewayToLiftedAct fc.clock.m w := by
        rw [hx_gw]
        rfl
      exact False.elim (hy hy_gw)
  | inr r =>
    rw [h_gw, stage4_gateway_score_h_uniform fc.clock b zeta c_step delta q]
    exact h_reset r

/-- **Modular Constructor for `UniformLiftSpec` (`UniformLiftSpec.ofGroundedStages`)**:
    Constructs `UniformLiftSpec` given the verified stagewise priority bounds, ceiling growth,
    and parent count preservation. -/
def UniformLiftSpec.ofGroundedStages {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0)
    (phaseShift : ℕ) (hshift : w ≤ phaseShift)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis w σ))
    (parent_rank : Fin fc.clock.m → Fin fc.clock.m)
    (h_dot_ge_low : ∀ p : ℕ, 1 + (Nat.choose (p + phaseShift) w : ℚ) ≤ dotProduct zeta (binomBasis (w + 1) (p + phaseShift)))
    (h_dot_ge_high : ∀ p : ℕ, 0 ≤ dotProduct zeta (binomBasis (w + 1) (p + 1 + phaseShift)))
    (h_early : ∀ p : ℕ,
      let G_O := AdjoinLeaderEndpointG fc.clock.G b fc.clock.v
      let P := P_uniform_coupled hw fc.clock b c_step H0 delta J zeta P0 fc.L_C
      let S := S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta
      let X := X_gateway fc.clock
      let M := M_coupled w
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) (p + phaseShift))
      IsValidPriorityWord (liftedGameMat G_O P J) s0
        (paperPriorityRank fc.clock.m w parent_rank) (W_early_word fc.clock.m w (p + phaseShift)))
    (h_late : ∀ p : ℕ,
      let G_O := AdjoinLeaderEndpointG fc.clock.G b fc.clock.v
      let P := P_uniform_coupled hw fc.clock b c_step H0 delta J zeta P0 fc.L_C
      let S := S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta
      let X := X_gateway fc.clock
      let M := M_coupled w
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) (p + phaseShift))
      IsValidPriorityWord (liftedGameMat G_O P J)
        (wordScore (liftedGameMat G_O P J) s0 (W_early_word fc.clock.m w (p + phaseShift)))
        (paperPriorityRank fc.clock.m w parent_rank) (W_late_word fc.clock.m w (p + phaseShift)))
    (h_bundle : ∀ p : ℕ,
      let G_O := AdjoinLeaderEndpointG fc.clock.G b fc.clock.v
      let P := P_uniform_coupled hw fc.clock b c_step H0 delta J zeta P0 fc.L_C
      let S := S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta
      let X := X_gateway fc.clock
      let M := M_coupled w
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) (p + phaseShift))
      IsValidPriorityWord (liftedGameMat G_O P J)
        (wordScore (liftedGameMat G_O P J) s0 (W_early_word fc.clock.m w (p + phaseShift) ++ W_late_word fc.clock.m w (p + phaseShift)))
        (paperPriorityRank fc.clock.m w parent_rank)
        ((W_bundle_word parentWord (p + phaseShift + 1)).map (bundleToLiftedAct fc.clock.m w)))
    (h_gw : ∀ p : ℕ,
      let G_O := AdjoinLeaderEndpointG fc.clock.G b fc.clock.v
      let P := P_uniform_coupled hw fc.clock b c_step H0 delta J zeta P0 fc.L_C
      let S := S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta
      let X := X_gateway fc.clock
      let M := M_coupled w
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) (p + phaseShift))
      ∀ y, y ≠ gatewayToLiftedAct fc.clock.m w →
        wordScore (liftedGameMat G_O P J) s0
          (W_early_word fc.clock.m w (p + phaseShift) ++ W_late_word fc.clock.m w (p + phaseShift) ++
            ((W_bundle_word parentWord (p + phaseShift + 1)).map (bundleToLiftedAct fc.clock.m w))) y <
        wordScore (liftedGameMat G_O P J) s0
          (W_early_word fc.clock.m w (p + phaseShift) ++ W_late_word fc.clock.m w (p + phaseShift) ++
            ((W_bundle_word parentWord (p + phaseShift + 1)).map (bundleToLiftedAct fc.clock.m w)))
          (gatewayToLiftedAct fc.clock.m w)) :
    UniformLiftSpec hw fc b c_step H0 delta J E zeta P0 hMJM hmoment hJ_lower where
  phaseShift := phaseShift
  parentWord := parentWord
  hparent_count := hparent_count
  m_rank := fc.clock.m + 2 * (w + 1) + 1
  hm_rank := by omega
  rank := uniformActionRank hw fc b c_step H0 delta J E zeta P0 hMJM hmoment parent_rank
  hpriority_raw := fun p => by
    have h_raw := uniform_hpriority_raw_of_stages hw fc b c_step H0 delta J zeta P0 parentWord parent_rank (p + phaseShift)
      (h_early p) (h_late p) (h_bundle p) (h_gw p)
    have h_rw : (fun i => uniformActionRank hw fc b c_step H0 delta J E zeta P0 hMJM hmoment parent_rank
        ((rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1))) i)) =
      paperPriorityRank fc.clock.m w parent_rank :=
      funext fun i => uniformActionRank_rotLeaderEquiv hw fc b c_step H0 delta J E zeta P0 hMJM hmoment parent_rank i
    rw [h_rw]
    exact h_raw
  c_low := bundle_c_low fc phaseShift
  c_high := uniform_c_high w zeta
    (uniformBiasedScoreShift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment
      (uniformActionRank hw fc b c_step H0 delta J E zeta P0 hMJM hmoment parent_rank) phaseShift)
    phaseShift
  hc_low_pos := bundle_c_low_pos fc phaseShift
  hc_high_pos := uniform_c_high_pos w zeta
    (uniformBiasedScoreShift hw fc b c_step H0 delta J E zeta P0 hMJM hmoment
      (uniformActionRank hw fc b c_step H0 delta J E zeta P0 hMJM hmoment parent_rank) phaseShift)
    phaseShift
  hgap_low := fun p => uniform_hgap_low hw fc b c_step H0 delta J E zeta P0 hMJM hmoment phaseShift hshift
    parentWord hparent_count (by omega)
    (uniformActionRank hw fc b c_step H0 delta J E zeta P0 hMJM hmoment parent_rank) h_dot_ge_low p
  hgap_high := fun p => uniform_hgap_high hw fc b c_step H0 delta J E zeta P0 hMJM hmoment phaseShift hshift
    parentWord hparent_count (by omega)
    (uniformActionRank hw fc b c_step H0 delta J E zeta P0 hMJM hmoment parent_rank) h_dot_ge_high p



/-!
## Section 32: Universal Master Moment Equation for All Algebraic Clocks

This section formalizes the universal resolution of the master moment equation
`L(E) = Dᵀ X - ℓᵀ ψ` for all algebraic clocks with `w ≥ 2`
and non-zero top-subdiagonal entry `R_{b, w-1} ≠ 0`:
1. Unconditional column-`w` vanishing of `Cᵀ G C` and `F_gw_uniform`:
   `C_transpose_G_mul_C_last_col_zero`, `C_transpose_G_mul_C_skew`,
   `C_transpose_G_mul_C_last_row_zero`, `F_gw_uniform_last_col_zero`.
2. Border-inner splitting `F_gw_uniform = F_gw_border + F_inner_uniform`:
   `F_gw_split`, `F_gw_border_supp`, `F_gw_border_anti`, `E_rank2_border_moment`.
3. Universal inner solver `E_inner_uniform_moment`:
   Vanishing on row/column `w` via `G_inner_uniform_row_w` and `G_inner_uniform_col_w`,
   and reset matrix equation `F_reset_inner_mul_one_add_N`.
4. Universal master moment equation `E_uniform_full_moment_equation`:
   Solves `L(E_total) = Dᵀ X - ℓ_totalᵀ ψ` unconditionally.
-/



-- Check that CGC last column is zero
theorem C_transpose_G_mul_C_last_col_zero {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (r : Fin w) :
    (clock.C.transpose * clock.G * clock.C) r ⟨w - 1, by omega⟩ = 0 := by
  have hGC : clock.G * clock.C = clock.R * N_mat w := clock.hclock
  rw [Matrix.mul_assoc, hGC]
  rw [Matrix.mul_apply]
  have hN_col : ∀ x : Fin clock.m, (clock.R * N_mat w) x ⟨w - 1, by omega⟩ = 0 := by
    intro x
    rw [mul_N_mat_apply]
    have hnot : ¬ ((w - 1) + 1 < w) := by omega
    simp [hnot]
  simp [hN_col]

-- CGC is skew-symmetric
theorem C_transpose_G_mul_C_skew {w : ℕ} (clock : AlgebraicClock w) :
    IsSkewSymmetric (clock.C.transpose * clock.G * clock.C) := by
  intro i j
  have h_trans : (clock.C.transpose * clock.G * clock.C).transpose = - (clock.C.transpose * clock.G * clock.C) := by
    rw [Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose]
    have hG : clock.G.transpose = - clock.G := by
      ext x y
      simp only [Matrix.transpose_apply, Matrix.neg_apply]
      exact clock.hskew y x
    rw [hG]
    simp only [Matrix.mul_neg, Matrix.neg_mul, Matrix.mul_assoc]
  have hij := congr_fun (congr_fun h_trans j) i
  exact hij

-- Therefore CGC last row is zero!
theorem C_transpose_G_mul_C_last_row_zero {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (r : Fin w) :
    (clock.C.transpose * clock.G * clock.C) ⟨w - 1, by omega⟩ r = 0 := by
  have hskew := C_transpose_G_mul_C_skew clock ⟨w - 1, by omega⟩ r
  have hcol := C_transpose_G_mul_C_last_col_zero hw clock r
  linarith

-- Column w of F_gw_uniform is unconditionally zero!
theorem F_gw_uniform_last_col_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (i : Fin (w + 1)) :
    F_gw_uniform hw clock b c_step H0 delta i ⟨w, Nat.lt_succ_self w⟩ = 0 := by
  by_cases hi : i.val = 0
  · have hi0 : i = ⟨0, Nat.succ_pos w⟩ := by ext; exact hi
    rw [hi0]
    exact F_gw_uniform_zero_last_col hw clock b c_step H0 delta
  · by_cases hiw : i.val = w
    · have hiw_eq : i = ⟨w, Nat.lt_succ_self w⟩ := by ext; exact hiw
      rw [hiw_eq]
      exact F_gw_uniform_last_row_zero hw clock b c_step H0 delta ⟨w, Nat.lt_succ_self w⟩
    · have hi_pos : 0 < i.val := by omega
      have hi_lt : i.val < w := by
        have := i.isLt
        omega
      have hw_pos : 0 < w := by omega
      rw [F_gw_uniform_pos hw clock b c_step H0 delta i ⟨w, Nat.lt_succ_self w⟩ hi_pos hi_lt hw_pos]
      have hzero := C_transpose_G_mul_C_last_row_zero (by omega) clock ⟨i.val - 1, by omega⟩
      dsimp
      rw [hzero]
      ring

-- Definition of border gateway matrix F_gw_border
def F_gw_border {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  Matrix.of fun i j => if i.val = 0 ∨ j.val = 0 then F_gw_uniform hw clock b c_step H0 delta i j else 0

-- Definition of inner gateway matrix F_inner_uniform
def F_inner_uniform {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  Matrix.of fun i j => if i.val = 0 ∨ j.val = 0 then 0 else F_gw_uniform hw clock b c_step H0 delta i j

-- Split identity F_gw_uniform = F_gw_border + F_inner_uniform
theorem F_gw_split {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) :
    F_gw_uniform hw clock b c_step H0 delta =
      F_gw_border hw clock b c_step H0 delta + F_inner_uniform hw clock b c_step H0 delta := by
  ext i j
  simp only [F_gw_border, F_inner_uniform, Matrix.add_apply, Matrix.of_apply]
  split_ifs <;> ring

-- F_gw_border satisfies hF_supp unconditionally
theorem F_gw_border_supp {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (i j : Fin (w + 1)) (hi : 0 < i.val) (hj : 0 < j.val) :
    F_gw_border hw clock b c_step H0 delta i j = 0 := by
  simp only [F_gw_border, Matrix.of_apply]
  have h_not : ¬ (i.val = 0 ∨ j.val = 0) := by omega
  rw [if_neg h_not]

-- F_gw_border satisfies hF_anti unconditionally
theorem F_gw_border_anti {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) :
    F_gw_border hw clock b c_step H0 delta ⟨0, Nat.succ_pos w⟩ ⟨w, Nat.lt_succ_self w⟩ +
      F_gw_border hw clock b c_step H0 delta ⟨w, Nat.lt_succ_self w⟩ ⟨0, Nat.succ_pos w⟩ = 0 := by
  have h1 : (⟨0, Nat.succ_pos w⟩ : Fin (w + 1)).val = 0 ∨ (⟨w, Nat.lt_succ_self w⟩ : Fin (w + 1)).val = 0 := Or.inl rfl
  have h2 : (⟨w, Nat.lt_succ_self w⟩ : Fin (w + 1)).val = 0 ∨ (⟨0, Nat.succ_pos w⟩ : Fin (w + 1)).val = 0 := Or.inr rfl
  show (if (⟨0, Nat.succ_pos w⟩ : Fin (w + 1)).val = 0 ∨ (⟨w, Nat.lt_succ_self w⟩ : Fin (w + 1)).val = 0
        then F_gw_uniform hw clock b c_step H0 delta ⟨0, Nat.succ_pos w⟩ ⟨w, Nat.lt_succ_self w⟩ else 0) +
       (if (⟨w, Nat.lt_succ_self w⟩ : Fin (w + 1)).val = 0 ∨ (⟨0, Nat.succ_pos w⟩ : Fin (w + 1)).val = 0
        then F_gw_uniform hw clock b c_step H0 delta ⟨w, Nat.lt_succ_self w⟩ ⟨0, Nat.succ_pos w⟩ else 0) = 0
  rw [if_pos h1, if_pos h2]
  exact F_gw_uniform_anti hw clock b c_step H0 delta

-- E_rank2 for F_gw_border solves moment equation unconditionally
theorem E_rank2_border_moment {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) :
    E_rank2 (F_gw_border hw clock b c_step H0 delta) -
      (E_rank2 (F_gw_border hw clock b c_step H0 delta)).transpose * B_mat (w + 1) =
      F_gw_border hw clock b c_step H0 delta :=
  E_rank2_solves_moment (by omega) (F_gw_border hw clock b c_step H0 delta)
    (F_gw_border_supp hw clock b c_step H0 delta)
    (F_gw_border_anti hw clock b c_step H0 delta)

-- F_inner_uniform vanishes on row w
theorem F_inner_uniform_last_row_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (j : Fin (w + 1)) :
    F_inner_uniform hw clock b c_step H0 delta ⟨w, Nat.lt_succ_self w⟩ j = 0 := by
  simp only [F_inner_uniform, Matrix.of_apply]
  split_ifs with h
  · rfl
  · exact F_gw_uniform_last_row_zero hw clock b c_step H0 delta j

-- F_inner_uniform vanishes on column w
theorem F_inner_uniform_last_col_zero {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (i : Fin (w + 1)) :
    F_inner_uniform hw clock b c_step H0 delta i ⟨w, Nat.lt_succ_self w⟩ = 0 := by
  simp only [F_inner_uniform, Matrix.of_apply]
  split_ifs with h
  · rfl
  · exact F_gw_uniform_last_col_zero hw clock b c_step H0 delta i

def v_seq_fun {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m) (c_step : ℚ) : ℕ → ℚ :=
  fun c => if hc : c < w + 1 then v_step (by omega) clock b c_step ⟨c, hc⟩ else 0

theorem v_seq_fun_w {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m) (c_step : ℚ) :
    v_seq_fun hw clock b c_step w = 0 := by
  dsimp [v_seq_fun]
  have hlt : w < w + 1 := by omega
  simp only [hlt, ↓reduceDIte]
  exact v_step_top (by omega) clock b c_step

theorem v_seq_fun_w_succ {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m) (c_step : ℚ) :
    v_seq_fun hw clock b c_step (w + 1) = 0 := by
  dsimp [v_seq_fun]
  have hnot : ¬ (w + 1 < w + 1) := by omega
  rw [dif_neg hnot]

theorem v_seq_fun_w_pred {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m) (c_step : ℚ)
    (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0) :
    v_seq_fun hw clock b c_step (w - 1) ≠ 0 := by
  dsimp [v_seq_fun]
  have hlt : w - 1 < w + 1 := by omega
  simp only [hlt, ↓reduceDIte]
  have hpos : 0 < (⟨w - 1, hlt⟩ : Fin (w + 1)).val := by
    dsimp
    omega
  rw [v_step_pos (by omega) clock b c_step ⟨w - 1, hlt⟩ hpos]
  have hlt_w : (⟨w - 1, hlt⟩ : Fin (w + 1)).val < w := by
    dsimp
    omega
  simp only [hlt_w, ↓reduceDIte]
  exact hR

def G_inner_uniform {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) : ℕ → ℕ → ℚ :=
  fun i j =>
    if hi : i < w + 1 then
      if hj : j < w + 1 then
        (F_inner_uniform hw clock b c_step H0 delta * (1 + N_mat (w + 1))) ⟨i, hi⟩ ⟨j, hj⟩
      else 0
    else 0

theorem G_inner_uniform_apply {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (i j : Fin (w + 1)) :
    G_inner_uniform hw clock b c_step H0 delta i.val j.val =
      (F_inner_uniform hw clock b c_step H0 delta * (1 + N_mat (w + 1))) i j := by
  dsimp [G_inner_uniform]
  have hi := i.isLt
  have hj := j.isLt
  simp [hi, hj]

theorem G_inner_uniform_row_w {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (a : ℕ) (ha : a ≤ w) :
    G_inner_uniform hw clock b c_step H0 delta w a = 0 := by
  dsimp [G_inner_uniform]
  have hw_lt : w < w + 1 := by omega
  have ha_lt : a < w + 1 := by omega
  simp only [hw_lt, ha_lt, ↓reduceDIte]
  rw [Matrix.mul_add, Matrix.mul_one, Matrix.add_apply]
  have hF_w : F_inner_uniform hw clock b c_step H0 delta ⟨w, hw_lt⟩ ⟨a, ha_lt⟩ = 0 :=
    F_inner_uniform_last_row_zero hw clock b c_step H0 delta ⟨a, ha_lt⟩
  rw [hF_w, zero_add]
  by_cases ha_w : a < w
  · rw [mul_N_mat_apply]
    have ha_succ : a + 1 < w + 1 := by omega
    simp only [ha_succ, ↓reduceDIte]
    exact F_inner_uniform_last_row_zero hw clock b c_step H0 delta ⟨a + 1, ha_succ⟩
  · have ha_eq : a = w := by omega
    have ha_fin : (⟨a, ha_lt⟩ : Fin (w + 1)) = ⟨w, hw_lt⟩ := by ext; exact ha_eq
    rw [ha_fin, mul_N_mat_last_col_zero]

theorem G_inner_uniform_col_w {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (a : ℕ) (ha : a ≤ w) :
    G_inner_uniform hw clock b c_step H0 delta a w = 0 := by
  dsimp [G_inner_uniform]
  have hw_lt : w < w + 1 := by omega
  have ha_lt : a < w + 1 := by omega
  simp only [hw_lt, ha_lt, ↓reduceDIte]
  rw [Matrix.mul_add, Matrix.mul_one, Matrix.add_apply]
  have hF_w : F_inner_uniform hw clock b c_step H0 delta ⟨a, ha_lt⟩ ⟨w, hw_lt⟩ = 0 :=
    F_inner_uniform_last_col_zero hw clock b c_step H0 delta ⟨a, ha_lt⟩
  rw [hF_w, mul_N_mat_last_col_zero, add_zero]

-- Inner reset row ell_inner_uniform
def ell_inner_uniform {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) : Fin (w + 1) → ℚ :=
  fun i => ell_seq w (G_inner_uniform hw clock b c_step H0 delta) (v_seq_fun hw clock b c_step) (w - 1) i.val

-- Total reset row
def ell_uniform_total {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta alpha : ℚ) : Fin (w + 1) → ℚ :=
  ell_uniform hw clock b c_step H0 alpha + ell_inner_uniform hw clock b c_step H0 delta

-- Reset matrix for ell_inner
def F_reset_inner {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  Matrix.of fun i j => ell_inner_uniform hw clock b c_step H0 delta i * v_step (by omega) clock b c_step j

-- Total moment matrix E_uniform_total
def E_uniform_total {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta alpha : ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  E_rank2 (F_gw_border hw clock b c_step H0 delta) +
  E_outer hw clock b c_step H0 alpha +
  E_mat_U w (G_with_ell (G_inner_uniform hw clock b c_step H0 delta)
    (v_seq_fun hw clock b c_step)
    (ell_seq w (G_inner_uniform hw clock b c_step H0 delta) (v_seq_fun hw clock b c_step) (w - 1)))

theorem F_reset_inner_mul_one_add_N (w : ℕ) (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (i j : Fin (w + 1)) :
    (F_reset_inner hw clock b c_step H0 delta * (1 + N_mat (w + 1))) i j =
      ell_inner_uniform hw clock b c_step H0 delta i *
        (v_seq_fun hw clock b c_step j.val + v_seq_fun hw clock b c_step (j.val + 1)) := by
  rw [Matrix.mul_add, Matrix.mul_one, Matrix.add_apply]
  simp only [F_reset_inner, Matrix.of_apply]
  by_cases hj : j.val < w
  · rw [mul_N_mat_apply]
    have hj_succ : j.val + 1 < w + 1 := by omega
    simp only [hj_succ, ↓reduceDIte, Matrix.of_apply]
    dsimp [v_seq_fun]
    have hj_lt : j.val < w + 1 := by omega
    rw [if_pos hj_lt, dif_pos hj_succ]
    ring
  · have hj_ge : w ≤ j.val := by omega
    have hj_lt := j.isLt
    have hj_eq : j = ⟨w, Nat.lt_succ_self w⟩ := by
      ext
      dsimp
      omega
    subst hj_eq
    rw [mul_N_mat_last_col_zero]
    dsimp [v_seq_fun]
    have hw_lt : w < w + 1 := by omega
    have hw1_not : ¬ (w + 1 < w + 1) := by omega
    rw [dif_pos hw_lt, dif_neg hw1_not]
    ring

theorem F_inner_add_reset_mul_one_add_N (w : ℕ) (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (i j : Fin (w + 1)) :
    ((F_inner_uniform hw clock b c_step H0 delta + F_reset_inner hw clock b c_step H0 delta) *
      (1 + N_mat (w + 1))) i j =
      G_with_ell (G_inner_uniform hw clock b c_step H0 delta)
        (v_seq_fun hw clock b c_step)
        (ell_seq w (G_inner_uniform hw clock b c_step H0 delta) (v_seq_fun hw clock b c_step) (w - 1))
        i.val j.val := by
  rw [Matrix.add_mul, Matrix.add_apply]
  rw [← G_inner_uniform_apply hw clock b c_step H0 delta i j]
  rw [F_reset_inner_mul_one_add_N w hw clock b c_step H0 delta i j]
  dsimp [G_with_ell, ell_inner_uniform]

theorem E_inner_uniform_moment (w : ℕ) (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0) :
    let G_base := G_inner_uniform hw clock b c_step H0 delta
    let v := v_seq_fun hw clock b c_step
    let ell := ell_seq w G_base v (w - 1)
    E_mat_U w (G_with_ell G_base v ell) - (E_mat_U w (G_with_ell G_base v ell)).transpose * B_mat (w + 1) =
      F_inner_uniform hw clock b c_step H0 delta + F_reset_inner hw clock b c_step H0 delta := by
  intro G_base v ell
  have h_row : ∀ a ≤ w, G_base w a = 0 := G_inner_uniform_row_w hw clock b c_step H0 delta
  have h_col : ∀ a ≤ w, G_base a w = 0 := G_inner_uniform_col_w hw clock b c_step H0 delta
  have hv_w : v w = 0 := v_seq_fun_w hw clock b c_step
  have hv_w1 : v (w + 1) = 0 := v_seq_fun_w_succ hw clock b c_step
  have hv_nz : v (w - 1) ≠ 0 := v_seq_fun_w_pred hw clock b c_step hR
  have hF_G : ∀ i j : Fin (w + 1),
      ((F_inner_uniform hw clock b c_step H0 delta + F_reset_inner hw clock b c_step H0 delta) *
        (1 + N_mat (w + 1))) i j =
      G_with_ell G_base v ell i.val j.val :=
    F_inner_add_reset_mul_one_add_N w hw clock b c_step H0 delta
  exact E_inner_solves_moment w hw G_base v
    (F_inner_uniform hw clock b c_step H0 delta + F_reset_inner hw clock b c_step H0 delta)
    h_row h_col hv_w hv_w1 hv_nz hF_G

/-- **Universal Master Moment Equation for All Algebraic Clocks**:
    Unconditionally solves $\mathcal{L}(E) = D^\top X - \ell^\top \psi$ for ANY algebraic clock
    with $2 \le w$ and non-zero top-subdiagonal entry $R_{b, w-1} \ne 0$. -/
theorem E_uniform_full_moment_equation {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta alpha : ℚ) (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0) :
    E_uniform_total hw clock b c_step H0 delta alpha -
      (E_uniform_total hw clock b c_step H0 delta alpha).transpose * B_mat (w + 1) =
    (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
      (Matrix.of fun (_ : Unit) c => ell_uniform_total hw clock b c_step H0 delta alpha c).transpose *
        psi_row (zeta_canonical (by omega) clock b c_step H0) (B_mat (w + 1)) := by
  have h_border := E_rank2_border_moment hw clock b c_step H0 delta
  have h_outer := E_outer_moment hw clock b c_step H0 alpha
  have h_inner := E_inner_uniform_moment w hw clock b c_step H0 delta hR
  dsimp [E_uniform_total]
  rw [matrix_moment_add, matrix_moment_add]
  rw [h_border, h_outer, h_inner]
  ext i j
  simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.of_apply]
  have h_psi := ell_psi_row_apply hw clock b c_step H0 alpha i j
  have h_psi_total : ((Matrix.of fun (_ : Unit) c => ell_uniform_total hw clock b c_step H0 delta alpha c).transpose *
      psi_row (zeta_canonical (by omega) clock b c_step H0) (B_mat (w + 1))) i j =
      - (ell_uniform_total hw clock b c_step H0 delta alpha i * v_step (by omega) clock b c_step j) := by
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Fintype.univ_punit, Finset.sum_singleton]
    rw [psi_row_zeta_canonical_eq hw clock b c_step H0]
    ring
  rw [h_psi_total]
  have h_split := congr_fun (congr_fun (F_gw_split hw clock b c_step H0 delta) i) j
  simp only [Matrix.add_apply] at h_split
  have hF_def : F_gw_uniform hw clock b c_step H0 delta i j =
      ((D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock) i j -
        v_step (by omega) clock b c_step i * x_sum_uniform clock j := rfl
  dsimp [F_reset_inner, ell_uniform_total]
  linarith



/-!
## Section 33: Concrete Grounded Stage Theorems 1–4 for Uniform Lift

This section proves the four concrete stage theorems discharging the fields
`h_early`, `h_late`, `h_bundle`, and `h_gw` of `UniformLiftSpec.ofGroundedStages`
for the uniform lift:
1. `uniform_stage1_valid`: Stage 1 early reset priority validity via `isValidPriorityWord_W_early_word_of_start`.
2. `uniform_stage2_valid`: Stage 2 late reset priority validity via `isValidPriorityWord_W_late_word_of_end_sharp`.
3. `uniform_stage3_valid`: Stage 3 parent bundle priority validity via `isValidPriorityWord_stage3_bundle_from_parent`.
4. `uniform_stage4_valid`: Stage 4 gateway dominance at Stage 3 completion via `uniform_stage4_gateway_dominance`.
-/




/-!
# Grounded Verification of Stage 1, 2, 3, 4 Conditions for Uniform Lift

This module provides the concrete Stage 1, Stage 2, Stage 3, and Stage 4 theorems
that discharge the fields `h_early`, `h_late`, `h_bundle`, and `h_gw` of
`UniformLiftSpec.ofGroundedStages`:

1. **Stage 1 (`uniform_stage1_valid`)**:
   Priority validity of early reset cascade `W_early_word` via
   `isValidPriorityWord_W_early_word_of_start`.

2. **Stage 2 (`uniform_stage2_valid`)**:
   Priority validity of late reset cascade `W_late_word` via
   `isValidPriorityWord_W_late_word_of_end_sharp`, connecting to
   `wordScore_after_reset_stages_inl` and `stage2_parent_end_sharp_canonical`.

3. **Stage 3 (`uniform_stage3_valid`)**:
   Priority validity of parent bundle `W_bundle_word` via
   `isValidPriorityWord_stage3_bundle_from_parent`, connecting to
   `stage3_subphase_priority_valid`, `wordScore_bundle_take_gateway_sub_leader`,
   `stage3_early_reset_waiting`, and `stage3_late_reset_waiting`.

4. **Stage 4 (`uniform_stage4_valid`)**:
   Strict domination of gateway action at Stage 3 completion via
   `uniform_stage4_gateway_dominance`.
-/

/-!
### 1. Stage 1: Early Reset Cascade Priority Validity
-/

/-- **Stage 1 Early Reset Priority Validity for Uniform Lift**:
    Proves priority validity of `W_early_word` on `liftedGameMat` given lower triangularity
    and subdiagonal positivity of `J`, nonpositive early coupling of `P_uniform_coupled`,
    and initial old-action waiting below the ceiling. -/
theorem uniform_stage1_valid {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (parent_rank : Fin clock.m → Fin clock.m)
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0)
    (hJ_subdiag_pos : ∀ a b : Fin ((w + 1) + (w + 1)), b.val < a.val → 0 < J a b)
    (hP_early_nonpos : ∀ (j : Fin (w + 1)) (x : Fin (clock.m + 1)),
      (P_uniform_coupled hw clock b c_step H0 delta J zeta P0 L_C) x (finSumFinEquiv (Sum.inl j)) ≤ 0)
    (q : ℕ)
    (h_old_start : ∀ x : Fin (clock.m + 1),
      let G_O := AdjoinLeaderEndpointG clock.G b clock.v
      let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
      let X := X_gateway clock
      let M := M_coupled w
      (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q) (Sum.inl x) <
        dotProduct zeta (binomBasis (w + 1) q)) :
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let P := P_uniform_coupled hw clock b c_step H0 delta J zeta P0 L_C
    let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
    let X := X_gateway clock
    let M := M_coupled w
    let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)
    IsValidPriorityWord (liftedGameMat G_O P J) s0
      (paperPriorityRank clock.m w parent_rank) (W_early_word clock.m w q) := by
  intro G_O P S X M s0
  exact isValidPriorityWord_W_early_word_of_start G_O P J S X zeta parent_rank
    hJ_lower hJ_subdiag_pos hP_early_nonpos h_old_start

/-!
### 2. Stage 2: Late Reset Cascade Priority Validity
-/

/-- **Stage 2 Late Reset Priority Validity for Uniform Lift**:
    Proves priority validity of `W_late_word` from the sharpened post-Stage-2 end condition,
    evaluated via `wordScore_after_reset_stages_inl`. -/
theorem uniform_stage2_valid {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (parent_rank : Fin clock.m → Fin clock.m)
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0)
    (hJ_subdiag_pos : ∀ a b : Fin ((w + 1) + (w + 1)), b.val < a.val → 0 < J a b)
    (hP_late_nonneg : ∀ (j : Fin (w + 1)) (x : Fin (clock.m + 1)),
      0 ≤ (P_uniform_coupled hw clock b c_step H0 delta J zeta P0 L_C) x (finSumFinEquiv (Sum.inr j)))
    (q : ℕ)
    (h_end_sharp : ∀ x : Fin (clock.m + 1),
      let P := P_uniform_coupled hw clock b c_step H0 delta J zeta P0 L_C
      let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
      S.mulVec (binomBasis (w + 1) (q + 1)) x -
        P x (finSumFinEquiv (Sum.inr ⟨w, Nat.lt_succ_self w⟩)) <
        dotProduct zeta (binomBasis (w + 1) q)) :
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let P := P_uniform_coupled hw clock b c_step H0 delta J zeta P0 L_C
    let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
    let X := X_gateway clock
    let M := M_coupled w
    let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)
    IsValidPriorityWord (liftedGameMat G_O P J)
      (wordScore (liftedGameMat G_O P J) s0 (W_early_word clock.m w q))
      (paperPriorityRank clock.m w parent_rank) (W_late_word clock.m w q) := by
  intro G_O P S X M s0
  apply isValidPriorityWord_W_late_word_of_end_sharp
  · exact hJ_lower
  · exact hJ_subdiag_pos
  · exact hP_late_nonneg
  · intro x
    have hPM : P * M = S * N_mat (w + 1) - G_O * X := by
      dsimp only [P, S, X, M, G_O]
      have hP_mul := P_uniform_coupled_mul_M hw clock b c_step H0 delta J E zeta P0 L_C hMJM hmoment
      rw [hP_mul]
      rfl
    have h_after := wordScore_after_reset_stages_inl clock G_O P J S zeta hPM q x
    rw [h_after]
    exact h_end_sharp x

/-!
### 3. Stage 3: Parent Bundle Priority Validity
-/

/-- **Stage 3 Parent Bundle Priority Validity for Uniform Lift**:
    Proves priority validity of `(W_bundle_word parentWord (q + 1)).map bundleToLiftedAct`
    on `liftedGameMat` from per-phase parent priority validity, gateway waiting, and reset waiting. -/
theorem uniform_stage3_valid {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hMJM : (M_coupled w).transpose * J * M_coupled w = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row (M_coupled w)).transpose * psi_row zeta (B_mat (w + 1)))
    (parentWord : ℕ → List (Fin clock.m))
    (parent_rank : Fin clock.m → Fin clock.m)
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (hparent_valid : ∀ σ : ℕ,
      IsValidPriorityWord clock.G (clock.R.mulVec (binomBasis w σ)) parent_rank (parentWord σ))
    (q : ℕ)
    (h_gw_waits : ∀ (k : ℕ) (hk : k < (W_bundle_word parentWord (q + 1)).length),
      let G_O := AdjoinLeaderEndpointG clock.G b clock.v
      let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
      let X := X_gateway clock
      let M := M_coupled w
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)
      let s_mid := wordScore (liftedGameMat G_O (P_uniform_coupled hw clock b c_step H0 delta J zeta P0 L_C) J) s0
        (W_early_word clock.m w q ++ W_late_word clock.m w q)
      wordScore G_O (fun u => s_mid (Sum.inl u))
        (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).take k)
        (gatewayOldAct clock.m) <
      wordScore G_O (fun u => s_mid (Sum.inl u))
        (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).take k)
        (parentToOldAct clock.m ((W_bundle_word parentWord (q + 1))[k]'hk)))
    (h_reset_waits : ∀ (k : ℕ)
      (hk : k < ((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).length)
      (j : Fin ((w + 1) + (w + 1))),
      let G_O := AdjoinLeaderEndpointG clock.G b clock.v
      let P := P_uniform_coupled hw clock b c_step H0 delta J zeta P0 L_C
      let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
      let X := X_gateway clock
      let M := M_coupled w
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)
      let s_mid := wordScore (liftedGameMat G_O P J) s0 (W_early_word clock.m w q ++ W_late_word clock.m w q)
      s_mid (Sum.inr j) -
        ∑ u, P u j * wordCountVec (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).take k) u <
        wordScore G_O (fun u => s_mid (Sum.inl u))
          (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).take k)
          (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m))[k])) :
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let P := P_uniform_coupled hw clock b c_step H0 delta J zeta P0 L_C
    let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
    let X := X_gateway clock
    let M := M_coupled w
    let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)
    IsValidPriorityWord (liftedGameMat G_O P J)
      (wordScore (liftedGameMat G_O P J) s0 (W_early_word clock.m w q ++ W_late_word clock.m w q))
      (paperPriorityRank clock.m w parent_rank)
      ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)) := by
  intro G_O P S X M s0
  let s_mid := wordScore (liftedGameMat G_O P J) s0 (W_early_word clock.m w q ++ W_late_word clock.m w q)
  have hPM : P * M = S * N_mat (w + 1) - G_O * X := by
    dsimp only [P, S, X, M, G_O]
    have hP_mul := P_uniform_coupled_mul_M hw clock b c_step H0 delta J E zeta P0 L_C hMJM hmoment
    rw [hP_mul]
    rfl
  have hs_after : ∀ u : Fin (clock.m + 1), s_mid (Sum.inl u) = S.mulVec (binomBasis (w + 1) (q + 1)) u := by
    intro u
    dsimp only [s_mid, s0]
    exact wordScore_after_reset_stages_inl clock G_O P J S zeta hPM q u
  let c_shift := dotProduct (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) (binomBasis (w + 1) (q + 1))
  have hs_agree : ∀ i : Fin clock.m, s_mid (Sum.inl (parentToOldAct clock.m i)) =
      clock.R.mulVec (binomBasis w 0) i + c_shift := by
    intro i
    rw [hs_after]
    have hp : parentToOldAct clock.m i = finSumFinEquiv (Sum.inl i) := rfl
    rw [hp]
    dsimp only [S]
    rw [S_uniform_parent_eval (by omega) clock b _ delta i q]
    have hR0 : clock.R.mulVec (binomBasis w 0) i = clock.R i ⟨0, by omega⟩ := by
      simp only [Matrix.mulVec, dotProduct, binomBasis]
      rw [Finset.sum_eq_single ⟨0, by omega⟩]
      · simp
      · intro j _ hj
        have : j.val ≠ 0 := by intro h; apply hj; ext; exact h
        have : Nat.choose 0 j.val = 0 := Nat.choose_eq_zero_of_lt (by omega)
        simp [this]
      · intro h; exact False.elim (h (Finset.mem_univ _))
    rw [hR0]
  have hG_agree : ∀ i j : Fin clock.m,
      G_O (parentToOldAct clock.m i) (parentToOldAct clock.m j) = clock.G i j := by
    intro i j
    dsimp only [G_O]
    exact AdjoinLeaderEndpointG_parent_parent clock.G b clock.v i j
  exact isValidPriorityWord_stage3_bundle_from_parent clock parentWord parent_rank
    hparent_count hparent_valid q c_shift G_O P J s_mid
    hG_agree hs_agree h_gw_waits h_reset_waits

/-!
### 4. Stage 4: Gateway Dominance at Stage 3 Completion
-/

/-- **Stage 4 Gateway Dominance for Uniform Lift**:
    Proves that the gateway action strictly beats every other action at the completion
    of Stage 3, discharging the `h_gw` condition. -/
theorem uniform_stage4_valid {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step delta : ℚ) (hdelta : 0 < delta)
    (zeta : Fin (w + 1) → ℚ) (q : ℕ)
    (s_end : Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)) → ℚ)
    (h_parent : ∀ i : Fin fc.clock.m,
      s_end (Sum.inl (finSumFinEquiv (Sum.inl i))) =
        fc.clock.R.mulVec (binomBasis w (q + 1)) i +
          dotProduct (h_uniform fc.clock b zeta c_step) (binomBasis (w + 1) (q + 1)))
    (h_leader : ∀ i : Fin fc.clock.m,
      fc.clock.R.mulVec (binomBasis w (q + 1)) i ≤ fc.clock.R.mulVec (binomBasis w (q + 1)) b)
    (h_gw : s_end (gatewayToLiftedAct fc.clock.m w) =
      fc.clock.R.mulVec (binomBasis w (q + 1)) b +
        dotProduct (h_uniform fc.clock b zeta c_step) (binomBasis (w + 1) (q + 1)) + delta)
    (h_reset : ∀ r : Fin ((w + 1) + (w + 1)),
      s_end (Sum.inr r) < dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + delta) :
    ∀ y : Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
      y ≠ gatewayToLiftedAct fc.clock.m w →
      s_end y < s_end (gatewayToLiftedAct fc.clock.m w) := by
  intro y hy
  exact uniform_stage4_gateway_dominance hw fc b c_step delta hdelta zeta q s_end
    h_parent h_leader h_gw h_reset y hy



/-!
## Section 34: Column-Calibrated Reset Matrix M_row0 and Interaction Matrix J_row0

This section formalizes the column-calibrated reset count matrix $M_{\mathrm{row0}}$
and interaction matrix $J_{\mathrm{row0}}$ pairing with $\vec{\ell}_{\mathrm{uniform\_total}}$:
1. `W_row0`, `W_row0_inv`: row-0 calibration matrix and inverse.
2. `M_row0`, `R_M_row0`: stacked reset matrix and left inverse.
3. `J_row0`: strictly lower-triangular interaction matrix realizing target moment matrix $E$.
4. Matrix properties: `ell_row_M_row0`, `R_M_row0_mul_M_row0`, `J_row0_lower`, `M_row0_transpose_mul_J_row0_mul_M_row0`.
5. Exact Moment Compatibility: `uniform_total_moment_compat`.
6. Coupling matrix and full-rank lift: `P_uniform_total`, `P_uniform_total_transpose_mul_X`, `P_uniform_total_mul_M`, `uniformTotalFullRankLift`.
-/

/-- Column-calibrated matrix `W_row0` where row 0 carries the deficit and rows 1..w are the identity. -/
def W_row0 (w : ℕ) (u : Fin (w + 1) → ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  Matrix.of fun i c =>
    if i.val = 0 then (if c.val = 0 then u c else u c - 1)
    else (if i = c then 1 else 0)

/-- Inverse matrix `W_row0_inv`. -/
def W_row0_inv (w : ℕ) (u : Fin (w + 1) → ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  Matrix.of fun i c =>
    if i.val = 0 then
      (if c.val = 0 then (u 0)⁻¹ else -(u 0)⁻¹ * (u c - 1))
    else (if i = c then 1 else 0)

theorem W_row0_apply_zero_zero (w : ℕ) (u : Fin (w + 1) → ℚ) :
    W_row0 w u 0 0 = u 0 := rfl

theorem W_row0_apply_zero_succ (w : ℕ) (u : Fin (w + 1) → ℚ) (c : Fin w) :
    W_row0 w u 0 c.succ = u c.succ - 1 := rfl

theorem W_row0_apply_succ_zero (w : ℕ) (u : Fin (w + 1) → ℚ) (i : Fin w) :
    W_row0 w u i.succ 0 = 0 := rfl

theorem W_row0_apply_succ_succ (w : ℕ) (u : Fin (w + 1) → ℚ) (i c : Fin w) :
    W_row0 w u i.succ c.succ = if i = c then 1 else 0 := by
  dsimp [W_row0]
  simp [Fin.succ_inj]

theorem W_row0_inv_apply_zero_zero (w : ℕ) (u : Fin (w + 1) → ℚ) :
    W_row0_inv w u 0 0 = (u 0)⁻¹ := rfl

theorem W_row0_inv_apply_zero_succ (w : ℕ) (u : Fin (w + 1) → ℚ) (c : Fin w) :
    W_row0_inv w u 0 c.succ = - (u 0)⁻¹ * (u c.succ - 1) := rfl

theorem W_row0_inv_apply_succ_zero (w : ℕ) (u : Fin (w + 1) → ℚ) (i : Fin w) :
    W_row0_inv w u i.succ 0 = 0 := rfl

theorem W_row0_inv_apply_succ_succ (w : ℕ) (u : Fin (w + 1) → ℚ) (i c : Fin w) :
    W_row0_inv w u i.succ c.succ = if i = c then 1 else 0 := by
  dsimp [W_row0_inv]
  simp [Fin.succ_inj]

theorem W_row0_inv_mul_W_row0 {w : ℕ} (u : Fin (w + 1) → ℚ)
    (hu : u 0 ≠ 0) :
    W_row0_inv w u * W_row0 w u = 1 := by
  ext i k
  rw [Matrix.mul_apply, Fin.sum_univ_succ]
  refine Fin.cases ?_ ?_ i
  · refine Fin.cases ?_ ?_ k
    · rw [W_row0_inv_apply_zero_zero, W_row0_apply_zero_zero]
      have hrest : (∑ j : Fin w, W_row0_inv w u 0 j.succ * W_row0 w u j.succ 0) = 0 := by
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [W_row0_apply_succ_zero, mul_zero]
      rw [hrest, add_zero, Matrix.one_apply_eq]
      exact inv_mul_cancel₀ hu
    · intro jk
      rw [W_row0_inv_apply_zero_zero, W_row0_apply_zero_succ]
      have hrest : (∑ j : Fin w, W_row0_inv w u 0 j.succ * W_row0 w u j.succ jk.succ) =
          - (u 0)⁻¹ * (u jk.succ - 1) := by
        simp_rw [W_row0_inv_apply_zero_succ, W_row0_apply_succ_succ]
        rw [Finset.sum_eq_single jk]
        · simp
        · intro x _ hx; simp [hx]
        · intro hx; exfalso; exact hx (Finset.mem_univ _)
      rw [hrest]
      have h1 : (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) 0 jk.succ = 0 := by
        rw [Matrix.one_apply_ne (Fin.succ_ne_zero jk).symm]
      rw [h1]
      ring
  · intro ji
    refine Fin.cases ?_ ?_ k
    · rw [W_row0_inv_apply_succ_zero, zero_mul, zero_add]
      have hrest : (∑ j : Fin w, W_row0_inv w u ji.succ j.succ * W_row0 w u j.succ 0) = 0 := by
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [W_row0_apply_succ_zero, mul_zero]
      rw [hrest]
      rw [Matrix.one_apply_ne (Fin.succ_ne_zero ji)]
    · intro jk
      rw [W_row0_inv_apply_succ_zero, zero_mul, zero_add]
      simp_rw [W_row0_inv_apply_succ_succ, W_row0_apply_succ_succ]
      have hrest : (∑ j : Fin w, (if ji = j then (1 : ℚ) else 0) * if j = jk then 1 else 0) =
          if ji = jk then 1 else 0 := by
        rw [Finset.sum_eq_single jk]
        · simp
        · intro x _ hx; simp [hx]
        · intro hx; exfalso; exact hx (Finset.mem_univ _)
      rw [hrest]
      by_cases h : ji = jk
      · subst h
        rw [if_pos rfl, Matrix.one_apply_eq]
      · rw [if_neg h, Matrix.one_apply_ne (by simpa [Fin.succ_inj])]

theorem W_row0_mul_W_row0_inv {w : ℕ} (u : Fin (w + 1) → ℚ)
    (hu : u 0 ≠ 0) :
    W_row0 w u * W_row0_inv w u = 1 := by
  ext i k
  rw [Matrix.mul_apply, Fin.sum_univ_succ]
  refine Fin.cases ?_ ?_ i
  · refine Fin.cases ?_ ?_ k
    · rw [W_row0_apply_zero_zero, W_row0_inv_apply_zero_zero]
      have hrest : (∑ j : Fin w, W_row0 w u 0 j.succ * W_row0_inv w u j.succ 0) = 0 := by
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [W_row0_inv_apply_succ_zero, mul_zero]
      rw [hrest, add_zero, Matrix.one_apply_eq]
      exact mul_inv_cancel₀ hu
    · intro jk
      rw [W_row0_apply_zero_zero, W_row0_inv_apply_zero_succ]
      have hrest : (∑ j : Fin w, W_row0 w u 0 j.succ * W_row0_inv w u j.succ jk.succ) =
          u jk.succ - 1 := by
        simp_rw [W_row0_apply_zero_succ, W_row0_inv_apply_succ_succ]
        rw [Finset.sum_eq_single jk]
        · simp
        · intro x _ hx; simp [hx]
        · intro hx; exfalso; exact hx (Finset.mem_univ _)
      rw [hrest]
      have h1 : (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) 0 jk.succ = 0 := by
        rw [Matrix.one_apply_ne (Fin.succ_ne_zero jk).symm]
      rw [h1]
      have hmul : u 0 * (- (u 0)⁻¹ * (u jk.succ - 1)) = - (u jk.succ - 1) := by
        calc u 0 * (- (u 0)⁻¹ * (u jk.succ - 1))
          _ = - (u 0 * (u 0)⁻¹) * (u jk.succ - 1) := by ring
          _ = - 1 * (u jk.succ - 1) := by rw [mul_inv_cancel₀ hu]
          _ = - (u jk.succ - 1) := by ring
      rw [hmul]
      ring
  · intro ji
    refine Fin.cases ?_ ?_ k
    · rw [W_row0_apply_succ_zero, zero_mul, zero_add]
      have hrest : (∑ j : Fin w, W_row0 w u ji.succ j.succ * W_row0_inv w u j.succ 0) = 0 := by
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [W_row0_inv_apply_succ_zero, mul_zero]
      rw [hrest]
      rw [Matrix.one_apply_ne (Fin.succ_ne_zero ji)]
    · intro jk
      rw [W_row0_apply_succ_zero, zero_mul, zero_add]
      simp_rw [W_row0_apply_succ_succ, W_row0_inv_apply_succ_succ]
      have hrest : (∑ j : Fin w, (if ji = j then (1 : ℚ) else 0) * if j = jk then 1 else 0) =
          if ji = jk then 1 else 0 := by
        rw [Finset.sum_eq_single jk]
        · simp
        · intro x _ hx; simp [hx]
        · intro hx; exfalso; exact hx (Finset.mem_univ _)
      rw [hrest]
      by_cases h : ji = jk
      · subst h
        rw [if_pos rfl, Matrix.one_apply_eq]
      · rw [if_neg h, Matrix.one_apply_ne (by simpa [Fin.succ_inj])]

theorem vecMul_one_W_row0 (w : ℕ) (u : Fin (w + 1) → ℚ) :
    Matrix.vecMul (fun _ => 1) (W_row0 w u) = u := by
  ext c
  dsimp [Matrix.vecMul, dotProduct]
  rw [Fin.sum_univ_succ]
  refine Fin.cases ?_ ?_ c
  · rw [W_row0_apply_zero_zero]
    have hrest : (∑ j : Fin w, (1 : ℚ) * W_row0 w u j.succ 0) = 0 := by
      refine Finset.sum_eq_zero fun j _ => ?_
      rw [W_row0_apply_succ_zero, mul_zero]
    rw [hrest, add_zero, one_mul]
  · intro jc
    rw [W_row0_apply_zero_succ]
    have hrest : (∑ j : Fin w, (1 : ℚ) * W_row0 w u j.succ jc.succ) = 1 := by
      simp_rw [W_row0_apply_succ_succ]
      rw [Finset.sum_eq_single jc]
      · simp
      · intro x _ hx; simp [hx]
      · intro hx; exfalso; exact hx (Finset.mem_univ _)
    rw [hrest, one_mul]
    ring

/-- Abbreviation for `W_row0` instantiated with `ell / 2`. -/
def W_row0_u (w : ℕ) (ell : Fin (w + 1) → ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  W_row0 w (fun j => ell j / 2)

/-- Abbreviation for `W_row0_inv` instantiated with `ell / 2`. -/
def W_row0_inv_u (w : ℕ) (ell : Fin (w + 1) → ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  W_row0_inv w (fun j => ell j / 2)

/-- Reset count matrix `M_row0` constructed by stacking two copies of `W_row0_u w ell`. -/
def M_row0 (w : ℕ) (ell : Fin (w + 1) → ℚ) : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ :=
  Matrix.of fun r c =>
    match finSumFinEquiv.symm r with
    | Sum.inl i => W_row0_u w ell i c
    | Sum.inr i => W_row0_u w ell i c

/-- Left inverse `R_M_row0` for `M_row0`. -/
def R_M_row0 (w : ℕ) (ell : Fin (w + 1) → ℚ) : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  Matrix.of fun c r =>
    match finSumFinEquiv.symm r with
    | Sum.inl i => W_row0_inv_u w ell c i
    | Sum.inr _ => 0

/-- Interaction matrix `J_row0` realizing target moment matrix `E`. -/
def J_row0 (w : ℕ) (ell : Fin (w + 1) → ℚ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) :
    Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ :=
  let X_mid := (W_row0_inv_u w ell).transpose * E * W_row0_inv_u w ell
  Matrix.of fun a b =>
    match finSumFinEquiv.symm a, finSumFinEquiv.symm b with
    | Sum.inl _, _ => 0
    | Sum.inr _, Sum.inr _ => 0
    | Sum.inr i, Sum.inl j => X_mid i j

theorem ell_row_M_row0 (w : ℕ) (ell : Fin (w + 1) → ℚ) :
    ell_row (M_row0 w ell) = Matrix.of fun (_ : Unit) c => ell c := by
  ext _ c
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      (1 : ℚ) * M_row0 w ell r c).symm
  simp only [ell_row, one_row, Matrix.mul_apply, Matrix.of_apply]
  rw [hcomp, Fintype.sum_sum_type]
  simp only [M_row0, Matrix.of_apply, Equiv.symm_apply_apply, one_mul]
  have hvec : (∑ i : Fin (w + 1), W_row0_u w ell i c) = ell c / 2 := by
    have h := congr_fun (vecMul_one_W_row0 w (fun j => ell j / 2)) c
    dsimp [Matrix.vecMul, dotProduct, W_row0_u] at h ⊢
    rw [← h]
    simp only [one_mul]
  rw [hvec]
  ring

theorem R_M_row0_mul_M_row0 (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (hell0 : ell 0 ≠ 0) :
    R_M_row0 w ell * M_row0 w ell = 1 := by
  ext c1 c2
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      R_M_row0 w ell c1 r * M_row0 w ell r c2).symm
  rw [Matrix.mul_apply, hcomp, Fintype.sum_sum_type]
  simp only [R_M_row0, M_row0, Matrix.of_apply, Equiv.symm_apply_apply,
    zero_mul, Finset.sum_const_zero, add_zero]
  have hu0 : (fun j => ell j / 2) 0 ≠ 0 := by
    dsimp
    intro h
    have : ell 0 = 0 := by linarith [h]
    exact hell0 this
  have hW := congr_fun (congr_fun (W_row0_inv_mul_W_row0 (fun j => ell j / 2) hu0) c1) c2
  simpa [Matrix.mul_apply, W_row0_inv_u, W_row0_u] using hW

theorem J_row0_lower (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (a b : Fin ((w + 1) + (w + 1))) (hab : a.val ≤ b.val) :
    J_row0 w ell E a b = 0 := by
  obtain ⟨sa, rfl⟩ := finSumFinEquiv.surjective a
  obtain ⟨sb, rfl⟩ := finSumFinEquiv.surjective b
  simp only [J_row0, Matrix.of_apply, Equiv.symm_apply_apply]
  rcases sa with i | i <;> rcases sb with j | j
  · rfl
  · rfl
  · simp only [finSumFinEquiv_apply_left, finSumFinEquiv_apply_right,
      Fin.val_castAdd, Fin.val_natAdd] at hab
    have hj : j.val < w + 1 := j.isLt
    omega
  · rfl

theorem M_row0_transpose_mul_J_row0_mul_M_row0 (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hell0 : ell 0 ≠ 0) :
    (M_row0 w ell).transpose * J_row0 w ell E * M_row0 w ell = E := by
  have hu0 : (fun j => ell j / 2) 0 ≠ 0 := by
    dsimp
    intro h
    have : ell 0 = 0 := by linarith [h]
    exact hell0 this
  let X_mid := (W_row0_inv_u w ell).transpose * E * W_row0_inv_u w ell
  have h_eq :
      (M_row0 w ell).transpose * J_row0 w ell E * M_row0 w ell =
        (W_row0_u w ell).transpose * X_mid * W_row0_u w ell := by
    ext c1 c2
    simp only [Matrix.mul_apply, Matrix.transpose_apply]
    have hcomp1 :
        ∀ b : Fin ((w + 1) + (w + 1)),
          (∑ a : Fin ((w + 1) + (w + 1)), M_row0 w ell a c1 * J_row0 w ell E a b) =
            (∑ i : Fin (w + 1), W_row0_u w ell i c1 * J_row0 w ell E (finSumFinEquiv (Sum.inl i)) b) +
            (∑ i : Fin (w + 1), W_row0_u w ell i c1 * J_row0 w ell E (finSumFinEquiv (Sum.inr i)) b) := by
      intro b
      have hc := (Equiv.sum_comp finSumFinEquiv fun a => M_row0 w ell a c1 * J_row0 w ell E a b).symm
      rw [hc, Fintype.sum_sum_type]
      simp only [M_row0, Matrix.of_apply, Equiv.symm_apply_apply]
    simp_rw [hcomp1]
    have hcomp2 :=
      (Equiv.sum_comp finSumFinEquiv fun b : Fin ((w + 1) + (w + 1)) =>
        ((∑ i : Fin (w + 1), W_row0_u w ell i c1 * J_row0 w ell E (finSumFinEquiv (Sum.inl i)) b) +
         (∑ i : Fin (w + 1), W_row0_u w ell i c1 * J_row0 w ell E (finSumFinEquiv (Sum.inr i)) b)) *
        M_row0 w ell b c2).symm
    rw [hcomp2, Fintype.sum_sum_type]
    simp only [M_row0, J_row0, Matrix.of_apply, Equiv.symm_apply_apply,
      mul_zero, Finset.sum_const_zero, zero_add, add_zero, zero_mul, X_mid]
  rw [h_eq]
  have hinv : W_row0_inv_u w ell * W_row0_u w ell = 1 :=
    W_row0_inv_mul_W_row0 (fun j => ell j / 2) hu0
  have h1 : (W_row0_u w ell).transpose * (W_row0_inv_u w ell).transpose = (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) := by
    rw [← Matrix.transpose_mul, hinv, Matrix.transpose_one]
  have h2 : (W_row0_inv_u w ell) * (W_row0_u w ell) = (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) :=
    hinv
  calc
    (W_row0_u w ell).transpose * X_mid * W_row0_u w ell
      = ((W_row0_u w ell).transpose * (W_row0_inv_u w ell).transpose) * E * (W_row0_inv_u w ell * W_row0_u w ell) := by
        dsimp only [X_mid]
        simp only [Matrix.mul_assoc]
    _ = 1 * E * 1 := by rw [h1, h2]
    _ = E := by
      have he1 : (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) * E = E := Matrix.one_mul E
      have he2 : E * (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) = E := Matrix.mul_one E
      rw [he1, he2]

/-- Moment compatibility for the total uniform clock lift. -/
theorem uniform_total_moment_compat {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0)
    (hell0 : ell_uniform_total hw clock b c_step H0 delta alpha 0 ≠ 0) :
    (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock =
      (M_row0 w (ell_uniform_total hw clock b c_step H0 delta alpha)).transpose *
        Q_reset (J_row0 w (ell_uniform_total hw clock b c_step H0 delta alpha) (E_uniform_total hw clock b c_step H0 delta alpha))
          (M_row0 w (ell_uniform_total hw clock b c_step H0 delta alpha))
          (B_mat (w + 1)) (zeta_canonical (by omega) clock b c_step H0) := by
  let ell := ell_uniform_total hw clock b c_step H0 delta alpha
  let M := M_row0 w ell
  let J := J_row0 w ell (E_uniform_total hw clock b c_step H0 delta alpha)
  let E := E_uniform_total hw clock b c_step H0 delta alpha
  let zeta := zeta_canonical (by omega) clock b c_step H0
  have hMJM : M.transpose * J * M = E :=
    M_row0_transpose_mul_J_row0_mul_M_row0 w ell E hell0
  have hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row M).transpose * psi_row zeta (B_mat (w + 1)) := by
    have hfull := E_uniform_full_moment_equation hw clock b c_step H0 delta alpha hR
    rw [ell_row_M_row0 w ell]
    exact hfull
  exact uniform_moment_compat hw clock b c_step H0 delta M J E zeta hMJM hmoment

/-- Column-calibrated uniform coupling matrix `P_uniform_total`. -/
def P_uniform_total {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  let ell := ell_uniform_total hw clock b c_step H0 delta alpha
  let M := M_row0 w ell
  let R_M := R_M_row0 w ell
  let J := J_row0 w ell (E_uniform_total hw clock b c_step H0 delta alpha)
  let zeta := zeta_canonical (by omega) clock b c_step H0
  P_uniform_interp hw clock b c_step H0 delta M R_M J zeta P0 L_C

/-- `P_uniform_total` satisfies `Pᵀ * X = Q`. -/
theorem P_uniform_total_transpose_mul_X {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) :
    let ell := ell_uniform_total hw clock b c_step H0 delta alpha
    let M := M_row0 w ell
    let J := J_row0 w ell (E_uniform_total hw clock b c_step H0 delta alpha)
    let zeta := zeta_canonical (by omega) clock b c_step H0
    (P_uniform_total hw clock b c_step H0 delta alpha P0 L_C).transpose * X_gateway clock =
      Q_reset J M (B_mat (w + 1)) zeta := by
  intro ell M J zeta
  exact P_uniform_interp_transpose_mul_X hw clock b c_step H0 delta M (R_M_row0 w ell) J zeta P0 L_C hLC

/-- `P_uniform_total` satisfies `P * M = D`. -/
theorem P_uniform_total_mul_M {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0)
    (hell0 : ell_uniform_total hw clock b c_step H0 delta alpha 0 ≠ 0) :
    let ell := ell_uniform_total hw clock b c_step H0 delta alpha
    let M := M_row0 w ell
    P_uniform_total hw clock b c_step H0 delta alpha P0 L_C * M =
      D_uniform hw clock b c_step H0 delta := by
  intro ell M
  let R_M := R_M_row0 w ell
  let J := J_row0 w ell (E_uniform_total hw clock b c_step H0 delta alpha)
  let E := E_uniform_total hw clock b c_step H0 delta alpha
  let zeta := zeta_canonical (by omega) clock b c_step H0
  have hRM : R_M * M = 1 := R_M_row0_mul_M_row0 w ell hell0
  have hMJM : M.transpose * J * M = E := M_row0_transpose_mul_J_row0_mul_M_row0 w ell E hell0
  have hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row M).transpose * psi_row zeta (B_mat (w + 1)) := by
    have hfull := E_uniform_full_moment_equation hw clock b c_step H0 delta alpha hR
    rw [ell_row_M_row0 w ell]
    exact hfull
  exact P_uniform_interp_mul_M hw clock b c_step H0 delta M R_M J E zeta P0 L_C hRM hMJM hmoment

/-- Weight calibration for row-0 reset matrix `M_row0`. -/
theorem row0_weight_calibration {w : ℕ} (clock : AlgebraicClock w)
    (ell : Fin (w + 1) → ℚ) :
    Matrix.vecMul (v_old_coupled clock.m)
      (X_coupled clock * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) +
      Matrix.vecMul (0 : Fin ((w + 1) + (w + 1)) → ℚ) (M_row0 w ell) =
    e0_row (w + 1) := by
  have h0 : Matrix.vecMul (0 : Fin ((w + 1) + (w + 1)) → ℚ) (M_row0 w ell) = 0 := by
    ext c; simp [Matrix.vecMul, dotProduct]
  have h0_coupled : Matrix.vecMul (0 : Fin ((w + 1) + (w + 1)) → ℚ) (M_coupled w) = 0 := by
    ext c; simp [Matrix.vecMul, dotProduct]
  have hcal := coupled_weight_calibration clock
  rw [h0_coupled, add_zero] at hcal
  rw [h0, add_zero, hcal]

/-- Inductive algebraic clock lift of order `w + 1` from the total uniform score table architecture. -/
@[reducible] def uniformTotalLiftClock {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0)
    (hell0 : ell_uniform_total hw clock b c_step H0 delta alpha 0 ≠ 0) :
    AlgebraicClock (w + 1) :=
  let ell := ell_uniform_total hw clock b c_step H0 delta alpha
  let M := M_row0 w ell
  let J := J_row0 w ell (E_uniform_total hw clock b c_step H0 delta alpha)
  let zeta := zeta_canonical (by omega) clock b c_step H0
  let P := P_uniform_total hw clock b c_step H0 delta alpha P0 L_C
  let G_O := AdjoinLeaderEndpointG clock.G b clock.v
  let h_row := h_uniform clock b zeta c_step
  let S := S_uniform (by omega) clock b h_row delta
  let X := X_gateway clock
  let B := B_mat (w + 1)
  let v_old := v_old_coupled clock.m
  let v_reset : Fin ((w + 1) + (w + 1)) → ℚ := 0
  let aP_old : Fin (clock.m + 1) → ℚ := fun _ => 1
  let aP_reset : Fin ((w + 1) + (w + 1)) → ℚ := fun _ => 1
  AlgebraicClock.ofEquiv (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)))
    (liftedGameMat G_O P J)
    (liftedScoreMat G_O J S X M zeta)
    (liftedCountMat X M (N_mat (w + 1)))
    (liftedWeightVec v_old v_reset)
    (liftedWeightVec aP_old aP_reset)
    (liftedGameMat_skew G_O P J (AdjoinLeaderEndpointG_skew clock.G b clock.v clock.hskew))
    (liftedGameMat_mul_liftedCountMat G_O P J S X M B (N_mat (w + 1)) zeta
      (B_mat_mul_one_add_N (w + 1))
      (P_uniform_total_transpose_mul_X hw clock b c_step H0 delta alpha P0 L_C hLC)
      (P_uniform_total_mul_M hw clock b c_step H0 delta alpha P0 L_C hR hell0))
    (by
      have hcal := row0_weight_calibration clock ell
      exact liftedWeightVec_mul_liftedCountMat X M v_old v_reset hcal)
    (fun s => by
      cases s with
      | inl _ => exact zero_lt_one
      | inr _ => exact zero_lt_one)

/-- Universal left inverse $L_C$ for `uniformTotalLiftClock`. -/
def L_C_uniform_total_next {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0)
    (hell0 : ell_uniform_total hw clock b c_step H0 delta alpha 0 ≠ 0) :
    Matrix (Fin (uniformTotalLiftClock hw clock b c_step H0 delta alpha P0 L_C hLC hR hell0).m) (Fin (w + 1)) ℚ :=
  let ell := ell_uniform_total hw clock b c_step H0 delta alpha
  Matrix.of fun x c =>
    match (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))).symm x with
    | Sum.inl _ => 0
    | Sum.inr r => R_M_row0 w ell c r

/-- Full column rank preservation for `uniformTotalLiftClock`. -/
theorem uniform_total_C_transpose_mul_L_C {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0)
    (hell0 : ell_uniform_total hw clock b c_step H0 delta alpha 0 ≠ 0) :
    (uniformTotalLiftClock hw clock b c_step H0 delta alpha P0 L_C hLC hR hell0).C.transpose *
      L_C_uniform_total_next hw clock b c_step H0 delta alpha P0 L_C hLC hR hell0 = 1 := by
  let ell := ell_uniform_total hw clock b c_step H0 delta alpha
  ext c1 c2
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  change ∑ x : Fin ((clock.m + 1) + ((w + 1) + (w + 1))),
    (uniformTotalLiftClock hw clock b c_step H0 delta alpha P0 L_C hLC hR hell0).C x c1 *
      L_C_uniform_total_next hw clock b c_step H0 delta alpha P0 L_C hLC hR hell0 x c2 =
    (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) c1 c2
  rw [(Equiv.sum_comp (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))) fun y =>
    (uniformTotalLiftClock hw clock b c_step H0 delta alpha P0 L_C hLC hR hell0).C y c1 *
      L_C_uniform_total_next hw clock b c_step H0 delta alpha P0 L_C hLC hR hell0 y c2).symm]
  rw [Fintype.sum_sum_type]
  simp only [uniformTotalLiftClock, AlgebraicClock.ofEquiv, liftedCountMat,
    L_C_uniform_total_next, Matrix.of_apply, Equiv.symm_apply_apply,
    mul_zero, Finset.sum_const_zero, zero_add]
  have hRM := congr_fun (congr_fun (R_M_row0_mul_M_row0 w ell hell0) c2) c1
  simp only [Matrix.mul_apply, Matrix.one_apply, eq_comm] at hRM ⊢
  simpa [mul_comm] using hRM

/-- Verified full-rank clock of order `w + 1` from `uniformTotalLiftClock`. -/
def uniformTotalFullRankLift {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hR : fc.clock.R b ⟨w - 1, by omega⟩ ≠ 0)
    (hell0 : ell_uniform_total hw fc.clock b c_step H0 delta alpha 0 ≠ 0) :
    FullRankClock (w + 1) where
  clock := uniformTotalLiftClock hw fc.clock b c_step H0 delta alpha P0 fc.L_C fc.hLC hR hell0
  L_C := L_C_uniform_total_next hw fc.clock b c_step H0 delta alpha P0 fc.L_C fc.hLC hR hell0
  hLC := uniform_total_C_transpose_mul_L_C hw fc.clock b c_step H0 delta alpha P0 fc.L_C fc.hLC hR hell0



/-!
### Lower-Triangular Column-Calibrated Reset Architecture: `W_lower`, `M_lower`, `J_lower`

This subsection provides the lower-triangular column-calibrated reset count matrix $W_{\mathrm{lower}}$
and stacked reset matrix $M_{\mathrm{lower}}$ satisfying:
1. Exact column sums: $\mathbf{1}^\top W_{\mathrm{lower}}(w, u) = u^\top$.
2. Two-sided explicit inverse $W_{\mathrm{lower}}^{-1}$.
3. Strict positivity in column 0: $W_{\mathrm{lower}}(i, 0) \ge 1$ for all rows $i$ whenever $u_0 \ge w + 1$.
4. Entrywise non-negativity: $W_{\mathrm{lower}}(i, c) \ge 0$ for all $i, c$.
5. Stacked reset matrix $M_{\mathrm{lower}}$ with $M_{\mathrm{lower}}(r, 0) \ge 1$ for all reset rows $r$,
   satisfying the reset step-count positivity requirement.
-/

/-- Lower-triangular column-calibrated reset matrix `W_lower`.
    Column 0 has entry `u 0 - w` in row 0 and `1` in rows 1..w.
    Column `c > 0` has entry `u c` on the diagonal and `0` elsewhere.
    This guarantees every row has entry ≥ 1 in column 0 whenever `u 0 ≥ w + 1`. -/
def W_lower (w : ℕ) (u : Fin (w + 1) → ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  Matrix.of fun i c =>
    if i.val = 0 then (if c.val = 0 then u 0 - w else 0)
    else (if c.val = 0 then 1 else if i = c then u c else 0)

/-- Inverse matrix `W_lower_inv`. -/
def W_lower_inv (w : ℕ) (u : Fin (w + 1) → ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  Matrix.of fun i c =>
    if i.val = 0 then (if c.val = 0 then (u 0 - w)⁻¹ else 0)
    else (if c.val = 0 then - (u 0 - w)⁻¹ * (u i)⁻¹ else if i = c then (u c)⁻¹ else 0)

theorem W_lower_apply_zero_zero (w : ℕ) (u : Fin (w + 1) → ℚ) :
    W_lower w u 0 0 = u 0 - w := rfl

theorem W_lower_apply_zero_succ (w : ℕ) (u : Fin (w + 1) → ℚ) (c : Fin w) :
    W_lower w u 0 c.succ = 0 := rfl

theorem W_lower_apply_succ_zero (w : ℕ) (u : Fin (w + 1) → ℚ) (i : Fin w) :
    W_lower w u i.succ 0 = 1 := rfl

theorem W_lower_apply_succ_succ (w : ℕ) (u : Fin (w + 1) → ℚ) (i c : Fin w) :
    W_lower w u i.succ c.succ = if i = c then u c.succ else 0 := by
  dsimp [W_lower]
  simp [Fin.succ_inj]

theorem W_lower_inv_apply_zero_zero (w : ℕ) (u : Fin (w + 1) → ℚ) :
    W_lower_inv w u 0 0 = (u 0 - w)⁻¹ := rfl

theorem W_lower_inv_apply_zero_succ (w : ℕ) (u : Fin (w + 1) → ℚ) (c : Fin w) :
    W_lower_inv w u 0 c.succ = 0 := rfl

theorem W_lower_inv_apply_succ_zero (w : ℕ) (u : Fin (w + 1) → ℚ) (i : Fin w) :
    W_lower_inv w u i.succ 0 = - (u 0 - w)⁻¹ * (u i.succ)⁻¹ := rfl

theorem W_lower_inv_apply_succ_succ (w : ℕ) (u : Fin (w + 1) → ℚ) (i c : Fin w) :
    W_lower_inv w u i.succ c.succ = if i = c then (u c.succ)⁻¹ else 0 := by
  dsimp [W_lower_inv]
  simp [Fin.succ_inj]

theorem vecMul_one_W_lower (w : ℕ) (u : Fin (w + 1) → ℚ) :
    Matrix.vecMul (fun _ => 1) (W_lower w u) = u := by
  ext c
  dsimp [Matrix.vecMul, dotProduct]
  rw [Fin.sum_univ_succ]
  refine Fin.cases ?_ ?_ c
  · rw [W_lower_apply_zero_zero]
    have hrest : (∑ j : Fin w, (1 : ℚ) * W_lower w u j.succ 0) = w := by
      simp_rw [W_lower_apply_succ_zero, mul_one]
      simp [Finset.card_univ]
    rw [hrest, one_mul]
    ring
  · intro jc
    rw [W_lower_apply_zero_succ]
    have hrest : (∑ j : Fin w, (1 : ℚ) * W_lower w u j.succ jc.succ) = u jc.succ := by
      simp_rw [W_lower_apply_succ_succ]
      rw [Finset.sum_eq_single jc]
      · simp
      · intro x _ hx
        rw [if_neg hx, mul_zero]
      · intro h; exfalso; exact h (Finset.mem_univ _)
    rw [hrest, one_mul, zero_add]

theorem W_lower_inv_mul_W_lower {w : ℕ} (u : Fin (w + 1) → ℚ)
    (hu0 : u 0 - w ≠ 0) (hui : ∀ i : Fin w, u i.succ ≠ 0) :
    W_lower_inv w u * W_lower w u = 1 := by
  ext i k
  rw [Matrix.mul_apply, Fin.sum_univ_succ]
  refine Fin.cases ?_ ?_ i
  · refine Fin.cases ?_ ?_ k
    · rw [W_lower_inv_apply_zero_zero, W_lower_apply_zero_zero]
      have hrest : (∑ j : Fin w, W_lower_inv w u 0 j.succ * W_lower w u j.succ 0) = 0 := by
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [W_lower_inv_apply_zero_succ, zero_mul]
      rw [hrest, add_zero, Matrix.one_apply_eq]
      exact inv_mul_cancel₀ hu0
    · intro jk
      rw [W_lower_inv_apply_zero_zero, W_lower_apply_zero_succ]
      have hrest : (∑ j : Fin w, W_lower_inv w u 0 j.succ * W_lower w u j.succ jk.succ) = 0 := by
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [W_lower_inv_apply_zero_succ, zero_mul]
      rw [hrest, mul_zero, add_zero]
      exact (Matrix.one_apply_ne (Fin.succ_ne_zero jk).symm).symm
  · intro ji
    refine Fin.cases ?_ ?_ k
    · rw [W_lower_inv_apply_succ_zero, W_lower_apply_zero_zero]
      have hrest : (∑ j : Fin w, W_lower_inv w u ji.succ j.succ * W_lower w u j.succ 0) =
          (u ji.succ)⁻¹ := by
        simp_rw [W_lower_inv_apply_succ_succ, W_lower_apply_succ_zero, mul_one]
        rw [Finset.sum_eq_single ji]
        · simp
        · intro x _ hx
          rw [if_neg (Ne.symm hx)]
        · intro h; exfalso; exact h (Finset.mem_univ _)
      rw [hrest]
      have hmul : (- (u 0 - w)⁻¹ * (u ji.succ)⁻¹) * (u 0 - w) = - (u ji.succ)⁻¹ := by
        calc (- (u 0 - w)⁻¹ * (u ji.succ)⁻¹) * (u 0 - w)
          _ = - ((u 0 - w)⁻¹ * (u 0 - w)) * (u ji.succ)⁻¹ := by ring
          _ = - 1 * (u ji.succ)⁻¹ := by rw [inv_mul_cancel₀ hu0]
          _ = - (u ji.succ)⁻¹ := by ring
      rw [hmul]
      have h1 : (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) ji.succ 0 = 0 :=
        Matrix.one_apply_ne (Fin.succ_ne_zero ji)
      rw [h1]
      ring
    · intro jk
      rw [W_lower_inv_apply_succ_zero, W_lower_apply_zero_succ, mul_zero, zero_add]
      simp_rw [W_lower_inv_apply_succ_succ, W_lower_apply_succ_succ]
      have hrest : (∑ j : Fin w, (if ji = j then (u j.succ)⁻¹ else 0) * if j = jk then u jk.succ else 0) =
          if ji = jk then 1 else 0 := by
        rw [Finset.sum_eq_single jk]
        · by_cases h : ji = jk
          · subst h
            simp [inv_mul_cancel₀ (hui ji)]
          · rw [if_neg h, zero_mul, if_neg h]
        · intro x _ hx
          rw [if_neg hx, mul_zero]
        · intro h; exfalso; exact h (Finset.mem_univ _)
      rw [hrest]
      by_cases h : ji = jk
      · subst h
        rw [if_pos rfl, Matrix.one_apply_eq]
      · rw [if_neg h, Matrix.one_apply_ne (by simpa [Fin.succ_inj])]

theorem W_lower_mul_W_lower_inv {w : ℕ} (u : Fin (w + 1) → ℚ)
    (hu0 : u 0 - w ≠ 0) (hui : ∀ i : Fin w, u i.succ ≠ 0) :
    W_lower w u * W_lower_inv w u = 1 := by
  ext i k
  rw [Matrix.mul_apply, Fin.sum_univ_succ]
  refine Fin.cases ?_ ?_ i
  · refine Fin.cases ?_ ?_ k
    · rw [W_lower_apply_zero_zero, W_lower_inv_apply_zero_zero]
      have hrest : (∑ j : Fin w, W_lower w u 0 j.succ * W_lower_inv w u j.succ 0) = 0 := by
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [W_lower_apply_zero_succ, zero_mul]
      rw [hrest, add_zero, Matrix.one_apply_eq]
      exact mul_inv_cancel₀ hu0
    · intro jk
      rw [W_lower_apply_zero_zero, W_lower_inv_apply_zero_succ]
      have hrest : (∑ j : Fin w, W_lower w u 0 j.succ * W_lower_inv w u j.succ jk.succ) = 0 := by
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [W_lower_apply_zero_succ, zero_mul]
      rw [hrest, mul_zero, add_zero]
      exact (Matrix.one_apply_ne (Fin.succ_ne_zero jk).symm).symm
  · intro ji
    refine Fin.cases ?_ ?_ k
    · rw [W_lower_apply_succ_zero, W_lower_inv_apply_zero_zero]
      have hrest : (∑ j : Fin w, W_lower w u ji.succ j.succ * W_lower_inv w u j.succ 0) =
          - (u 0 - w)⁻¹ := by
        simp_rw [W_lower_apply_succ_succ, W_lower_inv_apply_succ_zero]
        rw [Finset.sum_eq_single ji]
        · rw [if_pos rfl]
          calc u ji.succ * (- (u 0 - w)⁻¹ * (u ji.succ)⁻¹)
            _ = - (u 0 - w)⁻¹ * (u ji.succ * (u ji.succ)⁻¹) := by ring
            _ = - (u 0 - w)⁻¹ * 1 := by rw [mul_inv_cancel₀ (hui ji)]
            _ = - (u 0 - w)⁻¹ := by ring
        · intro x _ hx
          rw [if_neg (Ne.symm hx), zero_mul]
        · intro h; exfalso; exact h (Finset.mem_univ _)
      rw [hrest]
      have h1 : (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) ji.succ 0 = 0 :=
        Matrix.one_apply_ne (Fin.succ_ne_zero ji)
      rw [h1]
      ring
    · intro jk
      rw [W_lower_apply_succ_zero, W_lower_inv_apply_zero_succ, mul_zero, zero_add]
      simp_rw [W_lower_apply_succ_succ, W_lower_inv_apply_succ_succ]
      have hrest : (∑ j : Fin w, (if ji = j then u j.succ else 0) * if j = jk then (u jk.succ)⁻¹ else 0) =
          if ji = jk then 1 else 0 := by
        rw [Finset.sum_eq_single jk]
        · by_cases h : ji = jk
          · subst h
            simp [mul_inv_cancel₀ (hui ji)]
          · rw [if_neg h, zero_mul, if_neg h]
        · intro x _ hx
          rw [if_neg hx, mul_zero]
        · intro h; exfalso; exact h (Finset.mem_univ _)
      rw [hrest]
      by_cases h : ji = jk
      · subst h
        rw [if_pos rfl, Matrix.one_apply_eq]
      · rw [if_neg h, Matrix.one_apply_ne (by simpa [Fin.succ_inj])]

theorem vecMul_u_W_lower_inv (w : ℕ) (u : Fin (w + 1) → ℚ)
    (hu0 : u 0 - w ≠ 0) (hui : ∀ i : Fin w, u i.succ ≠ 0) :
    Matrix.vecMul u (W_lower_inv w u) = fun _ => 1 := by
  have h1 : Matrix.vecMul (fun _ => 1) (W_lower w u) = u := vecMul_one_W_lower w u
  calc Matrix.vecMul u (W_lower_inv w u)
    _ = Matrix.vecMul (Matrix.vecMul (fun _ => 1) (W_lower w u)) (W_lower_inv w u) := by rw [h1]
    _ = Matrix.vecMul (fun _ => 1) (W_lower w u * W_lower_inv w u) := by rw [Matrix.vecMul_vecMul]
    _ = Matrix.vecMul (fun _ => 1) 1 := by rw [W_lower_mul_W_lower_inv u hu0 hui]
    _ = fun _ => 1 := Matrix.vecMul_one (fun _ => 1)

/-- Strict column-0 positivity of `W_lower`: every row has entry ≥ 1 in column 0. -/
theorem W_lower_col_zero_ge_one (w : ℕ) (u : Fin (w + 1) → ℚ)
    (hu0 : (w : ℚ) + 1 ≤ u 0) (i : Fin (w + 1)) :
    1 ≤ W_lower w u i 0 := by
  refine Fin.cases ?_ ?_ i
  · rw [W_lower_apply_zero_zero]
    linarith
  · intro ji
    rw [W_lower_apply_succ_zero]

/-- Entrywise non-negativity of `W_lower`. -/
theorem W_lower_nonneg (w : ℕ) (u : Fin (w + 1) → ℚ)
    (hu0 : (w : ℚ) ≤ u 0) (hui : ∀ c : Fin (w + 1), 0 ≤ u c) (i c : Fin (w + 1)) :
    0 ≤ W_lower w u i c := by
  refine Fin.cases ?_ ?_ i
  · refine Fin.cases ?_ ?_ c
    · rw [W_lower_apply_zero_zero]
      linarith
    · intro jc
      rw [W_lower_apply_zero_succ]
  · intro ji
    refine Fin.cases ?_ ?_ c
    · rw [W_lower_apply_succ_zero]
      norm_num
    · intro jc
      rw [W_lower_apply_succ_succ]
      split_ifs with h
      · exact hui jc.succ
      · rfl

/-- Abbreviation for `W_lower` instantiated with `ell / 2`. -/
def W_lower_u (w : ℕ) (ell : Fin (w + 1) → ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  W_lower w (fun j => ell j / 2)

/-- Abbreviation for `W_lower_inv` instantiated with `ell / 2`. -/
def W_lower_inv_u (w : ℕ) (ell : Fin (w + 1) → ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  W_lower_inv w (fun j => ell j / 2)

/-- Reset count matrix `M_lower` constructed by stacking two copies of `W_lower_u w ell`. -/
def M_lower (w : ℕ) (ell : Fin (w + 1) → ℚ) : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ :=
  Matrix.of fun r c =>
    match finSumFinEquiv.symm r with
    | Sum.inl i => W_lower_u w ell i c
    | Sum.inr i => W_lower_u w ell i c

/-- Left inverse `R_M_lower` for `M_lower`. -/
def R_M_lower (w : ℕ) (ell : Fin (w + 1) → ℚ) : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  Matrix.of fun c r =>
    match finSumFinEquiv.symm r with
    | Sum.inl i => W_lower_inv_u w ell c i
    | Sum.inr _ => 0

/-- Interaction matrix `J_lower` realizing target moment matrix `E`. -/
def J_lower (w : ℕ) (ell : Fin (w + 1) → ℚ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) :
    Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ :=
  let X_mid := (W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell
  Matrix.of fun a b =>
    match finSumFinEquiv.symm a, finSumFinEquiv.symm b with
    | Sum.inl _, _ => 0
    | Sum.inr _, Sum.inr _ => 0
    | Sum.inr i, Sum.inl j => X_mid i j

/-- Reset step count positivity: every reset row in `M_lower` has entry ≥ 1 in column 0. -/
theorem M_lower_col_zero_ge_one (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (hell0 : (w : ℚ) + 1 ≤ ell 0 / 2) (r : Fin ((w + 1) + (w + 1))) :
    1 ≤ M_lower w ell r 0 := by
  dsimp [M_lower]
  cases finSumFinEquiv.symm r with
  | inl i => exact W_lower_col_zero_ge_one w (fun j => ell j / 2) hell0 i
  | inr i => exact W_lower_col_zero_ge_one w (fun j => ell j / 2) hell0 i

/-- Non-negativity of reset matrix `M_lower`. -/
theorem M_lower_nonneg (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (hell0 : (w : ℚ) ≤ ell 0 / 2) (helli : ∀ c : Fin (w + 1), 0 ≤ ell c)
    (r : Fin ((w + 1) + (w + 1))) (c : Fin (w + 1)) :
    0 ≤ M_lower w ell r c := by
  dsimp [M_lower]
  have hui : ∀ c : Fin (w + 1), 0 ≤ ell c / 2 := fun c => by linarith [helli c]
  cases finSumFinEquiv.symm r with
  | inl i => exact W_lower_nonneg w (fun j => ell j / 2) hell0 hui i c
  | inr i => exact W_lower_nonneg w (fun j => ell j / 2) hell0 hui i c

theorem ell_row_M_lower (w : ℕ) (ell : Fin (w + 1) → ℚ) :
    ell_row (M_lower w ell) = Matrix.of fun (_ : Unit) c => ell c := by
  ext _ c
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      (1 : ℚ) * M_lower w ell r c).symm
  simp only [ell_row, one_row, Matrix.mul_apply, Matrix.of_apply]
  rw [hcomp, Fintype.sum_sum_type]
  simp only [M_lower, Matrix.of_apply, Equiv.symm_apply_apply, one_mul]
  have hvec : (∑ i : Fin (w + 1), W_lower_u w ell i c) = ell c / 2 := by
    have h := congr_fun (vecMul_one_W_lower w (fun j => ell j / 2)) c
    dsimp [Matrix.vecMul, dotProduct, W_lower_u] at h ⊢
    rw [← h]
    simp only [one_mul]
  rw [hvec]
  ring

theorem R_M_lower_mul_M_lower (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ i : Fin w, ell i.succ ≠ 0) :
    R_M_lower w ell * M_lower w ell = 1 := by
  ext c1 c2
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      R_M_lower w ell c1 r * M_lower w ell r c2).symm
  rw [Matrix.mul_apply, hcomp, Fintype.sum_sum_type]
  simp only [R_M_lower, M_lower, Matrix.of_apply, Equiv.symm_apply_apply,
    zero_mul, Finset.sum_const_zero, add_zero]
  have hui' : ∀ i : Fin w, (fun j => ell j / 2) i.succ ≠ 0 := by
    intro i h
    have : ell i.succ = 0 := by linarith [h]
    exact hui i this
  have hW := congr_fun (congr_fun (W_lower_inv_mul_W_lower (fun j => ell j / 2) hu0 hui') c1) c2
  simpa [Matrix.mul_apply, W_lower_inv_u, W_lower_u] using hW

theorem J_lower_lower (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (a b : Fin ((w + 1) + (w + 1))) (hab : a.val ≤ b.val) :
    J_lower w ell E a b = 0 := by
  obtain ⟨sa, rfl⟩ := finSumFinEquiv.surjective a
  obtain ⟨sb, rfl⟩ := finSumFinEquiv.surjective b
  simp only [J_lower, Matrix.of_apply, Equiv.symm_apply_apply]
  rcases sa with i | i <;> rcases sb with j | j
  · rfl
  · rfl
  · simp only [finSumFinEquiv_apply_left, finSumFinEquiv_apply_right,
      Fin.val_castAdd, Fin.val_natAdd] at hab
    have hj : j.val < w + 1 := j.isLt
    omega
  · rfl

theorem M_lower_transpose_mul_J_lower_mul_M_lower (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ i : Fin w, ell i.succ ≠ 0) :
    (M_lower w ell).transpose * J_lower w ell E * M_lower w ell = E := by
  have hui' : ∀ i : Fin w, (fun j => ell j / 2) i.succ ≠ 0 := by
    intro i h
    have : ell i.succ = 0 := by linarith [h]
    exact hui i this
  let X_mid := (W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell
  have h_eq :
      (M_lower w ell).transpose * J_lower w ell E * M_lower w ell =
        (W_lower_u w ell).transpose * X_mid * W_lower_u w ell := by
    ext c1 c2
    simp only [Matrix.mul_apply, Matrix.transpose_apply]
    have hcomp1 :
        ∀ b : Fin ((w + 1) + (w + 1)),
          (∑ a : Fin ((w + 1) + (w + 1)), M_lower w ell a c1 * J_lower w ell E a b) =
            (∑ i : Fin (w + 1), W_lower_u w ell i c1 * J_lower w ell E (finSumFinEquiv (Sum.inl i)) b) +
            (∑ i : Fin (w + 1), W_lower_u w ell i c1 * J_lower w ell E (finSumFinEquiv (Sum.inr i)) b) := by
      intro b
      have hc := (Equiv.sum_comp finSumFinEquiv fun a => M_lower w ell a c1 * J_lower w ell E a b).symm
      rw [hc, Fintype.sum_sum_type]
      simp only [M_lower, Matrix.of_apply, Equiv.symm_apply_apply]
    simp_rw [hcomp1]
    have hcomp2 :=
      (Equiv.sum_comp finSumFinEquiv fun b : Fin ((w + 1) + (w + 1)) =>
        ((∑ i : Fin (w + 1), W_lower_u w ell i c1 * J_lower w ell E (finSumFinEquiv (Sum.inl i)) b) +
         (∑ i : Fin (w + 1), W_lower_u w ell i c1 * J_lower w ell E (finSumFinEquiv (Sum.inr i)) b)) *
        M_lower w ell b c2).symm
    rw [hcomp2, Fintype.sum_sum_type]
    simp only [M_lower, J_lower, Matrix.of_apply, Equiv.symm_apply_apply,
      mul_zero, Finset.sum_const_zero, zero_add, add_zero, zero_mul, X_mid]
  rw [h_eq]
  have hinv : W_lower_inv_u w ell * W_lower_u w ell = 1 :=
    W_lower_inv_mul_W_lower (fun j => ell j / 2) hu0 hui'
  have h1 : (W_lower_u w ell).transpose * (W_lower_inv_u w ell).transpose = (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) := by
    rw [← Matrix.transpose_mul, hinv, Matrix.transpose_one]
  have h2 : (W_lower_inv_u w ell) * (W_lower_u w ell) = (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) :=
    hinv
  calc
    (W_lower_u w ell).transpose * X_mid * W_lower_u w ell
      = ((W_lower_u w ell).transpose * (W_lower_inv_u w ell).transpose) * E * (W_lower_inv_u w ell * W_lower_u w ell) := by
        dsimp only [X_mid]
        simp only [Matrix.mul_assoc]
    _ = 1 * E * 1 := by rw [h1, h2]
    _ = E := by
      have he1 : (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) * E = E := Matrix.one_mul E
      have he2 : E * (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) = E := Matrix.mul_one E
      rw [he1, he2]

/-- Moment compatibility for the lower-triangular uniform clock lift. -/
theorem uniform_total_moment_compat_lower {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0)
    (hu0 : ell_uniform_total hw clock b c_step H0 delta alpha 0 / 2 - w ≠ 0)
    (hui : ∀ i : Fin w, ell_uniform_total hw clock b c_step H0 delta alpha i.succ ≠ 0) :
    (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock =
      (M_lower w (ell_uniform_total hw clock b c_step H0 delta alpha)).transpose *
        Q_reset (J_lower w (ell_uniform_total hw clock b c_step H0 delta alpha) (E_uniform_total hw clock b c_step H0 delta alpha))
          (M_lower w (ell_uniform_total hw clock b c_step H0 delta alpha))
          (B_mat (w + 1)) (zeta_canonical (by omega) clock b c_step H0) := by
  let ell := ell_uniform_total hw clock b c_step H0 delta alpha
  let M := M_lower w ell
  let J := J_lower w ell (E_uniform_total hw clock b c_step H0 delta alpha)
  let E := E_uniform_total hw clock b c_step H0 delta alpha
  let zeta := zeta_canonical (by omega) clock b c_step H0
  have hMJM : M.transpose * J * M = E :=
    M_lower_transpose_mul_J_lower_mul_M_lower w ell E hu0 hui
  have hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row M).transpose * psi_row zeta (B_mat (w + 1)) := by
    have hfull := E_uniform_full_moment_equation hw clock b c_step H0 delta alpha hR
    rw [ell_row_M_lower w ell]
    exact hfull
  exact uniform_moment_compat hw clock b c_step H0 delta M J E zeta hMJM hmoment

/-- Column-calibrated uniform coupling matrix `P_uniform_total_lower`. -/
def P_uniform_total_lower {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  let ell := ell_uniform_total hw clock b c_step H0 delta alpha
  let M := M_lower w ell
  let R_M := R_M_lower w ell
  let J := J_lower w ell (E_uniform_total hw clock b c_step H0 delta alpha)
  let zeta := zeta_canonical (by omega) clock b c_step H0
  P_uniform_interp hw clock b c_step H0 delta M R_M J zeta P0 L_C

/-- `P_uniform_total_lower` satisfies `Pᵀ * X = Q`. -/
theorem P_uniform_total_lower_transpose_mul_X {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) :
    let ell := ell_uniform_total hw clock b c_step H0 delta alpha
    let M := M_lower w ell
    let J := J_lower w ell (E_uniform_total hw clock b c_step H0 delta alpha)
    let zeta := zeta_canonical (by omega) clock b c_step H0
    (P_uniform_total_lower hw clock b c_step H0 delta alpha P0 L_C).transpose * X_gateway clock =
      Q_reset J M (B_mat (w + 1)) zeta := by
  intro ell M J zeta
  exact P_uniform_interp_transpose_mul_X hw clock b c_step H0 delta M (R_M_lower w ell) J zeta P0 L_C hLC

/-- `P_uniform_total_lower` satisfies `P * M = D`. -/
theorem P_uniform_total_lower_mul_M {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0)
    (hu0 : ell_uniform_total hw clock b c_step H0 delta alpha 0 / 2 - w ≠ 0)
    (hui : ∀ i : Fin w, ell_uniform_total hw clock b c_step H0 delta alpha i.succ ≠ 0) :
    let ell := ell_uniform_total hw clock b c_step H0 delta alpha
    let M := M_lower w ell
    P_uniform_total_lower hw clock b c_step H0 delta alpha P0 L_C * M =
      D_uniform hw clock b c_step H0 delta := by
  intro ell M
  let R_M := R_M_lower w ell
  let J := J_lower w ell (E_uniform_total hw clock b c_step H0 delta alpha)
  let E := E_uniform_total hw clock b c_step H0 delta alpha
  let zeta := zeta_canonical (by omega) clock b c_step H0
  have hRM : R_M * M = 1 := R_M_lower_mul_M_lower w ell hu0 hui
  have hMJM : M.transpose * J * M = E := M_lower_transpose_mul_J_lower_mul_M_lower w ell E hu0 hui
  have hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row M).transpose * psi_row zeta (B_mat (w + 1)) := by
    have hfull := E_uniform_full_moment_equation hw clock b c_step H0 delta alpha hR
    rw [ell_row_M_lower w ell]
    exact hfull
  exact P_uniform_interp_mul_M hw clock b c_step H0 delta M R_M J E zeta P0 L_C hRM hMJM hmoment

/-- Weight calibration for lower-triangular reset matrix `M_lower`. -/
theorem lower_weight_calibration {w : ℕ} (clock : AlgebraicClock w)
    (ell : Fin (w + 1) → ℚ) :
    Matrix.vecMul (v_old_coupled clock.m)
      (X_coupled clock * (1 + N_mat (w + 1) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)) +
      Matrix.vecMul (0 : Fin ((w + 1) + (w + 1)) → ℚ) (M_lower w ell) =
    e0_row (w + 1) := by
  have h0 : Matrix.vecMul (0 : Fin ((w + 1) + (w + 1)) → ℚ) (M_lower w ell) = 0 := by
    ext c; simp [Matrix.vecMul, dotProduct]
  have h0_coupled : Matrix.vecMul (0 : Fin ((w + 1) + (w + 1)) → ℚ) (M_coupled w) = 0 := by
    ext c; simp [Matrix.vecMul, dotProduct]
  have hcal := coupled_weight_calibration clock
  rw [h0_coupled, add_zero] at hcal
  rw [h0, add_zero, hcal]

/-- Inductive algebraic clock lift of order `w + 1` from the lower-triangular uniform score table architecture. -/
@[reducible] def uniformTotalLiftClock_lower {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0)
    (hu0 : ell_uniform_total hw clock b c_step H0 delta alpha 0 / 2 - w ≠ 0)
    (hui : ∀ i : Fin w, ell_uniform_total hw clock b c_step H0 delta alpha i.succ ≠ 0) :
    AlgebraicClock (w + 1) :=
  let ell := ell_uniform_total hw clock b c_step H0 delta alpha
  let M := M_lower w ell
  let J := J_lower w ell (E_uniform_total hw clock b c_step H0 delta alpha)
  let zeta := zeta_canonical (by omega) clock b c_step H0
  let P := P_uniform_total_lower hw clock b c_step H0 delta alpha P0 L_C
  let G_O := AdjoinLeaderEndpointG clock.G b clock.v
  let h_row := h_uniform clock b zeta c_step
  let S := S_uniform (by omega) clock b h_row delta
  let X := X_gateway clock
  let B := B_mat (w + 1)
  let v_old := v_old_coupled clock.m
  let v_reset : Fin ((w + 1) + (w + 1)) → ℚ := 0
  let aP_old : Fin (clock.m + 1) → ℚ := fun _ => 1
  let aP_reset : Fin ((w + 1) + (w + 1)) → ℚ := fun _ => 1
  AlgebraicClock.ofEquiv (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1)))
    (liftedGameMat G_O P J)
    (liftedScoreMat G_O J S X M zeta)
    (liftedCountMat X M (N_mat (w + 1)))
    (liftedWeightVec v_old v_reset)
    (liftedWeightVec aP_old aP_reset)
    (liftedGameMat_skew G_O P J (AdjoinLeaderEndpointG_skew clock.G b clock.v clock.hskew))
    (liftedGameMat_mul_liftedCountMat G_O P J S X M B (N_mat (w + 1)) zeta
      (B_mat_mul_one_add_N (w + 1))
      (P_uniform_total_lower_transpose_mul_X hw clock b c_step H0 delta alpha P0 L_C hLC)
      (P_uniform_total_lower_mul_M hw clock b c_step H0 delta alpha P0 L_C hR hu0 hui))
    (by
      have hcal := lower_weight_calibration clock ell
      exact liftedWeightVec_mul_liftedCountMat X M v_old v_reset hcal)
    (fun s => by
      cases s with
      | inl _ => exact zero_lt_one
      | inr _ => exact zero_lt_one)

/-- Universal left inverse $L_C$ for `uniformTotalLiftClock_lower`. -/
def L_C_uniform_total_next_lower {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0)
    (hu0 : ell_uniform_total hw clock b c_step H0 delta alpha 0 / 2 - w ≠ 0)
    (hui : ∀ i : Fin w, ell_uniform_total hw clock b c_step H0 delta alpha i.succ ≠ 0) :
    Matrix (Fin (uniformTotalLiftClock_lower hw clock b c_step H0 delta alpha P0 L_C hLC hR hu0 hui).m) (Fin (w + 1)) ℚ :=
  let ell := ell_uniform_total hw clock b c_step H0 delta alpha
  Matrix.of fun x c =>
    match (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))).symm x with
    | Sum.inl _ => 0
    | Sum.inr r => R_M_lower w ell c r

/-- Full column rank preservation for `uniformTotalLiftClock_lower`. -/
theorem uniform_total_C_transpose_mul_L_C_lower {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0)
    (hu0 : ell_uniform_total hw clock b c_step H0 delta alpha 0 / 2 - w ≠ 0)
    (hui : ∀ i : Fin w, ell_uniform_total hw clock b c_step H0 delta alpha i.succ ≠ 0) :
    (uniformTotalLiftClock_lower hw clock b c_step H0 delta alpha P0 L_C hLC hR hu0 hui).C.transpose *
      L_C_uniform_total_next_lower hw clock b c_step H0 delta alpha P0 L_C hLC hR hu0 hui = 1 := by
  let ell := ell_uniform_total hw clock b c_step H0 delta alpha
  ext c1 c2
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  change ∑ x : Fin ((clock.m + 1) + ((w + 1) + (w + 1))),
    (uniformTotalLiftClock_lower hw clock b c_step H0 delta alpha P0 L_C hLC hR hu0 hui).C x c1 *
      L_C_uniform_total_next_lower hw clock b c_step H0 delta alpha P0 L_C hLC hR hu0 hui x c2 =
    (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) c1 c2
  rw [(Equiv.sum_comp (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))) fun y =>
    (uniformTotalLiftClock_lower hw clock b c_step H0 delta alpha P0 L_C hLC hR hu0 hui).C y c1 *
      L_C_uniform_total_next_lower hw clock b c_step H0 delta alpha P0 L_C hLC hR hu0 hui y c2).symm]
  rw [Fintype.sum_sum_type]
  simp only [uniformTotalLiftClock_lower, AlgebraicClock.ofEquiv, liftedCountMat,
    L_C_uniform_total_next_lower, Matrix.of_apply, Equiv.symm_apply_apply,
    mul_zero, Finset.sum_const_zero, zero_add]
  have hRM := congr_fun (congr_fun (R_M_lower_mul_M_lower w ell hu0 hui) c2) c1
  simp only [Matrix.mul_apply, Matrix.one_apply, eq_comm] at hRM ⊢
  simpa [mul_comm] using hRM

/-- Verified full-rank clock of order `w + 1` from `uniformTotalLiftClock_lower`. -/
def uniformTotalFullRankLift_lower {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hR : fc.clock.R b ⟨w - 1, by omega⟩ ≠ 0)
    (hu0 : ell_uniform_total hw fc.clock b c_step H0 delta alpha 0 / 2 - w ≠ 0)
    (hui : ∀ i : Fin w, ell_uniform_total hw fc.clock b c_step H0 delta alpha i.succ ≠ 0) :
    FullRankClock (w + 1) where
  clock := uniformTotalLiftClock_lower hw fc.clock b c_step H0 delta alpha P0 fc.L_C fc.hLC hR hu0 hui
  L_C := L_C_uniform_total_next_lower hw fc.clock b c_step H0 delta alpha P0 fc.L_C fc.hLC hR hu0 hui
  hLC := uniform_total_C_transpose_mul_L_C_lower hw fc.clock b c_step H0 delta alpha P0 fc.L_C fc.hLC hR hu0 hui

end Karlin



