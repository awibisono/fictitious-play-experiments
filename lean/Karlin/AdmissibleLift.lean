theorem count_map_equiv' {α β : Type*} [DecidableEq α] [DecidableEq β] (e : α ≃ β) (W : List α) (y : β) :
    wordCountVec (W.map e) y = wordCountVec W (e.symm y) := by
  dsimp [wordCountVec, List.count]
  rw [List.countP_map]
  congr 1
  apply List.countP_congr
  intro x _
  dsimp
  simp only [beq_iff_eq]
  exact e.apply_eq_iff_eq_symm_apply

theorem step_parentWord_count {w : ℕ} (grc : GroundedRealizedClock w) (q : ℕ) :
    wordCountVec (step_parentWord grc q) =
      grc.step_rc.fc.clock.C.mulVec (binomBasis (w + 1) q) := by
  have h_raw := wordCountVec_rawFourStageWord_M grc.rc.fc.clock grc.parentWord grc.hparent_count
    (M_lower_nat w grc.u) q
  ext y
  dsimp [step_parentWord]
  rw [count_map_equiv' (rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1)))]
  rw [h_raw]
  simp only [Matrix.mulVec, dotProduct, step_clock_C_apply]

theorem isValidPriorityWord_of_rank_val {α : Type*} [Fintype α] [DecidableEq α] {m n : ℕ}
    (M : Matrix α α ℚ) (s : α → ℚ) (r : α → Fin m) (r' : α → Fin n) (W : List α)
    (hr : ∀ a, (r' a).val = (r a).val) (hW : IsValidPriorityWord M s r W) :
    IsValidPriorityWord M s r' W := by
  intro k hk j
  obtain ⟨h1, h2⟩ := hW k hk j
  refine ⟨h1, fun hne heq => ?_⟩
  rw [hr, hr]
  exact h2 hne heq

theorem step_parentWord_valid {w : ℕ} (grc : GroundedRealizedClock w) {n : ℕ}
    (rank : Fin (grc.rc.fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)) → Fin n)
    (h_raw : ∀ σ, IsValidPriorityWord (grcGl grc) ((grcRl grc).mulVec (binomBasis (w + 1) σ)) rank
      (rawFourStageWord_M grc.rc.fc.clock grc.parentWord (M_lower_nat w grc.u) σ)) (σ : ℕ) :
    IsValidPriorityWord grc.step_rc.fc.clock.G (grc.step_rc.fc.clock.R.mulVec (binomBasis (w + 1) σ))
      (fun j => rank ((rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm j))
      (step_parentWord grc σ) := by
  rw [step_clock_G_eq, step_clock_R_mulVec]
  exact isValidPriorityWord_map_equiv (rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1)))
    _ _ rank _ (h_raw σ)

/-- Generic: a parent row of the lifted score table is dominated by the gateway row plus `K` at
    column 0. -/
theorem parent_row_le_gw_row_add {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (h : Fin (w + 1) → ℚ) (delta K : ℚ)
    (h_leader_all : ∀ i (j : Fin w), clock.R i j ≤ clock.R b j)
    (h_K : ∀ i0 : Fin clock.m, clock.R i0 ⟨0, by omega⟩ - clock.R b ⟨0, by omega⟩ -
      (clock.G b i0 + clock.v i0) ≤ K + delta)
    (i0 : Fin clock.m) (j : Fin (w + 1)) :
    (S_uniform (Nat.le_of_succ_le hw) clock b h delta +
        AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock) (finSumFinEquiv (Sum.inl i0)) j ≤
      (S_uniform (Nat.le_of_succ_le hw) clock b h delta +
        AdjoinLeaderEndpointG clock.G b clock.v * X_gateway clock) (gatewayOldAct clock.m) j +
        (if j.val = 0 then K else 0) := by
  have h_parent := S_add_GO_X_parent_apply (Nat.le_of_succ_le hw) clock b h delta i0 j
  have h_gw := S_add_GO_X_gateway_apply (Nat.le_of_succ_le hw) clock b h delta j
  dsimp only at h_parent h_gw
  rw [h_parent, h_gw]
  by_cases hj0 : j.val = 0
  · simp only [hj0, ↓reduceIte]
    rw [mul_shiftRightCount_zero clock.G clock.C b j hj0, mul_shiftRightCount_zero clock.G clock.C i0 j hj0]
    have h_delta := h_K i0
    linarith
  · simp only [hj0, ↓reduceIte, add_zero]
    by_cases hjw : j.val < w
    · have h_mul_b := shiftRightCount_R_mul_N_mat (by omega) clock b j
      have h_mul_i0 := shiftRightCount_R_mul_N_mat (by omega) clock i0 j
      rw [if_neg hj0] at h_mul_b h_mul_i0
      rw [← h_mul_b, ← h_mul_i0, mul_N_mat_apply, mul_N_mat_apply]
      have hd_lt : j.val + 1 < w + 1 := by omega
      simp only [hd_lt, ↓reduceDIte]
      have hshift : ∀ a, shiftRightCount clock.R a ⟨j.val + 1, hd_lt⟩ = clock.R a ⟨j.val, hjw⟩ := by
        intro a
        unfold shiftRightCount
        simp only [Matrix.of_apply]
        have hpos : 0 < j.val + 1 := by omega
        simp only [hpos, ↓reduceDIte]
        congr 1
      rw [hshift b, hshift i0]
      have h_lead := h_leader_all i0 ⟨j.val, hjw⟩
      linarith
    · have hj_eq_w : j.val = w := by have := j.isLt; omega
      have heq_j : j = ⟨w, Nat.lt_succ_self w⟩ := by ext; exact hj_eq_w
      rw [heq_j]
      have h_shift : ∀ a, (clock.G * shiftRightCount clock.C) a ⟨w, Nat.lt_succ_self w⟩ = 0 := by
        intro a
        have h_mul := shiftRightCount_R_mul_N_mat (by omega) clock a ⟨w, Nat.lt_succ_self w⟩
        have hw_ne : ¬ (w = 0) := by omega
        rw [if_neg hw_ne] at h_mul
        rw [← h_mul, mul_N_mat_apply]
        have h_col : ¬ (w + 1 < w + 1) := by omega
        simp only [h_col, ↓reduceDIte]
      rw [h_shift b, h_shift i0]

theorem step_b0_leader_all' {w : ℕ} (grc : GroundedRealizedClock w)
    (h_leader_all : ∀ i (j : Fin w), grc.rc.fc.clock.R i j ≤ grc.rc.fc.clock.R grc.b j)
    (h_JM_nonneg : ∀ r c, 0 ≤ (grcJ grc * M_of_nat (M_lower_nat w grc.u)) r c)
    (hc_Gv : ∀ i0 : Fin grc.rc.fc.clock.m,
      grc.rc.fc.clock.R i0 ⟨0, by have := grc.hw; omega⟩ - grc.rc.fc.clock.R grc.b ⟨0, by have := grc.hw; omega⟩ -
        (grc.rc.fc.clock.G grc.b i0 + grc.rc.fc.clock.v i0) ≤ grc.c_step)
    (h_delta_le : grc.delta ≤ grc.c_step)
    (i : Fin grc.step_rc.fc.clock.m) (j : Fin (w + 1)) :
    grc.step_rc.fc.clock.R i j ≤ grc.step_rc.fc.clock.R (step_b0 grc) j := by
  rw [step_clock_R_apply, step_b0_R]
  have hgw := grcRl_gw_apply grc j
  have hgw_le : grcRl grc (Sum.inl (gatewayOldAct grc.rc.fc.clock.m)) j ≤ grcZeta grc j := by
    rw [hgw]
    split_ifs <;> linarith
  generalize (rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm i = x
  rcases x with y | r
  · rcases hy : finSumFinEquiv.symm y with i0 | z
    · have hy_eq : y = finSumFinEquiv (Sum.inl i0) := by rw [← hy, Equiv.apply_symm_apply]
      subst hy_eq
      have h1 := parent_row_le_gw_row_add grc.hw grc.rc.fc.clock grc.b (h_uniform grc.rc.fc.clock grc.b (grcZeta grc) grc.c_step) grc.delta
        (grc.c_step - grc.delta) h_leader_all (fun i0 => by have := hc_Gv i0; linarith) i0 j
      change grcRl grc (Sum.inl (finSumFinEquiv (Sum.inl i0))) j ≤
        grcRl grc (Sum.inl (gatewayOldAct grc.rc.fc.clock.m)) j +
          (if j.val = 0 then grc.c_step - grc.delta else 0) at h1
      rw [hgw] at h1
      split_ifs at h1 <;> linarith
    · have hy_eq : y = gatewayOldAct grc.rc.fc.clock.m := by
        rw [← Equiv.apply_symm_apply finSumFinEquiv y, hy, Subsingleton.elim z 0]
        rfl
      subst hy_eq
      exact hgw_le
  · rw [grcRl_inr_apply]
    linarith [h_JM_nonneg r j]

theorem J_lower_eta_nonneg' (w : ℕ) (ell : Fin (w + 1) → ℚ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (hJ_sub : ∀ a b : Fin ((w + 1) + (w + 1)), b.val < a.val → 0 < J_lower_eta w ell E eta a b)
    (a b : Fin ((w + 1) + (w + 1))) :
    0 ≤ J_lower_eta w ell E eta a b := by
  by_cases hab : a.val ≤ b.val
  · rw [J_lower_eta_lower w ell E eta a b hab]
  · have hlt : b.val < a.val := by omega
    exact le_of_lt (hJ_sub a b hlt)

theorem JM_lower_eta_nonneg' (w : ℕ) (ell : Fin (w + 1) → ℚ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (u : Fin (w + 1) → ℕ)
    (hJ_sub : ∀ a b : Fin ((w + 1) + (w + 1)), b.val < a.val → 0 < J_lower_eta w ell E eta a b)
    (r : Fin ((w + 1) + (w + 1))) (c : Fin (w + 1)) :
    0 ≤ (J_lower_eta w ell E eta * M_of_nat (M_lower_nat w u)) r c := by
  simp only [Matrix.mul_apply]
  refine Finset.sum_nonneg fun a _ => ?_
  have hj := J_lower_eta_nonneg' w ell E eta hJ_sub r a
  have hm : 0 ≤ (M_of_nat (M_lower_nat w u)) a c := by
    dsimp [M_of_nat]
    exact Nat.cast_nonneg _
  exact mul_nonneg hj hm

/-- Identification of `P_uniform_total_lower_eta` with the natural-matrix coupling. -/
theorem P_total_eq_P_uniform_M {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 alpha eta : ℚ) (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (u : Fin (w + 1) → ℕ) (hu0 : w ≤ u 0)
    (hell : ell_uniform_total hw clock b c_step H0 (1 / 2) alpha = fun c => 2 * (u c : ℚ)) :
    P_uniform_total_lower_eta hw clock b c_step H0 (1 / 2) alpha eta L_C a_old =
      P_uniform_M hw clock b c_step H0 (1 / 2) (M_lower_nat w u)
        (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw clock b c_step H0 (1 / 2) alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0) (P0_cone_old a_old w) L_C := by
  dsimp [P_uniform_total_lower_eta, P_uniform_M, P_uniform_interp]
  rw [hell, M_of_nat_M_lower_nat w u hu0]

section GroundedClockBundle

variable {w : ℕ} (B : GroundedClockBundle w)

theorem GroundedClockBundle.hJM_nonneg (r : Fin ((w + 1) + (w + 1))) (c : Fin (w + 1)) :
    0 ≤ (grcJ B.L.toGRC * M_of_nat (M_lower_nat w B.L.toGRC.u)) r c :=
  JM_lower_eta_nonneg' w _ _ _ B.L.u B.L.hJ_subdiag r c

theorem GroundedClockBundle.two_u_eq (c : Fin (w + 1)) :
    2 * ((B.L.u c : ℕ) : ℚ) = 3 * (2 * (((B.m_alpha : ℤ)) : ℚ) + 1) *
      zeta_canonical (Nat.le_of_succ_le B.L.hw) B.L.rc.fc.clock B.L.b B.L.c_step B.L.H0 c -
        y_sum_uniform B.L.rc.fc.clock c := by
  have h1 := congrFun B.L.hell c
  rw [ell_uniform_total_eq_ell_uniform_of_CGC_zero _ _ _ _ _ _ _ B.hCGC] at h1
  simp only [ell_uniform, Pi.sub_apply, Pi.smul_apply, smul_eq_mul] at h1
  rw [B.halpha] at h1
  push_cast
  linarith

theorem GroundedClockBundle.colsum_step (c : Fin (w + 1)) :
    ∃ z : ℤ, (∑ a, B.L.toGRC.step_rc.fc.clock.C a c) = (((2 * (B.m_alpha : ℤ) + 1) * z : ℤ) : ℚ) ∧
      (∑ a, B.L.toGRC.step_rc.fc.clock.C a c) -
        3 * zeta_canonical (Nat.le_of_succ_le B.L.hw) B.L.rc.fc.clock B.L.b B.L.c_step B.L.H0 c =
          2 * (((B.m_alpha : ℤ) * z : ℤ) : ℚ) := by
  obtain ⟨z, hz⟩ := B.hzeta_int c
  have h := colsum_sub_three_zeta_even_of_odd_mul_three_alpha (Nat.le_of_succ_le B.L.hw) B.L.rc.fc.clock
    B.L.b B.L.c_step B.L.H0 (fun j => (B.L.u j : ℚ)) (B.m_alpha : ℤ) z c hz (B.two_u_eq c)
  have hsum : (∑ a, B.L.toGRC.step_rc.fc.clock.C a c) =
      ∑ x, liftedCountMat (X_gateway B.L.rc.fc.clock) (M_lower w (fun j => 2 * (B.L.u j : ℚ)))
        (N_mat (w + 1)) x c := by
    simp only [step_clock_C_apply]
    rw [← M_of_nat_M_lower_nat w B.L.u (by have := B.L.hu0; omega)]
    exact Equiv.sum_comp (rotLeaderEquiv (B.L.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm
      (fun x => liftedCountMat (X_gateway B.L.rc.fc.clock) (M_of_nat (M_lower_nat w B.L.u)) (N_mat (w + 1)) x c)
  refine ⟨z, ?_, ?_⟩
  · rw [hsum]; exact h.1
  · rw [hsum]; exact h.2

theorem GroundedClockBundle.step_CGC :
    B.L.toGRC.step_rc.fc.clock.C.transpose * B.L.toGRC.step_rc.fc.clock.G *
      B.L.toGRC.step_rc.fc.clock.C = 0 := by
  apply step_clock_CGC_zero_of_lifted
  have hu0' : w ≤ B.L.u 0 := by have := B.L.hu0; omega
  have hcol : ∀ c, (∑ r, M_of_nat (M_lower_nat w B.L.u) r c) =
      ell_uniform B.L.hw B.L.rc.fc.clock B.L.b B.L.c_step B.L.H0 B.L.alpha c := by
    intro c
    have h1 := congrFun (congrFun (ell_row_M_lower_nat w B.L.u hu0') ()) c
    simp only [ell_row, one_row, Matrix.mul_apply, Matrix.of_apply, one_mul] at h1
    rw [← ell_uniform_total_eq_ell_uniform_of_CGC_zero _ _ _ _ _ (1 / 2) _ B.hCGC, B.L.hell]
    exact h1
  have hMJM : (M_of_nat (M_lower_nat w B.L.u)).transpose * grcJ B.L.toGRC * M_of_nat (M_lower_nat w B.L.u) =
      E_uniform B.L.hw B.L.rc.fc.clock B.L.b B.L.c_step B.L.H0 (1 / 2) B.L.alpha := by
    rw [← E_uniform_total_eq_E_uniform_of_CGC_zero _ _ _ _ _ _ _ B.hCGC]
    exact M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w B.L.u _ B.L.eta B.L.hu0 B.L.hui
  exact uniform_lifted_clock_CGC_zero B.L.hw B.L.rc.fc.clock B.L.b B.L.c_step B.L.H0 (1 / 2) B.L.alpha
    B.hCGC (grcP B.L.toGRC) (grcJ B.L.toGRC) (M_of_nat (M_lower_nat w B.L.u)) (B_mat (w + 1))
    (B_mat_mul_one_add_N (w + 1)) (grc_hPtX B.L.toGRC) (grc_hPM B.L.toGRC) hcol hMJM

end GroundedClockBundle

section GroundedClockBundle

theorem GroundedClockBundle.next_nonempty {w : ℕ} (B : GroundedClockBundle w) : Nonempty (GroundedClockBundle (w + 1)) := by
  classical
  set grc := B.L.toGRC with hgrc
  have hw' : 2 ≤ w + 1 := by have := B.L.hw; omega
  have hH0pos : 0 < grc.H0 := by show 0 < B.L.H0; linarith [B.L.hH0]
  have hcpos : 0 < grc.c_step := by show 0 < B.L.c_step; linarith [B.L.hc1]
  have hRpos : ∀ c : Fin w, 0 < grc.rc.fc.clock.R grc.b c := B.L.hR_pos
  have hcount' := step_parentWord_count grc
  have hlen' := step_parentWord_length_ge grc B.h_len
  have hsuf' := hasSuffixBound_step_b0 grc B.hasSuffix B.h_len
  have hzeta_pos := zeta_canonical_pos B.L.hw B.L.rc.fc.clock B.L.b B.L.c_step B.L.H0 hH0pos hcpos B.L.hR_pos
  have hRb0_pos : ∀ j, 0 < grc.step_rc.fc.clock.R (step_b0 grc) j := by
    intro j; rw [step_b0_R]; exact hzeta_pos j
  have hb0_top : grc.step_rc.fc.clock.R (step_b0 grc) ⟨w + 1 - 1, by omega⟩ = 1 := by
    have h := step_b0_subdiag grc
    have he : (⟨w + 1 - 1, by omega⟩ : Fin (w + 1)) = ⟨w, Nat.lt_succ_self w⟩ := Fin.ext (by simp)
    rw [he]; exact h
  let Cfn : ℚ → ℚ := fun eps => if h : 0 < eps then
    Classical.choose (bundle_active_score_lb_of_hasSuffixBound hw' grc.step_rc.fc.clock (step_b0 grc)
      (step_parentWord grc) hcount' hsuf' hlen' eps h) else 0
  obtain ⟨z0, hz0, -⟩ := B.colsum_step ⟨0, by omega⟩
  let Kgv : ℚ := ∑ i, |grc.step_rc.fc.clock.R i ⟨0, by omega⟩ - grc.step_rc.fc.clock.R (step_b0 grc) ⟨0, by omega⟩ -
    (grc.step_rc.fc.clock.G (step_b0 grc) i + grc.step_rc.fc.clock.v i)|
  obtain ⟨c', H0', eps', k_step, k_H0, a', h3c, h3H, hCmin, hc'pos, -, hcH, heps_pos, ha'pos, heps_le,
    ha_gw, hmargin, hcone⟩ :=
    exists_next_cone_params grc hH0pos hcpos hRpos ((2 * (B.m_alpha : ℤ) + 1) * z0) (max 1 (Kgv + 1))
      (fun c => c + 1) Cfn
  have hc1' : 1 ≤ c' := le_trans (le_max_left _ _) hCmin
  have hcK : Kgv + 1 ≤ c' := le_trans (le_max_right _ _) hCmin
  have hH0'1 : 1 ≤ H0' := by linarith
  have hH0'pos : 0 < H0' := by linarith
  have hzeta'_pos := zeta_canonical_pos hw' grc.step_rc.fc.clock (step_b0 grc) c' H0' hH0'pos hc'pos hRb0_pos
  have hspec := exists_odd_alpha_and_eta_for_uniform_total hw' grc.step_rc.fc.clock (step_b0 grc) c' H0' (1 / 2)
      hzeta'_pos a' ha'pos hcone grc.step_rc.fc.L_C (by rw [hb0_top]; norm_num)
  obtain ⟨m', eta', hspec⟩ := hspec
  dsimp only at hspec
  obtain ⟨heta', hell0', hellc', -, -, hJsub', hPinr', hPinl'⟩ := hspec
  have hparity' : ∀ c : Fin (w + 1), 0 < c.val → ∃ k : ℤ,
      (∑ i, grc.step_rc.fc.clock.C i c) - 3 * grc.step_rc.fc.clock.R (step_b0 grc) c = 2 * (k : ℚ) := by
    intro c _
    obtain ⟨z, -, hz⟩ := B.colsum_step c
    exact ⟨_, by rw [step_b0_R]; exact hz⟩
  have hRint' : ∀ c : Fin (w + 1), 0 < c.val → ∃ z : ℤ, 3 * grc.step_rc.fc.clock.R (step_b0 grc) c = (z : ℚ) := by
    intro c _
    obtain ⟨z, hz⟩ := B.hzeta_int c
    exact ⟨z, by rw [step_b0_R]; exact hz⟩
  have hpar := ell_uniform_total_even_of_colsum_sub_three_R_even hw' grc.step_rc.fc.clock (step_b0 grc) H0' c'
    (1 / 2) (3 * (2 * (m' : ℚ) + 1)) B.step_CGC hb0_top ⟨_, hz0⟩ hparity' hRint' k_step k_H0 (m' : ℤ)
    (by rw [hz0]; exact h3c) (by rw [hz0]; exact h3H) (by push_cast; ring)
  obtain ⟨hzeta_int', -, hell_even⟩ := hpar
  choose kk hkk using hell_even
  have hkk_pos : ∀ c, 1 ≤ kk c := by
    intro c
    have h := hellc' c
    rw [hkk c] at h
    have : (1 : ℚ) ≤ (kk c : ℚ) := by linarith
    exact_mod_cast this
  let u' : Fin (w + 1 + 1) → ℕ := fun c => (kk c).toNat
  have hu'_int : ∀ c, ((u' c : ℕ) : ℤ) = kk c := fun c => Int.toNat_of_nonneg (by linarith [hkk_pos c])
  have hu'_cast : ∀ c, ((u' c : ℕ) : ℚ) = (kk c : ℚ) := by
    intro c
    have := hu'_int c
    exact_mod_cast this
  have hell' : ell_uniform_total hw' grc.step_rc.fc.clock (step_b0 grc) c' H0' (1 / 2) (3 * (2 * (m' : ℚ) + 1)) =
      fun c => 2 * (u' c : ℚ) := by
    funext c; rw [hu'_cast, hkk c]
  have hu0' : w + 1 + 1 ≤ u' 0 := by
    have h := hell0'
    rw [hkk 0] at h
    have h2 : ((w + 1 + 1 : ℕ) : ℚ) ≤ (kk 0 : ℚ) := by push_cast at h ⊢; linarith
    have h3 : ((w + 1 + 1 : ℕ) : ℤ) ≤ kk 0 := by exact_mod_cast h2
    have h4 := hu'_int 0
    omega
  have hui' : ∀ i : Fin (w + 1), 1 ≤ u' i.succ := by
    intro i
    have h1 := hkk_pos i.succ
    have h2 := hu'_int i.succ
    omega
  rw [hell'] at hJsub'
  have hPeq := P_total_eq_P_uniform_M hw' grc.step_rc.fc.clock (step_b0 grc) c' H0' (3 * (2 * (m' : ℚ) + 1)) eta'
    grc.step_rc.fc.L_C a' u' (by omega) hell'
  rw [hPeq] at hPinr' hPinl'
  have hCfn : Cfn eps' = Classical.choose (bundle_active_score_lb_of_hasSuffixBound hw' grc.step_rc.fc.clock
      (step_b0 grc) (step_parentWord grc) hcount' hsuf' hlen' eps' heps_pos) := dif_pos heps_pos
  have hCspec := Classical.choose_spec (bundle_active_score_lb_of_hasSuffixBound hw' grc.step_rc.fc.clock
      (step_b0 grc) (step_parentWord grc) hcount' hsuf' hlen' eps' heps_pos)
  rw [← hCfn] at hCspec
  have hm_rank : B.L.rc.fc.clock.m + 2 * (w + 1) + 1 = grc.step_rc.fc.clock.m := by
    show _ = B.L.rc.fc.clock.m + 1 + ((w + 1) + (w + 1)); omega
  exact ⟨{
    L := {
      hw := hw'
      rc := grc.step_rc
      b := step_b0 grc
      hb_subdiag := hb0_top
      parentWord := step_parentWord grc
      parent_rank := fun j => Fin.cast hm_rank (paperPriorityRank B.L.rc.fc.clock.m w B.L.parent_rank
        ((rotLeaderEquiv (B.L.rc.fc.clock.m + 1) ((w + 1) + (w + 1))).symm j))
      hparent_count := hcount'
      hparent_valid := fun σ => isValidPriorityWord_of_rank_val _ _ _ _ _ (fun _ => rfl)
        (step_parentWord_valid grc (paperPriorityRank B.L.rc.fc.clock.m w B.L.parent_rank) B.L.raw_valid σ)
      h_leader_all := step_b0_leader_all' grc B.L.h_leader_all B.hJM_nonneg
        (fun i0 => le_of_lt (B.L.hc_Gv i0)) (by show (1 / 2 : ℚ) ≤ B.L.c_step; linarith [B.L.hc1])
      hR_pos := hRb0_pos
      h_v_take := fun σ r hr => le_of_eq (step_parentWord_take_v_dot_eq_zero grc σ r hr)
      c_step := c'
      H0 := H0'
      alpha := 3 * (2 * (m' : ℚ) + 1)
      eta := eta'
      heta := heta'
      hc1 := hc1'
      hc_Gv := fun i => by
        have h1 := Finset.single_le_sum (f := fun i => |grc.step_rc.fc.clock.R i ⟨0, by omega⟩ -
            grc.step_rc.fc.clock.R (step_b0 grc) ⟨0, by omega⟩ -
            (grc.step_rc.fc.clock.G (step_b0 grc) i + grc.step_rc.fc.clock.v i)|)
          (fun i _ => abs_nonneg _) (Finset.mem_univ i)
        have h2 := le_abs_self (grc.step_rc.fc.clock.R i ⟨0, by omega⟩ -
            grc.step_rc.fc.clock.R (step_b0 grc) ⟨0, by omega⟩ -
            (grc.step_rc.fc.clock.G (step_b0 grc) i + grc.step_rc.fc.clock.v i))
        change _ ≤ Kgv at h1
        linarith
      hH0 := hH0'1
      u := u'
      hu0 := hu0'
      hui := hui'
      hell := hell'
      hJ_subdiag := hJsub'
      a_old := a'
      ha_pos := ha'pos
      hP_inr := hPinr'
      hP_inl := hPinl'
      eps := eps'
      C_bundle := Cfn eps'
      hC_nonneg := hCspec.1
      heps := heps_le
      h_active := fun q k hk => hCspec.2 c' H0' (1 / 2) q k hk
      h_gw_margin := by rw [ha_gw]; linarith }
    hasSuffix := hsuf'
    h_len := hlen'
    hCGC := B.step_CGC
    m_alpha := m'
    halpha := rfl
    hzeta_int := hzeta_int'
    hm := by
      change grc.step_rc.fc.clock.m = (w + 1 + 1) ^ 2 - 6
      have hbw := B.L.hw
      have hbm := B.hm
      have hsq : (w + 1 + 1) ^ 2 = (w + 1) ^ 2 + 2 * (w + 1) + 1 := by ring
      have h6 : 6 ≤ (w + 1) ^ 2 := by nlinarith
      omega }⟩

end GroundedClockBundle

/-! ## The tower and the unconditional realized clock -/

/-- The inductive step: every grounded clock bundle at width `w` lifts to one at width `w + 1`. -/
noncomputable def GroundedClockBundle.next {w : ℕ} (B : GroundedClockBundle w) :
    GroundedClockBundle (w + 1) :=
  Classical.choice B.next_nonempty

/-- The tower of grounded clock bundles, starting from the RPS base case at width `2`. -/
noncomputable def groundedBundleTower : (d : ℕ) → GroundedClockBundle (d + 2)
  | 0 => rpsGroundedBundle
  | d + 1 => (groundedBundleTower d).next

/-- An unconditional realized clock at every width `k ≥ 2`. -/
noncomputable def unconditionalRealizedClock (k : ℕ) (hk : 2 ≤ k) : RealizedClock k :=
  (Nat.sub_add_cancel hk) ▸ (groundedBundleTower (k - 2)).L.rc

theorem realizedClock_nonempty (k : ℕ) (hk : 2 ≤ k) : Nonempty (RealizedClock k) :=
  ⟨unconditionalRealizedClock k hk⟩

theorem unconditionalRealizedClock_m (k : ℕ) (hk : 2 ≤ k) :
    (unconditionalRealizedClock k hk).fc.clock.m = (k + 1) ^ 2 - 6 := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le' hk
  simpa [unconditionalRealizedClock] using (groundedBundleTower d).hm

/-- **Unconditional all-orders Karlin theorem**: for every order `k ≥ 2` there is a realized clock
    whose skew-symmetric game has a unique (tie-free) fictitious-play trajectory with duality gap
    `Θ(t^{-1/k})`. -/
theorem unconditional_karlin_theorem (k : ℕ) (hk : 2 ≤ k) :
    ∃ (rc : RealizedClock k),
      rc.fc.clock.m = (k + 1) ^ 2 - 6 ∧
      Fintype.card (Option (Fin rc.fc.clock.m)) = (k + 1) ^ 2 - 5 ∧
      IsSkewSymmetric rc.gameMatrix ∧
      rc.fc.clock.C.transpose * rc.fc.L_C = 1 ∧
      rc.trajectory 0 = none ∧
      IsStrictFPTrajectory rc.gameMatrix rc.trajectory ∧
      IsStrictTwoPlayerFPTrajectory rc.gameMatrix rc.trajectory rc.trajectory ∧
      (∀ rowPlay colPlay : ℕ → Option (Fin rc.fc.clock.m),
        IsWeakTwoPlayerFPTrajectory rc.gameMatrix rowPlay colPlay →
        rowPlay 0 = none → colPlay 0 = none →
        ∀ t : ℕ, rowPlay t = rc.trajectory t ∧ colPlay t = rc.trajectory t) ∧
      0 < rc.c_low ∧
      0 < rc.c_high ∧
      (∀ t : ℕ, 1 ≤ t →
        rc.c_low ≤
          standardDualityGap rc.gameMatrix rc.trajectory rc.trajectory t ^ k * (t : ℚ) ∧
        standardDualityGap rc.gameMatrix rc.trajectory rc.trajectory t ^ k * (t : ℚ) ≤
          rc.c_high) := by
  let rc := unconditionalRealizedClock k hk
  have hm : rc.fc.clock.m = (k + 1) ^ 2 - 6 := unconditionalRealizedClock_m k hk
  have hcard : Fintype.card (Option (Fin rc.fc.clock.m)) = (k + 1) ^ 2 - 5 := by
    rw [Fintype.card_option, Fintype.card_fin, hm]
    have h6 : 6 ≤ (k + 1) ^ 2 := by nlinarith
    omega
  exact ⟨rc, hm, hcard, rc.gameMatrix_skew, rc.fc.hLC, rc.htraj_zero, rc.hstrict, rc.isStrictTwoPlayerFP,
    rc.unique_trajectory, rc.hc_low_pos, rc.hc_high_pos, rc.hgap_bounds⟩


end Karlin

