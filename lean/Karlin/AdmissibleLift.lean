/-- Count vector of  matches  with . -/
theorem wordCountVec_rawFourStageWord_M {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (q : ℕ) :
    wordCountVec (rawFourStageWord_M clock parentWord M_nat q) =
      (liftedCountMat (X_gateway clock) (M_of_nat M_nat) (N_mat (w + 1))).mulVec (binomBasis (w + 1) q) := by
  ext x
  cases x with
  | inr r =>
    simp only [rawFourStageWord_M, wordCountVec_append, liftedCountMat,
      Matrix.mulVec, dotProduct]
    have hAB : wordCountVec (W_early_word_M clock.m w M_nat q) (Sum.inr r) +
        wordCountVec (W_late_word_M clock.m w M_nat q) (Sum.inr r) =
        wordCountVec (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q) (Sum.inr r) := by
      rw [wordCountVec_append]
    have hreset := wordCountVec_reset_stages_M_inr clock.m w q M_nat r
    rw [hAB, hreset]
    have hnone1 : ∀ y ∈ (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w),
        y ≠ Sum.inr r := by
      intro y hy h
      simp only [List.mem_map] at hy
      rcases hy with ⟨j, _, rfl⟩
      contradiction
    have hcount1 : wordCountVec ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)) (Sum.inr r) = 0 := by
      unfold wordCountVec
      rw [list_count_eq_zero_of_forall_ne hnone1]
      rfl
    have hnone2 : ∀ y ∈ [gatewayToLiftedAct clock.m w], y ≠ Sum.inr r := by
      intro y hy h
      simp only [List.mem_singleton] at hy
      subst hy
      contradiction
    have hcount2 : wordCountVec [gatewayToLiftedAct clock.m w] (Sum.inr r) = 0 := by
      unfold wordCountVec
      rw [list_count_eq_zero_of_forall_ne hnone2]
