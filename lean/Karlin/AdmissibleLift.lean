/-!
## Section 30_M: Uniform Algebraic & Full-Rank Clock Lift for General M
-/

def P_uniform_M {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  P_uniform_interp hw clock b c_step H0 delta (M_of_nat M_nat) R_M J zeta P0 L_C

theorem P_uniform_M_mul_M {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hRM : R_M * (M_of_nat M_nat) = 1)
    (hMJM : (M_of_nat M_nat).transpose * J * (M_of_nat M_nat) = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row (M_of_nat M_nat)).transpose * psi_row zeta (B_mat (w + 1))) :
    (P_uniform_M hw clock b c_step H0 delta M_nat R_M J zeta P0 L_C) * (M_of_nat M_nat) =
      (S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta) * N_mat (w + 1) -
      (AdjoinLeaderEndpointG clock.G b clock.v) * X_gateway clock :=
  P_uniform_interp_mul_M hw clock b c_step H0 delta (M_of_nat M_nat) R_M J E zeta P0 L_C hRM hMJM hmoment

theorem P_uniform_M_transpose_mul_X {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1) :
    (P_uniform_M hw clock b c_step H0 delta M_nat R_M J zeta P0 L_C).transpose * X_gateway clock =
      Q_reset J (M_of_nat M_nat) (B_mat (w + 1)) zeta :=
  P_uniform_interp_transpose_mul_X hw clock b c_step H0 delta (M_of_nat M_nat) R_M J zeta P0 L_C hLC

def L_C_uniform_next_M {w : ℕ} (clock : AlgebraicClock w)
    (_M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ) :
    Matrix (Fin ((clock.m + 1) + ((w + 1) + (w + 1)))) (Fin (w + 1)) ℚ :=
  Matrix.of fun x c =>
    match (rotLeaderEquiv (clock.m + 1) ((w + 1) + (w + 1))).symm x with
    | Sum.inl _ => 0
    | Sum.inr r => R_M c r

def uniformFullRankLift_M {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (hRM : R_M * (M_of_nat M_nat) = 1)
    (hMJM : (M_of_nat M_nat).transpose * J * (M_of_nat M_nat) = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_of_nat M_nat)).transpose * psi_row zeta (B_mat (w + 1))) :
    FullRankClock (w + 1) where
  clock :=
    let G_O := AdjoinLeaderEndpointG fc.clock.G b fc.clock.v
    let P := P_uniform_M hw fc.clock b c_step H0 delta M_nat R_M J zeta P0 fc.L_C
    let S := S_uniform (by omega) fc.clock b (h_uniform fc.clock b (zeta_canonical (by omega) fc.clock b c_step H0) c_step) delta
    let X := X_gateway fc.clock
    let M := M_of_nat M_nat
    let B := B_mat (w + 1)
    let v_old := v_old_coupled fc.clock.m
    let v_reset : Fin ((w + 1) + (w + 1)) → ℚ := 0
    let aP_old : Fin (fc.clock.m + 1) → ℚ := fun _ => 1
    let aP_reset : Fin ((w + 1) + (w + 1)) → ℚ := fun _ => 1
    AlgebraicClock.ofEquiv (rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1)))
      (liftedGameMat G_O P J)
      (liftedScoreMat G_O J S X M zeta)
      (liftedCountMat X M (N_mat (w + 1)))
      (liftedWeightVec v_old v_reset)
      (liftedWeightVec aP_old aP_reset)
      (liftedGameMat_skew G_O P J (AdjoinLeaderEndpointG_skew fc.clock.G b fc.clock.v fc.clock.hskew))
      (liftedGameMat_mul_liftedCountMat G_O P J S X M B (N_mat (w + 1)) zeta
        (B_mat_mul_one_add_N (w + 1))
        (P_uniform_M_transpose_mul_X hw fc.clock b c_step H0 delta M_nat R_M J zeta P0 fc.L_C fc.hLC)
        (P_uniform_M_mul_M hw fc.clock b c_step H0 delta M_nat R_M J E zeta P0 fc.L_C hRM hMJM hmoment))
      (by
        have hcal := coupled_weight_calibration fc.clock
        have h0 : Matrix.vecMul v_reset M = 0 := by
          ext c; simp [Matrix.vecMul, dotProduct, v_reset]
        have h0_c : Matrix.vecMul (0 : Fin ((w + 1) + (w + 1)) → ℚ) (M_coupled w) = 0 := by
          ext c; simp [Matrix.vecMul, dotProduct]
        have hw_cal : Matrix.vecMul v_old (X * (1 + N_mat (w + 1))) + Matrix.vecMul v_reset M = e0_row (w + 1) := by
          rw [h0, add_zero]
          rw [h0_c, add_zero] at hcal
          exact hcal
        exact liftedWeightVec_mul_liftedCountMat X M v_old v_reset hw_cal)
      (fun s => by
        cases s with
        | inl _ => exact zero_lt_one
        | inr _ => exact zero_lt_one)
  L_C := L_C_uniform_next_M fc.clock M_nat R_M
  hLC := by
    ext c1 c2
    simp only [Matrix.mul_apply, Matrix.transpose_apply]
    change ∑ x : Fin ((fc.clock.m + 1) + ((w + 1) + (w + 1))),
      (liftedCountMat (X_gateway fc.clock) (M_of_nat M_nat) (N_mat (w + 1)))
        ((rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1))).symm x) c1 *
        (L_C_uniform_next_M fc.clock M_nat R_M) x c2 =
      (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) c1 c2
    rw [(Equiv.sum_comp (rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1))) fun y =>
      (liftedCountMat (X_gateway fc.clock) (M_of_nat M_nat) (N_mat (w + 1)))
        ((rotLeaderEquiv (fc.clock.m + 1) ((w + 1) + (w + 1))).symm y) c1 *
        (L_C_uniform_next_M fc.clock M_nat R_M) y c2).symm]
    rw [Fintype.sum_sum_type]
    simp only [liftedCountMat, L_C_uniform_next_M, Matrix.of_apply, Equiv.symm_apply_apply,
      mul_zero, Finset.sum_const_zero, zero_add]
    have hRM_apply := congr_fun (congr_fun hRM c2) c1
    simp only [Matrix.mul_apply, Matrix.one_apply, eq_comm, M_of_nat, Matrix.of_apply] at hRM_apply ⊢
    simpa [mul_comm] using hRM_apply

theorem uniformFullRankLift_M_m {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step H0 delta : ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
