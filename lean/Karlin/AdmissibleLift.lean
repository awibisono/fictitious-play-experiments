    (h_uniform fc.clock b (gZeta hw fc b c_step H0) c_step) (1 / 2) (W_bundle_word parentWord (q + 1)) q k
  have hscore_b := wordScore_bundle_take_parentToOldAct_uniform hw1 fc.clock b
    (h_uniform fc.clock b (gZeta hw fc b c_step H0) c_step) (1 / 2) (W_bundle_word parentWord (q + 1)) q k b
  have hscore_k := wordScore_bundle_take_parentToOldAct_uniform hw1 fc.clock b
    (h_uniform fc.clock b (gZeta hw fc b c_step H0) c_step) (1 / 2) (W_bundle_word parentWord (q + 1)) q k
    ((W_bundle_word parentWord (q + 1))[k]'hk)
  have h_act_dom : wordScore fc.clock.G (fc.clock.R.mulVec (binomBasis w 0))
      ((W_bundle_word parentWord (q + 1)).take k) b ≤
      wordScore fc.clock.G (fc.clock.R.mulVec (binomBasis w 0))
        ((W_bundle_word parentWord (q + 1)).take k) ((W_bundle_word parentWord (q + 1))[k]'hk) := by
    have h_bundle_p := isValidPriorityWord_bundle_word fc.clock parentWord parent_rank hparent_count
      hparent_valid 0 (q + 1)
    have h0 : (fun i => fc.clock.R.mulVec (binomBasis w 0) i + 0) = fc.clock.R.mulVec (binomBasis w 0) := by
      ext i; ring
    rw [h0] at h_bundle_p
    exact (h_bundle_p k hk b).1
  have h_v_full : ∀ σ : ℕ, dotProduct fc.clock.v (wordCountVec (parentWord σ)) = 1 := by
    intro σ
