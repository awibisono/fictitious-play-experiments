      (wordScore (liftedGameMat G_O P J) s0 (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q))
      (paperPriorityRank clock.m w parent_rank)
      ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)))
    (h_gw : ∀ y : Fin (clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
      y ≠ gatewayToLiftedAct clock.m w →
      wordScore (liftedGameMat G_O P J) s0
        (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q ++
          ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w))) y <
