      Matrix.mulVec, dotProduct]
    have hAB : wordCountVec (W_early_word_M clock.m w M_nat q) (Sum.inl u) +
        wordCountVec (W_late_word_M clock.m w M_nat q) (Sum.inl u) =
        wordCountVec (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q) (Sum.inl u) := by
      rw [wordCountVec_append]
