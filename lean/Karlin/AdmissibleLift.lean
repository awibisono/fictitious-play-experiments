open scoped Matrix

/-!
# Bridge Theorems: RPS Base Case and Inductive Step Preservation

This module formalizes:
1. RPS Base Case word and phase-start leader obligations (w = 2):
   - `rps_leader_dom_all`: phase-start leader dominance across all phases `σ : ℕ`.
   - `rps_R_nonneg`: nonnegativity of `clock.R b_rps c`.
   - `rps_R_pos`: strict positivity of `clock.R b_rps c`.
   - `rps_R_top`: top-degree score entry `clock.R b_rps ⟨2 - 1, _⟩ = 1`.
   - `rps_phaseWord_count`: play-count vector matches `clock.C · binomBasis 2 σ`.
   - `rps_phaseWord_priority_valid`: validity of `rpsPhaseWord σ` under priority order.

2. Inductive Positivity and Top Entry Preservation (w + 1):
   - `zeta_canonical_nonneg`: coordinate-wise nonnegativity from `H0 ≥ 0`, `c_step ≥ 0`, `clock.R b ≥ 0`.
   - `zeta_canonical_pos`: coordinate-wise strict positivity from `H0 > 0`, `c_step > 0`, `clock.R b > 0`.
   - `zeta_canonical_top_eq_one`: top entry equals 1 when parent clock leader top entry equals 1.

3. Simultaneous Parity and Lower-Bound Calibration:
   - `exists_parity_aligned_c_step_H0`: simultaneous calibration of `k_step`, `k_H0`, `c_step`, `H0`
     satisfying exact 3-scaled parity equations and arbitrary lower bounds `C_min ≤ c_step`, `H_min ≤ H0`.

4. Gap-Bound Discharge Lemmas for Uniform Lift:
   - `zeta_canonical_dot_binomBasis_nonneg`: nonnegativity of `zeta_canonical · binomBasis (w + 1) q`.
   - `zeta_canonical_dot_binomBasis_ge_one_add_choose`: `1 + choose q w ≤ zeta_canonical · binomBasis (w + 1) q`.
   - `rawFourStageWord_M_length_ge_choose`: `choose q w ≤ length (rawFourStageWord_M ...)`.
-/

/-!
## 1. RPS Base Case Obligations (w = 2)
-/

/-- Phase-start leader dominance for RPS clock across all phases `σ : ℕ`. -/
theorem rps_leader_dom_all (σ : ℕ) (i : Fin rpsFullRankClock.clock.m) :
    (rpsFullRankClock.clock.R.mulVec (binomBasis 2 σ)) i ≤
      (rpsFullRankClock.clock.R.mulVec (binomBasis 2 σ)) b_rps :=
  rpsAlgebraicClock_leader_zero_dom σ i

/-- Nonnegativity of RPS leader score row `R(b_rps, c) ≥ 0`. -/
theorem rps_R_nonneg (c : Fin 2) :
    0 ≤ rpsFullRankClock.clock.R b_rps c := by
  fin_cases c
  · simp [b_rps, rpsFullRankClock, rpsAlgebraicClock, R2]
  · simp [b_rps, rpsFullRankClock, rpsAlgebraicClock, R2]

/-- Strict positivity of RPS leader score row `R(b_rps, c) > 0`. -/
theorem rps_R_pos (c : Fin 2) :
    0 < rpsFullRankClock.clock.R b_rps c := by
  fin_cases c
  · simp [b_rps, rpsFullRankClock, rpsAlgebraicClock, R2]
  · simp [b_rps, rpsFullRankClock, rpsAlgebraicClock, R2]

/-- Top-degree score entry of RPS leader equals 1. -/
theorem rps_R_top :
    rpsFullRankClock.clock.R b_rps ⟨2 - 1, by omega⟩ = 1 := by
  simp [b_rps, rpsFullRankClock, rpsAlgebraicClock, R2]

/-- Exact play-count vector of `rpsPhaseWord σ` matches `rpsFullRankClock.clock.C.mulVec (binomBasis 2 σ)`. -/
theorem rps_phaseWord_count (σ : ℕ) :
    wordCountVec (rpsPhaseWord σ) = rpsFullRankClock.clock.C.mulVec (binomBasis 2 σ) :=
  wordCountVec_rpsPhaseWord σ

/-- Priority validity of `rpsPhaseWord σ` for any rank function. -/
theorem rps_phaseWord_priority_valid (σ : ℕ) (rank : Fin 3 → Fin 3) :
    IsValidPriorityWord rpsFullRankClock.clock.G (rpsFullRankClock.clock.R.mulVec (binomBasis 2 σ))
      rank (rpsPhaseWord σ) :=
  isValidPriorityWord_rpsPhaseWord σ rank

/-!
## 2. Inductive Positivity Preservation and Top Entry
-/

/-- Coordinate-wise nonnegativity of `zeta_canonical` from nonnegativity of `H0`, `c_step`, and `clock.R b`. -/
theorem zeta_canonical_nonneg {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) (hH0 : 0 ≤ H0) (hc_step : 0 ≤ c_step)
    (hR : ∀ c : Fin w, 0 ≤ clock.R b c) :
    ∀ c : Fin (w + 1), 0 ≤ zeta_canonical (by omega) clock b c_step H0 c := by
  intro c
  by_cases hc0 : c.val = 0
  · have heq0 : c = 0 := Fin.ext hc0
    subst heq0
    rw [zeta_canonical_zero (by omega)]
    exact hH0
  · by_cases hc1 : c.val = 1
    · have heq1 : c = ⟨1, by omega⟩ := Fin.ext hc1
      rw [heq1, zeta_canonical_one hw]
      have := hR ⟨1, by omega⟩
      linarith
    · by_cases hcw : c.val < w
      · have hc2 : 2 ≤ c.val := by omega
        rw [zeta_canonical_ge_two_lt hw clock b c_step H0 c hc2 hcw]
        have h1 := hR ⟨c.val - 1, by omega⟩
        have h2 := hR ⟨c.val, hcw⟩
        linarith
      · have hc_val : c.val = w := by have := c.isLt; omega
        have hc_top : c = ⟨w, Nat.lt_succ_self w⟩ := Fin.ext hc_val
        rw [hc_top, zeta_canonical_top hw]
        exact hR ⟨w - 1, by omega⟩

/-- Coordinate-wise strict positivity of `zeta_canonical` from positivity of `H0`, `c_step`, and `clock.R b`. -/
theorem zeta_canonical_pos {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) (hH0 : 0 < H0) (hc_step : 0 < c_step)
    (hR : ∀ c : Fin w, 0 < clock.R b c) :
    ∀ c : Fin (w + 1), 0 < zeta_canonical (by omega) clock b c_step H0 c := by
  intro c
  by_cases hc0 : c.val = 0
  · have heq0 : c = 0 := Fin.ext hc0
    subst heq0
    rw [zeta_canonical_zero (by omega)]
    exact hH0
  · by_cases hc1 : c.val = 1
    · have heq1 : c = ⟨1, by omega⟩ := Fin.ext hc1
      rw [heq1, zeta_canonical_one hw]
      have := hR ⟨1, by omega⟩
      linarith
    · by_cases hcw : c.val < w
      · have hc2 : 2 ≤ c.val := by omega
        rw [zeta_canonical_ge_two_lt hw clock b c_step H0 c hc2 hcw]
        have h1 := hR ⟨c.val - 1, by omega⟩
        have h2 := hR ⟨c.val, hcw⟩
        linarith
      · have hc_val : c.val = w := by have := c.isLt; omega
        have hc_top : c = ⟨w, Nat.lt_succ_self w⟩ := Fin.ext hc_val
        rw [hc_top, zeta_canonical_top hw]
        exact hR ⟨w - 1, by omega⟩

/-- Preservation of top-degree score entry 1 for `zeta_canonical`. -/
theorem zeta_canonical_top_eq_one {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) (hb_top : clock.R b ⟨w - 1, by omega⟩ = 1) :
    zeta_canonical (by omega) clock b c_step H0 ⟨w, Nat.lt_succ_self w⟩ = 1 := by
  rw [zeta_canonical_top hw, hb_top]

/-!
## 3. Simultaneous Parity and Lower-Bound Calibration
-/

/-- Existence of integers `k_step` and `k_H0` and rational parameters `c_step` and `H0`
    satisfying the exact 3-scaled parity equations and arbitrary lower bounds `C_min`, `H_min`. -/
theorem exists_parity_aligned_c_step_H0 (colsum_0 : ℤ) (C_min H_min : ℚ) :
    ∃ (k_step k_H0 : ℤ) (c_step H0 : ℚ),
      3 * c_step = (colsum_0 : ℚ) + 2 * (k_step : ℚ) ∧
      3 * H0 = 1 + (colsum_0 : ℚ) + 2 * (k_H0 : ℚ) ∧
      C_min ≤ c_step ∧
      0 < c_step ∧
      H_min ≤ H0 ∧
      0 < H0 := by
  let target_step := max C_min 1
  let target_H0 := max H_min 1
  let k_step : ℤ := ⌈(3 * target_step - (colsum_0 : ℚ)) / 2⌉
  let k_H0 : ℤ := ⌈(3 * target_H0 - 1 - (colsum_0 : ℚ)) / 2⌉
  let c_step : ℚ := ((colsum_0 : ℚ) + 2 * (k_step : ℚ)) / 3
  let H0 : ℚ := (1 + (colsum_0 : ℚ) + 2 * (k_H0 : ℚ)) / 3
  have hc_eq : 3 * c_step = (colsum_0 : ℚ) + 2 * (k_step : ℚ) := by
    dsimp [c_step]; ring
  have hH_eq : 3 * H0 = 1 + (colsum_0 : ℚ) + 2 * (k_H0 : ℚ) := by
    dsimp [H0]; ring
  have hk_step_le : (3 * target_step - (colsum_0 : ℚ)) / 2 ≤ (k_step : ℚ) :=
    Int.le_ceil _
  have hk_H0_le : (3 * target_H0 - 1 - (colsum_0 : ℚ)) / 2 ≤ (k_H0 : ℚ) :=
    Int.le_ceil _
  have hc_step_ge : target_step ≤ c_step := by
    dsimp [c_step]
    linarith
  have hH0_ge : target_H0 ≤ H0 := by
    dsimp [H0]
    linarith
  have hC_min_le : C_min ≤ c_step := le_trans (le_max_left C_min 1) hc_step_ge
  have hc_pos : 0 < c_step := lt_of_lt_of_le (by norm_num) (le_trans (le_max_right C_min 1) hc_step_ge)
  have hH_min_le : H_min ≤ H0 := le_trans (le_max_left H_min 1) hH0_ge
  have hH_pos : 0 < H0 := lt_of_lt_of_le (by norm_num) (le_trans (le_max_right H_min 1) hH0_ge)
  exact ⟨k_step, k_H0, c_step, H0, hc_eq, hH_eq, hC_min_le, hc_pos, hH_min_le, hH_pos⟩

/-!
## 4. Gap-Bound Discharge Lemmas for Uniform Lift
-/

/-- Nonnegativity of inner product `zeta_canonical · binomBasis (w + 1) q`. -/
theorem zeta_canonical_dot_binomBasis_nonneg {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 : ℚ) (hH0 : 0 ≤ H0) (hc_step : 0 ≤ c_step)
    (hR : ∀ c : Fin w, 0 ≤ clock.R b c) (q : ℕ) :
    0 ≤ dotProduct (zeta_canonical (by omega) clock b c_step H0) (binomBasis (w + 1) q) := by
  dsimp [dotProduct]
  refine Finset.sum_nonneg (fun c _ => ?_)
  have hzeta := zeta_canonical_nonneg hw clock b c_step H0 hH0 hc_step hR c
  have hbinom : 0 ≤ binomBasis (w + 1) q c := by
    unfold binomBasis
    positivity
  exact mul_nonneg hzeta hbinom

/-- Lower bound `1 + choose q w ≤ zeta_canonical · binomBasis (w + 1) q` under `1 ≤ H0`. -/
theorem zeta_canonical_dot_binomBasis_ge_one_add_choose {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 : ℚ) (hH0 : 1 ≤ H0) (hc_step : 0 ≤ c_step)
    (hR : ∀ c : Fin w, 0 ≤ clock.R b c) (hb_top : clock.R b ⟨w - 1, by omega⟩ = 1) (q : ℕ) :
    1 + (Nat.choose q w : ℚ) ≤ dotProduct (zeta_canonical (by omega) clock b c_step H0) (binomBasis (w + 1) q) := by
  dsimp [dotProduct]
  let c0 : Fin (w + 1) := 0
  let cw : Fin (w + 1) := ⟨w, Nat.lt_succ_self w⟩
  have hc0_ne_cw : c0 ≠ cw := by
    intro h
    have hval : c0.val = cw.val := congr_arg Fin.val h
    dsimp [c0, cw] at hval
    omega
  have hc0_univ : c0 ∈ Finset.univ := Finset.mem_univ c0
  have hcw_erase : cw ∈ Finset.univ.erase c0 := by
    rw [Finset.mem_erase]
    exact ⟨Ne.symm hc0_ne_cw, Finset.mem_univ cw⟩
  rw [← Finset.add_sum_erase Finset.univ _ hc0_univ]
  rw [← Finset.add_sum_erase (Finset.univ.erase c0) _ hcw_erase]
  have hzeta_nonneg : ∀ c : Fin (w + 1), 0 ≤ zeta_canonical (by omega) clock b c_step H0 c :=
    zeta_canonical_nonneg hw clock b c_step H0 (by linarith) hc_step hR
  have hrem : 0 ≤ ∑ x ∈ (Finset.univ.erase c0).erase cw,
      zeta_canonical (by omega) clock b c_step H0 x * binomBasis (w + 1) q x := by
    refine Finset.sum_nonneg (fun c _ => ?_)
    have h1 := hzeta_nonneg c
    have h2 : 0 ≤ binomBasis (w + 1) q c := by unfold binomBasis; positivity
    exact mul_nonneg h1 h2
  have h_c0_val : zeta_canonical (by omega) clock b c_step H0 c0 * binomBasis (w + 1) q c0 = H0 := by
    dsimp [c0]
    rw [zeta_canonical_zero (by omega)]
    unfold binomBasis
    simp only [Fin.val_zero, Nat.choose_zero_right, Nat.cast_one, mul_one]
  have h_cw_val : zeta_canonical (by omega) clock b c_step H0 cw * binomBasis (w + 1) q cw = (Nat.choose q w : ℚ) := by
    dsimp [cw]
    rw [zeta_canonical_top_eq_one hw clock b c_step H0 hb_top]
    unfold binomBasis
    simp only [one_mul]
  rw [h_c0_val, h_cw_val]
  linarith

/-- Count of reset action in four-stage raw word under general reset matrix `M_nat`. -/
theorem wordCountVec_rawFourStageWord_M_inr {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (q : ℕ) (r : Fin ((w + 1) + (w + 1))) :
    wordCountVec (rawFourStageWord_M clock parentWord M_nat q) (Sum.inr r) =
      (resetStepCount_M M_nat r q : ℚ) := by
  simp only [rawFourStageWord_M, wordCountVec_append]
  have hAB : wordCountVec (W_early_word_M clock.m w M_nat q) (Sum.inr r) +
      wordCountVec (W_late_word_M clock.m w M_nat q) (Sum.inr r) =
      wordCountVec (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q) (Sum.inr r) := by
    rw [wordCountVec_append]
  have hreset := wordCountVec_reset_stages_M_inr clock.m w q M_nat r
  rw [hAB, hreset]
  have hnone1 : ∀ y ∈ (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w),
      y ≠ Sum.inr r := by
    intro y hy h
    simp only [List.mem_map] at hy
    rcases hy with ⟨j, _, rfl⟩
    contradiction
  have hcount1 : wordCountVec ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)) (Sum.inr r) = 0 := by
    unfold wordCountVec
    rw [list_count_eq_zero_of_forall_ne hnone1]
    rfl
  have hnone2 : ∀ y ∈ [gatewayToLiftedAct clock.m w], y ≠ Sum.inr r := by
    intro y hy h
    simp only [List.mem_singleton] at hy
    subst hy
    contradiction
  have hcount2 : wordCountVec [gatewayToLiftedAct clock.m w] (Sum.inr r) = 0 := by
    unfold wordCountVec
    rw [list_count_eq_zero_of_forall_ne hnone2]
    rfl
  rw [hcount1, hcount2, add_zero, add_zero]
  exact (resetStepCount_M_cast M_nat r q).symm

/-- Lower bound on `resetStepCount_M` by `choose q w` whenever column `w` has entry `≥ 1`. -/
theorem resetStepCount_M_ge_choose {w : ℕ}
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (r : Fin ((w + 1) + (w + 1)))
    (hr : 1 ≤ M_nat r ⟨w, Nat.lt_succ_self w⟩)
    (q : ℕ) :
    Nat.choose q w ≤ resetStepCount_M M_nat r q := by
  unfold resetStepCount_M
  let cw : Fin (w + 1) := ⟨w, Nat.lt_succ_self w⟩
  have hcw_univ : cw ∈ Finset.univ := Finset.mem_univ cw
  have h_single : M_nat r cw * Nat.choose q cw.val ≤
      ∑ c : Fin (w + 1), M_nat r c * Nat.choose q c.val :=
    Finset.single_le_sum (fun (c : Fin (w + 1)) _ => Nat.zero_le (M_nat r c * Nat.choose q c.val)) hcw_univ
  have hcw_val : cw.val = w := rfl
  rw [hcw_val] at h_single
  have h_mul : Nat.choose q w ≤ M_nat r cw * Nat.choose q w := by
    calc Nat.choose q w = 1 * Nat.choose q w := (one_mul _).symm
      _ ≤ M_nat r cw * Nat.choose q w := Nat.mul_le_mul_right (Nat.choose q w) hr
  exact le_trans h_mul h_single

/-- Lower bound on four-stage raw word length by binomial coefficient `choose q w`. -/
theorem rawFourStageWord_M_length_ge_choose {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (r : Fin ((w + 1) + (w + 1)))
    (hr : 1 ≤ M_nat r ⟨w, Nat.lt_succ_self w⟩)
    (q : ℕ) :
    (Nat.choose q w : ℚ) ≤ ((rawFourStageWord_M clock parentWord M_nat q).length : ℚ) := by
  let W := rawFourStageWord_M clock parentWord M_nat q
  have h_len := list_length_eq_sum_wordCountVec W
  have h_inr_le : wordCountVec W (Sum.inr r) ≤ ∑ x, wordCountVec W x := by
    refine Finset.single_le_sum (fun x _ => ?_) (Finset.mem_univ (Sum.inr r))
    unfold wordCountVec
    positivity
  have h_inr_count : wordCountVec W (Sum.inr r) = (resetStepCount_M M_nat r q : ℚ) :=
    wordCountVec_rawFourStageWord_M_inr clock parentWord M_nat q r
  rw [h_inr_count] at h_inr_le
  rw [← h_len] at h_inr_le
  have h_ge := resetStepCount_M_ge_choose M_nat r hr q
  have h_ge_q : (Nat.choose q w : ℚ) ≤ (resetStepCount_M M_nat r q : ℚ) := by
    exact_mod_cast h_ge
  exact le_trans h_ge_q h_inr_le


/-!
## 5. Exact Chronology Score Evaluation for Uniform Lift
-/
theorem S_add_GO_X_gateway_apply {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (h : Fin (w + 1) → ℚ) (delta : ℚ) (c : Fin (w + 1)) :
    let S := S_uniform hw clock b h delta
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let X := X_gateway clock
    (S + G_O * X) (gatewayOldAct clock.m) c =
      h c + (clock.G * shiftRightCount clock.C) b c + (if c.val = 0 then clock.R b ⟨0, hw⟩ + delta else 0) := by
  intro S G_O X
  rw [Matrix.add_apply]
  have hg : gatewayOldAct clock.m = finSumFinEquiv (Sum.inr (0 : Fin 1)) := rfl
  rw [hg]
  dsimp only [S, S_uniform]
  rw [Matrix.of_apply]
  simp only [Equiv.symm_apply_apply]
  rw [GO_mul_X_inr_apply]
  by_cases hc0 : c.val = 0
  · simp only [hc0, ↓reduceIte]
    have he1 : e1_row (w + 1) c = 0 := by simp [e1_row, hc0]
    have hshift0 : (clock.G * shiftRightCount clock.C) b c = 0 :=
      mul_shiftRightCount_zero clock.G clock.C b c hc0
    rw [he1, hshift0]
    have h01 : ¬ ((0 : ℕ) = 1) := by decide
    rw [if_neg h01, sub_zero]
    ring
  · simp only [hc0, ↓reduceIte]
    by_cases hc1 : c.val = 1
    · have he1 : e1_row (w + 1) c = 1 := by simp [e1_row, hc1]
      simp only [hc1, ↓reduceIte, he1]
      ring
    · have he1 : e1_row (w + 1) c = 0 := by simp [e1_row, hc1]
      simp only [hc1, ↓reduceIte, sub_zero, he1, add_zero]
      ring

theorem dotProduct_h_uniform_binomBasis {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (zeta : Fin (w + 1) → ℚ) (c_step : ℚ) (q : ℕ) :
    dotProduct (h_uniform clock b zeta c_step) (binomBasis (w + 1) q) =
      dotProduct zeta (binomBasis (w + 1) q) - (clock.R.mulVec (binomBasis w q)) b - c_step := by
  dsimp [h_uniform, dotProduct]
  have hsplit : (∑ c : Fin (w + 1),
      (zeta c - (if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0) -
        (if c.val = 0 then c_step else 0)) * binomBasis (w + 1) q c) =
    (∑ c : Fin (w + 1), zeta c * binomBasis (w + 1) q c) -
    (∑ c : Fin (w + 1), (if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0) * binomBasis (w + 1) q c) -
    (∑ c : Fin (w + 1), (if c.val = 0 then c_step else 0) * binomBasis (w + 1) q c) := by
    simp_rw [sub_mul]
    rw [Finset.sum_sub_distrib, Finset.sum_sub_distrib]
  rw [hsplit]
  have h_Rb : (∑ c : Fin (w + 1), (if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0) * binomBasis (w + 1) q c) =
      clock.R.mulVec (binomBasis w q) b := by
    simp only [Matrix.mulVec, dotProduct]
    have heq_sum := (Fin.sum_univ_castSucc (fun c : Fin (w + 1) =>
      (if hc : c.val < w then clock.R b ⟨c.val, hc⟩ else 0) * binomBasis (w + 1) q c)).symm
    rw [← heq_sum]
    have h_last : ((if hc : (Fin.last w).val < w then clock.R b ⟨(Fin.last w).val, hc⟩ else 0) *
        binomBasis (w + 1) q (Fin.last w)) = 0 := by
      have hnot : ¬ ((Fin.last w).val < w) := by
        simp only [Fin.val_last, lt_self_iff_false, not_false_eq_true]
      simp only [hnot, ↓reduceDIte, zero_mul]
    rw [h_last, add_zero]
    refine Finset.sum_congr rfl fun c _ => ?_
    have hc_lt : (Fin.castSucc c).val < w := c.isLt
    simp only [hc_lt, ↓reduceDIte]
    rfl
  have h_cstep : (∑ c : Fin (w + 1), (if c.val = 0 then c_step else 0) * binomBasis (w + 1) q c) = c_step := by
    rw [Finset.sum_eq_single ⟨0, by omega⟩]
    · simp only [↓reduceIte, binomBasis, Nat.choose_zero_right]
      ring
    · intro c _ hc
      have hne : c.val ≠ 0 := by intro h; apply hc; ext; exact h
      simp [hne]
    · intro h; exact False.elim (h (Finset.mem_univ _))
  rw [h_Rb, h_cstep]

theorem shiftRightCount_mulVec_binomBasis_diff {α : Type*} {w : ℕ} (R : Matrix α (Fin w) ℚ)
    (q : ℕ) (i : α) :
    ((shiftRightCount R).mulVec (binomBasis (w + 1) (q + 1))) i -
      ((shiftRightCount R).mulVec (binomBasis (w + 1) q)) i =
      (R.mulVec (binomBasis w q)) i := by
  rw [shiftRightCount_mulVec_binomBasis_eq_sum, shiftRightCount_mulVec_binomBasis_eq_sum]
  rw [Finset.sum_range_succ]
  ring

theorem shiftRightCount_R_N_mat_binomBasis {w : ℕ} (clock : AlgebraicClock w)
    (i : Fin clock.m) (q : ℕ) :
    ((shiftRightCount clock.R * N_mat (w + 1)).mulVec (binomBasis (w + 1) q)) i =
      (clock.R.mulVec (binomBasis w q)) i := by
  have h_mul : (shiftRightCount clock.R * N_mat (w + 1)).mulVec (binomBasis (w + 1) q) =
      (shiftRightCount clock.R).mulVec ((N_mat (w + 1)).mulVec (binomBasis (w + 1) q)) := by
    rw [Matrix.mulVec_mulVec]
  rw [h_mul]
  have h_diff : (N_mat (w + 1)).mulVec (binomBasis (w + 1) q) =
      binomBasis (w + 1) (q + 1) - binomBasis (w + 1) q :=
    (binomBasis_succ_sub (w + 1) q).symm
  rw [h_diff, Matrix.mulVec_sub]
  exact shiftRightCount_mulVec_binomBasis_diff clock.R q i

theorem sum_G_shiftRightCount_C_binomBasis {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (i : Fin clock.m) (q : ℕ) :
    (∑ c : Fin (w + 1), (clock.G * shiftRightCount clock.C) i c * binomBasis (w + 1) q c) =
      (clock.R.mulVec (binomBasis w q)) i - clock.R i ⟨0, hw⟩ := by
  have hRN := shiftRightCount_R_N_mat_binomBasis clock i q
  dsimp [Matrix.mulVec, dotProduct] at hRN
  have h_split : (∑ c : Fin (w + 1), (shiftRightCount clock.R * N_mat (w + 1)) i c * binomBasis (w + 1) q c) =
      (shiftRightCount clock.R * N_mat (w + 1)) i 0 * binomBasis (w + 1) q 0 +
      ∑ c : Fin w, (shiftRightCount clock.R * N_mat (w + 1)) i c.succ * binomBasis (w + 1) q c.succ := by
    rw [Fin.sum_univ_succ]
  rw [h_split] at hRN
  have h0 : (shiftRightCount clock.R * N_mat (w + 1)) i 0 = clock.R i ⟨0, hw⟩ := by
    rw [shiftRightCount_R_mul_N_mat hw clock i 0]
    simp
  have h0_binom : binomBasis (w + 1) q 0 = 1 := by
    unfold binomBasis
    simp
  rw [h0, h0_binom, mul_one] at hRN
  have h_succ : ∀ c : Fin w, (shiftRightCount clock.R * N_mat (w + 1)) i c.succ =
      (clock.G * shiftRightCount clock.C) i c.succ := by
    intro c
    rw [shiftRightCount_R_mul_N_mat hw clock i c.succ]
    have hne : c.succ.val ≠ 0 := Nat.succ_ne_zero c.val
    rw [if_neg hne]
  simp_rw [h_succ] at hRN
  have h_target : (∑ c : Fin (w + 1), (clock.G * shiftRightCount clock.C) i c * binomBasis (w + 1) q c) =
      (clock.G * shiftRightCount clock.C) i 0 * binomBasis (w + 1) q 0 +
      ∑ c : Fin w, (clock.G * shiftRightCount clock.C) i c.succ * binomBasis (w + 1) q c.succ := by
    rw [Fin.sum_univ_succ]
  rw [h_target]
  have h_g0 : (clock.G * shiftRightCount clock.C) i 0 = 0 :=
    mul_shiftRightCount_zero clock.G clock.C i 0 rfl
  rw [h_g0, zero_mul, zero_add]
  dsimp [Matrix.mulVec, dotProduct]
  linarith

theorem liftedScoreMat_S_uniform_inl_gateway_eval {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (M : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ)
    (q : ℕ) :
    let zeta := zeta_canonical hw clock b c_step H0
    let h := h_uniform clock b zeta c_step
    let S := S_uniform hw clock b h delta
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let X := X_gateway clock
    ((liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q))
      (Sum.inl (gatewayOldAct clock.m)) =
      dotProduct zeta (binomBasis (w + 1) q) - c_step + delta := by
  intro zeta h S G_O X
  dsimp [liftedScoreMat, Matrix.mulVec, dotProduct]
  have h_add : (∑ c : Fin (w + 1), (S (gatewayOldAct clock.m) c + (G_O * X) (gatewayOldAct clock.m) c) * binomBasis (w + 1) q c) =
      (∑ c : Fin (w + 1), (h c + (clock.G * shiftRightCount clock.C) b c + (if c.val = 0 then clock.R b ⟨0, hw⟩ + delta else 0)) * binomBasis (w + 1) q c) := by
    refine Finset.sum_congr rfl fun c _ => ?_
    have h_entry := S_add_GO_X_gateway_apply hw clock b h delta c
    rw [← Matrix.add_apply, h_entry]
  rw [h_add]
  have h_split : (∑ c : Fin (w + 1), (h c + (clock.G * shiftRightCount clock.C) b c + (if c.val = 0 then clock.R b ⟨0, hw⟩ + delta else 0)) * binomBasis (w + 1) q c) =
      (∑ c : Fin (w + 1), h c * binomBasis (w + 1) q c) +
      (∑ c : Fin (w + 1), (clock.G * shiftRightCount clock.C) b c * binomBasis (w + 1) q c) +
      (∑ c : Fin (w + 1), (if c.val = 0 then clock.R b ⟨0, hw⟩ + delta else 0) * binomBasis (w + 1) q c) := by
    simp_rw [add_mul]
    rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
  rw [h_split]
  have h_h := dotProduct_h_uniform_binomBasis clock b zeta c_step q
  have h_G := sum_G_shiftRightCount_C_binomBasis hw clock b q
  have h_d : (∑ c : Fin (w + 1), (if c.val = 0 then clock.R b ⟨0, hw⟩ + delta else 0) * binomBasis (w + 1) q c) =
      clock.R b ⟨0, hw⟩ + delta := by
    rw [Finset.sum_eq_single ⟨0, by omega⟩]
    · simp only [↓reduceIte, binomBasis, Nat.choose_zero_right]
      ring
    · intro c _ hc
      have hne : c.val ≠ 0 := by intro h; apply hc; ext; exact h
      simp [hne]
    · intro h; exact False.elim (h (Finset.mem_univ _))
  dsimp [dotProduct] at h_h
  rw [h_h, h_G, h_d]
  ring

theorem S_add_GO_X_parent_apply {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (h : Fin (w + 1) → ℚ) (delta : ℚ) (i : Fin clock.m) (c : Fin (w + 1)) :
    let S := S_uniform hw clock b h delta
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let X := X_gateway clock
    (S + G_O * X) (finSumFinEquiv (Sum.inl i)) c =
      h c + (clock.G * shiftRightCount clock.C) i c +
        (if c.val = 0 then clock.R i ⟨0, hw⟩ - (clock.G b i + clock.v i) else 0) := by
  intro S G_O X
  rw [Matrix.add_apply]
  dsimp only [S, S_uniform]
  rw [Matrix.of_apply]
  simp only [Equiv.symm_apply_apply]
  rw [GO_mul_X_inl_apply]
  by_cases hc0 : c.val = 0
  · have he0 : e0_row (w + 1) c = 1 := by simp [e0_row, hc0]
    simp only [hc0, ↓reduceIte, he0]
    ring
  · have he0 : e0_row (w + 1) c = 0 := by simp [e0_row, hc0]
    simp only [hc0, ↓reduceIte, he0, mul_zero, sub_zero, add_zero]
    ring

theorem liftedScoreMat_S_uniform_inl_parent_eval {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (M : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ)
    (i : Fin clock.m) (q : ℕ) :
    let zeta := zeta_canonical hw clock b c_step H0
    let h := h_uniform clock b zeta c_step
    let S := S_uniform hw clock b h delta
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let X := X_gateway clock
    ((liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q))
      (Sum.inl (finSumFinEquiv (Sum.inl i))) =
      (clock.R.mulVec (binomBasis w q)) i + dotProduct zeta (binomBasis (w + 1) q) -
        (clock.R.mulVec (binomBasis w q)) b - c_step - clock.G b i - clock.v i := by
  intro zeta h S G_O X
  dsimp [liftedScoreMat, Matrix.mulVec, dotProduct]
  have h_add : (∑ c : Fin (w + 1), (S (Fin.castAdd 1 i) c + (G_O * X) (Fin.castAdd 1 i) c) * binomBasis (w + 1) q c) =
      (∑ c : Fin (w + 1), (h c + (clock.G * shiftRightCount clock.C) i c +
        (if c.val = 0 then clock.R i ⟨0, hw⟩ - (clock.G b i + clock.v i) else 0)) * binomBasis (w + 1) q c) := by
    refine Finset.sum_congr rfl fun c _ => ?_
    have h_entry := S_add_GO_X_parent_apply hw clock b h delta i c
    change (S + G_O * X) (Fin.castAdd 1 i) c = _ at h_entry
    rw [← Matrix.add_apply, h_entry]
  rw [h_add]
  have h_split : (∑ c : Fin (w + 1), (h c + (clock.G * shiftRightCount clock.C) i c +
        (if c.val = 0 then clock.R i ⟨0, hw⟩ - (clock.G b i + clock.v i) else 0)) * binomBasis (w + 1) q c) =
      (∑ c : Fin (w + 1), h c * binomBasis (w + 1) q c) +
      (∑ c : Fin (w + 1), (clock.G * shiftRightCount clock.C) i c * binomBasis (w + 1) q c) +
      (∑ c : Fin (w + 1), (if c.val = 0 then clock.R i ⟨0, hw⟩ - (clock.G b i + clock.v i) else 0) * binomBasis (w + 1) q c) := by
    simp_rw [add_mul]
    rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
  rw [h_split]
  have h_h := dotProduct_h_uniform_binomBasis clock b zeta c_step q
  have h_G := sum_G_shiftRightCount_C_binomBasis hw clock b q
  have h_G_i := sum_G_shiftRightCount_C_binomBasis hw clock i q
  have h_d : (∑ c : Fin (w + 1), (if c.val = 0 then clock.R i ⟨0, hw⟩ - (clock.G b i + clock.v i) else 0) * binomBasis (w + 1) q c) =
      clock.R i ⟨0, hw⟩ - (clock.G b i + clock.v i) := by
    rw [Finset.sum_eq_single ⟨0, by omega⟩]
    · simp only [↓reduceIte, binomBasis, Nat.choose_zero_right]
      ring
    · intro c _ hc
      have hne : c.val ≠ 0 := by intro h; apply hc; ext; exact h
      simp [hne]
    · intro h; exact False.elim (h (Finset.mem_univ _))
  dsimp [dotProduct] at h_h
  rw [h_h, h_G_i, h_d]
  dsimp [Matrix.mulVec, dotProduct]
  ring

theorem liftedScoreMat_S_uniform_inl_leader_eval {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (M : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ)
    (hvb : clock.v b = 0) (q : ℕ) :
    let zeta := zeta_canonical hw clock b c_step H0
    let h := h_uniform clock b zeta c_step
    let S := S_uniform hw clock b h delta
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let X := X_gateway clock
    ((liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q))
      (Sum.inl (finSumFinEquiv (Sum.inl b))) =
      dotProduct zeta (binomBasis (w + 1) q) - c_step := by
  intro zeta h S G_O X
  have h_parent := liftedScoreMat_S_uniform_inl_parent_eval hw clock b c_step H0 delta J M b q
  dsimp only [zeta, h, S, G_O, X] at h_parent
  have hskew : clock.G b b = 0 := skew_diag_zero clock.hskew b
  rw [h_parent, hskew, hvb]
  ring

theorem stage1_old_start_all {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (M : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ)
    (q : ℕ)
    (h_gw : delta < c_step)
    (h_parent : ∀ i : Fin clock.m,
      (clock.R.mulVec (binomBasis w q)) i - (clock.R.mulVec (binomBasis w q)) b -
        clock.G b i - clock.v i < c_step)
    (u : Fin (clock.m + 1)) :
    let zeta := zeta_canonical hw clock b c_step H0
    let h := h_uniform clock b zeta c_step
    let S := S_uniform hw clock b h delta
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let X := X_gateway clock
    ((liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)) (Sum.inl u) <
      dotProduct zeta (binomBasis (w + 1) q) := by
  intro zeta h S G_O X
  cases hsym : finSumFinEquiv.symm u with
  | inr j =>
    have hj : j = 0 := Subsingleton.elim _ _
    subst hj
    apply_fun finSumFinEquiv at hsym
    rw [Equiv.apply_symm_apply] at hsym
    subst hsym
    have hgw : finSumFinEquiv (Sum.inr 0) = gatewayOldAct clock.m := rfl
    rw [hgw]
    have h_eval := liftedScoreMat_S_uniform_inl_gateway_eval hw clock b c_step H0 delta J M q
    dsimp only [zeta, h, S, G_O, X] at h_eval
    rw [h_eval]
    linarith
  | inl i =>
    apply_fun finSumFinEquiv at hsym
    rw [Equiv.apply_symm_apply] at hsym
    subst hsym
    have h_eval := liftedScoreMat_S_uniform_inl_parent_eval hw clock b c_step H0 delta J M i q
    dsimp only [zeta, h, S, G_O, X] at h_eval
    rw [h_eval]
    have hp := h_parent i
    linarith

theorem wordScore_bundle_take_parentToOldAct_uniform {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (h : Fin (w + 1) → ℚ) (delta : ℚ)
    (W_p : List (Fin clock.m)) (q k : ℕ) (i : Fin clock.m) :
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v)
      ((S_uniform hw clock b h delta).mulVec (binomBasis (w + 1) (q + 1)))
      ((W_p.map (parentToOldAct clock.m)).take k)
      (parentToOldAct clock.m i) =
    wordScore clock.G
      (clock.R.mulVec (binomBasis w 0))
      (W_p.take k) i +
    dotProduct h (binomBasis (w + 1) (q + 1)) := by
  have hinj : Function.Injective (parentToOldAct clock.m) := by
    intro a b_idx hab
    simp only [parentToOldAct, Equiv.apply_eq_iff_eq, Sum.inl.injEq] at hab
    exact hab
  rw [← List.map_take]
  simp only [wordScore, scoreVec, Matrix.mulVec, dotProduct]
  rw [(Equiv.sum_comp finSumFinEquiv fun y => (AdjoinLeaderEndpointG clock.G b clock.v) (parentToOldAct clock.m i) y *
    wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) y).symm]
  rw [Fintype.sum_sum_type]
  have hcount_inr : ∀ v : Fin 1,
      wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inr v)) = 0 := by
    intro v
    unfold wordCountVec
    have hnone : ∀ y ∈ (W_p.take k).map (parentToOldAct clock.m),
        y ≠ finSumFinEquiv (Sum.inr v) := by
      intro y hy h
      simp only [List.mem_map] at hy
      rcases hy with ⟨j, _, rfl⟩
      simp only [parentToOldAct, Equiv.apply_eq_iff_eq] at h
      contradiction
    exact_mod_cast list_count_eq_zero_of_forall_ne hnone
  simp only [hcount_inr, mul_zero, Finset.sum_const_zero, add_zero]
  have hcount_inl : ∀ j : Fin clock.m,
      wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inl j)) =
      wordCountVec (W_p.take k) j := by
    intro j
    have hp : finSumFinEquiv (Sum.inl j) = parentToOldAct clock.m j := rfl
    rw [hp]
    unfold wordCountVec
    rw [list_count_map_of_injective (parentToOldAct clock.m) hinj (W_p.take k) j]
  have hsum_i : (∑ j : Fin clock.m, (AdjoinLeaderEndpointG clock.G b clock.v) (parentToOldAct clock.m i) (finSumFinEquiv (Sum.inl j)) *
      wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inl j))) =
      ∑ j : Fin clock.m, clock.G i j * wordCountVec (W_p.take k) j := by
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hcount_inl j]
    have hp : finSumFinEquiv (Sum.inl j) = parentToOldAct clock.m j := rfl
    rw [hp, AdjoinLeaderEndpointG_parent_parent clock.G b clock.v i j]
  have hs_i : ((S_uniform hw clock b h delta).mulVec (binomBasis (w + 1) (q + 1))) (parentToOldAct clock.m i) =
      clock.R i ⟨0, hw⟩ + dotProduct h (binomBasis (w + 1) (q + 1)) := by
    have hp : parentToOldAct clock.m i = finSumFinEquiv (Sum.inl i) := rfl
    rw [hp]
    exact S_uniform_parent_eval hw clock b h delta i q
  have hR0 : clock.R.mulVec (binomBasis w 0) i = clock.R i ⟨0, hw⟩ := by
    have hp0 : binomBasis w 0 = fun c => if c.val = 0 then 1 else 0 := by
      ext c
      simp only [binomBasis]
      cases c.val with
      | zero => simp
      | succ n => simp [Nat.choose_eq_zero_of_lt]
    simp only [Matrix.mulVec, dotProduct, hp0]
    rw [Finset.sum_eq_single ⟨0, hw⟩]
    · simp
    · intro c _ hc
      have hne : c.val ≠ 0 := by intro h; apply hc; ext; exact h
      simp [hne]
    · intro h; exact False.elim (h (Finset.mem_univ _))
  dsimp [Matrix.mulVec, dotProduct] at hR0 hs_i
  rw [hs_i, hsum_i, hR0]
  ring

theorem wordScore_bundle_take_gateway_sub_leader_uniform {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (h : Fin (w + 1) → ℚ) (delta : ℚ)
    (W_p : List (Fin clock.m)) (q k : ℕ) :
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v)
      ((S_uniform hw clock b h delta).mulVec (binomBasis (w + 1) (q + 1)))
      ((W_p.map (parentToOldAct clock.m)).take k)
      (gatewayOldAct clock.m) -
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v)
      ((S_uniform hw clock b h delta).mulVec (binomBasis (w + 1) (q + 1)))
      ((W_p.map (parentToOldAct clock.m)).take k)
      (parentToOldAct clock.m b) =
    delta - ((q + 1 : ℕ) : ℚ) + dotProduct clock.v (wordCountVec (W_p.take k)) := by
  have hinj : Function.Injective (parentToOldAct clock.m) := by
    intro a b_idx hab
    simp only [parentToOldAct, Equiv.apply_eq_iff_eq, Sum.inl.injEq] at hab
    exact hab
  rw [← List.map_take]
  simp only [wordScore, scoreVec, Matrix.mulVec, dotProduct]
  rw [(Equiv.sum_comp finSumFinEquiv fun y => (AdjoinLeaderEndpointG clock.G b clock.v) (gatewayOldAct clock.m) y *
    wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) y).symm]
  rw [(Equiv.sum_comp finSumFinEquiv fun y => (AdjoinLeaderEndpointG clock.G b clock.v) (parentToOldAct clock.m b) y *
    wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) y).symm]
  rw [Fintype.sum_sum_type, Fintype.sum_sum_type]
  have hcount_inr : ∀ v : Fin 1,
      wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inr v)) = 0 := by
    intro v
    unfold wordCountVec
    have hnone : ∀ y ∈ (W_p.take k).map (parentToOldAct clock.m),
        y ≠ finSumFinEquiv (Sum.inr v) := by
      intro y hy h
      simp only [List.mem_map] at hy
      rcases hy with ⟨j, _, rfl⟩
      simp only [parentToOldAct, Equiv.apply_eq_iff_eq] at h
      contradiction
    exact_mod_cast list_count_eq_zero_of_forall_ne hnone
  simp only [hcount_inr, mul_zero, Finset.sum_const_zero, add_zero]
  have hcount_inl : ∀ j : Fin clock.m,
      wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inl j)) =
      wordCountVec (W_p.take k) j := by
    intro j
    have hp : finSumFinEquiv (Sum.inl j) = parentToOldAct clock.m j := rfl
    rw [hp]
    unfold wordCountVec
    rw [list_count_map_of_injective (parentToOldAct clock.m) hinj (W_p.take k) j]
  have hsum_gw : (∑ j : Fin clock.m, (AdjoinLeaderEndpointG clock.G b clock.v) (gatewayOldAct clock.m) (finSumFinEquiv (Sum.inl j)) *
      wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inl j))) =
      (∑ j : Fin clock.m, clock.G b j * wordCountVec (W_p.take k) j) +
      (∑ j : Fin clock.m, clock.v j * wordCountVec (W_p.take k) j) := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hcount_inl j]
    have hrow := leader_endpoint_row clock.G b clock.v j
    have hg : gatewayOldAct clock.m = finSumFinEquiv (Sum.inr 0) := rfl
    rw [hg, hrow]
    ring
  have hsum_lead : (∑ j : Fin clock.m, (AdjoinLeaderEndpointG clock.G b clock.v) (parentToOldAct clock.m b) (finSumFinEquiv (Sum.inl j)) *
      wordCountVec ((W_p.take k).map (parentToOldAct clock.m)) (finSumFinEquiv (Sum.inl j))) =
      ∑ j : Fin clock.m, clock.G b j * wordCountVec (W_p.take k) j := by
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hcount_inl j]
    have hp : finSumFinEquiv (Sum.inl j) = parentToOldAct clock.m j := rfl
    rw [hp, AdjoinLeaderEndpointG_parent_parent clock.G b clock.v b j]
  have hs_gw := S_uniform_gateway_eval hw clock b h delta q
  have hs_lead := S_uniform_parent_eval hw clock b h delta b q
  rw [hsum_gw, hsum_lead]
  change (∑ x, S_uniform hw clock b h delta (Fin.natAdd clock.m 0) x * binomBasis (w + 1) (q + 1) x) +
    (∑ j, clock.G b j * wordCountVec (List.take k W_p) j + ∑ j, clock.v j * wordCountVec (List.take k W_p) j) -
    ((∑ x, S_uniform hw clock b h delta (Fin.castAdd 1 b) x * binomBasis (w + 1) (q + 1) x) +
      ∑ j, clock.G b j * wordCountVec (List.take k W_p) j) = _
  dsimp [Matrix.mulVec, dotProduct] at hs_gw hs_lead
  rw [hs_gw, hs_lead]
  ring

theorem stage3_gw_waits_all {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (h : Fin (w + 1) → ℚ) (delta : ℚ) (hdelta : delta < 1)
    (W_p : List (Fin clock.m)) (q k : ℕ) (hk : k < W_p.length)
    (hv_nonpos : dotProduct clock.v (wordCountVec (W_p.take k)) ≤ 0)
    (h_act_dom : wordScore clock.G (clock.R.mulVec (binomBasis w 0)) (W_p.take k) b ≤
      wordScore clock.G (clock.R.mulVec (binomBasis w 0)) (W_p.take k) (W_p[k]'hk)) :
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v)
      ((S_uniform hw clock b h delta).mulVec (binomBasis (w + 1) (q + 1)))
      (((W_p.map (parentToOldAct clock.m)).take k))
      (gatewayOldAct clock.m) <
    wordScore (AdjoinLeaderEndpointG clock.G b clock.v)
      ((S_uniform hw clock b h delta).mulVec (binomBasis (w + 1) (q + 1)))
      (((W_p.map (parentToOldAct clock.m)).take k))
      (parentToOldAct clock.m (W_p[k]'hk)) := by
  have hdiff := wordScore_bundle_take_gateway_sub_leader_uniform hw clock b h delta W_p q k
  have hscore_b := wordScore_bundle_take_parentToOldAct_uniform hw clock b h delta W_p q k b
  have hscore_k := wordScore_bundle_take_parentToOldAct_uniform hw clock b h delta W_p q k (W_p[k]'hk)
  have hq_ge : (1 : ℚ) ≤ ((q + 1 : ℕ) : ℚ) := by
    exact_mod_cast Nat.succ_le_succ (Nat.zero_le q)
  linarith

/-- Prefix nonpositivity of `v · count` along `rpsPhaseWord`. -/
theorem rps_phaseWord_take_v_dot_le_zero (σ r : ℕ) (hr : r < (rpsPhaseWord σ).length) :
    dotProduct rpsFullRankClock.clock.v (wordCountVec ((rpsPhaseWord σ).take r)) ≤ 0 :=
  rpsPhaseWord_take_v_dot_nonpos σ r hr

/-- At any proper prefix of `rawFourStageWord_M`, the dot product with the lifted endpoint weight vector is zero. -/
theorem rawFourStageWord_M_take_v_dot_eq_zero {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ) (σ r : ℕ)
    (hr : r < (rawFourStageWord_M clock parentWord M_nat σ).length) :
    dotProduct (liftedWeightVec (v_old_coupled clock.m) (0 : Fin ((w + 1) + (w + 1)) → ℚ))
      (wordCountVec ((rawFourStageWord_M clock parentWord M_nat σ).take r)) = 0 := by
  let W_prefix : List (Fin (clock.m + 1) ⊕ Fin ((w + 1) + (w + 1))) :=
    (W_early_word_M clock.m w M_nat σ ++ W_late_word_M clock.m w M_nat σ) ++
      (W_bundle_word parentWord (σ + 1)).map (bundleToLiftedAct clock.m w)
  have h_raw : rawFourStageWord_M clock parentWord M_nat σ = W_prefix ++ [gatewayToLiftedAct clock.m w] := by
    unfold rawFourStageWord_M W_prefix
    simp only [List.append_assoc]
  have h_len : r ≤ W_prefix.length := by
    have h_tot : (rawFourStageWord_M clock parentWord M_nat σ).length = W_prefix.length + 1 := by
      rw [h_raw, List.length_append, List.length_singleton]
    omega
  have htake : (rawFourStageWord_M clock parentWord M_nat σ).take r = W_prefix.take r := by
    rw [h_raw]
    exact List.take_append_of_le_length h_len
  have h_prefix_count : wordCountVec W_prefix (gatewayToLiftedAct clock.m w) = 0 := by
    dsimp only [W_prefix]
    have hgw : gatewayToLiftedAct clock.m w = Sum.inl (gatewayOldAct clock.m) := rfl
    rw [hgw, wordCountVec_append]
    have hreset := wordCountVec_reset_stages_M_inl clock.m w M_nat σ (gatewayOldAct clock.m)
    have hdrop := wordCountVec_drop_bundleToLiftedAct_gateway clock.m w (W_bundle_word parentWord (σ + 1)) 0
    rw [List.drop_zero] at hdrop
    rw [hreset, hdrop, add_zero]
  have h_take_zero : wordCountVec ((rawFourStageWord_M clock parentWord M_nat σ).take r) (gatewayToLiftedAct clock.m w) = 0 := by
    rw [htake]
    have h1 := (wordCountVec_take_drop_bounds W_prefix r (gatewayToLiftedAct clock.m w)).1
    have h2 := (wordCountVec_take_drop_bounds W_prefix r (gatewayToLiftedAct clock.m w)).2.2.1
    rw [h_prefix_count] at h2
    linarith
  simp only [dotProduct]
  apply Finset.sum_eq_zero
  intro y _
  cases y with
  | inr r' =>
    have : liftedWeightVec (v_old_coupled clock.m) (0 : Fin ((w + 1) + (w + 1)) → ℚ) (Sum.inr r') = 0 := rfl
    rw [this, zero_mul]
  | inl u =>
    obtain ⟨sa, rfl⟩ := finSumFinEquiv.surjective u
    rcases sa with i | v
    · have hv : v_old_coupled clock.m (finSumFinEquiv (Sum.inl i)) = 0 := by
        dsimp only [v_old_coupled]
        rw [Equiv.symm_apply_apply]
      have hvec : liftedWeightVec (v_old_coupled clock.m) (0 : Fin ((w + 1) + (w + 1)) → ℚ)
          (Sum.inl (finSumFinEquiv (Sum.inl i))) = 0 := hv
      rw [hvec, zero_mul]
    · have hv0 : v = 0 := Subsingleton.elim v 0
      subst hv0
      have hy : Sum.inl (finSumFinEquiv (Sum.inr (0 : Fin 1))) = gatewayToLiftedAct clock.m w := rfl
      rw [hy, h_take_zero, mul_zero]


/-- Score of late reset action in Stage 3 is bounded above by its post-reset-stages value. -/
theorem wordScore_stage3_take_late_inr_M_le_start {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (G_O : Matrix (Fin (clock.m + 1)) (Fin (clock.m + 1)) ℚ)
    (P : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (S : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (zeta : Fin (w + 1) → ℚ)
    (j : Fin (w + 1))
    (hP_late : ∀ u : Fin (clock.m + 1), 0 ≤ P u (finSumFinEquiv (Sum.inr j)))
    (q k : ℕ) :
    let s0 := (liftedScoreMat G_O J S (X_gateway clock) (M_of_nat M_nat) zeta).mulVec (binomBasis (w + 1) q)
    let W_stage3 := (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)
    let r := finSumFinEquiv (Sum.inr j)
    wordScore (liftedGameMat G_O P J)
      (wordScore (liftedGameMat G_O P J) s0 (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q))
      (W_stage3.take k) (Sum.inr r) ≤
    (one_zeta (Fin ((w + 1) + (w + 1))) zeta - J.transpose * (M_of_nat M_nat)).mulVec (binomBasis (w + 1) q) r := by
  intro s0 W_stage3 r
  have htake_inr := wordCountVec_take_bundleToLiftedAct_inr clock.m w (W_bundle_word parentWord (q + 1)) k
  rw [wordScore_liftedGameMat_old_word_inr G_O P J _ _ htake_inr r]
  rw [wordScore_after_reset_stages_M_inr clock G_O P J S M_nat zeta q r]
  have hsum_nonneg : 0 ≤ ∑ u : Fin (clock.m + 1), P u r * wordCountVec (W_stage3.take k) (Sum.inl u) := by
    apply Finset.sum_nonneg
    intro u _
    have h1 := hP_late u
    have h2 : 0 ≤ wordCountVec (W_stage3.take k) (Sum.inl u) := by unfold wordCountVec; positivity
    exact mul_nonneg h1 h2
  linarith

/-!
## 9. Stage 3 Suffix Bound and Multi-Subphase Growth Bound
-/

/-- Weak suffix bound property: active parent score remains within `eps * suffix_length + A`
    of the next-phase leader score. -/
def HasSuffixBound {w : ℕ} (clock : AlgebraicClock w) (b : Fin clock.m)
    (parentWord : ℕ → List (Fin clock.m)) : Prop :=
  ∀ eps : ℚ, 0 < eps → ∃ A : ℚ, 0 ≤ A ∧ ∀ (σ r : ℕ) (hr : r < (parentWord σ).length),
    (clock.R.mulVec (binomBasis w (σ + 1))) b -
      wordScore clock.G (clock.R.mulVec (binomBasis w σ)) ((parentWord σ).take r) ((parentWord σ)[r]) ≤
      eps * (((parentWord σ).drop r).length : ℚ) + A

/-- Monotonicity of binomial coefficients under simultaneous index shift:
    `Nat.choose n m ≤ Nat.choose (n + d) (m + d)`. -/
lemma choose_le_choose_add (n m d : ℕ) : Nat.choose n m ≤ Nat.choose (n + d) (m + d) := by
  induction d with
  | zero => exact le_rfl
  | succ d ih =>
    rw [Nat.add_succ, Nat.add_succ, Nat.choose_succ_succ]
    exact le_trans ih (Nat.le_add_right _ _)

/-- Universal key bound relating intermediate binomial coefficients to top-order binomial coefficients:
    `(τ + 1) * Nat.choose τ k.val ≤ w * Nat.choose (τ + w - 1) (w - 1)`. -/
lemma choose_bound_key {w : ℕ} (hw : 2 ≤ w) (k : Fin (w - 1)) (τ : ℕ) :
    (τ + 1) * Nat.choose τ k.val ≤ w * Nat.choose (τ + w - 1) (w - 1) := by
  have hk : k.val < w - 1 := k.isLt
  have h1 : (τ + 1) * Nat.choose τ k.val = (k.val + 1) * Nat.choose (τ + 1) (k.val + 1) := by
    rw [Nat.add_one_mul_choose_eq, mul_comm]
  rw [h1]
  let d := w - 2 - k.val
  have hd_add : k.val + 1 + d = w - 1 := by
    dsimp [d]
    omega
  have h_add := choose_le_choose_add (τ + 1) (k.val + 1) d
  rw [hd_add] at h_add
  have h_le_n : τ + 1 + d ≤ τ + w - 1 := by
    dsimp [d]
    omega
  have h_mono := Nat.choose_le_choose (w - 1) h_le_n
  have h_comb : Nat.choose (τ + 1) (k.val + 1) ≤ Nat.choose (τ + w - 1) (w - 1) :=
    le_trans h_add h_mono
  have h_coeff : k.val + 1 ≤ w := by omega
  exact Nat.mul_le_mul h_coeff h_comb

/-- Componentwise difference of binomial basis vectors between consecutive phases. -/
lemma binomBasis_succ_sub_apply (w : ℕ) (τ : ℕ) (c : Fin w) :
    binomBasis w (τ + 1) c - binomBasis w τ c =
      if 0 < c.val then (Nat.choose τ (c.val - 1) : ℚ) else 0 := by
  dsimp [binomBasis]
  split_ifs with hc
  · obtain ⟨k, hk⟩ : ∃ k, c.val = k + 1 := Nat.exists_eq_succ_of_ne_zero (ne_of_gt hc)
    rw [hk]
    simp only [Nat.add_sub_cancel_right]
    have hch : Nat.choose (τ + 1) (k + 1) = Nat.choose τ k + Nat.choose τ (k + 1) :=
      Nat.choose_succ_succ τ k
    rw [hch]
    push_cast
    ring
  · have hc0 : c.val = 0 := by omega
    rw [hc0]
    simp

/-- Single-step leader difference bounded by `K * (w / (τ + 1)) * choose(τ + w - 1, w - 1)`. -/
lemma R_mulVec_diff_le_sum {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m) (τ : ℕ) :
    (clock.R.mulVec (binomBasis w (τ + 1))) b - (clock.R.mulVec (binomBasis w τ)) b ≤
      (∑ c : Fin w, |clock.R b c|) * ((w : ℚ) / (τ + 1 : ℚ)) * (Nat.choose (τ + w - 1) (w - 1) : ℚ) := by
  dsimp [Matrix.mulVec, dotProduct]
  rw [← Finset.sum_sub_distrib]
  have h_term : ∀ c : Fin w, clock.R b c * binomBasis w (τ + 1) c - clock.R b c * binomBasis w τ c =
      clock.R b c * (binomBasis w (τ + 1) c - binomBasis w τ c) := by
    intro c; ring
  simp_rw [h_term, binomBasis_succ_sub_apply w τ]
  have h_le_each : ∀ c : Fin w,
      clock.R b c * (if 0 < c.val then (Nat.choose τ (c.val - 1) : ℚ) else 0) ≤
        |clock.R b c| * ((w : ℚ) / (τ + 1 : ℚ)) * (Nat.choose (τ + w - 1) (w - 1) : ℚ) := by
    intro c
    split_ifs with hc
    · have hk : c.val - 1 < w - 1 := by
        have := c.isLt
        omega
      let k : Fin (w - 1) := ⟨c.val - 1, hk⟩
      have h_key := choose_bound_key hw k τ
      have h_key_q : ((τ + 1 : ℚ)) * (Nat.choose τ (c.val - 1) : ℚ) ≤
          (w : ℚ) * (Nat.choose (τ + w - 1) (w - 1) : ℚ) := by
        exact_mod_cast h_key
      have h_pos : 0 < (τ + 1 : ℚ) := by positivity
      have h_div : (Nat.choose τ (c.val - 1) : ℚ) ≤
          ((w : ℚ) / (τ + 1 : ℚ)) * (Nat.choose (τ + w - 1) (w - 1) : ℚ) := by
        rw [div_mul_eq_mul_div]
        exact (le_div_iff₀ h_pos).mpr (by linarith [h_key_q])
      have h_R_le : clock.R b c ≤ |clock.R b c| := le_abs_self _
      have h_ch_nonneg : 0 ≤ (Nat.choose τ (c.val - 1) : ℚ) := by positivity
      have h_prod := mul_le_mul h_R_le h_div h_ch_nonneg (by positivity)
      rw [mul_assoc]
      exact h_prod
    · rw [mul_zero]
      positivity
  have h_sum : (∑ c : Fin w, clock.R b c * (if 0 < c.val then (Nat.choose τ (c.val - 1) : ℚ) else 0)) ≤
      ∑ c : Fin w, |clock.R b c| * ((w : ℚ) / (τ + 1 : ℚ)) * (Nat.choose (τ + w - 1) (w - 1) : ℚ) :=
    Finset.sum_le_sum (fun c _ => h_le_each c)
  have h_distrib : (∑ c : Fin w, |clock.R b c| * ((w : ℚ) / (τ + 1 : ℚ)) * (Nat.choose (τ + w - 1) (w - 1) : ℚ)) =
      (∑ c : Fin w, |clock.R b c|) * ((w : ℚ) / (τ + 1 : ℚ)) * (Nat.choose (τ + w - 1) (w - 1) : ℚ) := by
    rw [← Finset.sum_mul, ← Finset.sum_mul]
  rwa [h_distrib] at h_sum

/-- Telescoping sum of adjacent differences over `Finset.Ico σ (q + 1)`. -/
theorem sum_Ico_sub_adjacent (f : ℕ → ℚ) (σ q : ℕ) (hσ : σ ≤ q + 1) :
    ∑ τ ∈ Finset.Ico σ (q + 1), (f (τ + 1) - f τ) = f (q + 1) - f σ := by
  obtain ⟨k, hk⟩ := Nat.le.dest hσ
  rw [← hk]
  clear hk hσ q
  induction k with
  | zero => simp
  | succ k ih =>
    have h_le : σ ≤ σ + k := Nat.le_add_right _ _
    have h_step : σ + (k + 1) = (σ + k) + 1 := by omega
    rw [h_step, Finset.sum_Ico_succ_top h_le]
    rw [ih]
    ring

/-- Sum of filtered non-negative terms over `Finset.Ico σ (q + 1)` bounded by total range sum. -/
theorem sum_Ico_ite_lt_le_range (h : ℕ → ℚ) (hh_nonneg : ∀ τ, 0 ≤ h τ) (T0 σ q : ℕ) :
    (∑ τ ∈ Finset.Ico σ (q + 1), if τ < T0 then h τ else 0) ≤ ∑ τ ∈ Finset.range T0, h τ := by
  have h_le : (∑ τ ∈ Finset.Ico σ (q + 1), if τ < T0 then h τ else 0) ≤
      ∑ τ ∈ Finset.range (q + 1), if τ < T0 then h τ else 0 := by
    apply Finset.sum_le_sum_of_subset_of_nonneg
    · intro x hx
      rw [Finset.mem_Ico] at hx
      rw [Finset.mem_range]
      exact hx.2
    · intro x _ _
      split_ifs
      · exact hh_nonneg x
      · rfl
  have h_filt : (∑ τ ∈ Finset.range (q + 1), if τ < T0 then h τ else 0) ≤
      ∑ τ ∈ Finset.range T0, h τ := by
    rw [← Finset.sum_filter]
    apply Finset.sum_le_sum_of_subset_of_nonneg
    · intro x hx
      rw [Finset.mem_filter] at hx
      rw [Finset.mem_range]
      exact hx.2
    · intro x _ _
      exact hh_nonneg x
  exact le_trans h_le h_filt

/-- **Multi-Subphase Growth Bound (`subphase_leader_diff_le_eps_length_add_const`)**:
    Across any range of subphases `σ ≤ q + 1`, the cumulative leader score growth is bounded by
    `eps * (cumulative word length) + B_const`. -/
theorem subphase_leader_diff_le_eps_length_add_const {w : ℕ} (hw : 2 ≤ w)
    (clock : AlgebraicClock w) (b : Fin clock.m)
    (parentWord : ℕ → List (Fin clock.m))
    (h_len : ∀ τ : ℕ, (Nat.choose (τ + w - 1) (w - 1) : ℚ) ≤ ((parentWord τ).length : ℚ))
    (eps : ℚ) (heps : 0 < eps) :
    ∃ B_const : ℚ, 0 ≤ B_const ∧ ∀ (σ q : ℕ) (_hσ : σ ≤ q + 1),
      (clock.R.mulVec (binomBasis w (q + 1))) b - (clock.R.mulVec (binomBasis w σ)) b ≤
        eps * (∑ τ ∈ Finset.Ico σ (q + 1), ((parentWord τ).length : ℚ)) + B_const := by
  let K := ∑ c : Fin w, |clock.R b c|
  obtain ⟨T0, hT0⟩ : ∃ T0 : ℕ, (K * (w : ℚ)) / eps ≤ (T0 : ℚ) := exists_nat_ge ((K * (w : ℚ)) / eps)
  let diff := fun τ => (clock.R.mulVec (binomBasis w (τ + 1))) b - (clock.R.mulVec (binomBasis w τ)) b
  let rem := fun τ => max 0 (diff τ)
  let B_const := ∑ τ ∈ Finset.range T0, rem τ
  refine ⟨B_const, ?_, ?_⟩
  · apply Finset.sum_nonneg
    intro τ _
    dsimp [rem]
    exact le_max_left 0 _
  · intro σ q hσ
    have h_diff_each : ∀ τ : ℕ, diff τ ≤ eps * ((parentWord τ).length : ℚ) + (if τ < T0 then rem τ else 0) := by
      intro τ
      by_cases hτ : τ < T0
      · simp only [hτ, ↓reduceIte]
        have h_rem : diff τ ≤ rem τ := le_max_right 0 (diff τ)
        have h_len_nonneg : 0 ≤ eps * ((parentWord τ).length : ℚ) := by positivity
        linarith
      · simp only [hτ, ↓reduceIte, add_zero]
        push_neg at hτ
        have h_bound := R_mulVec_diff_le_sum hw clock b τ
        have h_word_len := h_len τ
        have h_tau_pos : 0 < (τ + 1 : ℚ) := by positivity
        have h_T0_pos : 0 < (T0 + 1 : ℚ) := by positivity
        have h_tau_ge_T0 : (T0 + 1 : ℚ) ≤ (τ + 1 : ℚ) := by
          exact_mod_cast (Nat.succ_le_succ hτ)
        have h_div_le : (1 : ℚ) / (τ + 1 : ℚ) ≤ (1 : ℚ) / (T0 + 1 : ℚ) :=
          one_div_le_one_div_of_le h_T0_pos h_tau_ge_T0
        have hK_nonneg : 0 ≤ K := Finset.sum_nonneg (fun c _ => abs_nonneg _)
        have hw_pos : 0 ≤ (w : ℚ) := by positivity
        have h_mul_le : K * ((w : ℚ) / (τ + 1 : ℚ)) ≤ eps := by
          have h1 : K * ((w : ℚ) / (τ + 1 : ℚ)) = (K * (w : ℚ)) * ((1 : ℚ) / (τ + 1 : ℚ)) := by ring
          have h2 : (K * (w : ℚ)) * ((1 : ℚ) / (τ + 1 : ℚ)) ≤ (K * (w : ℚ)) * ((1 : ℚ) / (T0 + 1 : ℚ)) := by
            apply mul_le_mul_of_nonneg_left h_div_le
            positivity
          have h3 : (K * (w : ℚ)) * ((1 : ℚ) / (T0 + 1 : ℚ)) = (K * (w : ℚ)) / (T0 + 1 : ℚ) := by ring
          have h4 : (K * (w : ℚ)) / (T0 + 1 : ℚ) ≤ eps := by
            rw [div_le_iff₀ h_T0_pos]
            have h_eps_mul : (K * (w : ℚ)) / eps * eps ≤ (T0 : ℚ) * eps := by
              nlinarith
            rw [div_mul_cancel₀ _ (ne_of_gt heps)] at h_eps_mul
            linarith
          linarith
        have h_ch_nonneg : 0 ≤ (Nat.choose (τ + w - 1) (w - 1) : ℚ) := by positivity
        have h_prod : diff τ ≤ eps * (Nat.choose (τ + w - 1) (w - 1) : ℚ) := by
          dsimp [diff]
          have h_diff_le : (clock.R.mulVec (binomBasis w (τ + 1))) b - (clock.R.mulVec (binomBasis w τ)) b ≤
              (K * ((w : ℚ) / (τ + 1 : ℚ))) * (Nat.choose (τ + w - 1) (w - 1) : ℚ) := by
            have := R_mulVec_diff_le_sum hw clock b τ
            dsimp [K]
            linarith
          have h_step : (K * ((w : ℚ) / (τ + 1 : ℚ))) * (Nat.choose (τ + w - 1) (w - 1) : ℚ) ≤
              eps * (Nat.choose (τ + w - 1) (w - 1) : ℚ) :=
            mul_le_mul_of_nonneg_right h_mul_le h_ch_nonneg
          exact le_trans h_diff_le h_step
        have h_prod_len : eps * (Nat.choose (τ + w - 1) (w - 1) : ℚ) ≤
            eps * ((parentWord τ).length : ℚ) :=
          mul_le_mul_of_nonneg_left h_word_len (le_of_lt heps)
        exact le_trans h_prod h_prod_len
    have h_sum_le : (∑ τ ∈ Finset.Ico σ (q + 1), diff τ) ≤
        ∑ τ ∈ Finset.Ico σ (q + 1), (eps * ((parentWord τ).length : ℚ) + (if τ < T0 then rem τ else 0)) :=
      Finset.sum_le_sum (fun τ _ => h_diff_each τ)
    rw [Finset.sum_add_distrib, ← Finset.mul_sum] at h_sum_le
    have h_rem_le : (∑ τ ∈ Finset.Ico σ (q + 1), if τ < T0 then rem τ else 0) ≤ B_const := by
      apply sum_Ico_ite_lt_le_range
      intro τ
      exact le_max_left 0 _
    have h_tele : (∑ τ ∈ Finset.Ico σ (q + 1), diff τ) =
        (clock.R.mulVec (binomBasis w (q + 1))) b - (clock.R.mulVec (binomBasis w σ)) b := by
      exact sum_Ico_sub_adjacent (fun τ => (clock.R.mulVec (binomBasis w τ)) b) σ q hσ
    rw [h_tele] at h_sum_le
    linarith

/-- Active score lower bound during RPS phase word: active action score is at least `σ + 1`. -/
theorem rps_active_score_ge_sigma_add_one (σ r : ℕ) (hr : r < (rpsPhaseWord σ).length) :
    (σ : ℚ) + 1 ≤
      wordScore A_RPS (R2.mulVec (binomBasis 2 σ))
        ((rpsPhaseWord σ).take r) ((rpsPhaseWord σ)[r]) := by
  have hlen : (rpsPhaseWord σ).length = (3 * σ + 5) + (3 * σ + 6) + (3 * σ + 7) := by
    dsimp [rpsPhaseWord]
    simp only [List.length_append, List.length_replicate]
  have hr_len : r < (3 * σ + 5) + (3 * σ + 6) + (3 * σ + 7) := by rwa [hlen] at hr
  have htake : ((rpsPhaseWord σ).take r) =
      (List.replicate (3 * σ + 5) 0).take r ++
      (List.replicate (3 * σ + 6) 1).take (r - (3 * σ + 5)) ++
      (List.replicate (3 * σ + 7) 2).take (r - ((3 * σ + 5) + (3 * σ + 6))) := by
    dsimp [rpsPhaseWord]
    rw [List.take_append, List.take_append]
    simp only [List.length_append, List.length_replicate]
  have h_R : R2.mulVec (binomBasis 2 σ) = r2Vec (σ : ℚ) :=
    (r2Vec_eq_R2_mulVec σ).symm
  have h_pv_raw := isValidPriorityWord_rpsPhaseWord σ (fun _ => (0 : Fin 3))
  have h_pv : IsValidPriorityWord A_RPS (R2.mulVec (binomBasis 2 σ)) (fun _ => (0 : Fin 3)) (rpsPhaseWord σ) :=
    h_pv_raw
  by_cases h0 : r < 3 * σ + 5
  · have hj := (h_pv r hr (0 : Fin 3)).1
    have hc1 : ((rpsPhaseWord σ).take r).count 1 = 0 := by
      rw [htake]
      simp only [List.count_append, List.take_replicate, List.count_replicate]
      split_ifs <;> try contradiction
      omega
    have hc2 : ((rpsPhaseWord σ).take r).count 2 = 0 := by
      rw [htake]
      simp only [List.count_append, List.take_replicate, List.count_replicate]
      split_ifs <;> try contradiction
      omega
    have h_score0 : wordScore A_RPS (R2.mulVec (binomBasis 2 σ))
        ((rpsPhaseWord σ).take r) (0 : Fin 3) = (σ : ℚ) + 1 := by
      rw [h_R]
      dsimp [wordScore, scoreVec, wordCountVec, dotProduct]
      rw [Fin.sum_univ_three]
      have hA00 : A_RPS 0 0 = 0 := rfl
      have hA01 : A_RPS 0 1 = -1 := rfl
      have hA02 : A_RPS 0 2 = 1 := rfl
      have hr0 : r2Vec (σ : ℚ) 0 = (σ : ℚ) + 1 := rfl
      rw [hA00, hA01, hA02, hr0, hc1, hc2]
      ring
    linarith [hj, h_score0]
  · by_cases h1 : r < (3 * σ + 5) + (3 * σ + 6)
    · have hj := (h_pv r hr (1 : Fin 3)).1
      have hc0 : ((rpsPhaseWord σ).take r).count 0 = 3 * σ + 5 := by
        rw [htake]
        simp only [List.count_append, List.take_replicate, List.count_replicate]
        split_ifs <;> try contradiction
        omega
      have hc2 : ((rpsPhaseWord σ).take r).count 2 = 0 := by
        rw [htake]
        simp only [List.count_append, List.take_replicate, List.count_replicate]
        split_ifs <;> try contradiction
        omega
      have h_score1 : wordScore A_RPS (R2.mulVec (binomBasis 2 σ))
          ((rpsPhaseWord σ).take r) (1 : Fin 3) = (σ : ℚ) + 4 / 3 := by
        rw [h_R]
        dsimp [wordScore, scoreVec, wordCountVec, dotProduct]
        rw [Fin.sum_univ_three]
        have hA10 : A_RPS 1 0 = 1 := rfl
        have hA11 : A_RPS 1 1 = 0 := rfl
        have hA12 : A_RPS 1 2 = -1 := rfl
        have hr1 : r2Vec (σ : ℚ) 1 = -2 * (σ : ℚ) - 11 / 3 := rfl
        rw [hA10, hA11, hA12, hr1, hc0, hc2]
        push_cast
        ring
      linarith [hj, h_score1]
    · have hj := (h_pv r hr (2 : Fin 3)).1
      have hc0 : ((rpsPhaseWord σ).take r).count 0 = 3 * σ + 5 := by
        rw [htake]
        simp only [List.count_append, List.take_replicate, List.count_replicate]
        split_ifs <;> try contradiction
        omega
      have hc1 : ((rpsPhaseWord σ).take r).count 1 = 3 * σ + 6 := by
        rw [htake]
        simp only [List.count_append, List.take_replicate, List.count_replicate]
        split_ifs <;> try contradiction
        omega
      have h_score2 : wordScore A_RPS (R2.mulVec (binomBasis 2 σ))
          ((rpsPhaseWord σ).take r) (2 : Fin 3) = (σ : ℚ) + 5 / 3 := by
        rw [h_R]
        dsimp [wordScore, scoreVec, wordCountVec, dotProduct]
        rw [Fin.sum_univ_three]
        have hA20 : A_RPS 2 0 = -1 := rfl
        have hA21 : A_RPS 2 1 = 1 := rfl
        have hA22 : A_RPS 2 2 = 0 := rfl
        have hr2 : r2Vec (σ : ℚ) 2 = (σ : ℚ) + 2 / 3 := rfl
        rw [hA20, hA21, hA22, hr2, hc0, hc1]
        push_cast
        ring
      linarith [hj, h_score2]

/-- **RPS Base-Case Suffix Bound (`rps_hasSuffixBound`, w = 2)**:
    The 3-action RPS clock satisfies `HasSuffixBound` with constant `A = 1`. -/
theorem rps_hasSuffixBound :
    HasSuffixBound rpsFullRankClock.clock b_rps rpsPhaseWord := by
  intro eps heps
  refine ⟨1, by positivity, ?_⟩
  intro σ r hr
  have h_score := rps_active_score_ge_sigma_add_one σ r hr
  have h_Rb : (rpsFullRankClock.clock.R.mulVec (binomBasis 2 (σ + 1))) b_rps = (σ : ℚ) + 2 := by
    dsimp [Matrix.mulVec, dotProduct]
    rw [Fin.sum_univ_two]
    simp [b_rps, rpsFullRankClock, rpsAlgebraicClock, R2, binomBasis]
    ring
  have h_G : rpsFullRankClock.clock.G = A_RPS := rfl
  have h_R : rpsFullRankClock.clock.R = R2 := rfl
  change (rpsFullRankClock.clock.R.mulVec (binomBasis 2 (σ + 1))) b_rps -
      wordScore A_RPS (R2.mulVec (binomBasis 2 σ))
        ((rpsPhaseWord σ).take r) ((rpsPhaseWord σ)[r]) ≤ _
  rw [h_Rb]
  have h_len_nonneg : 0 ≤ eps * (((rpsPhaseWord σ).drop r).length : ℚ) := by positivity
  linarith [h_score, h_len_nonneg]







/-- Positivity of subdiagonal entries of `J_lower_eta`. -/
theorem J_lower_eta_subdiag_pos (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (heta : 0 < eta)
    (hX : ∀ i j, 0 < ((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell - (2 * eta) • L_strict (w + 1)) i j) :
    ∀ a b : Fin ((w + 1) + (w + 1)), b.val < a.val → 0 < J_lower_eta w ell E eta a b := by
  intro a b hab
  obtain ⟨sa, rfl⟩ := finSumFinEquiv.surjective a
  obtain ⟨sb, rfl⟩ := finSumFinEquiv.surjective b
  simp only [J_lower_eta, Matrix.of_apply, Equiv.symm_apply_apply]
  rcases sa with i | i <;> rcases sb with j | j
  · -- Case 1: both early
    dsimp
    simp only [finSumFinEquiv_apply_left, Fin.val_castAdd] at hab
    have hL : L_strict (w + 1) i j = 1 := by
      simp only [L_strict, Matrix.of_apply, if_pos hab]
    rw [hL, mul_one]
    exact heta
  · -- Case 2: a early, b late (impossible since b.val < a.val)
    simp only [finSumFinEquiv_apply_left, finSumFinEquiv_apply_right,
      Fin.val_castAdd, Fin.val_natAdd] at hab
    have hi : i.val < w + 1 := i.isLt
    omega
  · -- Case 3: a late, b early (cross-block X_mid)
    dsimp
    exact hX i j
  · -- Case 4: both late
    dsimp
    simp only [finSumFinEquiv_apply_right, Fin.val_natAdd] at hab
    have hlt : j.val < i.val := by omega
    have hL : L_strict (w + 1) i j = 1 := by
      simp only [L_strict, Matrix.of_apply, if_pos hlt]
    rw [hL, mul_one]
    exact heta

/-- Exact rank-1 factorized conjugation of `E_outer2` under `W_lower_inv`. -/
theorem W_lower_inv_transpose_mul_E_outer2_mul_W_lower_inv {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) (ell : Fin (w + 1) → ℚ) (i j : Fin (w + 1)) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let W_inv := W_lower_inv_u w ell
    (W_inv.transpose * E_outer2 hw clock b c_step H0 alpha * W_inv) i j =
      alpha * (W_inv.transpose.mulVec zeta i) * (W_inv.transpose.mulVec zeta j) := by
  intro zeta W_inv
  have hzeta : zeta_canonical (by omega) clock b c_step H0 = zeta := rfl
  simp only [Matrix.mul_apply, E_outer2, Matrix.of_apply, Matrix.mulVec, dotProduct, hzeta]
  have h_inner : ∀ x : Fin (w + 1),
      (∑ k : Fin (w + 1), W_inv.transpose i k * (alpha * zeta k * zeta x)) =
        (alpha * (∑ k : Fin (w + 1), W_inv.transpose i k * zeta k)) * zeta x := by
    intro x
    have heq : (fun k => W_inv.transpose i k * (alpha * zeta k * zeta x)) =
        fun k => (alpha * zeta x) * (W_inv.transpose i k * zeta k) := by
      funext k; ring
    simp_rw [heq, ← Finset.mul_sum]
    ring
  simp_rw [h_inner]
  have heq2 : (fun x => (alpha * (∑ k : Fin (w + 1), W_inv.transpose i k * zeta k) * zeta x) * W_inv x j) =
      fun x => (alpha * (∑ k : Fin (w + 1), W_inv.transpose i k * zeta k)) * (W_inv.transpose j x * zeta x) := by
    funext x; simp only [Matrix.transpose_apply]; ring
  simp_rw [heq2, ← Finset.mul_sum]

/-- Asymptotic entrywise lower bound on conjugated `E_outer2`. -/
theorem E_outer2_conjugated_ge_inv_alpha {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) (ell ell_base : Fin (w + 1) → ℚ)
    (halpha : 0 < alpha)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ i : Fin w, ell i.succ ≠ 0)
    (hu_def : ∀ c, ell c = alpha * zeta_canonical (by omega) clock b c_step H0 c + ell_base c)
    (h_bound : ∀ k, |((W_lower_inv_u w ell).transpose.mulVec ell_base) k| ≤ 1)
    (i j : Fin (w + 1)) :
    alpha⁻¹ ≤ ((W_lower_inv_u w ell).transpose * E_outer2 hw clock b c_step H0 alpha * W_lower_inv_u w ell) i j := by
  let zeta := zeta_canonical (by omega) clock b c_step H0
  let W_inv := W_lower_inv_u w ell
  rw [W_lower_inv_transpose_mul_E_outer2_mul_W_lower_inv hw clock b c_step H0 alpha ell i j]
  have h_u_hui : ∀ k : Fin w, (fun c => ell c / 2) k.succ ≠ 0 := by
    intro k h
    have h0 : ell k.succ = 0 := by linarith [h]
    exact hui k h0
  have h_u_def : ∀ c : Fin (w + 1), 2 * (ell c / 2) = alpha * zeta c + ell_base c := by
    intro c
    have := hu_def c
    linarith
  have h_vec := alpha_smul_W_lower_inv_transpose_mulVec_zeta w (fun c => ell c / 2) zeta ell_base alpha hu0 h_u_hui h_u_def
  have h_comp : ∀ k : Fin (w + 1), 1 ≤ alpha * W_inv.transpose.mulVec zeta k := by
    intro k
    have hk := congr_fun h_vec k
    change alpha * (W_lower_inv_u w ell).transpose.mulVec zeta k =
      2 - (W_lower_inv_u w ell).transpose.mulVec ell_base k at hk
    have hb := h_bound k
    have h_le : W_inv.transpose.mulVec ell_base k ≤ 1 := (abs_le.mp hb).2
    linarith
  have hi := h_comp i
  have hj := h_comp j
  have h_prod : 1 ≤ (alpha * W_inv.transpose.mulVec zeta i) * (alpha * W_inv.transpose.mulVec zeta j) := by
    nlinarith
  have h_ne : alpha ≠ 0 := ne_of_gt halpha
  have h_id : alpha * (W_inv.transpose.mulVec zeta i) * (W_inv.transpose.mulVec zeta j) =
      alpha⁻¹ * ((alpha * W_inv.transpose.mulVec zeta i) * (alpha * W_inv.transpose.mulVec zeta j)) := by
    have h_prod_comm : (alpha * W_inv.transpose.mulVec zeta i) * (alpha * W_inv.transpose.mulVec zeta j) =
        alpha * (alpha * (W_inv.transpose.mulVec zeta i) * (W_inv.transpose.mulVec zeta j)) := by ring
    rw [h_prod_comm, ← mul_assoc, inv_mul_cancel₀ h_ne, one_mul]
  rw [h_id]
  have h_inv_pos : 0 < alpha⁻¹ := inv_pos.mpr halpha
  calc alpha⁻¹ = alpha⁻¹ * 1 := (mul_one alpha⁻¹).symm
    _ ≤ alpha⁻¹ * ((alpha * W_inv.transpose.mulVec zeta i) * (alpha * W_inv.transpose.mulVec zeta j)) :=
        mul_le_mul_of_nonneg_left h_prod (le_of_lt h_inv_pos)

/-- On the early block `Sum.inl i`, `J_lower_eta * M_lower = eta • (L_strict * W)`. -/
theorem J_lower_eta_mul_M_lower_inl (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (i : Fin (w + 1)) :
    (fun c => (J_lower_eta w ell E eta * M_lower w ell) (finSumFinEquiv (Sum.inl i)) c) =
      fun c => eta * (L_strict (w + 1) * W_lower_u w ell) i c := by
  ext c
  rw [Matrix.mul_apply]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      J_lower_eta w ell E eta (finSumFinEquiv (Sum.inl i)) r * M_lower w ell r c).symm
  rw [hcomp, Fintype.sum_sum_type]
  simp only [J_lower_eta, M_lower, Matrix.of_apply, Equiv.symm_apply_apply,
    zero_mul, Finset.sum_const_zero, add_zero]
  simp only [Matrix.mul_apply, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro x _
  ring

/-- On the late block `Sum.inr j`, `J_lower_eta * M_lower = (W_lower_inv_u)ᵀ * E - eta • (L_strict * W)`. -/
theorem J_lower_eta_mul_M_lower_inr (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ k : Fin w, ell k.succ ≠ 0)
    (j : Fin (w + 1)) :
    (fun c => (J_lower_eta w ell E eta * M_lower w ell) (finSumFinEquiv (Sum.inr j)) c) =
      fun c => ((W_lower_inv_u w ell).transpose * E) j c - eta * (L_strict (w + 1) * W_lower_u w ell) j c := by
  ext c
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      J_lower_eta w ell E eta (finSumFinEquiv (Sum.inr j)) r * M_lower w ell r c).symm
  rw [Matrix.mul_apply, hcomp, Fintype.sum_sum_type]
  simp only [J_lower_eta, M_lower, Matrix.of_apply, Equiv.symm_apply_apply]
  simp only [Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul, sub_mul]
  rw [Finset.sum_sub_distrib]
  have hui' : ∀ i : Fin w, (fun k => ell k / 2) i.succ ≠ 0 := by
    intro i h
    have : ell i.succ = 0 := by linarith [h]
    exact hui i this
  have hinv : W_lower_inv_u w ell * W_lower_u w ell = 1 :=
    W_lower_inv_mul_W_lower (fun k => ell k / 2) hu0 hui'
  have hsum :
      (∑ i : Fin (w + 1), ((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell) j i * W_lower_u w ell i c) =
        (((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell) * W_lower_u w ell) j c := rfl
  rw [hsum, Matrix.mul_assoc, hinv, Matrix.mul_one]
  have h2 : (∑ i : Fin (w + 1), (2 * eta) * L_strict (w + 1) j i * W_lower_u w ell i c) =
      2 * (eta * (L_strict (w + 1) * W_lower_u w ell) j c) := by
    simp only [Matrix.mul_apply, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring
  have h1 : (∑ i : Fin (w + 1), eta * L_strict (w + 1) j i * W_lower_u w ell i c) =
      eta * (L_strict (w + 1) * W_lower_u w ell) j c := by
    simp only [Matrix.mul_apply, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [h2, h1]
  ring

/-- On the early block `Sum.inl i`, `(J_lower_eta)ᵀ * M_lower = (W_lower_inv_u)ᵀ * Eᵀ - eta • (L_strictᵀ * W)`. -/
theorem J_lower_eta_transpose_mul_M_lower_inl (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ k : Fin w, ell k.succ ≠ 0)
    (i : Fin (w + 1)) :
    (fun c => ((J_lower_eta w ell E eta).transpose * M_lower w ell) (finSumFinEquiv (Sum.inl i)) c) =
      fun c => ((W_lower_inv_u w ell).transpose * E.transpose) i c - eta * ((L_strict (w + 1)).transpose * W_lower_u w ell) i c := by
  ext c
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      (J_lower_eta w ell E eta).transpose (finSumFinEquiv (Sum.inl i)) r * M_lower w ell r c).symm
  rw [Matrix.mul_apply, hcomp, Fintype.sum_sum_type]
  simp only [Matrix.transpose_apply, J_lower_eta, M_lower, Matrix.of_apply, Equiv.symm_apply_apply]
  simp only [Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul, sub_mul]
  rw [Finset.sum_sub_distrib]
  have hui' : ∀ j : Fin w, (fun k => ell k / 2) j.succ ≠ 0 := by
    intro j h
    have : ell j.succ = 0 := by linarith [h]
    exact hui j this
  have hinv : W_lower_inv_u w ell * W_lower_u w ell = 1 :=
    W_lower_inv_mul_W_lower (fun k => ell k / 2) hu0 hui'
  have h_trans : (∑ x : Fin (w + 1), ((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell) x i * W_lower_u w ell x c) =
      (∑ x : Fin (w + 1), ((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell).transpose i x * W_lower_u w ell x c) := by
    simp_rw [Matrix.transpose_apply]
  rw [h_trans]
  have hsum :
      (∑ j : Fin (w + 1), ((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell).transpose i j * W_lower_u w ell j c) =
        ((((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell).transpose) * W_lower_u w ell) i c := rfl
  rw [hsum]
  simp only [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.mul_assoc]
  rw [hinv, Matrix.mul_one]
  have h1 : (∑ x : Fin (w + 1), eta * L_strict (w + 1) x i * W_lower_u w ell x c) =
      eta * ((L_strict (w + 1)).transpose * W_lower_u w ell) i c := by
    simp only [Matrix.transpose_apply, Matrix.mul_apply, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro x _
    ring
  have h2 : (∑ x : Fin (w + 1), (2 * eta) * L_strict (w + 1) x i * W_lower_u w ell x c) =
      2 * (eta * ((L_strict (w + 1)).transpose * W_lower_u w ell) i c) := by
    simp only [Matrix.transpose_apply, Matrix.mul_apply, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro x _
    ring
  rw [h1, h2]
  ring

/-- On the late block `Sum.inr j`, `(J_lower_eta)ᵀ * M_lower = eta • (L_strictᵀ * W)`. -/
theorem J_lower_eta_transpose_mul_M_lower_inr (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (j : Fin (w + 1)) :
    (fun c => ((J_lower_eta w ell E eta).transpose * M_lower w ell) (finSumFinEquiv (Sum.inr j)) c) =
      fun c => eta * ((L_strict (w + 1)).transpose * W_lower_u w ell) j c := by
  ext c
  rw [Matrix.mul_apply]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      (J_lower_eta w ell E eta).transpose (finSumFinEquiv (Sum.inr j)) r * M_lower w ell r c).symm
  rw [hcomp, Fintype.sum_sum_type]
  simp only [Matrix.transpose_apply, J_lower_eta, M_lower, Matrix.of_apply, Equiv.symm_apply_apply,
    zero_mul, Finset.sum_const_zero, zero_add]
  simp only [Matrix.mul_apply, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro x _
  simp only [Matrix.transpose_apply]
  ring

/-- Closed form for `Q_reset` with `J_lower_eta` on the early block `Sum.inl i`. -/
theorem Q_reset_lower_eta_inl (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ) (zeta : Fin (w + 1) → ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (i : Fin (w + 1)) :
    (fun c => Q_reset (J_lower_eta w ell E eta) (M_lower w ell) (B_mat (w + 1)) zeta (finSumFinEquiv (Sum.inl i)) c) =
      fun c => (Matrix.vecMul zeta (B_mat (w + 1))) c - zeta c -
        (((W_lower_inv_u w ell).transpose * E.transpose) * B_mat (w + 1)) i c +
        eta * (L_strict (w + 1) * W_lower_u w ell) i c +
        eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) i c := by
  ext c
  change (one_zeta (Fin ((w + 1) + (w + 1))) zeta * B_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) c -
      (one_zeta (Fin ((w + 1) + (w + 1))) zeta) (finSumFinEquiv (Sum.inl i)) c +
      (J_lower_eta w ell E eta * M_lower w ell) (finSumFinEquiv (Sum.inl i)) c -
      ((J_lower_eta w ell E eta).transpose * M_lower w ell * B_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) c = _
  have hJM : (J_lower_eta w ell E eta * M_lower w ell) (finSumFinEquiv (Sum.inl i)) c =
      eta * (L_strict (w + 1) * W_lower_u w ell) i c := by
    exact congr_fun (J_lower_eta_mul_M_lower_inl w ell E eta i) c
  have hJTM : ((J_lower_eta w ell E eta).transpose * M_lower w ell * B_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) c =
      (((W_lower_inv_u w ell).transpose * E.transpose) * B_mat (w + 1)) i c -
      eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) i c := by
    rw [Matrix.mul_apply, Matrix.mul_apply, Matrix.mul_apply]
    have hsum : (∑ x : Fin (w + 1), ((J_lower_eta w ell E eta).transpose * M_lower w ell) (finSumFinEquiv (Sum.inl i)) x * B_mat (w + 1) x c) =
        ∑ x : Fin (w + 1), (((W_lower_inv_u w ell).transpose * E.transpose) i x -
          eta * ((L_strict (w + 1)).transpose * W_lower_u w ell) i x) * B_mat (w + 1) x c := by
      apply Finset.sum_congr rfl
      intro x _
      have hx := congr_fun (J_lower_eta_transpose_mul_M_lower_inl w ell E eta hu0 hui i) x
      rw [hx]
    rw [hsum]
    simp only [sub_mul, Finset.sum_sub_distrib]
    congr 1
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro x _
    ring
  have honeB : (one_zeta (Fin ((w + 1) + (w + 1))) zeta * B_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) c =
      (Matrix.vecMul zeta (B_mat (w + 1))) c := rfl
  have hone : (one_zeta (Fin ((w + 1) + (w + 1))) zeta) (finSumFinEquiv (Sum.inl i)) c = zeta c := rfl
  rw [hJM, hJTM, honeB, hone]
  ring

/-- Closed form for `Q_reset` with `J_lower_eta` on the late block `Sum.inr j`. -/
theorem Q_reset_lower_eta_inr (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ) (zeta : Fin (w + 1) → ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ k : Fin w, ell k.succ ≠ 0)
    (j : Fin (w + 1)) :
    (fun c => Q_reset (J_lower_eta w ell E eta) (M_lower w ell) (B_mat (w + 1)) zeta (finSumFinEquiv (Sum.inr j)) c) =
      fun c => (Matrix.vecMul zeta (B_mat (w + 1))) c - zeta c +
        ((W_lower_inv_u w ell).transpose * E) j c -
        eta * (L_strict (w + 1) * W_lower_u w ell) j c -
        eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) j c := by
  ext c
  change (one_zeta (Fin ((w + 1) + (w + 1))) zeta * B_mat (w + 1)) (finSumFinEquiv (Sum.inr j)) c -
      (one_zeta (Fin ((w + 1) + (w + 1))) zeta) (finSumFinEquiv (Sum.inr j)) c +
      (J_lower_eta w ell E eta * M_lower w ell) (finSumFinEquiv (Sum.inr j)) c -
      ((J_lower_eta w ell E eta).transpose * M_lower w ell * B_mat (w + 1)) (finSumFinEquiv (Sum.inr j)) c = _
  have hJM : (J_lower_eta w ell E eta * M_lower w ell) (finSumFinEquiv (Sum.inr j)) c =
      ((W_lower_inv_u w ell).transpose * E) j c - eta * (L_strict (w + 1) * W_lower_u w ell) j c := by
    exact congr_fun (J_lower_eta_mul_M_lower_inr w ell E eta hu0 hui j) c
  have hJTM : ((J_lower_eta w ell E eta).transpose * M_lower w ell * B_mat (w + 1)) (finSumFinEquiv (Sum.inr j)) c =
      eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) j c := by
    rw [Matrix.mul_apply, Matrix.mul_apply]
    have hsum : (∑ x : Fin (w + 1), ((J_lower_eta w ell E eta).transpose * M_lower w ell) (finSumFinEquiv (Sum.inr j)) x * B_mat (w + 1) x c) =
        ∑ x : Fin (w + 1), (eta * ((L_strict (w + 1)).transpose * W_lower_u w ell) j x) * B_mat (w + 1) x c := by
      apply Finset.sum_congr rfl
      intro x _
      have hx := congr_fun (J_lower_eta_transpose_mul_M_lower_inr w ell E eta j) x
      rw [hx]
    rw [hsum]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro x _
    ring
  have honeB : (one_zeta (Fin ((w + 1) + (w + 1))) zeta * B_mat (w + 1)) (finSumFinEquiv (Sum.inr j)) c =
      (Matrix.vecMul zeta (B_mat (w + 1))) c := rfl
  have hone : (one_zeta (Fin ((w + 1) + (w + 1))) zeta) (finSumFinEquiv (Sum.inr j)) c = zeta c := rfl
  rw [hJM, hJTM, honeB, hone]
  ring



/-- Early projection of `P0_cone_old` against `X_gateway`. -/
theorem P0_cone_old_transpose_mul_X_inl {w : ℕ} (clock : AlgebraicClock w)
    (a_old : Fin (clock.m + 1) → ℚ) (i : Fin (w + 1)) (c : Fin (w + 1)) :
    ((P0_cone_old a_old w).transpose * X_gateway clock) (finSumFinEquiv (Sum.inl i)) c =
      - Matrix.vecMul a_old (X_gateway clock) c :=
  P0_cone_transpose_mul_X_inl clock a_old _ rfl i c

/-- Late projection of `P0_cone_old` against `X_gateway`. -/
theorem P0_cone_old_transpose_mul_X_inr {w : ℕ} (clock : AlgebraicClock w)
    (a_old : Fin (clock.m + 1) → ℚ) (j : Fin (w + 1)) (c : Fin (w + 1)) :
    ((P0_cone_old a_old w).transpose * X_gateway clock) (finSumFinEquiv (Sum.inr j)) c =
      Matrix.vecMul a_old (X_gateway clock) c :=
  P0_cone_transpose_mul_X_inr clock a_old _ rfl j c

/-- Symmetry of `E_outer2`. -/
theorem E_outer2_transpose {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) :
    (E_outer2 hw clock b c_step H0 alpha).transpose = E_outer2 hw clock b c_step H0 alpha := by
  ext x y
  simp only [Matrix.transpose_apply, E_outer2, Matrix.of_apply]
  ring

/-- Exact rank-1 factorized action of `(W_lower_inv_u)ᵀ * E_outer2`. -/
theorem W_lower_inv_transpose_mul_E_outer2 {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) (ell : Fin (w + 1) → ℚ)
    (j c : Fin (w + 1)) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    ((W_lower_inv_u w ell).transpose * E_outer2 hw clock b c_step H0 alpha) j c =
      alpha * ((W_lower_inv_u w ell).transpose.mulVec zeta j) * zeta c := by
  intro zeta
  have hzeta : zeta_canonical (by omega) clock b c_step H0 = zeta := rfl
  simp only [Matrix.mul_apply, E_outer2, Matrix.of_apply, Matrix.mulVec, dotProduct, hzeta]
  have heq : (fun x : Fin (w + 1) => (W_lower_inv_u w ell).transpose j x * (alpha * zeta x * zeta c)) =
      fun x => (alpha * zeta c) * ((W_lower_inv_u w ell).transpose j x * zeta x) := by
    funext x; ring
  simp_rw [heq, ← Finset.mul_sum]
  ring

/-- Exact rank-1 factorized action of `(W_lower_inv_u)ᵀ * E_outer2ᵀ * B`. -/
theorem W_lower_inv_transpose_mul_E_outer2_transpose_mul_B {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) (ell : Fin (w + 1) → ℚ)
    (i c : Fin (w + 1)) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    ((W_lower_inv_u w ell).transpose * (E_outer2 hw clock b c_step H0 alpha).transpose * B_mat (w + 1)) i c =
      alpha * ((W_lower_inv_u w ell).transpose.mulVec zeta i) * (Matrix.vecMul zeta (B_mat (w + 1)) c) := by
  intro zeta
  rw [E_outer2_transpose]
  rw [Matrix.mul_apply]
  have h_inner : ∀ x : Fin (w + 1),
      ((W_lower_inv_u w ell).transpose * E_outer2 hw clock b c_step H0 alpha) i x =
        alpha * ((W_lower_inv_u w ell).transpose.mulVec zeta i) * zeta x := by
    intro x
    exact W_lower_inv_transpose_mul_E_outer2 hw clock b c_step H0 alpha ell i x
  simp_rw [h_inner]
  simp only [Matrix.vecMul, dotProduct]
  have heq : (fun x : Fin (w + 1) => alpha * ((W_lower_inv_u w ell).transpose.mulVec zeta i) * zeta x * B_mat (w + 1) x c) =
      fun x => (alpha * ((W_lower_inv_u w ell).transpose.mulVec zeta i)) * (zeta x * B_mat (w + 1) x c) := by
    funext x; ring
  simp_rw [heq, ← Finset.mul_sum]

/-- Exact cone-cancellation of leading `-(zeta + zeta * B)` on early block `Sum.inl i`. -/
theorem Q_res_lower_eta_cone_inl {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) (ell ell_base : Fin (w + 1) → ℚ) (eta : ℚ)
    (a_old : Fin (clock.m + 1) → ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (hu_def : ∀ c, ell c = alpha * zeta_canonical (by omega) clock b c_step H0 c + ell_base c)
    (h_cone : Matrix.vecMul a_old (X_gateway clock) =
      Matrix.vecMul (zeta_canonical (by omega) clock b c_step H0) (1 + B_mat (w + 1)))
    (i : Fin (w + 1)) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let E := E_outer2 hw clock b c_step H0 alpha
    let J := J_lower_eta w ell E eta
    let M := M_lower w ell
    let Q := Q_reset J M (B_mat (w + 1)) zeta
    let P0 := P0_cone_old a_old w
    let X := X_gateway clock
    (fun c => (Q_res Q P0 X) (finSumFinEquiv (Sum.inl i)) c) =
      fun c => ((W_lower_inv_u w ell).transpose.mulVec ell_base i) * (Matrix.vecMul zeta (B_mat (w + 1)) c) +
        eta * (L_strict (w + 1) * W_lower_u w ell) i c +
        eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) i c := by
  intro zeta E J M Q P0 X
  ext c
  have h_res : (Q_res Q P0 X) (finSumFinEquiv (Sum.inl i)) c =
      Q (finSumFinEquiv (Sum.inl i)) c - (P0.transpose * X) (finSumFinEquiv (Sum.inl i)) c := rfl
  rw [h_res]
  have hP0 : (P0.transpose * X) (finSumFinEquiv (Sum.inl i)) c =
      - (zeta c + Matrix.vecMul zeta (B_mat (w + 1)) c) := by
    rw [P0_cone_old_transpose_mul_X_inl clock a_old i c]
    have hc := congr_fun h_cone c
    simp only [Matrix.vecMul_add, Matrix.vecMul_one, Pi.add_apply] at hc
    rw [hc]
  have hQ : Q (finSumFinEquiv (Sum.inl i)) c =
      Matrix.vecMul zeta (B_mat (w + 1)) c - zeta c -
        (((W_lower_inv_u w ell).transpose * E.transpose) * B_mat (w + 1)) i c +
        eta * (L_strict (w + 1) * W_lower_u w ell) i c +
        eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) i c :=
    congr_fun (Q_reset_lower_eta_inl w ell E eta zeta hu0 hui i) c
  have hE : (((W_lower_inv_u w ell).transpose * E.transpose) * B_mat (w + 1)) i c =
      alpha * ((W_lower_inv_u w ell).transpose.mulVec zeta i) * (Matrix.vecMul zeta (B_mat (w + 1)) c) :=
    W_lower_inv_transpose_mul_E_outer2_transpose_mul_B hw clock b c_step H0 alpha ell i c
  have h_u_hui : ∀ k : Fin w, (fun c => ell c / 2) k.succ ≠ 0 := by
    intro k h
    have h0 : ell k.succ = 0 := by linarith [h]
    exact hui k h0
  have h_u_def : ∀ c : Fin (w + 1), 2 * (ell c / 2) = alpha * zeta c + ell_base c := by
    intro c
    have := hu_def c
    linarith
  have h_vec := alpha_smul_W_lower_inv_transpose_mulVec_zeta w (fun c => ell c / 2) zeta ell_base alpha hu0 h_u_hui h_u_def
  have hi := congr_fun h_vec i
  change alpha * (W_lower_inv_u w ell).transpose.mulVec zeta i =
    2 - (W_lower_inv_u w ell).transpose.mulVec ell_base i at hi
  rw [hQ, hP0, hE]
  have h_subst : alpha * (W_lower_inv_u w ell).transpose.mulVec zeta i * Matrix.vecMul zeta (B_mat (w + 1)) c =
      (2 - (W_lower_inv_u w ell).transpose.mulVec ell_base i) * Matrix.vecMul zeta (B_mat (w + 1)) c := by
    rw [hi]
  rw [h_subst]
  ring

/-- Exact cone-cancellation of leading `+(zeta + zeta * B)` on late block `Sum.inr j`. -/
theorem Q_res_lower_eta_cone_inr {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) (ell ell_base : Fin (w + 1) → ℚ) (eta : ℚ)
    (a_old : Fin (clock.m + 1) → ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (hu_def : ∀ c, ell c = alpha * zeta_canonical (by omega) clock b c_step H0 c + ell_base c)
    (h_cone : Matrix.vecMul a_old (X_gateway clock) =
      Matrix.vecMul (zeta_canonical (by omega) clock b c_step H0) (1 + B_mat (w + 1)))
    (j : Fin (w + 1)) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let E := E_outer2 hw clock b c_step H0 alpha
    let J := J_lower_eta w ell E eta
    let M := M_lower w ell
    let Q := Q_reset J M (B_mat (w + 1)) zeta
    let P0 := P0_cone_old a_old w
    let X := X_gateway clock
    (fun c => (Q_res Q P0 X) (finSumFinEquiv (Sum.inr j)) c) =
      fun c => - (((W_lower_inv_u w ell).transpose.mulVec ell_base j) * zeta c) -
        eta * (L_strict (w + 1) * W_lower_u w ell) j c -
        eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) j c := by
  intro zeta E J M Q P0 X
  ext c
  have h_res : (Q_res Q P0 X) (finSumFinEquiv (Sum.inr j)) c =
      Q (finSumFinEquiv (Sum.inr j)) c - (P0.transpose * X) (finSumFinEquiv (Sum.inr j)) c := rfl
  rw [h_res]
  have hP0 : (P0.transpose * X) (finSumFinEquiv (Sum.inr j)) c =
      zeta c + Matrix.vecMul zeta (B_mat (w + 1)) c := by
    rw [P0_cone_old_transpose_mul_X_inr clock a_old j c]
    have hc := congr_fun h_cone c
    simp only [Matrix.vecMul_add, Matrix.vecMul_one, Pi.add_apply] at hc
    rw [hc]
  have hQ : Q (finSumFinEquiv (Sum.inr j)) c =
      Matrix.vecMul zeta (B_mat (w + 1)) c - zeta c +
        ((W_lower_inv_u w ell).transpose * E) j c -
        eta * (L_strict (w + 1) * W_lower_u w ell) j c -
        eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) j c :=
    congr_fun (Q_reset_lower_eta_inr w ell E eta zeta hu0 hui j) c
  have hE : ((W_lower_inv_u w ell).transpose * E) j c =
      alpha * ((W_lower_inv_u w ell).transpose.mulVec zeta j) * zeta c :=
    W_lower_inv_transpose_mul_E_outer2 hw clock b c_step H0 alpha ell j c
  have h_u_hui : ∀ k : Fin w, (fun c => ell c / 2) k.succ ≠ 0 := by
    intro k h
    have h0 : ell k.succ = 0 := by linarith [h]
    exact hui k h0
  have h_u_def : ∀ c : Fin (w + 1), 2 * (ell c / 2) = alpha * zeta c + ell_base c := by
    intro c
    have := hu_def c
    linarith
  have h_vec := alpha_smul_W_lower_inv_transpose_mulVec_zeta w (fun c => ell c / 2) zeta ell_base alpha hu0 h_u_hui h_u_def
  have hj := congr_fun h_vec j
  change alpha * (W_lower_inv_u w ell).transpose.mulVec zeta j =
    2 - (W_lower_inv_u w ell).transpose.mulVec ell_base j at hj
  rw [hQ, hP0, hE]
  have h_subst : alpha * (W_lower_inv_u w ell).transpose.mulVec zeta j * zeta c =
      (2 - (W_lower_inv_u w ell).transpose.mulVec ell_base j) * zeta c := by
    rw [hj]
  rw [h_subst]
  ring


/-- On late columns `Sum.inr j`, `1 - M * R_M` acts as the identity column. -/
theorem one_sub_M_lower_mul_R_M_lower_inr (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (r : Fin ((w + 1) + (w + 1))) (j : Fin (w + 1)) :
    ((1 : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ) - M_lower w ell * R_M_lower w ell) r (finSumFinEquiv (Sum.inr j)) =
      if r = finSumFinEquiv (Sum.inr j) then 1 else 0 := by
  simp only [Matrix.sub_apply, Matrix.one_apply]
  have h_mul : (M_lower w ell * R_M_lower w ell) r (finSumFinEquiv (Sum.inr j)) = 0 := by
    rw [Matrix.mul_apply]
    refine Finset.sum_eq_zero fun x _ => ?_
    simp only [R_M_lower, Matrix.of_apply, Equiv.symm_apply_apply, mul_zero]
  rw [h_mul, sub_zero]

/-- On early column `Sum.inl i`, entry at `Sum.inl k` of `1 - M * R_M` vanishes. -/
theorem one_sub_M_lower_mul_R_M_lower_inl_inl (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (k i : Fin (w + 1)) :
    ((1 : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ) - M_lower w ell * R_M_lower w ell) (finSumFinEquiv (Sum.inl k)) (finSumFinEquiv (Sum.inl i)) = 0 := by
  simp only [Matrix.sub_apply, Matrix.one_apply]
  have hui' : ∀ j : Fin w, (fun c => ell c / 2) j.succ ≠ 0 := by
    intro j h
    have : ell j.succ = 0 := by linarith [h]
    exact hui j this
  have hW_inv : W_lower_u w ell * W_lower_inv_u w ell = 1 :=
    W_lower_mul_W_lower_inv (fun c => ell c / 2) hu0 hui'
  have h_mul : (M_lower w ell * R_M_lower w ell) (finSumFinEquiv (Sum.inl k)) (finSumFinEquiv (Sum.inl i)) =
      if k = i then 1 else 0 := by
    rw [Matrix.mul_apply]
    have heq_M : ∀ x : Fin (w + 1), M_lower w ell (finSumFinEquiv (Sum.inl k)) x = W_lower_u w ell k x := by
      intro x; simp only [M_lower, Matrix.of_apply, Equiv.symm_apply_apply]
    have heq_R : ∀ x : Fin (w + 1), R_M_lower w ell x (finSumFinEquiv (Sum.inl i)) = W_lower_inv_u w ell x i := by
      intro x; simp only [R_M_lower, Matrix.of_apply, Equiv.symm_apply_apply]
    simp_rw [heq_M, heq_R]
    have hone : (∑ x : Fin (w + 1), W_lower_u w ell k x * W_lower_inv_u w ell x i) =
        (W_lower_u w ell * W_lower_inv_u w ell) k i := rfl
    rw [hone, hW_inv, Matrix.one_apply]
  rw [h_mul]
  by_cases h : k = i
  · subst h
    simp
  · have hneq : (finSumFinEquiv (Sum.inl k) : Fin ((w + 1) + (w + 1))) ≠ finSumFinEquiv (Sum.inl i) := by
      intro heq
      have : (Sum.inl k : Fin (w + 1) ⊕ Fin (w + 1)) = Sum.inl i := finSumFinEquiv.injective heq
      cases this
      exact h rfl
    rw [if_neg hneq, if_neg h, sub_zero]

/-- On early column `Sum.inl i`, entry at `Sum.inr k` of `1 - M * R_M` is `-1` if `k = i` else `0`. -/
theorem one_sub_M_lower_mul_R_M_lower_inl_inr (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (k i : Fin (w + 1)) :
    ((1 : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ) - M_lower w ell * R_M_lower w ell) (finSumFinEquiv (Sum.inr k)) (finSumFinEquiv (Sum.inl i)) =
      if k = i then -1 else 0 := by
  simp only [Matrix.sub_apply, Matrix.one_apply]
  have hui' : ∀ j : Fin w, (fun c => ell c / 2) j.succ ≠ 0 := by
    intro j h
    have : ell j.succ = 0 := by linarith [h]
    exact hui j this
  have hW_inv : W_lower_u w ell * W_lower_inv_u w ell = 1 :=
    W_lower_mul_W_lower_inv (fun c => ell c / 2) hu0 hui'
  have h_mul : (M_lower w ell * R_M_lower w ell) (finSumFinEquiv (Sum.inr k)) (finSumFinEquiv (Sum.inl i)) =
      if k = i then 1 else 0 := by
    rw [Matrix.mul_apply]
    have heq_M : ∀ x : Fin (w + 1), M_lower w ell (finSumFinEquiv (Sum.inr k)) x = W_lower_u w ell k x := by
      intro x; simp only [M_lower, Matrix.of_apply, Equiv.symm_apply_apply]
    have heq_R : ∀ x : Fin (w + 1), R_M_lower w ell x (finSumFinEquiv (Sum.inl i)) = W_lower_inv_u w ell x i := by
      intro x; simp only [R_M_lower, Matrix.of_apply, Equiv.symm_apply_apply]
    simp_rw [heq_M, heq_R]
    have hone : (∑ x : Fin (w + 1), W_lower_u w ell k x * W_lower_inv_u w ell x i) =
        (W_lower_u w ell * W_lower_inv_u w ell) k i := rfl
    rw [hone, hW_inv, Matrix.one_apply]
  have hneq : finSumFinEquiv (Sum.inr k) ≠ finSumFinEquiv (Sum.inl i) := by
    intro heq
    have hsymm : Sum.inr k = (Sum.inl i : Fin (w + 1) ⊕ Fin (w + 1)) := finSumFinEquiv.injective heq
    cases hsymm
  rw [if_neg hneq, h_mul]
  by_cases h : k = i
  · subst h; simp
  · simp [h]


/-- On late columns `Sum.inr j`, `P_interp` reduces to `a_old + L_X * Q_resᵀ`. -/
theorem P_interp_lower_inr {w : ℕ} (clock : AlgebraicClock w)
    (a_old : Fin (clock.m + 1) → ℚ) (ell : Fin (w + 1) → ℚ)
    (D : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (Q : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (j : Fin (w + 1)) (x : Fin (clock.m + 1)) :
    let X := X_gateway clock
    let L_X := L_X_gateway L_C
    let M := M_lower w ell
    let R_M := R_M_lower w ell
    let P0 := P0_cone_old a_old w
    P_interp X L_X M R_M D Q P0 x (finSumFinEquiv (Sum.inr j)) =
      a_old x + ∑ c : Fin (w + 1), L_X x c * Q_res Q P0 X (finSumFinEquiv (Sum.inr j)) c := by
  intro X L_X M R_M P0
  have hRM : ∀ c : Fin (w + 1), R_M c (finSumFinEquiv (Sum.inr j)) = 0 := by
    intro c
    simp only [R_M, R_M_lower, Matrix.of_apply, Equiv.symm_apply_apply]
  rw [P_interp_col_of_R_M_zero X L_X M R_M D Q P0 (finSumFinEquiv (Sum.inr j)) hRM x]
  have hP0 : P0 x (finSumFinEquiv (Sum.inr j)) = a_old x := by
    simp only [P0, P0_cone_old, P0_cone, Matrix.of_apply, Equiv.symm_apply_apply]
  rw [hP0]
  rfl

/-- On early columns `Sum.inl i`, `P_interp` reduces to `- a_old + D * W_inv - L_X * Q_res(inr i)ᵀ`. -/
theorem P_interp_lower_inl {w : ℕ} (clock : AlgebraicClock w)
    (a_old : Fin (clock.m + 1) → ℚ) (ell : Fin (w + 1) → ℚ)
    (D : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (Q : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (h_compat : D.transpose * X_gateway clock = (M_lower w ell).transpose * Q)
    (i : Fin (w + 1)) (x : Fin (clock.m + 1)) :
    let X := X_gateway clock
    let L_X := L_X_gateway L_C
    let M := M_lower w ell
    let R_M := R_M_lower w ell
    let P0 := P0_cone_old a_old w
    P_interp X L_X M R_M D Q P0 x (finSumFinEquiv (Sum.inl i)) =
      - a_old x + (∑ c : Fin (w + 1), D x c * W_lower_inv_u w ell c i) -
        ∑ c : Fin (w + 1), L_X x c * Q_res Q P0 X (finSumFinEquiv (Sum.inr i)) c := by
  intro X L_X M R_M P0
  dsimp only [P_interp]
  simp only [Matrix.add_apply]
  have hP0 : P0 x (finSumFinEquiv (Sum.inl i)) = - a_old x := by
    simp only [P0, P0_cone_old, P0_cone, Matrix.of_apply, Equiv.symm_apply_apply]
  have hDR : D_res D P0 M = D := D_res_P0_cone_old_M_lower D a_old ell
  have hDR_RM : (D_res D P0 M * R_M) x (finSumFinEquiv (Sum.inl i)) =
      ∑ c : Fin (w + 1), D x c * W_lower_inv_u w ell c i := by
    rw [hDR, Matrix.mul_apply]
    apply Finset.sum_congr rfl
    intro c _
    simp only [R_M, R_M_lower, Matrix.of_apply, Equiv.symm_apply_apply]
  rw [hP0, hDR_RM]
  have h_compat_QR : X.transpose * D = (Q_res Q P0 X).transpose * M := by
    have h1 : X.transpose * D = (D.transpose * X).transpose := by
      simp only [Matrix.transpose_mul, Matrix.transpose_transpose]
    rw [h1, h_compat]
    simp only [Matrix.transpose_mul, Matrix.transpose_transpose]
    dsimp [Q_res]
    simp only [Matrix.sub_mul, Matrix.transpose_sub, Matrix.transpose_mul, Matrix.transpose_transpose]
    have hP0M : P0 * M = 0 := P0_cone_old_mul_M_lower a_old ell
    rw [Matrix.mul_assoc, hP0M, Matrix.mul_zero, sub_zero]
  have h_inner_eq : (Q_res Q P0 X).transpose - X.transpose * D_res D P0 M * R_M =
      (Q_res Q P0 X).transpose *
        ((1 : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ) - M * R_M) := by
    rw [hDR, h_compat_QR, Matrix.mul_assoc, Matrix.mul_sub, Matrix.mul_one]
  have h_LX_eq : L_X * ((Q_res Q P0 X).transpose - X.transpose * D_res D P0 M * R_M) =
      (L_X * (Q_res Q P0 X).transpose) *
        ((1 : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ) - M * R_M) := by
    rw [h_inner_eq, Matrix.mul_assoc]
  have h_LX_col : (L_X * ((Q_res Q P0 X).transpose - X.transpose * D_res D P0 M * R_M)) x (finSumFinEquiv (Sum.inl i)) =
      - ∑ c : Fin (w + 1), L_X x c * Q_res Q P0 X (finSumFinEquiv (Sum.inr i)) c := by
    rw [h_LX_eq, Matrix.mul_apply]
    have hcomp :=
      (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
        (L_X * (Q_res Q P0 X).transpose) x r *
          ((1 : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ) - M * R_M) r (finSumFinEquiv (Sum.inl i))).symm
    rw [hcomp, Fintype.sum_sum_type]
    have h_inl_zero : (∑ k : Fin (w + 1), (L_X * (Q_res Q P0 X).transpose) x (finSumFinEquiv (Sum.inl k)) *
        ((1 : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ) - M * R_M) (finSumFinEquiv (Sum.inl k)) (finSumFinEquiv (Sum.inl i))) = 0 := by
      refine Finset.sum_eq_zero fun k _ => ?_
      rw [one_sub_M_lower_mul_R_M_lower_inl_inl w ell hu0 hui k i, mul_zero]
    rw [h_inl_zero, zero_add]
    have h_inr_sum : (∑ k : Fin (w + 1), (L_X * (Q_res Q P0 X).transpose) x (finSumFinEquiv (Sum.inr k)) *
        ((1 : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ) - M * R_M) (finSumFinEquiv (Sum.inr k)) (finSumFinEquiv (Sum.inl i))) =
        - (L_X * (Q_res Q P0 X).transpose) x (finSumFinEquiv (Sum.inr i)) := by
      have heq_k : ∀ k : Fin (w + 1),
          ((1 : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ) - M * R_M) (finSumFinEquiv (Sum.inr k)) (finSumFinEquiv (Sum.inl i)) =
            if k = i then -1 else 0 :=
        fun k => one_sub_M_lower_mul_R_M_lower_inl_inr w ell hu0 hui k i
      simp_rw [heq_k]
      simp only [mul_ite, mul_neg, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
    rw [h_inr_sum]
    rfl
  rw [h_LX_col]
  ring

/-- Sum of early and late interpolated coupling entries cancels the `Q_res` and `a_old` terms identically. -/
theorem P_interp_lower_sum_inl_inr {w : ℕ} (clock : AlgebraicClock w)
    (a_old : Fin (clock.m + 1) → ℚ) (ell : Fin (w + 1) → ℚ)
    (D : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (Q : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (h_compat : D.transpose * X_gateway clock = (M_lower w ell).transpose * Q)
    (i : Fin (w + 1)) (x : Fin (clock.m + 1)) :
    let X := X_gateway clock
    let L_X := L_X_gateway L_C
    let M := M_lower w ell
    let R_M := R_M_lower w ell
    let P0 := P0_cone_old a_old w
    P_interp X L_X M R_M D Q P0 x (finSumFinEquiv (Sum.inl i)) +
      P_interp X L_X M R_M D Q P0 x (finSumFinEquiv (Sum.inr i)) =
    ∑ c : Fin (w + 1), D x c * W_lower_inv_u w ell c i := by
  intro X L_X M R_M P0
  have hinl := P_interp_lower_inl clock a_old ell D Q L_C hu0 hui h_compat i x
  have hinr := P_interp_lower_inr clock a_old ell D Q L_C i x
  dsimp at hinl hinr ⊢
  rw [hinl, hinr]
  ring


/-- Linear error perturbation vector induced by `eta • L_strict` on reset coupling. -/
def err_eta {w : ℕ} (clock : AlgebraicClock w) (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (ell : Fin (w + 1) → ℚ)
    (x : Fin (clock.m + 1)) (k : Fin (w + 1)) : ℚ :=
  ∑ c : Fin (w + 1), (L_X_gateway L_C) x c *
    ((L_strict (w + 1) * W_lower_u w ell) k c +
     ((L_strict (w + 1)).transpose * W_lower_u w ell * B_mat (w + 1)) k c)

/-- Baseline late coupling score at `eta = 0`. -/
def P_eta0_inr {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (a_old : Fin (clock.m + 1) → ℚ) (ell ell_base : Fin (w + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (b : Fin clock.m) (c_step H0 : ℚ)
    (x : Fin (clock.m + 1)) (j : Fin (w + 1)) : ℚ :=
  let zeta := zeta_canonical hw clock b c_step H0
  let L_X := L_X_gateway L_C
  a_old x - (∑ c : Fin (w + 1), L_X x c * (((W_lower_inv_u w ell).transpose.mulVec ell_base j) * zeta c))

/-- Baseline early coupling score at `eta = 0`. -/
def P_eta0_inl {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (a_old : Fin (clock.m + 1) → ℚ) (ell ell_base : Fin (w + 1) → ℚ)
    (D : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (b : Fin clock.m) (c_step H0 : ℚ)
    (x : Fin (clock.m + 1)) (i : Fin (w + 1)) : ℚ :=
  let zeta := zeta_canonical hw clock b c_step H0
  let L_X := L_X_gateway L_C
  (- a_old x + (∑ c : Fin (w + 1), D x c * W_lower_inv_u w ell c i) +
    (∑ c : Fin (w + 1), L_X x c * (((W_lower_inv_u w ell).transpose.mulVec ell_base i) * zeta c)))

/-- Exact linear decomposition of late `P_interp` in `eta`. -/
theorem P_interp_decomp_inr {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) (ell ell_base : Fin (w + 1) → ℚ) (eta : ℚ)
    (a_old : Fin (clock.m + 1) → ℚ)
    (D : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (hu_def : ∀ c, ell c = alpha * zeta_canonical (by omega) clock b c_step H0 c + ell_base c)
    (h_cone : Matrix.vecMul a_old (X_gateway clock) =
      Matrix.vecMul (zeta_canonical (by omega) clock b c_step H0) (1 + B_mat (w + 1)))
    (j : Fin (w + 1)) (x : Fin (clock.m + 1)) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let E := E_outer2 hw clock b c_step H0 alpha
    let J := J_lower_eta w ell E eta
    let M := M_lower w ell
    let R_M := R_M_lower w ell
    let Q := Q_reset J M (B_mat (w + 1)) zeta
    let P0 := P0_cone_old a_old w
    let X := X_gateway clock
    let L_X := L_X_gateway L_C
    P_interp X L_X M R_M D Q P0 x (finSumFinEquiv (Sum.inr j)) =
      P_eta0_inr (by omega) clock a_old ell ell_base L_C b c_step H0 x j - eta * err_eta clock L_C ell x j := by
  intro zeta E J M R_M Q P0 X L_X
  rw [P_interp_lower_inr clock a_old ell D Q L_C j x]
  have hQ (c : Fin (w + 1)) :
      Q_res Q P0 X (Fin.natAdd (w + 1) j) c =
        - (((W_lower_inv_u w ell).transpose.mulVec ell_base j) * zeta c) -
          eta * (L_strict (w + 1) * W_lower_u w ell) j c -
          eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) j c :=
    congr_fun (Q_res_lower_eta_cone_inr hw clock b c_step H0 alpha ell ell_base eta a_old hu0 hui hu_def h_cone j) c
  have h_sum : (∑ c : Fin (w + 1), L_X x c * Q_res Q P0 X (Fin.natAdd (w + 1) j) c) =
      - (∑ c : Fin (w + 1), L_X x c * (((W_lower_inv_u w ell).transpose.mulVec ell_base j) * zeta c)) -
        eta * err_eta clock L_C ell x j := by
    dsimp [err_eta]
    rw [Finset.mul_sum]
    rw [← Finset.sum_neg_distrib, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro c _
    rw [hQ c]
    ring
  change a_old x + ∑ c, L_X x c * Q_res Q P0 X (Fin.natAdd (w + 1) j) c = _
  rw [h_sum]
  dsimp [P_eta0_inr, zeta, L_X]
  ring

/-- Exact linear decomposition of early `P_interp` in `eta`. -/
theorem P_interp_decomp_inl {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) (ell ell_base : Fin (w + 1) → ℚ) (eta : ℚ)
    (a_old : Fin (clock.m + 1) → ℚ)
    (D : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (hu_def : ∀ c, ell c = alpha * zeta_canonical (by omega) clock b c_step H0 c + ell_base c)
    (h_cone : Matrix.vecMul a_old (X_gateway clock) =
      Matrix.vecMul (zeta_canonical (by omega) clock b c_step H0) (1 + B_mat (w + 1)))
    (h_compat : D.transpose * X_gateway clock = (M_lower w ell).transpose *
      (Q_reset (J_lower_eta w ell (E_outer2 hw clock b c_step H0 alpha) eta) (M_lower w ell) (B_mat (w + 1))
        (zeta_canonical (by omega) clock b c_step H0)))
    (i : Fin (w + 1)) (x : Fin (clock.m + 1)) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let E := E_outer2 hw clock b c_step H0 alpha
    let J := J_lower_eta w ell E eta
    let M := M_lower w ell
    let R_M := R_M_lower w ell
    let Q := Q_reset J M (B_mat (w + 1)) zeta
    let P0 := P0_cone_old a_old w
    let X := X_gateway clock
    let L_X := L_X_gateway L_C
    P_interp X L_X M R_M D Q P0 x (finSumFinEquiv (Sum.inl i)) =
      P_eta0_inl (by omega) clock a_old ell ell_base D L_C b c_step H0 x i + eta * err_eta clock L_C ell x i := by
  intro zeta E J M R_M Q P0 X L_X
  rw [P_interp_lower_inl clock a_old ell D Q L_C hu0 hui h_compat i x]
  have hQ (c : Fin (w + 1)) :
      Q_res Q P0 X (Fin.natAdd (w + 1) i) c =
        - (((W_lower_inv_u w ell).transpose.mulVec ell_base i) * zeta c) -
          eta * (L_strict (w + 1) * W_lower_u w ell) i c -
          eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) i c :=
    congr_fun (Q_res_lower_eta_cone_inr hw clock b c_step H0 alpha ell ell_base eta a_old hu0 hui hu_def h_cone i) c
  have h_sum : (∑ c : Fin (w + 1), L_X x c * Q_res Q P0 X (Fin.natAdd (w + 1) i) c) =
      - (∑ c : Fin (w + 1), L_X x c * (((W_lower_inv_u w ell).transpose.mulVec ell_base i) * zeta c)) -
        eta * err_eta clock L_C ell x i := by
    dsimp [err_eta]
    rw [Finset.mul_sum]
    rw [← Finset.sum_neg_distrib, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro c _
    rw [hQ c]
    ring
  change - a_old x + (∑ c, D x c * W_lower_inv_u w ell c i) - ∑ c, L_X x c * Q_res Q P0 X (Fin.natAdd (w + 1) i) c = _
  rw [h_sum]
  dsimp [P_eta0_inl, zeta, L_X]
  ring

/-- Existence of positive interaction parameter `eta > 0` simultaneously ensuring strict subdiagonal positivity
    of `J_lower_eta` and preservation of positive late / negative early coupling waiting margins. -/
theorem exists_eta_subdiag_pos_and_P_interp_margins {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) (ell ell_base : Fin (w + 1) → ℚ)
    (a_old : Fin (clock.m + 1) → ℚ)
    (D : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (ha_pos : ∀ x, 0 < a_old x)
    (hX_pos : ∀ i j, 0 < ((W_lower_inv_u w ell).transpose * E_outer2 hw clock b c_step H0 alpha * W_lower_inv_u w ell) i j)
    (hP_inr : ∀ x j, a_old x / 2 ≤ P_eta0_inr (by omega) clock a_old ell ell_base L_C b c_step H0 x j)
    (hP_inl : ∀ x i, P_eta0_inl (by omega) clock a_old ell ell_base D L_C b c_step H0 x i ≤ - (a_old x / 2)) :
    ∃ eta : ℚ, 0 < eta ∧
      (∀ a b_act : Fin ((w + 1) + (w + 1)), b_act.val < a.val →
        0 < J_lower_eta w ell (E_outer2 hw clock b c_step H0 alpha) eta a b_act) ∧
      (∀ (x : Fin (clock.m + 1)) (j : Fin (w + 1)),
        a_old x / 4 ≤ P_eta0_inr (by omega) clock a_old ell ell_base L_C b c_step H0 x j - eta * err_eta clock L_C ell x j) ∧
      (∀ (x : Fin (clock.m + 1)) (i : Fin (w + 1)),
        P_eta0_inl (by omega) clock a_old ell ell_base D L_C b c_step H0 x i + eta * err_eta clock L_C ell x i ≤ - (a_old x / 4)) := by
  let E := E_outer2 hw clock b c_step H0 alpha
  let X_mid_0 := (W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell
  let c_old := Finset.univ.inf' Finset.univ_nonempty a_old
  have hc_old_pos : 0 < c_old := by
    rw [Finset.lt_inf'_iff]
    intro x _
    exact ha_pos x
  have hc_old_le : ∀ x, c_old ≤ a_old x := fun x =>
    Finset.inf'_le a_old (Finset.mem_univ x)
  let c_X := Finset.univ.inf' Finset.univ_nonempty (fun p : Fin (w + 1) × Fin (w + 1) => X_mid_0 p.1 p.2)
  have hc_X_pos : 0 < c_X := by
    rw [Finset.lt_inf'_iff]
    intro p _
    exact hX_pos p.1 p.2
  have hc_X_le : ∀ i j, c_X ≤ X_mid_0 i j := fun i j =>
    Finset.inf'_le (fun p : Fin (w + 1) × Fin (w + 1) => X_mid_0 p.1 p.2) (Finset.mem_univ (i, j))
  let M_err := 1 + Finset.univ.sup' Finset.univ_nonempty (fun p : Fin (clock.m + 1) × Fin (w + 1) => |err_eta clock L_C ell p.1 p.2|)
  have hM_err_pos : 0 < M_err := by
    have hp : ((0 : Fin (clock.m + 1)), (0 : Fin (w + 1))) ∈ Finset.univ := Finset.mem_univ _
    have hle := Finset.le_sup' (fun p : Fin (clock.m + 1) × Fin (w + 1) => |err_eta clock L_C ell p.1 p.2|) hp
    have habs : 0 ≤ |err_eta clock L_C ell 0 0| := abs_nonneg _
    have hsup_nonneg : 0 ≤ Finset.univ.sup' Finset.univ_nonempty (fun p : Fin (clock.m + 1) × Fin (w + 1) => |err_eta clock L_C ell p.1 p.2|) :=
      le_trans habs hle
    linarith
  have h_err_le : ∀ x k, |err_eta clock L_C ell x k| ≤ M_err := by
    intro x k
    have hp : (x, k) ∈ Finset.univ := Finset.mem_univ _
    have hle := Finset.le_sup' (fun p : Fin (clock.m + 1) × Fin (w + 1) => |err_eta clock L_C ell p.1 p.2|) hp
    linarith
  let eta := min (c_X / 3) (c_old / (4 * M_err))
  have heta_pos : 0 < eta := by
    apply lt_min
    · linarith
    · have : 0 < 4 * M_err := by linarith
      exact div_pos hc_old_pos this
  refine ⟨eta, heta_pos, ?_, ?_, ?_⟩
  · -- Subdiagonal positivity of J_lower_eta
    have hX_sub : ∀ i j, 0 < (X_mid_0 - (2 * eta) • L_strict (w + 1)) i j := by
      intro i j
      simp only [Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul]
      have heta_le1 : eta ≤ c_X / 3 := min_le_left _ _
      have hc_le : c_X ≤ X_mid_0 i j := hc_X_le i j
      dsimp [L_strict]
      split_ifs with hlt
      · simp only [mul_one]
        linarith
      · simp only [mul_zero, sub_zero]
        exact hX_pos i j
    intro a b_act hab
    exact J_lower_eta_subdiag_pos w ell E eta heta_pos hX_sub a b_act hab
  · -- Margin on P_eta0_inr
    intro x j
    have heta_le2 : eta ≤ c_old / (4 * M_err) := min_le_right _ _
    have herr_le : |err_eta clock L_C ell x j| ≤ M_err := h_err_le x j
    have hc_le : c_old ≤ a_old x := hc_old_le x
    have h_prod : eta * |err_eta clock L_C ell x j| ≤ (c_old / (4 * M_err)) * M_err := by
      apply mul_le_mul heta_le2 herr_le (abs_nonneg _)
      have : 0 < 4 * M_err := by linarith
      exact le_of_lt (div_pos hc_old_pos this)
    have h_cancel : (c_old / (4 * M_err)) * M_err = c_old / 4 := by
      have : M_err ≠ 0 := ne_of_gt hM_err_pos
      calc (c_old / (4 * M_err)) * M_err = c_old * (4 * M_err)⁻¹ * M_err := rfl
        _ = c_old * ((4 * M_err)⁻¹ * M_err) := by ring
        _ = c_old * (4⁻¹ * M_err⁻¹ * M_err) := by rw [mul_inv]
        _ = c_old * (4⁻¹ * (M_err⁻¹ * M_err)) := by ring
        _ = c_old * (4⁻¹ * 1) := by rw [inv_mul_cancel₀ this]
        _ = c_old / 4 := by ring
    have h_err_bound : eta * err_eta clock L_C ell x j ≤ a_old x / 4 := by
      have h1 : eta * err_eta clock L_C ell x j ≤ eta * |err_eta clock L_C ell x j| := by
        have : err_eta clock L_C ell x j ≤ |err_eta clock L_C ell x j| := le_abs_self _
        exact mul_le_mul_of_nonneg_left this (le_of_lt heta_pos)
      linarith
    have hbase := hP_inr x j
    linarith
  · -- Margin on P_eta0_inl
    intro x i
    have heta_le2 : eta ≤ c_old / (4 * M_err) := min_le_right _ _
    have herr_le : |err_eta clock L_C ell x i| ≤ M_err := h_err_le x i
    have hc_le : c_old ≤ a_old x := hc_old_le x
    have h_prod : eta * |err_eta clock L_C ell x i| ≤ (c_old / (4 * M_err)) * M_err := by
      apply mul_le_mul heta_le2 herr_le (abs_nonneg _)
      have : 0 < 4 * M_err := by linarith
      exact le_of_lt (div_pos hc_old_pos this)
    have h_cancel : (c_old / (4 * M_err)) * M_err = c_old / 4 := by
      have : M_err ≠ 0 := ne_of_gt hM_err_pos
      calc (c_old / (4 * M_err)) * M_err = c_old * (4 * M_err)⁻¹ * M_err := rfl
        _ = c_old * ((4 * M_err)⁻¹ * M_err) := by ring
        _ = c_old * (4⁻¹ * M_err⁻¹ * M_err) := by rw [mul_inv]
        _ = c_old * (4⁻¹ * (M_err⁻¹ * M_err)) := by ring
        _ = c_old * (4⁻¹ * 1) := by rw [inv_mul_cancel₀ this]
        _ = c_old / 4 := by ring
    have h_err_bound : eta * err_eta clock L_C ell x i ≤ a_old x / 4 := by
      have h1 : eta * err_eta clock L_C ell x i ≤ eta * |err_eta clock L_C ell x i| := by
        have : err_eta clock L_C ell x i ≤ |err_eta clock L_C ell x i| := le_abs_self _
        exact mul_le_mul_of_nonneg_left this (le_of_lt heta_pos)
      linarith
    have hbase := hP_inl x i
    linarith


/-- Exact cone-cancellation with E_base on late block `Sum.inr j`. -/
theorem Q_res_lower_eta_cone_inr_total {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) (ell ell_base : Fin (w + 1) → ℚ)
    (E_base : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (a_old : Fin (clock.m + 1) → ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (hu_def : ∀ c, ell c = alpha * zeta_canonical (by omega) clock b c_step H0 c + ell_base c)
    (h_cone : Matrix.vecMul a_old (X_gateway clock) =
      Matrix.vecMul (zeta_canonical (by omega) clock b c_step H0) (1 + B_mat (w + 1)))
    (j : Fin (w + 1)) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let E := E_outer2 hw clock b c_step H0 alpha + E_base
    let J := J_lower_eta w ell E eta
    let M := M_lower w ell
    let Q := Q_reset J M (B_mat (w + 1)) zeta
    let P0 := P0_cone_old a_old w
    let X := X_gateway clock
    (fun c => (Q_res Q P0 X) (finSumFinEquiv (Sum.inr j)) c) =
      fun c => - (((W_lower_inv_u w ell).transpose.mulVec ell_base j) * zeta c) +
        ((W_lower_inv_u w ell).transpose * E_base) j c -
        eta * (L_strict (w + 1) * W_lower_u w ell) j c -
        eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) j c := by
  intro zeta E J M Q P0 X
  ext c
  have h_res : (Q_res Q P0 X) (finSumFinEquiv (Sum.inr j)) c =
      Q (finSumFinEquiv (Sum.inr j)) c - (P0.transpose * X) (finSumFinEquiv (Sum.inr j)) c := rfl
  rw [h_res]
  have hP0 : (P0.transpose * X) (finSumFinEquiv (Sum.inr j)) c =
      zeta c + Matrix.vecMul zeta (B_mat (w + 1)) c := by
    rw [P0_cone_old_transpose_mul_X_inr clock a_old j c]
    have hc := congr_fun h_cone c
    simp only [Matrix.vecMul_add, Matrix.vecMul_one, Pi.add_apply] at hc
    rw [hc]
  have hQ : Q (finSumFinEquiv (Sum.inr j)) c =
      Matrix.vecMul zeta (B_mat (w + 1)) c - zeta c +
        ((W_lower_inv_u w ell).transpose * E) j c -
        eta * (L_strict (w + 1) * W_lower_u w ell) j c -
        eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) j c :=
    congr_fun (Q_reset_lower_eta_inr w ell E eta zeta hu0 hui j) c
  have hE_split : ((W_lower_inv_u w ell).transpose * E) j c =
      ((W_lower_inv_u w ell).transpose * E_outer2 hw clock b c_step H0 alpha) j c +
      ((W_lower_inv_u w ell).transpose * E_base) j c := by
    dsimp [E]
    rw [Matrix.mul_add, Matrix.add_apply]
  have hE : ((W_lower_inv_u w ell).transpose * E_outer2 hw clock b c_step H0 alpha) j c =
      alpha * ((W_lower_inv_u w ell).transpose.mulVec zeta j) * zeta c :=
    W_lower_inv_transpose_mul_E_outer2 hw clock b c_step H0 alpha ell j c
  have h_u_hui : ∀ k : Fin w, (fun c => ell c / 2) k.succ ≠ 0 := by
    intro k h
    have h0 : ell k.succ = 0 := by linarith [h]
    exact hui k h0
  have h_u_def : ∀ c : Fin (w + 1), 2 * (ell c / 2) = alpha * zeta c + ell_base c := by
    intro c
    have := hu_def c
    linarith
  have h_vec := alpha_smul_W_lower_inv_transpose_mulVec_zeta w (fun c => ell c / 2) zeta ell_base alpha hu0 h_u_hui h_u_def
  have hj := congr_fun h_vec j
  change alpha * (W_lower_inv_u w ell).transpose.mulVec zeta j =
    2 - (W_lower_inv_u w ell).transpose.mulVec ell_base j at hj
  rw [hQ, hP0, hE_split, hE]
  have h_subst : alpha * (W_lower_inv_u w ell).transpose.mulVec zeta j * zeta c =
      (2 - (W_lower_inv_u w ell).transpose.mulVec ell_base j) * zeta c := by
    rw [hj]
  rw [h_subst]
  ring

/-- Exact cone-cancellation with E_base on early block `Sum.inl i`. -/
theorem Q_res_lower_eta_cone_inl_total {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) (ell ell_base : Fin (w + 1) → ℚ)
    (E_base : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (a_old : Fin (clock.m + 1) → ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (hu_def : ∀ c, ell c = alpha * zeta_canonical (by omega) clock b c_step H0 c + ell_base c)
    (h_cone : Matrix.vecMul a_old (X_gateway clock) =
      Matrix.vecMul (zeta_canonical (by omega) clock b c_step H0) (1 + B_mat (w + 1)))
    (i : Fin (w + 1)) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let E := E_outer2 hw clock b c_step H0 alpha + E_base
    let J := J_lower_eta w ell E eta
    let M := M_lower w ell
    let Q := Q_reset J M (B_mat (w + 1)) zeta
    let P0 := P0_cone_old a_old w
    let X := X_gateway clock
    (fun c => (Q_res Q P0 X) (finSumFinEquiv (Sum.inl i)) c) =
      fun c => ((W_lower_inv_u w ell).transpose.mulVec ell_base i) * (Matrix.vecMul zeta (B_mat (w + 1)) c) -
        (((W_lower_inv_u w ell).transpose * E_base.transpose) * B_mat (w + 1)) i c +
        eta * (L_strict (w + 1) * W_lower_u w ell) i c +
        eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) i c := by
  intro zeta E J M Q P0 X
  ext c
  have h_res : (Q_res Q P0 X) (finSumFinEquiv (Sum.inl i)) c =
      Q (finSumFinEquiv (Sum.inl i)) c - (P0.transpose * X) (finSumFinEquiv (Sum.inl i)) c := rfl
  rw [h_res]
  have hP0 : (P0.transpose * X) (finSumFinEquiv (Sum.inl i)) c =
      - (zeta c + Matrix.vecMul zeta (B_mat (w + 1)) c) := by
    rw [P0_cone_old_transpose_mul_X_inl clock a_old i c]
    have hc := congr_fun h_cone c
    simp only [Matrix.vecMul_add, Matrix.vecMul_one, Pi.add_apply] at hc
    rw [hc]
  have hQ : Q (finSumFinEquiv (Sum.inl i)) c =
      Matrix.vecMul zeta (B_mat (w + 1)) c - zeta c -
        (((W_lower_inv_u w ell).transpose * E.transpose) * B_mat (w + 1)) i c +
        eta * (L_strict (w + 1) * W_lower_u w ell) i c +
        eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) i c :=
    congr_fun (Q_reset_lower_eta_inl w ell E eta zeta hu0 hui i) c
  have hE_split : (((W_lower_inv_u w ell).transpose * E.transpose) * B_mat (w + 1)) i c =
      (((W_lower_inv_u w ell).transpose * (E_outer2 hw clock b c_step H0 alpha).transpose) * B_mat (w + 1)) i c +
      (((W_lower_inv_u w ell).transpose * E_base.transpose) * B_mat (w + 1)) i c := by
    dsimp [E]
    rw [Matrix.transpose_add, Matrix.mul_add, Matrix.add_mul, Matrix.add_apply]
  have hE : (((W_lower_inv_u w ell).transpose * (E_outer2 hw clock b c_step H0 alpha).transpose) * B_mat (w + 1)) i c =
      alpha * ((W_lower_inv_u w ell).transpose.mulVec zeta i) * (Matrix.vecMul zeta (B_mat (w + 1)) c) :=
    W_lower_inv_transpose_mul_E_outer2_transpose_mul_B hw clock b c_step H0 alpha ell i c
  have h_u_hui : ∀ k : Fin w, (fun c => ell c / 2) k.succ ≠ 0 := by
    intro k h
    have h0 : ell k.succ = 0 := by linarith [h]
    exact hui k h0
  have h_u_def : ∀ c : Fin (w + 1), 2 * (ell c / 2) = alpha * zeta c + ell_base c := by
    intro c
    have := hu_def c
    linarith
  have h_vec := alpha_smul_W_lower_inv_transpose_mulVec_zeta w (fun c => ell c / 2) zeta ell_base alpha hu0 h_u_hui h_u_def
  have hi := congr_fun h_vec i
  change alpha * (W_lower_inv_u w ell).transpose.mulVec zeta i =
    2 - (W_lower_inv_u w ell).transpose.mulVec ell_base i at hi
  rw [hQ, hP0, hE_split, hE]
  have h_subst : alpha * (W_lower_inv_u w ell).transpose.mulVec zeta i * Matrix.vecMul zeta (B_mat (w + 1)) c =
      (2 - (W_lower_inv_u w ell).transpose.mulVec ell_base i) * Matrix.vecMul zeta (B_mat (w + 1)) c := by
    rw [hi]
  rw [h_subst]
  ring

/-- Baseline late coupling score at `eta = 0` with E_base. -/
def P_eta0_inr_total {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (a_old : Fin (clock.m + 1) → ℚ) (ell ell_base : Fin (w + 1) → ℚ)
    (E_base : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (b : Fin clock.m) (c_step H0 : ℚ)
    (x : Fin (clock.m + 1)) (j : Fin (w + 1)) : ℚ :=
  let zeta := zeta_canonical hw clock b c_step H0
  let L_X := L_X_gateway L_C
  a_old x - (∑ c : Fin (w + 1), L_X x c * (((W_lower_inv_u w ell).transpose.mulVec ell_base j) * zeta c)) +
    ∑ c : Fin (w + 1), L_X x c * ((W_lower_inv_u w ell).transpose * E_base) j c

/-- Baseline early coupling score at `eta = 0` with E_base. -/
def P_eta0_inl_total {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (a_old : Fin (clock.m + 1) → ℚ) (ell ell_base : Fin (w + 1) → ℚ)
    (E_base : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (D : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (b : Fin clock.m) (c_step H0 : ℚ)
    (x : Fin (clock.m + 1)) (i : Fin (w + 1)) : ℚ :=
  let zeta := zeta_canonical hw clock b c_step H0
  let L_X := L_X_gateway L_C
  (- a_old x + (∑ c : Fin (w + 1), D x c * W_lower_inv_u w ell c i) +
    (∑ c : Fin (w + 1), L_X x c * (((W_lower_inv_u w ell).transpose.mulVec ell_base i) * zeta c)) -
    ∑ c : Fin (w + 1), L_X x c * ((W_lower_inv_u w ell).transpose * E_base) i c)

/-- Exact linear decomposition of late `P_interp` in `eta` with E_base. -/
theorem P_interp_decomp_inr_total {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) (ell ell_base : Fin (w + 1) → ℚ)
    (E_base : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (a_old : Fin (clock.m + 1) → ℚ)
    (D : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (hu_def : ∀ c, ell c = alpha * zeta_canonical (by omega) clock b c_step H0 c + ell_base c)
    (h_cone : Matrix.vecMul a_old (X_gateway clock) =
      Matrix.vecMul (zeta_canonical (by omega) clock b c_step H0) (1 + B_mat (w + 1)))
    (j : Fin (w + 1)) (x : Fin (clock.m + 1)) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let E := E_outer2 hw clock b c_step H0 alpha + E_base
    let J := J_lower_eta w ell E eta
    let M := M_lower w ell
    let R_M := R_M_lower w ell
    let Q := Q_reset J M (B_mat (w + 1)) zeta
    let P0 := P0_cone_old a_old w
    let X := X_gateway clock
    let L_X := L_X_gateway L_C
    P_interp X L_X M R_M D Q P0 x (finSumFinEquiv (Sum.inr j)) =
      P_eta0_inr_total (by omega) clock a_old ell ell_base E_base L_C b c_step H0 x j - eta * err_eta clock L_C ell x j := by
  intro zeta E J M R_M Q P0 X L_X
  rw [P_interp_lower_inr clock a_old ell D Q L_C j x]
  have hQ (c : Fin (w + 1)) :
      Q_res Q P0 X (Fin.natAdd (w + 1) j) c =
        - (((W_lower_inv_u w ell).transpose.mulVec ell_base j) * zeta c) +
          ((W_lower_inv_u w ell).transpose * E_base) j c -
          eta * (L_strict (w + 1) * W_lower_u w ell) j c -
          eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) j c :=
    congr_fun (Q_res_lower_eta_cone_inr_total hw clock b c_step H0 alpha ell ell_base E_base eta a_old hu0 hui hu_def h_cone j) c
  have h_sum : (∑ c : Fin (w + 1), L_X x c * Q_res Q P0 X (Fin.natAdd (w + 1) j) c) =
      - (∑ c : Fin (w + 1), L_X x c * (((W_lower_inv_u w ell).transpose.mulVec ell_base j) * zeta c)) +
        (∑ c : Fin (w + 1), L_X x c * ((W_lower_inv_u w ell).transpose * E_base) j c) -
        eta * err_eta clock L_C ell x j := by
    dsimp [err_eta]
    rw [Finset.mul_sum]
    rw [← Finset.sum_neg_distrib, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro c _
    rw [hQ c]
    ring
  change a_old x + ∑ c, L_X x c * Q_res Q P0 X (Fin.natAdd (w + 1) j) c = _
  rw [h_sum]
  dsimp [P_eta0_inr_total, zeta, L_X]
  ring

/-- Exact linear decomposition of early `P_interp` in `eta` with E_base. -/
theorem P_interp_decomp_inl_total {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) (ell ell_base : Fin (w + 1) → ℚ)
    (E_base : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (a_old : Fin (clock.m + 1) → ℚ)
    (D : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (hu_def : ∀ c, ell c = alpha * zeta_canonical (by omega) clock b c_step H0 c + ell_base c)
    (h_cone : Matrix.vecMul a_old (X_gateway clock) =
      Matrix.vecMul (zeta_canonical (by omega) clock b c_step H0) (1 + B_mat (w + 1)))
    (h_compat : D.transpose * X_gateway clock = (M_lower w ell).transpose *
      (Q_reset (J_lower_eta w ell (E_outer2 hw clock b c_step H0 alpha + E_base) eta) (M_lower w ell) (B_mat (w + 1))
        (zeta_canonical (by omega) clock b c_step H0)))
    (i : Fin (w + 1)) (x : Fin (clock.m + 1)) :
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let E := E_outer2 hw clock b c_step H0 alpha + E_base
    let J := J_lower_eta w ell E eta
    let M := M_lower w ell
    let R_M := R_M_lower w ell
    let Q := Q_reset J M (B_mat (w + 1)) zeta
    let P0 := P0_cone_old a_old w
    let X := X_gateway clock
    let L_X := L_X_gateway L_C
    P_interp X L_X M R_M D Q P0 x (finSumFinEquiv (Sum.inl i)) =
      P_eta0_inl_total (by omega) clock a_old ell ell_base E_base D L_C b c_step H0 x i + eta * err_eta clock L_C ell x i := by
  intro zeta E J M R_M Q P0 X L_X
  rw [P_interp_lower_inl clock a_old ell D Q L_C hu0 hui h_compat i x]
  have hQ (c : Fin (w + 1)) :
      Q_res Q P0 X (Fin.natAdd (w + 1) i) c =
        - (((W_lower_inv_u w ell).transpose.mulVec ell_base i) * zeta c) +
          ((W_lower_inv_u w ell).transpose * E_base) i c -
          eta * (L_strict (w + 1) * W_lower_u w ell) i c -
          eta * (((L_strict (w + 1)).transpose * W_lower_u w ell) * B_mat (w + 1)) i c :=
    congr_fun (Q_res_lower_eta_cone_inr_total hw clock b c_step H0 alpha ell ell_base E_base eta a_old hu0 hui hu_def h_cone i) c
  have h_sum : (∑ c : Fin (w + 1), L_X x c * Q_res Q P0 X (Fin.natAdd (w + 1) i) c) =
      - (∑ c : Fin (w + 1), L_X x c * (((W_lower_inv_u w ell).transpose.mulVec ell_base i) * zeta c)) +
        (∑ c : Fin (w + 1), L_X x c * ((W_lower_inv_u w ell).transpose * E_base) i c) -
        eta * err_eta clock L_C ell x i := by
    dsimp [err_eta]
    rw [Finset.mul_sum]
    rw [← Finset.sum_neg_distrib, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro c _
    rw [hQ c]
    ring
  change - a_old x + (∑ c, D x c * W_lower_inv_u w ell c i) - ∑ c, L_X x c * Q_res Q P0 X (Fin.natAdd (w + 1) i) c = _
  rw [h_sum]
  dsimp [P_eta0_inl_total, zeta, L_X]
  ring

/-- Existence of positive interaction parameter `eta > 0` simultaneously ensuring strict subdiagonal positivity
    of `J_lower_eta` and preservation of positive late / negative early coupling waiting margins with E_base. -/
theorem exists_eta_subdiag_pos_and_P_interp_margins_total {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 alpha : ℚ) (ell ell_base : Fin (w + 1) → ℚ)
    (E_base : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (a_old : Fin (clock.m + 1) → ℚ)
    (D : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (ha_pos : ∀ x, 0 < a_old x)
    (hX_pos : ∀ i j, 0 < ((W_lower_inv_u w ell).transpose * (E_outer2 hw clock b c_step H0 alpha + E_base) * W_lower_inv_u w ell) i j)
    (hP_inr : ∀ x j, a_old x / 2 ≤ P_eta0_inr_total (by omega) clock a_old ell ell_base E_base L_C b c_step H0 x j)
    (hP_inl : ∀ x i, P_eta0_inl_total (by omega) clock a_old ell ell_base E_base D L_C b c_step H0 x i ≤ - (a_old x / 2)) :
    ∃ eta : ℚ, 0 < eta ∧
      (∀ a b_act : Fin ((w + 1) + (w + 1)), b_act.val < a.val →
        0 < J_lower_eta w ell (E_outer2 hw clock b c_step H0 alpha + E_base) eta a b_act) ∧
      (∀ (x : Fin (clock.m + 1)) (j : Fin (w + 1)),
        a_old x / 4 ≤ P_eta0_inr_total (by omega) clock a_old ell ell_base E_base L_C b c_step H0 x j - eta * err_eta clock L_C ell x j) ∧
      (∀ (x : Fin (clock.m + 1)) (i : Fin (w + 1)),
        P_eta0_inl_total (by omega) clock a_old ell ell_base E_base D L_C b c_step H0 x i + eta * err_eta clock L_C ell x i ≤ - (a_old x / 4)) := by
  let E := E_outer2 hw clock b c_step H0 alpha + E_base
  let X_mid_0 := (W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell
  let c_old := Finset.univ.inf' Finset.univ_nonempty a_old
  have hc_old_pos : 0 < c_old := by
    rw [Finset.lt_inf'_iff]
    intro x _
    exact ha_pos x
  have hc_old_le : ∀ x, c_old ≤ a_old x := fun x =>
    Finset.inf'_le a_old (Finset.mem_univ x)
  let c_X := Finset.univ.inf' Finset.univ_nonempty (fun p : Fin (w + 1) × Fin (w + 1) => X_mid_0 p.1 p.2)
  have hc_X_pos : 0 < c_X := by
    rw [Finset.lt_inf'_iff]
    intro p _
    exact hX_pos p.1 p.2
  have hc_X_le : ∀ i j, c_X ≤ X_mid_0 i j := fun i j =>
    Finset.inf'_le (fun p : Fin (w + 1) × Fin (w + 1) => X_mid_0 p.1 p.2) (Finset.mem_univ (i, j))
  let M_err := 1 + Finset.univ.sup' Finset.univ_nonempty (fun p : Fin (clock.m + 1) × Fin (w + 1) => |err_eta clock L_C ell p.1 p.2|)
  have hM_err_pos : 0 < M_err := by
    have hp : ((0 : Fin (clock.m + 1)), (0 : Fin (w + 1))) ∈ Finset.univ := Finset.mem_univ _
    have hle := Finset.le_sup' (fun p : Fin (clock.m + 1) × Fin (w + 1) => |err_eta clock L_C ell p.1 p.2|) hp
    have habs : 0 ≤ |err_eta clock L_C ell 0 0| := abs_nonneg _
    have hsup_nonneg : 0 ≤ Finset.univ.sup' Finset.univ_nonempty (fun p : Fin (clock.m + 1) × Fin (w + 1) => |err_eta clock L_C ell p.1 p.2|) :=
      le_trans habs hle
    linarith
  have h_err_le : ∀ x k, |err_eta clock L_C ell x k| ≤ M_err := by
    intro x k
    have hp : (x, k) ∈ Finset.univ := Finset.mem_univ _
    have hle := Finset.le_sup' (fun p : Fin (clock.m + 1) × Fin (w + 1) => |err_eta clock L_C ell p.1 p.2|) hp
    linarith
  let eta := min (c_X / 3) (c_old / (4 * M_err))
  have heta_pos : 0 < eta := by
    apply lt_min
    · linarith
    · have : 0 < 4 * M_err := by linarith
      exact div_pos hc_old_pos this
  refine ⟨eta, heta_pos, ?_, ?_, ?_⟩
  · -- Subdiagonal positivity of J_lower_eta
    have hX_sub : ∀ i j, 0 < (X_mid_0 - (2 * eta) • L_strict (w + 1)) i j := by
      intro i j
      simp only [Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul]
      have heta_le1 : eta ≤ c_X / 3 := min_le_left _ _
      have hc_le : c_X ≤ X_mid_0 i j := hc_X_le i j
      dsimp [L_strict]
      split_ifs with hlt
      · simp only [mul_one]
        linarith
      · simp only [mul_zero, sub_zero]
        exact hX_pos i j
    intro a b_act hab
    exact J_lower_eta_subdiag_pos w ell E eta heta_pos hX_sub a b_act hab
  · -- Margin on P_eta0_inr_total
    intro x j
    have heta_le2 : eta ≤ c_old / (4 * M_err) := min_le_right _ _
    have herr_le : |err_eta clock L_C ell x j| ≤ M_err := h_err_le x j
    have hc_le : c_old ≤ a_old x := hc_old_le x
    have h_prod : eta * |err_eta clock L_C ell x j| ≤ (c_old / (4 * M_err)) * M_err := by
      apply mul_le_mul heta_le2 herr_le (abs_nonneg _)
      have : 0 < 4 * M_err := by linarith
      exact le_of_lt (div_pos hc_old_pos this)
    have h_cancel : (c_old / (4 * M_err)) * M_err = c_old / 4 := by
      have : M_err ≠ 0 := ne_of_gt hM_err_pos
      calc (c_old / (4 * M_err)) * M_err = c_old * (4 * M_err)⁻¹ * M_err := rfl
        _ = c_old * ((4 * M_err)⁻¹ * M_err) := by ring
        _ = c_old * (4⁻¹ * M_err⁻¹ * M_err) := by rw [mul_inv]
        _ = c_old * (4⁻¹ * (M_err⁻¹ * M_err)) := by ring
        _ = c_old * (4⁻¹ * 1) := by rw [inv_mul_cancel₀ this]
        _ = c_old / 4 := by ring
    have h_err_bound : eta * err_eta clock L_C ell x j ≤ a_old x / 4 := by
      have h1 : eta * err_eta clock L_C ell x j ≤ eta * |err_eta clock L_C ell x j| := by
        have : err_eta clock L_C ell x j ≤ |err_eta clock L_C ell x j| := le_abs_self _
        exact mul_le_mul_of_nonneg_left this (le_of_lt heta_pos)
      linarith
    have hbase := hP_inr x j
    linarith
  · -- Margin on P_eta0_inl_total
    intro x i
    have heta_le2 : eta ≤ c_old / (4 * M_err) := min_le_right _ _
    have herr_le : |err_eta clock L_C ell x i| ≤ M_err := h_err_le x i
    have hc_le : c_old ≤ a_old x := hc_old_le x
    have h_prod : eta * |err_eta clock L_C ell x i| ≤ (c_old / (4 * M_err)) * M_err := by
      apply mul_le_mul heta_le2 herr_le (abs_nonneg _)
      have : 0 < 4 * M_err := by linarith
      exact le_of_lt (div_pos hc_old_pos this)
    have h_cancel : (c_old / (4 * M_err)) * M_err = c_old / 4 := by
      have : M_err ≠ 0 := ne_of_gt hM_err_pos
      calc (c_old / (4 * M_err)) * M_err = c_old * (4 * M_err)⁻¹ * M_err := rfl
        _ = c_old * ((4 * M_err)⁻¹ * M_err) := by ring
        _ = c_old * (4⁻¹ * M_err⁻¹ * M_err) := by rw [mul_inv]
        _ = c_old * (4⁻¹ * (M_err⁻¹ * M_err)) := by ring
        _ = c_old * (4⁻¹ * 1) := by rw [inv_mul_cancel₀ this]
        _ = c_old / 4 := by ring
    have h_err_bound : eta * err_eta clock L_C ell x i ≤ a_old x / 4 := by
      have h1 : eta * err_eta clock L_C ell x i ≤ eta * |err_eta clock L_C ell x i| := by
        have : err_eta clock L_C ell x i ≤ |err_eta clock L_C ell x i| := le_abs_self _
        exact mul_le_mul_of_nonneg_left this (le_of_lt heta_pos)
      linarith
    have hbase := hP_inl x i
    linarith

theorem W_lower_inv_entry_bound {w : ℕ} (u : Fin (w + 1) → ℚ) (B : ℚ)
    (hB : 1 ≤ B)
    (hu0 : B ≤ u 0 - w)
    (hui : ∀ c, B ≤ u c) (i c : Fin (w + 1)) :
    |(W_lower_inv w u) i c| ≤ B⁻¹ := by
  simp only [W_lower_inv, Matrix.of_apply]
  have hB_pos : 0 < B := by linarith
  have hB_inv_nonneg : 0 ≤ B⁻¹ := inv_nonneg.mpr (by linarith)
  split_ifs with h1 h2 h3 h4
  · -- i = 0, c = 0
    rw [abs_inv]
    have h_pos : 0 < u 0 - w := by linarith
    rw [abs_of_pos h_pos]
    exact (inv_le_inv₀ h_pos hB_pos).mpr hu0
  · -- i = 0, c ≠ 0
    simp; linarith [inv_pos.mpr hB_pos]
  · -- i ≠ 0, c = 0
    rw [abs_mul, abs_neg, abs_inv, abs_inv]
    have h_pos0 : 0 < u 0 - w := by linarith
    have h_posi : 0 < u i := by linarith [hui i]
    rw [abs_of_pos h_pos0, abs_of_pos h_posi]
    have h1 : (u 0 - w)⁻¹ ≤ B⁻¹ := (inv_le_inv₀ h_pos0 hB_pos).mpr hu0
    have h2 : (u i)⁻¹ ≤ B⁻¹ := (inv_le_inv₀ h_posi hB_pos).mpr (hui i)
    have hprod : (u 0 - w)⁻¹ * (u i)⁻¹ ≤ B⁻¹ * B⁻¹ :=
      mul_le_mul h1 h2 (inv_nonneg.mpr (by linarith)) hB_inv_nonneg
    have hB_le_one : B⁻¹ ≤ 1 := by
      rw [inv_le_one_iff₀]
      right
      exact hB
    have hB2 : B⁻¹ * B⁻¹ ≤ B⁻¹ := by
      calc B⁻¹ * B⁻¹ ≤ 1 * B⁻¹ := mul_le_mul_of_nonneg_right hB_le_one hB_inv_nonneg
        _ = B⁻¹ := one_mul _
    linarith
  · -- i ≠ 0, c ≠ 0, i = c
    rw [abs_inv]
    have h_posc : 0 < u c := by linarith [hui c]
    rw [abs_of_pos h_posc]
    exact (inv_le_inv₀ h_posc hB_pos).mpr (hui c)
  · -- i ≠ 0, c ≠ 0, i ≠ c
    simp; linarith [inv_pos.mpr hB_pos]

theorem W_lower_inv_transpose_mulVec_bound {w : ℕ} (u v : Fin (w + 1) → ℚ) (B Mv : ℚ)
    (hB : 1 ≤ B)
    (hu0 : B ≤ u 0 - w)
    (hui : ∀ c, B ≤ u c)
    (hv : ∀ c, |v c| ≤ Mv) (k : Fin (w + 1)) :
    |((W_lower_inv w u).transpose.mulVec v) k| ≤ ((w + 1 : ℕ) : ℚ) * (B⁻¹ * Mv) := by
  dsimp [Matrix.mulVec, dotProduct, Matrix.transpose_apply]
  have h_tri : |∑ c : Fin (w + 1), W_lower_inv w u c k * v c| ≤
      ∑ c : Fin (w + 1), |W_lower_inv w u c k * v c| := Finset.abs_sum_le_sum_abs _ _
  have h_each : ∀ c : Fin (w + 1), |W_lower_inv w u c k * v c| ≤ B⁻¹ * Mv := by
    intro c
    rw [abs_mul]
    have hW := W_lower_inv_entry_bound u B hB hu0 hui c k
    exact mul_le_mul hW (hv c) (abs_nonneg _) (inv_nonneg.mpr (by linarith))
  have h_sum : (∑ c : Fin (w + 1), |W_lower_inv w u c k * v c|) ≤ ((w + 1 : ℕ) : ℚ) * (B⁻¹ * Mv) := by
    have := Finset.sum_le_card_nsmul Finset.univ (fun c => |W_lower_inv w u c k * v c|) (B⁻¹ * Mv)
      (fun c _ => h_each c)
    simp only [Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at this
    exact this
  linarith

theorem W_lower_inv_transpose_mul_mat_mul_W_lower_inv_bound {w : ℕ} (u : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (B ME : ℚ)
    (hB : 1 ≤ B)
    (hu0 : B ≤ u 0 - w)
    (hui : ∀ c, B ≤ u c)
    (hME : 0 ≤ ME)
    (hE : ∀ k l, |E k l| ≤ ME) (i j : Fin (w + 1)) :
    |((W_lower_inv w u).transpose * E * W_lower_inv w u) i j| ≤
      (((w + 1 : ℕ) : ℚ) * ((w + 1 : ℕ) : ℚ)) * (B⁻¹ * B⁻¹ * ME) := by
  let v : Fin (w + 1) → ℚ := fun c => (E * W_lower_inv w u) c j
  have h_mul : ((W_lower_inv w u).transpose * E * W_lower_inv w u) i j =
      ((W_lower_inv w u).transpose.mulVec v) i := by
    rw [Matrix.mul_assoc]
    rfl
  have hv : ∀ c, |v c| ≤ ((w + 1 : ℕ) : ℚ) * (B⁻¹ * ME) := by
    intro c
    dsimp [v, Matrix.mul_apply]
    have h_tri := Finset.abs_sum_le_sum_abs (fun l => E c l * W_lower_inv w u l j) Finset.univ
    have h_each : ∀ l : Fin (w + 1), |E c l * W_lower_inv w u l j| ≤ ME * B⁻¹ := by
      intro l
      rw [abs_mul]
      have h1 := hE c l
      have h2 := W_lower_inv_entry_bound u B hB hu0 hui l j
      exact mul_le_mul h1 h2 (abs_nonneg _) hME
    have h_sum : (∑ l : Fin (w + 1), |E c l * W_lower_inv w u l j|) ≤ ((w + 1 : ℕ) : ℚ) * (ME * B⁻¹) := by
      have := Finset.sum_le_card_nsmul Finset.univ (fun l => |E c l * W_lower_inv w u l j|) (ME * B⁻¹)
        (fun l _ => h_each l)
      simp only [Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at this
      exact this
    have h_comm : ((w + 1 : ℕ) : ℚ) * (ME * B⁻¹) = ((w + 1 : ℕ) : ℚ) * (B⁻¹ * ME) := by ring
    rw [h_comm] at h_sum
    linarith
  have h_bound := W_lower_inv_transpose_mulVec_bound u v B (((w + 1 : ℕ) : ℚ) * (B⁻¹ * ME)) hB hu0 hui hv i
  rw [h_mul]
  have heq : ((w + 1 : ℕ) : ℚ) * (B⁻¹ * (((w + 1 : ℕ) : ℚ) * (B⁻¹ * ME))) =
      (((w + 1 : ℕ) : ℚ) * ((w + 1 : ℕ) : ℚ)) * (B⁻¹ * B⁻¹ * ME) := by ring
  rw [heq] at h_bound
  exact h_bound

lemma abs_sum_le_card_mul {w : ℕ} (f : Fin (w + 1) → ℚ) (M : ℚ)
    (hf : ∀ c, |f c| ≤ M) :
    |∑ c, f c| ≤ ((w + 1 : ℕ) : ℚ) * M := by
  have h_tri := Finset.abs_sum_le_sum_abs f Finset.univ
  have h_sum := Finset.sum_le_card_nsmul Finset.univ (fun c => |f c|) M (fun c _ => hf c)
  simp only [Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at h_sum
  linarith

theorem W_lower_inv_transpose_mul_mat_entry_bound {w : ℕ} (u : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (B ME : ℚ)
    (hB : 1 ≤ B)
    (hu0 : B ≤ u 0 - w)
    (hui : ∀ c, B ≤ u c)
    (hE : ∀ k l, |E k l| ≤ ME) (j c : Fin (w + 1)) :
    |((W_lower_inv w u).transpose * E) j c| ≤ ((w + 1 : ℕ) : ℚ) * (B⁻¹ * ME) := by
  let v : Fin (w + 1) → ℚ := fun k => E k c
  have heq : ((W_lower_inv w u).transpose * E) j c = ((W_lower_inv w u).transpose.mulVec v) j := rfl
  rw [heq]
  have hv : ∀ k, |v k| ≤ ME := fun k => hE k c
  exact W_lower_inv_transpose_mulVec_bound u v B ME hB hu0 hui hv j

theorem mat_mul_W_lower_inv_entry_bound {w : ℕ} (u : Fin (w + 1) → ℚ)
    {m : ℕ} (D : Matrix (Fin m) (Fin (w + 1)) ℚ) (B MD : ℚ)
    (hB : 1 ≤ B)
    (hu0 : B ≤ u 0 - w)
    (hui : ∀ c, B ≤ u c)
    (hD : ∀ x c, |D x c| ≤ MD) (x : Fin m) (i : Fin (w + 1)) :
    |∑ c : Fin (w + 1), D x c * (W_lower_inv w u) c i| ≤ ((w + 1 : ℕ) : ℚ) * (MD * B⁻¹) := by
  have h_each : ∀ c : Fin (w + 1), |D x c * (W_lower_inv w u) c i| ≤ MD * B⁻¹ := by
    intro c
    rw [abs_mul]
    have h1 := hD x c
    have h2 := W_lower_inv_entry_bound u B hB hu0 hui c i
    have hMD_nonneg : 0 ≤ MD := le_trans (abs_nonneg _) h1
    exact mul_le_mul h1 h2 (abs_nonneg _) hMD_nonneg
  exact abs_sum_le_card_mul (fun c => D x c * (W_lower_inv w u) c i) (MD * B⁻¹) h_each

lemma term1_bound {w : ℕ} (u : Fin (w + 1) → ℚ) (ell_base zeta : Fin (w + 1) → ℚ)
    {m : ℕ} (L_X : Matrix (Fin m) (Fin (w + 1)) ℚ)
    (B Mbase Mzeta MLC : ℚ)
    (hB : 1 ≤ B) (hu0 : B ≤ u 0 - w) (hui : ∀ c, B ≤ u c)
    (h_base : ∀ c, |ell_base c| ≤ Mbase)
    (h_zeta : ∀ c, |zeta c| ≤ Mzeta)
    (h_LX : ∀ x c, |L_X x c| ≤ MLC) (x : Fin m) (j : Fin (w + 1)) :
    |∑ c : Fin (w + 1), L_X x c * (((W_lower_inv w u).transpose.mulVec ell_base j) * zeta c)| ≤
      (((w + 1 : ℕ) : ℚ) * ((w + 1 : ℕ) : ℚ)) * (B⁻¹ * (MLC * Mbase * Mzeta)) := by
  have hv : |(W_lower_inv w u).transpose.mulVec ell_base j| ≤ ((w + 1 : ℕ) : ℚ) * (B⁻¹ * Mbase) :=
    W_lower_inv_transpose_mulVec_bound u ell_base B Mbase hB hu0 hui h_base j
  have hB_inv_nonneg : 0 ≤ B⁻¹ := inv_nonneg.mpr (by linarith)
  have hMbase_nonneg : 0 ≤ Mbase := le_trans (abs_nonneg _) (h_base 0)
  have hMzeta_nonneg : 0 ≤ Mzeta := le_trans (abs_nonneg _) (h_zeta 0)
  have hMLC_nonneg : 0 ≤ MLC := le_trans (abs_nonneg _) (h_LX x 0)
  have h_each : ∀ c : Fin (w + 1),
      |L_X x c * (((W_lower_inv w u).transpose.mulVec ell_base j) * zeta c)| ≤
        ((w + 1 : ℕ) : ℚ) * (B⁻¹ * (MLC * Mbase * Mzeta)) := by
    intro c
    rw [abs_mul, abs_mul]
    have h1 := h_LX x c
    have h2 := hv
    have h3 := h_zeta c
    have h_prod23 : |(W_lower_inv w u).transpose.mulVec ell_base j| * |zeta c| ≤
        (((w + 1 : ℕ) : ℚ) * (B⁻¹ * Mbase)) * Mzeta := by
      apply mul_le_mul h2 h3 (abs_nonneg _)
      have : 0 ≤ B⁻¹ * Mbase := mul_nonneg hB_inv_nonneg hMbase_nonneg
      positivity
    have h_all : |L_X x c| * (|(W_lower_inv w u).transpose.mulVec ell_base j| * |zeta c|) ≤
        MLC * ((((w + 1 : ℕ) : ℚ) * (B⁻¹ * Mbase)) * Mzeta) := by
      apply mul_le_mul h1 h_prod23
      · positivity
      · exact hMLC_nonneg
    have heq : MLC * ((((w + 1 : ℕ) : ℚ) * (B⁻¹ * Mbase)) * Mzeta) =
        ((w + 1 : ℕ) : ℚ) * (B⁻¹ * (MLC * Mbase * Mzeta)) := by ring
    linarith
  have h_sum := abs_sum_le_card_mul (fun c => L_X x c * (((W_lower_inv w u).transpose.mulVec ell_base j) * zeta c))
    (((w + 1 : ℕ) : ℚ) * (B⁻¹ * (MLC * Mbase * Mzeta))) h_each
  have heq : ((w + 1 : ℕ) : ℚ) * (((w + 1 : ℕ) : ℚ) * (B⁻¹ * (MLC * Mbase * Mzeta))) =
      (((w + 1 : ℕ) : ℚ) * ((w + 1 : ℕ) : ℚ)) * (B⁻¹ * (MLC * Mbase * Mzeta)) := by ring
  linarith

lemma term2_bound {w : ℕ} (u : Fin (w + 1) → ℚ) (E_base : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    {m : ℕ} (L_X : Matrix (Fin m) (Fin (w + 1)) ℚ)
    (B ME MLC : ℚ)
    (hB : 1 ≤ B) (hu0 : B ≤ u 0 - w) (hui : ∀ c, B ≤ u c)
    (h_E : ∀ k l, |E_base k l| ≤ ME)
    (h_LX : ∀ x c, |L_X x c| ≤ MLC) (x : Fin m) (j : Fin (w + 1)) :
    |∑ c : Fin (w + 1), L_X x c * ((W_lower_inv w u).transpose * E_base) j c| ≤
      (((w + 1 : ℕ) : ℚ) * ((w + 1 : ℕ) : ℚ)) * (B⁻¹ * (MLC * ME)) := by
  have h_each : ∀ c : Fin (w + 1),
      |L_X x c * ((W_lower_inv w u).transpose * E_base) j c| ≤
        ((w + 1 : ℕ) : ℚ) * (B⁻¹ * (MLC * ME)) := by
    intro c
    rw [abs_mul]
    have h1 := h_LX x c
    have h2 := W_lower_inv_transpose_mul_mat_entry_bound u E_base B ME hB hu0 hui h_E j c
    have hB_inv_nonneg : 0 ≤ B⁻¹ := inv_nonneg.mpr (by linarith)
    have hME_nonneg : 0 ≤ ME := le_trans (abs_nonneg _) (h_E 0 0)
    have hMLC_nonneg : 0 ≤ MLC := le_trans (abs_nonneg _) (h_LX x 0)
    have h_prod : |L_X x c| * |((W_lower_inv w u).transpose * E_base) j c| ≤
        MLC * (((w + 1 : ℕ) : ℚ) * (B⁻¹ * ME)) := by
      apply mul_le_mul h1 h2 (abs_nonneg _) hMLC_nonneg
    have heq : MLC * (((w + 1 : ℕ) : ℚ) * (B⁻¹ * ME)) =
        ((w + 1 : ℕ) : ℚ) * (B⁻¹ * (MLC * ME)) := by ring
    linarith
  have h_sum := abs_sum_le_card_mul (fun c => L_X x c * ((W_lower_inv w u).transpose * E_base) j c)
    (((w + 1 : ℕ) : ℚ) * (B⁻¹ * (MLC * ME))) h_each
  have heq : ((w + 1 : ℕ) : ℚ) * (((w + 1 : ℕ) : ℚ) * (B⁻¹ * (MLC * ME))) =
      (((w + 1 : ℕ) : ℚ) * ((w + 1 : ℕ) : ℚ)) * (B⁻¹ * (MLC * ME)) := by ring
  linarith

lemma B_inv_eq {alpha c_zeta : ℚ} (ha : 0 < alpha) (hc : 0 < c_zeta) :
    (alpha * (c_zeta / 4))⁻¹ = (4 / c_zeta) * alpha⁻¹ := by
  have ha_ne : alpha ≠ 0 := ne_of_gt ha
  have hc_ne : c_zeta ≠ 0 := ne_of_gt hc
  have h_prod : (alpha * (c_zeta / 4)) * ((4 / c_zeta) * alpha⁻¹) = 1 := by
    calc (alpha * (c_zeta / 4)) * ((4 / c_zeta) * alpha⁻¹)
      _ = (alpha * alpha⁻¹) * ((c_zeta * 4⁻¹) * (4 * c_zeta⁻¹)) := by ring
      _ = 1 * ((c_zeta * c_zeta⁻¹) * (4⁻¹ * 4)) := by rw [mul_inv_cancel₀ ha_ne]; ring
      _ = 1 * (1 * 1) := by rw [mul_inv_cancel₀ hc_ne, inv_mul_cancel₀ (by norm_num)]
      _ = 1 := by ring
  exact inv_eq_of_mul_eq_one_right h_prod

lemma mul_inv_le_one_of_le {X alpha : ℚ} (ha : 0 < alpha) (hle : X ≤ alpha) :
    X * alpha⁻¹ ≤ 1 := by
  have : X * alpha⁻¹ ≤ alpha * alpha⁻¹ := mul_le_mul_of_nonneg_right hle (le_of_lt (inv_pos.mpr ha))
  rw [mul_inv_cancel₀ (ne_of_gt ha)] at this
  exact this

lemma quad_bound_le_half_inv {K alpha : ℚ} (ha : 0 < alpha) (hle : 2 * K ≤ alpha) :
    K * (alpha⁻¹ * alpha⁻¹) ≤ 2⁻¹ * alpha⁻¹ := by
  have h_ne : alpha ≠ 0 := ne_of_gt ha
  have h_pos_inv : 0 ≤ alpha⁻¹ := le_of_lt (inv_pos.mpr ha)
  have h1 : (2 * K) * alpha⁻¹ ≤ alpha * alpha⁻¹ := mul_le_mul_of_nonneg_right hle h_pos_inv
  rw [mul_inv_cancel₀ h_ne] at h1
  have h2 : 2 * (K * (alpha⁻¹ * alpha⁻¹)) ≤ alpha⁻¹ := by
    calc 2 * (K * (alpha⁻¹ * alpha⁻¹)) = ((2 * K) * alpha⁻¹) * alpha⁻¹ := by ring
      _ ≤ 1 * alpha⁻¹ := mul_le_mul_of_nonneg_right h1 h_pos_inv
      _ = alpha⁻¹ := one_mul _
  linarith

lemma linear_margin_bound {Y c_old alpha : ℚ} (hc_old : 0 < c_old) (ha : 0 < alpha)
    (hle : 2 * Y / c_old ≤ alpha) :
    Y * alpha⁻¹ ≤ c_old / 2 := by
  have hc_ne : c_old ≠ 0 := ne_of_gt hc_old
  have h_ne : alpha ≠ 0 := ne_of_gt ha
  have h_pos_inv : 0 ≤ alpha⁻¹ := le_of_lt (inv_pos.mpr ha)
  have h1 : (2 * Y / c_old) * alpha⁻¹ ≤ alpha * alpha⁻¹ :=
    mul_le_mul_of_nonneg_right hle h_pos_inv
  rw [mul_inv_cancel₀ h_ne] at h1
  have h2 : (2 * Y / c_old) * alpha⁻¹ * c_old ≤ 1 * c_old :=
    mul_le_mul_of_nonneg_right h1 (le_of_lt hc_old)
  have heq : (2 * Y / c_old) * alpha⁻¹ * c_old = 2 * (Y * alpha⁻¹) := by
    calc (2 * Y / c_old) * alpha⁻¹ * c_old
      _ = (2 * Y * c_old⁻¹) * alpha⁻¹ * c_old := rfl
      _ = (2 * (Y * alpha⁻¹)) * (c_old⁻¹ * c_old) := by ring
      _ = (2 * (Y * alpha⁻¹)) * 1 := by rw [inv_mul_cancel₀ hc_ne]
      _ = 2 * (Y * alpha⁻¹) := by ring
  rw [heq, one_mul] at h2
  linarith

/-- Explicit alpha-threshold theorem guaranteeing subdiagonal positivity and preserved waiting margins. -/
theorem exists_alpha_for_X_pos_and_P_eta0_margins {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 : ℚ)
    (hzeta_pos : ∀ c, 0 < zeta_canonical (by omega) clock b c_step H0 c)
    (ell_base : Fin (w + 1) → ℚ)
    (E_base : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (a_old : Fin (clock.m + 1) → ℚ)
    (ha_pos : ∀ x, 0 < a_old x)
    (D : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    ∃ A_min : ℚ, 0 < A_min ∧
      ∀ alpha : ℚ, A_min ≤ alpha →
        let ell : Fin (w + 1) → ℚ := fun c => alpha * zeta_canonical (by omega) clock b c_step H0 c + ell_base c
        (2 * (w + 1 : ℚ) ≤ ell 0) ∧
        (∀ c : Fin (w + 1), 2 ≤ ell c) ∧
        (ell 0 / 2 - w ≠ 0) ∧
        (∀ j : Fin w, ell j.succ ≠ 0) ∧
        (∀ i j, 0 < ((W_lower_inv_u w ell).transpose * (E_outer2 hw clock b c_step H0 alpha + E_base) * W_lower_inv_u w ell) i j) ∧
        (∀ x j, a_old x / 2 ≤ P_eta0_inr_total (by omega) clock a_old ell ell_base E_base L_C b c_step H0 x j) ∧
        (∀ x i, P_eta0_inl_total (by omega) clock a_old ell ell_base E_base D L_C b c_step H0 x i ≤ - (a_old x / 2)) := by
  let zeta := zeta_canonical (by omega) clock b c_step H0
  let L_X := L_X_gateway L_C
  let Nw : ℚ := ((w + 1 : ℕ) : ℚ)
  have hNw_pos : 0 < Nw := by positivity
  have hNw_ge1 : 1 ≤ Nw := by
    have : 1 ≤ w + 1 := by omega
    have : (1 : ℚ) ≤ ((w + 1 : ℕ) : ℚ) := Nat.one_le_cast.mpr this
    exact this
  let c_zeta := Finset.univ.inf' Finset.univ_nonempty zeta
  have hc_zeta_pos : 0 < c_zeta := by
    rw [Finset.lt_inf'_iff]
    intro c _
    exact hzeta_pos c
  have hc_zeta_le : ∀ c, c_zeta ≤ zeta c := fun c =>
    Finset.inf'_le zeta (Finset.mem_univ c)
  let c_old := Finset.univ.inf' Finset.univ_nonempty a_old
  have hc_old_pos : 0 < c_old := by
    rw [Finset.lt_inf'_iff]
    intro x _
    exact ha_pos x
  have hc_old_le : ∀ x, c_old ≤ a_old x := fun x =>
    Finset.inf'_le a_old (Finset.mem_univ x)
  let M_zeta := 1 + Finset.univ.sup' Finset.univ_nonempty zeta
  have h_zeta_le : ∀ c, |zeta c| ≤ M_zeta := by
    intro c
    have hp : c ∈ Finset.univ := Finset.mem_univ _
    have hle := Finset.le_sup' zeta hp
    have hz_pos : 0 ≤ zeta c := le_of_lt (hzeta_pos c)
    rw [abs_of_nonneg hz_pos]
    linarith
  let M_base := 1 + Finset.univ.sup' Finset.univ_nonempty (fun c => |ell_base c|)
  have h_base_le : ∀ c, |ell_base c| ≤ M_base := by
    intro c
    have hp : c ∈ Finset.univ := Finset.mem_univ _
    have hle := Finset.le_sup' (fun c => |ell_base c|) hp
    linarith
  let M_E := 1 + Finset.univ.sup' Finset.univ_nonempty (fun p : Fin (w + 1) × Fin (w + 1) => |E_base p.1 p.2|)
  have h_E_le : ∀ k l, |E_base k l| ≤ M_E := by
    intro k l
    have hp : (k, l) ∈ Finset.univ := Finset.mem_univ _
    have hle := Finset.le_sup' (fun p : Fin (w + 1) × Fin (w + 1) => |E_base p.1 p.2|) hp
    linarith
  have hME_nonneg : 0 ≤ M_E := by
    have hp : ((0 : Fin (w + 1)), (0 : Fin (w + 1))) ∈ Finset.univ := Finset.mem_univ _
    have hle := Finset.le_sup' (fun p : Fin (w + 1) × Fin (w + 1) => |E_base p.1 p.2|) hp
    have habs : 0 ≤ |E_base 0 0| := abs_nonneg _
    linarith
  let M_D := 1 + Finset.univ.sup' Finset.univ_nonempty (fun p : Fin (clock.m + 1) × Fin (w + 1) => |D p.1 p.2|)
  have hMD_pos : 0 < M_D := by
    have hp : ((0 : Fin (clock.m + 1)), (0 : Fin (w + 1))) ∈ Finset.univ := Finset.mem_univ _
    have hle := Finset.le_sup' (fun p : Fin (clock.m + 1) × Fin (w + 1) => |D p.1 p.2|) hp
    have habs : 0 ≤ |D 0 0| := abs_nonneg _
    linarith
  have h_D_le : ∀ x c, |D x c| ≤ M_D := by
