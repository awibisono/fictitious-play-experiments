    | Sum.inl i =>
      if i.val = 0 then 7 / 18
      else if i.val = 1 then 4 / 18
      else 1 / 18
    | Sum.inr _ => 2 * H0 - 4 / 3

theorem rps_zeta_canonical_four_thirds_one_H0 (H0 : ℚ) :
    zeta_canonical (by decide) rpsFullRankClock.clock b_rps_local (4 / 3) H0 1 = 7 / 3 := by
