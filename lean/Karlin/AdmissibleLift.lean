/-- Base part of `ell_uniform_total` independent of `alpha`. -/
def ell_base_uniform_total {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) : Fin (w + 1) → ℚ :=
  - y_sum_uniform clock + ell_inner_uniform hw clock b c_step H0 delta

/-- Master affine decomposition of `ell_uniform_total` in `alpha`. -/
theorem ell_uniform_total_eq {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta alpha : ℚ) :
    ell_uniform_total hw clock b c_step H0 delta alpha =
      fun c => alpha * zeta_canonical (by omega) clock b c_step H0 c +
        ell_base_uniform_total hw clock b c_step H0 delta c := by
  ext c
  dsimp [ell_uniform_total, ell_uniform, ell_base_uniform_total]
  ring

/-- Base part of `E_uniform_total` independent of `alpha`. -/
def E_base_uniform_total {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta : ℚ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ :=
  E_rank2 (F_gw_border hw clock b c_step H0 delta) +
  E_outer1 hw clock b c_step +
  E_mat_U w (G_with_ell (G_inner_uniform hw clock b c_step H0 delta)
    (v_seq_fun hw clock b c_step)
    (ell_seq w (G_inner_uniform hw clock b c_step H0 delta) (v_seq_fun hw clock b c_step) (w - 1)))

/-- Master affine decomposition of `E_uniform_total` into `E_outer2` and `E_base`. -/
theorem E_uniform_total_eq {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 delta alpha : ℚ) :
    E_uniform_total hw clock b c_step H0 delta alpha =
      E_outer2 hw clock b c_step H0 alpha + E_base_uniform_total hw clock b c_step H0 delta := by
  ext i j
  dsimp [E_uniform_total, E_base_uniform_total, E_outer]
  ring

/-- Perturbed coupling matrix `P_uniform_total_lower_eta` using `J_lower_eta` and `P0_cone_old`. -/
def P_uniform_total_lower_eta {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha eta : ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (a_old : Fin (clock.m + 1) → ℚ) :
    Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  let ell := ell_uniform_total hw clock b c_step H0 delta alpha
  let M := M_lower w ell
  let R_M := R_M_lower w ell
  let E := E_uniform_total hw clock b c_step H0 delta alpha
  let J := J_lower_eta w ell E eta
  let zeta := zeta_canonical (by omega) clock b c_step H0
  let P0 := P0_cone_old a_old w
  let D := D_uniform hw clock b c_step H0 delta
  let Q := Q_reset J M (B_mat (w + 1)) zeta
  let X := X_gateway clock
  let L_X := L_X_gateway L_C
  P_interp X L_X M R_M D Q P0

/-- Moment compatibility for `J_lower_eta` with `D_uniform` and `E_uniform_total`. -/
theorem D_uniform_transpose_mul_X_eq_M_lower_transpose_mul_Q_reset_lower_eta
    {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha eta : ℚ)
    (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0)
    (hu0 : ell_uniform_total hw clock b c_step H0 delta alpha 0 / 2 - w ≠ 0)
    (hui : ∀ i : Fin w, ell_uniform_total hw clock b c_step H0 delta alpha i.succ ≠ 0) :
    let ell := ell_uniform_total hw clock b c_step H0 delta alpha
    let E := E_uniform_total hw clock b c_step H0 delta alpha
    let J := J_lower_eta w ell E eta
    let M := M_lower w ell
    let zeta := zeta_canonical (by omega) clock b c_step H0
    (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock =
      M.transpose * Q_reset J M (B_mat (w + 1)) zeta := by
  intro ell E J M zeta
  have hMJM : M.transpose * J * M = E :=
    M_lower_transpose_mul_J_lower_eta_mul_M_lower w ell E eta hu0 hui
  have hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row M).transpose * psi_row zeta (B_mat (w + 1)) := by
    have hfull := E_uniform_full_moment_equation hw clock b c_step H0 delta alpha hR
    rw [ell_row_M_lower w ell]
    exact hfull
  exact uniform_moment_compat hw clock b c_step H0 delta M J E zeta hMJM hmoment

/-- Master wrapper theorem: existence of odd integer alpha and strictly positive eta
    yielding strictly positive subdiagonals of `J_lower_eta` and strictly preserved waiting margins. -/
theorem exists_odd_alpha_and_eta_for_uniform_total {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (hzeta_pos : ∀ c, 0 < zeta_canonical (by omega) clock b c_step H0 c)
    (a_old : Fin (clock.m + 1) → ℚ)
    (ha_pos : ∀ x, 0 < a_old x)
    (h_cone : Matrix.vecMul a_old (X_gateway clock) =
      Matrix.vecMul (zeta_canonical (by omega) clock b c_step H0) (1 + B_mat (w + 1)))
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0) :
    ∃ (m_alpha : ℕ) (eta : ℚ),
      let alpha : ℚ := 3 * (2 * (m_alpha : ℚ) + 1)
      let ell := ell_uniform_total hw clock b c_step H0 delta alpha
      let E := E_uniform_total hw clock b c_step H0 delta alpha
      let P := P_uniform_total_lower_eta hw clock b c_step H0 delta alpha eta L_C a_old
      0 < eta ∧
      (2 * (w + 1 : ℚ) ≤ ell 0) ∧
      (∀ c : Fin (w + 1), 2 ≤ ell c) ∧
      (ell 0 / 2 - w ≠ 0) ∧
      (∀ j : Fin w, ell j.succ ≠ 0) ∧
      (∀ a b_act : Fin ((w + 1) + (w + 1)), b_act.val < a.val → 0 < J_lower_eta w ell E eta a b_act) ∧
      (∀ (x : Fin (clock.m + 1)) (j : Fin (w + 1)),
        a_old x / 4 ≤ P x (finSumFinEquiv (Sum.inr j))) ∧
      (∀ (x : Fin (clock.m + 1)) (i : Fin (w + 1)),
        P x (finSumFinEquiv (Sum.inl i)) ≤ - (a_old x / 4)) := by
  let ell_base := ell_base_uniform_total hw clock b c_step H0 delta
  let E_base := E_base_uniform_total hw clock b c_step H0 delta
  let D := D_uniform hw clock b c_step H0 delta
  obtain ⟨A_min, hA_pos, hA⟩ := exists_alpha_for_X_pos_and_P_eta0_margins hw clock b c_step H0 hzeta_pos
    ell_base E_base a_old ha_pos D L_C
  obtain ⟨N, hN⟩ := exists_nat_gt A_min
  let m_alpha := N
  let alpha : ℚ := 3 * (2 * (m_alpha : ℚ) + 1)
  have h_alpha_ge : A_min ≤ alpha := by
    have hN_nonneg : 0 ≤ (m_alpha : ℚ) := Nat.cast_nonneg m_alpha
    linarith
  have h_alpha_pos : 0 < alpha := by
    linarith [hA_pos, h_alpha_ge]
  have h_alpha_props := hA alpha h_alpha_ge
  dsimp at h_alpha_props
  have hell_eq : (fun c => alpha * zeta_canonical (by omega) clock b c_step H0 c + ell_base c) =
      ell_uniform_total hw clock b c_step H0 delta alpha := by
    ext c
    rw [ell_uniform_total_eq]
  have hE_eq : E_uniform_total hw clock b c_step H0 delta alpha =
      E_outer2 hw clock b c_step H0 alpha + E_base := by
    rw [E_uniform_total_eq]
  let ell := ell_uniform_total hw clock b c_step H0 delta alpha
  let E := E_uniform_total hw clock b c_step H0 delta alpha
  have hell_at (c : Fin (w + 1)) : alpha * zeta_canonical (by omega) clock b c_step H0 c + ell_base c = ell c :=
    congr_fun hell_eq c
  have h_ell0 : 2 * (w + 1 : ℚ) ≤ ell 0 := by
    have h := h_alpha_props.1
    change 2 * (w + 1 : ℚ) ≤ alpha * zeta_canonical (by omega) clock b c_step H0 0 + ell_base 0 at h
    rw [hell_at 0] at h
    exact h
  have h_ell_c : ∀ c, 2 ≤ ell c := by
    intro c
    have h := h_alpha_props.2.1 c
    change 2 ≤ alpha * zeta_canonical (by omega) clock b c_step H0 c + ell_base c at h
    rw [hell_at c] at h
    exact h
  have hu0 : ell 0 / 2 - w ≠ 0 := by
    have h := h_alpha_props.2.2.1
    change (alpha * zeta_canonical (by omega) clock b c_step H0 0 + ell_base 0) / 2 - w ≠ 0 at h
    rw [hell_at 0] at h
    exact h
  have hui : ∀ j : Fin w, ell j.succ ≠ 0 := by
    intro j
    have h := h_alpha_props.2.2.2.1 j
    change (alpha * zeta_canonical (by omega) clock b c_step H0 j.succ + ell_base j.succ) ≠ 0 at h
    rw [hell_at j.succ] at h
    exact h
  have hX_pos : ∀ i j, 0 < ((W_lower_inv_u w ell).transpose * (E_outer2 hw clock b c_step H0 alpha + E_base) * W_lower_inv_u w ell) i j := by
    intro i j
    have h := h_alpha_props.2.2.2.2.1 i j
    rwa [hell_eq] at h
  have hP_inr : ∀ x j, a_old x / 2 ≤ P_eta0_inr_total (by omega) clock a_old ell ell_base E_base L_C b c_step H0 x j := by
    intro x j
    have h := h_alpha_props.2.2.2.2.2.1 x j
    rwa [hell_eq] at h
  have hP_inl : ∀ x i, P_eta0_inl_total (by omega) clock a_old ell ell_base E_base D L_C b c_step H0 x i ≤ - (a_old x / 2) := by
    intro x i
    have h := h_alpha_props.2.2.2.2.2.2 x i
    rwa [hell_eq] at h
  obtain ⟨eta, heta_pos, hJ_subdiag, hmargin_inr, hmargin_inl⟩ :=
    exists_eta_subdiag_pos_and_P_interp_margins_total hw clock b c_step H0 alpha
      ell ell_base E_base a_old D L_C ha_pos hX_pos hP_inr hP_inl
  have hJ_subdiag_E : ∀ a b_act : Fin ((w + 1) + (w + 1)), b_act.val < a.val → 0 < J_lower_eta w ell E eta a b_act := by
    intro a b_act hab
    have h := hJ_subdiag a b_act hab
    dsimp [E]
    rw [hE_eq]
    exact h
  have hu_def : ∀ c, ell c = alpha * zeta_canonical (by omega) clock b c_step H0 c + ell_base c := by
    intro c
    exact congr_fun (ell_uniform_total_eq hw clock b c_step H0 delta alpha) c
  have h_compat : D.transpose * X_gateway clock = (M_lower w ell).transpose *
      (Q_reset (J_lower_eta w ell (E_outer2 hw clock b c_step H0 alpha + E_base) eta) (M_lower w ell) (B_mat (w + 1))
        (zeta_canonical (by omega) clock b c_step H0)) := by
    have hcompat0 := D_uniform_transpose_mul_X_eq_M_lower_transpose_mul_Q_reset_lower_eta
      hw clock b c_step H0 delta alpha eta hR hu0 hui
    dsimp [D, ell, E] at hcompat0
    rw [hE_eq] at hcompat0
    exact hcompat0
  have hP_eq_inr : ∀ x j, P_uniform_total_lower_eta hw clock b c_step H0 delta alpha eta L_C a_old x (finSumFinEquiv (Sum.inr j)) =
      P_eta0_inr_total (by omega) clock a_old ell ell_base E_base L_C b c_step H0 x j - eta * err_eta clock L_C ell x j := by
    intro x j
    dsimp [P_uniform_total_lower_eta, ell, E]
    rw [hE_eq]
    exact P_interp_decomp_inr_total hw clock b c_step H0 alpha ell ell_base E_base eta a_old D L_C hu0 hui hu_def h_cone j x
  have hP_eq_inl : ∀ x i, P_uniform_total_lower_eta hw clock b c_step H0 delta alpha eta L_C a_old x (finSumFinEquiv (Sum.inl i)) =
      P_eta0_inl_total (by omega) clock a_old ell ell_base E_base D L_C b c_step H0 x i + eta * err_eta clock L_C ell x i := by
    intro x i
    dsimp [P_uniform_total_lower_eta, ell, E]
    rw [hE_eq]
    exact P_interp_decomp_inl_total hw clock b c_step H0 alpha ell ell_base E_base eta a_old D L_C hu0 hui hu_def h_cone h_compat i x
  refine ⟨m_alpha, eta, heta_pos, h_ell0, h_ell_c, hu0, hui, hJ_subdiag_E, ?_, ?_⟩
  · intro x j
    rw [hP_eq_inr x j]
    exact hmargin_inr x j
  · intro x i
    rw [hP_eq_inl x i]
    exact hmargin_inl x i


def b_rps_local : Fin rpsAlgebraicClock.m := ⟨0, by decide⟩

theorem rps_zeta_canonical_zero :
    zeta_canonical (by decide) rpsFullRankClock.clock b_rps_local (3 / 2) 2 0 = 2 := rfl

theorem rps_zeta_canonical_one :
    zeta_canonical (by decide) rpsFullRankClock.clock b_rps_local (3 / 2) 2 1 = 5 / 2 := by
  dsimp [zeta_canonical, v_step, b_rps_local, rpsFullRankClock, rpsAlgebraicClock, R2, Matrix.vecMul, dotProduct]
  simp only [Fin.sum_univ_three, N_mat, Matrix.one_apply, Matrix.of_apply, Matrix.vecCons]
  norm_num

theorem rps_zeta_canonical_two :
    zeta_canonical (by decide) rpsFullRankClock.clock b_rps_local (3 / 2) 2 2 = 1 := by
  dsimp [zeta_canonical, v_step, b_rps_local, rpsFullRankClock, rpsAlgebraicClock, R2, Matrix.vecMul, dotProduct]
  simp only [Fin.sum_univ_three, N_mat, Matrix.one_apply, Matrix.of_apply, Matrix.vecCons]
