section GroundedRealizedClockTower

variable {w : ℕ} (grc : GroundedRealizedClock w)

/-- Next-order leader action in `clock'`. -/
def step_b : Fin grc.step_rc.fc.clock.m :=
  rotLeaderEquiv (grc.rc.fc.clock.m + 1) ((w + 1) + (w + 1))
    (Sum.inl (gatewayOldAct grc.rc.fc.clock.m))

/-- Subdiagonal preservation: top-order entry of leader in lifted clock equals 1. -/
theorem hb'_subdiag_of_grc (hb_subdiag : grc.rc.fc.clock.R grc.b ⟨w - 1, by have := grc.hw; omega⟩ = 1) :
    grc.step_rc.fc.clock.R (step_b grc) ⟨w, Nat.lt_succ_self w⟩ = 1 := by
  have hw2 := grc.hw
  let clock := grc.rc.fc.clock
  let b := grc.b
  let c_step := grc.c_step
  let H0 := grc.H0
  let delta := grc.delta
  let u := grc.u
  have hu0 : w + 1 ≤ u 0 := grc.hu0
  let M_nat := M_lower_nat w u
  let R_M := R_M_lower w (fun c => 2 * (u c : ℚ))
  let E := E_uniform_total grc.hw clock b c_step H0 delta grc.alpha
  let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) E grc.eta
  let zeta := zeta_canonical (Nat.le_of_succ_le grc.hw) clock b c_step H0
  let h := h_uniform clock b zeta c_step
  let S := S_uniform (by omega) clock b h delta
  let G_O := AdjoinLeaderEndpointG clock.G b clock.v
  let X := X_gateway clock
  let M := M_of_nat M_nat
  have hR_apply : grc.step_rc.fc.clock.R (step_b grc) ⟨w, Nat.lt_succ_self w⟩ =
      (liftedScoreMat G_O J S X M zeta) (Sum.inl (gatewayOldAct clock.m)) ⟨w, Nat.lt_succ_self w⟩ := by
    change (uniformFullRankLift_M grc.hw grc.rc.fc b c_step H0 delta
      M_nat R_M J E zeta grc.P0
      (R_M_lower_mul_M_lower_nat w u grc.hu0 grc.hui)
      (M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w u E grc.eta grc.hu0 grc.hui)
      (E_uniform_total_moment_equation_M_lower_nat grc.hw clock b c_step H0 delta grc.alpha u
        (by omega) grc.hell (by rw [grc.hb_subdiag]; norm_num))).clock.R
      (step_b grc) ⟨w, Nat.lt_succ_self w⟩ = _
    dsimp [uniformFullRankLift_M, step_b, AlgebraicClock.ofEquiv]
    simp only [Equiv.symm_apply_apply]
    rfl
  rw [hR_apply]
  dsimp [liftedScoreMat]
  have h_entry := S_add_GO_X_gateway_apply (by omega) clock b h delta ⟨w, Nat.lt_succ_self w⟩
  change (S + G_O * X) (gatewayOldAct clock.m) ⟨w, Nat.lt_succ_self w⟩ = _
  rw [h_entry]
  have hw_ne0 : ¬ (w = 0) := by omega
  have h_if : (if (⟨w, Nat.lt_succ_self w⟩ : Fin (w + 1)).val = 0 then clock.R b ⟨0, by omega⟩ + delta else 0) = 0 := by
    simp only [hw_ne0, ↓reduceIte]
  rw [h_if, add_zero]
  have h_shift : (clock.G * shiftRightCount clock.C) b ⟨w, Nat.lt_succ_self w⟩ = 0 := by
    have h_mul := shiftRightCount_R_mul_N_mat (by omega) clock b ⟨w, Nat.lt_succ_self w⟩
    dsimp only at h_mul
    rw [if_neg hw_ne0] at h_mul
    rw [← h_mul]
    rw [mul_N_mat_apply]
    have h_col : ¬ (w + 1 < w + 1) := by omega
    simp only [h_col, ↓reduceDIte]
  rw [h_shift, add_zero]
  dsimp [h, h_uniform]
  have h_w_lt : ¬ (w < w) := by omega
  simp only [h_w_lt, hw_ne0, ↓reduceDIte, ↓reduceIte, sub_zero]
  exact zeta_canonical_top_eq_one hw2 clock b c_step H0 hb_subdiag

/-- Evaluation of leader row in lifted clock for any positive column j > 0 matches zeta j. -/
theorem step_b_R_pos (j : Fin (w + 1)) (hj : 0 < j.val) :
