/-- Difference matrix `F_admissible = K - ℓᵀ * ψ(ζ)` is independent of `delta`. -/
theorem F_admissible_indep_of_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    F_admissible clock b H0 ch delta = F_admissible clock b H0 ch 0 := by
  dsimp only [F_admissible]
  rw [K_admissible_indep_of_delta clock b H0 ch delta]
  rw [zeta_admissible_indep_of_delta clock b H0 ch delta]

/-- Difference matrix `F_admissible` is independent of both `H0` and `delta`. -/
theorem F_admissible_indep_of_H0_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta : ℚ) :
    F_admissible clock b H0 ch delta = F_admissible clock b 0 ch 0 := by
