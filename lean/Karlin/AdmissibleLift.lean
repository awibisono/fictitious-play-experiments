  · -- c = 1
    have : (⟨1, hc⟩ : Fin 3) = 1 := rfl
    rw [this]
    have h1_0 : shiftRightCount C2 0 1 = C2 0 0 := shiftRightCount_pos C2 0 1 (by decide)
    have h1_1 : shiftRightCount C2 1 1 = C2 1 0 := shiftRightCount_pos C2 1 1 (by decide)
    have h1_2 : shiftRightCount C2 2 1 = C2 2 0 := shiftRightCount_pos C2 2 1 (by decide)
    rw [h1_0, h1_1, h1_2, C2_zero_zero, C2_one_zero, C2_two_zero]
    rw [Fin.sum_univ_three]
    rw [B_mat_3_0_1, B_mat_3_1_1, B_mat_3_2_1]
    rw [one_3_0_1, one_3_1_1, one_3_2_1]
    have hz0 : zeta_canonical (by decide) rpsFullRankClock.clock b_rps_local (4 / 3) H0 0 = H0 := rfl
    have hz1 := rps_zeta_canonical_four_thirds_one_H0 H0
    have hz2 := rps_zeta_canonical_four_thirds_two_H0 H0
    rw [hz0, hz1, hz2]
    dsimp [e0_row]
    norm_num
  · -- c = 2
    have : (⟨2, hc⟩ : Fin 3) = 2 := rfl
    rw [this]
    have h2_0 : shiftRightCount C2 0 2 = C2 0 1 := shiftRightCount_pos C2 0 2 (by decide)
    have h2_1 : shiftRightCount C2 1 2 = C2 1 1 := shiftRightCount_pos C2 1 2 (by decide)
    have h2_2 : shiftRightCount C2 2 2 = C2 2 1 := shiftRightCount_pos C2 2 2 (by decide)
    rw [h2_0, h2_1, h2_2, C2_zero_one, C2_one_one, C2_two_one]
    rw [Fin.sum_univ_three]
    rw [B_mat_3_0_2, B_mat_3_1_2, B_mat_3_2_2]
    rw [one_3_0_2, one_3_1_2, one_3_2_2]
    have hz0 : zeta_canonical (by decide) rpsFullRankClock.clock b_rps_local (4 / 3) H0 0 = H0 := rfl
    have hz1 := rps_zeta_canonical_four_thirds_one_H0 H0
    have hz2 := rps_zeta_canonical_four_thirds_two_H0 H0
    rw [hz0, hz1, hz2]
    dsimp [e0_row]
    norm_num

/-- For any bundle suffix constant `C_bundle`, there exists an odd-integer-scaled baseline `H0`
    such that `a_old_rps_four_thirds_H0` is strictly positive, matches the gateway count projections,
    has parent weights bounded below by `1 / 72`, and gives strict gateway margin `> c_step + C_bundle`. -/
theorem exists_H0_rps_four_thirds_with_gateway_margin (C_bundle : ℚ) :
    ∃ H0 : ℚ,
      (∃ z : ℤ, 3 * H0 = (z : ℚ) ∧ ¬ Even z) ∧
      (∀ x, 0 < a_old_rps_four_thirds_H0 H0 x) ∧
      (Matrix.vecMul (a_old_rps_four_thirds_H0 H0) (X_gateway rpsFullRankClock.clock) =
        Matrix.vecMul (zeta_canonical (by decide) rpsFullRankClock.clock b_rps_local (4 / 3) H0) (1 + B_mat 3)) ∧
      (∀ i : Fin 3, (1 : ℚ) / 72 ≤ a_old_rps_four_thirds_H0 H0 (finSumFinEquiv (Sum.inl i)) / 4) ∧
      (4 * ((4 / 3 : ℚ) + C_bundle) < a_old_rps_four_thirds_H0 H0 (gatewayOldAct 3)) := by
  have hex_m : ∃ m : ℕ, (4 * ((4 / 3 : ℚ) + C_bundle) - 14 / 3) / 4 < (m : ℚ) := by
    exact exists_nat_gt _
  obtain ⟨m, hm⟩ := hex_m
  let H0 : ℚ := 3 + 2 * (m : ℚ)
  use H0
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · use 9 + 6 * (m : ℤ)
    constructor
    · push_cast; ring
    · intro h_even
      have h9 : Even (9 : ℤ) := by
        have h_sub : (9 : ℤ) = (9 + 6 * (m : ℤ)) - 2 * (3 * (m : ℤ)) := by ring
        rw [h_sub]
        exact Even.sub h_even (even_two_mul _)
      revert h9
      decide
  · intro x
    dsimp [a_old_rps_four_thirds_H0]
    split
    · split_ifs <;> norm_num
    · have : 0 ≤ (m : ℚ) := Nat.cast_nonneg m
      linarith
  · exact vecMul_a_old_rps_four_thirds_H0_X_gateway H0
  · intro i
    dsimp [a_old_rps_four_thirds_H0]
    simp
    split_ifs <;> norm_num
  · change 4 * ((4 / 3 : ℚ) + C_bundle) < a_old_rps_four_thirds_H0 H0 (finSumFinEquiv (Sum.inr (0 : Fin 1)))
    dsimp [a_old_rps_four_thirds_H0]
    simp
    linarith




/-!
## Section 35: Inductive Cone Vector Lift and Threshold Positivity
-/

/-- The combined count table for the lower/reset block of the lifted clock. -/
def C_lifted_lower (w : ℕ) (clock : AlgebraicClock w) (ell : Fin (w + 1) → ℚ) :
    Matrix (Fin ((clock.m + 1) + ((w + 1) + (w + 1)))) (Fin (w + 1)) ℚ :=
  Matrix.of fun y c =>
    match finSumFinEquiv.symm y with
    | Sum.inl i => (X_gateway clock * (1 + N_mat (w + 1)) : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ) i c
    | Sum.inr r => M_lower w ell r c

/-- The lifted cone vector on the extended action set `Fin (((clock.m + 1) + 2(w + 1)) + 1)`. -/
def a_old_lifted {w : ℕ} (clock : AlgebraicClock w) (ell : Fin (w + 1) → ℚ)
    (mu : ℚ) (v : Fin (w + 1) → ℚ) (a_g : ℚ) :
    Fin (((clock.m + 1) + ((w + 1) + (w + 1))) + 1) → ℚ :=
  fun x =>
    match finSumFinEquiv.symm x with
    | Sum.inl y =>
      match finSumFinEquiv.symm y with
      | Sum.inl _ => mu
      | Sum.inr r =>
        match finSumFinEquiv.symm r with
        | Sum.inl k => (1 / 2) * ((W_lower_inv_u w ell).transpose.mulVec v) k
        | Sum.inr k => (1 / 2) * ((W_lower_inv_u w ell).transpose.mulVec v) k
    | Sum.inr _ => a_g

/-- The gateway count table `X_gateway clock_+` for the lifted clock. -/
def X_gateway_lifted {w : ℕ} (clock : AlgebraicClock w) (ell : Fin (w + 1) → ℚ) :
    Matrix (Fin (((clock.m + 1) + ((w + 1) + (w + 1))) + 1)) (Fin (w + 2)) ℚ :=
  Matrix.of fun x c =>
    match finSumFinEquiv.symm x with
    | Sum.inl y => shiftRightCount (C_lifted_lower w clock ell) y c
    | Sum.inr _ => e0_row (w + 2) c

/-- Coordinate 0 of `vecMul a_old_lifted X_gateway_lifted` matches `a_g`. -/
theorem vecMul_a_old_lifted_X_gateway_zero {w : ℕ} (clock : AlgebraicClock w)
    (ell : Fin (w + 1) → ℚ) (mu : ℚ) (v : Fin (w + 1) → ℚ) (a_g : ℚ) :
    (Matrix.vecMul (a_old_lifted clock ell mu v a_g) (X_gateway_lifted clock ell)) 0 = a_g := by
  dsimp [Matrix.vecMul, dotProduct]
  have hcomp := (Equiv.sum_comp finSumFinEquiv fun x =>
    a_old_lifted clock ell mu v a_g x * X_gateway_lifted clock ell x 0).symm
  rw [hcomp, Fintype.sum_sum_type]
  have h_inl : (∑ y : Fin ((clock.m + 1) + ((w + 1) + (w + 1))),
      a_old_lifted clock ell mu v a_g (finSumFinEquiv (Sum.inl y)) *
      X_gateway_lifted clock ell (finSumFinEquiv (Sum.inl y)) 0) = 0 := by
    refine Finset.sum_eq_zero fun y _ => ?_
    simp only [X_gateway_lifted, Matrix.of_apply, Equiv.symm_apply_apply]
    have h0 : shiftRightCount (C_lifted_lower w clock ell) y 0 = 0 :=
      shiftRightCount_zero (C_lifted_lower w clock ell) y 0 rfl
    rw [h0, mul_zero]
  have h_inr : (∑ g : Fin 1,
      a_old_lifted clock ell mu v a_g (finSumFinEquiv (Sum.inr g)) *
      X_gateway_lifted clock ell (finSumFinEquiv (Sum.inr g)) 0) = a_g := by
    rw [Fin.sum_univ_one]
    simp only [X_gateway_lifted, a_old_lifted, Matrix.of_apply, Equiv.symm_apply_apply, e0_row]
    simp
  rw [h_inl, h_inr, zero_add]

/-- Coordinate `c.succ` of `vecMul a_old_lifted X_gateway_lifted` matches `mu • y_sum_uniform + v(c)`. -/
theorem vecMul_a_old_lifted_X_gateway_succ {w : ℕ} (clock : AlgebraicClock w)
    (ell : Fin (w + 1) → ℚ) (mu : ℚ) (v : Fin (w + 1) → ℚ) (a_g : ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ k : Fin w, ell k.succ ≠ 0)
    (c : Fin (w + 1)) :
    (Matrix.vecMul (a_old_lifted clock ell mu v a_g) (X_gateway_lifted clock ell)) c.succ =
      mu * y_sum_uniform clock c + v c := by
  dsimp [Matrix.vecMul, dotProduct]
  have hcomp := (Equiv.sum_comp finSumFinEquiv fun x =>
    a_old_lifted clock ell mu v a_g x * X_gateway_lifted clock ell x c.succ).symm
  rw [hcomp, Fintype.sum_sum_type]
  have he0 : e0_row (w + 2) c.succ = 0 := by
    simp [e0_row]
  have h_inr : (∑ g : Fin 1,
      a_old_lifted clock ell mu v a_g (finSumFinEquiv (Sum.inr g)) *
      X_gateway_lifted clock ell (finSumFinEquiv (Sum.inr g)) c.succ) = 0 := by
    rw [Fin.sum_univ_one]
    simp only [X_gateway_lifted, Matrix.of_apply, Equiv.symm_apply_apply]
    rw [he0, mul_zero]
  have hshift : ∀ y : Fin ((clock.m + 1) + ((w + 1) + (w + 1))),
      X_gateway_lifted clock ell (finSumFinEquiv (Sum.inl y)) c.succ =
        C_lifted_lower w clock ell y c := by
    intro y
    simp only [X_gateway_lifted, Matrix.of_apply, Equiv.symm_apply_apply]
    have hc_pos : 0 < c.succ.val := by
      rw [Fin.val_succ]
      omega
    have hc_lt : c.succ.val - 1 < w + 1 := by
      rw [Fin.val_succ, Nat.succ_sub_one]
      exact c.isLt
    have hs := shiftRightCount_pos (C_lifted_lower w clock ell) y c.succ hc_pos
    have hpred : (⟨c.succ.val - 1, hc_lt⟩ : Fin (w + 1)) = c := by
      ext
      simp only [Fin.val_succ, Nat.succ_sub_one]
    rw [hs, hpred]
  simp_rw [hshift]
  have hcomp2 := (Equiv.sum_comp finSumFinEquiv fun y =>
    a_old_lifted clock ell mu v a_g (finSumFinEquiv (Sum.inl y)) *
      C_lifted_lower w clock ell y c).symm
  rw [hcomp2, Fintype.sum_sum_type]
  have ha_top (i : Fin (clock.m + 1)) :
      a_old_lifted clock ell mu v a_g (finSumFinEquiv (Sum.inl (finSumFinEquiv (Sum.inl i)))) = mu := by
    simp only [a_old_lifted, Equiv.symm_apply_apply]
  have hC_top (i : Fin (clock.m + 1)) :
      C_lifted_lower w clock ell (finSumFinEquiv (Sum.inl i)) c =
        (X_gateway clock * (1 + N_mat (w + 1)) : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ) i c := by
    simp only [C_lifted_lower, Matrix.of_apply, Equiv.symm_apply_apply]
  simp_rw [ha_top, hC_top]
  have h_top_sum : (∑ i : Fin (clock.m + 1), mu *
      (X_gateway clock * (1 + N_mat (w + 1)) : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ) i c) =
      mu * y_sum_uniform clock c := by
    rw [← Finset.mul_sum]
    congr 1
    dsimp [y_sum_uniform, x_sum_uniform, Matrix.vecMul, dotProduct]
    simp only [Matrix.mul_apply]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro x _
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro i _
    simp only [Matrix.add_apply, one_mul]
  rw [h_top_sum]
  have hcomp_reset := (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
    a_old_lifted clock ell mu v a_g (finSumFinEquiv (Sum.inl (finSumFinEquiv (Sum.inr r)))) *
      C_lifted_lower w clock ell (finSumFinEquiv (Sum.inr r)) c).symm
  rw [hcomp_reset, Fintype.sum_sum_type]
  have ha_inl_reset (k : Fin (w + 1)) :
      a_old_lifted clock ell mu v a_g (finSumFinEquiv (Sum.inl (finSumFinEquiv (Sum.inr (finSumFinEquiv (Sum.inl k)))))) =
        (1 / 2) * ((W_lower_inv_u w ell).transpose.mulVec v) k := by
    simp only [a_old_lifted, Equiv.symm_apply_apply]
  have ha_inr_reset (k : Fin (w + 1)) :
      a_old_lifted clock ell mu v a_g (finSumFinEquiv (Sum.inl (finSumFinEquiv (Sum.inr (finSumFinEquiv (Sum.inr k)))))) =
        (1 / 2) * ((W_lower_inv_u w ell).transpose.mulVec v) k := by
    simp only [a_old_lifted, Equiv.symm_apply_apply]
  have hC_inl_reset (k : Fin (w + 1)) :
      C_lifted_lower w clock ell (finSumFinEquiv (Sum.inr (finSumFinEquiv (Sum.inl k)))) c =
        W_lower_u w ell k c := by
    simp only [C_lifted_lower, M_lower, Matrix.of_apply, Equiv.symm_apply_apply]
  have hC_inr_reset (k : Fin (w + 1)) :
      C_lifted_lower w clock ell (finSumFinEquiv (Sum.inr (finSumFinEquiv (Sum.inr k)))) c =
        W_lower_u w ell k c := by
    simp only [C_lifted_lower, M_lower, Matrix.of_apply, Equiv.symm_apply_apply]
  simp_rw [ha_inl_reset, ha_inr_reset, hC_inl_reset, hC_inr_reset]
  have h_half_sum : (∑ i : Fin (w + 1),
      (1 / 2 : ℚ) * ((W_lower_inv_u w ell).transpose.mulVec v) i * W_lower_u w ell i c) +
      (∑ i : Fin (w + 1),
      (1 / 2 : ℚ) * ((W_lower_inv_u w ell).transpose.mulVec v) i * W_lower_u w ell i c) =
      ∑ i : Fin (w + 1), ((W_lower_inv_u w ell).transpose.mulVec v) i * W_lower_u w ell i c := by
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [h_half_sum]
  have h_inv_eval : (∑ i : Fin (w + 1), ((W_lower_inv_u w ell).transpose.mulVec v) i * W_lower_u w ell i c) = v c := by
    dsimp [Matrix.mulVec, dotProduct, Matrix.transpose_apply]
    simp_rw [Finset.sum_mul]
    rw [Finset.sum_comm]
    have h_factor : ∀ l : Fin (w + 1),
        (∑ k : Fin (w + 1), W_lower_inv_u w ell l k * v l * W_lower_u w ell k c) =
          v l * (∑ k : Fin (w + 1), W_lower_inv_u w ell l k * W_lower_u w ell k c) := by
      intro l
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k _
      ring
    simp_rw [h_factor]
    have hui' : ∀ i : Fin w, (fun j => ell j / 2) i.succ ≠ 0 := fun i h => hui i (by linarith [h])
    have hW_one := W_lower_inv_mul_W_lower (fun j => ell j / 2) hu0 hui'
    have h_prod_entry : ∀ l : Fin (w + 1),
        (∑ k : Fin (w + 1), W_lower_inv_u w ell l k * W_lower_u w ell k c) =
          if l = c then 1 else 0 := by
      intro l
      have hl := congr_fun (congr_fun hW_one l) c
      simp only [Matrix.mul_apply, Matrix.one_apply, W_lower_inv_u, W_lower_u] at hl ⊢
      exact hl
    simp_rw [h_prod_entry]
    rw [Finset.sum_eq_single c]
    · simp
    · intro l _ hl
      rw [if_neg hl, mul_zero]
    · intro hc'; exfalso; exact hc' (Finset.mem_univ _)
  rw [h_inv_eval]
  rw [h_inr, add_zero]

/-- Positivity of all entries of `a_old_lifted`. -/
theorem a_old_lifted_pos {w : ℕ} (clock : AlgebraicClock w) (ell : Fin (w + 1) → ℚ)
    (mu : ℚ) (v : Fin (w + 1) → ℚ) (a_g : ℚ)
    (hmu : 0 < mu)
    (hag : 0 < a_g)
    (hWv : ∀ k : Fin (w + 1), 0 < ((W_lower_inv_u w ell).transpose.mulVec v) k)
    (x : Fin (((clock.m + 1) + ((w + 1) + (w + 1))) + 1)) :
    0 < a_old_lifted clock ell mu v a_g x := by
  dsimp [a_old_lifted]
  split
  · split
    · exact hmu
    · split
      · exact mul_pos (by norm_num) (hWv _)
      · exact mul_pos (by norm_num) (hWv _)
  · exact hag

/-- Threshold theorem: for large `c_step` and `H0 ≥ c_step + 1`, the lifted cone vector
    `a_old_lifted` is strictly positive on all actions and matches the gateway count projections. -/
theorem exists_c_step_H0_and_a_old_lifted {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (ell : Fin (w + 1) → ℚ) (hu0 : (w : ℚ) < ell 0 / 2) (hui : ∀ k : Fin w, 0 < ell k.succ / 2)
    (mu : ℚ) (hmu : 0 < mu)
    (s C0 : ℚ) (hs : 0 < s) (v_rest : Fin w → ℚ) (hv_rest : ∀ j : Fin w, 0 < v_rest j) :
    ∃ c_step_star : ℚ, ∀ c_step : ℚ, c_step_star < c_step →
      ∀ H0 : ℚ, c_step + 1 ≤ H0 →
        let v : Fin (w + 1) → ℚ := fun c =>
          if _ : c.val = 0 then s * c_step + C0
          else v_rest ⟨c.val - 1, by have := c.isLt; omega⟩
        let a_g : ℚ := 2 * H0 - c_step
        (∀ x, 0 < a_old_lifted clock ell mu v a_g x) ∧
        (0 < a_g) ∧
        ((Matrix.vecMul (a_old_lifted clock ell mu v a_g) (X_gateway_lifted clock ell)) 0 = a_g) ∧
        (∀ c : Fin (w + 1),
          (Matrix.vecMul (a_old_lifted clock ell mu v a_g) (X_gateway_lifted clock ell)) c.succ =
            mu * y_sum_uniform clock c + v c) := by
  obtain ⟨c_star, h_star⟩ := w_late_zero_pos_of_large_c_step hw (fun c => ell c / 2) hu0 hui s C0 hs v_rest
  let c_step_star := max c_star 0
  use c_step_star
  intro c_step hc_gt H0 hH0 v a_g
  have hc_star_lt : c_star < c_step := lt_of_le_of_lt (le_max_left c_star 0) hc_gt
  have hc_pos : 0 < c_step := lt_of_le_of_lt (le_max_right c_star 0) hc_gt
  have hag_pos : 0 < a_g := by
    dsimp [a_g]
    linarith
  have hu0_ne : ell 0 / 2 - w ≠ 0 := by linarith
  have hui_ne : ∀ k : Fin w, ell k.succ ≠ 0 := by
    intro k h
    have : ell k.succ / 2 = 0 := by linarith
    linarith [hui k]
  have hv_succ : ∀ j : Fin w, v j.succ = v_rest j := by
    intro j
    change (if _ : (j.succ : Fin (w + 1)).val = 0 then s * c_step + C0
      else v_rest ⟨(j.succ : Fin (w + 1)).val - 1, by have := (j.succ).isLt; omega⟩) = v_rest j
    have hne : ¬ ((j.succ : Fin (w + 1)).val = 0) := fun h => Fin.succ_ne_zero j (Fin.ext h)
    rw [dif_neg hne]
    have heq : (⟨(j.succ : Fin (w + 1)).val - 1, by have := (j.succ).isLt; omega⟩ : Fin w) = j := by ext; simp
    rw [heq]
  have hWv : ∀ k : Fin (w + 1), 0 < ((W_lower_inv_u w ell).transpose.mulVec v) k := by
    intro k
    refine Fin.cases ?_ ?_ k
    · exact h_star c_step hc_star_lt
    · intro j
      change 0 < ((W_lower_inv w (fun c => ell c / 2)).transpose.mulVec v) j.succ
      have hv_pos : 0 < v j.succ := by rw [hv_succ j]; exact hv_rest j
      exact W_lower_inv_transpose_mulVec_succ_pos w (fun c => ell c / 2) v j (hui j) hv_pos
  refine ⟨a_old_lifted_pos clock ell mu v a_g hmu hag_pos hWv, hag_pos, ?_, ?_⟩
  · exact vecMul_a_old_lifted_X_gateway_zero clock ell mu v a_g
  · intro c
    exact vecMul_a_old_lifted_X_gateway_succ clock ell mu v a_g hu0_ne hui_ne c


/-- Gateway margin extension for the lifted cone vector at order w ≥ 3:
    Parent weights of `a_old_lifted` are strictly positive and completely independent of `H0`,
    so their minimum `eps > 0` and the corresponding bundle constant `C_bundle_fn eps` are fixed first,
    after which `H0` can be chosen arbitrarily large to ensure `4 * (c_step + C_bundle) < a_g`. -/
theorem exists_c_step_H0_and_a_old_lifted_with_gateway_margin
    {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (ell : Fin (w + 1) → ℚ) (hu0 : (w : ℚ) < ell 0 / 2) (hui : ∀ k : Fin w, 0 < ell k.succ / 2)
    (mu : ℚ) (hmu : 0 < mu)
    (s C0 : ℚ) (hs : 0 < s) (v_rest : Fin w → ℚ) (hv_rest : ∀ j : Fin w, 0 < v_rest j)
    (C_bundle_fn : ℚ → ℚ) :
    ∃ c_step_star : ℚ, ∀ c_step : ℚ, c_step_star < c_step →
      let v : Fin (w + 1) → ℚ := fun c =>
        if _ : c.val = 0 then s * c_step + C0
        else v_rest ⟨c.val - 1, by have := c.isLt; omega⟩
      let a_ref := a_old_lifted clock ell mu v (2 * (c_step + 1) - c_step)
      ∃ eps : ℚ, 0 < eps ∧
        (∀ y : Fin ((clock.m + 1) + ((w + 1) + (w + 1))),
          eps ≤ a_ref (finSumFinEquiv (Sum.inl y)) / 4) ∧
        ∀ H0_bound : ℚ,
          ∃ H0 : ℚ, H0_bound ≤ H0 ∧ c_step + 1 ≤ H0 ∧
            (4 * (c_step + C_bundle_fn eps) < 2 * H0 - c_step) ∧
            (∀ x, 0 < a_old_lifted clock ell mu v (2 * H0 - c_step) x) ∧
            ((Matrix.vecMul (a_old_lifted clock ell mu v (2 * H0 - c_step)) (X_gateway_lifted clock ell)) 0 = 2 * H0 - c_step) ∧
            (∀ c : Fin (w + 1),
              (Matrix.vecMul (a_old_lifted clock ell mu v (2 * H0 - c_step)) (X_gateway_lifted clock ell)) c.succ =
                mu * y_sum_uniform clock c + v c) := by
  obtain ⟨c_step_star, h_base⟩ := exists_c_step_H0_and_a_old_lifted hw clock ell hu0 hui mu hmu s C0 hs v_rest hv_rest
  use c_step_star
  intro c_step hc_gt v
  let a_ref := a_old_lifted clock ell mu v (2 * (c_step + 1) - c_step)
  have h_props := h_base c_step hc_gt (c_step + 1) (by linarith)
  have h_pos_parent : ∀ y : Fin ((clock.m + 1) + ((w + 1) + (w + 1))),
      0 < a_ref (finSumFinEquiv (Sum.inl y)) / 4 := by
    intro y
    have h_any := h_props.1 (finSumFinEquiv (Sum.inl y))
    linarith
  let parent_vals := Finset.image (fun y => a_ref (finSumFinEquiv (Sum.inl y)) / 4) Finset.univ
  have h_nonempty : parent_vals.Nonempty := by
    use a_ref (finSumFinEquiv (Sum.inl 0)) / 4
    exact Finset.mem_image_of_mem _ (Finset.mem_univ 0)
  have h_min_pos : 0 < parent_vals.min' h_nonempty := by
    have h_mem := Finset.min'_mem parent_vals h_nonempty
    rw [Finset.mem_image] at h_mem
    obtain ⟨y, _, hy_eq⟩ := h_mem
    rw [← hy_eq]
    exact h_pos_parent y
  use parent_vals.min' h_nonempty
  refine ⟨h_min_pos, ?_, ?_⟩
  · intro y
    apply Finset.min'_le
    exact Finset.mem_image_of_mem _ (Finset.mem_univ y)
  · intro H0_bound
    let target := max H0_bound (max (c_step + 1) ((5 * c_step + 4 * C_bundle_fn (parent_vals.min' h_nonempty) + 1) / 2))
    use target
    have h_target_ge_bound : H0_bound ≤ target := le_max_left _ _
    have h_target_ge_step : c_step + 1 ≤ target := le_trans (le_max_left _ _) (le_max_right _ _)
    have h_target_ge_margin : (5 * c_step + 4 * C_bundle_fn (parent_vals.min' h_nonempty) + 1) / 2 ≤ target :=
      le_trans (le_max_right _ _) (le_max_right _ _)
    have h_margin : 4 * (c_step + C_bundle_fn (parent_vals.min' h_nonempty)) < 2 * target - c_step := by
      linarith
    have h_props_target := h_base c_step hc_gt target h_target_ge_step
    exact ⟨h_target_ge_bound, h_target_ge_step, h_margin, h_props_target.1, h_props_target.2.2.1, h_props_target.2.2.2⟩




open scoped BigOperators

set_option linter.unusedSimpArgs false


/-!
### Section: Grounded Realized Clock and Natural-Number Matrix Calibration
-/

/-- Natural-number lower-triangular column-calibrated matrix W_lower_nat. -/
def W_lower_nat (w : ℕ) (u : Fin (w + 1) → ℕ) : Matrix (Fin (w + 1)) (Fin (w + 1)) ℕ :=
  Matrix.of fun i c =>
    if i.val = 0 then (if c.val = 0 then u 0 - w else 0)
    else (if c.val = 0 then 1 else if i = c then u c else 0)

/-- Stacked natural-number reset matrix M_lower_nat. -/
def M_lower_nat (w : ℕ) (u : Fin (w + 1) → ℕ) : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ :=
  Matrix.of fun r c =>
    match finSumFinEquiv.symm r with
    | Sum.inl i => W_lower_nat w u i c
    | Sum.inr i => W_lower_nat w u i c

/-- Column 0 positivity for M_lower_nat: every reset row has at least 1 in column 0. -/
theorem M_lower_nat_col_zero_ge_one (w : ℕ) (u : Fin (w + 1) → ℕ)
    (hu0 : w + 1 ≤ u 0) (r : Fin ((w + 1) + (w + 1))) :
    1 ≤ M_lower_nat w u r ⟨0, Nat.succ_pos w⟩ := by
  dsimp [M_lower_nat, W_lower_nat]
  cases finSumFinEquiv.symm r with
  | inl i =>
    refine Fin.cases ?_ ?_ i
    · simp only [Fin.val_zero, ↓reduceIte]
      omega
    · intro ji
      simp only [Fin.val_succ, Nat.succ_ne_zero, ↓reduceIte, le_refl]
  | inr i =>
    refine Fin.cases ?_ ?_ i
    · simp only [Fin.val_zero, ↓reduceIte]
      omega
    · intro ji
      simp only [Fin.val_succ, Nat.succ_ne_zero, ↓reduceIte, le_refl]

/-- Cast of W_lower_nat to ℚ matches W_lower. -/
theorem W_of_nat_W_lower_nat (w : ℕ) (u : Fin (w + 1) → ℕ) (hu0 : w ≤ u 0) (i c : Fin (w + 1)) :
    ((W_lower_nat w u i c : ℕ) : ℚ) = W_lower w (fun j => (u j : ℚ)) i c := by
  dsimp [W_lower_nat, W_lower]
  refine Fin.cases ?_ ?_ i
  · refine Fin.cases ?_ ?_ c
    · simp only [Fin.val_zero, ↓reduceIte]
      exact Nat.cast_sub hu0
    · intro jc
      simp only [Fin.val_zero, ↓reduceIte,
        Fin.val_succ, Nat.succ_ne_zero, Nat.cast_zero]
  · intro ji
    refine Fin.cases ?_ ?_ c
    · simp only [Fin.val_succ, Nat.succ_ne_zero, ↓reduceIte,
        Fin.val_zero, Nat.cast_one]
    · intro jc
      simp only [Fin.val_succ, Nat.succ_ne_zero, ↓reduceIte,
        Fin.succ_inj]
      split_ifs <;> rfl

/-- Exact correspondence between M_of_nat M_lower_nat and M_lower. -/
theorem M_of_nat_M_lower_nat (w : ℕ) (u : Fin (w + 1) → ℕ) (hu0 : w ≤ u 0) :
    M_of_nat (M_lower_nat w u) = M_lower w (fun c => 2 * (u c : ℚ)) := by
  ext r c
  dsimp [M_of_nat, M_lower_nat, M_lower, W_lower_u]
  have hu_half : (fun j => (2 * (u j : ℚ)) / 2) = (fun j => (u j : ℚ)) := by
    ext j; ring
  rw [hu_half]
  cases finSumFinEquiv.symm r with
  | inl i => exact W_of_nat_W_lower_nat w u hu0 i c
  | inr i => exact W_of_nat_W_lower_nat w u hu0 i c

/-- Inversion identity `R_M_lower * M_lower_nat = 1`. -/
theorem R_M_lower_mul_M_lower_nat (w : ℕ) (u : Fin (w + 1) → ℕ)
    (hu0 : w + 1 ≤ u 0) (hui : ∀ i : Fin w, 1 ≤ u i.succ) :
    R_M_lower w (fun c => 2 * (u c : ℚ)) * M_of_nat (M_lower_nat w u) = 1 := by
  have hu0_le : w ≤ u 0 := by omega
  rw [M_of_nat_M_lower_nat w u hu0_le]
  have hu0_ne : (2 * (u 0 : ℚ)) / 2 - w ≠ 0 := by
    have : (2 * (u 0 : ℚ)) / 2 = (u 0 : ℚ) := by ring
    rw [this]
    intro h
    have : (u 0 : ℚ) = w := by linarith
    have : (u 0 : ℚ) ≥ (w + 1 : ℚ) := by exact_mod_cast hu0
    linarith
  have hui_ne : ∀ i : Fin w, (2 * (u i.succ : ℚ)) ≠ 0 := by
    intro i h
    have : (u i.succ : ℚ) ≥ 1 := by exact_mod_cast (hui i)
    linarith
  exact R_M_lower_mul_M_lower w (fun c => 2 * (u c : ℚ)) hu0_ne hui_ne

/-- Moment realization `Mᵀ * J_lower * M = E` for natural-number matrix. -/
theorem M_lower_nat_transpose_mul_J_lower_mul_M_lower_nat (w : ℕ) (u : Fin (w + 1) → ℕ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hu0 : w + 1 ≤ u 0) (hui : ∀ i : Fin w, 1 ≤ u i.succ) :
    (M_of_nat (M_lower_nat w u)).transpose * J_lower w (fun c => 2 * (u c : ℚ)) E * M_of_nat (M_lower_nat w u) = E := by
  have hu0_le : w ≤ u 0 := by omega
  rw [M_of_nat_M_lower_nat w u hu0_le]
  have hu0_ne : (2 * (u 0 : ℚ)) / 2 - w ≠ 0 := by
    have : (2 * (u 0 : ℚ)) / 2 = (u 0 : ℚ) := by ring
    rw [this]
    intro h
    have : (u 0 : ℚ) = w := by linarith
    have : (u 0 : ℚ) ≥ (w + 1 : ℚ) := by exact_mod_cast hu0
    linarith
  have hui_ne : ∀ i : Fin w, (2 * (u i.succ : ℚ)) ≠ 0 := by
    intro i h
    have : (u i.succ : ℚ) ≥ 1 := by exact_mod_cast (hui i)
    linarith
  exact M_lower_transpose_mul_J_lower_mul_M_lower w (fun c => 2 * (u c : ℚ)) E hu0_ne hui_ne

/-- Moment realization `Mᵀ * J_lower_eta * M = E` for natural-number matrix. -/
theorem M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat (w : ℕ) (u : Fin (w + 1) → ℕ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (hu0 : w + 1 ≤ u 0) (hui : ∀ i : Fin w, 1 ≤ u i.succ) :
    (M_of_nat (M_lower_nat w u)).transpose * J_lower_eta w (fun c => 2 * (u c : ℚ)) E eta * M_of_nat (M_lower_nat w u) = E := by
  have hu0_le : w ≤ u 0 := by omega
  rw [M_of_nat_M_lower_nat w u hu0_le]
  have hu0_ne : (2 * (u 0 : ℚ)) / 2 - w ≠ 0 := by
    have : (2 * (u 0 : ℚ)) / 2 = (u 0 : ℚ) := by ring
    rw [this]
    intro h
    have : (u 0 : ℚ) = w := by linarith
    have : (u 0 : ℚ) ≥ (w + 1 : ℚ) := by exact_mod_cast hu0
    linarith
  have hui_ne : ∀ i : Fin w, (2 * (u i.succ : ℚ)) ≠ 0 := by
    intro i h
    have : (u i.succ : ℚ) ≥ 1 := by exact_mod_cast (hui i)
    linarith
  exact M_lower_transpose_mul_J_lower_eta_mul_M_lower w (fun c => 2 * (u c : ℚ)) E eta hu0_ne hui_ne

/-- Column sum of `M_of_nat (M_lower_nat w u)` gives `2 * u`. -/
theorem ell_row_M_lower_nat (w : ℕ) (u : Fin (w + 1) → ℕ) (hu0 : w ≤ u 0) :
    ell_row (M_of_nat (M_lower_nat w u)) = Matrix.of fun (_ : Unit) c => 2 * (u c : ℚ) := by
  rw [M_of_nat_M_lower_nat w u hu0]
  exact ell_row_M_lower w (fun c => 2 * (u c : ℚ))

/-- Master moment equation satisfied by `M_lower_nat`. -/
theorem E_uniform_total_moment_equation_M_lower_nat {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ) (u : Fin (w + 1) → ℕ)
    (hu0 : w ≤ u 0)
    (hell : ell_uniform_total hw clock b c_step H0 delta alpha = fun c => 2 * (u c : ℚ))
    (hR : clock.R b ⟨w - 1, by omega⟩ ≠ 0) :
    let E := E_uniform_total hw clock b c_step H0 delta alpha
    let zeta := zeta_canonical (Nat.le_of_succ_le hw) clock b c_step H0
    E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row (M_of_nat (M_lower_nat w u))).transpose * psi_row zeta (B_mat (w + 1)) := by
  intro E zeta
  have hfull := E_uniform_full_moment_equation hw clock b c_step H0 delta alpha hR
  rw [M_of_nat_M_lower_nat w u hu0]
  rw [ell_row_M_lower w (fun c => 2 * (u c : ℚ))]
  have h_ell_eq : (Matrix.of fun (_ : Unit) c => (2 * (u c : ℚ))) =
      (Matrix.of fun (_ : Unit) c => ell_uniform_total hw clock b c_step H0 delta alpha c) := by
    ext _ c
    simp only [Matrix.of_apply]
    rw [← congr_fun hell c]
  rw [h_ell_eq]
  exact hfull

/-- A grounded realized clock of width `w ≥ 2`:
    packages a `RealizedClock w` together with:
    1. A distinguished phase-boundary leader `b : Fin rc.fc.clock.m`,
    2. Subdiagonal coefficient calibration `rc.fc.clock.R b ⟨w - 1, _⟩ = 1`,
    3. Grounded four-stage lift data `(c_step, H0, delta, alpha, u, P0)` satisfying:
       - `hu0 : w + 1 ≤ u 0`, `hui : ∀ i, 1 ≤ u i.succ`,
       - `hell : ell_uniform_total = 2 * u`,
       - Valid priority words for early, late, bundle, and gateway stages.
    NOTE: ZERO sparse gateway support `hF_supp` hypothesis is required! -/
structure GroundedRealizedClock (w : ℕ) where
  hw : 2 ≤ w
  rc : RealizedClock w
  b : Fin rc.fc.clock.m
  hb_subdiag : rc.fc.clock.R b ⟨w - 1, by omega⟩ = 1
  c_step : ℚ
  H0 : ℚ
  delta : ℚ
  hdelta : 0 < delta
  alpha : ℚ
  eta : ℚ
  heta : 0 < eta
  u : Fin (w + 1) → ℕ
  hu0 : w + 1 ≤ u 0
  hui : ∀ i : Fin w, 1 ≤ u i.succ
  hell : ell_uniform_total hw rc.fc.clock b c_step H0 delta alpha = fun c => 2 * (u c : ℚ)
  P0 : Matrix (Fin (rc.fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ
  phaseShift : ℕ
  hshift : w ≤ phaseShift
  parentWord : ℕ → List (Fin rc.fc.clock.m)
  hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = rc.fc.clock.C.mulVec (binomBasis w σ)
  parent_rank : Fin rc.fc.clock.m → Fin rc.fc.clock.m
  h_dot_ge_low : ∀ p : ℕ, 1 + (Nat.choose (p + phaseShift) w : ℚ) ≤
    dotProduct (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) (binomBasis (w + 1) (p + phaseShift))
  h_dot_ge_high : ∀ p : ℕ, 0 ≤
    dotProduct (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) (binomBasis (w + 1) (p + 1 + phaseShift))
  h_len_lower : ∀ q : ℕ, (Nat.choose q w : ℚ) ≤
    ((rawFourStageWord_M rc.fc.clock parentWord (M_lower_nat w u) q).length : ℚ)
  h_early : ∀ p : ℕ,
    let G_O := AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v
    let P := P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u)
      (R_M_lower w (fun c => 2 * (u c : ℚ)))
      (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta)
      (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) P0 rc.fc.L_C
    let S := S_uniform (Nat.le_of_succ_le hw) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) c_step) delta
    let X := X_gateway rc.fc.clock
    let M := M_of_nat (M_lower_nat w u)
    let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta
    let s0 := (liftedScoreMat G_O J S X M (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0)).mulVec (binomBasis (w + 1) (p + phaseShift))
    IsValidPriorityWord (liftedGameMat G_O P J) s0
      (paperPriorityRank rc.fc.clock.m w parent_rank) (W_early_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift))
  h_late : ∀ p : ℕ,
    let G_O := AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v
    let P := P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u)
      (R_M_lower w (fun c => 2 * (u c : ℚ)))
      (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta)
      (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) P0 rc.fc.L_C
    let S := S_uniform (Nat.le_of_succ_le hw) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) c_step) delta
    let X := X_gateway rc.fc.clock
    let M := M_of_nat (M_lower_nat w u)
    let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta
    let s0 := (liftedScoreMat G_O J S X M (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0)).mulVec (binomBasis (w + 1) (p + phaseShift))
    IsValidPriorityWord (liftedGameMat G_O P J)
      (wordScore (liftedGameMat G_O P J) s0 (W_early_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift)))
      (paperPriorityRank rc.fc.clock.m w parent_rank) (W_late_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift))
  h_bundle : ∀ p : ℕ,
    let G_O := AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v
    let P := P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u)
      (R_M_lower w (fun c => 2 * (u c : ℚ)))
      (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta)
      (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) P0 rc.fc.L_C
    let S := S_uniform (Nat.le_of_succ_le hw) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) c_step) delta
    let X := X_gateway rc.fc.clock
    let M := M_of_nat (M_lower_nat w u)
    let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta
    let s0 := (liftedScoreMat G_O J S X M (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0)).mulVec (binomBasis (w + 1) (p + phaseShift))
    IsValidPriorityWord (liftedGameMat G_O P J)
      (wordScore (liftedGameMat G_O P J) s0 (W_early_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++ W_late_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift)))
      (paperPriorityRank rc.fc.clock.m w parent_rank)
      ((W_bundle_word parentWord (p + phaseShift + 1)).map (bundleToLiftedAct rc.fc.clock.m w))
  h_gw : ∀ p : ℕ,
    let G_O := AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v
    let P := P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u)
      (R_M_lower w (fun c => 2 * (u c : ℚ)))
      (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta)
      (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) P0 rc.fc.L_C
    let S := S_uniform (Nat.le_of_succ_le hw) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) c_step) delta
    let X := X_gateway rc.fc.clock
    let M := M_of_nat (M_lower_nat w u)
    let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta
    let s0 := (liftedScoreMat G_O J S X M (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0)).mulVec (binomBasis (w + 1) (p + phaseShift))
    ∀ y : Fin (rc.fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
      y ≠ gatewayToLiftedAct rc.fc.clock.m w →
      wordScore (liftedGameMat G_O P J) s0
        (W_early_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++ W_late_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++
          ((W_bundle_word parentWord (p + phaseShift + 1)).map (bundleToLiftedAct rc.fc.clock.m w))) y <
      wordScore (liftedGameMat G_O P J) s0
        (W_early_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++ W_late_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++
          ((W_bundle_word parentWord (p + phaseShift + 1)).map (bundleToLiftedAct rc.fc.clock.m w)))
        (gatewayToLiftedAct rc.fc.clock.m w)

/-- The canonical lift specification for a grounded realized clock using `E_uniform_total`. -/
def GroundedRealizedClock.spec {w : ℕ} (grc : GroundedRealizedClock w) :
    UniformLiftSpec_M grc.hw grc.rc.fc grc.b grc.c_step grc.H0 grc.delta
      (M_lower_nat w grc.u)
      (R_M_lower w (fun c => 2 * (grc.u c : ℚ)))
      (J_lower_eta w (fun c => 2 * (grc.u c : ℚ)) (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta)
      (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha)
      (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0)
      grc.P0
      (R_M_lower_mul_M_lower_nat w grc.u grc.hu0 grc.hui)
      (M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w grc.u (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta grc.hu0 grc.hui)
      (E_uniform_total_moment_equation_M_lower_nat grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha grc.u (by have := grc.hu0; omega) grc.hell (by rw [grc.hb_subdiag]; norm_num))
      (M_lower_nat_col_zero_ge_one w grc.u grc.hu0)
      (J_lower_eta_lower w (fun c => 2 * (grc.u c : ℚ)) (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta) :=
  UniformLiftSpec_M.ofGroundedStages grc.hw grc.rc.fc grc.b grc.c_step grc.H0 grc.delta
    (M_lower_nat w grc.u)
    (R_M_lower w (fun c => 2 * (grc.u c : ℚ)))
    (J_lower_eta w (fun c => 2 * (grc.u c : ℚ)) (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta)
    (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha)
    (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0)
    grc.P0
    (R_M_lower_mul_M_lower_nat w grc.u grc.hu0 grc.hui)
    (M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w grc.u _ grc.eta grc.hu0 grc.hui)
    (E_uniform_total_moment_equation_M_lower_nat grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha grc.u (by have := grc.hu0; omega) grc.hell (by rw [grc.hb_subdiag]; norm_num))
    (M_lower_nat_col_zero_ge_one w grc.u grc.hu0)
    (J_lower_eta_lower w (fun c => 2 * (grc.u c : ℚ)) _ grc.eta)
    grc.phaseShift grc.hshift grc.parentWord grc.hparent_count grc.parent_rank
    grc.h_dot_ge_low grc.h_dot_ge_high grc.h_len_lower
    grc.h_early grc.h_late grc.h_bundle grc.h_gw

/-- The inductive step: lifting `grc : GroundedRealizedClock w` produces a `RealizedClock (w + 1)`. -/
def GroundedRealizedClock.step_rc {w : ℕ} (grc : GroundedRealizedClock w) : RealizedClock (w + 1) :=
  RealizedClock.ofUniformLift_M grc.hw grc.rc grc.b grc.c_step grc.H0 grc.delta
    (M_lower_nat w grc.u)
    (R_M_lower w (fun c => 2 * (grc.u c : ℚ)))
    (J_lower_eta w (fun c => 2 * (grc.u c : ℚ)) (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta)
    (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha)
    (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0)
    grc.P0
    (R_M_lower_mul_M_lower_nat w grc.u grc.hu0 grc.hui)
    (M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w grc.u _ grc.eta grc.hu0 grc.hui)
    (E_uniform_total_moment_equation_M_lower_nat grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha grc.u (by have := grc.hu0; omega) grc.hell (by rw [grc.hb_subdiag]; norm_num))
    (M_lower_nat_col_zero_ge_one w grc.u grc.hu0)
    (J_lower_eta_lower w (fun c => 2 * (grc.u c : ℚ)) _ grc.eta)
    grc.spec

/-- The lifted clock's FullRankClock matches `uniformFullRankLift_M`. -/
theorem GroundedRealizedClock.step_fc_eq {w : ℕ} (grc : GroundedRealizedClock w) :
    grc.step_rc.fc = uniformFullRankLift_M grc.hw grc.rc.fc grc.b grc.c_step grc.H0 grc.delta
      (M_lower_nat w grc.u)
      (R_M_lower w (fun c => 2 * (grc.u c : ℚ)))
      (J_lower_eta w (fun c => 2 * (grc.u c : ℚ)) (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha) grc.eta)
      (E_uniform_total grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha)
      (zeta_canonical (Nat.le_of_succ_le grc.hw) grc.rc.fc.clock grc.b grc.c_step grc.H0)
      grc.P0
      (R_M_lower_mul_M_lower_nat w grc.u grc.hu0 grc.hui)
      (M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w grc.u _ grc.eta grc.hu0 grc.hui)
      (E_uniform_total_moment_equation_M_lower_nat grc.hw grc.rc.fc.clock grc.b grc.c_step grc.H0 grc.delta grc.alpha grc.u (by have := grc.hu0; omega) grc.hell (by rw [grc.hb_subdiag]; norm_num)) :=
  rfl



/-- Derivation of nonpositive early coupling from positive margin. -/
theorem P_early_nonpos_of_margin {α β : Type*} (a_old : α → ℚ) (ha_pos : ∀ x, 0 < a_old x)
    (P : α → β → ℚ) (hP : ∀ x j, P x j ≤ - (a_old x / 4)) (x : α) (j : β) :
    P x j ≤ 0 := by
  have : 0 < a_old x / 4 := by linarith [ha_pos x]
  have := hP x j
  linarith

/-- Derivation of nonnegative late coupling from positive margin. -/
theorem P_late_nonneg_of_margin {α β : Type*} (a_old : α → ℚ) (ha_pos : ∀ x, 0 < a_old x)
    (P : α → β → ℚ) (hP : ∀ x j, a_old x / 4 ≤ P x j) (x : α) (j : β) :
    0 ≤ P x j := by
  have : 0 < a_old x / 4 := by linarith [ha_pos x]
  have := hP x j
  linarith

/-- Concrete discharge for Stage 1 early reset priority validity. -/
theorem GroundedRealizedClock.discharge_early {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (u : Fin (w + 1) → ℕ)
    (hu0 : w + 1 ≤ u 0)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (parent_rank : Fin clock.m → Fin clock.m)
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0)
    (hJ_subdiag_pos : ∀ a b : Fin ((w + 1) + (w + 1)), b.val < a.val → 0 < J a b)
    (hP_early_nonpos : ∀ (j : Fin (w + 1)) (x : Fin (clock.m + 1)),
      (P_uniform_M hw clock b c_step H0 delta (M_lower_nat w u) R_M J zeta P0 L_C) x (finSumFinEquiv (Sum.inl j)) ≤ 0)
    (phaseShift : ℕ)
    (h_old_start : ∀ p : ℕ, ∀ x : Fin (clock.m + 1),
      let G_O := AdjoinLeaderEndpointG clock.G b clock.v
      let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
      let X := X_gateway clock
      let M := M_of_nat (M_lower_nat w u)
      (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) (p + phaseShift)) (Sum.inl x) <
        dotProduct zeta (binomBasis (w + 1) (p + phaseShift))) :
    ∀ p : ℕ,
      let G_O := AdjoinLeaderEndpointG clock.G b clock.v
      let P := P_uniform_M hw clock b c_step H0 delta (M_lower_nat w u) R_M J zeta P0 L_C
      let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
      let X := X_gateway clock
      let M := M_of_nat (M_lower_nat w u)
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) (p + phaseShift))
      IsValidPriorityWord (liftedGameMat G_O P J) s0
        (paperPriorityRank clock.m w parent_rank) (W_early_word_M clock.m w (M_lower_nat w u) (p + phaseShift)) := by
  intro p
  have hM0 := M_lower_nat_col_zero_ge_one w u hu0
  exact uniform_stage1_valid_M hw clock b c_step H0 delta (M_lower_nat w u) hM0 R_M J zeta P0 L_C parent_rank
    hJ_lower hJ_subdiag_pos hP_early_nonpos (p + phaseShift) (h_old_start p)

/-- Concrete discharge for Stage 2 late reset priority validity. -/
theorem GroundedRealizedClock.discharge_late {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (u : Fin (w + 1) → ℕ)
    (hu0 : w + 1 ≤ u 0)
    (R_M : Matrix (Fin (w + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (zeta : Fin (w + 1) → ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (hRM : R_M * (M_of_nat (M_lower_nat w u)) = 1)
    (hMJM : (M_of_nat (M_lower_nat w u)).transpose * J * (M_of_nat (M_lower_nat w u)) = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw clock b c_step H0 delta).transpose * X_gateway clock -
        (ell_row (M_of_nat (M_lower_nat w u))).transpose * psi_row zeta (B_mat (w + 1)))
    (parent_rank : Fin clock.m → Fin clock.m)
    (hJ_lower : ∀ a b : Fin ((w + 1) + (w + 1)), a.val ≤ b.val → J a b = 0)
    (hJ_subdiag_pos : ∀ a b : Fin ((w + 1) + (w + 1)), b.val < a.val → 0 < J a b)
    (hP_late_nonneg : ∀ (j : Fin (w + 1)) (x : Fin (clock.m + 1)),
      0 ≤ (P_uniform_M hw clock b c_step H0 delta (M_lower_nat w u) R_M J zeta P0 L_C) x (finSumFinEquiv (Sum.inr j)))
    (phaseShift : ℕ)
    (h_end_sharp : ∀ p : ℕ, ∀ x : Fin (clock.m + 1),
      let P := P_uniform_M hw clock b c_step H0 delta (M_lower_nat w u) R_M J zeta P0 L_C
      let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
      S.mulVec (binomBasis (w + 1) (p + phaseShift + 1)) x -
        P x (finSumFinEquiv (Sum.inr ⟨w, Nat.lt_succ_self w⟩)) <
        dotProduct zeta (binomBasis (w + 1) (p + phaseShift))) :
    ∀ p : ℕ,
      let G_O := AdjoinLeaderEndpointG clock.G b clock.v
      let P := P_uniform_M hw clock b c_step H0 delta (M_lower_nat w u) R_M J zeta P0 L_C
      let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
      let X := X_gateway clock
      let M := M_of_nat (M_lower_nat w u)
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) (p + phaseShift))
      IsValidPriorityWord (liftedGameMat G_O P J)
        (wordScore (liftedGameMat G_O P J) s0 (W_early_word_M clock.m w (M_lower_nat w u) (p + phaseShift)))
        (paperPriorityRank clock.m w parent_rank) (W_late_word_M clock.m w (M_lower_nat w u) (p + phaseShift)) := by
  intro p
  have hM0 := M_lower_nat_col_zero_ge_one w u hu0
  exact uniform_stage2_valid_M hw clock b c_step H0 delta (M_lower_nat w u) hM0 R_M J E zeta P0 L_C
    hRM hMJM hmoment parent_rank hJ_lower hJ_subdiag_pos hP_late_nonneg (p + phaseShift) (h_end_sharp p)

/-- Update of wordScore under a single played action. -/
theorem wordScore_singleton_apply {α : Type*} [Fintype α] [DecidableEq α]
    (M : Matrix α α ℚ) (s0 : α → ℚ) (a y : α) :
    wordScore M s0 [a] y = s0 y + M y a := by
  unfold wordScore scoreVec wordCountVec
  have hsum : (∑ x : α, M y x * (List.count x [a] : ℚ)) = M y a := by
    rw [Finset.sum_eq_single a]
    · simp
    · intro b _ hba
      simp [List.count_singleton, beq_false_of_ne (Ne.symm hba)]
    · intro ha
      exact False.elim (ha (Finset.mem_univ a))
  rw [hsum]

/-- Monotonicity of active action score in any valid priority word under a zero-diagonal game:
    at every step `k < W.length`, the active action's score is at least the initial score of any action `i`. -/
theorem initial_score_le_active_wordScore_of_isValidPriorityWord
    {α : Type*} [Fintype α] [DecidableEq α] {m : ℕ}
    (G : Matrix α α ℚ) (hG_diag : ∀ i : α, G i i = 0)
    (s : α → ℚ) (rank : α → Fin m) (W : List α)
    (hW : IsValidPriorityWord G s rank W) :
    ∀ (k : ℕ) (hk : k < W.length) (i : α),
      s i ≤ wordScore G s (W.take k) W[k] := by
  intro k
  induction k with
  | zero =>
    intro hk0 i
    have htake : W.take 0 = [] := rfl
    have h0 := (hW 0 hk0 i).1
    rw [htake, wordScore_nil] at h0
    rw [htake, wordScore_nil]
    exact h0
  | succ k ih =>
    intro hk_succ i
    have hk : k < W.length := by omega
    have h_ih := ih hk i
    have h_take : W.take (k + 1) = W.take k ++ [W[k]] := by
      have := List.take_concat_get' W k hk
      exact this.symm
    have h_score : wordScore G s (W.take (k + 1)) W[k] = wordScore G s (W.take k) W[k] := by
      rw [h_take, wordScore_append, wordScore_singleton_apply, hG_diag, add_zero]
    have h_step : wordScore G s (W.take (k + 1)) W[k] ≤ wordScore G s (W.take (k + 1)) W[k + 1] :=
      (hW (k + 1) hk_succ W[k]).1
    linarith

/-- Late reset waiting at step `k < W_O.length`:
    whenever `s_mid_inr_j ≤ zeta_q ≤ s_mid_inl b_old` and reset coupling is nondecreasing (`0 ≤ ∑ u, P_col u * count u`),
    the late reset score is bounded by the active parent action's score. -/
theorem stage3_late_reset_waits_step
    {m : ℕ} {G_O : Matrix (Fin (m + 1)) (Fin (m + 1)) ℚ}
    (hG_diag : ∀ i, G_O i i = 0)
    (s_mid_inl : Fin (m + 1) → ℚ) {m_rank : ℕ} (rank : Fin (m + 1) → Fin m_rank)
    (W_O : List (Fin (m + 1)))
    (hW : IsValidPriorityWord G_O s_mid_inl rank W_O)
    (b_old : Fin (m + 1))
    (zeta_q : ℚ)
    (hb_score : zeta_q ≤ s_mid_inl b_old)
    (s_mid_inr_j : ℚ)
    (h_mid_le : s_mid_inr_j ≤ zeta_q)
    (P_col : Fin (m + 1) → ℚ)
    (k : ℕ) (hk : k < W_O.length)
    (hP_nonneg : 0 ≤ ∑ u, P_col u * wordCountVec (W_O.take k) u) :
    s_mid_inr_j - ∑ u, P_col u * wordCountVec (W_O.take k) u ≤
      wordScore G_O s_mid_inl (W_O.take k) W_O[k] := by
  have h_active := initial_score_le_active_wordScore_of_isValidPriorityWord G_O hG_diag s_mid_inl rank W_O hW k hk b_old
  linarith

/-- Early reset waiting at step `k < W_O.length` of Stage 3 under the bundle suffix bound:
    the early reset score is bounded backward from its end value and strictly dominated
    by the active parent score through cancellation of the `eps * remaining_length` terms. -/
theorem stage3_early_reset_waits_step
    {m : ℕ} {G_O : Matrix (Fin (m + 1)) (Fin (m + 1)) ℚ}
    (s_mid_inl : Fin (m + 1) → ℚ)
    (W_O : List (Fin (m + 1)))
    (k : ℕ) (hk : k < W_O.length)
    (s_mid_inr_j : ℚ)
    (P_col : Fin (m + 1) → ℚ)
    (s_end_j : ℚ)
    (h_end_decomp : s_mid_inr_j - ∑ u, P_col u * wordCountVec W_O u = s_end_j)
    (eps : ℚ)
    (hP_col_le : ∀ u, wordCountVec (W_O.drop k) u ≠ 0 → P_col u ≤ -eps)
    (zeta_q1 P_g_j : ℚ)
    (h_end_le : s_end_j ≤ zeta_q1 + P_g_j)
    (c_step C_bundle : ℚ)
    (h_active_lb : zeta_q1 - c_step - C_bundle - eps * ((W_O.drop k).length : ℚ) ≤
      wordScore G_O s_mid_inl (W_O.take k) W_O[k])
    (h_Pg : P_g_j < - c_step - C_bundle) :
    s_mid_inr_j - ∑ u, P_col u * wordCountVec (W_O.take k) u <
      wordScore G_O s_mid_inl (W_O.take k) W_O[k] := by
  have h_split : W_O = W_O.take k ++ W_O.drop k := (List.take_append_drop k W_O).symm
  have h_count_split : ∀ u, wordCountVec W_O u =
      wordCountVec (W_O.take k) u + wordCountVec (W_O.drop k) u := by
    intro u
    nth_rw 1 [h_split]
    rw [wordCountVec_append]
  have h_sum_split : (∑ u, P_col u * wordCountVec W_O u) =
      (∑ u, P_col u * wordCountVec (W_O.take k) u) +
      (∑ u, P_col u * wordCountVec (W_O.drop k) u) := by
    simp_rw [h_count_split, mul_add, Finset.sum_add_distrib]
  have h_drop_le : (∑ u, P_col u * wordCountVec (W_O.drop k) u) ≤
      -eps * ((W_O.drop k).length : ℚ) := by
    rw [list_length_eq_sum_wordCountVec (W_O.drop k), Finset.mul_sum]
    refine Finset.sum_le_sum fun u _ => ?_
    by_cases hz : wordCountVec (W_O.drop k) u = 0
    · simp [hz]
    · have hP := hP_col_le u hz
      have hpos : 0 ≤ wordCountVec (W_O.drop k) u := by
        simp only [wordCountVec]
        exact Nat.cast_nonneg _
      nlinarith
  have h_score_eq : s_mid_inr_j - ∑ u, P_col u * wordCountVec (W_O.take k) u =
      s_end_j + ∑ u, P_col u * wordCountVec (W_O.drop k) u := by
    linarith
  linarith

/-- Unified Stage 3 reset waiting theorem:
    discharges the reset waiting inequality `s_mid - ∑ P * count ≤ active`
    for ALL reset actions (both early and late). -/
theorem stage3_reset_waits_all
    {m : ℕ} {G_O : Matrix (Fin (m + 1)) (Fin (m + 1)) ℚ}
    (hG_diag : ∀ i, G_O i i = 0)
    (s_mid_inl : Fin (m + 1) → ℚ) {m_rank : ℕ} (rank : Fin (m + 1) → Fin m_rank)
    (W_O : List (Fin (m + 1)))
    (hW : IsValidPriorityWord G_O s_mid_inl rank W_O)
    (b_old : Fin (m + 1))
    (zeta_q : ℚ)
    (hb_score : zeta_q ≤ s_mid_inl b_old)
    {w : ℕ}
    (P : Matrix (Fin (m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (s_mid_inr : Fin ((w + 1) + (w + 1)) → ℚ)
    (k : ℕ) (hk : k < W_O.length)
    (h_late_mid : ∀ j : Fin (w + 1), s_mid_inr (finSumFinEquiv (Sum.inr j)) ≤ zeta_q)
    (hP_late_nonneg : ∀ j : Fin (w + 1), 0 ≤ ∑ u, P u (finSumFinEquiv (Sum.inr j)) * wordCountVec (W_O.take k) u)
    (s_end : Fin ((w + 1) + (w + 1)) → ℚ)
    (h_end_decomp : ∀ j : Fin (w + 1),
      s_mid_inr (finSumFinEquiv (Sum.inl j)) - ∑ u, P u (finSumFinEquiv (Sum.inl j)) * wordCountVec W_O u =
        s_end (finSumFinEquiv (Sum.inl j)))
    (eps : ℚ)
    (hP_early_le : ∀ (j : Fin (w + 1)) (u : Fin (m + 1)),
      wordCountVec (W_O.drop k) u ≠ 0 → P u (finSumFinEquiv (Sum.inl j)) ≤ -eps)
    (zeta_q1 : ℚ) (P_g : Fin (w + 1) → ℚ)
    (h_end_le : ∀ j : Fin (w + 1), s_end (finSumFinEquiv (Sum.inl j)) ≤ zeta_q1 + P_g j)
    (c_step C_bundle : ℚ)
    (h_active_lb : zeta_q1 - c_step - C_bundle - eps * ((W_O.drop k).length : ℚ) ≤
      wordScore G_O s_mid_inl (W_O.take k) W_O[k])
    (h_Pg : ∀ j : Fin (w + 1), P_g j < - c_step - C_bundle)
    (r : Fin ((w + 1) + (w + 1))) :
    s_mid_inr r - ∑ u, P u r * wordCountVec (W_O.take k) u ≤
      wordScore G_O s_mid_inl (W_O.take k) W_O[k] := by
  obtain ⟨sr, rfl⟩ := finSumFinEquiv.surjective r
  cases sr with
  | inl j =>
    have h_lt := stage3_early_reset_waits_step s_mid_inl W_O k hk
      (s_mid_inr (finSumFinEquiv (Sum.inl j)))
      (fun u => P u (finSumFinEquiv (Sum.inl j)))
      (s_end (finSumFinEquiv (Sum.inl j)))
      (h_end_decomp j) eps (hP_early_le j) zeta_q1 (P_g j) (h_end_le j)
      c_step C_bundle h_active_lb (h_Pg j)
    exact le_of_lt h_lt
  | inr j =>
    have h_le := stage3_late_reset_waits_step hG_diag s_mid_inl rank W_O hW b_old zeta_q hb_score
      (s_mid_inr (finSumFinEquiv (Sum.inr j))) (h_late_mid j)
      (fun u => P u (finSumFinEquiv (Sum.inr j))) k hk (hP_late_nonneg j)
    exact h_le

/-- Inductive preservation of the suffix bound across all 4 stages of the lifted clock:
    For any prefix index `r < W.length`:
    - Stage 4 (gateway): remaining gain is `c_step - delta < c_step`.
    - Stage 3 (parent bundle): bounded by `eps * len_rem + c_step + A_w + B_w`.
    - Stages 1 & 2 (reset block): active score ≥ zeta(q), remaining gain is
      `zeta(q+1) - zeta(q) ≤ eps * bundle_len + c_step + B_w ≤ eps * len_rem + c_step + A_w + B_w`. -/
theorem lifted_suffix_bound_cases
    (zeta_q1 zeta_q c_step delta A_w B_w eps : ℚ)
    (h_delta : 0 < delta) (h_A : 0 ≤ A_w) (h_B : 0 ≤ B_w) (h_eps : 0 < eps)
    (len_rem : ℕ)
    (case_idx : Fin 3)
    (H_active : ℚ)
    (bundle_len rem_bundle_len : ℕ)
    (h_bundle_le_rem : bundle_len ≤ len_rem)
    (h_rem_bundle_le_rem : rem_bundle_len ≤ len_rem)
    (h_stage4_H : H_active = zeta_q1 - c_step + delta)
    (h_stage3_H : zeta_q1 - c_step - (A_w + B_w) - eps * (rem_bundle_len : ℚ) ≤ H_active)
    (h_stage12_H : zeta_q ≤ H_active)
    (h_zeta_diff : zeta_q1 - zeta_q ≤ eps * (bundle_len : ℚ) + c_step + B_w) :
    zeta_q1 - H_active ≤ eps * (len_rem : ℚ) + (c_step + A_w + B_w) := by
  fin_cases case_idx
  · -- Case 0: Stage 4
    rw [h_stage4_H]
    have : 0 ≤ eps * (len_rem : ℚ) := by positivity
    linarith
  · -- Case 1: Stage 3
    have h_drop : (rem_bundle_len : ℚ) ≤ (len_rem : ℚ) := by exact_mod_cast h_rem_bundle_le_rem
    have : eps * (rem_bundle_len : ℚ) ≤ eps * (len_rem : ℚ) := by nlinarith
    linarith
  · -- Case 2: Stages 1 & 2
    have h_drop : (bundle_len : ℚ) ≤ (len_rem : ℚ) := by exact_mod_cast h_bundle_le_rem
    have : eps * (bundle_len : ℚ) ≤ eps * (len_rem : ℚ) := by nlinarith
    linarith

/-- Variant of isValidPriorityWord_stage1_bundle_valid with weak reset waiting inequality ≤,
    using parent-over-reset priority tie-breaking. -/
theorem isValidPriorityWord_stage1_bundle_valid' {α β : Type*} [Fintype α] [Fintype β]
    [DecidableEq α] [DecidableEq β] {m_rank : ℕ}
    (G_O : Matrix α α ℚ) (P : Matrix α β ℚ) (J : Matrix β β ℚ)
    (rank : α ⊕ β → Fin m_rank)
    (s0 : α ⊕ β → ℚ) (W_O : List α)
    (h_parent : IsValidPriorityWord G_O (fun u => s0 (Sum.inl u)) (fun u => rank (Sum.inl u)) W_O)
    (h_rank_active_reset : ∀ (k : ℕ) (hk : k < W_O.length) (j : β), (rank (Sum.inl (W_O[k]))).val < (rank (Sum.inr j)).val)
    (h_reset_waits :
      ∀ (k : ℕ) (hk : k < W_O.length) (j : β),
        s0 (Sum.inr j) - ∑ u : α, P u j * wordCountVec (W_O.take k) u ≤
          wordScore G_O (fun u => s0 (Sum.inl u)) (W_O.take k) (W_O[k])) :
    IsValidPriorityWord (Matrix.fromBlocks G_O P (-P.transpose) (J - J.transpose))
      s0 rank (W_O.map Sum.inl) := by
  intro k hk x
  have hk_len : k < W_O.length := by simpa using hk
  have hget : (W_O.map (Sum.inl : α → α ⊕ β))[k] = Sum.inl (W_O[k]) := by simp
  have htake : (W_O.map (Sum.inl : α → α ⊕ β)).take k = (W_O.take k).map Sum.inl := by rw [List.map_take]
  rw [hget, htake, wordScore_map_inl_old G_O P J s0 (W_O.take k) (W_O[k])]
  cases x with
  | inl i =>
      rw [wordScore_map_inl_old G_O P J s0 (W_O.take k) i]
      have h_step := h_parent k hk_len i
      refine ⟨h_step.1, ?_⟩
      intro hne heq
      have hi_ne : i ≠ W_O[k] := fun h => hne (congr_arg Sum.inl h)
      exact h_step.2 hi_ne heq
  | inr j =>
      rw [wordScore_map_inl_new G_O P J s0 (W_O.take k) j]
      have h_le := h_reset_waits k hk_len j
      refine ⟨h_le, ?_⟩
      intro _ _
      exact h_rank_active_reset k hk_len j

theorem isValidPriorityWord_stage3_bundle_of_priority' {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m)) (parent_rank : Fin clock.m → Fin clock.m) (q : ℕ)
    (G_O : Matrix (Fin (clock.m + 1)) (Fin (clock.m + 1)) ℚ)
