    (hRM : R_M * (M_of_nat M_nat) = 1)
    (hMJM : (M_of_nat M_nat).transpose * J * (M_of_nat M_nat) = E)
    (hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw fc.clock b c_step H0 delta).transpose * X_gateway fc.clock -
        (ell_row (M_of_nat M_nat)).transpose * psi_row zeta (B_mat (w + 1))) :
    (uniformFullRankLift_M hw fc b c_step H0 delta M_nat R_M J E zeta P0 hRM hMJM hmoment).clock.m =
      (fc.clock.m + 1) + ((w + 1) + (w + 1)) :=
  rfl

