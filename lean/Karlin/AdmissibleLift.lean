        (((W_bundle_word parentWord (p + phaseShift + 1)).map (parentToOldAct clock.m)).take k)
        (gatewayOldAct clock.m) <
      wordScore G_O (fun u => s_mid (Sum.inl u))
        (((W_bundle_word parentWord (p + phaseShift + 1)).map (parentToOldAct clock.m)).take k)
        (parentToOldAct clock.m ((W_bundle_word parentWord (p + phaseShift + 1))[k]'hk)))
    (h_reset_waits : ∀ p : ℕ, ∀ (k : ℕ)
      (hk : k < ((W_bundle_word parentWord (p + phaseShift + 1)).map (parentToOldAct clock.m)).length)
      (j : Fin ((w + 1) + (w + 1))),
      let G_O := AdjoinLeaderEndpointG clock.G b clock.v
      let P := P_uniform_M hw clock b c_step H0 delta (M_lower_nat w u) R_M J zeta P0 L_C
      let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
      let X := X_gateway clock
      let M := M_of_nat (M_lower_nat w u)
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) (p + phaseShift))
      let s_mid := wordScore (liftedGameMat G_O P J) s0 (W_early_word_M clock.m w (M_lower_nat w u) (p + phaseShift) ++ W_late_word_M clock.m w (M_lower_nat w u) (p + phaseShift))
      s_mid (Sum.inr j) -
        ∑ u_act, P u_act j * wordCountVec (((W_bundle_word parentWord (p + phaseShift + 1)).map (parentToOldAct clock.m)).take k) u_act <
        wordScore G_O (fun u_act => s_mid (Sum.inl u_act))
          (((W_bundle_word parentWord (p + phaseShift + 1)).map (parentToOldAct clock.m)).take k)
          (((W_bundle_word parentWord (p + phaseShift + 1)).map (parentToOldAct clock.m))[k])) :
    ∀ p : ℕ,
      let G_O := AdjoinLeaderEndpointG clock.G b clock.v
      let P := P_uniform_M hw clock b c_step H0 delta (M_lower_nat w u) R_M J zeta P0 L_C
      let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
      let X := X_gateway clock
      let M := M_of_nat (M_lower_nat w u)
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) (p + phaseShift))
      IsValidPriorityWord (liftedGameMat G_O P J)
        (wordScore (liftedGameMat G_O P J) s0 (W_early_word_M clock.m w (M_lower_nat w u) (p + phaseShift) ++ W_late_word_M clock.m w (M_lower_nat w u) (p + phaseShift)))
        (paperPriorityRank clock.m w parent_rank)
        ((W_bundle_word parentWord (p + phaseShift + 1)).map (bundleToLiftedAct clock.m w)) := by
  intro p
  exact uniform_stage3_valid_M hw clock b c_step H0 delta (M_lower_nat w u) R_M J E zeta P0 L_C
    hRM hMJM hmoment parentWord parent_rank hparent_count hparent_valid (p + phaseShift)
    (h_gw_waits p) (h_reset_waits p)

/-- Concrete discharge for Stage 4 gateway dominance. -/
theorem GroundedRealizedClock.discharge_gw {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step delta : ℚ) (hdelta : 0 < delta)
    (zeta : Fin (w + 1) → ℚ) (phaseShift : ℕ)
    (s_end : ℕ → Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)) → ℚ)
    (h_parent : ∀ p : ℕ, ∀ i : Fin fc.clock.m,
      s_end p (Sum.inl (finSumFinEquiv (Sum.inl i))) =
        fc.clock.R.mulVec (binomBasis w (p + phaseShift + 1)) i +
          dotProduct (h_uniform fc.clock b zeta c_step) (binomBasis (w + 1) (p + phaseShift + 1)))
    (h_leader : ∀ p : ℕ, ∀ i : Fin fc.clock.m,
      fc.clock.R.mulVec (binomBasis w (p + phaseShift + 1)) i ≤ fc.clock.R.mulVec (binomBasis w (p + phaseShift + 1)) b)
    (h_gw : ∀ p : ℕ, s_end p (gatewayToLiftedAct fc.clock.m w) =
      fc.clock.R.mulVec (binomBasis w (p + phaseShift + 1)) b +
        dotProduct (h_uniform fc.clock b zeta c_step) (binomBasis (w + 1) (p + phaseShift + 1)) + delta)
    (h_reset : ∀ p : ℕ, ∀ r : Fin ((w + 1) + (w + 1)),
      s_end p (Sum.inr r) < dotProduct zeta (binomBasis (w + 1) (p + phaseShift + 1)) - c_step + delta) :
    ∀ p : ℕ, ∀ y : Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
      y ≠ gatewayToLiftedAct fc.clock.m w →
      s_end p y < s_end p (gatewayToLiftedAct fc.clock.m w) := by
  intro p y hy
  exact uniform_stage4_valid_M hw fc b c_step delta hdelta zeta (p + phaseShift) (s_end p)
    (h_parent p) (h_leader p) (h_gw p) (h_reset p) y hy

/-- Full Stage 4 gateway dominance for all competitors y ≠ gateway:
    at the end of Stage 3, the gateway action beats all parent actions (by leader dominance)
    and all reset actions (by reset dominance). -/
theorem stage4_gw_dom_all {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step delta : ℚ) (hdelta : 0 < delta)
    (zeta : Fin (w + 1) → ℚ) (q : ℕ)
    (s_end : Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)) → ℚ)
    (h_parent : ∀ i : Fin fc.clock.m,
      s_end (Sum.inl (finSumFinEquiv (Sum.inl i))) =
        fc.clock.R.mulVec (binomBasis w (q + 1)) i +
          dotProduct (h_uniform fc.clock b zeta c_step) (binomBasis (w + 1) (q + 1)))
    (h_leader : ∀ i : Fin fc.clock.m,
      fc.clock.R.mulVec (binomBasis w (q + 1)) i ≤ fc.clock.R.mulVec (binomBasis w (q + 1)) b)
    (h_gw : s_end (gatewayToLiftedAct fc.clock.m w) =
      fc.clock.R.mulVec (binomBasis w (q + 1)) b +
        dotProduct (h_uniform fc.clock b zeta c_step) (binomBasis (w + 1) (q + 1)) + delta)
    (h_reset : ∀ r : Fin ((w + 1) + (w + 1)),
      s_end (Sum.inr r) < dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + delta)
    (y : Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)))
    (hy : y ≠ gatewayToLiftedAct fc.clock.m w) :
    s_end y < s_end (gatewayToLiftedAct fc.clock.m w) :=
  uniform_stage4_valid_M hw fc b c_step delta hdelta zeta q s_end
    h_parent h_leader h_gw h_reset y hy

/-- Exact Stage 3 End Reset Score Identity for general M_nat:
    At the end of Stage 3, immediately before gateway is played,
    the score of every reset action `Sum.inr r` evaluates to:
    `dotProduct zeta (binomBasis (w + 1) (q + 1)) - ((J * M_of_nat M_nat).mulVec (binomBasis (w + 1) (q + 1))) r + P (gatewayOldAct clock.m) r`. -/
theorem wordScore_after_stage3_M_inr {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (G_O : Matrix (Fin (clock.m + 1)) (Fin (clock.m + 1)) ℚ)
    (P : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (S : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (zeta : Fin (w + 1) → ℚ)
    (hPtX : P.transpose * X_gateway clock = Q_reset J (M_of_nat M_nat) (B_mat (w + 1)) zeta)
    (q : ℕ) (r : Fin ((w + 1) + (w + 1))) :
    wordScore (liftedGameMat G_O P J)
      ((liftedScoreMat G_O J S (X_gateway clock) (M_of_nat M_nat) zeta).mulVec (binomBasis (w + 1) q))
      (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q ++
        (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w))
      (Sum.inr r) =
    dotProduct zeta (binomBasis (w + 1) (q + 1)) -
      ((J * (M_of_nat M_nat)).mulVec (binomBasis (w + 1) (q + 1))) r +
      P (gatewayOldAct clock.m) r := by
  rw [wordScore_append]
  have hW_inr := wordCountVec_bundle_word_lifted_inr clock parentWord (q + 1)
  rw [wordScore_liftedGameMat_old_word_inr G_O P J _ _ hW_inr r]
  rw [wordScore_after_reset_stages_M_inr clock G_O P J S M_nat zeta q r]
  have hV := congr_fun (one_zeta_sub_J_transpose_mul_M_mulVec_binomBasis w J (M_of_nat M_nat) zeta q) r
  rw [hV]
  rw [sum_P_mul_wordCountVec_bundle_word_lifted clock parentWord hparent_count P (q + 1) r]
  rw [hPtX]
  have hVQ : ((V_reset J (M_of_nat M_nat) (B_mat (w + 1)) zeta).mulVec (binomBasis (w + 1) (q + 1))) r -
      ((Q_reset J (M_of_nat M_nat) (B_mat (w + 1)) zeta).mulVec (binomBasis (w + 1) (q + 1))) r =
      ((one_zeta (Fin ((w + 1) + (w + 1))) zeta - J * (M_of_nat M_nat)).mulVec (binomBasis (w + 1) (q + 1))) r := by
    rw [← Pi.sub_apply, ← Matrix.sub_mulVec, rotated_reset_score_identity]
  have hone_zeta : ((one_zeta (Fin ((w + 1) + (w + 1))) zeta - J * (M_of_nat M_nat)).mulVec (binomBasis (w + 1) (q + 1))) r =
      dotProduct zeta (binomBasis (w + 1) (q + 1)) - ((J * (M_of_nat M_nat)).mulVec (binomBasis (w + 1) (q + 1))) r := by
    rw [Matrix.sub_mulVec, Pi.sub_apply]
    congr 1
  linarith

/-- Early reset bound at Stage 3 completion from nonnegativity of `(J M p)_r` and coupling margin `P_{g, r} < - c_step + delta`. -/
theorem stage4_reset_end_early {w : ℕ} (zeta : Fin (w + 1) → ℚ) (c_step delta : ℚ) (q : ℕ)
    (s_end_r JM_r P_g_r : ℚ)
    (hs_eq : s_end_r = dotProduct zeta (binomBasis (w + 1) (q + 1)) - JM_r + P_g_r)
    (hJM_nonneg : 0 ≤ JM_r)
    (hP_margin : P_g_r < - c_step + delta) :
    s_end_r < dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + delta := by
  linarith

/-- Late reset bound at Stage 3 completion from Stage 2 end ceiling bound `zeta(q)`,
    monotonicity during parent plays, and canonical ceiling growth `zeta(q) ≤ zeta(q+1) - c_step`. -/
theorem stage4_reset_end_late {w : ℕ} (zeta : Fin (w + 1) → ℚ) (c_step delta : ℚ) (hdelta : 0 < delta) (q : ℕ)
    (s_end_r s_mid_r : ℚ)
    (hs_mono : s_end_r ≤ s_mid_r)
    (hmid_le_zeta : s_mid_r ≤ dotProduct zeta (binomBasis (w + 1) q))
    (hzeta_growth : dotProduct zeta (binomBasis (w + 1) q) ≤ dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step) :
    s_end_r < dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + delta := by
  linarith

/-- Unified Stage 4 Reset End Theorem (`stage4_reset_end_all`):
    Combines early reset and late reset conditions to prove that every reset action
    `r : Fin ((w + 1) + (w + 1))` satisfies the Stage 4 gateway dominance reset condition:
    `s_end (Sum.inr r) < dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + delta`. -/
theorem stage4_reset_end_all {w : ℕ}
    (zeta : Fin (w + 1) → ℚ) (c_step delta : ℚ) (q : ℕ)
    (s_end : Fin ((w + 1) + (w + 1)) → ℚ)
    (h_early : ∀ j : Fin (w + 1),
      s_end (finSumFinEquiv (Sum.inl j)) < dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + delta)
    (h_late : ∀ j : Fin (w + 1),
      s_end (finSumFinEquiv (Sum.inr j)) < dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + delta)
    (r : Fin ((w + 1) + (w + 1))) :
    s_end r < dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + delta := by
  obtain ⟨sr, rfl⟩ := finSumFinEquiv.surjective r
  cases sr with
  | inl j => exact h_early j
  | inr j => exact h_late j

/-- Stage 4 gateway dominance for all competitors `y ≠ gateway`,
    with the reset condition factored into early and late reset components via `stage4_reset_end_all`. -/
theorem stage4_gw_dom_of_reset_blocks {w : ℕ} (hw : 2 ≤ w) (fc : FullRankClock w)
    (b : Fin fc.clock.m) (c_step delta : ℚ) (hdelta : 0 < delta)
    (zeta : Fin (w + 1) → ℚ) (q : ℕ)
    (s_end : Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)) → ℚ)
    (h_parent : ∀ i : Fin fc.clock.m,
      s_end (Sum.inl (finSumFinEquiv (Sum.inl i))) =
        fc.clock.R.mulVec (binomBasis w (q + 1)) i +
          dotProduct (h_uniform fc.clock b zeta c_step) (binomBasis (w + 1) (q + 1)))
    (h_leader : ∀ i : Fin fc.clock.m,
      fc.clock.R.mulVec (binomBasis w (q + 1)) i ≤ fc.clock.R.mulVec (binomBasis w (q + 1)) b)
    (h_gw : s_end (gatewayToLiftedAct fc.clock.m w) =
      fc.clock.R.mulVec (binomBasis w (q + 1)) b +
        dotProduct (h_uniform fc.clock b zeta c_step) (binomBasis (w + 1) (q + 1)) + delta)
    (h_early : ∀ j : Fin (w + 1),
      s_end (Sum.inr (finSumFinEquiv (Sum.inl j))) < dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + delta)
    (h_late : ∀ j : Fin (w + 1),
      s_end (Sum.inr (finSumFinEquiv (Sum.inr j))) < dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + delta)
    (y : Fin (fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)))
    (hy : y ≠ gatewayToLiftedAct fc.clock.m w) :
    s_end y < s_end (gatewayToLiftedAct fc.clock.m w) := by
  have h_reset : ∀ r : Fin ((w + 1) + (w + 1)),
      s_end (Sum.inr r) < dotProduct zeta (binomBasis (w + 1) (q + 1)) - c_step + delta :=
    fun r => stage4_reset_end_all zeta c_step delta q (fun r => s_end (Sum.inr r)) h_early h_late r
  exact uniform_stage4_valid_M hw fc b c_step delta hdelta zeta q s_end
    h_parent h_leader h_gw h_reset y hy

/-- Modular constructor for `GroundedRealizedClock w` using stage discharge theorems. -/
def GroundedRealizedClock.ofStages {w : ℕ} (hw : 2 ≤ w) (rc : RealizedClock w)
    (b : Fin rc.fc.clock.m) (hb_subdiag : rc.fc.clock.R b ⟨w - 1, by omega⟩ = 1)
    (c_step H0 delta : ℚ) (hdelta : 0 < delta)
    (alpha : ℚ) (eta : ℚ) (heta : 0 < eta) (u : Fin (w + 1) → ℕ)
    (hu0 : w + 1 ≤ u 0) (hui : ∀ i : Fin w, 1 ≤ u i.succ)
    (hell : ell_uniform_total hw rc.fc.clock b c_step H0 delta alpha = fun c => 2 * (u c : ℚ))
    (P0 : Matrix (Fin (rc.fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (phaseShift : ℕ) (hshift : w ≤ phaseShift)
    (parentWord : ℕ → List (Fin rc.fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = rc.fc.clock.C.mulVec (binomBasis w σ))
    (parent_rank : Fin rc.fc.clock.m → Fin rc.fc.clock.m)
    (h_dot_ge_low : ∀ p : ℕ, 1 + (Nat.choose (p + phaseShift) w : ℚ) ≤
      dotProduct (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) (binomBasis (w + 1) (p + phaseShift)))
    (h_dot_ge_high : ∀ p : ℕ, 0 ≤
      dotProduct (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) (binomBasis (w + 1) (p + 1 + phaseShift)))
    (h_len_lower : ∀ q : ℕ, (Nat.choose q w : ℚ) ≤
      ((rawFourStageWord_M rc.fc.clock parentWord (M_lower_nat w u) q).length : ℚ))
    (h_early : ∀ p : ℕ,
      let G_O := AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v
      let P := P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u)
        (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) P0 rc.fc.L_C
      let S := S_uniform (Nat.le_of_succ_le hw) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) c_step) delta
      let X := X_gateway rc.fc.clock
      let M := M_of_nat (M_lower_nat w u)
      let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta
      let s0 := (liftedScoreMat G_O J S X M (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0)).mulVec (binomBasis (w + 1) (p + phaseShift))
      IsValidPriorityWord (liftedGameMat G_O P J) s0
        (paperPriorityRank rc.fc.clock.m w parent_rank) (W_early_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift)))
    (h_late : ∀ p : ℕ,
      let G_O := AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v
      let P := P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u)
        (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) P0 rc.fc.L_C
      let S := S_uniform (Nat.le_of_succ_le hw) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) c_step) delta
      let X := X_gateway rc.fc.clock
      let M := M_of_nat (M_lower_nat w u)
      let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta
      let s0 := (liftedScoreMat G_O J S X M (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0)).mulVec (binomBasis (w + 1) (p + phaseShift))
      IsValidPriorityWord (liftedGameMat G_O P J)
        (wordScore (liftedGameMat G_O P J) s0 (W_early_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift)))
        (paperPriorityRank rc.fc.clock.m w parent_rank) (W_late_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift)))
    (h_bundle : ∀ p : ℕ,
      let G_O := AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v
      let P := P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u)
        (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) P0 rc.fc.L_C
      let S := S_uniform (Nat.le_of_succ_le hw) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) c_step) delta
      let X := X_gateway rc.fc.clock
      let M := M_of_nat (M_lower_nat w u)
      let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta
      let s0 := (liftedScoreMat G_O J S X M (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0)).mulVec (binomBasis (w + 1) (p + phaseShift))
      IsValidPriorityWord (liftedGameMat G_O P J)
        (wordScore (liftedGameMat G_O P J) s0 (W_early_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++ W_late_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift)))
        (paperPriorityRank rc.fc.clock.m w parent_rank)
        ((W_bundle_word parentWord (p + phaseShift + 1)).map (bundleToLiftedAct rc.fc.clock.m w)))
    (h_gw : ∀ p : ℕ,
      let G_O := AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v
      let P := P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u)
        (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) P0 rc.fc.L_C
      let S := S_uniform (Nat.le_of_succ_le hw) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) c_step) delta
      let X := X_gateway rc.fc.clock
      let M := M_of_nat (M_lower_nat w u)
      let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta
      let s0 := (liftedScoreMat G_O J S X M (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0)).mulVec (binomBasis (w + 1) (p + phaseShift))
      ∀ y : Fin (rc.fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
        y ≠ gatewayToLiftedAct rc.fc.clock.m w →
        wordScore (liftedGameMat G_O P J) s0
          (W_early_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++ W_late_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++
            ((W_bundle_word parentWord (p + phaseShift + 1)).map (bundleToLiftedAct rc.fc.clock.m w))) y <
        wordScore (liftedGameMat G_O P J) s0
          (W_early_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++ W_late_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++
            ((W_bundle_word parentWord (p + phaseShift + 1)).map (bundleToLiftedAct rc.fc.clock.m w)))
          (gatewayToLiftedAct rc.fc.clock.m w)) :
    GroundedRealizedClock w :=
  ⟨hw, rc, b, hb_subdiag, c_step, H0, delta, hdelta, alpha, eta, heta, u, hu0, hui, hell,
   P0, phaseShift, hshift, parentWord, hparent_count, parent_rank,
   h_dot_ge_low, h_dot_ge_high, h_len_lower, h_early, h_late, h_bundle, h_gw⟩



/-- Helper 1: Stage 2 sharpened end condition from leader-0 dominance and positive reset coupling margin. -/
theorem stage2_end_sharp_all {w : ℕ} (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ) (hdelta : delta ≤ 1) (q : ℕ) (hq_ge : 1 ≤ q)
    (P_reset : Fin (clock.m + 1) → ℚ)
    (h_lead0 : ∀ i : Fin clock.m, clock.R i ⟨0, by omega⟩ ≤ clock.R b ⟨0, by omega⟩)
    (hP_pos_parent : ∀ i : Fin clock.m, 0 < P_reset (finSumFinEquiv (Sum.inl i)))
    (hP_nonneg_gw : 0 ≤ P_reset (finSumFinEquiv (Sum.inr 0)))
    (x : Fin (clock.m + 1)) :
    let S := S_uniform (by omega) clock b (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) delta
    S.mulVec (binomBasis (w + 1) (q + 1)) x - P_reset x <
      dotProduct (zeta_canonical (by omega) clock b c_step H0) (binomBasis (w + 1) q) := by
  intro S
  obtain ⟨sx, rfl⟩ := finSumFinEquiv.surjective x
  cases sx with
  | inl i =>
    have h_const : clock.R i ⟨0, by omega⟩ - clock.R b ⟨0, by omega⟩ < P_reset (finSumFinEquiv (Sum.inl i)) := by
      have := h_lead0 i
      have := hP_pos_parent i
      linarith
    exact stage2_parent_end_sharp_canonical (by omega) clock b c_step H0 delta i q
      (P_reset (finSumFinEquiv (Sum.inl i))) h_const
  | inr j =>
    have hj0 : j = 0 := Subsingleton.elim j 0
    subst hj0
    have hgw : S.mulVec (binomBasis (w + 1) (q + 1)) (finSumFinEquiv (Sum.inr 0)) =
      dotProduct (zeta_canonical (by omega) clock b c_step H0) (binomBasis (w + 1) q) + delta - ((q + 1 : ℕ) : ℚ) := by
      rw [S_uniform_gateway_eval (by omega) clock b _ delta q]
      rw [h_uniform_zeta_canonical_eval (by omega) clock b c_step H0 q]
      ring
    have hP := hP_nonneg_gw
    have hq : 2 ≤ ((q + 1 : ℕ) : ℚ) := by
      have : 2 ≤ q + 1 := by omega
      exact_mod_cast this
    change S.mulVec (binomBasis (w + 1) (q + 1)) (finSumFinEquiv (Sum.inr 0)) - P_reset (finSumFinEquiv (Sum.inr 0)) <
      dotProduct (zeta_canonical (by omega) clock b c_step H0) (binomBasis (w + 1) q)
    rw [hgw]
    linarith

set_option maxHeartbeats 800000

/-- Full constructor for  from parent clock invariants and inner waiting conditions,
    automatically discharging the 4 stage priority obligations. -/
def GroundedRealizedClock.ofParentClock {w : ℕ} (hw : 2 ≤ w) (rc : RealizedClock w)
    (b : Fin rc.fc.clock.m) (hb_subdiag : rc.fc.clock.R b ⟨w - 1, by omega⟩ = 1)
    (c_step H0 delta : ℚ) (hdelta : 0 < delta) (hdelta_le : delta ≤ 1)
    (alpha : ℚ) (eta : ℚ) (heta : 0 < eta) (u : Fin (w + 1) → ℕ)
    (hu0 : w + 1 ≤ u 0) (hui : ∀ i : Fin w, 1 ≤ u i.succ)
    (hell : ell_uniform_total hw rc.fc.clock b c_step H0 delta alpha = fun c => 2 * (u c : ℚ))
    (P0 : Matrix (Fin (rc.fc.clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (phaseShift : ℕ) (hshift : w ≤ phaseShift)
    (parentWord : ℕ → List (Fin rc.fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = rc.fc.clock.C.mulVec (binomBasis w σ))
    (parent_rank : Fin rc.fc.clock.m → Fin rc.fc.clock.m)
    (hparent_valid : ∀ σ : ℕ,
      IsValidPriorityWord rc.fc.clock.G (rc.fc.clock.R.mulVec (binomBasis w σ)) parent_rank (parentWord σ))
    (h_dot_ge_low : ∀ p : ℕ, 1 + (Nat.choose (p + phaseShift) w : ℚ) ≤
      dotProduct (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) (binomBasis (w + 1) (p + phaseShift)))
    (h_dot_ge_high : ∀ p : ℕ, 0 ≤
      dotProduct (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) (binomBasis (w + 1) (p + 1 + phaseShift)))
    (h_len_lower : ∀ q : ℕ, (Nat.choose q w : ℚ) ≤
      ((rawFourStageWord_M rc.fc.clock parentWord (M_lower_nat w u) q).length : ℚ))
    (hJ_subdiag_pos : ∀ r1 r2 : Fin ((w + 1) + (w + 1)), r2.val < r1.val →
      0 < J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta r1 r2)
    (hP_early_nonpos : ∀ (j : Fin (w + 1)) (x : Fin (rc.fc.clock.m + 1)),
      (P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u)
        (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) P0 rc.fc.L_C) x (finSumFinEquiv (Sum.inl j)) ≤ 0)
    (hP_late_nonneg : ∀ (j : Fin (w + 1)) (x : Fin (rc.fc.clock.m + 1)),
      0 ≤ (P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u)
        (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) P0 rc.fc.L_C) x (finSumFinEquiv (Sum.inr j)))
    (h_lead0 : ∀ i : Fin rc.fc.clock.m, rc.fc.clock.R i ⟨0, by omega⟩ ≤ rc.fc.clock.R b ⟨0, by omega⟩)
    (hP_pos_parent : ∀ i : Fin rc.fc.clock.m,
      0 < (P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u)
        (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) P0 rc.fc.L_C)
        (finSumFinEquiv (Sum.inl i)) (finSumFinEquiv (Sum.inr ⟨w, Nat.lt_succ_self w⟩)))
    (h_old_start : ∀ p : ℕ, ∀ x : Fin (rc.fc.clock.m + 1),
      let G_O := AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v
      let S := S_uniform (Nat.le_of_succ_le hw) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) c_step) delta
      let X := X_gateway rc.fc.clock
      let M := M_of_nat (M_lower_nat w u)
      let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta
      let zeta := zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0
      (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) (p + phaseShift)) (Sum.inl x) <
        dotProduct zeta (binomBasis (w + 1) (p + phaseShift)))
    (h_gw_waits : ∀ p : ℕ, ∀ (k : ℕ) (hk : k < (W_bundle_word parentWord (p + phaseShift + 1)).length),
      let G_O := AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v
      let S := S_uniform (Nat.le_of_succ_le hw) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) c_step) delta
      let X := X_gateway rc.fc.clock
      let M := M_of_nat (M_lower_nat w u)
      let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta
      let zeta := zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) (p + phaseShift))
      let s_mid := wordScore (liftedGameMat G_O (P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u) (R_M_lower w (fun c => 2 * (u c : ℚ))) J zeta P0 rc.fc.L_C) J) s0
        (W_early_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++ W_late_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift))
      wordScore G_O (fun u_act => s_mid (Sum.inl u_act))
        (((W_bundle_word parentWord (p + phaseShift + 1)).map (parentToOldAct rc.fc.clock.m)).take k)
        (gatewayOldAct rc.fc.clock.m) <
      wordScore G_O (fun u_act => s_mid (Sum.inl u_act))
        (((W_bundle_word parentWord (p + phaseShift + 1)).map (parentToOldAct rc.fc.clock.m)).take k)
        (parentToOldAct rc.fc.clock.m ((W_bundle_word parentWord (p + phaseShift + 1))[k]'hk)))
    (h_reset_waits : ∀ p : ℕ, ∀ (k : ℕ)
      (hk : k < ((W_bundle_word parentWord (p + phaseShift + 1)).map (parentToOldAct rc.fc.clock.m)).length)
      (j : Fin ((w + 1) + (w + 1))),
      let G_O := AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v
      let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta
      let zeta := zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0
      let P := P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u) (R_M_lower w (fun c => 2 * (u c : ℚ))) J zeta P0 rc.fc.L_C
      let S := S_uniform (Nat.le_of_succ_le hw) rc.fc.clock b (h_uniform rc.fc.clock b zeta c_step) delta
      let X := X_gateway rc.fc.clock
      let M := M_of_nat (M_lower_nat w u)
      let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) (p + phaseShift))
      let s_mid := wordScore (liftedGameMat G_O P J) s0 (W_early_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++ W_late_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift))
      s_mid (Sum.inr j) -
        ∑ u_act, P u_act j * wordCountVec (((W_bundle_word parentWord (p + phaseShift + 1)).map (parentToOldAct rc.fc.clock.m)).take k) u_act ≤
        wordScore G_O (fun u_act => s_mid (Sum.inl u_act))
          (((W_bundle_word parentWord (p + phaseShift + 1)).map (parentToOldAct rc.fc.clock.m)).take k)
          (((W_bundle_word parentWord (p + phaseShift + 1)).map (parentToOldAct rc.fc.clock.m))[k]))
    (h_gw : ∀ p : ℕ,
      let G_O := AdjoinLeaderEndpointG rc.fc.clock.G b rc.fc.clock.v
      let P := P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u)
        (R_M_lower w (fun c => 2 * (u c : ℚ)))
        (J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta)
        (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) P0 rc.fc.L_C
      let S := S_uniform (Nat.le_of_succ_le hw) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0) c_step) delta
      let X := X_gateway rc.fc.clock
      let M := M_of_nat (M_lower_nat w u)
      let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta
      let s0 := (liftedScoreMat G_O J S X M (zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0)).mulVec (binomBasis (w + 1) (p + phaseShift))
      ∀ y : Fin (rc.fc.clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)),
        y ≠ gatewayToLiftedAct rc.fc.clock.m w →
        wordScore (liftedGameMat G_O P J) s0
          (W_early_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++ W_late_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++
            ((W_bundle_word parentWord (p + phaseShift + 1)).map (bundleToLiftedAct rc.fc.clock.m w))) y <
        wordScore (liftedGameMat G_O P J) s0
          (W_early_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++ W_late_word_M rc.fc.clock.m w (M_lower_nat w u) (p + phaseShift) ++
            ((W_bundle_word parentWord (p + phaseShift + 1)).map (bundleToLiftedAct rc.fc.clock.m w)))
          (gatewayToLiftedAct rc.fc.clock.m w)) :
    GroundedRealizedClock w :=
  let J := J_lower_eta w (fun c => 2 * (u c : ℚ)) (E_uniform_total hw rc.fc.clock b c_step H0 delta alpha) eta
  let E := E_uniform_total hw rc.fc.clock b c_step H0 delta alpha
  let zeta := zeta_canonical (Nat.le_of_succ_le hw) rc.fc.clock b c_step H0
  let R_M := R_M_lower w (fun c => 2 * (u c : ℚ))
  have hRM : R_M * (M_of_nat (M_lower_nat w u)) = 1 := R_M_lower_mul_M_lower_nat w u hu0 hui
  have hMJM : (M_of_nat (M_lower_nat w u)).transpose * J * (M_of_nat (M_lower_nat w u)) = E :=
    M_lower_nat_transpose_mul_J_lower_eta_mul_M_lower_nat w u E eta hu0 hui
  have hmoment : E - E.transpose * B_mat (w + 1) =
      (D_uniform hw rc.fc.clock b c_step H0 delta).transpose * X_gateway rc.fc.clock -
        (ell_row (M_of_nat (M_lower_nat w u))).transpose * psi_row zeta (B_mat (w + 1)) :=
    E_uniform_total_moment_equation_M_lower_nat hw rc.fc.clock b c_step H0 delta alpha u (by have := hu0; omega) hell
      (by rw [hb_subdiag]; norm_num)
  have hJ_lower : ∀ a b_act : Fin ((w + 1) + (w + 1)), a.val ≤ b_act.val → J a b_act = 0 :=
    J_lower_eta_lower w (fun c => 2 * (u c : ℚ)) E eta
  have h_early := GroundedRealizedClock.discharge_early hw rc.fc.clock b c_step H0 delta u hu0 R_M J zeta P0 rc.fc.L_C
    parent_rank hJ_lower hJ_subdiag_pos hP_early_nonpos phaseShift h_old_start
  have h_end_sharp : ∀ p : ℕ, ∀ x : Fin (rc.fc.clock.m + 1),
      let P := P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u) R_M J zeta P0 rc.fc.L_C
      let S := S_uniform (by omega) rc.fc.clock b (h_uniform rc.fc.clock b (zeta_canonical (by omega) rc.fc.clock b c_step H0) c_step) delta
      S.mulVec (binomBasis (w + 1) (p + phaseShift + 1)) x -
        P x (finSumFinEquiv (Sum.inr ⟨w, Nat.lt_succ_self w⟩)) <
        dotProduct zeta (binomBasis (w + 1) (p + phaseShift)) := by
    intro p x
    have hq_ge : 1 ≤ p + phaseShift := by have := hshift; omega
    let P := P_uniform_M hw rc.fc.clock b c_step H0 delta (M_lower_nat w u) R_M J zeta P0 rc.fc.L_C
    have hP_nonneg_gw' : 0 ≤ P (finSumFinEquiv (Sum.inr 0)) (finSumFinEquiv (Sum.inr ⟨w, Nat.lt_succ_self w⟩)) :=
      hP_late_nonneg ⟨w, Nat.lt_succ_self w⟩ (finSumFinEquiv (Sum.inr 0))
    exact stage2_end_sharp_all hw rc.fc.clock b c_step H0 delta hdelta_le (p + phaseShift) hq_ge
      (fun y => P y (finSumFinEquiv (Sum.inr ⟨w, Nat.lt_succ_self w⟩)))
      h_lead0 hP_pos_parent hP_nonneg_gw' x
  have h_late := GroundedRealizedClock.discharge_late hw rc.fc.clock b c_step H0 delta u hu0 R_M J E zeta P0 rc.fc.L_C
    hRM hMJM hmoment parent_rank hJ_lower hJ_subdiag_pos hP_late_nonneg phaseShift h_end_sharp
  have h_bundle := GroundedRealizedClock.discharge_bundle' hw rc.fc.clock b c_step H0 delta u R_M J E zeta P0 rc.fc.L_C
    hRM hMJM hmoment parentWord parent_rank hparent_count hparent_valid phaseShift h_gw_waits h_reset_waits
  GroundedRealizedClock.ofStages hw rc b hb_subdiag c_step H0 delta hdelta alpha eta heta u hu0 hui hell
    P0 phaseShift hshift parentWord hparent_count parent_rank h_dot_ge_low h_dot_ge_high h_len_lower
    h_early h_late h_bundle h_gw

/-- Word score of W_123 on gateway action evaluates to the gateway ceiling value. -/
theorem s_end_gw_M {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (P : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (hPtX : P.transpose * X_gateway clock = Q_reset J (M_of_nat M_nat) (B_mat (w + 1)) (zeta_canonical hw clock b c_step H0))
    (hPM : P * M_of_nat M_nat = (S_uniform hw clock b (h_uniform clock b (zeta_canonical hw clock b c_step H0) c_step) delta) * N_mat (w + 1) - (AdjoinLeaderEndpointG clock.G b clock.v) * X_gateway clock)
    (q : ℕ) :
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let S := S_uniform hw clock b (h_uniform clock b (zeta_canonical hw clock b c_step H0) c_step) delta
    let X := X_gateway clock
    let M := M_of_nat M_nat
    let zeta := zeta_canonical hw clock b c_step H0
    let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)
    let W_123 := W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q ++
      (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)
    let g := gatewayToLiftedAct clock.m w
    wordScore (liftedGameMat G_O P J) s0 W_123 g =
      (clock.R.mulVec (binomBasis w (q + 1))) b +
        dotProduct (h_uniform clock b zeta c_step) (binomBasis (w + 1) (q + 1)) + delta := by
  intro G_O S X M zeta s0 W_123 g
  have h_raw : rawFourStageWord_M clock parentWord M_nat q = W_123 ++ [g] := rfl
  have h_full := wordScore_rawFourStageWord_M clock parentWord hparent_count G_O P J S M_nat zeta hPtX hPM q
  rw [h_raw, wordScore_append] at h_full
  have h_g := congr_fun h_full g
  rw [wordScore_singleton_apply] at h_g
  have h_diag : liftedGameMat G_O P J g g = 0 := by
    dsimp [g, gatewayToLiftedAct, liftedGameMat]
    exact AdjoinLeaderEndpointG_diag_zero clock.G b clock.v clock.hskew (gatewayOldAct clock.m)
  rw [h_diag, add_zero] at h_g
  have h_gw_eval := liftedScoreMat_S_uniform_inl_gateway_eval hw clock b c_step H0 delta J M (q + 1)
  have h_h_dot := dotProduct_h_uniform_binomBasis clock b zeta c_step (q + 1)
  have h_g_eq : g = Sum.inl (gatewayOldAct clock.m) := rfl
  change wordScore (liftedGameMat G_O P J) s0 W_123 g = _
  rw [h_g, h_g_eq, h_gw_eval]
  linarith [h_h_dot]

/-- Word score of W_123 on parent actions evaluates to parent score + h_uniform. -/
theorem s_end_parent_M {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta : ℚ)
    (parentWord : ℕ → List (Fin clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (P : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (hPtX : P.transpose * X_gateway clock = Q_reset J (M_of_nat M_nat) (B_mat (w + 1)) (zeta_canonical hw clock b c_step H0))
    (hPM : P * M_of_nat M_nat = (S_uniform hw clock b (h_uniform clock b (zeta_canonical hw clock b c_step H0) c_step) delta) * N_mat (w + 1) - (AdjoinLeaderEndpointG clock.G b clock.v) * X_gateway clock)
    (i : Fin clock.m) (q : ℕ) :
    let G_O := AdjoinLeaderEndpointG clock.G b clock.v
    let S := S_uniform hw clock b (h_uniform clock b (zeta_canonical hw clock b c_step H0) c_step) delta
    let X := X_gateway clock
    let M := M_of_nat M_nat
    let zeta := zeta_canonical hw clock b c_step H0
    let s0 := (liftedScoreMat G_O J S X M zeta).mulVec (binomBasis (w + 1) q)
    let W_123 := W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q ++
      (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)
    let act := (Sum.inl (finSumFinEquiv (Sum.inl i)) : Fin (clock.m + 1) ⊕ Fin ((w + 1) + (w + 1)))
    wordScore (liftedGameMat G_O P J) s0 W_123 act =
      (clock.R.mulVec (binomBasis w (q + 1))) i +
        dotProduct (h_uniform clock b zeta c_step) (binomBasis (w + 1) (q + 1)) := by
  intro G_O S X M zeta s0 W_123 act
  let g := gatewayToLiftedAct clock.m w
  have h_raw : rawFourStageWord_M clock parentWord M_nat q = W_123 ++ [g] := rfl
  have h_full := wordScore_rawFourStageWord_M clock parentWord hparent_count G_O P J S M_nat zeta hPtX hPM q
  rw [h_raw, wordScore_append] at h_full
