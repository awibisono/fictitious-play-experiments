    (h_parent : IsValidPriorityWord G_O (fun u => s_mid (Sum.inl u))
      (fun u => paperPriorityRank clock.m w parent_rank (Sum.inl u))
      ((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)))
    (h_reset_waits : ∀ (k : ℕ) (hk : k < ((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).length)
      (j : Fin ((w + 1) + (w + 1))),
      s_mid (Sum.inr j) - ∑ u, P u j * wordCountVec (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).take k) u ≤
        wordScore G_O (fun u => s_mid (Sum.inl u))
          (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).take k)
          (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m))[k])) :
    IsValidPriorityWord (liftedGameMat G_O P J) s_mid (paperPriorityRank clock.m w parent_rank)
      ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)) := by
  rw [map_bundleToLiftedAct_eq_map_inl]
  have h_rank_active_reset : ∀ (k : ℕ) (hk : k < ((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)).length)
      (j : Fin ((w + 1) + (w + 1))),
      (paperPriorityRank clock.m w parent_rank (Sum.inl (((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m))[k]))).val <
        (paperPriorityRank clock.m w parent_rank (Sum.inr j)).val := by
    intro k hk j
    have hk_len : k < (W_bundle_word parentWord (q + 1)).length := by simpa using hk
    rw [List.getElem_map]
    have hp : parentToOldAct clock.m ((W_bundle_word parentWord (q + 1))[k]'hk_len) =
        (finSumFinEquiv : Fin clock.m ⊕ Fin 1 ≃ Fin (clock.m + 1)) (Sum.inl ((W_bundle_word parentWord (q + 1))[k]'hk_len)) := rfl
    rw [hp]
    exact paperPriorityRank_parent_lt_reset clock.m w parent_rank ((W_bundle_word parentWord (q + 1))[k]'hk_len) j
  exact isValidPriorityWord_stage1_bundle_valid' G_O P J (paperPriorityRank clock.m w parent_rank) s_mid
    ((W_bundle_word parentWord (q + 1)).map (parentToOldAct clock.m)) h_parent h_rank_active_reset h_reset_waits

theorem isValidPriorityWord_stage3_bundle_from_parent' {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (parent_rank : Fin clock.m → Fin clock.m)
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = clock.C.mulVec (binomBasis w σ))
    (hparent_valid : ∀ σ : ℕ,
