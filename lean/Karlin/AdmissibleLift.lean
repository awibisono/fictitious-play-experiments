  have hX_inl : (∑ i : Fin 3, a_old_rps_four_thirds_H0 H0 (finSumFinEquiv (Sum.inl i)) *
      X_gateway rpsFullRankClock.clock (finSumFinEquiv (Sum.inl i)) c) =
      (7 / 18 : ℚ) * shiftRightCount C2 0 c +
      (4 / 18 : ℚ) * shiftRightCount C2 1 c +
      (1 / 18 : ℚ) * shiftRightCount C2 2 c := by
    dsimp [a_old_rps_four_thirds_H0, X_gateway, X_coupled, rpsFullRankClock, rpsAlgebraicClock]
    simp_rw [Equiv.symm_apply_apply]
    rw [Fin.sum_univ_three]
    rfl
  change (∑ i : Fin 3, a_old_rps_four_thirds_H0 H0 (finSumFinEquiv (Sum.inl i)) *
      X_gateway rpsFullRankClock.clock (finSumFinEquiv (Sum.inl i)) c) + (2 * H0 - 4 / 3) * e0_row 3 c = _
  rw [hX_inl]
  rcases c with ⟨c, hc⟩
  interval_cases c
  · -- c = 0
    have : (⟨0, hc⟩ : Fin 3) = 0 := rfl
    rw [this]
    have h0_0 : shiftRightCount C2 0 0 = 0 := shiftRightCount_zero C2 0 0 rfl
    have h0_1 : shiftRightCount C2 1 0 = 0 := shiftRightCount_zero C2 1 0 rfl
    have h0_2 : shiftRightCount C2 2 0 = 0 := shiftRightCount_zero C2 2 0 rfl
    rw [h0_0, h0_1, h0_2]
    rw [Fin.sum_univ_three]
    rw [B_mat_3_0_0, B_mat_3_1_0, B_mat_3_2_0]
    rw [one_3_0_0, one_3_1_0, one_3_2_0]
    have hz0 : zeta_canonical (by decide) rpsFullRankClock.clock b_rps_local (4 / 3) H0 0 = H0 := rfl
    have hz1 := rps_zeta_canonical_four_thirds_one_H0 H0
    have hz2 := rps_zeta_canonical_four_thirds_two_H0 H0
    rw [hz0, hz1, hz2]
    dsimp [e0_row]
