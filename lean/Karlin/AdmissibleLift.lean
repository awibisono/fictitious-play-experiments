theorem g_gw_waits (hu0 : w + 1 ≤ u 0) (hui : ∀ i : Fin w, 1 ≤ u i.succ)
    (hell : ell_uniform_total hw fc.clock b c_step H0 (1 / 2) alpha = fun c => 2 * (u c : ℚ))
    (hb_subdiag : fc.clock.R b ⟨w - 1, by omega⟩ = 1)
    (parentWord : ℕ → List (Fin fc.clock.m)) (parent_rank : Fin fc.clock.m → Fin fc.clock.m)
