/-- Interpolation matrix `P_admissible_scaled` is independent of `delta`. -/
theorem P_admissible_scaled_indep_of_delta {w : ℕ} (clock : AlgebraicClock w)
    (b : Fin clock.m) (H0 ch delta c_zeta c_P0 : ℚ) (a_old : Fin (clock.m + 1) → ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) :
    P_admissible_scaled clock b H0 ch delta c_zeta c_P0 a_old L_C =
      P_admissible_scaled clock b H0 ch 0 c_zeta c_P0 a_old L_C := by
