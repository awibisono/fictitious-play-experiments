/-- Canonical positive cone vector for the RPS base clock with c_step = 4/3 and H0 = 3. -/
def a_old_rps_four_thirds : Fin (rpsFullRankClock.clock.m + 1) → ℚ :=
  fun x =>
    match finSumFinEquiv.symm x with
    | Sum.inl i =>
      if i.val = 0 then 7 / 18
      else if i.val = 1 then 4 / 18
      else 1 / 18
    | Sum.inr _ => 14 / 3

theorem a_old_rps_four_thirds_pos (x : Fin (rpsFullRankClock.clock.m + 1)) :
    0 < a_old_rps_four_thirds x := by
  dsimp [a_old_rps_four_thirds]
  split
  · split_ifs <;> norm_num
  · norm_num

theorem vecMul_a_old_rps_four_thirds_X_gateway :
    Matrix.vecMul a_old_rps_four_thirds (X_gateway rpsFullRankClock.clock) =
      Matrix.vecMul (zeta_canonical (by decide) rpsFullRankClock.clock b_rps_local (4 / 3) 3) (1 + B_mat 3) := by
  ext c
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun x =>
      a_old_rps_four_thirds x * X_gateway rpsFullRankClock.clock x c).symm
  dsimp [Matrix.vecMul, dotProduct]
  rw [hcomp, Fintype.sum_sum_type]
  have hX_inr : (∑ g : Fin 1, a_old_rps_four_thirds (finSumFinEquiv (Sum.inr g)) *
      X_gateway rpsFullRankClock.clock (finSumFinEquiv (Sum.inr g)) c) =
      (14 / 3) * e0_row 3 c := by
    rw [Fin.sum_univ_one]
    dsimp [a_old_rps_four_thirds, X_gateway, X_coupled]
    simp [e0_row]
  rw [hX_inr]
  have hX_inl : (∑ i : Fin 3, a_old_rps_four_thirds (finSumFinEquiv (Sum.inl i)) *
      X_gateway rpsFullRankClock.clock (finSumFinEquiv (Sum.inl i)) c) =
      (7 / 18 : ℚ) * shiftRightCount C2 0 c +
      (4 / 18 : ℚ) * shiftRightCount C2 1 c +
      (1 / 18 : ℚ) * shiftRightCount C2 2 c := by
    dsimp [a_old_rps_four_thirds, X_gateway, X_coupled, rpsFullRankClock, rpsAlgebraicClock]
    simp_rw [Equiv.symm_apply_apply]
    rw [Fin.sum_univ_three]
    rfl
  change (∑ i : Fin 3, a_old_rps_four_thirds (finSumFinEquiv (Sum.inl i)) *
      X_gateway rpsFullRankClock.clock (finSumFinEquiv (Sum.inl i)) c) + (14 / 3) * e0_row 3 c = _
  rw [hX_inl]
  rcases c with ⟨c, hc⟩
  interval_cases c
  · -- c = 0
    have : (⟨0, hc⟩ : Fin 3) = 0 := rfl
    rw [this]
    have h0_0 : shiftRightCount C2 0 0 = 0 := shiftRightCount_zero C2 0 0 rfl
    have h0_1 : shiftRightCount C2 1 0 = 0 := shiftRightCount_zero C2 1 0 rfl
    have h0_2 : shiftRightCount C2 2 0 = 0 := shiftRightCount_zero C2 2 0 rfl
    rw [h0_0, h0_1, h0_2]
    rw [Fin.sum_univ_three]
    rw [B_mat_3_0_0, B_mat_3_1_0, B_mat_3_2_0]
    rw [one_3_0_0, one_3_1_0, one_3_2_0]
    rw [rps_zeta_canonical_four_thirds_zero, rps_zeta_canonical_four_thirds_one, rps_zeta_canonical_four_thirds_two]
    dsimp [e0_row]
    norm_num
  · -- c = 1
    have : (⟨1, hc⟩ : Fin 3) = 1 := rfl
    rw [this]
    have h1_0 : shiftRightCount C2 0 1 = C2 0 0 := shiftRightCount_pos C2 0 1 (by decide)
    have h1_1 : shiftRightCount C2 1 1 = C2 1 0 := shiftRightCount_pos C2 1 1 (by decide)
    have h1_2 : shiftRightCount C2 2 1 = C2 2 0 := shiftRightCount_pos C2 2 1 (by decide)
    rw [h1_0, h1_1, h1_2, C2_zero_zero, C2_one_zero, C2_two_zero]
    rw [Fin.sum_univ_three]
    rw [B_mat_3_0_1, B_mat_3_1_1, B_mat_3_2_1]
    rw [one_3_0_1, one_3_1_1, one_3_2_1]
    rw [rps_zeta_canonical_four_thirds_zero, rps_zeta_canonical_four_thirds_one, rps_zeta_canonical_four_thirds_two]
    dsimp [e0_row]
    norm_num
  · -- c = 2
    have : (⟨2, hc⟩ : Fin 3) = 2 := rfl
    rw [this]
    have h2_0 : shiftRightCount C2 0 2 = C2 0 1 := shiftRightCount_pos C2 0 2 (by decide)
    have h2_1 : shiftRightCount C2 1 2 = C2 1 1 := shiftRightCount_pos C2 1 2 (by decide)
    have h2_2 : shiftRightCount C2 2 2 = C2 2 1 := shiftRightCount_pos C2 2 2 (by decide)
    rw [h2_0, h2_1, h2_2, C2_zero_one, C2_one_one, C2_two_one]
    rw [Fin.sum_univ_three]
    rw [B_mat_3_0_2, B_mat_3_1_2, B_mat_3_2_2]
    rw [one_3_0_2, one_3_1_2, one_3_2_2]
    rw [rps_zeta_canonical_four_thirds_zero, rps_zeta_canonical_four_thirds_one, rps_zeta_canonical_four_thirds_two]
    dsimp [e0_row]
    norm_num


/-- Shifted cone vector for RPS with baseline parameter `H0`. -/
def a_old_rps_four_thirds_H0 (H0 : ℚ) : Fin (rpsFullRankClock.clock.m + 1) → ℚ :=
