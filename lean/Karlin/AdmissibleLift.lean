    _ ≤ C_len_M fc M_nat * (((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k)) :=
      mul_le_mul_of_nonneg_right h_sum_le_C_len h_prod_nonneg
    _ = C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k) * ((q + 1 : ℚ) ^ k) := by ring

theorem wordPhaseStartStep_M_shifted_upper_pow {k : ℕ} (fc : FullRankClock k)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis k σ))
    (M_nat : Matrix (Fin ((k + 1) + (k + 1))) (Fin (k + 1)) ℕ)
    (phaseShift p : ℕ) :
    (wordPhaseStartStep (fun q => (rawFourStageWord_M fc.clock parentWord M_nat (q + phaseShift)).map finSumFinEquiv) (p + 1) : ℚ) ≤
      (1 + C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k)) * ((p + 1 : ℚ) ^ (k + 1)) := by
  let phaseWord : ℕ → List (Fin (fc.clock.m + 1 + ((k + 1) + (k + 1)))) := fun q =>
    (rawFourStageWord_M fc.clock parentWord M_nat (q + phaseShift)).map finSumFinEquiv
  have h_len_eq : ∀ r : ℕ, (phaseWord r).length = (rawFourStageWord_M fc.clock parentWord M_nat (r + phaseShift)).length := by
    intro r
    dsimp only [phaseWord]
    rw [List.length_map]
  have h_step_eq : ((wordPhaseStartStep phaseWord (p + 1) : ℕ) : ℚ) =
      (∑ r ∈ Finset.range (p + 1), ((phaseWord r).length : ℚ)) + 1 := by
    unfold wordPhaseStartStep runStart
    push_cast
    ring
  rw [h_step_eq]
  have h_term_le : ∀ r ∈ Finset.range (p + 1),
      ((phaseWord r).length : ℚ) ≤ C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k) * ((p + 1 : ℚ) ^ k) := by
    intro r hr
    rw [Finset.mem_range] at hr
    have hr_le : r + 1 ≤ p + 1 := by omega
    have hr_pow : (r + 1 : ℚ) ^ k ≤ (p + 1 : ℚ) ^ k := by
      have : (r + 1 : ℚ) ≤ (p + 1 : ℚ) := by exact_mod_cast hr_le
      exact pow_le_pow_left₀ (by positivity) this k
