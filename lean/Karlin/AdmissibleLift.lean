        (by omega) grc.hell (by rw [grc.hb_subdiag]; norm_num))).clock.R
      (step_b grc) j = _
    dsimp [uniformFullRankLift_M, step_b, AlgebraicClock.ofEquiv]
    simp only [Equiv.symm_apply_apply]
    rfl
  rw [hR_apply]
  dsimp [liftedScoreMat]
