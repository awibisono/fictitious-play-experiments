/-- At the end of the reset stages, the score on old actions evaluates to . -/
theorem wordScore_after_reset_stages_M_inl {w : ℕ} (clock : AlgebraicClock w)
    (G_O : Matrix (Fin (clock.m + 1)) (Fin (clock.m + 1)) ℚ)
    (P : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (S : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (zeta : Fin (w + 1) → ℚ)
    (hPM : P * M_of_nat M_nat = S * N_mat (w + 1) - G_O * X_gateway clock)
    (q : ℕ) (u : Fin (clock.m + 1)) :
    wordScore (liftedGameMat G_O P J)
      ((liftedScoreMat G_O J S (X_gateway clock) (M_of_nat M_nat) zeta).mulVec (binomBasis (w + 1) q))
      (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q) (Sum.inl u) =
    S.mulVec (binomBasis (w + 1) (q + 1)) u := by
  have hW_inl := wordCountVec_reset_stages_M_inl clock.m w M_nat q
  rw [wordScore_liftedGameMat_reset_inl G_O P J _ _ hW_inl u]
  have hW_inr : ∀ r : Fin ((w + 1) + (w + 1)), wordCountVec (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q) (Sum.inr r) =
      (M_of_nat M_nat).mulVec (binomBasis (w + 1) q) r :=
    wordCountVec_reset_stages_M_inr clock.m w q M_nat
  have hsum : (∑ r : Fin ((w + 1) + (w + 1)), P u r * wordCountVec (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q) (Sum.inr r)) =
      ((P * M_of_nat M_nat).mulVec (binomBasis (w + 1) q)) u := by
    have h1 : (∑ r : Fin ((w + 1) + (w + 1)), P u r * wordCountVec (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q) (Sum.inr r)) =
        (P.mulVec ((M_of_nat M_nat).mulVec (binomBasis (w + 1) q))) u := by
      simp only [Matrix.mulVec, dotProduct]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [hW_inr r]
      rfl
    rw [h1, ← Matrix.mulVec_mulVec]
  rw [hsum, hPM]
  have hs_u : ((liftedScoreMat G_O J S (X_gateway clock) (M_of_nat M_nat) zeta).mulVec (binomBasis (w + 1) q)) (Sum.inl u) =
      ((S + G_O * X_gateway clock).mulVec (binomBasis (w + 1) q)) u := rfl
  rw [hs_u]
  simp only [Matrix.sub_mulVec, Matrix.add_mulVec, Pi.add_apply, Pi.sub_apply]
  have hSN : S.mulVec (binomBasis (w + 1) q) u + (S * N_mat (w + 1)).mulVec (binomBasis (w + 1) q) u =
      S.mulVec (binomBasis (w + 1) (q + 1)) u := by
    have hT : S.mulVec (binomBasis (w + 1) (q + 1)) = S.mulVec ((1 + N_mat (w + 1)).mulVec (binomBasis (w + 1) q)) := by
      rw [← T_mat, ← binomBasis_succ]
    rw [hT]
    simp only [Matrix.add_mulVec, Matrix.one_mulVec, Matrix.mulVec_add, Matrix.mulVec_mulVec]
    rfl
  linarith



