    (G_O : Matrix (Fin (clock.m + 1)) (Fin (clock.m + 1)) ℚ)
    (P : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (J : Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ)
    (S : Matrix (Fin (clock.m + 1)) (Fin (w + 1)) ℚ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (zeta : Fin (w + 1) → ℚ)
    (hPtX : P.transpose * X_gateway clock = Q_reset J (M_of_nat M_nat) (B_mat (w + 1)) zeta)
    (hPM : P * M_of_nat M_nat = S * N_mat (w + 1) - G_O * X_gateway clock)
    (q : ℕ) :
    wordScore (liftedGameMat G_O P J)
      ((liftedScoreMat G_O J S (X_gateway clock) (M_of_nat M_nat) zeta).mulVec (binomBasis (w + 1) q))
      (rawFourStageWord_M clock parentWord M_nat q) =
    (liftedScoreMat G_O J S (X_gateway clock) (M_of_nat M_nat) zeta).mulVec (binomBasis (w + 1) (q + 1)) := by
  change scoreVec (liftedGameMat G_O P J)
    ((liftedScoreMat G_O J S (X_gateway clock) (M_of_nat M_nat) zeta).mulVec (binomBasis (w + 1) q))
    (wordCountVec (rawFourStageWord_M clock parentWord M_nat q)) = _
  rw [wordCountVec_rawFourStageWord_M clock parentWord hparent_count M_nat q]
  have hclock := liftedGameMat_mul_liftedCountMat G_O P J S (X_gateway clock) (M_of_nat M_nat)
    (B_mat (w + 1)) (N_mat (w + 1)) zeta (B_mat_mul_one_add_N (w + 1)) hPtX hPM
  exact clock_phase_transition (liftedGameMat G_O P J)
    (liftedScoreMat G_O J S (X_gateway clock) (M_of_nat M_nat) zeta)
    (liftedCountMat (X_gateway clock) (M_of_nat M_nat) (N_mat (w + 1)))
