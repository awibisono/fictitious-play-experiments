        _ = (1 + C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k)) * ((p + 1 : ℚ) ^ (k + 1)) := by ring

theorem wordPhaseStartStep_M_shifted_lower_pow {k : ℕ} (fc : FullRankClock k)
    (parentWord : ℕ → List (Fin fc.clock.m))
    (M_nat : Matrix (Fin ((k + 1) + (k + 1))) (Fin (k + 1)) ℕ)
    (h_len_lower : ∀ q : ℕ, (Nat.choose q k : ℚ) ≤ ((rawFourStageWord_M fc.clock parentWord M_nat q).length : ℚ))
    (phaseShift : ℕ) (hshift : k ≤ phaseShift) (p : ℕ) :
    ((p + 1 : ℚ) ^ (k + 1)) / ((2 ^ (k + 1) * (k + 1).factorial : ℕ) : ℚ) ≤
      (wordPhaseStartStep (fun q => (rawFourStageWord_M fc.clock parentWord M_nat (q + phaseShift)).map finSumFinEquiv) p : ℚ) := by
  let phaseWord : ℕ → List (Fin (fc.clock.m + 1 + ((k + 1) + (k + 1)))) := fun q =>
    (rawFourStageWord_M fc.clock parentWord M_nat (q + phaseShift)).map finSumFinEquiv
  have h_len_eq : ∀ r : ℕ, (phaseWord r).length = (rawFourStageWord_M fc.clock parentWord M_nat (r + phaseShift)).length := by
    intro r
    dsimp only [phaseWord]
    rw [List.length_map]
  have h_step_eq : ((wordPhaseStartStep phaseWord p : ℕ) : ℚ) =
      (∑ r ∈ Finset.range p, ((phaseWord r).length : ℚ)) + 1 := by
    unfold wordPhaseStartStep runStart
    push_cast
    ring
  cases p with
  | zero =>
    rw [h_step_eq]
    have h_denom_pos : 0 < (2 ^ (k + 1) * (k + 1).factorial : ℕ) := by positivity
    have h_denom_ge_one : 1 ≤ ((2 ^ (k + 1) * (k + 1).factorial : ℕ) : ℚ) := by
      exact_mod_cast Nat.succ_le_of_lt h_denom_pos
    have h_lhs : ((0 + 1 : ℚ) ^ (k + 1)) / ((2 ^ (k + 1) * (k + 1).factorial : ℕ) : ℚ) ≤ 1 := by
      have : ((0 + 1 : ℚ) ^ (k + 1)) = 1 := by ring
      rw [this]
      exact div_le_one_of_le₀ h_denom_ge_one (by positivity)
    simp only [Finset.range_zero, Finset.sum_empty, zero_add]
    exact h_lhs
  | succ m =>
    rw [h_step_eq]
    have h_term_ge : ∀ r : ℕ, (Nat.choose (r + phaseShift) k : ℚ) ≤ ((phaseWord r).length : ℚ) := by
      intro r
      rw [h_len_eq r]
      exact h_len_lower (r + phaseShift)
    have h_sum_ge := Finset.sum_le_sum fun r (_ : r ∈ Finset.range (m + 1)) => h_term_ge r
    have h_shifted := sum_range_shifted_choose k phaseShift (m + 1) hshift
    have h_rat_shifted : (Nat.choose (m + 1 + k) (k + 1) : ℚ) ≤
        ∑ r ∈ Finset.range (m + 1), (Nat.choose (r + phaseShift) k : ℚ) := by
      exact_mod_cast h_shifted
    have h_choose_le_sum : (Nat.choose (m + 1 + k) (k + 1) : ℚ) ≤
        ∑ r ∈ Finset.range (m + 1), ((phaseWord r).length : ℚ) :=
      le_trans h_rat_shifted h_sum_ge
    have h_pow_double : (m + 1 + 1) ^ (k + 1) ≤ 2 ^ (k + 1) * (m + 1) ^ (k + 1) := by
      have h_double : m + 1 + 1 ≤ 2 * (m + 1) := by omega
      have h := Nat.pow_le_pow_left h_double (k + 1)
      rw [Nat.mul_pow] at h
      exact h
    have h_pow_choose : (m + 1) ^ (k + 1) ≤ (k + 1).factorial * Nat.choose (m + 1 + k) (k + 1) := by
      have h := pow_le_factorial_mul_choose (k + 1) m
      have hm : m + (k + 1) = m + 1 + k := by omega
      rw [hm] at h
      exact h
    have h_comb : (m + 1 + 1) ^ (k + 1) ≤ (2 ^ (k + 1) * (k + 1).factorial) * Nat.choose (m + 1 + k) (k + 1) := by
      have h_mul := Nat.mul_le_mul_left (2 ^ (k + 1)) h_pow_choose
      have h_assoc : 2 ^ (k + 1) * ((k + 1).factorial * Nat.choose (m + 1 + k) (k + 1)) =
          (2 ^ (k + 1) * (k + 1).factorial) * Nat.choose (m + 1 + k) (k + 1) := by ring
      rw [h_assoc] at h_mul
      exact le_trans h_pow_double h_mul
    have h_rat_comb : ((m + 1 + 1 : ℚ) ^ (k + 1)) ≤
        ((2 ^ (k + 1) * (k + 1).factorial : ℕ) : ℚ) * (Nat.choose (m + 1 + k) (k + 1) : ℚ) := by
      have h_cast : (((m + 1 + 1) ^ (k + 1) : ℕ) : ℚ) ≤
          (((2 ^ (k + 1) * (k + 1).factorial) * Nat.choose (m + 1 + k) (k + 1) : ℕ) : ℚ) := by
        exact_mod_cast h_comb
      push_cast at h_cast ⊢
      exact h_cast
    have h_denom_pos : 0 < ((2 ^ (k + 1) * (k + 1).factorial : ℕ) : ℚ) := by positivity
    have h_div_le : ((m + 1 + 1 : ℚ) ^ (k + 1)) / ((2 ^ (k + 1) * (k + 1).factorial : ℕ) : ℚ) ≤
        (Nat.choose (m + 1 + k) (k + 1) : ℚ) :=
      (div_le_iff₀ h_denom_pos).mpr (by linarith [h_rat_comb])
    have h_trans : ((m + 1 + 1 : ℚ) ^ (k + 1)) / ((2 ^ (k + 1) * (k + 1).factorial : ℕ) : ℚ) ≤
        ∑ r ∈ Finset.range (m + 1), ((phaseWord r).length : ℚ) :=
      le_trans h_div_le h_choose_le_sum
    have h_cast_m : ((m + 1 : ℕ) + 1 : ℚ) = (m + 1 + 1 : ℚ) := by push_cast; ring
    rw [h_cast_m]
    linarith

