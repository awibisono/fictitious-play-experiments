/-- RPS Stage 3 active score lower bound in the `LiftInput.h_active` shape, for ALL `q`. -/
theorem rps_h_active (q k : ℕ)
    (hk : k < ((W_bundle_word rpsPhaseWord (q + 1)).map (parentToOldAct rpsRealizedClock.fc.clock.m)).length) :
    dotProduct (zeta_canonical hw1 rpsRealizedClock.fc.clock b_rps (4 / 3) 19) (binomBasis (2 + 1) (q + 1)) -
        4 / 3 - 7 -
        (1 / 72) * ((((W_bundle_word rpsPhaseWord (q + 1)).map (parentToOldAct rpsRealizedClock.fc.clock.m)).drop k).length : ℚ) ≤
      wordScore (AdjoinLeaderEndpointG rpsRealizedClock.fc.clock.G b_rps rpsRealizedClock.fc.clock.v)
        ((S_uniform hw1 rpsRealizedClock.fc.clock b_rps
          (h_uniform rpsRealizedClock.fc.clock b_rps (zeta_canonical hw1 rpsRealizedClock.fc.clock b_rps (4 / 3) 19) (4 / 3))
          (1 / 2)).mulVec (binomBasis (2 + 1) (q + 1)))
        (((W_bundle_word rpsPhaseWord (q + 1)).map (parentToOldAct rpsRealizedClock.fc.clock.m)).take k)
        (((W_bundle_word rpsPhaseWord (q + 1)).map (parentToOldAct rpsRealizedClock.fc.clock.m))[k]) := by
  have hk_b : k < (W_bundle_word rpsPhaseWord (q + 1)).length := by simpa using hk
  have h_eq : ((W_bundle_word rpsPhaseWord (q + 1)).map (parentToOldAct rpsRealizedClock.fc.clock.m))[k] =
      parentToOldAct rpsRealizedClock.fc.clock.m ((W_bundle_word rpsPhaseWord (q + 1))[k]'hk_b) :=
    List.getElem_map (parentToOldAct rpsRealizedClock.fc.clock.m)
  rw [h_eq]
  have hscore_k := wordScore_bundle_take_parentToOldAct_uniform hw1 rpsRealizedClock.fc.clock b_rps
    (h_uniform rpsRealizedClock.fc.clock b_rps (zeta_canonical hw1 rpsRealizedClock.fc.clock b_rps (4 / 3) 19) (4 / 3))
    (1 / 2) (W_bundle_word rpsPhaseWord (q + 1)) q k ((W_bundle_word rpsPhaseWord (q + 1))[k]'hk_b)
  have hh := dotProduct_h_uniform_binomBasis rpsRealizedClock.fc.clock b_rps
    (zeta_canonical hw1 rpsRealizedClock.fc.clock b_rps (4 / 3) 19) (4 / 3) (q + 1)
  have hRb : (rpsRealizedClock.fc.clock.R.mulVec (binomBasis 2 (q + 1))) b_rps = (q : ℚ) + 2 := by
    have h1 : (rpsFullRankClock.clock.R.mulVec (binomBasis 2 (q + 1))) b_rps = ((q + 1 : ℕ) : ℚ) + 1 :=
      rps_R_leader_eval (q + 1)
    change (rpsFullRankClock.clock.R.mulVec (binomBasis 2 (q + 1))) b_rps = _
    rw [h1]
    push_cast
    ring
  have hlb : ((q : ℚ) + 2) - 7 - (1 / 72) * (((W_bundle_word rpsPhaseWord (q + 1)).drop k).length : ℚ) ≤
      wordScore rpsRealizedClock.fc.clock.G (rpsRealizedClock.fc.clock.R.mulVec (binomBasis 2 0))
        ((W_bundle_word rpsPhaseWord (q + 1)).take k) ((W_bundle_word rpsPhaseWord (q + 1))[k]'hk_b) :=
    rps_bundle_active_lb q k hk_b
  have hlen : ((((W_bundle_word rpsPhaseWord (q + 1)).map (parentToOldAct rpsRealizedClock.fc.clock.m)).drop k).length : ℚ) =
      (((W_bundle_word rpsPhaseWord (q + 1)).drop k).length : ℚ) := by
    simp only [List.length_drop, List.length_map]
  rw [hh, hRb] at hscore_k
  rw [hscore_k, hlen]
  linarith

