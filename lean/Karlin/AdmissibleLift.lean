    have h_coeff_nonneg : 0 ≤ C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k) := by
      have : 0 < C_len_M fc M_nat := C_len_M_pos fc M_nat
      positivity
    calc ((rawFourStageWord_M fc.clock parentWord M_nat (r + phaseShift)).length : ℚ) ≤
        C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k) * ((r + 1 : ℚ) ^ k) := h_upper_r
      _ ≤ C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k) * ((p + 1 : ℚ) ^ k) :=
        mul_le_mul_of_nonneg_left hr_pow h_coeff_nonneg
  have h_sum_le := Finset.sum_le_sum h_term_le
  have h_sum_const : (∑ _r ∈ Finset.range (p + 1), C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k) * ((p + 1 : ℚ) ^ k)) =
      (p + 1 : ℚ) * (C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k) * ((p + 1 : ℚ) ^ k)) := by
    simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    push_cast
    ring
  rw [h_sum_const] at h_sum_le
  calc (∑ r ∈ Finset.range (p + 1), ((phaseWord r).length : ℚ)) + 1 ≤
      (p + 1 : ℚ) * (C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k) * ((p + 1 : ℚ) ^ k)) + 1 := by linarith [h_sum_le]
    _ = C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k) * ((p + 1 : ℚ) ^ (k + 1)) + 1 := by
      have hp : (p + 1 : ℚ) * (C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k) * ((p + 1 : ℚ) ^ k)) =
          C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k) * ((p + 1 : ℚ) * (p + 1 : ℚ) ^ k) := by ring
      have hpow : (p + 1 : ℚ) * (p + 1 : ℚ) ^ k = (p + 1 : ℚ) ^ (k + 1) := by
        rw [mul_comm, pow_succ]
      rw [hp, hpow]
    _ ≤ (1 + C_len_M fc M_nat * ((phaseShift + 1 : ℚ) ^ k)) * ((p + 1 : ℚ) ^ (k + 1)) := by
      have hp1 : 1 ≤ (p + 1 : ℚ) ^ (k + 1) := by
