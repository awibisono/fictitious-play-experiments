      (wordScore (liftedGameMat G_O P J) s0 (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q))
      (paperPriorityRank clock.m w parent_rank)
      ((W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w)) := by
  intro G_O P S X M s0
  let s_mid := wordScore (liftedGameMat G_O P J) s0 (W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q)
  have hPM : P * (M_of_nat M_nat) = S * N_mat (w + 1) - G_O * X :=
    P_uniform_M_mul_M hw clock b c_step H0 delta M_nat R_M J E zeta P0 L_C hRM hMJM hmoment
  have hs_after : ∀ u : Fin (clock.m + 1), s_mid (Sum.inl u) = S.mulVec (binomBasis (w + 1) (q + 1)) u := by
    intro u
    dsimp only [s_mid, s0]
    exact wordScore_after_reset_stages_M_inl clock G_O P J S M_nat zeta hPM q u
  let c_shift := dotProduct (h_uniform clock b (zeta_canonical (by omega) clock b c_step H0) c_step) (binomBasis (w + 1) (q + 1))
  have hs_agree : ∀ i : Fin clock.m, s_mid (Sum.inl (parentToOldAct clock.m i)) =
      clock.R.mulVec (binomBasis w 0) i + c_shift := by
    intro i
    rw [hs_after]
    have hp : parentToOldAct clock.m i = finSumFinEquiv (Sum.inl i) := rfl
    rw [hp]
    dsimp only [S]
    rw [S_uniform_parent_eval (by omega) clock b _ delta i q]
    have hR0 : clock.R.mulVec (binomBasis w 0) i = clock.R i ⟨0, by omega⟩ := by
      simp only [Matrix.mulVec, dotProduct, binomBasis]
      rw [Finset.sum_eq_single ⟨0, by omega⟩]
      · simp
      · intro j _ hj
        have : j.val ≠ 0 := by intro h; apply hj; ext; exact h
        have : Nat.choose 0 j.val = 0 := Nat.choose_eq_zero_of_lt (by omega)
        simp [this]
      · intro h; exact False.elim (h (Finset.mem_univ _))
    rw [hR0]
  have hG_agree : ∀ i j : Fin clock.m,
      G_O (parentToOldAct clock.m i) (parentToOldAct clock.m j) = clock.G i j := by
    intro i j
    dsimp only [G_O]
    exact AdjoinLeaderEndpointG_parent_parent clock.G b clock.v i j
  exact isValidPriorityWord_stage3_bundle_from_parent clock parentWord parent_rank
    hparent_count hparent_valid q c_shift G_O P J s_mid
    hG_agree hs_agree h_gw_waits h_reset_waits

