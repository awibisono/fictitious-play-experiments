namespace Karlin

/-- Transpose mulVec identity: `(W_lower_inv w u)ᵀ * u = 1`. -/
theorem W_lower_inv_transpose_mulVec_u (w : ℕ) (u : Fin (w + 1) → ℚ)
    (hu0 : u 0 - w ≠ 0) (hui : ∀ i : Fin w, u i.succ ≠ 0) :
    (W_lower_inv w u).transpose.mulVec u = fun _ => 1 := by
  ext c
  have h := congr_fun (vecMul_u_W_lower_inv w u hu0 hui) c
  dsimp [Matrix.vecMul, dotProduct] at h
  dsimp [Matrix.mulVec, dotProduct, Matrix.transpose_apply]
  simp_rw [mul_comm (W_lower_inv w u _ c)]
  exact h

/-- Scaled vector identity: `α • (W_lower_inv w u)ᵀ * ζ = 2 • 1 - (W_lower_inv w u)ᵀ * ℓ_base`
    whenever `2 • u = α • ζ + ℓ_base`. -/
theorem alpha_smul_W_lower_inv_transpose_mulVec_zeta (w : ℕ)
    (u zeta ell_base : Fin (w + 1) → ℚ) (alpha : ℚ)
    (hu0 : u 0 - w ≠ 0) (hui : ∀ i : Fin w, u i.succ ≠ 0)
    (hu_def : ∀ c : Fin (w + 1), 2 * u c = alpha * zeta c + ell_base c) :
    (alpha • (W_lower_inv w u).transpose.mulVec zeta) =
      (fun _ => 2) - (W_lower_inv w u).transpose.mulVec ell_base := by
  ext c
  have hu : ∀ c, alpha * zeta c = 2 * u c - ell_base c := by
    intro c; linarith [hu_def c]
  simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply, Pi.smul_apply, smul_eq_mul,
    Pi.sub_apply]
  rw [Finset.mul_sum]
  have hsum : (∑ j : Fin (w + 1), alpha * (W_lower_inv w u j c * zeta j)) =
      ∑ j : Fin (w + 1), W_lower_inv w u j c * (alpha * zeta j) := by
    apply Finset.sum_congr rfl
    intro j _
    ring
  rw [hsum]
  simp_rw [hu]
  simp_rw [mul_sub]
  rw [Finset.sum_sub_distrib]
  have h2 : (∑ j : Fin (w + 1), W_lower_inv w u j c * (2 * u j)) =
      2 * ∑ j : Fin (w + 1), W_lower_inv w u j c * u j := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    ring
  rw [h2]
  have hu_ones := congr_fun (W_lower_inv_transpose_mulVec_u w u hu0 hui) c
  dsimp [Matrix.mulVec, dotProduct, Matrix.transpose_apply] at hu_ones
  rw [hu_ones]
  ring

theorem W_lower_inv_transpose_mulVec_succ (w : ℕ) (u v : Fin (w + 1) → ℚ) (k : Fin w) :
    ((W_lower_inv w u).transpose.mulVec v) k.succ = (u k.succ)⁻¹ * v k.succ := by
  dsimp [Matrix.mulVec, dotProduct, Matrix.transpose_apply]
  rw [Fin.sum_univ_succ]
  rw [W_lower_inv_apply_zero_succ, zero_mul, zero_add]
  simp_rw [W_lower_inv_apply_succ_succ]
  rw [Finset.sum_eq_single k]
  · simp
  · intro x _ hx
    rw [if_neg hx, zero_mul]
  · intro h; exfalso; exact h (Finset.mem_univ _)

theorem W_lower_inv_transpose_mulVec_zero (w : ℕ) (u v : Fin (w + 1) → ℚ) :
    ((W_lower_inv w u).transpose.mulVec v) 0 =
      (u 0 - w)⁻¹ * (v 0 - ∑ j : Fin w, (u j.succ)⁻¹ * v j.succ) := by
  dsimp [Matrix.mulVec, dotProduct, Matrix.transpose_apply]
  rw [Fin.sum_univ_succ]
  rw [W_lower_inv_apply_zero_zero]
  simp_rw [W_lower_inv_apply_succ_zero]
  have hsum : (∑ j : Fin w, - (u 0 - w)⁻¹ * (u j.succ)⁻¹ * v j.succ) =
      - (u 0 - w)⁻¹ * ∑ j : Fin w, (u j.succ)⁻¹ * v j.succ := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    ring
  rw [hsum]
  ring

theorem W_lower_inv_transpose_mulVec_succ_pos (w : ℕ) (u v : Fin (w + 1) → ℚ) (k : Fin w)
    (hu : 0 < u k.succ) (hv : 0 < v k.succ) :
    0 < ((W_lower_inv w u).transpose.mulVec v) k.succ := by
  rw [W_lower_inv_transpose_mulVec_succ]
  exact mul_pos (inv_pos.mpr hu) hv

theorem W_lower_inv_transpose_mulVec_zero_pos (w : ℕ) (u v : Fin (w + 1) → ℚ)
    (hu0 : (w : ℚ) < u 0)
    (hdiff : (∑ j : Fin w, (u j.succ)⁻¹ * v j.succ) < v 0) :
    0 < ((W_lower_inv w u).transpose.mulVec v) 0 := by
  rw [W_lower_inv_transpose_mulVec_zero]
  have hpos1 : 0 < (u 0 - w)⁻¹ := by
    apply inv_pos.mpr
    linarith
  have hpos2 : 0 < v 0 - ∑ j : Fin w, (u j.succ)⁻¹ * v j.succ := by
    linarith
  exact mul_pos hpos1 hpos2

/-- On the late block `Sum.inr j`, `J_lower * M_lower = (W_lower_inv_u)ᵀ * E`. -/
theorem J_lower_mul_M_lower_inr (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ i : Fin w, ell i.succ ≠ 0)
    (j : Fin (w + 1)) :
    (fun c => (J_lower w ell E * M_lower w ell) (finSumFinEquiv (Sum.inr j)) c) =
      fun c => ((W_lower_inv_u w ell).transpose * E) j c := by
  ext c
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      J_lower w ell E (finSumFinEquiv (Sum.inr j)) r * M_lower w ell r c).symm
  rw [Matrix.mul_apply, hcomp, Fintype.sum_sum_type]
  simp only [J_lower, M_lower, Matrix.of_apply, Equiv.symm_apply_apply,
    zero_mul, Finset.sum_const_zero, add_zero]
  have hui' : ∀ i : Fin w, (fun k => ell k / 2) i.succ ≠ 0 := by
    intro i h
    have : ell i.succ = 0 := by linarith [h]
    exact hui i this
  have hinv : W_lower_inv_u w ell * W_lower_u w ell = 1 :=
    W_lower_inv_mul_W_lower (fun k => ell k / 2) hu0 hui'
  have hsum :
      (∑ i : Fin (w + 1), ((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell) j i * W_lower_u w ell i c) =
        (((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell) * W_lower_u w ell) j c := rfl
  rw [hsum, Matrix.mul_assoc, hinv, Matrix.mul_one]

/-- On the late block `Sum.inr j`, `(J_lower)ᵀ * M_lower = 0`. -/
theorem J_lower_transpose_mul_M_lower_inr (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (j : Fin (w + 1)) :
    (fun c => ((J_lower w ell E).transpose * M_lower w ell) (finSumFinEquiv (Sum.inr j)) c) =
      fun _ => 0 := by
  ext c
  rw [Matrix.mul_apply]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      (J_lower w ell E).transpose (finSumFinEquiv (Sum.inr j)) r * M_lower w ell r c).symm
  rw [hcomp, Fintype.sum_sum_type]
  simp only [Matrix.transpose_apply, J_lower, M_lower, Matrix.of_apply, Equiv.symm_apply_apply,
    Finset.sum_const_zero, zero_mul, add_zero]

/-- On the late block `Sum.inr j`, `Q_reset = 1 * (zeta * B - zeta) + (W_lower_inv_u)ᵀ * E`. -/
theorem Q_reset_lower_inr (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (zeta : Fin (w + 1) → ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ i : Fin w, ell i.succ ≠ 0)
    (j : Fin (w + 1)) :
    (fun c => Q_reset (J_lower w ell E) (M_lower w ell) (B_mat (w + 1)) zeta (finSumFinEquiv (Sum.inr j)) c) =
      fun c => (Matrix.vecMul zeta (B_mat (w + 1))) c - zeta c + ((W_lower_inv_u w ell).transpose * E) j c := by
  ext c
  change (one_zeta (Fin ((w + 1) + (w + 1))) zeta * B_mat (w + 1)) (finSumFinEquiv (Sum.inr j)) c -
      (one_zeta (Fin ((w + 1) + (w + 1))) zeta) (finSumFinEquiv (Sum.inr j)) c +
      (J_lower w ell E * M_lower w ell) (finSumFinEquiv (Sum.inr j)) c -
      ((J_lower w ell E).transpose * M_lower w ell * B_mat (w + 1)) (finSumFinEquiv (Sum.inr j)) c = _
  have hJM := congr_fun (J_lower_mul_M_lower_inr w ell E hu0 hui j) c
  have hJTM : ((J_lower w ell E).transpose * M_lower w ell * B_mat (w + 1)) (finSumFinEquiv (Sum.inr j)) c = 0 := by
    rw [Matrix.mul_apply]
    refine Finset.sum_eq_zero fun x _ => ?_
    have hx := congr_fun (J_lower_transpose_mul_M_lower_inr w ell E j) x
    rw [hx, zero_mul]
  have honeB : (one_zeta (Fin ((w + 1) + (w + 1))) zeta * B_mat (w + 1)) (finSumFinEquiv (Sum.inr j)) c =
      (Matrix.vecMul zeta (B_mat (w + 1))) c := rfl
  have hone : (one_zeta (Fin ((w + 1) + (w + 1))) zeta) (finSumFinEquiv (Sum.inr j)) c = zeta c := rfl
  rw [hJM, hJTM, honeB, hone]
  ring

/-- When `R_M` vanishes on column `r`, `P_interp` simplifies to `P0 + L_X * Q_Rᵀ`. -/
theorem P_interp_col_of_R_M_zero {m n w : Type*} [Fintype m] [Fintype n] [Fintype w]
    (X L_X : Matrix m w ℚ) (M : Matrix n w ℚ) (R_M : Matrix w n ℚ)
    (D : Matrix m w ℚ) (Q : Matrix n w ℚ) (P0 : Matrix m n ℚ)
    (r : n) (hRM : ∀ c : w, R_M c r = 0) (x : m) :
    P_interp X L_X M R_M D Q P0 x r =
      P0 x r + (L_X * (Q_res Q P0 X).transpose) x r := by
  unfold P_interp
  simp only [Matrix.add_apply]
  have hDR_RM : ∀ k : m, (D_res D P0 M * R_M) k r = 0 := by
    intro k
    rw [Matrix.mul_apply]
    exact Finset.sum_eq_zero fun c _ => by rw [hRM c, mul_zero]
  have hLX_X_DR : (L_X * (X.transpose * D_res D P0 M * R_M)) x r = 0 := by
    rw [Matrix.mul_apply]
    simp_rw [Matrix.mul_assoc]
    exact Finset.sum_eq_zero fun c _ => by
      rw [Matrix.mul_apply]
      have : (∑ k : m, X.transpose c k * (D_res D P0 M * R_M) k r) = 0 :=
        Finset.sum_eq_zero fun k _ => by rw [hDR_RM k, mul_zero]
      rw [this, mul_zero]
  have hsub : (L_X * ((Q_res Q P0 X).transpose - X.transpose * D_res D P0 M * R_M)) x r =
      (L_X * (Q_res Q P0 X).transpose) x r := by
    rw [Matrix.mul_sub, Matrix.sub_apply, hLX_X_DR, sub_zero]
  rw [hDR_RM x, add_zero, hsub]

/-- On any late column `Sum.inr j`, `P_uniform_total_lower` simplifies to `P0 + L_X * Q_Rᵀ`. -/
theorem P_uniform_total_lower_late (w : ℕ) (hw : 2 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step H0 delta alpha : ℚ)
    (P0 : Matrix (Fin (clock.m + 1)) (Fin ((w + 1) + (w + 1))) ℚ)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ)
    (j : Fin (w + 1)) (x : Fin (clock.m + 1)) :
    let ell := ell_uniform_total hw clock b c_step H0 delta alpha
    let M := M_lower w ell
    let J := J_lower w ell (E_uniform_total hw clock b c_step H0 delta alpha)
    let zeta := zeta_canonical (by omega) clock b c_step H0
    let Q := Q_reset J M (B_mat (w + 1)) zeta
    let X := X_gateway clock
    let L_X := L_X_gateway L_C
    P_uniform_total_lower hw clock b c_step H0 delta alpha P0 L_C x (finSumFinEquiv (Sum.inr j)) =
      P0 x (finSumFinEquiv (Sum.inr j)) + (L_X * (Q_res Q P0 X).transpose) x (finSumFinEquiv (Sum.inr j)) := by
  intro ell M J zeta Q X L_X
  have hRM : ∀ c : Fin (w + 1), R_M_lower w ell c (finSumFinEquiv (Sum.inr j)) = 0 := by
    intro c
    dsimp [R_M_lower]
    have heq : finSumFinEquiv.symm (Fin.natAdd (w + 1) j) = Sum.inr j := by
      rw [← finSumFinEquiv_apply_right, Equiv.symm_apply_apply]
    rw [heq]
  exact P_interp_col_of_R_M_zero X L_X M (R_M_lower w ell)
    (D_uniform hw clock b c_step H0 delta) Q P0
    (finSumFinEquiv (Sum.inr j)) hRM x

/-- On the early block `Sum.inl i`, `J_lower * M_lower = 0`. -/
theorem J_lower_mul_M_lower_inl (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (i : Fin (w + 1)) :
    (fun c => (J_lower w ell E * M_lower w ell) (finSumFinEquiv (Sum.inl i)) c) =
      fun _ => 0 := by
  ext c
  rw [Matrix.mul_apply]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      J_lower w ell E (finSumFinEquiv (Sum.inl i)) r * M_lower w ell r c).symm
  rw [hcomp, Fintype.sum_sum_type]
  simp only [J_lower, M_lower, Matrix.of_apply, Equiv.symm_apply_apply,
    zero_mul, Finset.sum_const_zero, add_zero]

/-- On the early block `Sum.inl i`, `(J_lower)ᵀ * M_lower = (W_lower_inv_u)ᵀ * Eᵀ`. -/
theorem J_lower_transpose_mul_M_lower_inl (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (i : Fin (w + 1)) :
    (fun c => ((J_lower w ell E).transpose * M_lower w ell) (finSumFinEquiv (Sum.inl i)) c) =
      fun c => ((W_lower_inv_u w ell).transpose * E.transpose) i c := by
  ext c
  rw [Matrix.mul_apply]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      (J_lower w ell E).transpose (finSumFinEquiv (Sum.inl i)) r * M_lower w ell r c).symm
  rw [hcomp, Fintype.sum_sum_type]
  simp only [Matrix.transpose_apply, J_lower, M_lower, Matrix.of_apply, Equiv.symm_apply_apply,
    zero_mul, Finset.sum_const_zero, zero_add]
  have hui' : ∀ j : Fin w, (fun k => ell k / 2) j.succ ≠ 0 := by
    intro j h
    have : ell j.succ = 0 := by linarith [h]
    exact hui j this
  have hinv : W_lower_inv_u w ell * W_lower_u w ell = 1 :=
    W_lower_inv_mul_W_lower (fun k => ell k / 2) hu0 hui'
  have h_trans : (∑ x : Fin (w + 1), ((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell) x i * W_lower_u w ell x c) =
      (∑ x : Fin (w + 1), ((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell).transpose i x * W_lower_u w ell x c) := by
    simp_rw [Matrix.transpose_apply]
  rw [h_trans]
  have hsum :
      (∑ j : Fin (w + 1), ((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell).transpose i j * W_lower_u w ell j c) =
        ((((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell).transpose) * W_lower_u w ell) i c := rfl
  rw [hsum]
  simp only [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.mul_assoc]
  rw [hinv, Matrix.mul_one]

/-- On the early block `Sum.inl i`, `Q_reset = 1 * (zeta * B - zeta) - (W_lower_inv_u)ᵀ * Eᵀ * B`. -/
theorem Q_reset_lower_inl (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (zeta : Fin (w + 1) → ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ j : Fin w, ell j.succ ≠ 0)
    (i : Fin (w + 1)) :
    (fun c => Q_reset (J_lower w ell E) (M_lower w ell) (B_mat (w + 1)) zeta (finSumFinEquiv (Sum.inl i)) c) =
      fun c => (Matrix.vecMul zeta (B_mat (w + 1))) c - zeta c - (((W_lower_inv_u w ell).transpose * E.transpose) * B_mat (w + 1)) i c := by
  ext c
  change (one_zeta (Fin ((w + 1) + (w + 1))) zeta * B_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) c -
      (one_zeta (Fin ((w + 1) + (w + 1))) zeta) (finSumFinEquiv (Sum.inl i)) c +
      (J_lower w ell E * M_lower w ell) (finSumFinEquiv (Sum.inl i)) c -
      ((J_lower w ell E).transpose * M_lower w ell * B_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) c = _
  have hJM : (J_lower w ell E * M_lower w ell) (finSumFinEquiv (Sum.inl i)) c = 0 := by
    exact congr_fun (J_lower_mul_M_lower_inl w ell E i) c
  have hJTM : ((J_lower w ell E).transpose * M_lower w ell * B_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) c =
      (((W_lower_inv_u w ell).transpose * E.transpose) * B_mat (w + 1)) i c := by
    rw [Matrix.mul_apply, Matrix.mul_apply]
    refine Finset.sum_congr rfl fun x _ => ?_
    have hx := congr_fun (J_lower_transpose_mul_M_lower_inl w ell E hu0 hui i) x
    rw [hx]
  have honeB : (one_zeta (Fin ((w + 1) + (w + 1))) zeta * B_mat (w + 1)) (finSumFinEquiv (Sum.inl i)) c =
      (Matrix.vecMul zeta (B_mat (w + 1))) c := rfl
  have hone : (one_zeta (Fin ((w + 1) + (w + 1))) zeta) (finSumFinEquiv (Sum.inl i)) c = zeta c := rfl
  rw [hJM, hJTM, honeB, hone]
  ring










/-- Reference coupling matrix `P0_cone_old` with negative early columns and positive late columns. -/
def P0_cone_old {m : ℕ} (a_old : Fin (m + 1) → ℚ) (w : ℕ) :
    Matrix (Fin (m + 1)) (Fin ((w + 1) + (w + 1))) ℚ :=
  P0_cone a_old w

/-- Early and late blocks of `M_lower` cancel identically against `P0_cone_old`,
    yielding `P0_cone_old a_old w * M_lower w ell = 0`. -/
theorem P0_cone_old_mul_M_lower {m w : ℕ} (a_old : Fin (m + 1) → ℚ) (ell : Fin (w + 1) → ℚ) :
    P0_cone_old a_old w * M_lower w ell = 0 := by
  ext x c
  rw [Matrix.mul_apply]
  have hcomp :=
    (Equiv.sum_comp finSumFinEquiv fun r : Fin ((w + 1) + (w + 1)) =>
      P0_cone_old a_old w x r * M_lower w ell r c).symm
  rw [hcomp, Fintype.sum_sum_type]
  simp only [P0_cone_old, P0_cone, M_lower, Matrix.of_apply, Equiv.symm_apply_apply]
  have h_inl : (∑ i : Fin (w + 1), -a_old x * W_lower_u w ell i c) =
      - a_old x * ∑ i : Fin (w + 1), W_lower_u w ell i c := by
    rw [← Finset.mul_sum]
  have h_inr : (∑ i : Fin (w + 1), a_old x * W_lower_u w ell i c) =
      a_old x * ∑ i : Fin (w + 1), W_lower_u w ell i c := by
    rw [← Finset.mul_sum]
  rw [h_inl, h_inr]
  simp only [Matrix.zero_apply]
  ring

/-- Deficit residual `D_res` under `P0_cone_old` and `M_lower` is simply `D`. -/
theorem D_res_P0_cone_old_M_lower {m w : ℕ} (D : Matrix (Fin (m + 1)) (Fin (w + 1)) ℚ)
    (a_old : Fin (m + 1) → ℚ) (ell : Fin (w + 1) → ℚ) :
    D_res D (P0_cone_old a_old w) (M_lower w ell) = D := by
  dsimp [D_res]
  rw [P0_cone_old_mul_M_lower, sub_zero]

/-- Parametric interaction matrix `J_lower_eta` with internal group interactions `eta • L_strict`. -/
def J_lower_eta (w : ℕ) (ell : Fin (w + 1) → ℚ) (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ) :
    Matrix (Fin ((w + 1) + (w + 1))) (Fin ((w + 1) + (w + 1))) ℚ :=
  let X_mid := (W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell - (2 * eta) • L_strict (w + 1)
  Matrix.of fun a b =>
    match finSumFinEquiv.symm a, finSumFinEquiv.symm b with
    | Sum.inl i, Sum.inl j => eta * L_strict (w + 1) i j
    | Sum.inl _, Sum.inr _ => 0
    | Sum.inr i, Sum.inl j => X_mid i j
    | Sum.inr i, Sum.inr j => eta * L_strict (w + 1) i j

/-- Strict lower triangularity of `J_lower_eta`: `J a b = 0` whenever `a.val ≤ b.val`. -/
theorem J_lower_eta_lower (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (a b : Fin ((w + 1) + (w + 1))) (hab : a.val ≤ b.val) :
    J_lower_eta w ell E eta a b = 0 := by
  obtain ⟨sa, rfl⟩ := finSumFinEquiv.surjective a
  obtain ⟨sb, rfl⟩ := finSumFinEquiv.surjective b
  simp only [J_lower_eta, Matrix.of_apply, Equiv.symm_apply_apply]
  rcases sa with i | i <;> rcases sb with j | j
  · simp only [finSumFinEquiv_apply_left, Fin.val_castAdd] at hab
    dsimp [L_strict]
    have hnot : ¬ (j.val < i.val) := by omega
    simp [hnot]
  · rfl
  · simp only [finSumFinEquiv_apply_left, finSumFinEquiv_apply_right,
      Fin.val_castAdd, Fin.val_natAdd] at hab
    have hj : j.val < w + 1 := j.isLt
    omega
  · simp only [finSumFinEquiv_apply_right, Fin.val_natAdd] at hab
    dsimp [L_strict]
    have hnot : ¬ (j.val < i.val) := by omega
    simp [hnot]

/-- Moment realization `Mᵀ * J_lower_eta * M = E`. -/
theorem M_lower_transpose_mul_J_lower_eta_mul_M_lower (w : ℕ) (ell : Fin (w + 1) → ℚ)
    (E : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) (eta : ℚ)
    (hu0 : ell 0 / 2 - w ≠ 0) (hui : ∀ i : Fin w, ell i.succ ≠ 0) :
    (M_lower w ell).transpose * J_lower_eta w ell E eta * M_lower w ell = E := by
  have hui' : ∀ i : Fin w, (fun j => ell j / 2) i.succ ≠ 0 := by
    intro i h
    have : ell i.succ = 0 := by linarith [h]
    exact hui i this
  let X_mid := (W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell - (2 * eta) • L_strict (w + 1)
  have h_eq :
      (M_lower w ell).transpose * J_lower_eta w ell E eta * M_lower w ell =
        (W_lower_u w ell).transpose * ((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell) * W_lower_u w ell := by
    ext c1 c2
    simp only [Matrix.mul_apply, Matrix.transpose_apply]
    have hcomp1 :
        ∀ b : Fin ((w + 1) + (w + 1)),
          (∑ a : Fin ((w + 1) + (w + 1)), M_lower w ell a c1 * J_lower_eta w ell E eta a b) =
            (∑ i : Fin (w + 1), W_lower_u w ell i c1 * J_lower_eta w ell E eta (finSumFinEquiv (Sum.inl i)) b) +
            (∑ i : Fin (w + 1), W_lower_u w ell i c1 * J_lower_eta w ell E eta (finSumFinEquiv (Sum.inr i)) b) := by
      intro b
      have hc := (Equiv.sum_comp finSumFinEquiv fun a => M_lower w ell a c1 * J_lower_eta w ell E eta a b).symm
      rw [hc, Fintype.sum_sum_type]
      simp only [M_lower, Matrix.of_apply, Equiv.symm_apply_apply]
    simp_rw [hcomp1]
    have hcomp2 :=
      (Equiv.sum_comp finSumFinEquiv fun b : Fin ((w + 1) + (w + 1)) =>
        ((∑ i : Fin (w + 1), W_lower_u w ell i c1 * J_lower_eta w ell E eta (finSumFinEquiv (Sum.inl i)) b) +
         (∑ i : Fin (w + 1), W_lower_u w ell i c1 * J_lower_eta w ell E eta (finSumFinEquiv (Sum.inr i)) b)) *
        M_lower w ell b c2).symm
    rw [hcomp2, Fintype.sum_sum_type]
    simp only [M_lower, J_lower_eta, Matrix.of_apply, Equiv.symm_apply_apply,
      mul_zero, Finset.sum_const_zero, zero_add]
    simp only [Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul]
    simp only [add_mul, sub_mul, mul_sub, Finset.sum_add_distrib, Finset.sum_sub_distrib]
    have h_reorder :
        (∑ x : Fin (w + 1), (∑ i : Fin (w + 1), W_lower_u w ell i c1 * (eta * L_strict (w + 1) i x)) * W_lower_u w ell x c2) +
        ((∑ x : Fin (w + 1), (∑ i : Fin (w + 1), W_lower_u w ell i c1 * ((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell) i x) * W_lower_u w ell x c2) -
         ∑ x : Fin (w + 1), (∑ i : Fin (w + 1), W_lower_u w ell i c1 * (2 * eta * L_strict (w + 1) i x)) * W_lower_u w ell x c2) +
        ∑ x : Fin (w + 1), (∑ i : Fin (w + 1), W_lower_u w ell i c1 * (eta * L_strict (w + 1) i x)) * W_lower_u w ell x c2 =
        ∑ x : Fin (w + 1), (∑ i : Fin (w + 1), W_lower_u w ell i c1 * ((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell) i x) * W_lower_u w ell x c2 := by
      have h2 : (∑ x : Fin (w + 1), (∑ i : Fin (w + 1), W_lower_u w ell i c1 * (2 * eta * L_strict (w + 1) i x)) * W_lower_u w ell x c2) =
          2 * ∑ x : Fin (w + 1), (∑ i : Fin (w + 1), W_lower_u w ell i c1 * (eta * L_strict (w + 1) i x)) * W_lower_u w ell x c2 := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro x _
        have hsum_2 : (∑ i : Fin (w + 1), W_lower_u w ell i c1 * (2 * eta * L_strict (w + 1) i x)) =
            2 * ∑ i : Fin (w + 1), W_lower_u w ell i c1 * (eta * L_strict (w + 1) i x) := by
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro i _
          ring
        rw [hsum_2]
        ring
      rw [h2]
      ring
    rw [h_reorder]
    rfl
  rw [h_eq]
  have hinv : W_lower_inv_u w ell * W_lower_u w ell = 1 :=
    W_lower_inv_mul_W_lower (fun j => ell j / 2) hu0 hui'
  have h1 : (W_lower_u w ell).transpose * (W_lower_inv_u w ell).transpose = (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) := by
    rw [← Matrix.transpose_mul, hinv, Matrix.transpose_one]
  have h2 : (W_lower_inv_u w ell) * (W_lower_u w ell) = (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) :=
    hinv
  calc
    (W_lower_u w ell).transpose * ((W_lower_inv_u w ell).transpose * E * W_lower_inv_u w ell) * W_lower_u w ell
      = ((W_lower_u w ell).transpose * (W_lower_inv_u w ell).transpose) * E * (W_lower_inv_u w ell * W_lower_u w ell) := by
        simp only [Matrix.mul_assoc]
    _ = 1 * E * 1 := by rw [h1, h2]
    _ = E := by
      have he1 : (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) * E = E := Matrix.one_mul E
      have he2 : E * (1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) = E := Matrix.mul_one E
      rw [he1, he2]

/-- General matrix multiplication inversion lemma: if `Bᵀ * A = 1`, then `vecMul (A * v) B = v`. -/
theorem vecMul_mulVec_eq_mulVec_transpose {m n : Type*} [Fintype m] [Fintype n] [DecidableEq n]
    (A : Matrix m n ℚ) (B : Matrix m n ℚ) (v : n → ℚ) (h : B.transpose * A = 1) :
    Matrix.vecMul (A.mulVec v) B = v := by
  ext c
  simp only [Matrix.vecMul, Matrix.mulVec, dotProduct]
  have hsum : (∑ x : m, (∑ j : n, A x j * v j) * B x c) =
      ∑ j : n, (∑ x : m, B.transpose c x * A x j) * v j := by
    simp_rw [Finset.sum_mul]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro x _
    simp only [Matrix.transpose_apply]
    ring
  rw [hsum]
  have hBA : ∀ j : n, (∑ x : m, B.transpose c x * A x j) = if c = j then 1 else 0 := by
    intro j
    have := congr_fun (congr_fun h c) j
    simp only [Matrix.mul_apply, Matrix.one_apply] at this
    exact this
  simp_rw [hBA]
  rw [Finset.sum_eq_single c]
  · simp
  · intro j _ hj
    rw [if_neg (Ne.symm hj), zero_mul]
  · intro hc; exfalso; exact hc (Finset.mem_univ _)

/-- Canonical positive cone vector `a_old_from_LC` satisfying `a_oldᵀ * X = ζ * (1 + B)`.
    On the endpoint action `g = Sum.inr 0`, entry is `(ζ * (1 + B)) 0`.
    On parent actions `i = Sum.inl i`, entry is `(L_C * (ζ * (1 + B))_{1..w}) i`. -/
def a_old_from_LC {w : ℕ} (clock : AlgebraicClock w)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (zeta : Fin (w + 1) → ℚ) :
    Fin (clock.m + 1) → ℚ :=
  (L_X_gateway L_C).mulVec (Matrix.vecMul zeta (1 + B_mat (w + 1)))

/-- The endpoint coordinate of `a_old_from_LC` is exactly `(ζ * (1 + B)) 0`. -/
theorem a_old_from_LC_endpoint {w : ℕ} (clock : AlgebraicClock w)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (zeta : Fin (w + 1) → ℚ) :
    a_old_from_LC clock L_C zeta (finSumFinEquiv (Sum.inr 0)) =
      (Matrix.vecMul zeta (1 + B_mat (w + 1))) 0 := by
  unfold a_old_from_LC L_X_gateway L_X_coupled
  simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Equiv.symm_apply_apply]
  rw [Fin.sum_univ_succ]
  have hzero : e0_row (w + 1) 0 = 1 := by simp [e0_row]
  rw [hzero, one_mul]
  have hrest : (∑ i : Fin w, e0_row (w + 1) i.succ *
      Matrix.vecMul zeta (1 + B_mat (w + 1)) i.succ) = 0 := by
    refine Finset.sum_eq_zero fun i _ => ?_
    have hne : e0_row (w + 1) i.succ = 0 := by simp [e0_row]
    rw [hne, zero_mul]
  rw [hrest, add_zero]

/-- The parent coordinates of `a_old_from_LC` are given by `L_C * (ζ * (1 + B))_{1..w}`. -/
theorem a_old_from_LC_parent {w : ℕ} (clock : AlgebraicClock w)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (zeta : Fin (w + 1) → ℚ) (i : Fin clock.m) :
    a_old_from_LC clock L_C zeta (finSumFinEquiv (Sum.inl i)) =
      (L_C.mulVec (fun k => Matrix.vecMul zeta (1 + B_mat (w + 1)) k.succ)) i := by
  unfold a_old_from_LC L_X_gateway L_X_coupled
  simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Equiv.symm_apply_apply]
  rw [Fin.sum_univ_succ]
  have h0 : shiftRightCount L_C i 0 = 0 := shiftRightCount_zero L_C i 0 rfl
  rw [h0, zero_mul, zero_add]
  rfl

/-- Cone identity: `a_old_from_LCᵀ * X = ζ * (1 + B)`. -/
theorem a_old_from_LC_cone_identity {w : ℕ} (clock : AlgebraicClock w)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (hLC : clock.C.transpose * L_C = 1)
    (zeta : Fin (w + 1) → ℚ) :
    Matrix.vecMul (a_old_from_LC clock L_C zeta) (X_gateway clock) =
      Matrix.vecMul zeta (1 + B_mat (w + 1)) := by
  apply vecMul_mulVec_eq_mulVec_transpose (L_X_gateway L_C) (X_gateway clock)
  exact X_gateway_transpose_mul_L_X_gateway clock L_C hLC

/-- General cone vector parameterized by null-space coefficient `c_null`.
    When `c_null = 0`, specializes to `a_old_from_LC`. -/
def a_old_param {w : ℕ} (clock : AlgebraicClock w)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (zeta : Fin (w + 1) → ℚ) (c_null : ℚ) :
    Fin (clock.m + 1) → ℚ :=
  fun x =>
    match finSumFinEquiv.symm x with
    | Sum.inl i => (L_C.mulVec (fun k => Matrix.vecMul zeta (1 + B_mat (w + 1)) k.succ)) i + c_null * clock.v i
    | Sum.inr _ => (Matrix.vecMul zeta (1 + B_mat (w + 1))) 0

theorem a_old_param_zero_eq {w : ℕ} (clock : AlgebraicClock w)
    (L_C : Matrix (Fin clock.m) (Fin w) ℚ) (zeta : Fin (w + 1) → ℚ) :
    a_old_param clock L_C zeta 0 = a_old_from_LC clock L_C zeta := by
  ext x
  dsimp [a_old_param]
  cases hsym : finSumFinEquiv.symm x with
  | inl i =>
    have heq := a_old_from_LC_parent clock L_C zeta i
    have hx : x = finSumFinEquiv (Sum.inl i) := by rw [← hsym, Equiv.apply_symm_apply]
    rw [hx, heq]
    ring
  | inr j =>
    have hj0 : j = 0 := Subsingleton.elim j 0
    subst hj0
    have heq := a_old_from_LC_endpoint clock L_C zeta
    have hx : x = finSumFinEquiv (Sum.inr 0) := by rw [← hsym, Equiv.apply_symm_apply]
    rw [hx, heq]


/-- Linear dependence of `v_step` on `c_step`:
    difference between two choices of `c_step` is supported only at index 0. -/
theorem v_step_sub_v_step {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step1 c_step2 : ℚ) (c : Fin (w + 1)) :
    v_step hw clock b c_step1 c - v_step hw clock b c_step2 c =
      if c.val = 0 then c_step1 - c_step2 else 0 := by
  dsimp [v_step]
  split_ifs with hc0 <;> ring

/-- Master identity: `zeta * (1 + B) = 2 • zeta - v_step`. -/
theorem vecMul_zeta_canonical_one_add_B_mat {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w) (b : Fin clock.m)
    (c_step H0 : ℚ) :
    Matrix.vecMul (zeta_canonical hw clock b c_step H0) (1 + B_mat (w + 1)) =
      (2 : ℚ) • zeta_canonical hw clock b c_step H0 - v_step hw clock b c_step := by
  have h_sub := vecMul_zeta_canonical_one_sub_B_mat hw clock b c_step H0
  ext c
  have h_id : (1 + B_mat (w + 1)) + (1 - B_mat (w + 1)) = (2 : ℚ) • 1 := by
    ext i j
    simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
    ring
  have h_add : Matrix.vecMul (zeta_canonical hw clock b c_step H0) ((1 + B_mat (w + 1)) + (1 - B_mat (w + 1))) =
      Matrix.vecMul (zeta_canonical hw clock b c_step H0) (1 + B_mat (w + 1)) +
      Matrix.vecMul (zeta_canonical hw clock b c_step H0) (1 - B_mat (w + 1)) := by
    rw [Matrix.vecMul_add]
  rw [h_id, Matrix.vecMul_smul, Matrix.vecMul_one] at h_add
  have h_add_c := congr_fun h_add c
  have h_sub_c := congr_fun h_sub c
  dsimp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at h_add_c
  linarith

/-- Master difference formula for `zeta * (1 + B)` under changes in `c_step`:
    `(zeta1 * (1 + B)) c - (zeta2 * (1 + B)) c = 2 * (zeta1 c - zeta2 c) - (v_step1 c - v_step2 c)`. -/
theorem vecMul_zeta_canonical_one_add_B_mat_diff {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step1 c_step2 H0 : ℚ) (c : Fin (w + 1)) :
    Matrix.vecMul (zeta_canonical hw clock b c_step1 H0) (1 + B_mat (w + 1)) c -
      Matrix.vecMul (zeta_canonical hw clock b c_step2 H0) (1 + B_mat (w + 1)) c =
    2 * (zeta_canonical hw clock b c_step1 H0 c - zeta_canonical hw clock b c_step2 H0 c) -
      (if c.val = 0 then c_step1 - c_step2 else 0) := by
  have h1 := congr_fun (vecMul_zeta_canonical_one_add_B_mat hw clock b c_step1 H0) c
  have h2 := congr_fun (vecMul_zeta_canonical_one_add_B_mat hw clock b c_step2 H0) c
  have hv := v_step_sub_v_step hw clock b c_step1 c_step2 c
  dsimp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul] at h1 h2
  linarith

/-- Difference in `zeta_canonical` between two choices of `c_step`:
    non-zero only at index 1 with coefficient 1. -/
theorem zeta_canonical_sub_c_step {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step1 c_step2 H0 : ℚ) (c : Fin (w + 1)) :
    zeta_canonical hw clock b c_step1 H0 c - zeta_canonical hw clock b c_step2 H0 c =
      if c.val = 1 then c_step1 - c_step2 else 0 := by
  dsimp [zeta_canonical]
  by_cases hc0 : c.val = 0
  · have hnot : ¬ (c.val = 1) := by omega
    rw [if_pos hc0, if_pos hc0, if_neg hnot]
    ring
  · rw [if_neg hc0, if_neg hc0]
    rw [← Pi.sub_apply, ← Matrix.sub_vecMul]
    have hdiff : (v_step hw clock b c_step1 - v_step hw clock b c_step2) =
        fun j => if j.val = 0 then c_step1 - c_step2 else 0 := by
      ext j; exact v_step_sub_v_step hw clock b c_step1 c_step2 j
    rw [hdiff]
    dsimp [Matrix.vecMul, dotProduct]
    rw [Fin.sum_univ_succ]
    have hzero : (if (0 : Fin (w + 1)).val = 0 then c_step1 - c_step2 else 0) = c_step1 - c_step2 := by simp
    rw [hzero]
    have hrest : (∑ i : Fin w, (if (i.succ : Fin (w + 1)).val = 0 then c_step1 - c_step2 else (0 : ℚ)) *
        ((1 : Matrix (Fin (w + 1)) (Fin (w + 1)) ℚ) i.succ ⟨c.val - 1, by omega⟩ + N_mat (w + 1) i.succ ⟨c.val - 1, by omega⟩)) = 0 := by
      refine Finset.sum_eq_zero fun i _ => ?_
      have hne : (i.succ : Fin (w + 1)).val ≠ 0 := fun h => Fin.succ_ne_zero i (Fin.ext h)
      have hif : (if (i.succ : Fin (w + 1)).val = 0 then c_step1 - c_step2 else (0 : ℚ)) = 0 := if_neg hne
      rw [hif, zero_mul]
    rw [hrest, add_zero]
    simp only [Matrix.one_apply, N_mat, Matrix.of_apply]
    have hN0 : ¬ ((0 : Fin (w + 1)).val = (⟨c.val - 1, by omega⟩ : Fin (w + 1)).val + 1) := by
      dsimp; omega
    rw [if_neg hN0, add_zero]
    by_cases hc1 : c.val = 1
    · have h00 : (0 : Fin (w + 1)) = ⟨c.val - 1, by omega⟩ := by ext; simp [hc1]
      rw [if_pos h00, if_pos hc1]
      ring
    · have h00 : ¬ ((0 : Fin (w + 1)) = ⟨c.val - 1, by omega⟩) := by
        intro h; have := congr_arg Fin.val h; dsimp at this; omega
      rw [if_neg h00, if_neg hc1]
      ring

/-- Difference in `vecMul zeta (1 + B_mat (w + 1))` between two values of `c_step`:
    at coordinate 1, the difference is `2 * (c_step1 - c_step2)`. -/
theorem vecMul_zeta_canonical_one_add_B_mat_diff_one {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step1 c_step2 H0 : ℚ) (h1 : 1 < w + 1) :
    Matrix.vecMul (zeta_canonical hw clock b c_step1 H0) (1 + B_mat (w + 1)) ⟨1, h1⟩ -
      Matrix.vecMul (zeta_canonical hw clock b c_step2 H0) (1 + B_mat (w + 1)) ⟨1, h1⟩ =
    2 * (c_step1 - c_step2) := by
  rw [vecMul_zeta_canonical_one_add_B_mat_diff hw clock b c_step1 c_step2 H0 ⟨1, h1⟩]
  rw [zeta_canonical_sub_c_step hw clock b c_step1 c_step2 H0 ⟨1, h1⟩]
  have hne0 : ¬ ((⟨1, h1⟩ : Fin (w + 1)).val = 0) := by dsimp; omega
  have heq1 : (⟨1, h1⟩ : Fin (w + 1)).val = 1 := rfl
  rw [if_neg hne0, if_pos heq1]
  ring

/-- Difference in `vecMul zeta (1 + B_mat (w + 1))` between two values of `c_step`:
    at any coordinate `k ≥ 2`, the difference is 0 (completely independent of `c_step`). -/
theorem vecMul_zeta_canonical_one_add_B_mat_diff_ge_two {w : ℕ} (hw : 1 ≤ w) (clock : AlgebraicClock w)
    (b : Fin clock.m) (c_step1 c_step2 H0 : ℚ) (k : Fin (w + 1)) (hk : 2 ≤ k.val) :
    Matrix.vecMul (zeta_canonical hw clock b c_step1 H0) (1 + B_mat (w + 1)) k -
      Matrix.vecMul (zeta_canonical hw clock b c_step2 H0) (1 + B_mat (w + 1)) k = 0 := by
  rw [vecMul_zeta_canonical_one_add_B_mat_diff hw clock b c_step1 c_step2 H0 k]
  rw [zeta_canonical_sub_c_step hw clock b c_step1 c_step2 H0 k]
  have hne0 : ¬ (k.val = 0) := by omega
  have hne1 : ¬ (k.val = 1) := by omega
  rw [if_neg hne0, if_neg hne1]
  ring

/-- Positivity of coordinate 0 of `(W_lower_inv)ᵀ * v` for large linear growth in `v 0`:
    If `v 0 = s * c_step + C0` with `s > 0` and the remaining coordinates `v k.succ` are constant,
    then for any `u 0 > w` and `u k.succ > 0`, there exists `c_step*` such that for all `c_step > c_step*`,
    `((W_lower_inv w u)ᵀ * v) 0 > 0`. -/
theorem w_late_zero_pos_of_large_c_step {w : ℕ} (hw : 1 ≤ w) (u : Fin (w + 1) → ℚ)
    (hu0 : (w : ℚ) < u 0) (_hui : ∀ k : Fin w, 0 < u k.succ)
    (s C0 : ℚ) (hs : 0 < s) (v_rest : Fin w → ℚ) :
    ∃ c_step_star : ℚ, ∀ c_step : ℚ, c_step_star < c_step →
      let v : Fin (w + 1) → ℚ := fun c =>
        if _ : c.val = 0 then s * c_step + C0
        else v_rest ⟨c.val - 1, by have := c.isLt; omega⟩
      0 < ((W_lower_inv w u).transpose.mulVec v) 0 := by
  let sum_rest := ∑ j : Fin w, (u j.succ)⁻¹ * v_rest j
  let c_step_star := (sum_rest - C0) / s
  use c_step_star
  intro c_step hc_gt v
  have hv0 : v 0 = s * c_step + C0 := rfl
  have hv_succ : ∀ j : Fin w, v j.succ = v_rest j := by
    intro j
    change (if _ : (j.succ : Fin (w + 1)).val = 0 then s * c_step + C0
      else v_rest ⟨(j.succ : Fin (w + 1)).val - 1, by have := (j.succ).isLt; omega⟩) = v_rest j
    have hne : ¬ ((j.succ : Fin (w + 1)).val = 0) := fun h => Fin.succ_ne_zero j (Fin.ext h)
    rw [dif_neg hne]
    have heq : (⟨(j.succ : Fin (w + 1)).val - 1, by have := (j.succ).isLt; omega⟩ : Fin w) = j := by ext; simp
    rw [heq]
  have hdiff : sum_rest < s * c_step + C0 := by
    dsimp [c_step_star] at hc_gt
    have hmul := (div_lt_iff₀ hs).mp hc_gt
    linarith
  have hpos := W_lower_inv_transpose_mulVec_zero_pos w u v hu0
  apply hpos
  rw [hv0]
  have hsum_eq : (∑ j : Fin w, (u j.succ)⁻¹ * v j.succ) = sum_rest := by
    dsimp [sum_rest]
    apply Finset.sum_congr rfl
    intro j _
    rw [hv_succ j]
  rw [hsum_eq]
  exact hdiff

/-!
## Section 36: Grounded Uniform RealizedClock Lift for General Reset Count Matrix M
-/

open scoped BigOperators
open scoped Matrix


/-- Rational matrix corresponding to an integer matrix . -/
def M_of_nat {w : ℕ} (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ) :
    Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℚ :=
  Matrix.of fun r c => (M_nat r c : ℚ)

/-- Step count for reset action  in phase  under matrix . -/
def resetStepCount_M {w : ℕ} (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (r : Fin ((w + 1) + (w + 1))) (q : ℕ) : ℕ :=
  ∑ c : Fin (w + 1), M_nat r c * Nat.choose q c.val

/-- Cast identity for . -/
theorem resetStepCount_M_cast {w : ℕ} (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (r : Fin ((w + 1) + (w + 1))) (q : ℕ) :
    (resetStepCount_M M_nat r q : ℚ) = (M_of_nat M_nat).mulVec (binomBasis (w + 1) q) r := by
  simp only [resetStepCount_M, M_of_nat, Nat.cast_sum, Nat.cast_mul, Matrix.mulVec, dotProduct, binomBasis, Matrix.of_apply]

/-- Strict positivity of  under column-0 positivity. -/
theorem resetStepCount_M_pos {w : ℕ} (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (hM0 : ∀ r, 1 ≤ M_nat r ⟨0, Nat.succ_pos w⟩)
    (r : Fin ((w + 1) + (w + 1))) (q : ℕ) :
    0 < resetStepCount_M M_nat r q := by
  unfold resetStepCount_M
  let c0 : Fin (w + 1) := ⟨0, Nat.succ_pos w⟩
  have hpos : 0 < M_nat r c0 * Nat.choose q c0.val := by
    have hM : 1 ≤ M_nat r c0 := hM0 r
    have hchoose : Nat.choose q 0 = 1 := Nat.choose_zero_right q
    have hc0 : c0.val = 0 := rfl
    rw [hc0, hchoose, mul_one]
    omega
  have hnonneg : ∀ c : Fin (w + 1), 0 ≤ M_nat r c * Nat.choose q c.val := fun _ => by positivity
  exact Finset.sum_pos' (fun c _ => hnonneg c) ⟨c0, Finset.mem_univ c0, hpos⟩

/-- Early reset word under matrix . -/
def W_early_word_M (m w : ℕ) (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ) (q : ℕ) :
    List (Fin (m + 1) ⊕ Fin ((w + 1) + (w + 1))) :=
  (List.finRange (w + 1)).flatMap fun r =>
    List.replicate (resetStepCount_M M_nat (finSumFinEquiv (Sum.inl r)) q)
      (Sum.inr (finSumFinEquiv (Sum.inl r)))

/-- The early reset word begins with . -/
theorem W_early_word_M_eq_cons (m w : ℕ) (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (hM0 : ∀ r, 1 ≤ M_nat r ⟨0, Nat.succ_pos w⟩) (q : ℕ) :
    ∃ tl, W_early_word_M m w M_nat q = Sum.inr ⟨0, by omega⟩ :: tl := by
  have hk : 0 < resetStepCount_M M_nat (finSumFinEquiv (Sum.inl (0 : Fin (w + 1)))) q :=
    resetStepCount_M_pos M_nat hM0 _ q
  obtain ⟨k, hk_eq⟩ : ∃ k, resetStepCount_M M_nat (finSumFinEquiv (Sum.inl (0 : Fin (w + 1)))) q = k + 1 :=
    Nat.exists_eq_succ_of_ne_zero (ne_of_gt hk)
  unfold W_early_word_M
  rw [List.finRange_succ, List.flatMap_cons]
  rw [hk_eq, List.replicate_succ, List.cons_append]
  exact ⟨_, rfl⟩

/-- Late reset word under matrix . -/
def W_late_word_M (m w : ℕ) (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ) (q : ℕ) :
    List (Fin (m + 1) ⊕ Fin ((w + 1) + (w + 1))) :=
  (List.finRange (w + 1)).flatMap fun r =>
    List.replicate (resetStepCount_M M_nat (finSumFinEquiv (Sum.inr r)) q)
      (Sum.inr (finSumFinEquiv (Sum.inr r)))

/-- Old actions have zero count in combined reset stages . -/
theorem wordCountVec_reset_stages_M_inl (m w : ℕ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ) (q : ℕ) (u : Fin (m + 1)) :
    wordCountVec (W_early_word_M m w M_nat q ++ W_late_word_M m w M_nat q) (Sum.inl u) = 0 := by
  rw [wordCountVec_append]
  have h1 : wordCountVec (W_early_word_M m w M_nat q) (Sum.inl u) = 0 := by
    unfold wordCountVec W_early_word_M
    have hnone : ∀ y ∈ (List.finRange (w + 1)).flatMap (fun r =>
        List.replicate (resetStepCount_M M_nat (finSumFinEquiv (Sum.inl r)) q)
          (Sum.inr (finSumFinEquiv (Sum.inl r)) : Fin (m + 1) ⊕ Fin ((w + 1) + (w + 1)))), y ≠ Sum.inl u := by
      intro y hy
      simp only [List.mem_flatMap, List.mem_replicate] at hy
      rcases hy with ⟨r, _, _, rfl⟩
      intro h
      contradiction
    rw [list_count_eq_zero_of_forall_ne hnone]
    rfl
  have h2 : wordCountVec (W_late_word_M m w M_nat q) (Sum.inl u) = 0 := by
    unfold wordCountVec W_late_word_M
    have hnone : ∀ y ∈ (List.finRange (w + 1)).flatMap (fun r =>
        List.replicate (resetStepCount_M M_nat (finSumFinEquiv (Sum.inr r)) q)
          (Sum.inr (finSumFinEquiv (Sum.inr r)) : Fin (m + 1) ⊕ Fin ((w + 1) + (w + 1)))), y ≠ Sum.inl u := by
      intro y hy
      simp only [List.mem_flatMap, List.mem_replicate] at hy
      rcases hy with ⟨r, _, _, rfl⟩
      intro h
      contradiction
    rw [list_count_eq_zero_of_forall_ne hnone]
    rfl
  rw [h1, h2, add_zero]

/-- The combined reset stages under  match . -/
theorem wordCountVec_reset_stages_M_inr (m w q : ℕ)
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (r : Fin ((w + 1) + (w + 1))) :
    wordCountVec (W_early_word_M m w M_nat q ++ W_late_word_M m w M_nat q) (Sum.inr r) =
      (M_of_nat M_nat).mulVec (binomBasis (w + 1) q) r := by
  rw [wordCountVec_append]
  have hinj_early : Function.Injective (fun r : Fin (w + 1) =>
      (Sum.inr (finSumFinEquiv (Sum.inl r)) : Fin (m + 1) ⊕ Fin ((w + 1) + (w + 1)))) := by
    intro a b hab
    simp only [Sum.inr.injEq, Equiv.apply_eq_iff_eq, Sum.inl.injEq] at hab
    exact hab
  have hinj_late : Function.Injective (fun r : Fin (w + 1) =>
      (Sum.inr (finSumFinEquiv (Sum.inr r)) : Fin (m + 1) ⊕ Fin ((w + 1) + (w + 1)))) := by
    intro a b hab
    simp only [Sum.inr.injEq, Equiv.apply_eq_iff_eq, Sum.inr.injEq] at hab
    exact hab
  cases hsym : finSumFinEquiv.symm r with
  | inl i =>
    have hreq : r = finSumFinEquiv (Sum.inl i) := by rw [← hsym, Equiv.apply_symm_apply]
    have h1 : wordCountVec (W_early_word_M m w M_nat q) (Sum.inr r) = (resetStepCount_M M_nat r q : ℚ) := by
      unfold wordCountVec W_early_word_M
      rw [hreq]
      have hcnt := count_flatMap_finRange_replicate (w + 1)
        (fun j => resetStepCount_M M_nat (finSumFinEquiv (Sum.inl j)) q)
        (fun j => Sum.inr (finSumFinEquiv (Sum.inl j))) hinj_early i
      exact_mod_cast hcnt
    have h2 : wordCountVec (W_late_word_M m w M_nat q) (Sum.inr r) = 0 := by
      unfold wordCountVec
      have hnone : ∀ y ∈ W_late_word_M m w M_nat q, y ≠ Sum.inr r := by
        intro y hy
        unfold W_late_word_M at hy
        simp only [List.mem_flatMap, List.mem_replicate] at hy
        rcases hy with ⟨j, _, _, rfl⟩
        rw [hreq]
        intro h
        simp only [Sum.inr.injEq, Equiv.apply_eq_iff_eq] at h
        contradiction
      have hcount := list_count_eq_zero_of_forall_ne hnone
      rw [hcount]
      rfl
    rw [h1, h2, add_zero, resetStepCount_M_cast]
  | inr i =>
    have hreq : r = finSumFinEquiv (Sum.inr i) := by rw [← hsym, Equiv.apply_symm_apply]
    have h1 : wordCountVec (W_early_word_M m w M_nat q) (Sum.inr r) = 0 := by
      unfold wordCountVec
      have hnone : ∀ y ∈ W_early_word_M m w M_nat q, y ≠ Sum.inr r := by
        intro y hy
        unfold W_early_word_M at hy
        simp only [List.mem_flatMap, List.mem_replicate] at hy
        rcases hy with ⟨j, _, _, rfl⟩
        rw [hreq]
        intro h
        simp only [Sum.inr.injEq, Equiv.apply_eq_iff_eq] at h
        contradiction
      have hcount := list_count_eq_zero_of_forall_ne hnone
      rw [hcount]
      rfl
    have h2 : wordCountVec (W_late_word_M m w M_nat q) (Sum.inr r) = (resetStepCount_M M_nat r q : ℚ) := by
      unfold wordCountVec W_late_word_M
      rw [hreq]
      have hcnt := count_flatMap_finRange_replicate (w + 1)
        (fun j => resetStepCount_M M_nat (finSumFinEquiv (Sum.inr j)) q)
        (fun j => Sum.inr (finSumFinEquiv (Sum.inr j))) hinj_late i
      exact_mod_cast hcnt
    rw [h1, h2, zero_add, resetStepCount_M_cast]


/-- Four-stage raw word under matrix . -/
def rawFourStageWord_M {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (q : ℕ) : List (Fin (clock.m + 1) ⊕ Fin ((w + 1) + (w + 1))) :=
  W_early_word_M clock.m w M_nat q ++ W_late_word_M clock.m w M_nat q ++
    (W_bundle_word parentWord (q + 1)).map (bundleToLiftedAct clock.m w) ++
    [gatewayToLiftedAct clock.m w]

/-- The raw four-stage word under  begins with . -/
theorem rawFourStageWord_M_eq_cons {w : ℕ} (clock : AlgebraicClock w)
    (parentWord : ℕ → List (Fin clock.m))
    (M_nat : Matrix (Fin ((w + 1) + (w + 1))) (Fin (w + 1)) ℕ)
    (hM0 : ∀ r, 1 ≤ M_nat r ⟨0, Nat.succ_pos w⟩) (q : ℕ) :
    ∃ tl, rawFourStageWord_M clock parentWord M_nat q = Sum.inr ⟨0, by omega⟩ :: tl := by
  obtain ⟨tl, htl⟩ := W_early_word_M_eq_cons clock.m w M_nat hM0 q
  unfold rawFourStageWord_M
  rw [htl]
