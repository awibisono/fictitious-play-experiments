      ((q + 1 : ℕ) : ℚ) - 1 :=
    dotProduct_wordCountVec_flatMap_take_le fc.clock.v parentWord h_v_full h_v_take (q + 1) k hk
  have hq : ((q + 1 : ℕ) : ℚ) = (q : ℚ) + 1 := by push_cast; ring
  linarith

theorem g_parent_active (parentWord : ℕ → List (Fin fc.clock.m)) (parent_rank : Fin fc.clock.m → Fin fc.clock.m)
    (hparent_count : ∀ σ : ℕ, wordCountVec (parentWord σ) = fc.clock.C.mulVec (binomBasis w σ))
    (hparent_valid : ∀ σ : ℕ,
